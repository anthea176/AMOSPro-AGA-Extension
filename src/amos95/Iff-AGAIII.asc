Fix(2)

Rem *************************************************************  
Rem *                                                           *  
Rem *     NOM DE SOURCE: Perfect Iff Viewer and Saver AGA V4.0  *    
Rem *     DESCRIPTIF : Utilise intuition pour afficher une      *  
Rem *                  Image jusqu'a 262144 couleurs !..        *  
Rem *                  ma palette est enfin en 24 bits ...      *
Rem *                  tralalalalèreheu !!!.........            *  
Rem *                                                           *
Rem *     PROGRAMMEUR : AMETHIST (HWARF 24 novembre 1995)  *      
Rem *                                                           *  
Rem *************************************************************  

' Variable écran intuition...  
Dim _INTSCREEN(16),_LENGTH(8)
Global _INTSCREEN(),_LENGTH()
Global _DISK$

INITIALISATION

Repeat 
   _DISK$=Dir$
   Repeat 
      CASE=Mouse Zone
      If Mouse Key=1
         If CASE=2
            QUITTER
         Else If CASE=1
            Ink 2 : Box 45,25 To 132,46
            Ink 1 : F Draw 45,25 To 132,25 : F Draw 132,25 To 132,46
            If _INTSCREEN(0)<>0
               Print "Showing picture."
               Wait 16
               Amos To Back 
               Dreg(0)=Intcall(-336)
               _ATTENTE=60
               Timer=0
               Repeat : Multi Wait : Until Left Click or Timer=_ATTENTE*50
               Amos To Front 
            Else 
               Print "No pictures loaded."
               Wait 16
            End If 
            Print "Ok."
            Ink 1 : Box 45,25 To 132,46
            Ink 2 : F Draw 45,25 To 132,25 : F Draw 132,25 To 132,46
         End If 
      End If 
      
      A$="Iff AMOS-AGA "+Str$(Chip Free)+" graphics mem "+Str$(Fast Free)+" other mem"
      Ink 1,2 : Text 8,8,Left$(A$+Space$(20),70)
      Multi Wait 
      
   Until Choice
   
   On Choice(1) Proc MENU
   Multi Wait 
   
Until False

Procedure QUITTER
   Ink 2 : Box 505,25 To 560,46
   Ink 1 : F Draw 505,25 To 560,25 : F Draw 560,25 To 560,46
   INFORMER["Quitter",3]
   If Param=False
      Ink 1 : Box 505,25 To 560,46
      Ink 2 : F Draw 505,25 To 560,25 : F Draw 560,25 To 560,46
      Print "Ok."
      Pop Proc
   End If 
   Print "Closing all - Restore system"
   Update Every 1 : Reset Zone : Menu Off 
   Erase All : Wait 20
   Fade 1,$AAA,$AAA,$AAA,$AAA : Wait 16
   If _INTSCREEN(0)<>0
      _INT_SCREEN_CLOSE
   End If 
   Wind Close 
   Screen Close 0
   Break On : Amos Unlock 
   End 
End Proc
Procedure SETUP
   Paper 1
   Menu$(1)="Projet" : Menu Static(1)
   Menu$(1,1)=" Nouveau Tiroir" : Menu Static(1,1)
   Menu$(1,2)=" Charger Image" : Set Menu(1,2) To 0,8
   Menu$(1,3)=" ---------------------- " : Menu Inactive(1,3)
   Menu$(1,4)=" Sauver Comme ..." : Set Menu(1,4) To 0,8
   Menu$(1,4,1)="Iff ILBM Compress rate 0" : Menu Static(1,4,1)
   Menu$(1,4,2)="Iff ILBM Compress rate 128"
   Menu$(1,4,3)="(IN 0,3) s " : Menu Inactive(1,4,3) : Set Menu(1,4,3) To 210,-8
   Menu$(1,4,4)="(IN 0,3) d " : Menu Inactive(1,4,4)
   Menu$(1,5)=" Effacer ..."
   Menu$(1,6)=" ---------------------- " : Menu Inactive(1,6)
   Menu$(1,7)=" Information Volume"
   Menu$(1,8)=" A Propos de ..."
   Menu$(1,9)=" Quitter"
   Menu$(1,10)="(IN 0,3) n" : Menu Inactive(1,10) : Set Menu(1,10) To 160,-64
   Menu$(1,11)="(IN 0,3) l" : Menu Inactive(1,11)
   Menu$(1,12)="(IN 0,3) e" : Menu Inactive(1,12) : Set Menu(1,12) To 0,24
   Menu$(1,13)="(IN 0,3) i" : Menu Inactive(1,13) : Set Menu(1,13) To 0,16
   Menu$(1,14)="(IN 0,3) a" : Menu Inactive(1,14)
   Menu$(1,15)="(IN 0,3) q" : Menu Inactive(1,15)
   
   Menu Key(1,1) To "n" : Menu Key(1,2) To "l"
   Menu Key(1,4,1) To "s" : Menu Key(1,4,2) To "d"
   Menu Key(1,5) To "e" : Menu Key(1,7) To "i"
   Menu Key(1,8) To "a" : Menu Key(1,9) To "q"
   
   Paper 0
End Proc
Procedure MENU
   Menu Off : Clear Key 
   W$="please Wait."
   If Choice(2)=1
      F$=Fsel$("","","Entrer le nom du nouveau","repértoire")
      If F$<>""
         INFORMER[F$,1] : If Param=False : Menu On : Print "Ok." : Pop Proc : End If 
         Print "Creating :"+Chr$(34)+F$+Chr$(34)
         Mkdir F$
      End If 
   Else If Choice(2)=2
      F$=Fsel$("","","Sélectionner un fichier graphique Iff ","et patienter")
      If F$<>""
         Print W$
         Print "loading file :"+Chr$(34)+F$+Chr$(34)
         _INT_IFF[F$]
      End If 
   Else If Choice(2)=4
      If _INTSCREEN(0)<>0
         F$=Fsel$("","","Sélectionner un fichier de sauvegarde")
         If F$="" : Print "Ok." : Menu On : Pop Proc : End If 
         If Choice(3)=1
            CMP=0
         Else If Choice(3)=2
            CMP=128
         End If 
         Print W$
         INFORMER[F$,1] : If Param=False : Print "Ok." : Menu On : Pop Proc : End If 
         Print "Saving file :"+Chr$(34)+F$+Chr$(34)
         _INT_IFF_SAVE[F$,CMP]
      Else 
         Print "No picture loaded."
      End If 
   Else If Choice(2)=5
      F$=Fsel$("","","Sélection du fichier"," à effacer")
      If Exist(F$)
         Print "Delete file :"+Chr$(34)+F$+Chr$(34)
         Kill F$
      Else 
         Print "File no exist."
      End If 
   Else If Choice(2)=7
      V$=Left$(_DISK$,Instr(_DISK$,":"))
      If Exist(V$)
         A$=Disc Info$(V$) : C=Instr(A$,":")
         _VOLUME$=Left$(Chr$(34)+Left$(A$,C-1)+Chr$(34)+Space$(18),22)
         FR=Val(Right$(A$,Len(A$)-C))
         _FREE$=Right$("000000000"+Mid$(Str$(Int(FR)),2),9)+" Octets"
         _CFREE$=Right$("000000000"+Mid$(Str$(Chip Free+Fast Free),2),9)+" Octets"
         REQUEST[90,84,300,74,"Information volume","Volume: "+_VOLUME$,"Espace libre: "+_FREE$,"Mémoire Ram : "+_CFREE$,"  Ok  ",""]
      Else 
         Print "Please insert a disk in volume:"+Chr$(34)+V$+Chr$(34)
      End If 
   Else If Choice(2)=8
      AUT$=Space$(6)+"© Coulloux Jér"+Chr$(244)+"me"
      T0$=Space$(7)+"Iff AMOS-AGA" : T1$=Space$(12)+"V4.0"
      REQUEST[90,75,300,92,"A propos de ...",AUT$,T0$,T1$,"  Ok  ",""]
   Else If Choice(2)=9
      QUITTER
   End If 
   Print "Ok."
   Menu On : Pop Proc
End Proc

Procedure INFORMER[F$,_MODE]
   TEST=True
   If _MODE=1
      TEST=Exist(F$)
      _TEXT$="Le fichier éxiste déjà"
      _TEXT2$="doit-on l'écraser"
   Else If _MODE=3
      _TEXT$="Etes vous sure de "
      _TEXT2$="vouloir quitter ? ..."
   End If 
   P=False
   If TEST=True
      REQUEST[112,85,279,65,"Requ"+Chr$(234)+"te utilisateurs",_TEXT$,_TEXT2$,"","  Oui  ","  Non  "]
      P=Param
   Else 
      P=True
   End If 
End Proc[P]
Procedure INITIALISATION
   Break Off : Amos Lock 
   Set Sprite Buffer 16
   Screen Open 0,640,256,4,Hires : Screen Hide 0
   Wind Open 1,32,136,73,12 : Paper 0
   Flash Off : Curs Off : Cls 0
   Palette $AAA,$0,$EEE,$47A,,,,,,,,,,,,,,$DDD,$E50,$444
   Colour Back Colour(0)
   Limit Mouse 128,41 To 447,292
   
   Autoback 0
   Update Every 2
   
   Reserve Zone 2
   SETUP
   Set Text %10 : Ink 1,0 : Text 48,38," Show Pic "
   Text 508,38," Quit "
   Box 45,25 To 132,46 : Box 505,25 To 560,46
   Set Zone 1,45,25 To 132,46
   Set Zone 2,505,25 To 560,46
   Ink 2 : F Draw 45,25 To 132,25 : F Draw 132,25 To 132,46
   F Draw 505,25 To 560,25 : F Draw 560,25 To 560,46
   Bar 0,0 To 639,11
   F Draw 16,130 To 16,240 : F Draw 16,240 To 624,240
   Ink 1 : F Draw 0,11 To 639,11 : F Draw 639,0 To 639,11
   F Draw 16,130 To 624,130 : F Draw 624,130 To 624,240
   Set Text %0
   
   Text 190,32,"Type De Microprocesseur: 680"+Right$("00"+Mid$(Str$(Cpu Info),2),2)
   Text 190,42,"KickStart Version: "+Mid$(Str$(Deek(Leek(4)+20)),2)+"."+Mid$(Str$(Deek(Leek(4)+34)),2)
   
   CHIP=Deek(Leek(4)+$7C)
   CHIP$="Original"
   If CHIP=248 Then CHIP$="AGA"
   If CHIP=252 Then CHIP$="ECS"
   If Ntsc=False Then _MODE$="Pal" Else _MODE$="Ntsc"
   Text 190,52,"Chip Graphique: "+CHIP$+Space$(2)+_MODE$
   
   Screen Show 0
   _DISK$=Dir$ : Set Dir 50,"*.Info"
   Pen 1
   Centre "Welcome under Iff AMOS-AGA v4.0" : Print : Print 
   If CHIP<>248
      Print "Sorry, you need AGA chip"
      Print "Closing all - Restore system"
      Update Every 1 : Reset Zone : Menu Off 
      Erase All : Wait 20
      Fade 1,$AAA,$AAA,$AAA,$AAA : Wait 16
      Wind Close 
      Screen Close 0
      Break On : Amos Unlock 
      End 
   End If 
   Menu On 
End Proc
Procedure REQUEST[X,Y,L,H,T$,PR$,PR2$,PR3$,C$,C2$]
   Menu Off : Reset Zone 
   Get Block 1,X,Y,L+1,H+1,1
   Cls 3,X,Y To X+L+1,Y+H+1
   Set Pattern 2 : Ink 2,0 : Bar X+5,Y+11 To X+L-4,Y+H-2 : Set Pattern 0
   Ink 0 : Bar X+9,Y+14 To X+L-8,Y+H-20
   Ink 1,0 : F Draw X,Y+H To X+L,Y+H : F Draw X+L,Y To X+L,Y+H
   F Draw X+3,Y+10 To X+3,Y+H-1 : F Draw X+3,Y+10 To X+L-3,Y+10
   F Draw X+8,Y+13 To X+8,Y+H-19 : F Draw X+8,Y+13 To X+L-8,Y+13
   Text X+35,Y+27,PR$ : Text X+35,Y+36,PR2$ : Text X+35,Y+45,PR3$
   If T$="A propos de ..."
      Text X+83,Y+54,"24 Novembre 1995 "+Chr$(174)
      Text X+43,Y+63,"Réalisé avec AMOS PRO v2.00"
   End If 
   CX=Text Length(C$)+28
   If C2$=""
      OFF=(Lsr.w((L-CX),1))-4
   Else OFF=0
      CX2=Text Length(C$)+28
      Ink 0 : Bar X+L-7-CX2,Y+H-17 To X+L-7,Y+H-4
      Ink 1,0 : Text X+L+8-CX2,Y+H-8,C2$
      F Draw X+L-8-CX2,Y+H-4 To X+L-8,Y+H-4 : F Draw X+L-8,Y+H-17 To X+L-8,Y+H-4
      Set Zone 2,X+L-8-CX2,Y+H-17 To X+L-8,Y+H-4
      Ink 2
      F Draw X+L-8-CX2,Y+H-17 To X+L-8,Y+H-17 : F Draw X+L-8-CX2,Y+H-17 To X+L-8-CX2,Y+H-4
   End If 
   Ink 0 : Bar X+OFF+9,Y+H-17 To X+OFF+9+CX,Y+H-4
   Ink 1,0 : Text X+OFF+24,Y+H-8,C$
   F Draw X+OFF+8,Y+H-4 To X+OFF+8+CX,Y+H-4 : F Draw X+OFF+8+CX,Y+H-17 To X+OFF+8+CX,Y+H-4
   Set Zone 1,X+OFF+8,Y+H-17 To X+OFF+8+CX,Y+H-4
   Ink 2 : F Draw X,Y To X+L,Y : F Draw X,Y To X,Y+H
   F Draw X+3,Y+H-1 To X+L-3,Y+H-1 : F Draw X+L-3,Y+10 To X+L-3,Y+H-1
   F Draw X+8,Y+H-19 To X+L-8,Y+H-19 : F Draw X+L-8,Y+13 To X+L-8,Y+H-19
   F Draw X+OFF+8,Y+H-17 To X+OFF+8,Y+H-4 : F Draw X+OFF+8,Y+H-17 To X+8+OFF+CX,Y+H-17
   Ink 1,3 : Text X+4,Y+8,T$
   
   ANSWER=1
   While ANSWER=1
      
      If(Mouse Zone=1 and Mouse Key=1) or Key State(67)
         Ink 2 : F Draw X+OFF+8,Y+H-4 To X+OFF+8+CX,Y+H-4 : F Draw X+OFF+8+CX,Y+H-17 To X+OFF+8+CX,Y+H-4
         Ink 1 : F Draw X+OFF+8,Y+H-17 To X+OFF+8,Y+H-4 : F Draw X+OFF+8,Y+H-17 To X+OFF+8+CX,Y+H-17
         ANSWER=True
      Else If(Mouse Zone=2 and Mouse Key=1) or Key State(69)
         Ink 2 : F Draw X+L-8-CX2,Y+H-4 To X+L-8,Y+H-4 : F Draw X+L-8,Y+H-17 To X+L-8,Y+H-4
         Ink 1 : F Draw X+L-8-CX2,Y+H-17 To X+L-8,Y+H-17 : F Draw X+L-8-CX2,Y+H-17 To X+L-8-CX2,Y+H-4
         ANSWER=False
      End If 
      
   Wend 
   Wait 10
   Cls 0,X,Y To X+L+1,Y+H+1
   Put Block 1,X,Y : Del Block 1
   Menu On : Reset Zone 
   Set Zone 1,45,25 To 132,46
   Set Zone 2,505,25 To 560,46
End Proc[ANSWER]
'
' procedure de gestion intuition 
'
Procedure _INT_SCREEN_CLOSE
   Areg(0)=_INTSCREEN(0)
   RES=Intcall(-$42)
   _INTSCREEN(0)=0
End Proc

Procedure _INT_IFF[FILE$]
   FOUNDBMHD=False
   FOUNDBODY=False
   FOUNDSQUASH=False
   
   If Not Exist(FILE$)
      Print "File not found."
      Pop Proc
   End If 
   If _INTSCREEN(0)<>0
      _INT_SCREEN_CLOSE
   End If 
   
   Timer=0
   Open In 1,FILE$ : L=Lof(1) : Close 1
   Print "File length:"+Str$(L)+" bytes"
   Reserve As Work 500,L
   SFILE=Start(500)
   Bload FILE$,SFILE
   TIMELOAD=Timer
   
   Timer=0
   If Peek$(SFILE,4)<>"FORM"
      Erase 500
      Print "Bad iff format."
      Pop Proc
   End If 
   
   Dreg(0)=Execall(-132)
   Comp Test Off 
   
   S=Hunt(SFILE To SFILE+Length(500),"CAMG")
   If S>0
      CAMGMODES=Leek(S+8)
   Else 
      CAMGMODES=$0
   End If 
   
   S=Hunt(SFILE To SFILE+Length(500),"BMHD")
   If S>0
      FOUNDBMHD=True
      Add S,8
      IWIDTH=Deek(S)
      IHEIGHT=Deek(S+2)
      IDEPTH=Peek(S+8)
      ICOMPR=Peek(S+10)
      IROWBYTES=IWIDTH/8
      SCRROWBYTES=Deek(S+16)/8
      SCROWBITS=Deek(S+16)/64
      If Deek(S+16)/64.0>SCROWBITS
         Inc SCROWBITS
         SCRROWBYTES=SCROWBITS*8
      End If 
      If IWIDTH/8.0>IROWBYTES
         Inc IROWBYTES
         If IROWBYTES/2.0<>IROWBYTES/2
            Inc IROWBYTES
         End If 
      End If 
      NCOLORS=Lsl.w(1,IDEPTH)
      If(CAMGMODES and $800)=$800
         If NCOLORS=256
            C0L0R=262144 : EXT$=" (Ham-8)"
         Else If NCOLORS=64
            C0L0R=4096 : EXT$=" (Ham-6)"
         End If 
      Else If(CAMGMODES and $80)=$80 and NCOLORS=64
         C0L0R=64 : EXT$=" (Half-bright)"
      Else 
         C0L0R=NCOLORS : EXT$=""
      End If 
      Print "Format:"+Str$(IWIDTH)+" x"+Str$(IHEIGHT)+" x"+Str$(C0L0R)+" colours"+EXT$+"."
      
      ' Assign TAG list  
      TS=$80000000+33
      SA_LEFT=TS
      SA_TOP=TS+1
      SA_WIDTH=TS+2
      SA_HEIGHT=TS+3
      SA_DEPTH=TS+4
      SA_ERRORCODE=TS+9
      SA_BITMAP=TS+13
      SA_DISPLAYID=TS+17
      SA_DCLIP=TS+18
      SA_OVERSCAN=TS+19
      ' *BOOLEANS* 
      SA_BEHIND=TS+22
      SA_QUIET=TS+23
      SA_AUTOSCROLL=TS+24
      SA_FULLPALETTE=TS+26
      SA_COLORMAPENTRIES=TS+27
      SA_DRAGGABLE=TS+29
      SA_INTERLEAVED=TS+33
      SA_COLORS32=TS+34

      ' Create Taglist... add tags at your choice... 
      TAGSTART
      TAG[SA_QUIET,-1]
      TAG[SA_DISPLAYID,CAMGMODES]
      TAG[SA_WIDTH,Max(SCRROWBYTES*8,128)]
      TAG[SA_HEIGHT,Max(IHEIGHT,48)]
      TAG[SA_DEPTH,IDEPTH]
      TAG[SA_AUTOSCROLL,1]
'      TAG[SA_OVERSCAN,704]
      TAG[0,0]
      
      ' Now open the screen... 
      Areg(0)=0 : Areg(1)=Start(15)
      _INTSCREEN(0)=Intcall(-$264) : Rem OpenScreenTagList
      
      If _INTSCREEN(0)=0
         Comp Test On 
         Dreg(0)=Execall(-138)
         Erase 500 : Erase 501
         Print "Out of chip memory."
         Pop Proc
      End If 
      
      _INTSCREEN(1)=_INTSCREEN(0)+44
      _INTSCREEN(3)=Leek(_INTSCREEN(1)+4)
      _INTSCREEN(4)=Leek(_INTSCREEN(3)+4)
      _INTSCREEN(5)=Leek(_INTSCREEN(0)+88)
      _INTSCREEN(6)=Deek(_INTSCREEN(0)+12)
      _INTSCREEN(7)=Deek(_INTSCREEN(0)+14)
      _INTSCREEN(8)=Peek(_INTSCREEN(5)+5)
      For KK=0 To _INTSCREEN(8)-1
         _INTSCREEN(9+KK)=Leek(_INTSCREEN(5)+8+(Lsl.b(KK,2)))
      Next KK
      
      _INT_CLS[0,0,_INTSCREEN(6)-1,16,0]
      Erase 501
   End If 
   S=Hunt(SFILE To SFILE+Length(500),"SQUASH")
   If S>0
      Add S,6
      FOUNDSQUASH=True
      For PP=0 To IDEPTH-1
         _LENGTH(PP)=Leek(S+(Lsl.b(PP,2)))
      Next PP
   End If 
   S=Hunt(SFILE To SFILE+Length(500),"BODY")
   If S>0 and FOUNDBMHD=True
      FOUNDBODY=True
      Add S,8
      
      HEIGHT=IHEIGHT-1
      DEPTH=_INTSCREEN(8)-1
      BOUCLE=8+_INTSCREEN(8)
      
      If ICOMPR=0
         For RR=0 To HEIGHT
            ELLOW=RR*SCRROWBYTES
            For PP=9 To BOUCLE
               Copy S,S+IROWBYTES To _INTSCREEN(PP)+ELLOW
               Add S,IROWBYTES
            Next PP
         Next RR
         
      Else If ICOMPR=1
         For RR=0 To HEIGHT
            ELLOW=RR*SCRROWBYTES
            For PP=9 To BOUCLE
               SCRROW=_INTSCREEN(PP)+ELLOW
               BCNT=0
               While BCNT<IROWBYTES
                  _INCODE=Peek(S) : Inc S
                  If _INCODE<128
                     Inc _INCODE
                     Copy S,S+_INCODE To SCRROW+BCNT
                     Add S,_INCODE
                  Else If _INCODE>128
                     _INCODE=257-_INCODE
                     INBYTE=Peek(S) : Inc S
                     If INBYTE<>0
                        BOUCLE1=SCRROW+BCNT
                        BOUCLE2=BOUCLE1+_INCODE-1
                        For KK=BOUCLE1 To BOUCLE2
                           Poke KK,INBYTE
                        Next KK
                     End If 
                  End If 
                  Add BCNT,_INCODE
               Wend 
            Next PP
         Next RR
         
      Else If ICOMPR=128 and FOUNDSQUASH=True
         For PP=0 To DEPTH
            Copy S,S+_LENGTH(PP) To _INTSCREEN(9+PP)
            L=Unsquash(_INTSCREEN(9+PP),_LENGTH(PP))
            Add S,_LENGTH(PP)
         Next PP
      Else 
         _INT_SCREEN_CLOSE
         Comp Test On 
         Dreg(0)=Execall(-138)
         Print "Iff compression not recognised."
         Erase 500
         Pop Proc
      End If 
'      If IWIDTH<_INTSCREEN(6) 
'         _INT_CLS[IWIDTH,0,_INTSCREEN(6)-1,_INTSCREEN(7)-1,0] 
'      End If  
   End If 
   S=Hunt(SFILE To SFILE+Length(500),"CMAP")
   If S>0 and FOUNDBMHD=True
      Add S,8
      Areg(0)=_INTSCREEN(1)
      For KK=0 To NCOLORS-1
         Dreg(0)=KK
         Dreg(1)=Lsl.l(L Swap(Peek(S)),8) : Inc S
         Dreg(2)=Lsl.l(L Swap(Peek(S)),8) : Inc S
         Dreg(3)=Lsl.l(L Swap(Peek(S)),8) : Inc S
         F=Gfxcall(-852)
      Next KK
   End If 
   TIMEDECRUNCH=Timer
   
   Erase 500
   Comp Test On 
   Dreg(0)=Execall(-138)
   
   Print "Loading time:"+Str$(TIMELOAD/50.0)+" secondes. Decrunching time:"+Str$(TIMEDECRUNCH/50.0)+" secondes."
   Print "Done."
End Proc
Procedure _INT_IFF_SAVE[FILE$,COMPRESS]
   Comp Test Off 
   
   _SCREEN=_INTSCREEN(0)
   Timer=0
   TAILLE=Lsr.w(Deek(_SCREEN+12),3)*Deek(_SCREEN+14)*_INTSCREEN(8)
   TAILLE_CMAP=Lsl.w(1,_INTSCREEN(8))*3
   If COMPRESS=128
      EXTENSION=6+(Lsl.b(_INTSCREEN(8),2))
   Else 
      EXTENSION=0
   End If 
   TAILLE_FILE=76+TAILLE+TAILLE_CMAP+EXTENSION
   Reserve As Data 1000,TAILLE_FILE
   S=Start(1000)
   Poke$ S,"FORM"
   TAILLE_GLOBAL=S+4
   Add S,8
   Poke$ S,"ILBMBMHD"
   Loke S+8,20
   Add S,12
   Doke S,Deek(_SCREEN+12)
   Doke S+2,Deek(_SCREEN+14)
   Loke S+4,0
   Poke S+8,_INTSCREEN(8)
   Poke S+9,0
   Poke S+10,COMPRESS
   Doke S+12,0
   Doke S+14,$A0B
   Doke S+16,Deek(_INTSCREEN(1)+24)
   Doke S+18,Deek(_INTSCREEN(1)+26)
   Add S,20
   Poke$ S,"CMAP"
   Loke S+4,TAILLE_CMAP
   Add S,8
   Reserve As Work 500,12
   Areg(0)=_INTSCREEN(3)
   Areg(1)=Start(500)
   Dreg(1)=1
   For KK=0 To Lsl.w(1,_INTSCREEN(8))-1
      Dreg(0)=KK
      G=Gfxcall(-900)
      Poke S,Peek(Areg(1)) : Inc S
      Poke S,Peek(Areg(1)+4) : Inc S
      Poke S,Peek(Areg(1)+8) : Inc S
   Next KK
   Erase 500
   Poke$ S,"CAMG"
   Loke S+4,4
   Loke S+8,Deek(_INTSCREEN(1)+32)
   Add S,12
   Poke$ S,"BODY"
   SLEN=S+4
   Loke SLEN,TAILLE
   Add S,8
   If COMPRESS=0
      SCRROWBYTES=Lsr.w(Deek(_SCREEN+12),3)
      For RR=0 To Deek(_SCREEN+14)-1
         For PP=0 To _INTSCREEN(8)-1
            SCRROW=_INTSCREEN(9+PP)+(RR*SCRROWBYTES)
            Copy SCRROW,SCRROW+SCRROWBYTES To S
            Add S,SCRROWBYTES
         Next PP
      Next RR
   Else If COMPRESS=128
      PLANE=(Lsr.w(Deek(_SCREEN+12),3))*Deek(_SCREEN+14)
      TAILLE=0
      For PP=0 To _INTSCREEN(8)-1
         _LENGTH(PP)=Squash(_INTSCREEN(9+PP),PLANE,-1,4095,0)
         If _LENGTH(PP)<0
            _INT_SCREEN_CLOSE
            Comp Test On 
            Erase 1000
            Print "Compression Failed. Use Cmp 0 to save file."
            Pop Proc
         End If 
         Copy _INTSCREEN(9+PP),_INTSCREEN(9+PP)+_LENGTH(PP) To S
         Add S,_LENGTH(PP) : Add TAILLE,_LENGTH(PP)
      Next PP
      Loke SLEN,TAILLE
      Bank Shrink 1000 To TAILLE+76+TAILLE_CMAP+EXTENSION
      Poke$ S,"SQUASH"
      Add S,6
      For L=0 To _INTSCREEN(8)-1
         Loke S+Lsl.b(L,2),_LENGTH(L)
      Next L
   End If 
   TAILLE=Length(1000)-8
   Loke TAILLE_GLOBAL,TAILLE
   
   Comp Test On 
   
   TIMECRUNCH#=Timer/50.0
   Print "File length:"+Str$(Length(1000))+" bytes"
   Timer=0
   Wait Vbl 
   Bsave FILE$,Start(1000) To Start(1000)+Length(1000)
   Wait Vbl 
   Print "Saving time:"+Str$(Timer/50.0)+" secondes. Crunching time:"+Str$(TIMECRUNCH#)+" secondes."
   _INT_SCREEN_CLOSE
   Erase 1000
End Proc
Procedure _INT_CLS[X1,Y1,X2,Y2,C0ULEUR]
      ' SETAPEN()
      Areg(1)=_INTSCREEN(0)+84
      Dreg(0)=C0ULEUR
      F=Gfxcall(-342)
      ' RECTFILL() 
      Areg(1)=_INTSCREEN(0)+84
      Dreg(0)=X1 : Dreg(1)=Y1
      Dreg(2)=X2 : Dreg(3)=Y2
      F=Gfxcall(-306)
End Proc

Procedure TAGSTART
  Shared TAGST
  Reserve As Work 15,128
  TAGST=Start(15)
End Proc
Procedure TAG[TAG,V]
  Shared TAGST
  Loke TAGST,TAG : Loke TAGST+4,V : Add TAGST,8
End Proc
