' AP20 V3 P3 TEST ONLY - R82 monolith plus independent second native unit.
' INSTALL ONLY IN A DISPOSABLE WINUAE MC68020+ TEST CONFIGURATION!
' This program has NOT been executed or compiled in real AMOS.
' DO NOT replace the approved R82 LAST_GOOD installation.
Cls
Print "AP20 V3 MULTIUNIT TEST ONLY"
_RESULT=1
_ERR=0
_PROBE=0
_R82_DETECT=0
_R82_OK=0
_V3_OK=0
_CHIP0=Chip Free
_FAST0=Fast Free
_PSTATE=Prg State
_RUNMODE$="UNKNOWN"
_LOGFILE$="RAM:AP20_V3_UNKNOWN.TXT"
If _PSTATE=0
   _RUNMODE$="INTERPRETED"
   _LOGFILE$="RAM:AP20_V3_INTERPRETED.TXT"
End If
If _PSTATE=1
   _RUNMODE$="RUNTIME"
   _LOGFILE$="RAM:AP20_V3_RUNTIME.TXT"
End If
If _PSTATE=-1
   _RUNMODE$="COMPILED"
   _LOGFILE$="RAM:AP20_V3_COMPILED.TXT"
End If
_CPU$="UNKNOWN"
_CPUFLAGS=0
_SYSBASE=Leek(4)
If _SYSBASE=0
   _ERR=10
   Goto CLEANUP
End If
_CPUFLAGS=Deek(_SYSBASE+296)
_CPU_OK=0
If (_CPUFLAGS And 2)<>0
   _CPU_OK=1
   _CPU$="68020"
End If
If (_CPUFLAGS And 4)<>0
   _CPU_OK=1
   _CPU$="68030"
End If
If (_CPUFLAGS And 8)<>0
   _CPU_OK=1
   _CPU$="68040"
End If
If (_CPUFLAGS And 128)<>0
   _CPU_OK=1
   _CPU$="68060"
End If
If _CPU_OK=0
   _ERR=11
   Goto CLEANUP
End If
' Exercise both original R82 API and new second native unit.
_R82_DETECT=Aga Detect
If _R82_DETECT=0
   _ERR=12
   Goto CLEANUP
End If
_R82_OK=1
_PROBE=Aga V3 Size Probe
If _PROBE<>77
   _ERR=13
   Goto CLEANUP
End If
_V3_OK=1
CLEANUP:
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free
_FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "R82 DETECT ";_R82_DETECT;" V3 PROBE ";_PROBE
Print "RESULT ";_RESULT;" ERR ";_ERR
_LOGERR=0
_CLOSEERR=0
Trap Open Out 1,_LOGFILE$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST AP20_V3_R82_MULTIUNIT_P3"
   Print #1,"VERSION R82 BASE EXPERIMENT V3 TEST ONLY"
   Print #1,"RUN_MODE ";_RUNMODE$
   Print #1,"PRG_STATE ";_PSTATE
   Print #1,"CPU ";_CPU$
   Print #1,"CPU_ATTNFLAGS ";_CPUFLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"R82_DETECT ";_R82_DETECT
   Print #1,"R82_OK ";_R82_OK
   Print #1,"V3_PROBE ";_PROBE
   Print #1,"V3_OK ";_V3_OK
   Print #1,"ERR ";_ERR
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOGFILE$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
End
