' V2 graphics benchmark - AMOS / AMCAF / AGA / 320x256x32.
' Requires AMCAF 1.40+ and AMOSPro_AGA.Lib R43 or later.
' R44 v0.11.5 recommended. V2 interpreted WinUAE test PENDING.
' IMPORTANT: all drawing uses colour index 31 (five bitplanes).
' The AGA extension has its OWN private screen and Safe back buffer.
' AMCAF uses 4 Turbo Draw per BOX, 5 Bcircle per CIRCLE.
' AMCAF has no like-for-like BAR, so its BAR cell is N/A (-1).
' 1 TIMER tick = 20 ms. Report 3 INDEPENDENT raw trials.
' Plot and circle loads increased after V1 user measurements.
_NP=120000
_NL=400
_NB=225
_NC=8000
_NF=100
_NE=80
_TRIALS=3
Dim _TM(2,5,2)
_ERR=0
Cls
Print "GRAPHICS 32C - AMOS / AMCAF / AGA"
Print "REQUIRES AMCAF AND AGA EXTENSION"
Screen Open 0,320,256,32,Lowres
Colour 0,$000
Colour 31,$FFF
Flash Off
Curs Off
Set Line $FFFF
Set Paint 0
Set Pattern 0
Gr Writing 1
Ink 31
' ---- NATIVE 320x256x32 ----
For _TR=1 To _TRIALS
   ' PLOT - preparation and warmup outside timing
   Plot 22,32
   Cls 0
   Blitter Wait
   _T0=Timer
   For _I=1 To _NP
      _X=(_I*73) Mod 320
      _Y=(_I*41) Mod 256
      Plot _X,_Y
   Next _I
   Blitter Wait
   _TM(0,0,_TR-1)=Timer-_T0
   ' DRAW - preparation and warmup outside timing
   Draw 20,20 To 210,170
   Cls 0
   Blitter Wait
   _T0=Timer
   For _I=1 To _NL
      _Y=8+(_I Mod 200)
      _Y2=247-(_I Mod 200)
      Draw 8,_Y To 311,_Y2
   Next _I
   Blitter Wait
   _TM(0,1,_TR-1)=Timer-_T0
   ' BOX - preparation and warmup outside timing
   Box 20,20 To 210,170
   Cls 0
   Blitter Wait
   _T0=Timer
   For _I=1 To _NB
      _X=20+(_I Mod 24)
      _Y=25+(_I Mod 16)
      _X2=300-_X
      _Y2=230-_Y
      Box _X,_Y To _X2,_Y2
   Next _I
   Blitter Wait
   _TM(0,2,_TR-1)=Timer-_T0
   ' CIRCLE - preparation and warmup outside timing
   Circle 160,128,32
   Cls 0
   Blitter Wait
   _T0=Timer
   For _I=1 To _NC
      _R=16+(_I Mod 48)
      Circle 160,128,_R
   Next _I
   Blitter Wait
   _TM(0,3,_TR-1)=Timer-_T0
   ' BAR - preparation and warmup outside timing
   Bar 60,60 To 259,195
   Cls 0
   Blitter Wait
   _T0=Timer
   For _I=1 To _NF
      Bar 60,60 To 259,195
   Next _I
   Blitter Wait
   _TM(0,4,_TR-1)=Timer-_T0
   ' CLEAR - preparation and warmup outside timing
   Cls 0
   Cls 0
   Bar 0,0 To 319,255
   Blitter Wait
   _T0=Timer
   For _I=1 To _NE
      Cls 0
   Next _I
   Blitter Wait
   _TM(0,5,_TR-1)=Timer-_T0
Next _TR
' Native geometry review (not timed).
Cls 0
Box 25,35 To 294,220
Circle 160,128,50
Draw 25,35 To 294,220
Plot 160,128
Bar 50,205 To 90,215
Wait 35
' ---- AMCAF 320x256x32 ----
' AMCAF calls operate on the same AMOS screen as native calls.
For _TR=1 To _TRIALS
   ' PLOT - preparation and warmup outside timing
   Turbo Plot 22,32,31
   Cls 0
   Blitter Wait
   _T0=Timer
   For _I=1 To _NP
      _X=(_I*73) Mod 320
      _Y=(_I*41) Mod 256
      Turbo Plot _X,_Y,31
   Next _I
   Blitter Wait
   _TM(1,0,_TR-1)=Timer-_T0
   ' DRAW - preparation and warmup outside timing
   Turbo Draw 20,20 To 210,170,31
   Cls 0
   Blitter Wait
   _T0=Timer
   For _I=1 To _NL
      _Y=8+(_I Mod 200)
      _Y2=247-(_I Mod 200)
      Turbo Draw 8,_Y To 311,_Y2,31
   Next _I
   Blitter Wait
   _TM(1,1,_TR-1)=Timer-_T0
   ' BOX - preparation and warmup outside timing
   Turbo Draw 20,20 To 210,20,31
   Cls 0
   Blitter Wait
   _T0=Timer
   For _I=1 To _NB
      _X=20+(_I Mod 24)
      _Y=25+(_I Mod 16)
      _X2=300-_X
      _Y2=230-_Y
      Turbo Draw _X,_Y To _X2,_Y,31
      Turbo Draw _X2,_Y To _X2,_Y2,31
      Turbo Draw _X2,_Y2 To _X,_Y2,31
      Turbo Draw _X,_Y2 To _X,_Y,31
   Next _I
   Blitter Wait
   _TM(1,2,_TR-1)=Timer-_T0
   ' CIRCLE - preparation and warmup outside timing
   Bcircle 160,128,32,0
   Bcircle 160,128,32,1
   Bcircle 160,128,32,2
   Bcircle 160,128,32,3
   Bcircle 160,128,32,4
   Cls 0
   Blitter Wait
   _T0=Timer
   For _I=1 To _NC
      _R=16+(_I Mod 48)
      Bcircle 160,128,_R,0
      Bcircle 160,128,_R,1
      Bcircle 160,128,_R,2
      Bcircle 160,128,_R,3
      Bcircle 160,128,_R,4
   Next _I
   Blitter Wait
   _TM(1,3,_TR-1)=Timer-_T0
   ' CLEAR - preparation and warmup outside timing
   Blitter Clear 0,0
   Blitter Wait
   Cls 0
   Bar 0,0 To 319,255
   Blitter Wait
   _T0=Timer
   For _I=1 To _NE
      Blitter Clear 0,0
      Blitter Clear 0,1
      Blitter Clear 0,2
      Blitter Clear 0,3
      Blitter Clear 0,4
      Blitter Wait
   Next _I
   Blitter Wait
   _TM(1,5,_TR-1)=Timer-_T0
Next _TR
' AMCAF geometry review (not timed).
Cls 0
Turbo Draw 25,35 To 294,35,31
Turbo Draw 294,35 To 294,220,31
Turbo Draw 294,220 To 25,220,31
Turbo Draw 25,220 To 25,35,31
Bcircle 160,128,50,0
Bcircle 160,128,50,1
Bcircle 160,128,50,2
Bcircle 160,128,50,3
Bcircle 160,128,50,4
Turbo Draw 25,35 To 294,220,31
Turbo Plot 160,128,31
Blitter Wait
Wait 35
' ---- AGA 320x256x32 ----
' Keep AMOS screen 0 alive for the final results display.
_OPEN=Aga Screen Open(320,256,32,$00021000)
If _OPEN<>1
   Print "AGA OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,0,0,0)
_P31=Aga Palette Set(31,255,255,255)
_LBL=Aga Text(12,35,31,"32C BENCHMARK RUNNING")
_SW=Aga Swap
If _P0<>1 or _P31<>1 or _LBL<>1 or _SW<>1
   Aga Screen Close
   Amos To Front
   Print "AGA INITIAL DISPLAY FAILED"
   End
End If
Amos To Back
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
If _READY<>1
   Aga Screen Close
   Amos To Front
   Print "AGA BACK NOT SAFE"
   End
End If
For _TR=1 To _TRIALS
   ' PLOT - preparation and warmup outside timing
   _OK=Aga Plot(22,32,31)
   _OK=Aga Blit Clear(0,0,320,256)
   _T0=Timer
   For _I=1 To _NP
      _X=(_I*73) Mod 320
      _Y=(_I*41) Mod 256
      _OK=Aga Plot(_X,_Y,31)
   Next _I
   _TM(2,0,_TR-1)=Timer-_T0
   If _OK<>1
      _ERR=_ERR+1
   End If
   ' DRAW - preparation and warmup outside timing
   _OK=Aga Draw(20,20,210,170,31)
   _OK=Aga Blit Clear(0,0,320,256)
   _T0=Timer
   For _I=1 To _NL
      _Y=8+(_I Mod 200)
      _Y2=247-(_I Mod 200)
      _OK=Aga Draw(8,_Y,311,_Y2,31)
   Next _I
   _TM(2,1,_TR-1)=Timer-_T0
   If _OK<>1
      _ERR=_ERR+1
   End If
   ' BOX - preparation and warmup outside timing
   _OK=Aga Box(20,20,210,170,31)
   _OK=Aga Blit Clear(0,0,320,256)
   _T0=Timer
   For _I=1 To _NB
      _X=20+(_I Mod 24)
      _Y=25+(_I Mod 16)
      _X2=300-_X
      _Y2=230-_Y
      _OK=Aga Box(_X,_Y,_X2,_Y2,31)
   Next _I
   _TM(2,2,_TR-1)=Timer-_T0
   If _OK<>1
      _ERR=_ERR+1
   End If
   ' CIRCLE - preparation and warmup outside timing
   _OK=Aga Circle(160,128,32,31)
   _OK=Aga Blit Clear(0,0,320,256)
   _T0=Timer
   For _I=1 To _NC
      _R=16+(_I Mod 48)
      _OK=Aga Circle(160,128,_R,31)
   Next _I
   _TM(2,3,_TR-1)=Timer-_T0
   If _OK<>1
      _ERR=_ERR+1
   End If
   ' BAR - preparation and warmup outside timing
   _OK=Aga Blit Fill(60,60,200,136,31)
   _OK=Aga Blit Clear(0,0,320,256)
   _T0=Timer
   For _I=1 To _NF
      _OK=Aga Blit Fill(60,60,200,136,31)
   Next _I
   _TM(2,4,_TR-1)=Timer-_T0
   If _OK<>1
      _ERR=_ERR+1
   End If
   ' CLEAR - preparation and warmup outside timing
   _OK=Aga Blit Clear(0,0,320,256)
   _OK=Aga Blit Clear(0,0,320,256)
   _OK=Aga Blit Fill(0,0,320,256,31)
   _T0=Timer
   For _I=1 To _NE
      _OK=Aga Blit Clear(0,0,320,256)
   Next _I
   _TM(2,5,_TR-1)=Timer-_T0
   If _OK<>1
      _ERR=_ERR+1
   End If
Next _TR
' AGA geometry review and presentation (NOT timed).
_OK=Aga Blit Clear(0,0,320,256)
_OK=Aga Box(25,35,294,220,31)
_OK=Aga Circle(160,128,50,31)
_OK=Aga Draw(25,35,294,220,31)
_OK=Aga Plot(160,128,31)
_OK=Aga Blit Fill(50,205,41,11,31)
_SW=Aga Swap
If _SW<>1
   _ERR=_ERR+1
End If
For _I=1 To 75
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
' V2 raw results: three separate elapsed tick counts per engine.
Cls
Print "BENCH V2 / 320X256X32 / PAL"
Print "3 RUNS / 1 TICK = 20 MS"
Print "A=AMOS  M=AMCAF  G=AGA"
Print "PLOT 120K A ";_TM(0,0,0);" ";_TM(0,0,1);" ";_TM(0,0,2)
Print "PLOT 120K M ";_TM(1,0,0);" ";_TM(1,0,1);" ";_TM(1,0,2)
Print "PLOT 120K G ";_TM(2,0,0);" ";_TM(2,0,1);" ";_TM(2,0,2)
Print "DRAW 400 A ";_TM(0,1,0);" ";_TM(0,1,1);" ";_TM(0,1,2)
Print "DRAW 400 M ";_TM(1,1,0);" ";_TM(1,1,1);" ";_TM(1,1,2)
Print "DRAW 400 G ";_TM(2,1,0);" ";_TM(2,1,1);" ";_TM(2,1,2)
Print "BOX 225 A ";_TM(0,2,0);" ";_TM(0,2,1);" ";_TM(0,2,2)
Print "BOX 225 M ";_TM(1,2,0);" ";_TM(1,2,1);" ";_TM(1,2,2)
Print "BOX 225 G ";_TM(2,2,0);" ";_TM(2,2,1);" ";_TM(2,2,2)
Print "CIRCLE 8000 A ";_TM(0,3,0);" ";_TM(0,3,1);" ";_TM(0,3,2)
Print "CIRCLE 8000 M ";_TM(1,3,0);" ";_TM(1,3,1);" ";_TM(1,3,2)
Print "CIRCLE 8000 G ";_TM(2,3,0);" ";_TM(2,3,1);" ";_TM(2,3,2)
Print "BAR 100 A ";_TM(0,4,0);" ";_TM(0,4,1);" ";_TM(0,4,2)
Print "BAR M N/A"
Print "BAR 100 G ";_TM(2,4,0);" ";_TM(2,4,1);" ";_TM(2,4,2)
Print "CLEAR 80 A ";_TM(0,5,0);" ";_TM(0,5,1);" ";_TM(0,5,2)
Print "CLEAR 80 M ";_TM(1,5,0);" ";_TM(1,5,1);" ";_TM(1,5,2)
Print "CLEAR 80 G ";_TM(2,5,0);" ";_TM(2,5,1);" ";_TM(2,5,2)
Print "AGA ERR ";_ERR
Print "CIRCLE M = 5 BCIRCLE / RING"
Print "V2 FINISHED - CLOSE RETURNED"
End
