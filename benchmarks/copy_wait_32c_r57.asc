' M17-R57-COPY-WAIT-01 / interpreted timing diagnosis.
' Copy 64x48 with native Screen Copy, Screen Copy + Blitter Wait,
' and Aga Blit Copy. NO changes to AGA library or hardware registers.
' Screen Copy end coordinates are EXCLUSIVE (sx+w,sy+h).
' Requires AMOS Pro, AMCAF Blitter Wait, and active AGA R57.
' PAL 320x256x32 (5 planes). Timer: 1 tick = 20 ms.
' Three geometries, 1200 copies per run, 3 runs per method.
' Native source pattern is reset identically before A and W runs.
Dim _TM(2,2,2)
_ERR=0
Cls
Print "M17-R57-COPY-WAIT-01"
Print "AMOS SCREEN COPY / WAIT / AGA"
Print "320X256X32 PAL / 3 RUNS"
Screen Open 0,320,256,32,Lowres
Colour 0,$000
Colour 7,$F00
Colour 31,$FFF
Flash Off
Curs Off
Gr Writing 1
Set Pattern 0
Set Paint 0
_OPEN=Aga Screen Open(320,256,32,$00021000)
If _OPEN<>1
   Print "AGA OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,0,0,0)
_P7=Aga Palette Set(7,255,0,0)
_P31=Aga Palette Set(31,255,255,255)
_SW=Aga Swap
If _P0<>1 or _P7<>1 or _P31<>1 or _SW<>1
   Aga Screen Close
   Amos To Front
   Print "AGA INIT FAILED"
   End
End If
Amos To Back
' Acquire Safe once; NO swaps during benchmark.
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
If _READY<>1
   Aga Screen Close
   Amos To Front
   Print "AGA BACK NOT SAFE"
   End
End If
_W=64 : _H=48 : _N=1200
For _CASE=0 To 2
   ' All three cases are non-overlapping copies, same 64x48 area.
   If _CASE=0
      ' Both X coordinates and rectangle width 16-pixel aligned.
      _SX=16 : _SY=24 : _DX=176 : _DY=24
   End If
   If _CASE=1
      ' Identical width/height, both X shifted by one pixel.
      _SX=17 : _SY=24 : _DX=177 : _DY=24
   End If
   If _CASE=2
      ' Identical aligned X; destination on different scanlines.
      _SX=16 : _SY=24 : _DX=176 : _DY=96
   End If
   _SX2=_SX+_W
   _SY2=_SY+_H
   For _TR=1 To 3
      ' A = AMOS native, one explicit Blitter Wait AFTER the series.
      ' Source reset and its synchronisation are NOT timed.
      Cls 0
      Ink 31
      Bar _SX,_SY To _SX+_W-1,_SY+_H-1
      Ink 7
      Bar _SX+8,_SY+8 To _SX+_W-9,_SY+_H-9
      Blitter Wait
      _T0=Timer
      For _I=1 To _N
         Screen Copy 0,_SX,_SY,_SX2,_SY2 To 0,_DX,_DY
      Next _I
      Blitter Wait
      _TM(0,_CASE,_TR-1)=Timer-_T0

      ' W = same Screen Copy plus explicit Blitter Wait EACH call.
      ' Repeat the same source reset OUTSIDE timed operations.
      Cls 0
      Ink 31
      Bar _SX,_SY To _SX+_W-1,_SY+_H-1
      Ink 7
      Bar _SX+8,_SY+8 To _SX+_W-9,_SY+_H-9
      Blitter Wait
      _T0=Timer
      For _I=1 To _N
         Screen Copy 0,_SX,_SY,_SX2,_SY2 To 0,_DX,_DY
         Blitter Wait
      Next _I
      _TM(1,_CASE,_TR-1)=Timer-_T0

      ' G = AGA R57 copy (internal WaitBlit), same geometry.
      ' No swaps after initial safe acquisition.
      _K0=Aga Blit Clear(0,0,320,256)
      _K1=Aga Blit Fill(_SX,_SY,_W,_H,31)
      _K2=Aga Blit Fill(_SX+8,_SY+8,_W-16,_H-16,7)
      If _K0<>1 or _K1<>1 or _K2<>1
         Aga Screen Close
         Amos To Front
         Print "AGA PREP FAILED CASE ";_CASE
         End
      End If
      _T0=Timer
      For _I=1 To _N
         _OK=Aga Blit Copy(_SX,_SY,_DX,_DY,_W,_H)
      Next _I
      _TM(2,_CASE,_TR-1)=Timer-_T0
      If _OK<>1
         _ERR=_ERR+1
      End If
   Next _TR
Next _CASE
Aga Screen Close
Amos To Front
Cls
Print "COPY WAIT R57 / 320X256X32"
Print "INTERPRETED / 1 TICK=20 MS"
Print "3 RUNS / 1200 COPIES EACH"
Print "A=AMOS W=AMOS+WAIT G=AGA"
Print "64X48 / ALIGNED"
Print "A ";_TM(0,0,0);" ";_TM(0,0,1);" ";_TM(0,0,2)
Print "W ";_TM(1,0,0);" ";_TM(1,0,1);" ";_TM(1,0,2)
Print "G ";_TM(2,0,0);" ";_TM(2,0,1);" ";_TM(2,0,2)
Print "64X48 / SHIFT X +1"
Print "A ";_TM(0,1,0);" ";_TM(0,1,1);" ";_TM(0,1,2)
Print "W ";_TM(1,1,0);" ";_TM(1,1,1);" ";_TM(1,1,2)
Print "G ";_TM(2,1,0);" ";_TM(2,1,1);" ";_TM(2,1,2)
Print "64X48 / DEST Y +72"
Print "A ";_TM(0,2,0);" ";_TM(0,2,1);" ";_TM(0,2,2)
Print "W ";_TM(1,2,0);" ";_TM(1,2,1);" ";_TM(1,2,2)
Print "G ";_TM(2,2,0);" ";_TM(2,2,1);" ";_TM(2,2,2)
Print "AGA ERR ";_ERR
Print "COPY WAIT FINISHED - CLOSE RETURNED"
Do
   Wait Vbl
Loop
