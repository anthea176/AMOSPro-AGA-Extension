' OPT020 P1E R60/R69 - BENCHMARK ONLY - AMOS INTERPRETED.
' Run EXACTLY the same ASC under R68 LAST_GOOD (R60 painter), then R69.
' WinUAE PAL AGA 68020 14 MHz, JIT OFF, same RAM and settings.
' Bench lives in benchmarks/, NOT a second tests/current active ASC.
' Load replaces bank 10. Use a disposable WinUAE session.
' 64x40x4 AGAPIC bank. Timer: 1 PAL tick = 20 ms.
' THREE runs per case; identical loops, only the library is changed.
' No Swap/Wait/Print inside timed loops. No AMOS Compiler.
Dim _TM(9,2)
_N=240
_ERR=0
Cls
Print "OPT020-P1E R60/R69 BENCH"
If Aga Detect=0
   Print "AGA CHIPSET MISSING"
   End
End If
Load "M16_AGAPIC_SAMPLE_BANK10.abk",10
If Start(10)=0 or Length(10)<>1836
   Print "AGAPIC BANK 10 MISSING"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   Erase 10
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 10
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_SW=0
For _TRY=1 To 20
   If _SW=0
      _SW=Aga Swap
   End If
   If _SW=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW<>1
   Aga Screen Close
   Amos To Front
   Erase 10
   Print "AGA SWAP FAILED"
   End
End If
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
If _READY<>1
   Aga Screen Close
   Amos To Front
   Erase 10
   Print "AGA BACK NOT SAFE"
   End
End If
Amos To Back
' Case setup is OUTSIDE timing. All cases draw to inactive bitmap.
' Source center 24,12..39,27 has substantial independent mask coverage.
For _CASE=0 To 9
   _SX=24 : _SY=12 : _W=16 : _H=16
   _X=160 : _Y=64 : _MODE=0
   If _CASE=0
      _X=320
   End If
   If _CASE=1
      _SX=32 : _SY=20 : _W=1 : _H=1
      _X=160 : _Y=40
   End If
   If _CASE=2
      _X=160 : _Y=64
   End If
   If _CASE=3
      _X=160 : _Y=88 : _MODE=1
   End If
   If _CASE=4
      _X=161 : _Y=112
   End If
   If _CASE=5
      _X=161 : _Y=136 : _MODE=1
   End If
   If _CASE=6
      _SX=23 : _SY=12 : _W=17
      _X=313 : _Y=160 : _MODE=1
   End If
   If _CASE=7
      _SX=16 : _SY=8 : _W=32 : _H=20
      _X=160 : _Y=184
   End If
   If _CASE=8
      _SX=16 : _SY=8 : _W=32 : _H=20
      _X=161 : _Y=216 : _MODE=1
   End If
   If _CASE=9
      _SX=23 : _SY=12 : _W=17 : _H=16
      _X=163 : _Y=160 : _MODE=1
   End If
   ' One warm-up call outside timing for comparable first-call effects.
   _OK=Aga Image Region(10,_SX,_SY,_W,_H,_X,_Y,_MODE)
   If _OK<>1
      Inc _ERR
   End If
   For _TR=0 To 2
      _SUM=0
      _T0=Timer
      For _I=1 To _N
         _OK=Aga Image Region(10,_SX,_SY,_W,_H,_X,_Y,_MODE)
         _SUM=_SUM+_OK
      Next _I
      _TM(_CASE,_TR)=Timer-_T0
      If _SUM<>_N
         Inc _ERR
      End If
   Next _TR
Next _CASE
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
Erase 10
_CF1=Chip Free
_RESULT=1
If _ERR<>0 or _CLOSED<>-1 or _CF0<>_CF1
   _RESULT=0
End If
Cls
Print "OPT020-P1E R60/R69 BENCH"
Print "PAL16 JIT OFF N=240 TRIALS=3"
Print "LABEL CAPTURE R68 OR R69"
Print "TICKS: A B C / 1 TICK=20MS"
Print "OFF16  ";_TM(0,0);" ";_TM(0,1);" ";_TM(0,2)
Print "ONEPX  ";_TM(1,0);" ";_TM(1,1);" ";_TM(1,2)
Print "OPA16  ";_TM(2,0);" ";_TM(2,1);" ";_TM(2,2)
Print "MSK16  ";_TM(3,0);" ";_TM(3,1);" ";_TM(3,2)
Print "OPA+1  ";_TM(4,0);" ";_TM(4,1);" ";_TM(4,2)
Print "MSK+1  ";_TM(5,0);" ";_TM(5,1);" ";_TM(5,2)
Print "CLIP17 ";_TM(6,0);" ";_TM(6,1);" ";_TM(6,2)
Print "OPA32  ";_TM(7,0);" ";_TM(7,1);" ";_TM(7,2)
Print "MSK32  ";_TM(8,0);" ";_TM(8,1);" ";_TM(8,2)
Print "FRG17  ";_TM(9,0);" ";_TM(9,1);" ";_TM(9,2)
Print "ERR ";_ERR;" CLOSE ";_CLOSED
Print "CHIP BEFORE/END ";_CF0;" ";_CF1
Print "RESULT ";_RESULT
Print "BENCH FINISHED - CLOSE RETURNED"
Do
   Wait Vbl
Loop
