' M18 R60 16x16 PRELIMINARY CPU versus BLITTER COPY BENCH.
' NOT a Fast Icon benchmark! CPU decodes AGAPIC; Blitter copies Chip.
' Same visible 16x16 pixels, but source/preparation costs are different.
' Requires R60 LAST_GOOD and M16_AGAPIC_SAMPLE_BANK10.abk in working dir.
' Use disposable WinUAE: Load overwrites bank 10. PAL Timer 1 tick=20ms.
' Timed loops contain ONLY the compared drawing instruction and return.
' Setup, Safe acquisition, staging and prints are outside timed loops.
Dim _TM(1,1,2)
_ERR=0
Cls
Print "M18-R60-16X16-CPU-BLIT-BASELINE"
If Aga Detect=0
   Print "AGA CHIPSET MISSING"
   End
End If
Load "M16_AGAPIC_SAMPLE_BANK10.abk",10
If Start(10)=0 or Length(10)<>1836
   Print "AGAPIC BANK 10 MISSING"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "AGA OPEN FAILED"
   Erase 10
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 10
   Print "AGA DB FAILED"
   End
End If
_SW=Aga Swap
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
If _READY<>1
   Aga Screen Close
   Amos To Front
   Erase 10
   Print "AGA BACK NOT SAFE"
   End
End If
Amos To Back
_N=1200
' The CPU renders from AGAPIC bank; Blitter reads a pre-staged Chip area.
' The stage stays untouched throughout each series: non-overlapping regions.
For _CASE=0 To 1
   If _CASE=0
      _SX=16 : _SY=24 : _DX=160 : _DY=40
   End If
   If _CASE=1
      _SX=17 : _SY=25 : _DX=161 : _DY=41
   End If
   _STAGE=Aga Image Region(10,0,0,16,16,_SX,_SY,0)
   If _STAGE<>1
      Inc _ERR
   End If
   For _TR=0 To 2
      _LASTCPU=0
      _T0=Timer
      For _I=1 To _N
         _LASTCPU=Aga Image Region(10,0,0,16,16,_DX,_DY,0)
      Next _I
      _TM(0,_CASE,_TR)=Timer-_T0
      If _LASTCPU<>1
         Inc _ERR
      End If
      _LASTBLIT=0
      _T0=Timer
      For _I=1 To _N
         _LASTBLIT=Aga Blit Copy(_SX,_SY,_DX,_DY,16,16)
      Next _I
      _TM(1,_CASE,_TR)=Timer-_T0
      If _LASTBLIT<>1
         Inc _ERR
      End If
   Next _TR
Next _CASE
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
Erase 10
_CF1=Chip Free
Cls
Print "M18-R60-16X16-CPU-BLIT-BASELINE"
Print "PAL 320X256X16 / 3 TRIALS"
Print "1 TIMER TICK = 20 MS / N=1200"
Print "CPU AGAPIC=DECODE+DRAW"
Print "BLIT=CHIP COPY ONLY; STAGE OUTSIDE TIMER"
Print "ALIGNED CPU ";_TM(0,0,0);" ";_TM(0,0,1);" ";_TM(0,0,2)
Print "ALIGNED BLIT ";_TM(1,0,0);" ";_TM(1,0,1);" ";_TM(1,0,2)
Print "SHIFT CPU   ";_TM(0,1,0);" ";_TM(0,1,1);" ";_TM(0,1,2)
Print "SHIFT BLIT  ";_TM(1,1,0);" ";_TM(1,1,1);" ";_TM(1,1,2)
Print "ERR ";_ERR;" CLOSE ";_CLOSED
Print "CHIP BEFORE/END ";_CF0;" ";_CF1
Print "BENCH FINISHED - CLOSE RETURNED"
Do
   Wait Vbl
Loop
