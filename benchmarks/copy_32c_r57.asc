' M17-R57-COPY-BENCH-01 / Screen Copy versus Aga Blit Copy.
' Same bitmap source/destination within each engine.
' Screen Copy end coordinates are EXCLUSIVE: SX+W and SY+H.
' Requires AMOS Pro + AMCAF (Blitter Wait) + AGA extension R57.
' PAL 320x256x32 (5 planes). 1 Timer tick = 20 ms.
' All clear, fill, Safe, Swap, VBL and printing OUTSIDE timed loops.
' Copy on native AMOS Screen 0 versus private AGA back buffer.
Dim _TM(1,3,2)
_ERR=0
Cls
Print "M17-R57-COPY-BENCH-01"
Print "SCREEN COPY VS AGA COPY"
Print "320X256X32 PAL / 3 RUNS"
Screen Open 0,320,256,32,Lowres
Colour 0,$000
Colour 7,$F00
Colour 31,$FFF
Flash Off
Curs Off
Gr Writing 1
Set Pattern 0
Set Paint 0
_OPEN=Aga Screen Open(320,256,32,$00021000)
If _OPEN<>1
   Print "AGA OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,0,0,0)
_P7=Aga Palette Set(7,255,0,0)
_P31=Aga Palette Set(31,255,255,255)
_SW=Aga Swap
If _P0<>1 or _P7<>1 or _P31<>1 or _SW<>1
   Aga Screen Close
   Amos To Front
   Print "AGA INIT FAILED"
   End
End If
Amos To Back
' Acquire Safe once; NO swaps during benchmark.
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
If _READY<>1
   Aga Screen Close
   Amos To Front
   Print "AGA BACK NOT SAFE"
   End
End If
For _CASE=0 To 3
   ' 0=aligned 1=unaligned 2=large 3=overlap.
   If _CASE=0
      _SX=16 : _SY=24 : _DX=176 : _DY=24
      _W=64 : _H=48 : _N=1200
   End If
   If _CASE=1
      _SX=13 : _SY=32 : _DX=197 : _DY=43
      _W=95 : _H=72 : _N=900
   End If
   If _CASE=2
      _SX=8 : _SY=8 : _DX=64 : _DY=136
      _W=200 : _H=112 : _N=500
   End If
   If _CASE=3
      _SX=40 : _SY=40 : _DX=56 : _DY=56
      _W=128 : _H=96 : _N=700
   End If
   _SX2=_SX+_W
   _SY2=_SY+_H
   For _TR=1 To 3
      ' Native source pattern, NOT timed.
      Cls 0
      Ink 31
      Bar _SX,_SY To _SX+_W-1,_SY+_H-1
      Ink 7
      Bar _SX+8,_SY+8 To _SX+_W-9,_SY+_H-9
      Blitter Wait
      _T0=Timer
      For _I=1 To _N
         Screen Copy 0,_SX,_SY,_SX2,_SY2 To 0,_DX,_DY
      Next _I
      Blitter Wait
      _TM(0,_CASE,_TR-1)=Timer-_T0
      ' AGA source pattern, NOT timed.
      _K0=Aga Blit Clear(0,0,320,256)
      _K1=Aga Blit Fill(_SX,_SY,_W,_H,31)
      _K2=Aga Blit Fill(_SX+8,_SY+8,_W-16,_H-16,7)
      If _K0<>1 or _K1<>1 or _K2<>1
         Aga Screen Close
         Amos To Front
         Print "AGA PREP FAILED CASE ";_CASE
         End
      End If
      _T0=Timer
      For _I=1 To _N
         _OK=Aga Blit Copy(_SX,_SY,_DX,_DY,_W,_H)
      Next _I
      _TM(1,_CASE,_TR-1)=Timer-_T0
      If _OK<>1
         _ERR=_ERR+1
      End If
   Next _TR
Next _CASE
Aga Screen Close
Amos To Front
Cls
Print "COPY BENCH R57 / 320X256X32"
Print "3 RUNS / 1 TICK=20 MS"
Print "A=AMOS SCREEN COPY G=AGA COPY"
Print "64X48 X1200 / ALIGNED"
Print "A ";_TM(0,0,0);" ";_TM(0,0,1);" ";_TM(0,0,2)
Print "G ";_TM(1,0,0);" ";_TM(1,0,1);" ";_TM(1,0,2)
Print "95X72 X900 / UNALIGNED"
Print "A ";_TM(0,1,0);" ";_TM(0,1,1);" ";_TM(0,1,2)
Print "G ";_TM(1,1,0);" ";_TM(1,1,1);" ";_TM(1,1,2)
Print "200X112 X500 / LARGE"
Print "A ";_TM(0,2,0);" ";_TM(0,2,1);" ";_TM(0,2,2)
Print "G ";_TM(1,2,0);" ";_TM(1,2,1);" ";_TM(1,2,2)
Print "128X96 X700 / OVERLAP"
Print "A ";_TM(0,3,0);" ";_TM(0,3,1);" ";_TM(0,3,2)
Print "G ";_TM(1,3,0);" ";_TM(1,3,1);" ";_TM(1,3,2)
Print "AGA ERR ";_ERR
Print "COPY BENCH FINISHED - CLOSE RETURNED"
Do
   Wait Vbl
Loop
