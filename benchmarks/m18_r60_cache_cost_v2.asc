' M18 R60 CACHE COST V2 - NO NATIVE CODE CHANGES.
' BENCH ONLY. Load overwrites Bank 10; use disposable WinUAE.
' 64x40x4 AGAPIC source, screen PAL 320x256x16, 3 trials.
' Timer = 20 ms/tick. No Swap/VBL/Print inside timed loops.
Dim _TM(7,2)
_ERR=0
_NCPU=240
_NBLIT=2400
Cls
Print "M18-R60-CACHE-COST-V2"
If Aga Detect=0
   Print "AGA CHIPSET MISSING"
   End
End If
Load "M16_AGAPIC_SAMPLE_BANK10.abk",10
If Start(10)=0 or Length(10)<>1836
   Print "AGAPIC BANK 10 MISSING"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "AGA OPEN FAILED"
   Erase 10
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 10
   Print "AGA DB FAILED"
   End
End If
_SW=Aga Swap
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
If _READY<>1
   Aga Screen Close
   Amos To Front
   Erase 10
   Print "AGA BACK NOT SAFE"
   End
End If
Amos To Back
_SX=16 : _SY=24 : _DX=160 : _DY=40
_STAGE=Aga Image Region(10,0,0,16,16,_SX,_SY,0)
If _STAGE<>1
   Inc _ERR
End If
For _TR=0 To 2
   ' Offscreen: bank checks + 1 validation pass, no painting.
   _LAST=0
   _T0=Timer
   For _I=1 To _NCPU
      _LAST=Aga Image Region(10,0,0,16,16,320,40,0)
   Next _I
   _TM(0,_TR)=Timer-_T0
   If _LAST<>1
      Inc _ERR
   End If
   ' Visible one pixel: 2 RLE passes plus one drawn pixel.
   _LAST=0
   _T0=Timer
   For _I=1 To _NCPU
      _LAST=Aga Image Region(10,0,0,1,1,_DX,_DY,0)
   Next _I
   _TM(1,_TR)=Timer-_T0
   If _LAST<>1
      Inc _ERR
   End If
   ' Visible opaque 16x16.
   _LAST=0
   _T0=Timer
   For _I=1 To _NCPU
      _LAST=Aga Image Region(10,0,0,16,16,_DX,_DY,0)
   Next _I
   _TM(2,_TR)=Timer-_T0
   If _LAST<>1
      Inc _ERR
   End If
   ' Visible 16x16 with AGAPIC independent mask.
   _LAST=0
   _T0=Timer
   For _I=1 To _NCPU
      _LAST=Aga Image Region(10,0,0,16,16,_DX,_DY,1)
   Next _I
   _TM(3,_TR)=Timer-_T0
   If _LAST<>1
      Inc _ERR
   End If
   ' Prestaged opaque Chip copy; N=2400 for good precision.
   _LAST=0
   _T0=Timer
   For _I=1 To _NBLIT
      _LAST=Aga Blit Copy(_SX,_SY,_DX,_DY,16,16)
   Next _I
   _TM(4,_TR)=Timer-_T0
   If _LAST<>1
      Inc _ERR
   End If
   ' 240 total copies each; 240, 60, or 15 CPU stages.
   For _CASE=0 To 2
      If _CASE=0
         _REUSE=1 : _BATCHES=240
      End If
      If _CASE=1
         _REUSE=4 : _BATCHES=60
      End If
      If _CASE=2
         _REUSE=16 : _BATCHES=15
      End If
      _STAGE=0 : _LAST=0
      _T0=Timer
      For _B=1 To _BATCHES
         _STAGE=Aga Image Region(10,0,0,16,16,_SX,_SY,0)
         For _R=1 To _REUSE
            _LAST=Aga Blit Copy(_SX,_SY,_DX,_DY,16,16)
         Next _R
      Next _B
      _TM(5+_CASE,_TR)=Timer-_T0
      If _STAGE<>1 or _LAST<>1
         Inc _ERR
      End If
   Next _CASE
Next _TR
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
Erase 10
_CF1=Chip Free
Cls
Print "M18-R60-CACHE-COST-V2"
Print "PAL16 3T CPU240 BLIT2400"
Print "CACHE: 240 BLITS / STAGE 1-16"
Print "OFF    ";_TM(0,0);" ";_TM(0,1);" ";_TM(0,2)
Print "1PIX   ";_TM(1,0);" ";_TM(1,1);" ";_TM(1,2)
Print "CPU16  ";_TM(2,0);" ";_TM(2,1);" ";_TM(2,2)
Print "MASK16 ";_TM(3,0);" ";_TM(3,1);" ";_TM(3,2)
Print "BLIT   ";_TM(4,0);" ";_TM(4,1);" ";_TM(4,2)
Print "CACHE1 ";_TM(5,0);" ";_TM(5,1);" ";_TM(5,2)
Print "CACHE4 ";_TM(6,0);" ";_TM(6,1);" ";_TM(6,2)
Print "CACHE16";_TM(7,0);" ";_TM(7,1);" ";_TM(7,2)
Print "ERR ";_ERR;" CLOSE ";_CLOSED
Print "CHIP ";_CF0;" ";_CF1
Print "BENCH FINISHED - CLOSE RETURNED"
Do
   Wait Vbl
Loop
