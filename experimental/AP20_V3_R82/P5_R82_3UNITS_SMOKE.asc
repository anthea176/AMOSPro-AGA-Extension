' P5 -- REAL R82 split into independent native AGA, C2P and IFF units.
' TEST ONLY, CPU 68020+ and chipset AGA, disposable WinUAE installation.
' This invokes real code from all 3 groups: AGA 82, C2P 80, IFF 81.
Cls
Print "AP20 V3 R82 TRUE THREE-MODULE TEST"
_RESULT=1
_ERR=0
_AGA_DETECT=0
_C2P_OPEN=-99
_C2P_CLOSE=-99
_IFF_REJECT=-99
_CHIP0=Chip Free
_FAST0=Fast Free
_PSTATE=Prg State
_RUNMODE$="UNKNOWN"
_LOGFILE$="RAM:AP20_V3_P5_UNKNOWN.TXT"
If _PSTATE=0
   _RUNMODE$="INTERPRETED"
   _LOGFILE$="RAM:AP20_V3_P5_INTERPRETED.TXT"
End If
If _PSTATE=1
   _RUNMODE$="RUNTIME"
   _LOGFILE$="RAM:AP20_V3_P5_RUNTIME.TXT"
End If
If _PSTATE=-1
   _RUNMODE$="COMPILED"
   _LOGFILE$="RAM:AP20_V3_P5_COMPILED.TXT"
End If
_AGA_DETECT=Aga Detect
If _AGA_DETECT=0
   _ERR=1
   Goto CLEANUP
End If
' The C2P module 80 contains actual R82 entry 70, not a synthetic probe.
' Invalid bank zero MUST fail closed without opening a C2P context.
_C2P_OPEN=Aga C2P Open(0)
If _C2P_OPEN<>0
   _ERR=2
   Goto CLEANUP
End If
_C2P_CLOSE=Aga C2P Close
If _C2P_CLOSE<>0
   _ERR=3
   Goto CLEANUP
End If
' Actual R82 entry 75 in the separate IFF decoder module 81.
' Bank zero is invalid and no image bank is overwritten.
_IFF_REJECT=Aga Iff To Chunky("RAM:AP20_V3_P5_MISSING.iff",0)
If _IFF_REJECT<>0
   _ERR=4
End If
CLEANUP:
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free
_FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "AGA ";_AGA_DETECT;" C2P OPEN ";_C2P_OPEN;" CLOSE ";_C2P_CLOSE
Print "IFF REJECT ";_IFF_REJECT;" RESULT ";_RESULT;" ERR ";_ERR
_LOGERR=0
_CLOSEERR=0
Trap Open Out 1,_LOGFILE$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST AP20_V3_R82_TRUE_3UNITS_P5"
   Print #1,"RUN_MODE ";_RUNMODE$
   Print #1,"PRG_STATE ";_PSTATE
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"R82_DETECT ";_AGA_DETECT
   Print #1,"C2P_OPEN_REJECT ";_C2P_OPEN
   Print #1,"C2P_CLOSE_REJECT ";_C2P_CLOSE
   Print #1,"IFF_REJECT ";_IFF_REJECT
   Print #1,"ERR ";_ERR
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOGFILE$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
End
