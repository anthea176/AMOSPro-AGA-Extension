' M5 - SAFE SCREEN-ONLY DIAGNOSTIC (R6)
' Replaces unsafe 3-stage test: DB + Swap + Close is blocked pending fix.
' NO Double Buffer, NO Swap, NO IFF Load, NO loader memory writes.
' Exactly one Open / Wait Key / Close cycle, without drawing.
' Use a NORMAL key, never Ctrl+C for this diagnostic.
' If WinUAE crashes: restart emulator before trying anything else.

Cls
Print "M5 SCREEN ONLY - NO DB / NO IFF LOAD"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_P=Aga Pic Info(_FILE$,2)
_CAMG=Aga Pic Info(_FILE$,5)
_MODE=Aga Pic Info(_FILE$,6)
_COLORS=Aga Pic Info(_FILE$,7)
Print "WIDTH ";_W;" HEIGHT ";_H;" DEPTH ";_P
Print "CAMG ";_CAMG;" MODE ";_MODE;" COLORS ";_COLORS
If _W<=0 or _H<=0 or _COLORS<=0
   Print "INVALID PIC INFO"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_COLORS,_MODE)
Print "OPEN = ";_OPEN
If _OPEN=0
   Print "OPEN FAILED, STOP"
   End
End If

Amos To Back
_K=Aga Wait Key
Aga Screen Close
Amos To Front
Print "CLOSED, NORMAL KEY = ";_K
Print "NO DOUBLE BUFFER OR IFF LOADER USED"
End
