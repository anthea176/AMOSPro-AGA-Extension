' M4b R6B-R4 - TEST 02: TEN NONBLOCKING SWAPS
Cls
Print "R6B-R4 TEST 02 - 10 SWAPS"
_OK=Aga Screen Open(320,256,256,$00021000)
Amos To Front
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _FAIL=0
      For _N=1 To 10
         _SW=Aga Swap
         Print "SWAP ";_N;" = ";_SW
         If _SW=0
            _FAIL=_FAIL+1
         End If
         For _I=1 To 3
            Aga Wait Vbl
         Next _I
      Next _N
      Print "SWAP FAILURES = ";_FAIL
   End If
   For _I=1 To 5
      Aga Wait Vbl
   Next _I
   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "TEST 02 FINISHED"
Wait Key
End
