' M4b R6B-R4 - TEST 03: 100 NONBLOCKING SWAPS
Cls
Print "R6B-R4 TEST 03 - 100 SWAPS"
_OK=Aga Screen Open(320,256,256,$00021000)
Amos To Front
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _FAIL=0
      For _N=1 To 100
         _SW=Aga Swap
         If _SW=0
            _FAIL=_FAIL+1
         End If
         Aga Wait Vbl
         If (_N Mod 10)=0
            Print "SWAPS ";_N;" / FAIL = ";_FAIL
         End If
      Next _N
      Print "TOTAL FAILURES = ";_FAIL
   End If
   For _I=1 To 5
      Aga Wait Vbl
   Next _I
   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "TEST 03 FINISHED"
Wait Key
End
