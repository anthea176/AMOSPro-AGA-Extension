' M5.1 - AGA PIC INFO - FSEL
' No AGA screen is opened. Select any IFF/ILBM with Fsel$("**").

Cls
Print "M5.1 - AGA PIC INFO"

_FILE$=Fsel$("**")
If _FILE$<>""
   Print _FILE$
   Print

   _W=Aga Pic Info(_FILE$,0)
   _H=Aga Pic Info(_FILE$,1)
   _P=Aga Pic Info(_FILE$,2)
   _C=Aga Pic Info(_FILE$,3)
   _Z=Aga Pic Info(_FILE$,4)
   _M=Aga Pic Info(_FILE$,5)

   Print "WIDTH       = ";_W
   Print "HEIGHT      = ";_H
   Print "BITPLANES   = ";_P
   Print "COLORS      = ";_C
   Print "COMPRESSION = ";_Z
   Print "CAMG        = ";_M
End If

Wait Key
End
