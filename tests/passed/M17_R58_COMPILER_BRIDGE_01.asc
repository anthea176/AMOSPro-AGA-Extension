' M17-R58-COMPILER-BRIDGE-01. V2 native probe at offset 40000.
' Project / Merge ASCII. Run interpreted then compile SAME source.
' No external IFF/ABK/AMCAF files needed. R58 must be installed.
Cls
Print "M17-R58-COMPILER-BRIDGE-01"
Print "BEFORE FAR AGA PROBE 40K"
Aga Probe
Print "FAR AGA PROBE RETURNED"
_OPEN=Aga Screen Open(320,256,32,$00021000)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_PAL=Aga Palette Set(31,255,255,255)
_SW0=0
For _TRY=1 To 20
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
_FILL=0
_COPY=0
_SWAP=0
If _READY=1
   _FILL=Aga Blit Fill(40,50,64,48,31)
   If _FILL=1
      _COPY=Aga Blit Copy(40,50,176,50,64,48)
   End If
End If
If _COPY=1
   For _TRY=1 To 20
      If _SWAP=0
         _SWAP=Aga Swap
      End If
      If _SWAP=0
         Aga Wait Vbl
      End If
   Next _TRY
End If
For _HOLD=1 To 100
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
Aga Probe
Print "FAR PROBE AFTER CLOSE RETURNED"
_RESULT=1
If _OPEN<>1 or _DB<>1 or _PAL<>1
   _RESULT=0
End If
If _SW0<>1 or _READY<>1 or _FILL<>1 or _COPY<>1 or _SWAP<>1
   _RESULT=0
End If
If _CLOSED<>-1
   _RESULT=0
End If
Print "M17-R58-COMPILER-BRIDGE-01"
Print "OFFSET 40000 / V2 40K COMPILER"
Print "OPEN ";_OPEN;" DB ";_DB;" PAL ";_PAL
Print "SW0 ";_SW0;" SAFE ";_READY;" FILL ";_FILL
Print "COPY ";_COPY;" SWAP ";_SWAP;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
