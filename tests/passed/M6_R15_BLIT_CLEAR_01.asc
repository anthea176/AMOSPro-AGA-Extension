' M6 R15 0.7.2 - single Clear validation / Fill + Copy regression
' Requires R15 candidate dist/AMOSPro_AGA.Lib, NOT R14 archive.
' Choose MYGIRL.IFF (320x256x8 indexed).
' Two colored rectangles get dark (palette index 0) inner cutouts.
' Negative, out-of-bounds and zero-width Clear MUST return 0.

Cls
Print "M6-R15-BLIT-CLEAR-01"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
If _W<>320 or _H<>256 or _D<>8
   Print "CHOOSE MYGIRL.IFF 320X256X8"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If

_F1=Aga Blit Fill(16,24,104,68,63)
_C1=Aga Blit Clear(32,40,72,36)
_F2=Aga Blit Fill(154,110,92,62,15)
_C2=Aga Blit Clear(166,122,68,38)
_NEG=Aga Blit Clear(-1,0,12,12)
_EDGE=Aga Blit Clear(315,245,10,20)
_ZERO=Aga Blit Clear(0,0,0,15)
_COPY=Aga Blit Copy(16,24,16,208,104,40)

If _F1<>1 or _C1<>1 or _F2<>1 or _C2<>1 or _NEG<>0 or _EDGE<>0 or _ZERO<>0 or _COPY<>1
   Aga Screen Close
   Amos To Front
   Print "RESULT ERROR"
   Print _F1;_C1;_F2;_C2;_NEG;_EDGE;_ZERO;_COPY
   End
End If

_SWAP=Aga Swap
If _SWAP=0
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED"
   End
End If

Amos To Back
_KEY=Aga Wait Key
Aga Screen Close
Amos To Front
Print "F1 ";_F1;" C1 ";_C1;" F2 ";_F2;" C2 ";_C2
Print "NEG ";_NEG;" EDGE ";_EDGE;" ZERO ";_ZERO
Print "COPY ";_COPY;" SWAP ";_SWAP
Print "KEY ";_KEY;" CLOSE RETURNED"
End
