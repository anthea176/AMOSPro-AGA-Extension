' R6C-R1 TEST 02 - VISIBLE BACK FILL + SWAP
Cls
Print "R6C-R1 TEST 02 - 2 COLORS"
_OK=Aga Screen Open(320,256,256,$00021000)
Amos To Front
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      Print "PREPARE COLOR 255"
      Aga Back Fill 255
      _SW1=Aga Swap
      Print "SWAP 1 = ";_SW1

      Amos To Back
      For _I=1 To 50
         Aga Wait Vbl
      Next _I

      Aga Back Fill 0
      _SW2=Aga Swap
      For _I=1 To 50
         Aga Wait Vbl
      Next _I

      Amos To Front
      Print "SWAP 2 = ";_SW2
   End If

   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "TEST 02 FINISHED"
Wait Key
End
