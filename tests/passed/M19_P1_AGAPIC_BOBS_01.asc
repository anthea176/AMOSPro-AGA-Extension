' M19 P1 - AGAPIC MULTI-BOB / MANUAL AMAL ON PRIVATE AGA
' R84 LAST_GOOD unchanged; test AGA 68020+ Runtime first.
' Needs banks 11..19 free. No external resources or c2p.library.
Cls
Print "M19 P1 AGAPIC BOBS"
_RESULT=1 : _ERR=0 : _OPEN=0 : _CLOSED=0
_B11=0 : _LASTCAP=11 : _PR18=0 : _PR19=0
_AMAL=0 : _SYN=0 : _CAPOK=0 : _METAOK=0 : _PIXDIFF=0 : _PROBEOK=0
_FOK=0 : _DF=0 : _SF=0 : _M0=0 : _M1=0
_C0=0 : _C1=0 : _FLIPS=0 : _OVER=0 : _CLIPS=0 : _ORDER=0
_LX=-1 : _LY=-1
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN"
_LOG$="RAM:M19_P1_AGAPIC_BOBS_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:M19_P1_AGAPIC_BOBS_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:M19_P1_AGAPIC_BOBS_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:M19_P1_AGAPIC_BOBS_COMPILED.TXT"
End If
_CPU$="UNKNOWN" : _FLAGS=0
_SYS=Leek(4)
If _SYS<>0
   _FLAGS=Deek(_SYS+296)
   _CPU$="68000"
   If (_FLAGS And 1)<>0
      _CPU$="68010"
   End If
   If (_FLAGS And 2)<>0
      _CPU$="68020"
   End If
   If (_FLAGS And 4)<>0
      _CPU$="68030"
   End If
   If (_FLAGS And 8)<>0
      _CPU$="68040"
   End If
   If (_FLAGS And 128)<>0
      _CPU$="68060"
   End If
End If
If Aga Detect=0
   _ERR=1
   Goto CLEANUP
End If
For _B=11 To 19
   If Length(_B)<>0
      _ERR=2
      Goto CLEANUP
   End If
Next _B
Reserve As Data 11,16
_B11=1
_PTR=Start(11)
For _J=0 To 15
   Poke _PTR+_J,0
Next _J
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3
   Goto CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4
   Goto CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,22,35,65)
_P3=Aga Palette Set(3,250,65,60)
_P4=Aga Palette Set(4,255,180,35)
_P5=Aga Palette Set(5,30,215,230)
_P6=Aga Palette Set(6,60,255,150)
_P7=Aga Palette Set(7,245,235,60)
_P8=Aga Palette Set(8,215,85,250)
If _P0<>1 or _P1<>1 or _P3<>1 or _P4<>1
   _ERR=5
   Goto CLEANUP
End If
If _P5<>1 or _P6<>1 or _P7<>1 or _P8<>1
   _ERR=6
   Goto CLEANUP
End If
' Capture six 24x24 AGAPIC source frames from same scratch zone.
' Bank12,14,16=v1; Bank13,15,17=v2.
' Banks 12..16 masked index0; Bank17 opaque.
For _I=0 To 5
   _B=12+_I : _COL=3+_I : _V=1 : _TR=0
   If (_I Mod 2)=1
      _V=2
   End If
   If _B=17
      _TR=-1
   End If
   _READY=0
   For _TRY=1 To 12
      If _READY=0
         _READY=Aga Blit Fill(8,8,24,24,0)
      End If
      If _READY=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _READY<>1
      _ERR=7
      Goto CLEANUP
   End If
   _D0=Aga Blit Fill(12,12,16,16,_COL)
   _D1=Aga Box(8,8,31,31,_COL)
   If (_I Mod 2)=0
      _D2=Aga Blit Fill(8,18,24,4,_COL)
   Else
      _D2=Aga Blit Fill(18,8,4,24,_COL)
   End If
   If _D0<>1 or _D1<>1 or _D2<>1
      _ERR=8
      Goto CLEANUP
   End If
   _OK=Aga Bank Image Capture(_B,8,8,24,24,_TR,_V)
   If _OK<>1
      _ERR=9
      Goto CLEANUP
   End If
   _LASTCAP=_B : _CAPOK=_CAPOK+1
   If Aga Bank Image Info(_B,1)<>24 or Aga Bank Image Info(_B,2)<>24
      _ERR=10
      Goto CLEANUP
   End If
   If Aga Bank Image Info(_B,3)<>8
      _ERR=11
      Goto CLEANUP
   End If
   _NC=0
   If _V=2
      _NC=256
   End If
   If Aga Bank Image Info(_B,4)<>_NC
      _ERR=12
      Goto CLEANUP
   End If
   _METAOK=_METAOK+1
Next _I
' Pixel probe: source 12 red, source 14 cyan, swapped draw order.
_BG=0
For _TRY=1 To 12
   If _BG=0
      _BG=Aga Blit Fill(0,0,320,256,1)
   End If
   If _BG=0
      Aga Wait Vbl
   End If
Next _TRY
If _BG<>1
   _ERR=13
   Goto CLEANUP
End If
_D0=Aga Bank Image Draw(12,180,80,1)
_D1=Aga Bank Image Draw(14,180,80,1)
If _D0<>1 or _D1<>1
   _ERR=14
   Goto CLEANUP
End If
_OK=Aga Bank Image Capture(18,192,92,1,1,-1,1)
If _OK<>1
   _ERR=15
   Goto CLEANUP
End If
_PR18=1
_BG=Aga Blit Fill(0,0,320,256,1)
If _BG<>1
   _ERR=16
   Goto CLEANUP
End If
_D0=Aga Bank Image Draw(14,180,80,1)
_D1=Aga Bank Image Draw(12,180,80,1)
If _D0<>1 or _D1<>1
   _ERR=17
   Goto CLEANUP
End If
_OK=Aga Bank Image Capture(19,192,92,1,1,-1,1)
If _OK<>1
   _ERR=18
   Goto CLEANUP
End If
_PR19=1
_P18=Start(18) : _P19=Start(19)
_S18=Leek(_P18+24) : _S19=Leek(_P19+24)
_N18=Leek(_P18+28)-_S18
_N19=Leek(_P19+28)-_S19
If _N18<=0 or _N18<>_N19
   _ERR=19
   Goto CLEANUP
End If
For _J=0 To _N18-1
   If Peek(_P18+_S18+_J)<>Peek(_P19+_S19+_J)
      _PIXDIFF=1
   End If
Next _J
If _PIXDIFF<>1
   _ERR=20
   Goto CLEANUP
End If
_PROBEOK=1
Doke _PTR,0 : Doke _PTR+2,40 : Doke _PTR+4,109 : Doke _PTR+6,1
Doke _PTR+8,0 : Doke _PTR+10,145 : Doke _PTR+12,5 : Doke _PTR+14,3
Synchro Off
_SYN=1
_A0$="Let X=40; Let Y=109; Let A=1; L: Let X=X+1; Pause; If X<270 Jump L; Let X=40; Jump L"
_A1$="Let X=145; Let Y=5; Let A=3; L: Let Y=Y+1; Pause; If Y<205 Jump L; Let Y=5; Jump L"
Amal 0,_A0$ To _PTR
Amal 1,_A1$ To _PTR+8
Amal On
_AMAL=1 : _B0=12 : _B1=14 : _T0=0 : _T1=0
Amos To Back
For _F=1 To 240
   Aga Wait Vbl
   Synchro
   _X0=Deek(_PTR+2) : _Y0=Deek(_PTR+4)
   _X1=Deek(_PTR+10) : _Y1=Deek(_PTR+12)
   If _X0<0 or _X0>296 or _Y0<0 or _Y0>232
      _ERR=21
      Goto CLEANUP
   End If
   If _X1<0 or _X1>296 or _Y1<0 or _Y1>232
      _ERR=22
      Goto CLEANUP
   End If
   If _LX>=0 and _X0<>_LX
      _M0=_M0+1
   End If
   If _LY>=0 and _Y1<>_LY
      _M1=_M1+1
   End If
   _LX=_X0 : _LY=_Y1
   _T0=_T0+1 : _T1=_T1+1
   If _T0>=16
      _T0=0 : _C0=_C0+1
      If _B0=12
         _B0=13
      Else
         _B0=12
      End If
   End If
   If _T1>=24
      _T1=0 : _C1=_C1+1
      If _B1=14
         _B1=15
      Else
         _B1=14
      End If
   End If
   If _F=61 or _F=121 or _F=181
      _ORDER=1-_ORDER : _FLIPS=_FLIPS+1
   End If
   If _X0+24>_X1 and _X1+24>_X0 and _Y0+24>_Y1 and _Y1+24>_Y0
      _OVER=_OVER+1
   End If
   _BG=0
   For _TRY=1 To 12
      If _BG=0
         _BG=Aga Blit Fill(0,0,320,256,1)
      End If
      If _BG=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _BG<>1
      _DF=_DF+1 : _ERR=23
      Goto CLEANUP
   End If
   _BASE=Aga Bank Image Draw(17,130,110,0)
   If _BASE<>1
      _DF=_DF+1 : _ERR=24
      Goto CLEANUP
   End If
   If _ORDER=0
      _D0=Aga Bank Image Draw(_B0,_X0,_Y0,1)
      _D1=Aga Bank Image Draw(_B1,_X1,_Y1,1)
   Else
      _D1=Aga Bank Image Draw(_B1,_X1,_Y1,1)
      _D0=Aga Bank Image Draw(_B0,_X0,_Y0,1)
   End If
   If _D0<>1 or _D1<>1
      _DF=_DF+1 : _ERR=25
      Goto CLEANUP
   End If
   _MARK=Aga Bank Image Draw(16,225,125,1)
   _CL=Aga Bank Image Draw(16,-8,68,1)
   _CR=Aga Bank Image Draw(16,307,180,1)
   _CT=Aga Bank Image Draw(16,260,-8,1)
   _CB=Aga Bank Image Draw(16,260,245,1)
   If _MARK<>1 or _CL<>1 or _CR<>1 or _CT<>1 or _CB<>1
      _DF=_DF+1 : _ERR=26
      Goto CLEANUP
   End If
   _CLIPS=_CLIPS+1
   _SW=0
   For _TRY=1 To 12
      If _SW=0
         _SW=Aga Swap
      End If
      If _SW=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _SW<>1
      _SF=_SF+1 : _ERR=27
      Goto CLEANUP
   End If
   _FOK=_FOK+1
   _KEY=Aga Key
   If _KEY=69
      Goto CLEANUP
   End If
Next _F
Goto CLEANUP

CLEANUP:
If _AMAL=1
   Amal Off
End If
If _SYN=1
   Synchro On
End If
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _PR19=1 and Length(19)<>0
   Erase 19
End If
If _PR18=1 and Length(18)<>0
   Erase 18
End If
If _LASTCAP>=12
   For _B=12 To _LASTCAP
      If Length(_B)<>0
         Erase _B
      End If
   Next _B
End If
If _B11=1 and Length(11)<>0
   Erase 11
End If
If _ERR=0 and (_CAPOK<>6 or _METAOK<>6 or _PROBEOK<>1)
   _ERR=28
End If
If _ERR=0 and _FOK<180
   _ERR=29
End If
If _ERR=0 and (_M0=0 or _M1=0 or _C0<4 or _C1<4)
   _ERR=30
End If
If _ERR=0 and (_FLIPS<2 or _OVER=0 or _CLIPS<>_FOK)
   _ERR=31
End If
If _ERR=0 and _CLOSED<>1
   _ERR=32
End If
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Cls
Print "M19 P1 ";_VERDICT$;" ERR ";_ERR
Print "CAP/META/PROBE ";_CAPOK;" ";_METAOK;" ";_PROBEOK
Print "FRAMES/MOVES ";_FOK;" ";_M0;" ";_M1
Print "CHANGES/FLIPS ";_C0;" ";_C1;" ";_FLIPS
Print "OVERLAP/CLIPS ";_OVER;" ";_CLIPS
Print "DRAW/SWAP FAIL ";_DF;" ";_SF
Print "CLOSE ";_CLOSED;" CHIP/FAST ";_CHIP1-_CHIP0;" ";_FAST1-_FAST0
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P1_AGAPIC_BOBS_01"
   Print #1,"VERSION R84 V0.13.29 LAST_GOOD"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"CPU ";_CPU$
   Print #1,"CPU_ATTNFLAGS ";_FLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"ERR ";_ERR
   Print #1,"CAP_OK ";_CAPOK
   Print #1,"META_OK ";_METAOK
   Print #1,"PROBE_OK ";_PROBEOK
   Print #1,"PIXEL_DIFF ";_PIXDIFF
   Print #1,"FRAME_OK ";_FOK
   Print #1,"MOVE_X0 ";_M0
   Print #1,"MOVE_Y1 ";_M1
   Print #1,"FRAME_SWITCH0 ";_C0
   Print #1,"FRAME_SWITCH1 ";_C1
   Print #1,"ORDER_FLIPS ";_FLIPS
   Print #1,"OVERLAP_FRAMES ";_OVER
   Print #1,"CLIP_OK ";_CLIPS
   Print #1,"DRAW_FAIL ";_DF
   Print #1,"SWAP_FAIL ";_SF
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"CHIP_DELTA ";_CHIP1-_CHIP0
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"FAST_DELTA ";_FAST1-_FAST0
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
Print "CLOSE RETURNED"
End
