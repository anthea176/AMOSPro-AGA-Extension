' M4a v0.0.5 - FIRST Aga Wait Vbl runtime test.
' Install dist/experimental/AMOSPro_AGA_M4a_v0.0.5.Lib as APSystem/AMOSPro_AGA.Lib.
' Run interpreted first. Compile only after the interpreted test succeeds.

Aga Wait Vbl
Print "WAIT WITHOUT SCREEN = OK"

_OK=Aga Screen Open(320,256,256,$00021000)
Print "M4A OPEN = ";_OK

If _OK<>0
   Amos To Back
   Aga Screen Pattern

   For _I=1 To 150
      Aga Wait Vbl
   Next _I

   Amos To Front
   Aga Screen Close
   Print "WAIT VBL 150 FRAMES = OK"
   Print "M4A CLOSED - BACK IN AMOS"
Else
   Print "OPEN FAILED"
End If

Wait Key
End
