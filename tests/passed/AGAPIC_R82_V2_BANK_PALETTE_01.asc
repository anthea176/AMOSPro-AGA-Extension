' R82 AGAPIC v1/v2 - four new numbered Bank Palette APIs.
' AGA 320x256x256 PAL LowRes, CPU 68020+, interpreted test FIRST.
' Keep BOTH R82_AGAPIC_V2_BANK10.abk and R82_AGAPIC_V1_BANK12.abk
' in the same directory as this ASC. LOAD overwrites banks 10 and 12.
' This candidate is NOT a verified WinUAE or Compiler PASS.
Cls
Print "R82 AGAPIC V2 / UNIFIED BANK PALETTES"
_RESULT=1
_ERR=0
_AGA=0
_CLOSE_RETURNED=0
_CHIP0=Chip Free
_FAST0=Fast Free
_PSTATE=Prg State
_RUNMODE$="UNKNOWN"
_LOGFILE$="RAM:AGAPIC_R82_UNKNOWN.TXT"
If _PSTATE=0
   _RUNMODE$="INTERPRETED"
   _LOGFILE$="RAM:AGAPIC_R82_INTERPRETED.TXT"
End If
If _PSTATE=1
   _RUNMODE$="RUNTIME"
   _LOGFILE$="RAM:AGAPIC_R82_RUNTIME.TXT"
End If
If _PSTATE=-1
   _RUNMODE$="COMPILED"
   _LOGFILE$="RAM:AGAPIC_R82_COMPILED.TXT"
End If
_CPU$="UNKNOWN"
_CPUFLAGS=0
_SYSBASE=Leek(4)
If _SYSBASE<>0
   _CPUFLAGS=Deek(_SYSBASE+296)
   _CPU$="68000"
   If (_CPUFLAGS And 1)<>0
      _CPU$="68010"
   End If
   If (_CPUFLAGS And 2)<>0
      _CPU$="68020"
   End If
   If (_CPUFLAGS And 4)<>0
      _CPU$="68030"
   End If
   If (_CPUFLAGS And 8)<>0
      _CPU$="68040"
   End If
   If (_CPUFLAGS And 128)<>0
      _CPU$="68060"
   End If
End If
_PAL_V2_OK=0
_PAL_V1_OK=0
_FADE_V2_OK=0
_FADE_AGAPAL_OK=0
_INIT_OK=0
_CAPTURE_OK=0
_DRAW_V1_OK=0
_DRAW_V2_OK=0
_REGION_V1_OK=0
_REGION_V2_OK=0
_INVALID_OK=0
_SWAP_OK=0
If Aga Detect=0
   _ERR=1
   Goto CLEANUP
End If
Load "R82_AGAPIC_V2_BANK10.abk",10
Load "R82_AGAPIC_V1_BANK12.abk",12
If Start(10)=0 or Start(12)=0
   _ERR=2
   Goto CLEANUP
End If
Reserve As Data 11,1568
If Length(11)<>1568
   _ERR=3
   Goto CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4
   Goto CLEANUP
End If
_AGA=1
_DB=Aga Double Buffer
If _DB<>1
   _ERR=5
   Goto CLEANUP
End If
_INIT_OK=Aga Bank Palette Init(11,2)
If _INIT_OK<>1
   _ERR=6
   Goto CLEANUP
End If
_PAL_V2_OK=Aga Bank Palette Apply(10,0)
If _PAL_V2_OK<>1
   _ERR=7
   Goto CLEANUP
End If
_P1=Aga Palette Get(1)
_P2=Aga Palette Get(2)
If _P1<>$FFFFFF or _P2<>$FF0000
   _ERR=8
   Goto CLEANUP
End If
_CAPTURE_OK=Aga Bank Palette Capture(11,0)
If _CAPTURE_OK<>1
   _ERR=9
   Goto CLEANUP
End If
_PBLUE=Aga Palette Set(2,0,0,255)
_CAPTURE1=Aga Bank Palette Capture(11,1)
If _PBLUE<>1 or _CAPTURE1<>1
   _ERR=10
   Goto CLEANUP
End If
_PAL_V1_OK=Aga Bank Palette Apply(11,0)
If _PAL_V1_OK<>1 or Aga Palette Get(2)<>$FF0000
   _ERR=11
   Goto CLEANUP
End If
_FADE_AGAPAL_OK=Aga Bank Palette Fade(11,1,5)
If _FADE_AGAPAL_OK<>1 or Aga Palette Get(2)<>$0000FF
   _ERR=12
   Goto CLEANUP
End If
_FADE_V2_OK=Aga Bank Palette Fade(10,0,5)
If _FADE_V2_OK<>1 or Aga Palette Get(2)<>$FF0000
   _ERR=13
   Goto CLEANUP
End If
' Fail-closed checks do NOT modify AGAPAL, AGAPIC or screen pixels.
_BAD1=Aga Bank Palette Apply(10,1)
_BAD2=Aga Bank Palette Fade(10,1,3)
_BAD3=Aga Bank Palette Apply(12,0)
_BAD4=Aga Bank Palette Capture(10,0)
_BAD5=Aga Bank Palette Init(10,1)
_BAD6=Aga Bank Palette Apply(4,0)
_BAD7=Aga Bank Palette Fade(10,0,0)
_BAD8=Aga Bank Palette Apply(11,2)
_INVALID_OK=1
If _BAD1<>0 or _BAD2<>0 or _BAD3<>0 or _BAD4<>0
   _INVALID_OK=0
End If
If _BAD5<>0 or _BAD6<>0 or _BAD7<>0 or _BAD8<>0
   _INVALID_OK=0
End If
If Aga Palette Get(2)<>$FF0000 or _INVALID_OK<>1
   _ERR=14
   Goto CLEANUP
End If
' All drawing is done on the INACTIVE buffer. No palette or Swap implicit.
_CLEAR=Aga Blit Clear(0,0,320,256)
_DV0=Aga Bank Image Draw(10,12,28,0)
_DV1=Aga Bank Image Draw(10,118,28,1)
_DRAW_V2_OK=1
If _CLEAR<>1 or _DV0<>1 or _DV1<>1
   _DRAW_V2_OK=0
   _ERR=15
   Goto CLEANUP
End If
_DRAW_V1_OK=Aga Bank Image Draw(12,208,28,0)
_DIRECT=Aga Image Draw(Start(10),Length(10),12,118,0)
If _DRAW_V1_OK<>1 or _DIRECT<>1
   _ERR=16
   Goto CLEANUP
End If
_REGION_V2_OK=Aga Image Region(10,8,8,48,32,126,145,0)
_REGION_V1_OK=Aga Image Region(12,8,8,48,32,206,145,1)
If _REGION_V2_OK<>1 or _REGION_V1_OK<>1
   _ERR=17
   Goto CLEANUP
End If
_SWAP_OK=Aga Swap
If _SWAP_OK<>1
   _ERR=18
   Goto CLEANUP
End If
Amos To Back
For _I=1 To 100
   Aga Wait Vbl
Next _I
Goto CLEANUP

CLEANUP:
If _ERR<>0
   _RESULT=0
End If
If _AGA=1
   Aga Screen Close
   _CLOSE_RETURNED=1
End If
Amos To Front
If Start(11)<>0
   Erase 11
End If
If Start(10)<>0
   Erase 10
End If
If Start(12)<>0
   Erase 12
End If
_CHIP1=Chip Free
_FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "R82 V2 PALETTE/FADE: ";_PAL_V2_OK;" ";_FADE_V2_OK
Print "R82 AGAPAL INIT/CAPTURE/APPLY/FADE: ";_INIT_OK;" ";_CAPTURE_OK;" ";_PAL_V1_OK;" ";_FADE_AGAPAL_OK
Print "R82 V1/V2 DRAW: ";_DRAW_V1_OK;" ";_DRAW_V2_OK
Print "R82 V1/V2 REGION: ";_REGION_V1_OK;" ";_REGION_V2_OK
Print "R82 INVALID: ";_INVALID_OK;" SWAP: ";_SWAP_OK
Print "RESULT ";_RESULT;" ERR ";_ERR
_LOGERR=0
_CLOSEERR=0
Trap Open Out 1,_LOGFILE$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST AGAPIC_R82_V2_BANK_PALETTE_01"
   Print #1,"VERSION R82 V0.13.27 NATIVE CANDIDATE"
   Print #1,"RUN_MODE ";_RUNMODE$
   Print #1,"PRG_STATE ";_PSTATE
   Print #1,"CPU ";_CPU$
   Print #1,"CPU_ATTNFLAGS ";_CPUFLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"PALETTE_V2_OK ";_PAL_V2_OK
   Print #1,"PALETTE_AGAPAL_OK ";_PAL_V1_OK
   Print #1,"FADE_V2_OK ";_FADE_V2_OK
   Print #1,"FADE_AGAPAL_OK ";_FADE_AGAPAL_OK
   Print #1,"INIT_OK ";_INIT_OK
   Print #1,"CAPTURE_OK ";_CAPTURE_OK
   Print #1,"DRAW_V1_OK ";_DRAW_V1_OK
   Print #1,"DRAW_V2_OK ";_DRAW_V2_OK
   Print #1,"REGION_V1_OK ";_REGION_V1_OK
   Print #1,"REGION_V2_OK ";_REGION_V2_OK
   Print #1,"INVALID_OK ";_INVALID_OK
   Print #1,"SWAP_OK ";_SWAP_OK
   Print #1,"ERR ";_ERR
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOGFILE$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
End
