' M8 R19 0.8.3 - Intuition mouse position, first nonblocking stage
' Only R19 supports Aga Mouse X and Aga Mouse Y functions.
' Choose MYGIRL.IFF 320x256x8.
' Move pointer to top LEFT and tap a key, then to bottom RIGHT and tap
' another key. Take a screenshot of summary after returning to AMOS.
' No bare Aga Mouse calls: all new commands are integer functions.

Cls
Print "M8-R19-MOUSE-POS-01"
_BAD0X=Aga Mouse X
_BAD0Y=Aga Mouse Y

_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
If _W<>320 or _H<>256 or _D<>8
   Print "USE MYGIRL.IFF 320X256X8"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
_SWAP=Aga Swap

Amos To Back
' Put pointer near top-left of image and tap a key.
_K1=Aga Wait Key
_X1=Aga Mouse X
_Y1=Aga Mouse Y
' Move pointer near bottom-right of image and tap another key.
_K2=Aga Wait Key
_X2=Aga Mouse X
_Y2=Aga Mouse Y

Aga Screen Close
Amos To Front
_BAD1X=Aga Mouse X
_BAD1Y=Aga Mouse Y

_REOPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _REOPEN=1
   _X3=Aga Mouse X
   _Y3=Aga Mouse Y
   Aga Screen Close
Else
   _X3=-1
   _Y3=-1
End If
_BAD2X=Aga Mouse X
_BAD2Y=Aga Mouse Y
Amos To Front

Print "M8-R19-MOUSE-POS-01"
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD;" SWAP ";_SWAP
Print "BEFORE ";_BAD0X;" ";_BAD0Y
Print "P1 ";_X1;" ";_Y1;" KEY ";_K1
Print "P2 ";_X2;" ";_Y2;" KEY ";_K2
Print "CLOSED ";_BAD1X;" ";_BAD1Y
Print "REOPEN ";_REOPEN;" POS3 ";_X3;" ";_Y3
Print "CLOSED2 ";_BAD2X;" ";_BAD2Y
Print "CLOSE X2 RETURNED"
End
