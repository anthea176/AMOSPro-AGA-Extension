' M5 R2R4 - FULL PALETTE SCREEN OPEN
Cls
Print "M5-R2R4 TEST - FULL PALETTE"

_OK=Aga Screen Open(320,200,256,$00021000)
Amos To Front
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _IFF=Aga Iff Load("DH6:Clown.iff")
      Print "IFF LOAD = ";_IFF
      If _IFF<>0
         _SW=Aga Swap
         Print "SWAP = ";_SW
         If _SW<>0
            Amos To Back
            For _I=1 To 200
               Aga Wait Vbl
            Next _I
            Amos To Front
         End If
      End If
   End If
   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "M5-R2R4 TEST FINISHED"
Wait Key
End
