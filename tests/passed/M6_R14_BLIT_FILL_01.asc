' M6 R14 0.7.1 - single Aga Blit Fill / R13 Copy regression
' Requires R14 candidate dist/AMOSPro_AGA.Lib, not archived R13
' Select MYGIRL.IFF (320x256x8 indexed)
' Fill pen 15, pen 63, pen 0; reject pen 256 and out-of-bounds.
' Expect three solid rectangles and copy of first into bottom-left.

Cls
Print "M6-R14-BLIT-FILL-01"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
If _W<>320 or _H<>256 or _D<>8
   Print "CHOOSE MYGIRL.IFF 320X256X8"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If

_F1=Aga Blit Fill(18,24,86,48,15)
_F2=Aga Blit Fill(144,118,78,50,63)
_F0=Aga Blit Fill(236,40,66,52,0)
_BADCOL=Aga Blit Fill(12,12,25,25,256)
_BADRECT=Aga Blit Fill(315,240,10,10,63)
_COPY=Aga Blit Copy(18,24,18,210,86,40)

If _F1<>1 or _F2<>1 or _F0<>1 or _BADCOL<>0 or _BADRECT<>0 or _COPY<>1
   Aga Screen Close
   Amos To Front
   Print "RESULT ERROR"
   Print _F1;_F2;_F0;_BADCOL;_BADRECT;_COPY
   End
End If

_SWAP=Aga Swap
If _SWAP=0
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED"
   End
End If

Amos To Back
_KEY=Aga Wait Key
Aga Screen Close
Amos To Front
Print "F1 ";_F1;" F2 ";_F2;" F0 ";_F0
Print "COL ";_BADCOL;" RECT ";_BADRECT
Print "COPY ";_COPY;" SWAP ";_SWAP
Print "KEY ";_KEY;" CLOSE RETURNED"
End
