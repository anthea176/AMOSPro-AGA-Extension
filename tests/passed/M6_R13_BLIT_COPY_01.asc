' M6 R13 0.7.0 preview - FIRST Blitter Copy test
' Requires experimental R13 preview .Lib, NOT the R12 stable file.
' Select any 320x256 ILBM image using Fsel.
' Expect two overlapping rectangles copying from the image and no crash.
' This is one integrated test, not a benchmark.

Cls
Print "M6-R13-BLIT-COPY-01"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_COLORS=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
Print "IMAGE ";_W;" X ";_H
If _W<>320 or _H<>256 or _COLORS<=0
   Print "CHOOSE A 320 X 256 IFF"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_COLORS,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If

_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If

_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If

' Copy from top left to bottom middle, no overlap.
_C1=Aga Blit Copy(0,0,160,128,96,80)
' Copy this new rectangle again with horizontal and vertical overlap.
_C2=Aga Blit Copy(160,128,176,144,96,80)
' Must refuse out of range without altering back buffer.
_BAD=Aga Blit Copy(310,250,0,0,20,20)

If _C1<>1 or _C2<>1 or _BAD<>0
   Aga Screen Close
   Amos To Front
   Print "COPY RESULT ERROR: ";_C1;" ";_C2;" ";_BAD
   End
End If

_SWAP=Aga Swap
If _SWAP=0
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED"
   End
End If

Amos To Back
_K=Aga Wait Key
Aga Screen Close
Amos To Front
Print "COPY1 ";_C1;" COPY2 ";_C2;" BAD ";_BAD
Print "SWAP ";_SWAP;" KEY ";_K;" CLOSE RETURNED"
Print "CHECK THE DUPLICATED PIXELS / NO GRAPHIC CORRUPTION"
End
