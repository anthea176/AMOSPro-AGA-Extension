' M4b R6B-R4 - TEST 01: NONBLOCKING SINGLE SWAP
Cls
Print "R6B-R4 TEST 01 - NONBLOCKING SWAP"
_OK=Aga Screen Open(320,256,256,$00021000)
Amos To Front
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      Print "BEFORE SWAP"
      _SW=Aga Swap
      Print "SWAP = ";_SW
      Print "AFTER SWAP"
      For _I=1 To 5
         Aga Wait Vbl
      Next _I
   End If
   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "TEST 01 FINISHED"
Wait Key
End
