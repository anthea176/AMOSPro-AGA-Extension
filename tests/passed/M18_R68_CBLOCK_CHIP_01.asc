' M18 R68 - CBlock temporary CHIP - WinUAE AMOS INTERPRETED ONLY.
' Banks 11, 12, 13 MUST BE FREE. No ABK is saved or loaded.
' Method: 0 CPU8, 1 CPU16, 2 Blitter. Horizontal alignment in PIXELS.
' No AMOS Compiler test before the final M18 Gate C.
Dim _TC(2)
Dim _TD(2)
Cls
Print "M18-R68-CBLOCK-CHIP-01"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_K0=Aga Palette Set(0,0,0,0)
_K2=Aga Palette Set(2,32,48,96)
_K4=Aga Palette Set(4,255,0,0)
_K5=Aga Palette Set(5,0,255,0)
_K255=Aga Palette Set(255,255,255,255)
_SW0=0
For _TRY=1 To 40
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_BG=0
For _TRY=1 To 40
   If _BG=0
      _BG=Aga Blit Fill(0,0,320,256,2)
   End If
   If _BG=0
      Aga Wait Vbl
   End If
Next _TRY
' Source 24x16: green/red/black. Index 0 is OPAQUE on restoration.
_P0=Aga Blit Fill(16,48,24,16,4)
_P1=Aga Blit Fill(24,52,8,8,0)
_P2=Aga Blit Fill(32,48,8,16,5)
_C24=Aga C Block Capture(11,16,48,24,16,2)
If _C24<>1
   Aga Screen Close
   Amos To Front
   Print "CBLOCK 11 CREATE FAILED - CHECK BANK 11 AND CHIP"
   End
End If
_PTR11=Start(11)
_LEN11=Length(11)
_CFNEW=Chip Free
' Recapture into SAME Chip bank: no allocation and original X becomes 32.
_P3=Aga Blit Fill(32,48,24,16,5)
_P4=Aga Blit Fill(40,52,8,8,0)
_RECAP=Aga C Block Capture(11,32,48,24,16,0)
_CFRE=Chip Free
_SAME=0
If _RECAP=1
   If Start(11)=_PTR11
      _SAME=1
   End If
End If
' Test 8-pixel Blitter destination; recapture target into bank 13 to compare.
_DRBL=Aga C Block Draw(11,96,120,2)
_CB=Aga C Block Capture(13,96,120,24,16,2)
_EQBL=0 : _MISBL=0
If _CB=1
   _EQBL=1
   If Length(13)<>_LEN11
      _EQBL=0
   Else
      For _I=40 To _LEN11-1
         If Peek(Start(11)+_I)<>Peek(Start(13)+_I)
            _EQBL=0
            Inc _MISBL
         End If
      Next _I
   End If
   Erase 13
End If
' CPU-byte path at X=8 and another exact planar comparison.
_DRBY=Aga C Block Draw(11,8,120,0)
_CC=Aga C Block Capture(13,8,120,24,16,2)
_EQBY=0 : _MISBY=0
If _CC=1
   _EQBY=1
   If Length(13)<>_LEN11
      _EQBY=0
   Else
      For _I=40 To _LEN11-1
         If Peek(Start(11)+_I)<>Peek(Start(13)+_I)
            _EQBY=0
            Inc _MISBY
         End If
      Next _I
   End If
   Erase 13
End If
_RST24=Aga C Block Restore(11,2)
' Second bank: 32x16, 16-pixel aligned for CPU-word path.
_P5=Aga Blit Fill(16,80,32,16,255)
_P6=Aga Blit Fill(24,84,16,8,0)
_C32=Aga C Block Capture(12,16,80,32,16,1)
If _C32<>1
   Aga Screen Close
   Amos To Front
   Erase 11
   Print "CBLOCK 12 CREATE FAILED - CHECK BANK 12 AND CHIP"
   End
End If
_LEN12=Length(12)
_DRWD=Aga C Block Draw(12,160,120,1)
_RST32=Aga C Block Restore(12,1)
_CD=Aga C Block Capture(13,160,120,32,16,2)
_EQWD=0 : _MISWD=0
If _CD=1
   _EQWD=1
   If Length(13)<>_LEN12
      _EQWD=0
   Else
      For _I=40 To _LEN12-1
         If Peek(Start(12)+_I)<>Peek(Start(13)+_I)
            _EQWD=0
            Inc _MISWD
         End If
      Next _I
   End If
   Erase 13
End If
' Invalid calls: no rounding, clipping or bank replacement.
_BAD8=Aga C Block Capture(11,12,48,24,16,2)
_BADDIM=Aga C Block Capture(11,32,48,32,16,0)
_BADWORD=Aga C Block Draw(11,96,120,1)
_BADOUT=Aga C Block Draw(11,304,120,2)
_BADBANK=Aga C Block Draw(4,96,120,2)
_BADMODE=Aga C Block Restore(11,3)
_BADX=Aga C Block Draw(11,97,120,2)
' Benchmark of the same 32x16 block, without Reserve/Erase cost.
' Timer results are PAL ticks (50 Hz): no speed verdict without repeats.
_N=300
_ERR=0
For _M=0 To 2
   _T0=Timer
   For _I=1 To _N
      _OK=Aga C Block Capture(12,16,80,32,16,_M)
      If _OK<>1
         Inc _ERR
      End If
   Next _I
   _TC(_M)=Timer-_T0
   _T0=Timer
   For _I=1 To _N
      _OK=Aga C Block Draw(12,160,152,_M)
      If _OK<>1
         Inc _ERR
      End If
   Next _I
   _TD(_M)=Timer-_T0
Next _M
' Expected visible screen after swap: three coloured blocks on blue.
' X8 CPU8 / X96 BLIT8 (24x16), X160 CPU16 (32x16).
' X240 remains blue. Black centres are index 0 restored opaquely.
_SW1=0
For _TRY=1 To 40
   If _SW1=0
      _SW1=Aga Swap
   End If
   If _SW1=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW1=1
   Amos To Back
End If
For _HOLD=1 To 175
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOS=Aga C Block Restore(11,2)
Erase 12
Erase 11
_CFEND=Chip Free
_RESULT=1
If _OPEN<>1 or _DB<>1 or _SW0<>1 or _SW1<>1 or _BG<>1
   _RESULT=0
End If
If _K0<>1 or _K2<>1 or _K4<>1 or _K5<>1 or _K255<>1
   _RESULT=0
End If
If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1 or _P4<>1 or _P5<>1 or _P6<>1
   _RESULT=0
End If
If _C24<>1 or _RECAP<>1 or _C32<>1 or _DRBL<>1 or _DRBY<>1 or _DRWD<>1
   _RESULT=0
End If
If _RST24<>1 or _RST32<>1 or _CB<>1 or _CC<>1 or _CD<>1
   _RESULT=0
End If
If _LEN11<>552 or _LEN12<>552 or _SAME<>1 or _CFNEW<>_CFRE
   _RESULT=0
End If
If _EQBL<>1 or _EQBY<>1 or _EQWD<>1 or _MISBL<>0 or _MISBY<>0 or _MISWD<>0
   _RESULT=0
End If
If _BAD8<>0 or _BADDIM<>0 or _BADWORD<>0 or _BADOUT<>0
   _RESULT=0
End If
If _BADBANK<>0 or _BADMODE<>0 or _BADX<>0 or _ERR<>0
   _RESULT=0
End If
If _NOS<>0 or _CLOSED<>-1 or _CF0<>_CFEND
   _RESULT=0
End If
Cls
Print "M18-R68-CBLOCK-CHIP-01"
Print "OPEN/DB/SWAPS ";_OPEN;" ";_DB;" ";_SW0;" ";_SW1
Print "CAP24/RECAP/SAME ";_C24;" ";_RECAP;" ";_SAME
Print "BLIT/CPU8/WORD DRAW ";_DRBL;" ";_DRBY;" ";_DRWD
Print "REST24/32 ";_RST24;" ";_RST32
Print "LEN 24/32 ";_LEN11;" ";_LEN12
Print "PLANE EQ BLIT/CPU8/WORD ";_EQBL;" ";_EQBY;" ";_EQWD
Print "BYTE MISMATCH ";_MISBL;" ";_MISBY;" ";_MISWD
Print "BAD 8/DIM/WORD/OUT ";_BAD8;" ";_BADDIM;" ";_BADWORD;" ";_BADOUT
Print "BAD BANK/MODE/X ";_BADBANK;" ";_BADMODE;" ";_BADX
Print "BENCH CAP CPU8/16/BLIT ";_TC(0);" ";_TC(1);" ";_TC(2)
Print "BENCH DRAW CPU8/16/BLIT ";_TD(0);" ";_TD(1);" ";_TD(2)
Print "BENCH ERR ";_ERR
Print "CHIP REC/CURRENT ";_CFNEW;" ";_CFRE
Print "CHIP START/END ";_CF0;" ";_CFEND
Print "NOS/CLOSE ";_NOS;" ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
