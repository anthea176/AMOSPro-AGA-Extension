' M5 R8 0.5.9 - VISIBLE checkpoints for Fallout path.
' No Swap, no Wait Key, no AGA screen drawing.
' Select a file once. The AMOS screen is brought to front AFTER
' each successful return, so the last displayed checkpoint is useful.
' A blinking cursor/moving mouse does NOT prove AMOS BASIC advances.
' Use only with R8 and only one trial in a clean WinUAE session.

Cls
Print "M5 R8 - LOAD ONLY / VISIBLE CHECKPOINTS"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_P=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,3)
_Z=Aga Pic Info(_FILE$,4)
_MODE=Aga Pic Info(_FILE$,6)
_COLORS=Aga Pic Info(_FILE$,7)
Print "PIC INFO: ";_W;"X";_H;" P";_P;" C";_C
Print "MODE ";_MODE;" COLORS ";_COLORS;" COMP ";_Z
If _W<=0 or _H<=0 or _P<=0 or _C<=0 or _Z<0 or _COLORS<=0
   Print "PIC INFO FAILED"
   End
End If

Print "BEFORE OPEN"
_OPEN=Aga Screen Open(_W,_H,_COLORS,_MODE)
Amos To Front
Print "AFTER OPEN = ";_OPEN
If _OPEN=0
   Print "OPEN FAILED"
   End
End If

Print "BEFORE DOUBLE BUFFER"
_DB=Aga Double Buffer
Amos To Front
Print "AFTER DOUBLE BUFFER = ";_DB
If _DB=0
   Print "BEFORE CLOSE AFTER DB FAILURE"
   Aga Screen Close
   Amos To Front
   Print "CLOSE RETURNED"
   End
End If

Print "BEFORE IFF LOAD"
_LOAD=Aga Iff Load(_FILE$)
Amos To Front
Print "AFTER IFF LOAD = ";_LOAD

Print "BEFORE CLOSE"
Aga Screen Close
Amos To Front
Print "AFTER CLOSE - NO SWAP / NO WAIT KEY"
End
