' M5 R3R1 - FSEL CLOWN NON-REGRESSION
' Select Clown.iff with Fsel$("**").
' Exact validated screen geometry: 320x200x256.

Cls
Print "M5-R3R1 - FSEL CLOWN"

_FILE$=Fsel$("**")
If _FILE$<>""
   Print _FILE$

   _OK=Aga Screen Open(320,200,256,$00021000)
   Amos To Front
   Print "OPEN = ";_OK

   If _OK<>0
      _DB=Aga Double Buffer
      Print "DOUBLE BUFFER = ";_DB

      If _DB<>0
         _IFF=Aga Iff Load(_FILE$)
         Print "IFF LOAD = ";_IFF

         If _IFF<>0
            _SW=Aga Swap
            Print "SWAP = ";_SW

            If _SW<>0
               Amos To Back
               For _I=1 To 200
                  Aga Wait Vbl
               Next _I
               Amos To Front
            End If
         End If
      End If

      Aga Screen Close
      Print "CLOSE = OK"
   End If
End If

Wait Key
End
