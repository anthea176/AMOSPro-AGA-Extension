' R8 - SINGLE Swap and safe Close (no IFF loader, no repeated Swap)
' Only test AFTER successful R8 68000 CPU + CI preflight.
' Requires R8 0.5.9. Do NOT use old R7 or older Lib.
' One clean WinUAE session; never test this on a corrupted session.

Cls
Print "M5 DB SYNC R8 - SINGLE SWAP / CLOSE"
Print "640 X 512 X 4 PLANES - NO IFF"
_OPEN=Aga Screen Open(640,512,16,167936)
Print "OPEN = ";_OPEN
If _OPEN=0
   Print "OPEN FAILED - STOP"
   End
End If

_DB=Aga Double Buffer
Print "DB = ";_DB
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED - CLOSED"
   End
End If

Aga Screen Pattern
_SW=Aga Swap
Print "SWAP = ";_SW
If _SW=0
   Print "SWAP FAILED - CLOSE WITHOUT ACTIVE SWAP"
End If

Amos To Back
_K=Aga Wait Key
Aga Screen Close
Amos To Front
Print "KEY = ";_K
Print "CLOSE RETURNED - VERIFY SCREEN DISAPPEARED"
End
