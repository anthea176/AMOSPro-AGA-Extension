' M3b 0.0.4 - SECOND TEST: resolution and indexed colors.
' First verify M3B_320.asc works in the interpreter.
' Change the four values here for each mode.
_W=640
_H=256
_COLORS=32
_MODE=$00029000
' PAL LORES:   320,256,256,$00021000
' PAL HIRES:   640,256,32,$00029000
' PAL HIRES LACE (if supported): 640,512,256,$00029004
Print "REQUEST ";_W;" x ";_H;" COLORS=";_COLORS
If Aga Detect<>0
   _OK=Aga Screen Open(_W,_H,_COLORS,_MODE)
   Print "OPEN = ";_OK
   If _OK<>0
      Amos To Back
      Aga Screen Pattern
      Wait 150
      Amos To Front
      Aga Screen Close
   End If
End If
Print "FINISHED"
Wait Key
End
