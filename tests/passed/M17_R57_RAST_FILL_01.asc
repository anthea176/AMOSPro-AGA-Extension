' M17-R57-RAST-FILL-01: self-protected Clear/Fill/Copy, 40 swaps.
' Requires R57 0.13.2 in dist/AMOSPro_AGA.Lib. Use examples/demo.iff 320X256X8 PAL.
' BLUE panel, two GREEN rectangles then two RED rectangles.
' The FIRST operation each frame rotates Clear/Fill/Copy.
' R57 must check Safe ITSELF; no Aga Text or external Safe probe.
' Retry only after Wait Vbl, at most 12 tries, never spin.
Cls
Print "M17-R57-RAST-FILL-01"
Print "Select demo.iff 320X256X8 PAL"
Print "GREEN / RED PAIRS MUST ALTERNATE"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8 or _C<>256 or _MODE<>$00021000
   Print "NEED demo.iff 320X256X8 PAL"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
_DONE=0
_CASE=0
_ALT=0
_RC=0
_RF=0
_RP=0
_C0=0
_F0=0
_P0=0
_SWAP0=0
_SAFEERR=0
_SWAPERR=0
_DRAWERR=0
Amos To Back
For _FRAME=1 To 40
   _READY=0
   For _TRY=1 To 12
      If _READY=0
         ' Test each legacy function directly as first back-buffer write.
         If _CASE=0
            _ATT=Aga Blit Clear(0,0,320,256)
         Else
            If _CASE=1
               _ATT=Aga Blit Fill(0,0,1,1,3)
            Else
               _ATT=Aga Blit Copy(0,0,1,1,1,1)
            End If
         End If
         If _ATT=1
            _READY=1
            If _CASE=0
               _RC=_RC+1
            Else
               If _CASE=1
                  _RF=_RF+1
               Else
                  _RP=_RP+1
               End If
            End If
         Else
            If _CASE=0
               _C0=_C0+1
            Else
               If _CASE=1
                  _F0=_F0+1
               Else
                  _P0=_P0+1
               End If
            End If
            Aga Wait Vbl
         End If
      End If
   Next _TRY
   If _READY=0
      _SAFEERR=1
      _FRAME=40
   Else
      ' Safe confirmed by THIS R57 RastPort fill, not by Aga Text.
      _CLEAR=Aga Blit Clear(0,0,320,256)
      _PANEL=Aga Blit Fill(22,48,276,158,3)
      If _ALT=0
         _FILL=Aga Blit Fill(42,88,86,50,28)
      Else
         _FILL=Aga Blit Fill(42,88,86,50,224)
      End If
      _COPY=Aga Blit Copy(42,88,192,88,86,50)
      If _CLEAR<>1 or _PANEL<>1 or _FILL<>1 or _COPY<>1
         _DRAWERR=1
         _FRAME=40
      Else
         _SWREADY=0
         For _ST=1 To 12
            If _SWREADY=0
               _SW=Aga Swap
               If _SW=1
                  _SWREADY=1
               Else
                  _SWAP0=_SWAP0+1
                  Aga Wait Vbl
               End If
            End If
         Next _ST
         If _SWREADY=0
            _SWAPERR=1
            _FRAME=40
         Else
            _DONE=_DONE+1
            _ALT=1-_ALT
            _CASE=_CASE+1
            If _CASE=3
               _CASE=0
            End If
         End If
      End If
   End If
Next _FRAME
For _HOLD=1 To 120
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _LOAD<>1
   _RESULT=0
End If
If _DONE<>40 or _RC<>14 or _RF<>13 or _RP<>13
   _RESULT=0
End If
If _SAFEERR<>0 or _SWAPERR<>0 or _DRAWERR<>0
   _RESULT=0
End If
If _CLOSED<>-1
   _RESULT=0
End If
Print "M17-R57-RAST-FILL-01"
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD
Print "DONE ";_DONE;" C ";_RC;" F ";_RF;" P ";_RP
Print "C0 ";_C0;" F0 ";_F0;" P0 ";_P0;" SWAP0 ";_SWAP0
Print "SAFEERR ";_SAFEERR;" SWAPERR ";_SWAPERR;" DRAWERR ";_DRAWERR
Print "CLOSED ";_CLOSED;" RESULT ";_RESULT
Print "CLOSE RETURNED"
' Hold output in interpreted and compiled AMOS without a key press.
Do
   Wait Vbl
Loop
