' R6C-R1 DIAG 01 - SINGLE BACK FILL ONLY
Cls
Print "R6C DIAG 01 - SINGLE BACK FILL"
_OK=Aga Screen Open(320,256,256,$00021000)
Amos To Front
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      Print "BEFORE BACK FILL"
      Aga Back Fill 255
      Print "AFTER BACK FILL"
   End If
   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "DIAG 01 FINISHED"
Wait Key
End
