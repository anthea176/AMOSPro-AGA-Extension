' M8 R23 0.8.7 - IDCMP short clicks + RAWKEY FIFO
' SINGLE ACTIVE WINUAE TEST. Select AGA_TESTCARD_320x256_256C.iff
' While AGA image is shown for ~4 sec, without any input reads:
'   1) click LEFT quickly once (press+release)
'   2) click RIGHT quickly once (press+release)
'   3) tap SPACE twice (release between taps)
' The program polls mouse/keyboard only AFTER the interval.
' Then press any key to finish through Aga Wait Key.
' Aga Wait Key returns the first RAWKEY, including modifier keys.
' $64 / decimal 100 = Left Alt: a valid key, not an error.
' NO Intuition menu bar on right click. Ctrl+C checked separately.
Cls
Print "M8-R23-IDCMP-QUICK-01"
Print "Select AGA_TESTCARD 320x256x8"
Print "During image: click left, right; SPACE twice"
Print "Then press ANY key to finish"
_BEFOREP=Aga Mouse Pressed
_BEFORER=Aga Mouse Released
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8
   Print "USE 320X256X8 TESTCARD"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "LOAD FAILED"
   End
End If
_SWAP=Aga Swap
Amos To Back
_INITP=Aga Mouse Pressed
_INITR=Aga Mouse Released
For _I=1 To 200
   Aga Wait Vbl
Next _I
_P=Aga Mouse Pressed
_R=Aga Mouse Released
_P2=Aga Mouse Pressed
_R2=Aga Mouse Released
_K1=Aga Key
_K2=Aga Key
_K3=Aga Key
_WAITK=Aga Wait Key
_X=Aga Mouse X
_Y=Aga Mouse Y
Aga Screen Close
Amos To Front
_CLOSEP=Aga Mouse Pressed
_CLOSER=Aga Mouse Released
_REOPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _REOPEN=1
   _BASEP=Aga Mouse Pressed
   _BASER=Aga Mouse Released
   Aga Screen Close
Else
   _BASEP=-1
   _BASER=-1
End If
_CLOSE2=Aga Mouse Pressed
Amos To Front
_OK=1
If _OPEN<>1 or _DB<>1 or _LOAD<>1 or _SWAP<>1 or _REOPEN<>1
   _OK=0
End If
If _BEFOREP<>-1 or _BEFORER<>-1 or _CLOSEP<>-1 or _CLOSER<>-1 or _CLOSE2<>-1
   _OK=0
End If
If _P<>3 or _R<>3 or _P2<>0 or _R2<>0
   _OK=0
End If
If _K1<>64 or _K2<>64 or _K3<>-1 or _WAITK<0
   _OK=0
End If
If _BASEP<>0 or _BASER<>0
   _OK=0
End If
Print "M8-R23-IDCMP-QUICK-01"
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD;" SWAP ";_SWAP
Print "BEFORE ";_BEFOREP;" ";_BEFORER;" INIT ";_INITP;" ";_INITR
Print "PRESSED ";_P;" RELEASED ";_R;" AGAIN ";_P2;" ";_R2
Print "KEYS ";_K1;" ";_K2;" ";_K3;" WAIT ";_WAITK
Print "MOUSE ";_X;" ";_Y
Print "CLOSED ";_CLOSEP;" ";_CLOSER;" CLOSE2 ";_CLOSE2
Print "REOPEN ";_REOPEN;" BASE ";_BASEP;" ";_BASER
Print "RESULT ";_OK
Print "CLOSE X2 RETURNED"
End
