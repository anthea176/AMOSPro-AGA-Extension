' M14-R38-CHIP-STRESS-01: 500 font switches on one private AGA screen.
' 100 rounds x 5 selections: AMCAF Topaz / Hwarf / Pix3M /
' AmigaOS Topaz / Hwarf. One Aga Text after EVERY selection.
' Requires R38 LAST_GOOD. No AMCAF runtime extension needed.
' Copy AMCAF_FONT9.abk, Hwarf1252S.abk and Pix3M-1252L.abk to RAM:.
' WARNING: replaces AMOS banks 10, 11 and 12.
' Compare samples 0..500 at the SAME selected font (Hwarf).
' CHIP = Chip Free; BIG = Exec AvailMem(MEMF_CHIP|MEMF_LARGEST).
' Dreg(1)=$20002, Execall(-216): official V36+ Exec ABI.
' A growing positive CHIP DROP suggests leakage; BIG DROP alone may
' be fragmentation. Other OS tasks can cause small variations.
Cls
Print "M14-R38-CHIP-STRESS-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
Load "RAM:AMCAF_FONT9.abk",10
Load "RAM:Hwarf1252S.abk",11
Load "RAM:Pix3M-1252L.abk",12
Dim _CF(5),_LG(5)
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_PA=Aga Palette Set(1,255,255,255)
_CL=Aga Blit Clear(0,0,320,256)
If _PA<>1 or _CL<>1
   Aga Screen Close
   Amos To Front
   Print "DRAW SETUP FAILED"
   End
End If
' Warm all FOUR font paths and their text rendering once.
_PREOK=1
_S=Aga Font Bank Select(Start(10),Length(10))
_T=Aga Text(24,90,1,"ABC 123")
If _S<>1 or _T<>1
   _PREOK=0
End If
_S=Aga Font Bank Select(Start(11),Length(11))
_T=Aga Text(24,90,1,"ABC 123")
If _S<>1 or _T<>1
   _PREOK=0
End If
_S=Aga Font Bank Select(Start(12),Length(12))
_T=Aga Text(24,90,1,"ABC 123")
If _S<>1 or _T<>1
   _PREOK=0
End If
_S=Aga Font Select("topaz.font",8)
_T=Aga Text(24,90,1,"ABC 123")
If _S<>1 or _T<>1
   _PREOK=0
End If
_S=Aga Font Bank Select(Start(11),Length(11))
_T=Aga Text(24,90,1,"ABC 123")
If _S<>1 or _T<>1
   _PREOK=0
End If
If _PREOK<>1
   _RESET=Aga Font Select("",0)
   Aga Screen Close
   Amos To Front
   Print "PRECHECK FAILED (FONT OR TEXT)"
   End
End If
' Start at Hwarf selected, after rendering has warmed up.
_CF(0)=Chip Free
Dreg(1)=$20002
_LG(0)=Execall(-216)
_ERR=0
_K=0
_TOTAL=0
For _R=1 To 100
   _S=Aga Font Bank Select(Start(10),Length(10))
   _T=Aga Text(24,90,1,"ABC 123")
   If _S<>1 or _T<>1
      _ERR=_ERR+1
   End If
   _TOTAL=_TOTAL+1
   _S=Aga Font Bank Select(Start(11),Length(11))
   _T=Aga Text(24,90,1,"ABC 123")
   If _S<>1 or _T<>1
      _ERR=_ERR+1
   End If
   _TOTAL=_TOTAL+1
   _S=Aga Font Bank Select(Start(12),Length(12))
   _T=Aga Text(24,90,1,"ABC 123")
   If _S<>1 or _T<>1
      _ERR=_ERR+1
   End If
   _TOTAL=_TOTAL+1
   _S=Aga Font Select("topaz.font",8)
   _T=Aga Text(24,90,1,"ABC 123")
   If _S<>1 or _T<>1
      _ERR=_ERR+1
   End If
   _TOTAL=_TOTAL+1
   _S=Aga Font Bank Select(Start(11),Length(11))
   _T=Aga Text(24,90,1,"ABC 123")
   If _S<>1 or _T<>1
      _ERR=_ERR+1
   End If
   _TOTAL=_TOTAL+1
   If _R=20 or _R=40 or _R=60 or _R=80 or _R=100
      _K=_K+1
      _CF(_K)=Chip Free
      Dreg(1)=$20002
      _LG(_K)=Execall(-216)
   End If
Next _R
' Reset frees current Hwarf private copy.
_RESET=Aga Font Select("",0)
_CFRESET=Chip Free
Dreg(1)=$20002
_LGRESET=Execall(-216)
_DONE=Aga Text(24,190,1,"R38 CHIP TEST DONE")
_SW=Aga Swap
If _SW=1
   Amos To Back
   For _I=1 To 90
      Aga Wait Vbl
   Next _I
End If
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Font Bank Select(0,0)
_CLOSED=Aga Mouse X
_CFEND=Chip Free
Dreg(1)=$20002
_LGEND=Execall(-216)
_DROP=_CF(0)-_CF(5)
_BDROP=_LG(0)-_LG(5)
_WARN=0
If _DROP>2048
   _WARN=1
End If
_RESULT=1
If _TOTAL<>500 or _ERR<>0 or _RESET<>1
   _RESULT=0
End If
If _DONE<>1 or _SW<>1 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "M14-R38-CHIP-STRESS-01"
Print "SWITCHES ";_TOTAL;" ERR ";_ERR
Print "SAMPLE CHIP FREE   BIGGEST FREE"
For _I=0 To 5
   Print _I*100;"  ";_CF(_I);"  ";_LG(_I)
Next _I
Print "CHIP DROP ";_DROP;" BIG DROP ";_BDROP
Print "RESET ";_CFRESET;"  ";_LGRESET
Print "CLOSED ";_CFEND;"  ";_LGEND
Print "CHIP_WARN ";_WARN;" (not proof)"
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
