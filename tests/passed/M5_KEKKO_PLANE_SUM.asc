' M5 R4D1 - KEKKO PLANE SUM - MINIMAL
' No PicInfo and no nested preconditions before Screen Open.
' Select KEKKO.IFF with Fsel$("**").

Cls
Print "M5 R4D1 - KEKKO MINIMAL"

_FILE$=Fsel$("**")
If _FILE$<>""
   Print _FILE$

   Print "BEFORE OPEN"
   _OK=Aga Screen Open(320,256,16,$00021000)
   Amos To Front
   Print "OPEN = ";_OK

   If _OK<>0
      Print "BEFORE DB"
      _DB=Aga Double Buffer
      Print "DB = ";_DB

      If _DB<>0
         Print "BEFORE IFF"
         _IFF=Aga Iff Load(_FILE$)
         Print "IFF = ";_IFF

         If _IFF<>0
            Print "BEFORE SUM"
            _S0=Aga Plane Sum(0)
            _S1=Aga Plane Sum(1)
            _S2=Aga Plane Sum(2)
            _S3=Aga Plane Sum(3)

            Print "P0 = ";_S0;" / 266241"
            Print "P1 = ";_S1;" / 282856"
            Print "P2 = ";_S2;" / 2319534"
            Print "P3 = ";_S3;" / 158428"
         End If
      End If

      Aga Screen Close
      Print "CLOSE = OK"
   End If
End If

Wait Key
End
