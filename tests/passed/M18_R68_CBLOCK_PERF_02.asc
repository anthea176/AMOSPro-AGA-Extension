' M18/R68 CBlock performance 02 - AMOS INTERPRETED ONLY.
' WinUAE 68020/68030 NO JIT; record real CPU clock / RAM in results.
' Uses ONLY Bank 11 and Bank 13: BOTH MUST BE FREE.
' Never run AMOS Compiler here. R68 library must already be installed.
' Methods: 0 CPU8, 1 CPU16, 2 Blitter. All lengths are PIXELS.
' C/D times: 2 x N calls per method, all in AMOS Timer ticks.
' -1 = CPU16 not possible for width 24 (16-pixel alignment).
Dim _W(5)
Dim _H(5)
Dim _N(5)
Dim _SX(5)
Dim _SY(5)
Dim _DX(5)
Dim _DY(5)
Dim _TC(5,2)
Dim _TD(5,2)
_W(0)=16 : _H(0)=16 : _N(0)=600
_W(1)=24 : _H(1)=16 : _N(1)=500
_W(2)=32 : _H(2)=16 : _N(2)=400
_W(3)=64 : _H(3)=48 : _N(3)=120
_W(4)=128 : _H(4)=96 : _N(4)=40
_W(5)=320 : _H(5)=64 : _N(5)=35
For _S=0 To 5
   _SX(_S)=16 : _SY(_S)=24
   _DX(_S)=160 : _DY(_S)=136
Next _S
_SX(1)=8 : _DX(1)=168
_SX(5)=0 : _DX(5)=0
Cls
Print "M18-R68-CBLOCK-PERF-02"
If Aga Detect=0
   Print "AGA MISSING"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,0,0,0)
_P2=Aga Palette Set(2,32,48,96)
_P4=Aga Palette Set(4,255,0,0)
_P5=Aga Palette Set(5,0,255,0)
_SW0=0
For _TRY=1 To 40
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_ERR=0 : _MIS=0 : _MEM=0 : _RUNS=0
If _P0<>1 or _P2<>1 or _P4<>1 or _P5<>1 or _SW0<>1
   Inc _ERR
End If
_BASE=Chip Free
For _S=0 To 5
   ' Reset the SAME inactive AGA back buffer before each size.
   _BG=0
   For _TRY=1 To 40
      If _BG=0
         _BG=Aga Blit Fill(0,0,320,256,2)
      End If
      If _BG=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _BG<>1
      Inc _ERR
   End If
   _PA=Aga Blit Fill(_SX(_S),_SY(_S),_W(_S),_H(_S),5)
   If _PA<>1
      Inc _ERR
   End If
   If _W(_S)>16
      _PB=Aga Blit Fill(_SX(_S)+8,_SY(_S)+4,_W(_S)-16,_H(_S)-8,0)
      If _PB<>1
         Inc _ERR
      End If
   End If
   _CREATE=Aga C Block Capture(11,_SX(_S),_SY(_S),_W(_S),_H(_S),2)
   If _CREATE<>1
      Inc _ERR
   Else
      _CFBANK=Chip Free
      For _M=0 To 2
         If _S=1 And _M=1
            ' CPU16 requires 16-pixel width; width 24 is invalid.
            _TC(_S,_M)=-1 : _TD(_S,_M)=-1
         Else
            Inc _RUNS
            _PTR=Start(11)
            For _REPEAT=1 To 2
               _T0=Timer
               For _I=1 To _N(_S)
                  _OK=Aga C Block Capture(11,_SX(_S),_SY(_S),_W(_S),_H(_S),_M)
                  If _OK<>1
                     Inc _ERR
                  End If
               Next _I
               _TC(_S,_M)=_TC(_S,_M)+Timer-_T0
               _T0=Timer
               For _I=1 To _N(_S)
                  _OK=Aga C Block Draw(11,_DX(_S),_DY(_S),_M)
                  If _OK<>1
                     Inc _ERR
                  End If
               Next _I
               _TD(_S,_M)=_TD(_S,_M)+Timer-_T0
            Next _REPEAT
            If Start(11)<>_PTR or Chip Free<>_CFBANK
               Inc _MEM
            End If
            ' Pixel-equivalence check is OUTSIDE timing.
            _VALID=Aga C Block Capture(13,_DX(_S),_DY(_S),_W(_S),_H(_S),2)
            If _VALID<>1
               Inc _ERR
            Else
               If Length(13)<>Length(11)
                  Inc _MIS
               Else
                  For _BYTE=40 To Length(11)-1
                     If Peek(Start(11)+_BYTE)<>Peek(Start(13)+_BYTE)
                        Inc _MIS
                     End If
                  Next _BYTE
               End If
               Erase 13
            End If
            If Chip Free<>_CFBANK
               Inc _MEM
            End If
         End If
      Next _M
      Erase 11
      If Chip Free<>_BASE
         Inc _MEM
      End If
   End If
Next _S
_SW1=0
For _TRY=1 To 40
   If _SW1=0
      _SW1=Aga Swap
   End If
   If _SW1=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW1=1
   Amos To Back
End If
For _HOLD=1 To 125
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOS=Aga C Block Restore(11,2)
_CFEND=Chip Free
_RESULT=1
If _OPEN<>1 or _DB<>1 or _SW0<>1 or _SW1<>1
   _RESULT=0
End If
If _RUNS<>17 or _ERR<>0 or _MIS<>0 or _MEM<>0
   _RESULT=0
End If
If _NOS<>0 or _CLOSED<>-1 or _CFEND<>_CF0
   _RESULT=0
End If
Cls
Print "M18-R68-CBLOCK-PERF-02"
Print "C/D=CPU8/CPU16/BLIT ticks"
Print "N=2 passes; -1=CPU16 skip"
For _S=0 To 5
   Print "S";_S;" ";_W(_S);"x";_H(_S);" N";_N(_S)*2
   Print "C";_TC(_S,0);"/";_TC(_S,1);"/";_TC(_S,2);" D";_TD(_S,0);"/";_TD(_S,1);"/";_TD(_S,2)
Next _S
Print "RUNS/ERR/MIS/MEM";_RUNS;" ";_ERR;" ";_MIS;" ";_MEM
Print "CHIP START/END";_CF0;" ";_CFEND
Print "NOS/CLOSE";_NOS;" ";_CLOSED
Print "RESULT";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
