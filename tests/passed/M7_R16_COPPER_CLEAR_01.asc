' M7 R16 0.8.0 — Copper Clear ownership/CloseScreen foundation
' Not an active raster effect yet: CEND-only UCopList.
' Install R16 candidate and select MYGIRL.IFF (320x256x8).
' C1/C2: first allocation + idempotent second call.
' C3: re-opened screen gets a new list; both CloseScreen calls must return.

Cls
Print "M7-R16-COPPER-CLEAR-01"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8
   Print "SELECT MYGIRL.IFF 320X256X8"
   End
End If
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D

_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If

_C1=Aga Copper Clear
_C2=Aga Copper Clear
_SWAP=Aga Swap
If _C1<>1 or _C2<>1 or _SWAP<>1
   Aga Screen Close
   Amos To Front
   Print "COPPER INIT/SWAP FAILED"
   Print "C1 ";_C1;" C2 ";_C2;" SWAP ";_SWAP
   End
End If
Amos To Back
_KEY=Aga Wait Key
Aga Screen Close
Amos To Front

_OPEN2=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN2=0
   Print "REOPEN FAILED"
   End
End If
_C3=Aga Copper Clear
Aga Screen Close
Amos To Front
Print "M7-R16-COPPER-CLEAR-01"
Print "C1 ";_C1;" C2 ";_C2;" C3 ";_C3
Print "OPEN ";_OPEN;" REOPEN ";_OPEN2
Print "SWAP ";_SWAP;" KEY ";_KEY
Print "CLOSE X2 RETURNED"
End
