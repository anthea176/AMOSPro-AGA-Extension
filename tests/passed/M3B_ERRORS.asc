' M3b 0.0.4 - negative and idempotence tests.
' Test ONLY after M3B_320 has passed; do not hide AMOS here.
Aga Screen Close
Aga Screen Close
_X=Aga Screen Open(320,256,3,$00021000)
Print "INVALID COLORS 3 (EXPECT 0) = ";_X
_X=Aga Screen Open(333,256,256,$00021000)
Print "INVALID WIDTH 333 (EXPECT 0) = ";_X
_X=Aga Screen Open(320,256,256,$00021800)
Print "HAM REJECT (EXPECT 0) = ";_X
_X=Aga Screen Open(320,256,256,$00021000)
Print "VALID OPEN (EXPECT NONZERO) = ";_X
_Y=Aga Screen Open(320,256,256,$00021000)
Print "SECOND OPEN (EXPECT 0) = ";_Y
Aga Screen Close
Aga Screen Close
Print "TWO CLOSES - FINISHED"
Wait Key
End
