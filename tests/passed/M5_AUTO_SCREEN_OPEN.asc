' M5 - AUTO SCREEN OPEN FROM AGA PIC INFO
' Uses current PicInfo candidate. No IFF BODY decode here.
' Select an image with Fsel$("**").

Cls
Print "M5 - AUTO SCREEN OPEN"

_FILE$=Fsel$("**")
If _FILE$<>""
   _W=Aga Pic Info(_FILE$,0)
   _H=Aga Pic Info(_FILE$,1)
   _P=Aga Pic Info(_FILE$,2)
   _C=Aga Pic Info(_FILE$,3)
   _Z=Aga Pic Info(_FILE$,4)
   _M=Aga Pic Info(_FILE$,5)

   Print _FILE$
   Print "W/H = ";_W;"/";_H
   Print "PLANES = ";_P
   Print "COLORS = ";_C
   Print "COMP = ";_Z
   Print "CAMG = ";_M

   If _W>0
      If _H>0
         If _C>0
            _MODE=_M
            If _MODE=0
               _MODE=$00021000
            End If

            _OK=Aga Screen Open(_W,_H,_C,_MODE)
            Amos To Front
            Print "OPEN = ";_OK
            Print "MODE = ";_MODE

            If _OK<>0
               Amos To Back
               For _I=1 To 200
                  Aga Wait Vbl
               Next _I
               Amos To Front
               Aga Screen Close
               Print "CLOSE = OK"
            End If
         End If
      End If
   End If
End If

Wait Key
End
