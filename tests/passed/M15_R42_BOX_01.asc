' M15-R42-BOX-01 : Gate B AMOS interpreted / WinUAE (not tested yet).
' Use R42 0.11.3 candidate and keep R41 LAST_GOOD untouched.
' Inclusive rectangular OUTLINES only; reversed corners and safe clipping.
Cls
Print "M15-R42-BOX-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,255,128,32)
_P3=Aga Palette Set(3,128,255,128)
_P4=Aga Palette Set(4,80,160,255)
_P5=Aga Palette Set(5,255,80,160)
_P6=Aga Palette Set(6,255,240,32)
_P7=Aga Palette Set(7,208,128,255)
_P8=Aga Palette Set(8,64,255,240)
_CLR=Aga Blit Clear(0,0,320,256)
_T1=Aga Text(23,22,1,"M15 R42 - AGA BOX")
_T2=Aga Text(22,236,1,"CLIPPED RECTANGLES")
' Frame, nested boxes and reversed corners.
_B0=Aga Box(0,0,319,255,1)
_B1=Aga Box(25,35,294,218,2)
_B2=Aga Box(75,75,245,180,3)
_REV=Aga Box(238,173,82,83,4)
' Four corners outside individually: visible sides clipped safely.
_CL=Aga Box(-40,40,90,130,5)
_CR=Aga Box(240,40,380,130,6)
_CT=Aga Box(60,-40,260,70,7)
_CB=Aga Box(60,180,260,300,8)
' Degenerate one-pixel-high/one-pixel-wide boxes and a single dot.
_LH=Aga Box(42,199,262,199,2)
_LV=Aga Box(162,45,162,206,3)
_DOT=Aga Box(160,128,160,128,1)
' Outside rectangles: return 0, no memory or other screen touched.
_O0=Aga Box(-65,20,-1,230,1)
_O1=Aga Box(320,20,390,230,1)
_O2=Aga Box(20,-50,290,-1,1)
_O3=Aga Box(20,256,290,320,1)
' Enclosing screen: all four ORIGINAL sides are invisible.
_WRAP=Aga Box(-20,-20,340,280,1)
' 32-bit out of range coordinates must NOT be silently truncated.
_BADL=Aga Box(32768,20,100,100,1)
_BADN=Aga Box(-32769,20,100,100,1)
_BADP=Aga Box(10,10,40,40,256)
_BADQ=Aga Box(10,10,40,40,-1)
_SW=Aga Swap
If _SW=1
   Amos To Back
End If
' A newly inactive buffer can only be drawn after Safe.
_SAFE=0
For _I=1 To 30
   If _SAFE=0
      _SAFE=Aga Box(-16,90,152,173,6)
   End If
   Aga Wait Vbl
Next _I
For _I=1 To 135
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Box(0,0,10,10,1)
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _CLR<>1 or _T1<>1 or _T2<>1
   _RESULT=0
End If
If _P1<>1 or _P2<>1 or _P3<>1 or _P4<>1
   _RESULT=0
End If
If _P5<>1 or _P6<>1 or _P7<>1 or _P8<>1
   _RESULT=0
End If
If _B0<>1 or _B1<>1 or _B2<>1 or _REV<>1
   _RESULT=0
End If
If _CL<>1 or _CR<>1 or _CT<>1 or _CB<>1
   _RESULT=0
End If
If _LH<>1 or _LV<>1 or _DOT<>1
   _RESULT=0
End If
If _O0<>0 or _O1<>0 or _O2<>0 or _O3<>0 or _WRAP<>0
   _RESULT=0
End If
If _BADL<>0 or _BADN<>0 or _BADP<>0 or _BADQ<>0
   _RESULT=0
End If
If _SW<>1 or _SAFE<>1 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "M15-R42-BOX-01"
Print "OPEN ";_OPEN;" DB ";_DB;" CLEAR ";_CLR
Print "BOXES ";_B0;" ";_B1;" ";_B2;" REV ";_REV
Print "CLIPPED ";_CL;" ";_CR;" ";_CT;" ";_CB
Print "LINES ";_LH;" ";_LV;" DOT ";_DOT
Print "OUTSIDE ";_O0;" ";_O1;" ";_O2;" ";_O3
Print "WRAP ";_WRAP;" BADLONG ";_BADL;" ";_BADN
Print "BADPEN ";_BADP;" ";_BADQ
Print "SWAP ";_SW;" BACKSAFE ";_SAFE
Print "NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
