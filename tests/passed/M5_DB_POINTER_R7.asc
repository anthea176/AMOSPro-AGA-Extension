' M5 / R7 - DBufInfo pointer regression, fixed Fallout geometry.
' Execute ONLY with R7 0.5.8 in a NEW WinUAE session.
' NO Fsel, NO PicInfo, NO IFF Load, NO Pattern, NO Swap.
' DO NOT run this with R6 or older: pointer reads can corrupt memory.
' One normal key only. Do not Ctrl+C during this test.

Cls
Print "M5 R7 DB POINTER CHECK - 640X512X4"
Print "OPEN START"
_OPEN=Aga Screen Open(640,512,16,167936)
Print "OPEN RETURNED ";_OPEN
If _OPEN=0
   Print "OPEN FAILED - NO DB"
   End
End If

Print "DOUBLE BUFFER START"
_DB=Aga Double Buffer
Print "DB RETURNED ";_DB
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED - SCREEN CLOSED"
   End
End If

Print "NORMAL KEY TO CLOSE (NO SWAP)"
Amos To Back
_K=Aga Wait Key
Aga Screen Close
Amos To Front
Print "CLOSE COMPLETED; KEY = ";_K
Print "NO IFF LOADER / NO SWAP"
End
