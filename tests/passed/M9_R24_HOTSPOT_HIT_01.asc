' M9 R24 0.9.0 - one WinUAE test for stateless rectangle hit
' Select original AGA_TESTCARD_320x256_256C.iff 320x256x8.
' THREE COLOURED RECTS; first and second overlap.
' LEFT CLICK in the overlap near (130,100) -> topmost zone ID20.
' RIGHT CLICK outside all rects near (300,220) -> zone ID0.
' Wait for test result, up to about 18 seconds.
Cls
Print "M9-R24-HOTSPOT-HIT-01"
Print "Select AGA_TESTCARD 320X256X8"
Print "LEFT click overlap rectangle near X130 Y100"
Print "RIGHT click empty bottom right near X300 Y220"
Print "Then wait for results"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8
   Print "USE 320X256X8 TESTCARD"
   End
End If
' Pure hit-test: no screen dependency; exclusive x+w/y+h.
_S1=Aga Hotspot Hit(20,20,20,20,150,120)
_S2=Aga Hotspot Hit(169,139,20,20,150,120)
_S3=Aga Hotspot Hit(170,139,20,20,150,120)
_S4=Aga Hotspot Hit(169,140,20,20,150,120)
_S5=Aga Hotspot Hit(120,90,20,20,150,120)
_S6=Aga Hotspot Hit(120,90,100,70,160,110)
_S7=Aga Hotspot Hit(-1,90,100,70,160,110)
_S8=Aga Hotspot Hit(120,90,100,70,0,110)
_S9=Aga Hotspot Hit(0,0,-5,-5,6,6)
_S10=Aga Hotspot Hit(0,0,-5,-5,5,5)
_STATIC=1
If _S1<>1 or _S2<>1 or _S3<>0 or _S4<>0
   _STATIC=0
End If
If _S5<>1 or _S6<>1 or _S7<>0 or _S8<>0
   _STATIC=0
End If
If _S9<>1 or _S10<>0
   _STATIC=0
End If
' Priority is the calling order: last declared rect wins.
_ID=0
_HA=Aga Hotspot Hit(130,100,20,20,150,120)
_HB=Aga Hotspot Hit(130,100,100,70,160,110)
_HC=Aga Hotspot Hit(130,100,275,15,30,30)
If _HA=1
   _ID=10
End If
If _HB=1
   _ID=20
End If
If _HC=1
   _ID=30
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "LOAD FAILED"
   End
End If
' Three visually distinct hotspot rectangles on the back buffer.
_F1=Aga Blit Fill(20,20,150,120,40)
_F2=Aga Blit Fill(100,70,160,110,130)
_F3=Aga Blit Fill(275,15,30,30,220)
_SWAP=Aga Swap
Amos To Back
_INIT=Aga Mouse Pressed
_LEFT=0
_RIGHT=0
_LCNT=0
_RCNT=0
For _FRAME=1 To 900
   _P=Aga Mouse Pressed
   If _P=1 or _P=3
      _PX=Aga Mouse X
      _PY=Aga Mouse Y
      _H1=Aga Hotspot Hit(_PX,_PY,20,20,150,120)
      _H2=Aga Hotspot Hit(_PX,_PY,100,70,160,110)
      _H3=Aga Hotspot Hit(_PX,_PY,275,15,30,30)
      _ZI=0
      If _H1=1
         _ZI=10
      End If
      If _H2=1
         _ZI=20
      End If
      If _H3=1
         _ZI=30
      End If
      _LEFT=_ZI
      _LCNT=_LCNT+1
   End If
   If _P=2 or _P=3
      _PX=Aga Mouse X
      _PY=Aga Mouse Y
      _H1=Aga Hotspot Hit(_PX,_PY,20,20,150,120)
      _H2=Aga Hotspot Hit(_PX,_PY,100,70,160,110)
      _H3=Aga Hotspot Hit(_PX,_PY,275,15,30,30)
      _ZI=0
      If _H1=1
         _ZI=10
      End If
      If _H2=1
         _ZI=20
      End If
      If _H3=1
         _ZI=30
      End If
      If _ZI=0
         _RIGHT=1
      End If
      _RCNT=_RCNT+1
   End If
   If _LEFT=20 and _RIGHT=1
      _FRAME=900
   End If
   Aga Wait Vbl
Next _FRAME
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_PA=Aga Mouse Pressed
_PURE=Aga Hotspot Hit(130,100,100,70,160,110)
_REOPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _REOPEN=1
   _BASE=Aga Mouse Pressed
   Aga Screen Close
Else
   _BASE=-1
End If
_CLOSE2=Aga Mouse Pressed
Amos To Front
_GOOD=1
If _STATIC<>1 or _ID<>20 or _PURE<>1
   _GOOD=0
End If
If _OPEN<>1 or _DB<>1 or _LOAD<>1 or _SWAP<>1
   _GOOD=0
End If
If _F1<>1 or _F2<>1 or _F3<>1
   _GOOD=0
End If
If _LEFT<>20 or _RIGHT<>1
   _GOOD=0
End If
If _CLOSED<>-1 or _PA<>-1 or _REOPEN<>1
   _GOOD=0
End If
If _BASE<>0 or _CLOSE2<>-1
   _GOOD=0
End If
Print "M9-R24-HOTSPOT-HIT-01"
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
Print "STATIC ";_STATIC;" OVERLAP ";_ID;" PURE ";_PURE
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD
Print "FILLS ";_F1;" ";_F2;" ";_F3;" SWAP ";_SWAP
Print "LEFT ID ";_LEFT;" COUNT ";_LCNT
Print "RIGHT OUT ";_RIGHT;" COUNT ";_RCNT
Print "CLOSED ";_CLOSED;" PRESS ";_PA
Print "REOPEN ";_REOPEN;" BASE ";_BASE;" CLOSE2 ";_CLOSE2
Print "RESULT ";_GOOD
Print "CLOSE X2 RETURNED"
End
