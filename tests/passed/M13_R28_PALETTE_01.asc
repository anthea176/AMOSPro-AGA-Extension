' M13-R28-PALETTE-01 - Load CMAP, Set/Get RGB, animate pen.
' Needs R28 0.10.0, not R27. Select a standard IFF/ILBM
' palette saved by Personal Paint or Deluxe Paint, OR demo.iff.
' FORM ILBM + CMAP is enough: BMHD and BODY are optional.
' Draw BEFORE palette load; no image pixels may be modified.
' Display GREEN panel then fade toward RED and back to GREEN.
Cls
Print "M13-R28-PALETTE-01"
Print "Choose ANY palette IFF from PPaint / DPaint"
Print "Or examples/demo.iff (no image pixels loaded)"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=320
_H=256
_D=8
_C=256
_MODE=$00021000
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
' Draw a real BitMap BEFORE loading the IFF palette.
' Successful palette load must not replace these bitplane pixels.
_CLR=Aga Blit Clear(0,0,320,256)
_PANEL=Aga Blit Fill(25,70,270,116,28)
_BAR=Aga Blit Fill(25,192,270,14,224)
_TITLE=Aga Text(35,44,28,"M13 R28 PALETTE")
' Only FORM ILBM/CMAP required; NO Aga Pic Info or Iff Load.
_PL=Aga Palette Load(_FILE$)
If _PL<>1
   Aga Screen Close
   Amos To Front
   Print "PALETTE LOAD FAILED"
   End
End If
_PRE=Aga Palette Get(28)
_B0=Aga Palette Set(0,0,0,0)
_B3=Aga Palette Set(3,0,0,128)
_B28=Aga Palette Set(28,0,255,0)
_B224=Aga Palette Set(224,255,0,0)
_G0=Aga Palette Get(28)
_BAD=Aga Palette Set(256,0,0,0)
_BADG=Aga Palette Get(256)
_SWAP=Aga Swap
Amos To Back
_FADEERR=0
' 32 visible forward RGB steps, one per VBL.
For _I=0 To 31
   _R=_I*8
   _G=255-_R
   _STEP=Aga Palette Set(28,_R,_G,0)
   If _STEP<>1
      _FADEERR=_FADEERR+1
   End If
   Aga Wait Vbl
Next _I
_PEAK=Aga Palette Get(28)
' Reverse fade back to the exact green palette entry.
For _I=0 To 31
   _R=(31-_I)*8
   _G=255-_R
   _STEP=Aga Palette Set(28,_R,_G,0)
   If _STEP<>1
      _FADEERR=_FADEERR+1
   End If
   Aga Wait Vbl
Next _I
_FINAL=Aga Palette Get(28)
For _HOLD=1 To 65
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _PL<>1
   _RESULT=0
End If
If _B0<>1 or _B3<>1 or _B28<>1 or _B224<>1
   _RESULT=0
End If
If _G0<>$00FF00 or _BAD<>0 or _BADG<>-1
   _RESULT=0
End If
If _CLR<>1 or _PANEL<>1 or _BAR<>1 or _TITLE<>1 or _SWAP<>1
   _RESULT=0
End If
If _PEAK<>$F80700 or _FINAL<>$00FF00 or _FADEERR<>0
   _RESULT=0
End If
If _CLOSED<>-1
   _RESULT=0
End If
Print "M13-R28-PALETTE-01"
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
Print "OPEN ";_OPEN;" DB ";_DB;" IFF CMAP ";_PL
Print "SET ";_B0;" ";_B3;" ";_B28;" ";_B224
Print "GET BEFORE ";_PRE;" GREEN ";_G0
Print "BAD ";_BAD;" BADG ";_BADG
Print "DRAW ";_CLR;" ";_PANEL;" ";_BAR;" ";_TITLE;" SWAP ";_SWAP
Print "PEAK ";_PEAK;" FINAL ";_FINAL;" FADEERR ";_FADEERR
Print "CLOSED ";_CLOSED;" RESULT ";_RESULT
Print "CLOSE RETURNED"
End
