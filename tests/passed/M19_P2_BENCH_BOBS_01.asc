' M19 P2 BENCH - 4/8/16 SOFTWARE BOBS; R84 LAST_GOOD, NO NATIVE API
' R84 AGAPIC and FICON8 sources built in RAM, screen 320x256x256.
' Timer PAL 50Hz ~20ms/tick. JIT OFF, compare identical WinUAE CPU setup.
' SORT/FILL/COMPOSE timing excludes Swap. DISPLAY timing includes VBL/Swap.
' Results are exploratory wall ticks, NOT isolated CPU cycles or 50fps.
' Banks 11..23 must be FREE; only 11..17,20,21 will be created.
Set Buffer 20
Cls
Print "M19 P2 BENCH 4 / 8 / 16 BOBS"
_RESULT=1 : _ERR=0 : _OPEN=0 : _CLOSED=0
_B11=0 : _B20=0 : _B21=0 : _LASTCAP=11
_CAPOK=0 : _ICONOK=0 : _SORTERR=0 : _FILLERR=0
_DRAWERR=0 : _SWAPERR=0 : _SAFERETRY=0 : _SWAPRETRY=0
_FRAMESOK=0 : _DRAWS=0 : _NEXTID=0
Dim _ALIVE(16),_TYPE(16),_BN1(16),_BN2(16),_IC1(16),_IC2(16)
Dim _FRAME(16),_OX(16),_OY(16),_HX(16),_HY(16),_OZ(16)
Dim _VISIBLE(16),_OMODE(16),_MOTION(16),_ORDER(16)
Dim _TM(3,2,1),_DRAWCASE(2,1),_SWCASE(2,1)
Dim _SAFEC(2,1),_NUM(2)
_NUM(0)=4 : _NUM(1)=8 : _NUM(2)=16
_NSORT=800 : _NFILL=120 : _NCOMP=120 : _NDISP=40
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN"
_LOG$="RAM:M19_P2_BENCH_BOBS_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:M19_P2_BENCH_BOBS_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:M19_P2_BENCH_BOBS_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:M19_P2_BENCH_BOBS_COMPILED.TXT"
End If
_CPU$="UNKNOWN" : _FLAGS=0
_SYS=Leek(4)
If _SYS<>0
   _FLAGS=Deek(_SYS+296)
   _CPU$="68000"
   If (_FLAGS And 1)<>0
      _CPU$="68010"
   End If
   If (_FLAGS And 2)<>0
      _CPU$="68020"
   End If
   If (_FLAGS And 4)<>0
      _CPU$="68030"
   End If
   If (_FLAGS And 8)<>0
      _CPU$="68040"
   End If
   If (_FLAGS And 128)<>0
      _CPU$="68060"
   End If
End If
If Aga Detect=0
   _ERR=1
   Goto CLEANUP
End If
For _BANK=11 To 23
   If Length(_BANK)<>0
      _ERR=2
      Goto CLEANUP
   End If
Next _BANK
Reserve As Data 11,16
_B11=1
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3
   Goto CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4
   Goto CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,22,35,65)
_P3=Aga Palette Set(3,250,65,60)
_P4=Aga Palette Set(4,255,180,35)
_P5=Aga Palette Set(5,30,215,230)
_P6=Aga Palette Set(6,60,255,150)
_P7=Aga Palette Set(7,245,235,60)
_P8=Aga Palette Set(8,215,85,250)
If _P0<>1 or _P1<>1 or _P3<>1 or _P4<>1
   _ERR=5
   Goto CLEANUP
End If
If _P5<>1 or _P6<>1 or _P7<>1 or _P8<>1
   _ERR=6
   Goto CLEANUP
End If
' Build six AGAPIC images (v1/v2, 5 masked, 1 opaque), as P2.0.
For _I=0 To 5
   _BANK=12+_I : _COL=3+_I : _VERS=1 : _TRANS=0
   If (_I Mod 2)=1
      _VERS=2
   End If
   If _BANK=17
      _TRANS=-1
   End If
   _READY=0
   For _TRY=1 To 12
      If _READY=0
         _READY=Aga Blit Fill(8,8,24,24,0)
      End If
      If _READY=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _READY<>1
      _ERR=7
      Goto CLEANUP
   End If
   _P1=Aga Blit Fill(12,12,16,16,_COL)
   _P2=Aga Box(8,8,31,31,_COL)
   If (_I Mod 2)=0
      _P3=Aga Blit Fill(8,18,24,4,_COL)
   Else
      _P3=Aga Blit Fill(18,8,4,24,_COL)
   End If
   If _P1<>1 or _P2<>1 or _P3<>1
      _ERR=8
      Goto CLEANUP
   End If
   _OK=Aga Bank Image Capture(_BANK,8,8,24,24,_TRANS,_VERS)
   If _OK<>1
      _ERR=9
      Goto CLEANUP
   End If
   _LASTCAP=_BANK : _CAPOK=_CAPOK+1
   If Aga Bank Image Info(_BANK,1)<>24 or Aga Bank Image Info(_BANK,2)<>24
      _ERR=10
      Goto CLEANUP
   End If
   If Aga Bank Image Info(_BANK,3)<>8
      _ERR=11
      Goto CLEANUP
   End If
Next _I
_OK=Aga F Icon Bank Create(20,4)
If _OK<>1
   _ERR=12
   Goto CLEANUP
End If
_B20=1
Reserve As Data 21,256
_B21=1
_PIX=Start(21)
For _ICON=1 To 4
   For _Y=0 To 15
      For _X=0 To 15
         _COL=0
         If _X=0 or _Y=0 or _X=15 or _Y=15
            _COL=4+_ICON
         End If
         If _X>=4 and _X<=11 and _Y>=4 and _Y<=11
            _COL=4+_ICON
         End If
         If _X=_Y or _X=15-_Y
            _COL=4+_ICON
         End If
         Poke _PIX+_Y*16+_X,_COL
      Next _X
   Next _Y
   _OK=Aga F Icon Bank Put(20,_ICON,21,0)
   If _OK<>1
      _ERR=13
      Goto CLEANUP
   End If
   _ICONOK=_ICONOK+1
Next _ICON
' Build 16 fixed reusable objects. First 4/8/16 subsets have 50% AGAPIC.
' Each group of four: masked AGAPIC, masked FICON, opaque AGAPIC, masked FICON.
' Source banks are shared between objects; no per-object palette or allocation.
For _BID=1 To 16
   _NEXTID=_BID : _ALIVE(_BID)=1 : _VISIBLE(_BID)=1
   _OX(_BID)=38+((_BID-1) Mod 4)*73
   _OY(_BID)=38+Int((_BID-1)/4)*54
   _OZ(_BID)=17-_BID : _FRAME(_BID)=1
   _OMODE(_BID)=1
   If (_BID Mod 2)=1
      _TYPE(_BID)=1
      If (_BID Mod 4)=1
         _BN1(_BID)=12+(Int((_BID-1)/4) Mod 4)
      Else
         _BN1(_BID)=17
         _OMODE(_BID)=0
      End If
      _BN2(_BID)=_BN1(_BID)
      _HX(_BID)=12 : _HY(_BID)=12
   Else
      _TYPE(_BID)=2
      _BN1(_BID)=20 : _BN2(_BID)=20
      _IC1(_BID)=1+(Int((_BID-2)/2) Mod 4)
      _IC2(_BID)=_IC1(_BID)
      _HX(_BID)=8 : _HY(_BID)=8
   End If
Next _BID
' Warmup before measurements; only Safe back buffer, no Swap.
_ACTIVE=16 : _RUN=0
For _WARM=1 To 8
   Gosub _DRAW_FRAME
   If _ROK<>1
      _ERR=14
      Goto CLEANUP
   End If
Next _WARM
Amos To Back
' Two paired passes, three object counts. No benchmark values are preset.
For _PASS=0 To 1
   For _CASE=0 To 2
      _ACTIVE=_NUM(_CASE)
      _T0=Timer
      For _ITER=1 To _NSORT
         Gosub _SORT_OBJECTS
      Next _ITER
      _TM(0,_CASE,_PASS)=Timer-_T0
      If _COUNT<>_ACTIVE
         _SORTERR=_SORTERR+1 : _ERR=15
         Goto CLEANUP
      End If
      _T0=Timer
      For _ITER=1 To _NFILL
         _READY=0
         For _TRY=1 To 12
            If _READY=0
               _READY=Aga Blit Fill(0,0,320,256,1)
            End If
            If _READY=0
               _SAFERETRY=_SAFERETRY+1
               Aga Wait Vbl
            End If
         Next _TRY
         If _READY<>1
            _FILLERR=_FILLERR+1 : _ERR=16
            Goto CLEANUP
         End If
      Next _ITER
      _TM(1,_CASE,_PASS)=Timer-_T0
      _SAFE0=_SAFERETRY
      _D0=_DRAWS
      _T0=Timer
      For _ITER=1 To _NCOMP
         _RUN=_RUN+1
         Gosub _DRAW_FRAME
         If _ROK<>1
            _DRAWERR=_DRAWERR+1 : _ERR=17
            Goto CLEANUP
         End If
      Next _ITER
      _TM(2,_CASE,_PASS)=Timer-_T0
      _SAFEC(_CASE,_PASS)=_SAFERETRY-_SAFE0
      _DRAWCASE(_CASE,_PASS)=_DRAWS-_D0
      _SW0=_SWAPRETRY
      _T0=Timer
      For _ITER=1 To _NDISP
         Aga Wait Vbl
         _RUN=_RUN+1
         Gosub _DRAW_FRAME
         If _ROK<>1
            _DRAWERR=_DRAWERR+1 : _ERR=18
            Goto CLEANUP
         End If
         _SW=0
         For _TRY=1 To 12
            If _SW=0
               _SW=Aga Swap
            End If
            If _SW=0
               _SWAPRETRY=_SWAPRETRY+1
               Aga Wait Vbl
            End If
         Next _TRY
         If _SW<>1
            _SWAPERR=_SWAPERR+1 : _ERR=19
            Goto CLEANUP
         End If
         _FRAMESOK=_FRAMESOK+1
         _KEY=Aga Key
         If _KEY=69
            _ERR=20
            Goto CLEANUP
         End If
      Next _ITER
      _TM(3,_CASE,_PASS)=Timer-_T0
      _SWCASE(_CASE,_PASS)=_SWAPRETRY-_SW0
      If _DRAWCASE(_CASE,_PASS)<>_NCOMP*_ACTIVE
         _ERR=21
         Goto CLEANUP
      End If
   Next _CASE
Next _PASS
Goto CLEANUP

CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _B21=1 and Length(21)<>0
   Erase 21
End If
If _B20=1 and Length(20)<>0
   Erase 20
End If
If _LASTCAP>=12
   For _BANK=12 To _LASTCAP
      If Length(_BANK)<>0
         Erase _BANK
      End If
   Next _BANK
End If
If _B11=1 and Length(11)<>0
   Erase 11
End If
If _ERR=0 and (_CAPOK<>6 or _ICONOK<>4 or _NEXTID<>16)
   _ERR=22
End If
If _ERR=0 and _FRAMESOK<>_NDISP*6
   _ERR=23
End If
If _ERR=0 and (_DRAWERR<>0 or _SWAPERR<>0 or _SORTERR<>0 or _FILLERR<>0)
   _ERR=24
End If
If _ERR=0 and _CLOSED<>1
   _ERR=25
End If
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Cls
Print "M19 BENCH ";_VERDICT$;" ERR ";_ERR
Print "CPU ";_CPU$;" MODE ";_MODE$
Print "TIMER PAL TICK ~20MS"
Print "PASS0 SORT/FILL/COMP/DISP"
For _CASE=0 To 2
   Print _NUM(_CASE);" ";_TM(0,_CASE,0);" ";_TM(1,_CASE,0);" ";_TM(2,_CASE,0);" ";_TM(3,_CASE,0)
Next _CASE
Print "PASS1 SORT/FILL/COMP/DISP"
For _CASE=0 To 2
   Print _NUM(_CASE);" ";_TM(0,_CASE,1);" ";_TM(1,_CASE,1);" ";_TM(2,_CASE,1);" ";_TM(3,_CASE,1)
Next _CASE
Print "SAFE RETRIES ";_SAFERETRY;" SWAP RETRIES ";_SWAPRETRY
Print "CHIP/FAST DELTA ";_CHIP1-_CHIP0;" ";_FAST1-_FAST0
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P2_BENCH_BOBS_01"
   Print #1,"VERSION R84 V0.13.29 LAST_GOOD"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"CPU ";_CPU$
   Print #1,"CPU_ATTNFLAGS ";_FLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"ERR ";_ERR
   Print #1,"TIMER_TICK_MS 20 PAL NOMINAL"
   Print #1,"SORT_REPS ";_NSORT
   Print #1,"FILL_REPS ";_NFILL
   Print #1,"COMPOSE_REPS ";_NCOMP
   Print #1,"DISPLAY_REPS ";_NDISP
   Print #1,"CAP_OK ";_CAPOK
   Print #1,"ICON_OK ";_ICONOK
   Print #1,"OBJECTS_PREPARED ";_NEXTID
   Print #1,"FRAME_OK ";_FRAMESOK
   Print #1,"DRAW_OK ";_DRAWS
   Print #1,"SORT_FAIL ";_SORTERR
   Print #1,"FILL_FAIL ";_FILLERR
   Print #1,"DRAW_FAIL ";_DRAWERR
   Print #1,"SWAP_FAIL ";_SWAPERR
   Print #1,"SAFE_RETRIES ";_SAFERETRY
   Print #1,"SWAP_RETRIES ";_SWAPRETRY
   Print #1,"N4_P0_SORT_TICKS ";_TM(0,0,0)
   Print #1,"N4_P0_FILL_TICKS ";_TM(1,0,0)
   Print #1,"N4_P0_COMP_TICKS ";_TM(2,0,0)
   Print #1,"N4_P0_DISP_TICKS ";_TM(3,0,0)
   Print #1,"N4_P0_COMP_DRAWS ";_DRAWCASE(0,0)
   Print #1,"N4_P0_COMP_SAFE_RETRIES ";_SAFEC(0,0)
   Print #1,"N4_P0_DISP_SWAP_RETRIES ";_SWCASE(0,0)
   Print #1,"N8_P0_SORT_TICKS ";_TM(0,1,0)
   Print #1,"N8_P0_FILL_TICKS ";_TM(1,1,0)
   Print #1,"N8_P0_COMP_TICKS ";_TM(2,1,0)
   Print #1,"N8_P0_DISP_TICKS ";_TM(3,1,0)
   Print #1,"N8_P0_COMP_DRAWS ";_DRAWCASE(1,0)
   Print #1,"N8_P0_COMP_SAFE_RETRIES ";_SAFEC(1,0)
   Print #1,"N8_P0_DISP_SWAP_RETRIES ";_SWCASE(1,0)
   Print #1,"N16_P0_SORT_TICKS ";_TM(0,2,0)
   Print #1,"N16_P0_FILL_TICKS ";_TM(1,2,0)
   Print #1,"N16_P0_COMP_TICKS ";_TM(2,2,0)
   Print #1,"N16_P0_DISP_TICKS ";_TM(3,2,0)
   Print #1,"N16_P0_COMP_DRAWS ";_DRAWCASE(2,0)
   Print #1,"N16_P0_COMP_SAFE_RETRIES ";_SAFEC(2,0)
   Print #1,"N16_P0_DISP_SWAP_RETRIES ";_SWCASE(2,0)
   Print #1,"N4_P1_SORT_TICKS ";_TM(0,0,1)
   Print #1,"N4_P1_FILL_TICKS ";_TM(1,0,1)
   Print #1,"N4_P1_COMP_TICKS ";_TM(2,0,1)
   Print #1,"N4_P1_DISP_TICKS ";_TM(3,0,1)
   Print #1,"N4_P1_COMP_DRAWS ";_DRAWCASE(0,1)
   Print #1,"N4_P1_COMP_SAFE_RETRIES ";_SAFEC(0,1)
   Print #1,"N4_P1_DISP_SWAP_RETRIES ";_SWCASE(0,1)
   Print #1,"N8_P1_SORT_TICKS ";_TM(0,1,1)
   Print #1,"N8_P1_FILL_TICKS ";_TM(1,1,1)
   Print #1,"N8_P1_COMP_TICKS ";_TM(2,1,1)
   Print #1,"N8_P1_DISP_TICKS ";_TM(3,1,1)
   Print #1,"N8_P1_COMP_DRAWS ";_DRAWCASE(1,1)
   Print #1,"N8_P1_COMP_SAFE_RETRIES ";_SAFEC(1,1)
   Print #1,"N8_P1_DISP_SWAP_RETRIES ";_SWCASE(1,1)
   Print #1,"N16_P1_SORT_TICKS ";_TM(0,2,1)
   Print #1,"N16_P1_FILL_TICKS ";_TM(1,2,1)
   Print #1,"N16_P1_COMP_TICKS ";_TM(2,2,1)
   Print #1,"N16_P1_DISP_TICKS ";_TM(3,2,1)
   Print #1,"N16_P1_COMP_DRAWS ";_DRAWCASE(2,1)
   Print #1,"N16_P1_COMP_SAFE_RETRIES ";_SAFEC(2,1)
   Print #1,"N16_P1_DISP_SWAP_RETRIES ";_SWCASE(2,1)
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"CHIP_DELTA ";_CHIP1-_CHIP0
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"FAST_DELTA ";_FAST1-_FAST0
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
Print "CLOSE RETURNED"
End

' Reuse validated P2.0 ordering: descending Z, stable ID tie.
_SORT_OBJECTS:
_COUNT=0
For _I=1 To _ACTIVE
   If _ALIVE(_I)=1 and _VISIBLE(_I)=1
      _COUNT=_COUNT+1
      _ORDER(_COUNT)=_I
   End If
Next _I
If _COUNT>=2
   For _SI=1 To _COUNT-1
      For _SJ=_SI+1 To _COUNT
         _A=_ORDER(_SI) : _B=_ORDER(_SJ)
         If _OZ(_A)>_OZ(_B) or (_OZ(_A)=_OZ(_B) and _A>_B)
            _ORDER(_SI)=_B : _ORDER(_SJ)=_A
         End If
      Next _SJ
   Next _SI
End If
Return

' Back buffer only, full background and all objects. No implicit Swap.
_DRAW_FRAME:
_ROK=0
_BG=0
For _TRY=1 To 12
   If _BG=0
      _BG=Aga Blit Fill(0,0,320,256,1)
   End If
   If _BG=0
      _SAFERETRY=_SAFERETRY+1
      Aga Wait Vbl
   End If
Next _TRY
If _BG<>1
   Return
End If
Gosub _SORT_OBJECTS
If _COUNT<>_ACTIVE
   Return
End If
For _DRAW=1 To _COUNT
   _ID=_ORDER(_DRAW)
   _PX=_OX(_ID)+((_RUN+_ID) Mod 5)-_HX(_ID)
   _PY=_OY(_ID)+((_RUN+_ID*3) Mod 5)-_HY(_ID)
   _SOURCE=_BN1(_ID) : _ICONID=_IC1(_ID)
   If Length(_SOURCE)=0
      Return
   End If
   If _TYPE(_ID)=1
      _OK=Aga Bank Image Draw(_SOURCE,_PX,_PY,_OMODE(_ID))
   Else
      _OK=Aga F Icon(_SOURCE,_ICONID,_PX,_PY,_OMODE(_ID))
   End If
   If _OK<>1
      Return
   End If
   _DRAWS=_DRAWS+1
Next _DRAW
_ROK=1
Return
