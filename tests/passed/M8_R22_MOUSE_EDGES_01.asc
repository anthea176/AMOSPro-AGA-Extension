' M8 R22 0.8.6 - Native Mouse Pressed / Released + focus-safe polling
' ONE active WinUAE test. Use MYGIRL.IFF 320x256x8.
' First release every button. Hold LEFT ~0.3s and release.
' Then hold RIGHT ~0.3s and release. Repeat LEFT once if desired.
' No Intuition menu bar must appear on RIGHT. Then press any key.
' Quick taps entirely between polls are NOT yet guaranteed.
Cls
Print "M8-R22-MOUSE-EDGES-01"
_BEFOREP=Aga Mouse Pressed
_BEFORER=Aga Mouse Released
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
If _W<>320 or _H<>256 or _D<>8
   Print "USE MYGIRL.IFF 320X256X8"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "LOAD FAILED"
   End
End If
_SWAP=Aga Swap
Amos To Back
_BASEP=Aga Mouse Pressed
_BASER=Aga Mouse Released
_PALL=0
_RALL=0
_PL=0
_PR=0
_RL=0
_RR=0
_ERR=0
_DONE=0
For _I=1 To 1000
   If _DONE=0
      _P=Aga Mouse Pressed
      _R=Aga Mouse Released
      _B=Aga Mouse Buttons
      If _P<0 or _R<0 or _B<0
         _ERR=1
         _DONE=1
      Else
         _PALL=_PALL Or _P
         _RALL=_RALL Or _R
         If (_P And 1)=1
            Add _PL,1
         End If
         If (_P And 2)=2
            Add _PR,1
         End If
         If (_R And 1)=1
            Add _RL,1
         End If
         If (_R And 2)=2
            Add _RR,1
         End If
         If (_PALL And 3)=3
            If (_RALL And 3)=3
               _DONE=1
            End If
         End If
      End If
      Aga Wait Vbl
   End If
Next _I
_KEY=Aga Wait Key
_X=Aga Mouse X
_Y=Aga Mouse Y
Aga Screen Close
Amos To Front
_CLOSEP=Aga Mouse Pressed
_CLOSER=Aga Mouse Released
_REOPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _REOPEN=1
   _REOPENP=Aga Mouse Pressed
   _REOPENR=Aga Mouse Released
   Aga Screen Close
Else
   _REOPENP=-1
   _REOPENR=-1
End If
_CLOSE2=Aga Mouse Pressed
Amos To Front
Print "M8-R22-MOUSE-EDGES-01"
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD;" SWAP ";_SWAP
Print "BEFORE ";_BEFOREP;" ";_BEFORER;" BASE ";_BASEP;" ";_BASER
Print "PRESSED ";_PALL;" RELEASED ";_RALL
Print "COUNTS PL ";_PL;" PR ";_PR;" RL ";_RL;" RR ";_RR
Print "DONE ";_DONE;" ERR ";_ERR;" FRAME ";_I
Print "KEY ";_KEY;" MOUSE ";_X;" ";_Y
Print "CLOSED ";_CLOSEP;" ";_CLOSER;" CLOSE2 ";_CLOSE2
Print "REOPEN ";_REOPEN;" BASE ";_REOPENP;" ";_REOPENR
Print "CLOSE X2 RETURNED"
End
