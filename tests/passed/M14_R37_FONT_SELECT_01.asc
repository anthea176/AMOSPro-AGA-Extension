' M14-R37-FONT-SELECT-01 : Gate B interpretee AMOS sous WinUAE.
' Require candidate R37 0.10.9, 43 AP20 commands (only after Gate A).
' Topaz 8 / Topaz 9 / reset default. No IFF file or font bank.
Cls
Print "M14-R37-FONT-SELECT-01"
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(1,255,255,255)
_P1=Aga Palette Set(2,0,90,160)
_CLR=Aga Blit Clear(0,0,320,256)
_PANEL=Aga Blit Fill(14,25,292,198,2)
_SEL8=Aga Font Select("topaz.font",8)
_TX8=Aga Text(28,72,1,"TOPAZ 8 - AGA MENU")
_SEL9=Aga Font Select("topaz.font",9)
_TX9=Aga Text(28,115,1,"TOPAZ 9 - AGA MENU")
_BAD0=Aga Font Select("topaz.font",0)
_BAD256=Aga Font Select("topaz.font",256)
_BADNAME=Aga Font Select("",8)
_TXKEEP=Aga Text(28,153,1,"STILL TOPAZ 9")
_RESET=Aga Font Select("",0)
_TXDEF=Aga Text(28,190,1,"DEFAULT FONT")
_SWAP=Aga Swap
If _SWAP<>1
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED"
   End
End If
Amos To Back
For _I=1 To 210
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Font Select("topaz.font",8)
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _P0<>1 or _P1<>1
   _RESULT=0
End If
If _CLR<>1 or _PANEL<>1 or _SEL8<>1 or _SEL9<>1
   _RESULT=0
End If
If _TX8<>1 or _TX9<>1 or _TXKEEP<>1 or _TXDEF<>1
   _RESULT=0
End If
If _BAD0<>0 or _BAD256<>0 or _BADNAME<>0
   _RESULT=0
End If
If _RESET<>1 or _SWAP<>1 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Print "M14-R37-FONT-SELECT-01"
Print "OPEN ";_OPEN;" DB ";_DB;" PALETTE ";_P0;" ";_P1
Print "SEL8 ";_SEL8;" TX8 ";_TX8;" SEL9 ";_SEL9;" TX9 ";_TX9
Print "BAD0 ";_BAD0;" BAD256 ";_BAD256;" BADNAME ";_BADNAME
Print "KEEP ";_TXKEEP;" RESET ";_RESET;" DEFAULT ";_TXDEF
Print "SWAP ";_SWAP;" NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
