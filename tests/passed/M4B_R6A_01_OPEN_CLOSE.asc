' M4b R6A - TEST 01: OPEN / CLOSE ONLY
' First run after confirming AMOS365 launches with R6A.
Cls
Print "R6A TEST 01 - OPEN CLOSE"
Print "BEFORE OPEN"
_OK=Aga Screen Open(320,256,256,$00021000)
Amos To Front
Print "OPEN = ";_OK
If _OK<>0
   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "TEST 01 FINISHED"
Wait Key
End
