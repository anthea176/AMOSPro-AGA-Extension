' R6C-R1 TEST 03 - 50 BACK FILL + SWAP CYCLES
Cls
Print "R6C-R1 TEST 03 - 50 FILL+SWAP"
_OK=Aga Screen Open(320,256,256,$00021000)
Amos To Front
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _FAIL=0
      Amos To Back
      For _N=1 To 50
         If (_N Mod 2)=0
            Aga Back Fill 0
         Else
            Aga Back Fill 255
         End If

         _SW=Aga Swap
         If _SW=0
            _FAIL=_FAIL+1
         End If

         For _I=1 To 2
            Aga Wait Vbl
         Next _I

         If (_N Mod 10)=0
            Amos To Front
            Print "CYCLES ";_N;" / FAIL = ";_FAIL
            Amos To Back
         End If
      Next _N

      For _I=1 To 5
         Aga Wait Vbl
      Next _I

      Amos To Front
      Print "TOTAL FAILURES = ";_FAIL
   End If

   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "TEST 03 FINISHED"
Wait Key
End
