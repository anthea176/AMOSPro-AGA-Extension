' M15-R43-CIRCLE-01 : Gate B AMOS interpreted / WinUAE NOT TESTED.
' Install R43 0.11.4 candidate; KEEP R42 LAST_GOOD UNCHANGED.
' One-pixel circles, bounds-safe clipping and eight-way symmetry.
Cls
Print "M15-R43-CIRCLE-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,255,160,32)
_P3=Aga Palette Set(3,128,255,128)
_P4=Aga Palette Set(4,80,160,255)
_P5=Aga Palette Set(5,255,80,160)
_P6=Aga Palette Set(6,255,240,32)
_P7=Aga Palette Set(7,208,128,255)
_P8=Aga Palette Set(8,64,255,240)
_CLR=Aga Blit Clear(0,0,320,256)
_T1=Aga Text(21,19,1,"M15 R43 - AGA CIRCLE")
_T2=Aga Text(28,236,1,"MIDPOINT CLIPPED CIRCLES")
' Nested full circles, including radius 1 and radius zero.
_C0=Aga Circle(160,128,90,2)
_C1=Aga Circle(160,128,64,3)
_C2=Aga Circle(160,128,38,4)
_C3=Aga Circle(160,128,1,5)
_DOT=Aga Circle(160,128,0,1)
' Rings clipped at each screen corner.
_K0=Aga Circle(0,0,42,5)
_K1=Aga Circle(319,0,42,6)
_K2=Aga Circle(0,255,42,7)
_K3=Aga Circle(319,255,42,8)
' Four individual borders and external centres.
_L=Aga Circle(-10,128,35,2)
_R=Aga Circle(330,128,35,3)
_T=Aga Circle(160,-10,35,4)
_B=Aga Circle(160,265,35,5)
' Pen 0 is a valid drawing colour.
_PEN0=Aga Circle(65,75,12,0)
' Entirely invisible rings must return zero.
_O0=Aga Circle(-100,128,35,1)
_O1=Aga Circle(420,128,35,1)
_O2=Aga Circle(160,-100,35,1)
_O3=Aga Circle(160,360,35,1)
' A circle surrounding the whole screen has NO visible contour.
_WRAP=Aga Circle(160,128,500,1)
_BADNEG=Aga Circle(160,128,-1,1)
_BADR=Aga Circle(160,128,32768,1)
_BADX=Aga Circle(32768,128,22,1)
_BADY=Aga Circle(160,-32769,22,1)
_BADP=Aga Circle(160,128,22,256)
_BADQ=Aga Circle(160,128,22,-1)
_SW=Aga Swap
If _SW=1
   Amos To Back
End If
' Wait cooperatively for the newly inactive back buffer to become Safe.
_SAFE=0
For _I=1 To 30
   If _SAFE=0
      _SAFE=Aga Circle(62,135,28,8)
   End If
   Aga Wait Vbl
Next _I
For _I=1 To 135
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Circle(100,100,10,1)
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _CLR<>1 or _T1<>1 or _T2<>1
   _RESULT=0
End If
If _P1<>1 or _P2<>1 or _P3<>1 or _P4<>1
   _RESULT=0
End If
If _P5<>1 or _P6<>1 or _P7<>1 or _P8<>1
   _RESULT=0
End If
If _C0<>1 or _C1<>1 or _C2<>1 or _C3<>1 or _DOT<>1
   _RESULT=0
End If
If _K0<>1 or _K1<>1 or _K2<>1 or _K3<>1
   _RESULT=0
End If
If _L<>1 or _R<>1 or _T<>1 or _B<>1 or _PEN0<>1
   _RESULT=0
End If
If _O0<>0 or _O1<>0 or _O2<>0 or _O3<>0 or _WRAP<>0
   _RESULT=0
End If
If _BADNEG<>0 or _BADR<>0 or _BADX<>0 or _BADY<>0
   _RESULT=0
End If
If _BADP<>0 or _BADQ<>0
   _RESULT=0
End If
If _SW<>1 or _SAFE<>1 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "M15-R43-CIRCLE-01"
Print "OPEN ";_OPEN;" DB ";_DB;" CLEAR ";_CLR
Print "CIRCLES ";_C0;" ";_C1;" ";_C2;" ";_C3;" DOT ";_DOT
Print "CORNERS ";_K0;" ";_K1;" ";_K2;" ";_K3
Print "CLIPPED ";_L;" ";_R;" ";_T;" ";_B
Print "PEN0 ";_PEN0;" OUTSIDE ";_O0;" ";_O1;" ";_O2;" ";_O3
Print "WRAP ";_WRAP;" BADR ";_BADNEG;" ";_BADR
Print "BADXY ";_BADX;" ";_BADY;" BADPEN ";_BADP;" ";_BADQ
Print "SWAP ";_SW;" BACKSAFE ";_SAFE
Print "NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
