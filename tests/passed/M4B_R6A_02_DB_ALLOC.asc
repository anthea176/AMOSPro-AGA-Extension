' M4b R6A - TEST 02: DOUBLE BUFFER ALLOCATION / CLEANUP
' Run only after TEST 01 succeeds.
Cls
Print "R6A TEST 02 - DB ALLOC"
_OK=Aga Screen Open(320,256,256,$00021000)
Amos To Front
Print "OPEN = ";_OK
If _OK<>0
   Print "BEFORE DOUBLE BUFFER"
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "TEST 02 FINISHED"
Wait Key
End
