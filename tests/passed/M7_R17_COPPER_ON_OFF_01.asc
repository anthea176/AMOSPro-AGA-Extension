' M7 R17 0.8.1 - Copper On / Off lifecycle without raster
' Requires R17 Lib from dist/AMOSPro_AGA.Lib; R16 has no On/Off.
' Choose MYGIRL.IFF (320x256x8); original image must stay intact.
' Validate repeated Off, re-initialization and two CloseScreen cycles.

Cls
Print "M7-R17-COPPER-ON-OFF-01"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
If _W<>320 or _H<>256 or _D<>8
   Print "USE MYGIRL.IFF 320X256X8"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If

_C1=Aga Copper Clear
_ON1=Aga Copper On
_SWAP=Aga Swap
If _C1<>1 or _ON1<>1 or _SWAP<>1
   Aga Screen Close
   Amos To Front
   Print "FIRST COPPER ON FAILED"
   Print _C1;_ON1;_SWAP
   End
End If
Amos To Back
_KEY=Aga Wait Key
_OFF1=Aga Copper Off
_OFF2=Aga Copper Off
_C2=Aga Copper Clear
_ON2=Aga Copper On
_OFF3=Aga Copper Off
Aga Screen Close
Amos To Front

_OPEN2=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN2=0
   Print "REOPEN FAILED"
   End
End If
_C3=Aga Copper Clear
_ON3=Aga Copper On
_OFF4=Aga Copper Off
Aga Screen Close
Amos To Front

Print "M7-R17-COPPER-ON-OFF-01"
Print "C1 ";_C1;" ON1 ";_ON1;" SWAP ";_SWAP
Print "OFF1 ";_OFF1;" OFF2 ";_OFF2
Print "C2 ";_C2;" ON2 ";_ON2;" OFF3 ";_OFF3
Print "REOPEN ";_OPEN2;" C3 ";_C3
Print "ON3 ";_ON3;" OFF4 ";_OFF4
Print "KEY ";_KEY;" CLOSE X2 RETURNED"
End
