' M3b 0.0.4 - FIRST TEST ON A1200 AGA / AMOS 365
' Must use the NEW experimental AMOSPro_AGA.Lib in APSystem.
' 320 x 256, 256 indexed RGB24 palette entries.
' Run interpreted first; compile only if the first test succeeds.
Aga Probe
Print "AGA DETECT = ";Aga Detect
If Aga Detect<>0
   _OPEN=Aga Screen Open(320,256,256,$00021000)
   Print "M3B OPEN = ";_OPEN
   If _OPEN<>0
      Amos To Back
      Aga Screen Pattern
      Wait 150
      Amos To Front
      Aga Screen Close
      Print "M3B CLOSED - BACK IN AMOS"
   Else
      Print "OPEN FAILED (NO SCREEN DISPLAYED)"
   End If
Else
   Print "AGA NOT DETECTED"
End If
Wait Key
End
