' M5 R1D3 - EXACT IFF OPEN DIAGNOSTIC
Cls
Print "M5-R1D3 - RAM:CLOWN.IFF"
_D=Aga Iff Load("RAM:Clown.iff")
Print "DIAG CODE = ";_D
Print
Print "10 ENTERED / EMPTY"
Print "11 NAME BUFFER"
Print "12 DOS.LIBRARY FAIL"
Print "13 DOS OPEN FAIL"
Print "14 HEADER ALLOC/READ FAIL"
Print "15 HEADER READ OK / FORM FAIL"
Print "16 FORM OK / ILBM FAIL"
Print "17 FORM ILBM OK"
Wait Key
End
