' M8 R21 0.8.5 - RMBTRAP window flag + button snapshot/edges
' R21 ONLY. Choose MYGIRL.IFF 320x256x8.
' When image appears: release mouse buttons, press/hold LEFT then
' release, press/hold RIGHT then release, then press a keyboard key.
' Hold each button ~0.3s: snapshots can miss very fast clicks.
' IMPORTANT: while holding RIGHT, visually check that NO Intuition menu
' bar appears. _PRESSED / _RELEASED are calculated from samples.

Cls
Print "M8-R21-MOUSE-RMBTRAP-01"
_BEFORE=Aga Mouse Buttons

_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
If _W<>320 or _H<>256 or _D<>8
   Print "USE MYGIRL.IFF 320X256X8"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "LOAD FAILED"
   End
End If
_SWAP=Aga Swap

Amos To Back
_PREV=Aga Mouse Buttons
_PRESSED=0
_RELEASED=0
_SEEN=0
_IOERR=0
_DONE=0
For _I=1 To 1000
   If _DONE=0
      _NOW=Aga Mouse Buttons
      If _NOW<0
         _IOERR=1
         _DONE=1
      Else
         _SEEN=_SEEN Or _NOW
         _PRESSED=_PRESSED Or (_NOW And (7-_PREV))
         _RELEASED=_RELEASED Or (_PREV And (7-_NOW))
         _PREV=_NOW
         If (_PRESSED And 3)=3
            If (_RELEASED And 3)=3
               _DONE=1
            End If
         End If
      End If
      Aga Wait Vbl
   End If
Next _I
_K=Aga Wait Key
_X=Aga Mouse X
_Y=Aga Mouse Y
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse Buttons
_REOPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _REOPEN=1
   _REBTN=Aga Mouse Buttons
   Aga Screen Close
Else
   _REBTN=-1
End If
_CLOSED2=Aga Mouse Buttons
Amos To Front

Print "M8-R21-MOUSE-RMBTRAP-01"
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD;" SWAP ";_SWAP
Print "BEFORE ";_BEFORE;" CLOSED ";_CLOSED;" CLOSED2 ";_CLOSED2
Print "PRESSED ";_PRESSED;" RELEASED ";_RELEASED;" SEEN ";_SEEN
Print "DONE ";_DONE;" IOERR ";_IOERR;" FRAME ";_I
Print "KEY ";_K;" MOUSE X/Y ";_X;" ";_Y
Print "REOPEN ";_REOPEN;" BUTTONS ";_REBTN
Print "CLOSE X2 RETURNED"
End
