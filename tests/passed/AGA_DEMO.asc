' AMOS Professional 365 AGA extension M3a / v0.0.3
' A1200, 68020+, AGA, Kickstart 3.x
' Aga Demo affiche un ecran 320x256 256 couleurs pendant ~3 s
' puis revient automatiquement a AMOS.
Aga Probe
Print "AGA M3a - test ecran 256 couleurs"
Print "AGA Detect = ";Aga Detect
If Aga Detect<>0
   Print "Ouverture ecran AGA..."
   _RESULT=Aga Demo
   Print "Retour ecran AGA = ";_RESULT
Else
   Print "Pas d'AGA : test saute"
End If
Print "Appuyez sur une touche pour terminer"
Wait Key
End
