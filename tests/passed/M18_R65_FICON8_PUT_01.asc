' M18 R65 FICON8 BANK PUT -- WINUAE INTERPRETED ONLY.
' Banks 12 AND 13 MUST be free. Built-in Reserve overwrites bank 13.
' Save writes RAM:M18_R65_FICON8.ABK and may overwrite a RAM: file.
' DO NOT compile manually until the very end of M18.
Cls
Print "M18-R65-FICON8-PUT-01"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_CF0=Chip Free : _FF0=Fast Free
_C1=Aga F Icon Bank Create(12,4)
If _C1<>1
   Print "FICON8 CREATE FAILED / BANK 12 OCCUPIED"
   End
End If
Reserve As Data 13,256
_SRC_LEN=Length(13)
For _Y=0 To 15
   For _X=0 To 15
      _COL=0
      If _X=_Y
         _COL=4
      End If
      If _X=15-_Y
         _COL=5
      End If
      If _X=0 Or _X=15 Or _Y=0 Or _Y=15
         _COL=255
      End If
      Poke Start(13)+_Y*16+_X,_COL
   Next _X
Next _Y
_C2=Aga F Icon Bank Create(12,4)
_P1=Aga F Icon Bank Put(12,1,13,0)
_P2=Aga F Icon Bank Put(12,2,13,0)
_SZ=Length(12)
_CT=Deek(Start(12)+4)
_M0=Deek(Start(12)+12)
_B0=Deek(Start(12)+14)
_M1=Deek(Start(12)+12+18)
_B1=Deek(Start(12)+12+18+2)
_ME=Deek(Start(12)+12+2*288)
_BE=Deek(Start(12)+12+2*288+2)
_SR0=Peek(Start(13))
_SR4=Peek(Start(13)+17)
_SR5=Peek(Start(13)+30)
_BADID=Aga F Icon Bank Put(12,5,13,0)
_BAD0=Aga F Icon Bank Put(12,0,13,0)
_BADOFF=Aga F Icon Bank Put(12,1,13,1)
_ALIAS=Aga F Icon Bank Put(12,1,12,0)
_BADBANK=Aga F Icon Bank Put(12,1,4,0)
_MCHECK=Deek(Start(12)+12+18)
Erase 13
Erase 12
_CF1=Chip Free : _FF1=Fast Free
_C3=Aga F Icon Bank Create(12,4)
If _C3<>1
   Print "SECOND CREATE FAILED"
   End
End If
Reserve As Data 13,256
For _Y=0 To 15
   For _X=0 To 15
      _COL=0
      If _X=_Y
         _COL=4
      End If
      If _X=15-_Y
         _COL=5
      End If
      If _X=0 Or _X=15 Or _Y=0 Or _Y=15
         _COL=255
      End If
      Poke Start(13)+_Y*16+_X,_COL
   Next _X
Next _Y
_P3=Aga F Icon Bank Put(12,1,13,0)
_P4=Aga F Icon Bank Put(12,2,13,0)
Erase 13
Save "RAM:M18_R65_FICON8.ABK",12
Erase 12
Load "RAM:M18_R65_FICON8.ABK",12
_LOAD=Length(12)
_LCT=Deek(Start(12)+4)
_LM0=Deek(Start(12)+12)
_LM1=Deek(Start(12)+12+18)
_LB0=Deek(Start(12)+14)
_LME=Deek(Start(12)+12+2*288)
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   Erase 12
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 12
   End
End If
_K0=Aga Palette Set(0,0,0,0)
_K2=Aga Palette Set(2,32,48,96)
_K4=Aga Palette Set(4,255,0,0)
_K5=Aga Palette Set(5,0,255,0)
_K255=Aga Palette Set(255,255,255,255)
_SW0=0
For _TRY=1 To 20
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
_BG=0 : _TRANS=0 : _OPAQUE=0 : _EMPTY=0 : _BADICON=0
If _READY=1
   _BG=Aga Blit Fill(0,0,320,256,2)
   _TRANS=Aga F Icon(12,1,30,60,1)
   _OPAQUE=Aga F Icon(12,2,90,60,0)
   _EMPTY=Aga F Icon(12,3,150,60,1)
   _BADICON=Aga F Icon(12,5,210,60,0)
End If
_SW1=0
For _TRY=1 To 20
   If _SW1=0
      _SW1=Aga Swap
   End If
   If _SW1=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW1=1
   Amos To Back
End If
' VISUAL: Blue background; icon x30 transparent, x90 opaque black interior.
' BOTH icons have a WHITE frame and RED/GREEN diagonals.
For _HOLD=1 To 125
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOS=Aga F Icon(12,1,30,60,0)
Erase 12
_CFEND=Chip Free : _FFEND=Fast Free
_RESULT=1
If _C1<>1 or _C2<>0 or _C3<>1 or _SRC_LEN<>256
   _RESULT=0
End If
If _P1<>1 or _P2<>1 or _P3<>1 or _P4<>1
   _RESULT=0
End If
If _SZ<>1164 or _CT<>4 or _LOAD<>1164 or _LCT<>4
   _RESULT=0
End If
If _M0<>0 or _B0<>65535 or _M1<>16380 or _B1<>32771
   _RESULT=0
End If
If _ME<>65535 and _ME<>-1
   _RESULT=0
End If
If _BE<>0 or _SR0<>255 or _SR4<>4 or _SR5<>5
   _RESULT=0
End If
If _BADID<>0 or _BAD0<>0 or _BADOFF<>0 or _ALIAS<>0 or _BADBANK<>0
   _RESULT=0
End If
If _MCHECK<>16380 or _LM0<>0 or _LM1<>16380 or _LB0<>65535
   _RESULT=0
End If
If _LME<>65535 and _LME<>-1
   _RESULT=0
End If
If _CF0<>_CF1 or _FF0<>_FF1
   _RESULT=0
End If
If _OPEN<>1 or _DB<>1 or _SW0<>1 or _SW1<>1 or _READY<>1 or _BG<>1
   _RESULT=0
End If
If _K0<>1 or _K2<>1 or _K4<>1 or _K5<>1 or _K255<>1
   _RESULT=0
End If
If _TRANS<>1 or _OPAQUE<>1 or _EMPTY<>1 or _BADICON<>0
   _RESULT=0
End If
If _NOS<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "M18-R65-FICON8-PUT-01"
Print "CREATE ";_C1;" ";_C3;" DUP ";_C2;" SRC LEN ";_SRC_LEN
Print "PUT 1/2/3/4 ";_P1;" ";_P2;" ";_P3;" ";_P4
Print "SIZE/COUNT ";_SZ;" ";_CT;" LOAD ";_LOAD;" ";_LCT
Print "MASK FIRST/ROW1 ";_M0;" ";_M1;" P0 ";_B0;" ";_B1
Print "EMPTY MASK/PLANE ";_ME;" ";_BE
Print "SOURCE 0/17/30 ";_SR0;" ";_SR4;" ";_SR5
Print "BAD ID0/5/OFF/ALIAS/BANK ";_BAD0;" ";_BADID;" ";_BADOFF;" ";_ALIAS;" ";_BADBANK
Print "CHIP BEFORE/ERASE ";_CF0;" ";_CF1
Print "FAST BEFORE/ERASE ";_FF0;" ";_FF1
Print "OPEN/DB/SHOW ";_OPEN;" ";_DB;" ";_SW1
Print "TRANSPARENT/OPAQUE/EMPTY ";_TRANS;" ";_OPAQUE;" ";_EMPTY
Print "NOS/CLOSE ";_NOS;" ";_CLOSED
Print "CHIP/FAST AFTER RAM FILE ";_CFEND;" ";_FFEND
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
