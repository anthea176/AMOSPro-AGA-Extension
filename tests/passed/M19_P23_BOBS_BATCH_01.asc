' M19 P2.3 R86 BOBS native batch — only active ASC.
' Self-contained: creates AGAPIC v1/v2 sources by capture and FICON8 by Bank Put.
' Descriptor DATA bank (bank 20): 16-byte header, then 20 bytes per Bob.
' Run unchanged in Runtime then Compiler. R84 LAST_GOOD MUST NOT be installed.
Set Buffer 20
Cls
_RESULT=1 : _ERR=0 : _OPEN=0 : _CLOSED=0 : _CNT=0
_CAP=0 : _DRAW=0 : _CLIP=0 : _MASK=0 : _ORDER=0
_REJECT=0 : _SAFE=0 : _FRAMES=0 : _SWAPS=0
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_P23_UNKNOWN.TXT"
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_P23_RUNTIME.TXT"
End If
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_P23_INTERPRETED.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_P23_COMPILED.TXT"
End If
Print "M19 P2.3 NATIVE BOBS R86"
If Aga Detect=0
   _ERR=1 : Goto CLEANUP
End If
If Aga Bob Probe<>1
   _ERR=2 : Goto CLEANUP
End If
For _B=10 To 22
   If Length(_B)<>0
      _ERR=3 : Goto CLEANUP
   End If
Next _B
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto CLEANUP
End If
If Aga Double Buffer<>1
   _ERR=5 : Goto CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,24,32,48)
_P3=Aga Palette Set(3,240,65,45)
_P4=Aga Palette Set(4,35,205,230)
_P5=Aga Palette Set(5,250,215,70)
If _P0<>1 or _P1<>1 or _P3<>1 or _P4<>1 or _P5<>1
   _ERR=6 : Goto CLEANUP
End If
' Generate 2 AGAPIC frames with opaque/transparent source index 0.
For _I=0 To 1
   _B=12+_I : _V=1+_I
   _D=Aga Blit Fill(0,0,320,256,0)
   If _D<>1
      _ERR=7 : Goto CLEANUP
   End If
   _D=Aga Blit Fill(8,8,24,24,3+_I)
   If _D<>1
      _ERR=8 : Goto CLEANUP
   End If
   _D=Aga Bank Image Capture(_B,0,0,40,40,0,_V)
   If _D<>1
      _ERR=9 : Goto CLEANUP
   End If
   _CAP=_CAP+1
Next _I
' Generate FICON8 bank with 4 slots. Chunky source is a DATA bank.
Reserve As Data 10,256
' The FICON8 native creation command establishes the canonical bank.
_OK=Aga F Icon Bank Create(11,4)
If _OK<>1
   _ERR=10 : Goto CLEANUP
End If
For _Y=0 To 15
   For _X=0 To 15
      _PIX=5
      If _X=0 or _Y=0 or _X=15 or _Y=15
         _PIX=0
      End If
      Poke Start(10)+_Y*16+_X,_PIX
   Next _X
Next _Y
_OK=Aga F Icon Bank Put(11,2,10,0)
If _OK<>1
   _ERR=11 : Goto CLEANUP
End If
' Construct the descriptor bank. Coordinates and ordering are explicit.
' BOB1 header: signature, version WORD, stride WORD, count LONG, reserved LONG.
' Record: Y LONG, X LONG, source Bank LONG, IconID LONG, Kind WORD, Mode WORD.
Reserve As Data 20,76
_P=Start(20)
Loke _P,$424F4231 : Doke _P+4,1 : Doke _P+6,20
Loke _P+8,3 : Loke _P+12,0
' Z/back-to-front order: AGAPIC v1, FICON, AGAPIC v2.
Loke _P+16,100 : Loke _P+20,100 : Loke _P+24,12
Loke _P+28,0 : Doke _P+32,1 : Doke _P+34,1
Loke _P+36,105 : Loke _P+40,105 : Loke _P+44,11
Loke _P+48,2 : Doke _P+52,2 : Doke _P+54,1
Loke _P+56,108 : Loke _P+60,108 : Loke _P+64,13
Loke _P+68,0 : Doke _P+72,1 : Doke _P+74,1
' Refusal tests before drawing: bad count, absent bank, bad Kind.
If Aga Bob Batch(20,0)<>0
   _ERR=12 : Goto CLEANUP
End If
_REJECT=_REJECT+1
If Aga Bob Batch(21,3)<>0
   _ERR=13 : Goto CLEANUP
End If
_REJECT=_REJECT+1
Doke _P+52,3
If Aga Bob Batch(20,3)<>0
   _ERR=14 : Goto CLEANUP
End If
_REJECT=_REJECT+1
Doke _P+52,2
' Execute without implicit swap: use fill, batch, then capture a pixel probe.
_D=Aga Blit Fill(0,0,320,256,1)
If _D<>1
   _ERR=15 : Goto CLEANUP
End If
_OK=Aga Bob Batch(20,3)
If _OK<>1
   _ERR=16 : Goto CLEANUP
End If
_DRAW=_DRAW+1
' Last AGAPIC should be on top. Capture one pixel at overlap.
_OK=Aga Bank Image Capture(18,110,110,1,1,-1,1)
If _OK<>1
   _ERR=17 : Goto CLEANUP
End If
_ORDER=1
' Signed coordinate clipping: shift second FICON to upper-left edge.
Loke _P+36,-8 : Loke _P+40,-8
_D=Aga Blit Fill(0,0,320,256,1)
If _D<>1
   _ERR=18 : Goto CLEANUP
End If
_OK=Aga Bob Batch(20,3)
If _OK<>1
   _ERR=19 : Goto CLEANUP
End If
_CLIP=1 : _DRAW=_DRAW+1
' Mask/opaque mode: same batch with source transparent index zero.
Doke _P+34,0 : Doke _P+54,0
_OK=Aga Bob Batch(20,3)
If _OK<>1
   _ERR=20 : Goto CLEANUP
End If
_MASK=1 : _DRAW=_DRAW+1
' Back-buffer composition only; presentation is the application's decision.
_OK=Aga Swap
If _OK<>1
   _ERR=21 : Goto CLEANUP
End If
_SWAPS=1
' Lightweight timing comparison: same prepared sources, no Z sort benchmark.
_T0=Timer
For _N=1 To 4
   _D=Aga Blit Fill(0,0,320,256,1)
   If _D<>1
      _ERR=22 : Goto CLEANUP
   End If
   _D=Aga Bank Image Draw(12,100,100,1)
   _E=Aga F Icon(11,2,105,105,1)
   _F=Aga Bank Image Draw(13,108,108,1)
   If _D<>1 or _E<>1 or _F<>1
      _ERR=23 : Goto CLEANUP
   End If
Next _N
_TBASIC=Timer-_T0
Loke _P+36,105 : Loke _P+40,105
Doke _P+34,1 : Doke _P+54,1
_T0=Timer
For _N=1 To 4
   _D=Aga Blit Fill(0,0,320,256,1)
   If _D<>1
      _ERR=24 : Goto CLEANUP
   End If
   _D=Aga Bob Batch(20,3)
   If _D<>1
      _ERR=25 : Goto CLEANUP
   End If
Next _N
_TBATCH=Timer-_T0
_FRAMES=4
Goto CLEANUP

CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _ERR<>3
   For _B=10 To 22
      If Length(_B)<>0
         Erase _B
      End If
   Next _B
End If
If _ERR=0 and (_CAP<>2 or _DRAW<>3 or _REJECT<>3)
   _ERR=26
End If
If _ERR=0 and (_SWAPS<>1 or _CLOSED<>1)
   _ERR=27
End If
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "M19 P2.3 ";_VERDICT$;" ERR ";_ERR
Print "FRAMES ";_FRAMES;" BATCH ";_TBATCH;" BASIC ";_TBASIC
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P23_BOBS_BATCH_01"
   Print #1,"LIBRARY R86_V0.13.31"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"CAPTURE ";_CAP
   Print #1,"DRAW ";_DRAW
   Print #1,"CLIP ";_CLIP
   Print #1,"MASK ";_MASK
   Print #1,"ORDER ";_ORDER
   Print #1,"REJECT ";_REJECT
   Print #1,"FRAMES ";_FRAMES
   Print #1,"SWAPS ";_SWAPS
   Print #1,"BASIC_TICKS ";_TBASIC
   Print #1,"BATCH_TICKS ";_TBATCH
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
