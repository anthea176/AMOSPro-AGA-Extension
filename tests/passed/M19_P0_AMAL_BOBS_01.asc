' M19 P0 - TWO AMAL MEMORY CHANNELS + TWO SOFTWARE BOBS ON PRIVATE AGA
' PROTOTYPE ONLY: R84 LAST_GOOD unchanged. Manual AMAL: no interrupt drawing.
' M19 P0 visual fix: image A stays stable (no 50/60Hz color flicker).
' Requires banks 11,12,13 FREE. No external asset or c2p.library.
' Import using Project -> Merge ASCII. Visual animation approximately 240 frames.
Cls
Print "M19 P0 AMAL MEMORY + AGA BOBS"
_RESULT=1 : _ERR=0
_OPEN=0 : _AMAL=0 : _BANK11=0 : _BANK12=0 : _BANK13=0
_CLOSED=0 : _COUNT=0 : _MOVE1=0 : _MOVE2=0
_DRAWFAIL=0 : _SWAPFAIL=0 : _FRAMEOK=0
_LASTX=-1 : _LASTY=-1 : _P11=0 : _P13=0
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State
_MODE$="UNKNOWN"
_LOGFILE$="RAM:M19_P0_AMAL_BOBS_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOGFILE$="RAM:M19_P0_AMAL_BOBS_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOGFILE$="RAM:M19_P0_AMAL_BOBS_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOGFILE$="RAM:M19_P0_AMAL_BOBS_COMPILED.TXT"
End If
_CPU$="UNKNOWN" : _FLAGS=0
_SYSBASE=Leek(4)
If _SYSBASE<>0
   _FLAGS=Deek(_SYSBASE+296)
   _CPU$="68000"
   If (_FLAGS And 1)<>0
      _CPU$="68010"
   End If
   If (_FLAGS And 2)<>0
      _CPU$="68020"
   End If
   If (_FLAGS And 4)<>0
      _CPU$="68030"
   End If
   If (_FLAGS And 8)<>0
      _CPU$="68040"
   End If
   If (_FLAGS And 128)<>0
      _CPU$="68060"
   End If
End If
If Aga Detect=0
   _ERR=1
   Goto CLEANUP
End If
' Never dereference Start() before the relevant bank was created.
If Length(11)<>0 or Length(12)<>0 or Length(13)<>0
   _ERR=2
   Goto CLEANUP
End If
Reserve As Data 11,16
_BANK11=1
_P11=Start(11)
For _I=0 To 15
   Poke _P11+_I,0
Next _I
' Create FICON8 source bank: 4 x 16x16 / 8 planes.
_C=Aga F Icon Bank Create(12,4)
If _C<>1
   _ERR=3
   Goto CLEANUP
End If
_BANK12=1
Reserve As Data 13,256
_BANK13=1
_P13=Start(13)
For _SLOT=1 To 4
   For _Y=0 To 15
      For _X=0 To 15
         _COL=0
         If _X=0 or _Y=0 or _X=15 or _Y=15
            _COL=_SLOT+2
         End If
         If _X=_Y or _X=15-_Y
            _COL=_SLOT+2
         End If
         If _X>=5 and _X<=10 and _Y>=5 and _Y<=10
            _COL=_SLOT+2
         End If
         Poke _P13+_Y*16+_X,_COL
      Next _X
   Next _Y
   _PUT=Aga F Icon Bank Put(12,_SLOT,13,0)
   If _PUT<>1
      _ERR=4
      Goto CLEANUP
   End If
Next _SLOT
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=5
   Goto CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=6
   Goto CLEANUP
End If
_PAL=Aga Palette Set(0,0,0,0)
_PAL2=Aga Palette Set(1,12,20,45)
_PAL3=Aga Palette Set(3,255,95,70)
_PAL4=Aga Palette Set(4,255,195,80)
_PAL5=Aga Palette Set(5,65,220,255)
_PAL6=Aga Palette Set(6,195,95,255)
If _PAL<>1 or _PAL2<>1 or _PAL3<>1
   _ERR=7
   Goto CLEANUP
End If
If _PAL4<>1 or _PAL5<>1 or _PAL6<>1
   _ERR=8
   Goto CLEANUP
End If
' Memory layout for each AMAL channel: WORD flags, X, Y, image A.
Doke _P11,0
Doke _P11+2,40
Doke _P11+4,70
Doke _P11+6,1
Doke _P11+8,0
Doke _P11+10,175
Doke _P11+12,40
Doke _P11+14,3
' CRITICAL: manual synchronization must be selected BEFORE AMAL declaration.
Synchro Off
_A0$="Let X=40; Let Y=70; Let A=1; L: Let X=X+1; Pause; If X<270 Jump L; Let X=40; Jump L"
_A1$="Let X=175; Let Y=40; Let A=3; L: Let Y=Y+1; Pause; If Y<205 Jump L; Let Y=40; Jump L"
Amal 0,_A0$ To _P11
Amal 1,_A1$ To _P11+8
Amal On
_AMAL=1
Amos To Back
For _FRAME=1 To 240
   ' Cadence only: Wait Vbl is NOT a Safe notification.
   Aga Wait Vbl
   Synchro
   _X0=Deek(_P11+2)
   _Y0=Deek(_P11+4)
   _A0=Deek(_P11+6)
   _X1=Deek(_P11+10)
   _Y1=Deek(_P11+12)
   _A1=Deek(_P11+14)
   If _A0<1 or _A0>2 or _A1<3 or _A1>4
      _ERR=9
      Goto CLEANUP
   End If
   If _X0<0 or _X0>304 or _X1<0 or _X1>304
      _ERR=10
      Goto CLEANUP
   End If
   If _Y0<0 or _Y0>240 or _Y1<0 or _Y1>240
      _ERR=11
      Goto CLEANUP
   End If
   If _LASTX>=0 and _X0<>_LASTX
      _MOVE1=_MOVE1+1
   End If
   If _LASTY>=0 and _Y1<>_LASTY
      _MOVE2=_MOVE2+1
   End If
   _LASTX=_X0 : _LASTY=_Y1
   ' First draw always checks Safe, with bounded retry only.
   _BG=0
   For _TRY=1 To 12
      If _BG=0
         _BG=Aga Blit Fill(0,0,320,256,1)
      End If
      If _BG=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _BG<>1
      _DRAWFAIL=_DRAWFAIL+1
      _ERR=12
      Goto CLEANUP
   End If
   _BOB0=Aga F Icon(12,_A0,_X0,_Y0,1)
   _BOB1=Aga F Icon(12,_A1,_X1,_Y1,1)
   If _BOB0<>1 or _BOB1<>1
      _DRAWFAIL=_DRAWFAIL+1
      _ERR=13
      Goto CLEANUP
   End If
   _SW=0
   For _TRY=1 To 12
      If _SW=0
         _SW=Aga Swap
      End If
      If _SW=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _SW<>1
      _SWAPFAIL=_SWAPFAIL+1
      _ERR=14
      Goto CLEANUP
   End If
   _FRAMEOK=_FRAMEOK+1
   _K=Aga Key
   If _K=69
      Goto CLEANUP
   End If
Next _FRAME
Goto CLEANUP

CLEANUP:
' No bank may be erased while AMAL can still write into it.
If _AMAL=1
   Amal Off
End If
Synchro On
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _BANK13=1 and Length(13)<>0
   Erase 13
End If
If _BANK12=1 and Length(12)<>0
   Erase 12
End If
If _BANK11=1 and Length(11)<>0
   Erase 11
End If
If _ERR=0 and _FRAMEOK<25
   _ERR=15
End If
If _ERR=0 and (_MOVE1=0 or _MOVE2=0)
   _ERR=16
End If
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Cls
Print "M19 P0 AMAL + TWO SOFTWARE BOBS"
Print "RUN ";_MODE$;" CPU ";_CPU$
Print "FRAMES ";_FRAMEOK;" MOVE ";_MOVE1;" ";_MOVE2
Print "DRAW/SWAP FAIL ";_DRAWFAIL;" ";_SWAPFAIL
Print "CLOSED ";_CLOSED;" ERR ";_ERR
Print "CHIP/FAST DELTA ";_CHIP1-_CHIP0;" ";_FAST1-_FAST0
Print "RESULT ";_RESULT;" ";_VERDICT$
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOGFILE$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P0_AMAL_BOBS_01"
   Print #1,"VERSION R84 V0.13.29 LAST_GOOD"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"CPU ";_CPU$
   Print #1,"CPU_ATTNFLAGS ";_FLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"ERR ";_ERR
   Print #1,"FRAME_OK ";_FRAMEOK
   Print #1,"MOVE_X0 ";_MOVE1
   Print #1,"MOVE_Y1 ";_MOVE2
   Print #1,"DRAW_FAIL ";_DRAWFAIL
   Print #1,"SWAP_FAIL ";_SWAPFAIL
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"CHIP_DELTA ";_CHIP1-_CHIP0
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"FAST_DELTA ";_FAST1-_FAST0
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOGFILE$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
Print "CLOSE RETURNED"
End
