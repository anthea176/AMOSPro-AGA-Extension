' M7 R18 0.8.2 - FIRST VISIBLE COPPER RASTER
' Use R18 candidate library. Select MYGIRL.IFF, 320x256x8.
' Expect red/green/blue horizontal bands in color index 0.
' Screenshot raster, then press key for cleanup/reopen output.

Cls
Print "M7-R18-COPPER-RASTER-01"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
If _W<>320 or _H<>256 or _D<>8
   Print "USE MYGIRL.IFF 320X256X8"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN=0
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "IFF FAILED"
   End
End If

_C1=Aga Copper Clear
_W1=Aga Copper Wait(20,0)
_M1=Aga Copper Move($180,$F00)
_W2=Aga Copper Wait(80,0)
_M2=Aga Copper Move($180,$0F0)
_W3=Aga Copper Wait(140,0)
_M3=Aga Copper Move($180,$00F)
_W4=Aga Copper Wait(200,0)
_M4=Aga Copper Move($180,$000)
_BADREG=Aga Copper Move($096,$0F0)
_BADRGB=Aga Copper Move($180,$1000)
_BADWAIT=Aga Copper Wait(100,0)
_END=Aga Copper End
_END2=Aga Copper End
_AFTER=Aga Copper Move($180,$FFF)
_ON=Aga Copper On
_SWAP=Aga Swap
If _C1<>1 or _W1<>1 or _M1<>1 or _W2<>1 or _M2<>1 or _W3<>1 or _M3<>1 or _W4<>1 or _M4<>1 or _END<>1 or _ON<>1 or _SWAP<>1
   X=Aga Copper Off
   Aga Screen Close
   Amos To Front
   Print "COPPER INITIALIZATION FAILED"
   End
End If

Amos To Back
_KEY=Aga Wait Key
_OFF=Aga Copper Off
_OFF2=Aga Copper Off
Aga Screen Close
Amos To Front

_OPEN2=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN2=0
   Print "REOPEN FAILED"
   End
End If
_C2=Aga Copper Clear
_ON2=Aga Copper On
_OFF3=Aga Copper Off
Aga Screen Close
Amos To Front

Print "M7-R18-COPPER-RASTER-01"
Print "W ";_W1;_W2;_W3;_W4;" M ";_M1;_M2;_M3;_M4
Print "BADREG ";_BADREG;" RGB ";_BADRGB;" WAIT ";_BADWAIT
Print "END ";_END;" END2 ";_END2;" AFTER ";_AFTER
Print "ON ";_ON;" SWAP ";_SWAP;" OFF ";_OFF;_OFF2
Print "REOPEN ";_OPEN2;" CLEAR2 ";_C2
Print "ON2 ";_ON2;" OFF3 ";_OFF3
Print "KEY ";_KEY;" CLOSE X2 RETURNED"
End
