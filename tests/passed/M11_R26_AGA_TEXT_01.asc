' M11-R26-AGA-TEXT-01: unique WinUAE R26 text test.
' Requires R26 0.9.2, not R25. Choose examples/demo.iff.
' Expected: GREEN AGA TEXT R26 in BLUE rectangle.
' Test targets Intuition back BitMap, not a native AMOS screen.
Cls
Print "M11-R26-AGA-TEXT-01"
Print "Choose demo.iff, 320X256X8 PAL"
Print "Look for GREEN text on BLUE panel"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8 or _C<>256
   Print "NEED 320X256X8 PALETTE"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
_CLEAR=Aga Blit Clear(0,0,320,256)
_PANEL=Aga Blit Fill(22,45,276,120,3)
_BAD=Aga Text(315,95,28,"TOO WIDE")
_TEXT=Aga Text(46,104,28,"AGA TEXT R26")
_SWAP=Aga Swap
Amos To Back
For _I=1 To 220
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_RESULT=1
If _CLEAR<>1 or _PANEL<>1 or _BAD<>0
   _RESULT=0
End If
If _TEXT<>1 or _SWAP<>1
   _RESULT=0
End If
If _OPEN<>1 or _DB<>1 or _LOAD<>1
   _RESULT=0
End If
If _CLOSED<>-1
   _RESULT=0
End If
Print "M11-R26-AGA-TEXT-01"
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD
Print "CLEAR ";_CLEAR;" PANEL ";_PANEL
Print "BAD ";_BAD;" TEXT ";_TEXT;" SWAP ";_SWAP
Print "CLOSED ";_CLOSED;" RESULT ";_RESULT
Print "CLOSE RETURNED"
End
