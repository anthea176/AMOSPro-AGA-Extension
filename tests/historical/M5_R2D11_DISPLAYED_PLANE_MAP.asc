' M5 R2D11 - DISPLAYED PLANE POINTER MAP
Cls
Print "M5-R2D11 - DISPLAYED PLANE MAP"

_OK=Aga Screen Open(320,200,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _IFF=Aga Iff Load("RAM:Clown.iff")
      Print "IFF LOAD = ";_IFF
      If _IFF<>0
         _SW=Aga Swap
         Print "SWAP = ";_SW
         If _SW<>0
            For _I=1 To 3
               Aga Wait Vbl
            Next _I
            For _P=0 To 7
               Print "DISPLAY P";_P;" -> BUFFER P";Aga Plane Hash(_P)
            Next _P
         End If
      End If
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If

Wait Key
End
