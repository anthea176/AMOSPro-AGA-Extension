' M4b R5 - SAFE SWAP stress test
' No Aga Back Fill here: validate only ScreenBuffer synchronisation.
'
Cls
Print "M4B R5 SAFE SWAP STRESS"
Print

_OK=Aga Screen Open(320,256,256,$00021000)
Print "OPEN = ";_OK

If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB

   If _DB=1
      For _I=1 To 20
         _SW=Aga Swap
         Print "SWAP ";_I;" = ";_SW
         If _SW<>1 Then _I=20
      Next _I
   End If

   Print "BEFORE CLOSE"
   Aga Screen Close
   Print "CLOSE = OK"
End If

Print "R5 TEST FINISHED"
Wait Key
End
