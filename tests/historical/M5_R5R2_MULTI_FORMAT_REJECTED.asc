' M5.2 R5R2 - MULTI FORMAT
' PicInfo-driven screen. No diagnostics.
' Use Fsel$("**"). harrison/EHB excluded.

Cls
Print "M5.2 R5R2 - MULTI FORMAT"

_FILE$=Fsel$("**")
If _FILE$<>""
   _W=Aga Pic Info(_FILE$,0)
   _H=Aga Pic Info(_FILE$,1)
   _C=Aga Pic Info(_FILE$,3)
   _M=Aga Pic Info(_FILE$,5)

   _MODE=_M
   If _MODE=0
      _MODE=$00021000
   End If

   _OK=Aga Screen Open(_W,_H,_C,_MODE)
   Amos To Front
   Print "OPEN = ";_OK

   If _OK<>0
      _DB=Aga Double Buffer
      Print "DB = ";_DB

      If _DB<>0
         _IFF=Aga Iff Load(_FILE$)
         Print "IFF = ";_IFF

         If _IFF<>0
            _SW=Aga Swap
            Print "SWAP = ";_SW

            If _SW<>0
               Amos To Back
               For _I=1 To 250
                  Aga Wait Vbl
               Next _I
               Amos To Front
            End If
         End If
      End If

      Aga Screen Close
      Print "CLOSE = OK"
   End If
End If

Wait Key
End
