' M11-R25-AMOS-TEXT-01 - screen compatibility diagnostic.
' This does NOT add any R26 command or modify the R25 library.
' Choose examples/demo.iff (or matching 320x256x8 PAL test card).
' AGA screen shows a blue panel. Look for "AMOS TEXT VISIBLE?"
' inside that blue panel DURING the 300 VBL display period.
' If the text is absent, AMOS Text may target the AMOS screen.
Cls
Print "M11-R25-AMOS-TEXT-01"
Print "Select demo.iff 320X256X8 PAL"
Print "Observe the BLUE panel for AMOS TEXT VISIBLE?"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8 or _C<>256 or _MODE<>$00021000
   Print "NEED 320X256X8 PAL TEST CARD"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
_DRAWERR=0
' Prepare BOTH AGA buffers so the panel remains visible.
For _I=1 To 2
   _CL=Aga Blit Clear(0,0,320,256)
   _BG=Aga Blit Fill(20,40,280,175,3)
   _LED=Aga Blit Fill(8,8,16,16,28)
   _SW=Aga Swap
   If _CL<>1 or _BG<>1 or _LED<>1 or _SW<>1
      _DRAWERR=1
   End If
   Aga Wait Vbl
Next _I
If _DRAWERR<>0
   Aga Screen Close
   Amos To Front
   Print "AGA DRAW FAILED"
   End
End If
Amos To Back
' The native AMOS command may draw only on the AMOS-owned screen.
' This is a VISUAL probe; no claim of compatibility is made.
Ink 2
Text 52,110,"AMOS TEXT VISIBLE?"
For _FRAME=1 To 300
   Aga Wait Vbl
Next _FRAME
Aga Screen Close
Amos To Front
Print "M11-R25-AMOS-TEXT-01"
Print "AGA SCREEN DISPLAYED 300 VBL"
Print "DRAWERR ";_DRAWERR
Print "REPORT: WAS AMOS TEXT VISIBLE IN BLUE PANEL?"
Print "CLOSE RETURNED"
End
