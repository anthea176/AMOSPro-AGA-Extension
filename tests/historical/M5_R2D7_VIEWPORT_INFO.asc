' M5 R2D7 - VIEWPORT / DISPLAY MODE DIAGNOSTIC
Cls
Print "M5-R2D7 - VIEWPORT INFO"

_OK=Aga Screen Open(320,200,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _IFF=Aga Iff Load("RAM:Clown.iff")
      Print "IFF LOAD = ";_IFF
      If _IFF<>0
         _VM=Aga Vp Modes
         _MID=Aga Vp Modeid
         _B0=Aga Bp0 Base
         _B1=Aga Bp1 Base
         Print "VP MODES = ";_VM
         Print "VP MODEID = ";_MID
         Print "BP0 BASE = ";_B0
         Print "BP1 BASE = ";_B1
      End If
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If

Wait Key
End
