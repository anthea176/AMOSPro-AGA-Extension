' R8 0.5.9 - R8-FALLOUT-KEY-POLL-01
' One Fallout IFF load + one Swap, NO Aga Wait Key.
' Check whether RAWKEY arrives at the Intuition Window via Aga Key.
' Polling is capped at 500 VBL; always close when the budget expires.
' To test focus: press SPACE on the AGA screen; if no response,
' click on the AGA screen and press SPACE again.
' Do NOT test Ctrl+C in this scenario: that path is separate.

Cls
Print "R8-FALLOUT-KEY-POLL-01"
Print "FALLOUT: PRESS SPACE WHEN IMAGE SHOWS"
Print "IF NO RESPONSE: CLICK AGA SCREEN, PRESS SPACE"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_P=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,3)
_Z=Aga Pic Info(_FILE$,4)
_MODE=Aga Pic Info(_FILE$,6)
_COLORS=Aga Pic Info(_FILE$,7)
Print "IMAGE ";_W;" X ";_H;" PLANS ";_P
If _W<=0 or _H<=0 or _P<=0 or _C<=0 or _Z<0 or _COLORS<=0
   Print "PIC INFO FAILED"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_COLORS,_MODE)
If _OPEN=0
   Amos To Front
   Print "OPEN FAILED"
   End
End If

_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED - CLOSED"
   End
End If

_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED - CLOSED"
   End
End If

_SW=Aga Swap
If _SW=0
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED - CLOSED"
   End
End If

Amos To Back
_KEY=-1
_TICKS=0
Repeat
   _KEY=Aga Key
   _TICKS=_TICKS+1
   If _KEY=-1
      Aga Wait Vbl
   End If
Until _KEY<>-1 or _TICKS>=500

Aga Screen Close
Amos To Front
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD;" SWAP ";_SW
Print "RAWKEY = ";_KEY;" POLLS = ";_TICKS
If _KEY=-1
   Print "TIMEOUT - NO RAWKEY ON AGA WINDOW"
Else
   Print "RAWKEY RECEIVED - CLOSE RETURNED"
End If
Print "TEST COMPLETE"
End
