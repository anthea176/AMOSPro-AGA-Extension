' M5 Intuition Input R6 - unique runtime validation
' Tests A/B/D complete normally. Test C MUST interrupt the program.
' R6: Break + automatic Amos To Front (no BASIC instruction on Break).
' R3 screen close and R4 Ctrl-only filtering must stay unchanged.
' Run interpreted first. Then repeat compiled if required by the validation matrix.

Cls
Print "M5 INTUITION INPUT R6"
Print "A: WAIT KEY - press a normal key on the AGA screen"

_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>0
   Aga Screen Pattern
   Amos To Back
   _K=Aga Wait Key
   Aga Screen Close
   Amos To Front
   Print "A PASS candidate - raw key = ";_K
Else
   Print "A FAIL - screen open"
End If

Print "B: POLLING - do not press immediately, then press a normal key"
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>0
   Aga Screen Pattern
   Amos To Back
   _EMPTY=0
   _K=-1
   Repeat
      _K=Aga Key
      If _K=-1
         _EMPTY=_EMPTY+1
         Aga Wait Vbl
      End If
   Until _K<>-1
   Aga Screen Close
   Amos To Front
   Print "B PASS candidate - empty polls = ";_EMPTY;" raw key = ";_K
Else
   Print "B FAIL - screen open"
End If

Print "D: 3 OPEN / WAIT / CLOSE cycles"
For _CYCLE=1 To 3
   _OPEN=Aga Screen Open(320,256,256,$00021000)
   If _OPEN<>0
      Aga Screen Pattern
      Amos To Back
      _K=Aga Wait Key
      Aga Screen Close
      Amos To Front
      Print "D cycle ";_CYCLE;" closed - raw key = ";_K
   Else
      Amos To Front
      Print "D FAIL - open cycle ";_CYCLE
   End If
Next _CYCLE

Print "C: BREAK ON / HOLD CTRL / PRESS C"
Print "CTRL (99) ALONE MUST NOT EXIT AGA WAIT KEY"
Print "Expected: BREAK, editor AMOS visible (not Workbench), no AGA screen."
Print "If C FAIL appears, the native break integration FAILED."
Break On
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>0
   Aga Screen Pattern
   Amos To Back
   _K=Aga Wait Key
   Aga Screen Close
   Amos To Front
   Print "C FAIL - Aga Wait Key returned ";_K;" instead of interrupting"
Else
   Print "C FAIL - screen open"
End If

End
