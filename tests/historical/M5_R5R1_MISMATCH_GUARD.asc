' M5.2 R5R1 - IMAGE/SCREEN MISMATCH GUARD
' Intentional mismatch test.
' Select Clown.iff (320x200x8 / 256 colors).
' We deliberately open 320x256x4 / 16 colors.
' EXPECTED: IFF LOAD = 0, explicit error message, NO CRASH.

Cls
Print "M5.2 R5R1 - MISMATCH GUARD"

_FILE$=Fsel$("**")
If _FILE$<>""
   Print _FILE$
   Print "OPEN WRONG SCREEN ON PURPOSE"

   _OK=Aga Screen Open(320,256,16,$00021000)
   Amos To Front
   Print "OPEN = ";_OK

   If _OK<>0
      _DB=Aga Double Buffer
      Print "DB = ";_DB

      If _DB<>0
         _IFF=Aga Iff Load(_FILE$)
         Print "IFF LOAD = ";_IFF

         If _IFF=0
            Print "ERROR: IMAGE/SCREEN MISMATCH"
            Print "LOAD ABORTED SAFELY"
         Else
            Print "ERROR: GUARD FAILED"
         End If
      End If

      Aga Screen Close
      Print "CLOSE = OK"
   End If
End If

Wait Key
End
