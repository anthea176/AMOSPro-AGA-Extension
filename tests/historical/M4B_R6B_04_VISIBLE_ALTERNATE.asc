' M4b R6B-R4 - TEST 04: VISIBLE BUFFER ALTERNATION
' Visual proof only: alternate screen pattern around each swap.
Cls
Print "R6B-R4 TEST 04 - VISIBLE ALTERNATE"
_OK=Aga Screen Open(320,256,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      Amos To Back
      For _N=1 To 20
         Aga Screen Pattern
         _SW=Aga Swap
         For _I=1 To 8
            Aga Wait Vbl
         Next _I
      Next _N
      Amos To Front
      Print "VISIBLE SWAPS = 20"
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "TEST 04 FINISHED"
Wait Key
End
