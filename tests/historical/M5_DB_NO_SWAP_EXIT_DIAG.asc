' M5 / R6 - isolate DB allocation and Close without Swap or IFF Load
' Run ONCE in a clean WinUAE session. Normal key only, NO Ctrl+C.
' After returning to AMOS, report PASS/FAIL before repeated runs.
' NO ChangeScreenBuffer, NO IFF Load, NO Screen Pattern.

Cls
Print "M5 DB ALLOC / CLOSE - NO SWAP NO IFF"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_P=Aga Pic Info(_FILE$,2)
_MODE=Aga Pic Info(_FILE$,6)
_COLORS=Aga Pic Info(_FILE$,7)
Print "WIDTH ";_W;" HEIGHT ";_H;" PLANES ";_P
Print "MODE ";_MODE;" COLORS ";_COLORS
If _W<=0 or _H<=0 or _COLORS<=0
   Print "INVALID PIC INFO"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_COLORS,_MODE)
Print "OPEN = ";_OPEN
If _OPEN=0
   Print "OPEN FAILED - NO DB"
   End
End If

_DB=Aga Double Buffer
Print "DOUBLE BUFFER = ";_DB
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED - SCREEN CLOSED"
   End
End If

Amos To Back
_K=Aga Wait Key
Aga Screen Close
Amos To Front
Print "DB ALLOC / CLOSE FINISHED - KEY = ";_K
Print "NO SWAP AND NO IFF LOAD"
End
