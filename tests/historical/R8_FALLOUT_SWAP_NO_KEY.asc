' R8 0.5.9 - TEST UNIQUE R8-FALLOUT-SWAP-NOKEY-01 (Fallout image).
' Follow-up to LOAD_ONLY visible checkpoints: OPEN/DB/LOAD/CLOSE PASS.
' This version adds ONE Swap. No input polling or Ctrl+C test.
' Start with a clean WinUAE session. Run once; inspect result before retry.
' Amos To Front makes command returns visible; no new AGA commands.

Cls
Print "R8-FALLOUT-SWAP-NOKEY-01"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_P=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,3)
_Z=Aga Pic Info(_FILE$,4)
_MODE=Aga Pic Info(_FILE$,6)
_COLORS=Aga Pic Info(_FILE$,7)
Print "PIC INFO ";_W;"X";_H;" P";_P;" C";_C
Print "MODE ";_MODE;" COLORS ";_COLORS;" COMP ";_Z
If _W<=0 or _H<=0 or _P<=0 or _C<=0 or _Z<0 or _COLORS<=0
   Print "PIC INFO FAILED"
   End
End If

Print "BEFORE OPEN"
_OPEN=Aga Screen Open(_W,_H,_COLORS,_MODE)
Amos To Front
Print "AFTER OPEN = ";_OPEN
If _OPEN=0
   Print "OPEN FAILED"
   End
End If

Print "BEFORE DOUBLE BUFFER"
_DB=Aga Double Buffer
Amos To Front
Print "AFTER DOUBLE BUFFER = ";_DB
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED - CLOSED"
   End
End If

Print "BEFORE IFF LOAD"
_LOAD=Aga Iff Load(_FILE$)
Amos To Front
Print "AFTER IFF LOAD = ";_LOAD
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "LOAD FAILED - CLOSED"
   End
End If

Print "BEFORE SWAP"
Amos To Back
_SW=Aga Swap
Amos To Front
Print "AFTER SWAP = ";_SW
If _SW<>0
   Amos To Back
   For _I=1 To 50
      Aga Wait Vbl
   Next _I
   Amos To Front
End If

Print "BEFORE CLOSE"
Aga Screen Close
Amos To Front
Print "AFTER CLOSE - NO WAIT KEY"
End
