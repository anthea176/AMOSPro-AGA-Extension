' M5.2 R5R1 - KEKKO A/B
' Direct 320x256x16 path. Select KEKKO.IFF with Fsel$("**").
' BODY has already been checksum-validated; this test is palette-only.

Cls
Print "M5.2 R5R1 - KEKKO A/B"

_FILE$=Fsel$("**")
If _FILE$<>""
   _OK=Aga Screen Open(320,256,16,$00021000)
   Amos To Front
   Print "OPEN = ";_OK

   If _OK<>0
      _DB=Aga Double Buffer
      Print "DB = ";_DB

      If _DB<>0
         _IFF=Aga Iff Load(_FILE$)
         Print "IFF = ";_IFF

         If _IFF<>0
            _SW=Aga Swap
            Print "SWAP = ";_SW

            If _SW<>0
               Amos To Back
               For _I=1 To 300
                  Aga Wait Vbl
               Next _I
               Amos To Front
            End If
         End If
      End If

      Aga Screen Close
      Print "CLOSE = OK"
   End If
End If

Wait Key
End
