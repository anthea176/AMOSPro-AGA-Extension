' M5.2 R5 - MULTI FORMAT REGRESSION
' Opens the screen from PicInfo metadata.
' Use Fsel$("**").
' Valid indexed 320px cases only; harrison/EHB excluded.

Cls
Print "M5.2 R5 - MULTI FORMAT"

_FILE$=Fsel$("**")
If _FILE$<>""
   _W=Aga Pic Info(_FILE$,0)
   _H=Aga Pic Info(_FILE$,1)
   _P=Aga Pic Info(_FILE$,2)
   _C=Aga Pic Info(_FILE$,3)
   _Z=Aga Pic Info(_FILE$,4)
   _M=Aga Pic Info(_FILE$,5)

   Print _FILE$
   Print "W/H = ";_W;"/";_H
   Print "PLANES = ";_P
   Print "COLORS = ";_C
   Print "COMP = ";_Z
   Print "CAMG = ";_M

   _MODE=_M
   If _MODE=0
      _MODE=$00021000
   End If

   Print "BEFORE OPEN"
   _OK=Aga Screen Open(_W,_H,_C,_MODE)
   Amos To Front
   Print "OPEN = ";_OK

   If _OK<>0
      _DB=Aga Double Buffer
      Print "DB = ";_DB

      If _DB<>0
         _IFF=Aga Iff Load(_FILE$)
         Print "IFF = ";_IFF

         If _IFF<>0
            _SW=Aga Swap
            Print "SWAP = ";_SW

            If _SW<>0
               Amos To Back
               For _I=1 To 250
                  Aga Wait Vbl
               Next _I
               Amos To Front
            End If
         End If
      End If

      Aga Screen Close
      Print "CLOSE = OK"
   End If
End If

Wait Key
End
