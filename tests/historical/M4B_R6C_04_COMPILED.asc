' R6C-R1 TEST 04 - COMPILED REGRESSION
' IMPORTANT: compile this program with AMOS Compiler, then run the executable.
Cls
Print "R6C-R1 TEST 04 - COMPILED"
_OK=Aga Screen Open(320,256,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _FAIL=0
      For _N=1 To 10
         If (_N Mod 2)=0
            Aga Back Fill 0
         Else
            Aga Back Fill 255
         End If
         _SW=Aga Swap
         If _SW=0
            _FAIL=_FAIL+1
         End If
         For _I=1 To 2
            Aga Wait Vbl
         Next _I
      Next _N
      Print "TOTAL FAILURES = ";_FAIL
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "COMPILED TEST FINISHED"
Wait Key
End
