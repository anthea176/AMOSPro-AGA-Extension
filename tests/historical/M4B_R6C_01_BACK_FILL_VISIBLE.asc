' M4b R6C - TEST 01: VISIBLE BACK BUFFER FILL
Cls
Print "R6C TEST 01 - BACK FILL"
_OK=Aga Screen Open(320,256,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   Aga Screen Pattern
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      Amos To Back
      For _N=1 To 12
         If (_N Mod 2)=0
            Aga Back Fill 0
         Else
            Aga Back Fill 255
         End If
         _SW=Aga Swap
         For _I=1 To 12
            Aga Wait Vbl
         Next _I
      Next _N
      Amos To Front
      Print "VISIBLE FILLS = 12"
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If
Print "TEST 01 FINISHED"
Wait Key
End
