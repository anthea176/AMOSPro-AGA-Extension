' M5 R2D3 - PLANE CHECKSUM AFTER IFF LOAD
Cls
Print "M5-R2D3 - PLANE CHECKSUM"

_OK=Aga Screen Open(320,200,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _IFF=Aga Iff Load("RAM:Clown.iff")
      Print "IFF LOAD = ";_IFF
      If _IFF<>0
         _P0=Aga P0 Sum
         _P7=Aga P7 Sum
         Print "P0 SUM = ";_P0
         Print "P0 EXPECT = 1084731"
         Print "P7 SUM = ";_P7
         Print "P7 EXPECT = 670502"
      End If
   End If

   Aga Screen Close
   Print "CLOSE = OK"
End If

Wait Key
End
