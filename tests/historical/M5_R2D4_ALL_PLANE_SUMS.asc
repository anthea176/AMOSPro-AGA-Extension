' M5 R2D4 - CHECKSUM ALL 8 PLANES
Cls
Print "M5-R2D4 - ALL PLANE SUMS"

_OK=Aga Screen Open(320,200,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _IFF=Aga Iff Load("RAM:Clown.iff")
      Print "IFF LOAD = ";_IFF
      If _IFF<>0
         For _P=0 To 7
            _S=Aga Plane Sum(_P)
            Print "PLANE ";_P;" SUM = ";_S
         Next _P
         Print "EXPECT:"
         Print "0 1084731"
         Print "1 1002473"
         Print "2 865185"
         Print "3 837995"
         Print "4 794171"
         Print "5 779721"
         Print "6 729727"
         Print "7 670502"
      End If
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If

Wait Key
End
