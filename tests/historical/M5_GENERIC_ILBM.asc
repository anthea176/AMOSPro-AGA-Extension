' M5 Generic ILBM R2 0.5.1 - single interpreted/compiled regression test
' Select any repository IFF. Cancel the selector to finish.
' Large screens scroll when the mouse reaches the display edge.

Cls
Print "M5 GENERIC ILBM - R2 0.5.1"
Repeat
   _FILE$=Fsel$("**")
   If _FILE$<>""
      _W=Aga Pic Info(_FILE$,0)
      _H=Aga Pic Info(_FILE$,1)
      _P=Aga Pic Info(_FILE$,2)
      _C=Aga Pic Info(_FILE$,3)
      _Z=Aga Pic Info(_FILE$,4)
      _CAMG=Aga Pic Info(_FILE$,5)
      _MODE=Aga Pic Info(_FILE$,6)
      _COLORS=Aga Pic Info(_FILE$,7)
      Print _FILE$
      Print "SIZE = ";_W;" x ";_H;" PLANES = ";_P
      Print "CMAP = ";_C;" COMPRESSION = ";_Z
      Print "CAMG = ";_CAMG;" SCREEN MODE = ";_MODE
      If _W>0 and _H>0 and _P>0 and _C>0 and _Z>=0 and _COLORS>0
         _OPEN=Aga Screen Open(_W,_H,_COLORS,_MODE)
         Amos To Front
         Print "OPEN = ";_OPEN
         If _OPEN<>0
            _DB=Aga Double Buffer
            Print "DOUBLE BUFFER = ";_DB
            If _DB<>0
               _LOAD=Aga Iff Load(_FILE$)
               Print "IFF LOAD = ";_LOAD
               If _LOAD<>0
                  _SWAP=Aga Swap
                  Print "SWAP = ";_SWAP
                  If _SWAP<>0
                     Amos To Back
                     For _I=1 To 750
                        Aga Wait Vbl
                     Next _I
                     Amos To Front
                     Print "CHECK GEOMETRY / PIXELS / ALL PALETTE INDICES"
                  End If
               End If
            End If
            Aga Screen Close
            Print "CLOSE = OK"
         End If
      Else
         Print "INVALID OR UNSUPPORTED IFF"
      End If
      Print "RECORD VISUAL RESULT - PRESS A KEY FOR NEXT FILE"
      Wait Key
   End If
Until _FILE$=""
End
