' M5 R2D6 - HASH REAL VIEWPORT PALETTE
Cls
Print "M5-R2D6 - PALETTE HASH"

_OK=Aga Screen Open(320,200,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _IFF=Aga Iff Load("RAM:Clown.iff")
      Print "IFF LOAD = ";_IFF
      If _IFF<>0
         _H=Aga Palette Hash
         Print "PALETTE HASH = ";_H
         Print "EXPECT = -672473043"
      End If
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If

Wait Key
End
