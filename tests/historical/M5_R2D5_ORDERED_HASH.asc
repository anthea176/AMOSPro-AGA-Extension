' M5 R2D5 - ORDERED HASH ALL 8 PLANES
Cls
Print "M5-R2D5 - ORDERED PLANE HASH"

_OK=Aga Screen Open(320,200,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _IFF=Aga Iff Load("RAM:Clown.iff")
      Print "IFF LOAD = ";_IFF
      If _IFF<>0
         For _P=0 To 7
            _H=Aga Plane Hash(_P)
            Print "P";_P;" HASH = ";_H
         Next _P
         Print "EXPECT:"
         Print "0 305178496"
         Print "1 1530027246"
         Print "2 1255217126"
         Print "3 -740432144"
         Print "4 371384384"
         Print "5 -431432818"
         Print "6 1029346052"
         Print "7 1770242699"
      End If
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If

Wait Key
End
