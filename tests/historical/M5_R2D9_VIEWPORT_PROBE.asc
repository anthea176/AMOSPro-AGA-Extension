' M5 R2D9 - SINGLE VIEWPORT PROBE
Cls
Print "M5-R2D9 - VIEWPORT PROBE"

_OK=Aga Screen Open(320,200,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _IFF=Aga Iff Load("RAM:Clown.iff")
      Print "IFF LOAD = ";_IFF
      If _IFF<>0
         Print "VIEW FLAGS = ";Aga Probe(0)
         Print "DISPLAY ID = ";Aga Probe(1)
         Print "BASE ZERO = ";Aga Probe(2)
         Print "BASE ONE = ";Aga Probe(3)
      End If
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If

Wait Key
End
