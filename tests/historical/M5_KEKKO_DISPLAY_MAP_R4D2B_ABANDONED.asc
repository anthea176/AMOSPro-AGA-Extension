' M5 R4D2b - KEKKO DISPLAYED PLANE MAP
' Reuses the already validated Aga Plane Sum(N) token.
' In THIS diagnostic only, Aga Plane Sum returns displayed->front plane mapping.

Cls
Print "M5 R4D2b - KEKKO DISPLAY MAP"

_FILE$=Fsel$("**")
If _FILE$<>""
   _OK=Aga Screen Open(320,256,16,$00021000)
   Amos To Front
   Print "OPEN = ";_OK

   If _OK<>0
      _DB=Aga Double Buffer
      Print "DB = ";_DB

      If _DB<>0
         _IFF=Aga Iff Load(_FILE$)
         Print "IFF = ";_IFF

         If _IFF<>0
            _SW=Aga Swap
            Print "SWAP = ";_SW

            If _SW<>0
               For _I=1 To 3
                  Aga Wait Vbl
               Next _I

               _M0=Aga Plane Sum(0)
               _M1=Aga Plane Sum(1)
               _M2=Aga Plane Sum(2)
               _M3=Aga Plane Sum(3)

               Amos To Front
               Print "MAP0 = ";_M0;" / 0"
               Print "MAP1 = ";_M1;" / 1"
               Print "MAP2 = ";_M2;" / 2"
               Print "MAP3 = ";_M3;" / 3"
            End If
         End If
      End If

      Aga Screen Close
      Print "CLOSE = OK"
   End If
End If

Wait Key
End
