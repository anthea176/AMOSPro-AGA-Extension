' M5 R2D1 - BACK BUFFER BITMAP INFO
Cls
Print "M5-R2D1 - BACK BITMAP INFO"

_OK=Aga Screen Open(320,200,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _F=Aga Back Flags
      _S=Aga Back Stride
      Print "BM FLAGS = ";_F
      Print "PLANE 1-0 DELTA = ";_S
   End If

   Aga Screen Close
   Print "CLOSE = OK"
End If

Wait Key
End
