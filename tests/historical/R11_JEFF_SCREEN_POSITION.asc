' R11 0.6.2 - Jeff screen should open at the top without manual drag
' Use ONLY R11 0.6.2. Jeff-Flag first, Fallout second if PASS.
' No new screen until the previous Close has returned.
' Run once in a fresh WinUAE session; validate before repetitions.
' This is NOT a stress test. Ctrl+C during active Swap is not validated.

Cls
Print "R11-JEFF-SCREEN-POS-01"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If

_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_P=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,3)
_Z=Aga Pic Info(_FILE$,4)
_MODE=Aga Pic Info(_FILE$,6)
_COLORS=Aga Pic Info(_FILE$,7)
Print "SIZE ";_W;" X ";_H;" PLANES ";_P
Print "CMAP ";_C;" COMPRESSION ";_Z
Print "MODE ";_MODE;" COLORS ";_COLORS
If _W<=0 or _H<=0 or _P<=0 or _C<=0 or _Z<0 or _COLORS<=0
   Print "INVALID IMAGE"
   End
End If

_OPEN=Aga Screen Open(_W,_H,_COLORS,_MODE)
Print "OPEN = ";_OPEN
If _OPEN=0
   Print "OPEN FAILED"
   End
End If

_DB=Aga Double Buffer
If _DB=0
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If

_LOAD=Aga Iff Load(_FILE$)
If _LOAD=0
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If

_SWAP=Aga Swap
If _SWAP=0
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED"
   End
End If

Amos To Back
_K=Aga Wait Key
Aga Screen Close
Amos To Front
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD;" SWAP ";_SWAP
Print "KEY ";_K;" - CLOSE RETURNED"
Print "CHECK IMAGE AND AMOS DISPLAY / NO CRASH"
End
