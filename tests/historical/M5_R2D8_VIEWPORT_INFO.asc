' M5 R2D8 - VIEWPORT / DISPLAY MODE DIAGNOSTIC
Cls
Print "M5-R2D8 - VIEWPORT INFO"

_OK=Aga Screen Open(320,200,256,$00021000)
Print "OPEN = ";_OK
If _OK<>0
   _DB=Aga Double Buffer
   Print "DOUBLE BUFFER = ";_DB
   If _DB<>0
      _IFF=Aga Iff Load("RAM:Clown.iff")
      Print "IFF LOAD = ";_IFF
      If _IFF<>0
         _VF=Aga Viewflags
         _DI=Aga Displayid
         _BZ=Aga Basezero
         _BO=Aga Baseone
         Print "VIEW FLAGS = ";_VF
         Print "DISPLAY ID = ";_DI
         Print "BASE ZERO = ";_BZ
         Print "BASE ONE = ";_BO
      End If
   End If
   Aga Screen Close
   Print "CLOSE = OK"
End If

Wait Key
End
