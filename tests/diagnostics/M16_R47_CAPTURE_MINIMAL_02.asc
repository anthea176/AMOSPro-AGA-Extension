Cls
Print "R47 CAPTURE DIAG 02"
If Aga Detect=0
   Print "NO AGA"
   End
End If
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "OPEN FAILED ";_OPEN
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED ";_DB
   End
End If
_CAP=Aga Image Capture(11,16,16,16,16,-1)
Aga Screen Close
Amos To Front
Print "CAPTURE RETURN ";_CAP
If _CAP=1
   Print "BANK NAME ";Peek$(Start(11),6)
   Erase 11
End If
Print "CLOSE RETURNED"
End
