' M16/R47 diagnostic #01 - one MINIMAL Image Capture call only.
' Do NOT run before M16_R47_CRASH_ISOLATION_00.asc returns RESULT 1.
' Run only on disposable WinUAE config; R47 is known to crash the host.
' BANK 11 MUST BE FREE before running. NO auto-erase on preexisting bank.
' No Save/Load/Draw, no complex picture, no Compiler.
Cls
Print "R47 DIAG 01 - MINIMAL CAPTURE"
If Aga Detect=0
   Print "NO AGA - STOP"
   End
End If
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "OPEN FAILED ";_OPEN
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED ";_DB
   End
End If
' Only new command is the following capture of a small blank rectangle.
_CAPTURE=Aga Image Capture(11,16,16,16,16,-1)
Aga Screen Close
Amos To Front
Print "CAPTURE 11 ";_CAPTURE
If _CAPTURE=1
   Print "BANK NAME ";Peek$(Start(11),6)
   Erase 11
End If
Print "CLOSE RETURNED"
End
