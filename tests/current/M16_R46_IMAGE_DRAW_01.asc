' M16-R46-IMAGE-DRAW-01 : WinUAE Gate B NOT TESTED.
' Requires R46 0.12.1 candidate AGA extension (not R45 failed nor R44).
' Put M16_AGAPIC_SAMPLE_BANK10.abk in the AMOS current directory.
' WARNING: Load overwrites AMOS bank number 10.
' Expected: opaque 64x40 colour mosaic and two masked circular mosaics.
' R46 repairs the observed AMOS native FLAGS=0 loading behavior.
' Pen 0 is PINK and must be drawn when mask bit = 1.
' Wait to see the image. Native CPU rendering may be slow on 68000.
Cls
Print "M16-R46-IMAGE-DRAW-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_B=10
Load "M16_AGAPIC_SAMPLE_BANK10.abk",_B
_BASE=Start(_B)
_LEN=Length(_B)
If _BASE=0 or _LEN<>1836
   Print "AGAPIC BANK 10 MISSING"
   End
End If
If Peek$(_BASE,6)<>"AGAPIC"
   Print "AGAPIC MAGIC BAD"
   End
End If
' Record actual AMOS native bank envelope (not the .abk disk header).
' The R46 CPU validator requires: LEN=DATA+16, NO=10, FLAGS=0/1/3,
' NAME="AGAPIC  ". Refuse anything else or an invalid RLE stream.
_METALEN=Leek(_BASE-20)
_METANO=Leek(_BASE-16)
_METAFLAGS=Deek(_BASE-12)
_METANAME$=Peek$(_BASE-8,8)
_CFBEFORE=Chip Free
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,255,40,190)
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,20,35,65)
_P3=Aga Palette Set(3,255,202,50)
_ERR=0
For _C=4 To 15
   _R=_C*15
   _G=255-_C*13
   _B2=_C*16
   _PC=Aga Palette Set(_C,_R,_G,_B2)
   If _PC<>1
      _ERR=_ERR+1
   End If
Next _C
' Opaque image MUST overwrite the dark-blue background with pen 0.
_CLR=Aga Blit Fill(0,0,320,256,2)
_T1=Aga Text(15,24,1,"R45 - CPU AGAPIC IMAGE")
_T2=Aga Text(15,47,3,"OPAQUE   MASKED   SHIFTED")
_T3=Aga Text(15,224,1,"FOUR EDGES / INDEX ZERO")
_F1=Aga Box(14,55,91,107,1)
_F2=Aga Box(106,55,183,107,1)
_F3=Aga Box(198,55,275,107,1)
_D0=Aga Image Draw(_BASE,_LEN,20,61,0)
_D1=Aga Image Draw(_BASE,_LEN,112,61,1)
_D2=Aga Image Draw(_BASE,_LEN,204,61,1)
' All four clipping sides, including X not divisible by 16.
_CL=Aga Image Draw(_BASE,_LEN,-14,139,1)
_CR=Aga Image Draw(_BASE,_LEN,287,141,1)
_CT=Aga Image Draw(_BASE,_LEN,132,-16,1)
_CB=Aga Image Draw(_BASE,_LEN,128,238,1)
' Invalid mode / pointer / length must not change any bitplane.
_BADM=Aga Image Draw(_BASE,_LEN,20,61,2)
_BADP=Aga Image Draw(0,_LEN,20,61,1)
_BADL=Aga Image Draw(_BASE,20,20,61,1)
' A wholly offscreen, otherwise valid call succeeds without writing.
_OUT=Aga Image Draw(_BASE,_LEN,320,256,1)
_SWAP=Aga Swap
If _SWAP=1
   Amos To Back
End If
' Wait for the just-displayed buffer to be visible to the user.
For _I=1 To 175
   Aga Wait Vbl
Next _I
' The new back buffer may initially be non-Safe: bounded retry.
_SAFE=0
For _I=1 To 25
   If _SAFE=0
      _SAFE=Aga Image Draw(_BASE,_LEN,135,100,1)
   End If
   Aga Wait Vbl
Next _I
For _I=1 To 125
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Image Draw(_BASE,_LEN,20,61,1)
_CLOSED=Aga Mouse X
_CFEND=Chip Free
_RESULT=1
If _OPEN<>1 or _DB<>1 or _CLR<>1
   _RESULT=0
End If
If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1 or _ERR<>0
   _RESULT=0
End If
If _T1<>1 or _T2<>1 or _T3<>1
   _RESULT=0
End If
If _F1<>1 or _F2<>1 or _F3<>1
   _RESULT=0
End If
If _D0<>1 or _D1<>1 or _D2<>1
   _RESULT=0
End If
If _CL<>1 or _CR<>1 or _CT<>1 or _CB<>1
   _RESULT=0
End If
If _BADM<>0 or _BADP<>0 or _BADL<>0 or _OUT<>1
   _RESULT=0
End If
If _SWAP<>1 or _SAFE<>1 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "M16-R46-IMAGE-DRAW-01"
Print "BANK ";_B;" BYTES ";_LEN;" OPEN ";_OPEN;" DB ";_DB
Print "OPAQUE ";_D0;" MASK ";_D1;" SHIFT ";_D2
Print "CLIP ";_CL;" ";_CR;" ";_CT;" ";_CB
Print "BAD ";_BADM;" ";_BADP;" ";_BADL;" OUT ";_OUT
Print "SWAP ";_SWAP;" BACKSAFE ";_SAFE
Print "CHIP BEFORE/END ";_CFBEFORE;" ";_CFEND
Print "NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "NATIVE LEN ";_METALEN;" WANT ";_LEN+16
Print "NATIVE NO ";_METANO;" FLAGS ";_METAFLAGS
Print "NATIVE NAME ";_METANAME$
Print "HEAD ";Peek$(_BASE,6);" V";Deek(_BASE+6)
Print "STREAM ";Leek(_BASE+24);" TOTAL ";Leek(_BASE+28)
Print "ERRORS ";_ERR;" RESULT ";_RESULT
Print "CLOSE RETURNED"
End
