' M19 P2.7 R87 - equal-pixel AGAPIC RLE vs FICON8 cache and Blit Copy.
' 4/8/16 masked Bobs, separate 8 Bob opaque Blitter probe.
' No new AGA command. No Swap/Wait Vbl in the benchmark.
Set Buffer 20
Cls
_RESULT=1 : _ERR=0 : _OPEN=0 : _CLOSED=0 : _BANKS_SAFE=0
_PARITY_OK=0 : _PARITY_BAD=0 : _RUNS=0 : _BLIT_RUNS=0
_REPS=64 : _RLE_CALLS=0 : _ICON_CALLS=0
_BLIT_CALLS=0 : _OPAQUE_ICON_CALLS=0 : _STAGES=0
Dim _OX(16),_OY(16),_SRC(16)
Dim _TIME(2,1,1),_TB(1,1)
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_P27_UNKNOWN.TXT"
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_P27_RUNTIME.TXT"
End If
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_P27_INTERPRETED.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_P27_COMPILED.TXT"
End If
Print "M19 P2.7 R87 RLE / FICON / BLITTER"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
' Reserve no bank until all would-be IDs are checked.
For _B=10 To 21
   If Length(_B)<>0
      _ERR=2 : Goto _CLEANUP
   End If
Next _B
_BANKS_SAFE=1
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
If Aga Double Buffer<>1
   _ERR=4 : Goto _CLEANUP
End If
' Source pixels: index 0 border, a coloured square and small accent.
' Same 256 indexed values feed both RLE AGAPIC and FICON8.
Reserve As Data 10,256
For _Y=0 To 15
   For _X=0 To 15
      _PIX=0
      If _X>=4 and _X<12 and _Y>=4 and _Y<12
         _PIX=5
      End If
      If _X>=8 and _X<12 and _Y>=2 and _Y<6
         _PIX=6
      End If
      Poke Start(10)+_Y*16+_X,_PIX
   Next _X
Next _Y
_D=Aga Blit Fill(0,0,320,256,0)
If _D<>1
   _ERR=5 : Goto _CLEANUP
End If
_D=Aga Blit Fill(4,4,8,8,5)
If _D<>1
   _ERR=6 : Goto _CLEANUP
End If
_D=Aga Blit Fill(8,2,4,4,6)
If _D<>1
   _ERR=7 : Goto _CLEANUP
End If
' Capture a SINGLE source scene in AGAPIC v1 and v2 with index 0 masked.
_D=Aga Bank Image Capture(12,0,0,16,16,0,1)
If _D<>1
   _ERR=8 : Goto _CLEANUP
End If
_D=Aga Bank Image Capture(13,0,0,16,16,0,2)
If _D<>1
   _ERR=9 : Goto _CLEANUP
End If
_D=Aga F Icon Bank Create(11,4)
If _D<>1
   _ERR=10 : Goto _CLEANUP
End If
_D=Aga F Icon Bank Put(11,2,10,0)
If _D<>1
   _ERR=11 : Goto _CLEANUP
End If
For _I=1 To 16
   _OX(_I)=20+((_I-1) Mod 4)*44
   _OY(_I)=20+Int((_I-1)/4)*44
   _SRC(_I)=12
   If (_I Mod 2)=0
      _SRC(_I)=13
   End If
Next _I
' Verify true captured output, not just return codes.
' Eight cases: v1/v2, opaque/masked, shifted and clipped X/Y.
For _CASE=1 To 8
   _SRCBANK=12 : _DRAWMODE=0
   _XPOS=32 : _YPOS=40 : _RX=24 : _RY=32
   If (_CASE Mod 2)=0
      _SRCBANK=13
   End If
   If _CASE>=3
      _DRAWMODE=1
   End If
   If _CASE=2 or _CASE=4
      _XPOS=33
   End If
   If _CASE=5
      _XPOS=-3 : _RX=0
   End If
   If _CASE=6
      _XPOS=312 : _YPOS=244 : _RX=288 : _RY=224
   End If
   If _CASE=7
      _YPOS=-3 : _RY=0
   End If
   If _CASE=8
      _YPOS=252 : _RY=224
   End If
   _D=Aga Blit Fill(0,0,320,256,1)
   If _D<>1
      _ERR=12 : Goto _CLEANUP
   End If
   _D=Aga Bank Image Draw(_SRCBANK,_XPOS,_YPOS,_DRAWMODE)
   If _D<>1
      _ERR=13 : Goto _CLEANUP
   End If
   _D=Aga Bank Image Capture(20,_RX,_RY,32,32,-1,1)
   If _D<>1
      _ERR=14 : Goto _CLEANUP
   End If
   _D=Aga Blit Fill(0,0,320,256,1)
   If _D<>1
      _ERR=15 : Goto _CLEANUP
   End If
   _D=Aga F Icon(11,2,_XPOS,_YPOS,_DRAWMODE)
   If _D<>1
      _ERR=16 : Goto _CLEANUP
   End If
   _D=Aga Bank Image Capture(21,_RX,_RY,32,32,-1,1)
   If _D<>1
      _ERR=17 : Goto _CLEANUP
   End If
   _DIFFER=0
   If Length(20)<>Length(21)
      _DIFFER=1
   Else
      _L=Length(20)
      If _L<1
         _DIFFER=1
      Else
         For _J=1 To _L
            If Peek(Start(20)+_J-1)<>Peek(Start(21)+_J-1)
               _DIFFER=1
            End If
         Next _J
      End If
   End If
   Erase 20 : Erase 21
   If _DIFFER<>0
      _PARITY_BAD=_PARITY_BAD+1
      _ERR=18 : Goto _CLEANUP
   End If
   _PARITY_OK=_PARITY_OK+1
Next _CASE
' One more full-image oracle: opaque Chip Blit Copy vs opaque FICON.
_D=Aga Blit Fill(0,0,320,256,1)
If _D<>1
   _ERR=19 : Goto _CLEANUP
End If
_D=Aga Bank Image Draw(12,240,200,0)
If _D<>1
   _ERR=20 : Goto _CLEANUP
End If
_D=Aga Blit Copy(240,200,33,40,16,16)
If _D<>1
   _ERR=21 : Goto _CLEANUP
End If
_D=Aga Bank Image Capture(20,24,32,32,32,-1,1)
If _D<>1
   _ERR=22 : Goto _CLEANUP
End If
_D=Aga Blit Fill(0,0,320,256,1)
If _D<>1
   _ERR=23 : Goto _CLEANUP
End If
_D=Aga F Icon(11,2,33,40,0)
If _D<>1
   _ERR=24 : Goto _CLEANUP
End If
_D=Aga Bank Image Capture(21,24,32,32,32,-1,1)
If _D<>1
   _ERR=25 : Goto _CLEANUP
End If
_DIFFER=0
If Length(20)<>Length(21)
   _DIFFER=1
Else
   _L=Length(20)
   If _L<1
      _DIFFER=1
   Else
      For _J=1 To _L
         If Peek(Start(20)+_J-1)<>Peek(Start(21)+_J-1)
            _DIFFER=1
         End If
      Next _J
   End If
End If
Erase 20 : Erase 21
If _DIFFER<>0
   _PARITY_BAD=_PARITY_BAD+1
   _ERR=26 : Goto _CLEANUP
End If
_PARITY_OK=_PARITY_OK+1
' Warm-up the two 16x16 backends before any timing.
_D=Aga Bank Image Draw(12,20,20,1)
If _D<>1
   _ERR=27 : Goto _CLEANUP
End If
_D=Aga F Icon(11,2,20,20,1)
If _D<>1
   _ERR=28 : Goto _CLEANUP
End If
' Masked draw-only RLE versus predecoded planar FICON8.
For _PASS=0 To 1
   For _CASE=0 To 2
      _N=4
      If _CASE=1
         _N=8
      End If
      If _CASE=2
         _N=16
      End If
      For _ORDER=0 To 1
         _METHOD=_ORDER
         If _PASS=1
            _METHOD=1-_ORDER
         End If
         _D=Aga Blit Fill(0,0,320,256,1)
         If _D<>1
            _ERR=29 : Goto _CLEANUP
         End If
         _T0=Timer
         If _METHOD=0
            For _REP=1 To _REPS
               For _I=1 To _N
                  _D=Aga Bank Image Draw(_SRC(_I),_OX(_I),_OY(_I),1)
                  If _D<>1
                     _ERR=30 : Goto _CLEANUP
                  End If
               Next _I
            Next _REP
            _RLE_CALLS=_RLE_CALLS+_REPS*_N
         Else
            For _REP=1 To _REPS
               For _I=1 To _N
                  _D=Aga F Icon(11,2,_OX(_I),_OY(_I),1)
                  If _D<>1
                     _ERR=31 : Goto _CLEANUP
                  End If
               Next _I
            Next _REP
            _ICON_CALLS=_ICON_CALLS+_REPS*_N
         End If
         _TIME(_CASE,_METHOD,_PASS)=Timer-_T0
         If _TIME(_CASE,_METHOD,_PASS)<=0
            _ERR=32 : Goto _CLEANUP
         End If
         _RUNS=_RUNS+1
      Next _ORDER
   Next _CASE
Next _PASS
' Opaque-only Blitter upper bound: source is pre-staged IN SAME back buffer.
' This DOES NOT measure a masked AGAPIC cache Blitter or staging cost.
For _PASS=0 To 1
   For _ORDER=0 To 1
      _METHOD=_ORDER
      If _PASS=1
         _METHOD=1-_ORDER
      End If
      _D=Aga Blit Fill(0,0,320,256,1)
      If _D<>1
         _ERR=33 : Goto _CLEANUP
      End If
      _D=Aga Bank Image Draw(12,240,200,0)
      If _D<>1
         _ERR=34 : Goto _CLEANUP
      End If
      _STAGES=_STAGES+1
      _T0=Timer
      For _REP=1 To _REPS
         For _I=1 To 8
            If _METHOD=0
               _D=Aga F Icon(11,2,_OX(_I),_OY(_I),0)
            Else
               _D=Aga Blit Copy(240,200,_OX(_I),_OY(_I),16,16)
            End If
            If _D<>1
               _ERR=35 : Goto _CLEANUP
            End If
         Next _I
      Next _REP
      _TB(_METHOD,_PASS)=Timer-_T0
      If _TB(_METHOD,_PASS)<=0
         _ERR=36 : Goto _CLEANUP
      End If
      If _METHOD=0
         _OPAQUE_ICON_CALLS=_OPAQUE_ICON_CALLS+_REPS*8
      Else
         _BLIT_CALLS=_BLIT_CALLS+_REPS*8
      End If
      _BLIT_RUNS=_BLIT_RUNS+1
   Next _ORDER
Next _PASS
If _PARITY_OK<>9 or _PARITY_BAD<>0
   _ERR=37 : Goto _CLEANUP
End If
If _RUNS<>12 or _RLE_CALLS<>3584 or _ICON_CALLS<>3584
   _ERR=38 : Goto _CLEANUP
End If
If _BLIT_RUNS<>4 or _STAGES<>4
   _ERR=39 : Goto _CLEANUP
End If
If _BLIT_CALLS<>1024 or _OPAQUE_ICON_CALLS<>1024
   _ERR=40 : Goto _CLEANUP
End If
Goto _CLEANUP

_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _BANKS_SAFE=1
   For _B=10 To 21
      If Length(_B)<>0
         Erase _B
      End If
   Next _B
End If
If _ERR=0 and _CLOSED<>1
   _ERR=41
End If
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "M19 P2.7 ";_VERDICT$;" ERR ";_ERR
Print "PARITY ";_PARITY_OK;"/9, TIMINGS ";_RUNS;"+";_BLIT_RUNS
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P27_R87_CACHE_CPU_BLITTER_01"
   Print #1,"LIBRARY_EXPECTED R87_V0.13.32"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"PARITY_OK ";_PARITY_OK
   Print #1,"PARITY_BAD ";_PARITY_BAD
   Print #1,"REPS ";_REPS
   Print #1,"MASK_RUNS ";_RUNS
   Print #1,"RLE_CALLS ";_RLE_CALLS
   Print #1,"FICON_CALLS ";_ICON_CALLS
   For _CASE=0 To 2
      _N=4
      If _CASE=1
         _N=8
      End If
      If _CASE=2
         _N=16
      End If
      _RA=_TIME(_CASE,0,0)+_TIME(_CASE,0,1)
      _FA=_TIME(_CASE,1,0)+_TIME(_CASE,1,1)
      Print #1,"MASK_BOBS ";_N;" RLE_TICKS ";_RA;" FICON_TICKS ";_FA
      Print #1,"PASS0_N ";_N;" RLE ";_TIME(_CASE,0,0);" FICON ";_TIME(_CASE,1,0)
      Print #1,"PASS1_N ";_N;" RLE ";_TIME(_CASE,0,1);" FICON ";_TIME(_CASE,1,1)
   Next _CASE
   Print #1,"OPAQUE_BOBS 8 FICON_TICKS ";_TB(0,0)+_TB(0,1);" BLIT_TICKS ";_TB(1,0)+_TB(1,1)
   Print #1,"OPAQUE_PASS0 FICON ";_TB(0,0);" BLIT ";_TB(1,0)
   Print #1,"OPAQUE_PASS1 FICON ";_TB(0,1);" BLIT ";_TB(1,1)
   Print #1,"BLIT_RUNS ";_BLIT_RUNS
   Print #1,"BLIT_STAGES ";_STAGES
   Print #1,"BLIT_CALLS ";_BLIT_CALLS
   Print #1,"OPAQUE_ICON_CALLS ";_OPAQUE_ICON_CALLS
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
