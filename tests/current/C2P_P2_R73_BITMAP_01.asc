' C2P/P2 R73 - read-only WinUAE bitmap diagnosis, 320x256x256.
' No C2P call and no bitmap write. Keep R73 LAST_GOOD unchanged.
' While WAIT KEY is active, run tools/c2p_p2_winuae_gdb.py on Windows.
' After the snapshot, press a normal key in the AGA window to close.
Print "C2P-P2-R73-BITMAP-01"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_SW=0
For _TRY=1 To 20
   If _SW=0
      _SW=Aga Swap
   End If
   If _SW=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
' The next call waits in the AGA extension with both buffers allocated.
_K=Aga Wait Key
Aga Screen Close
Amos To Front
_CF1=Chip Free
_RESULT=1
If _OPEN<>1 or _DB<>1 or _CF0<>_CF1
   _RESULT=0
End If
Cls
Print "C2P-P2-R73-BITMAP-01"
Print "OPEN/DB/SWAP ";_OPEN;" ";_DB;" ";_SW
Print "KEY ";_K
Print "CHIP BEFORE/AFTER ";_CF0;" ";_CF1
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
