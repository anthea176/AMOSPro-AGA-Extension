' M10-R25-RECT-OVERLAP-VISUAL-01 - SINGLE WinUAE TEST
' Requires R25 Lib and original AGA_TESTCARD_320x256_256C.iff.
' BLUE (palette 3) is stationary; moving 32x32 follows the mouse.
' GREEN (palette 28) = separated; RED (palette 224) = overlap.
' Move into and out of BLUE. LEFT click to finish after both states.
' Automatic end after 900 VBL. No THEN, all IF/END IF explicit.
Cls
Print "M10-R25-RECT-OVERLAP-VISUAL-01"
Print "Choose AGA_TESTCARD 320X256X8"
Print "BLUE fixed, GREEN free, RED overlap"
Print "MOVE mouse into BLUE and outside"
Print "LEFT click to finish after both colours"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8
   Print "NEED AGA TESTCARD 320X256X8"
   End
End If
' Pure AABB tests BEFORE any screen. Edge/corner touch is NO collision.
_S1=Aga Rect Overlap(20,20,100,80,20,20,100,80)
_S2=Aga Rect Overlap(20,20,100,80,120,20,5,5)
_S3=Aga Rect Overlap(20,20,100,80,119,20,5,5)
_S4=Aga Rect Overlap(20,20,100,80,20,100,5,5)
_S5=Aga Rect Overlap(20,20,100,80,20,99,5,5)
_S6=Aga Rect Overlap(20,20,100,80,120,100,5,5)
_S7=Aga Rect Overlap(20,20,100,80,119,99,5,5)
_S8=Aga Rect Overlap(20,20,0,80,20,20,10,10)
_S9=Aga Rect Overlap(20,20,100,80,20,20,0,10)
_S10=Aga Rect Overlap(-10,-10,20,20,0,0,5,5)
_S11=Aga Rect Overlap(-10,-10,10,10,0,0,5,5)
_S12=Aga Rect Overlap(20,20,100,80,40,40,10,10)
_S13=Aga Rect Overlap(40,40,10,10,20,20,100,80)
_S14=Aga Rect Overlap(20,20,-1,80,20,20,10,10)
_S15=Aga Rect Overlap(20,20,100,80,20,20,10,-1)
_STATIC=1
If _S1<>1 or _S2<>0 or _S3<>1 or _S4<>0 or _S5<>1
   _STATIC=0
End If
If _S6<>0 or _S7<>1 or _S8<>0 or _S9<>0
   _STATIC=0
End If
If _S10<>1 or _S11<>0 or _S12<>1 or _S13<>1
   _STATIC=0
End If
If _S14<>0 or _S15<>0
   _STATIC=0
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
_INIT=Aga Mouse Pressed
_FREESEEN=0
_HITSEEN=0
_DRAWERR=0
_DRAWN=0
_LASTHIT=0
Amos To Back
For _FRAME=1 To 900
   _MX=Aga Mouse X
   _MY=Aga Mouse Y
   If _MX<0
      _MX=0
   End If
   If _MY<0
      _MY=0
   End If
   _SX=_MX-16
   _SY=_MY-16
   If _SX<0
      _SX=0
   End If
   If _SY<0
      _SY=0
   End If
   If _SX>288
      _SX=288
   End If
   If _SY>224
      _SY=224
   End If
   _HIT=Aga Rect Overlap(100,70,120,100,_SX,_SY,32,32)
   _LASTHIT=_HIT
   If _HIT=1
      _PEN=224
      _HITSEEN=1
   Else
      _PEN=28
      _FREESEEN=1
   End If
   ' Redraw entire back buffer to prevent any trails.
   _CL=Aga Blit Clear(0,0,320,256)
   _FB=Aga Blit Fill(100,70,120,100,3)
   _FM=Aga Blit Fill(_SX,_SY,32,32,_PEN)
   _LED=Aga Blit Fill(8,8,16,16,_PEN)
   _SW=Aga Swap
   _DRAWN=_DRAWN+1
   If _CL<>1 or _FB<>1 or _FM<>1 or _LED<>1 or _SW<>1
      _DRAWERR=1
      _FRAME=900
   End If
   _P=Aga Mouse Pressed
   If _FREESEEN=1 and _HITSEEN=1
      If _P=1 or _P=3
         _FRAME=900
      End If
   End If
   Aga Wait Vbl
Next _FRAME
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_PRESS=Aga Mouse Pressed
' Stateless overlap must work without a screen.
_PURE=Aga Rect Overlap(100,70,120,100,120,90,32,32)
_REOPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _REOPEN=1
   _BASE=Aga Mouse Pressed
   Aga Screen Close
Else
   _BASE=-1
End If
_CLOSE2=Aga Mouse Pressed
Amos To Front
_RESULT=1
If _STATIC<>1 or _PURE<>1
   _RESULT=0
End If
If _FREESEEN<>1 or _HITSEEN<>1 or _DRAWERR<>0
   _RESULT=0
End If
If _OPEN<>1 or _DB<>1 or _LOAD<>1 or _DRAWN<2
   _RESULT=0
End If
If _CLOSED<>-1 or _PRESS<>-1 or _REOPEN<>1
   _RESULT=0
End If
If _BASE<>0 or _CLOSE2<>-1
   _RESULT=0
End If
Print "M10-R25-RECT-OVERLAP-VISUAL-01"
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
Print "STATIC ";_STATIC;" PURE ";_PURE
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD
Print "SEEN FREE ";_FREESEEN;" HIT ";_HITSEEN
Print "FRAMES ";_DRAWN;" DRAWERR ";_DRAWERR
Print "LAST HIT ";_LASTHIT
Print "CLOSED ";_CLOSED;" PRESS ";_PRESS
Print "REOPEN ";_REOPEN;" BASE ";_BASE;" CLOSE2 ";_CLOSE2
Print "RESULT ";_RESULT
Print "CLOSE X2 RETURNED"
End
