' M19 P2.4 - R87 BOBS: WINUAE PIXEL ORACLES AND 4/8/16 DRAW BENCH
' R87 removes the diagnostic native probe. Same pixels/Batch descriptor API.
' ONE active ASC. Old P2.3 must be archived byte-identically to passed.
' 1x1 v1 capture is decoded to a real indexed pixel; no cosmetic flags.
' Draw-only benchmark: 64 iterations, two reversed-order passes, no Swap.
Set Buffer 20
Cls
Print "M19 P2.4 R87 PIXELS + BOBS 4/8/16"
_RESULT=1 : _ERR=0 : _OPEN=0 : _CLOSED=0
_SOURCE_OK=0 : _ICON_OK=0 : _REJECT_OK=0
_PIXEL_OK=0 : _PIXEL_BAD=0 : _PIX_CAPTURE_BAD=0
_FIRST_BAD=0 : _FIRST_X=-1 : _FIRST_Y=-1
_FIRST_EXPECT=-1 : _FIRST_GOT=-1 : _FIRST_STAGE=0
_PARITY_OK=0 : _PARITY_BAD=0 : _PARITY_BYTES=0
_PARITY_FIRST=-1 : _PARITY_CASE=-1
_DRAW_ERR=0 : _SAFE_RETRY=0 : _SWAP_RETRY=0
_FRAMES=0 : _SWAPS=0 : _BENCH_RUNS=0
_BG=0 : _CLOSEOK=0 : _DRAWOK=0 : _CAPOK=0
_REPS=64 : _TOTAL_BASIC=0 : _TOTAL_BATCH=0
Dim _STAGE(5),_NOBJ(2),_BANKS(2),_TIMES(2,1,1)
Dim _OBANK(15),_OKIND(15),_OICON(15),_OX(15),_OY(15),_OMODE(15)
_NOBJ(0)=4 : _NOBJ(1)=8 : _NOBJ(2)=16
_BANKS(0)=24 : _BANKS(1)=25 : _BANKS(2)=26
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_P24_UNKNOWN.TXT"
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_P24_RUNTIME.TXT"
End If
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_P24_INTERPRETED.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_P24_COMPILED.TXT"
End If
_CPU$="UNKNOWN" : _FLAGS=0
_SYS=Leek(4)
If _SYS<>0
   _FLAGS=Deek(_SYS+296)
   _CPU$="68000"
   If (_FLAGS And 1)<>0
      _CPU$="68010"
   End If
   If (_FLAGS And 2)<>0
      _CPU$="68020"
   End If
   If (_FLAGS And 4)<>0
      _CPU$="68030"
   End If
   If (_FLAGS And 8)<>0
      _CPU$="68040"
   End If
   If (_FLAGS And 128)<>0
      _CPU$="68060"
   End If
End If
If Aga Detect=0
   _ERR=1 : Goto CLEANUP
End If
For _B=10 To 28
   If Length(_B)<>0
      _ERR=3 : Goto CLEANUP
   End If
Next _B
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto CLEANUP
End If
If Aga Double Buffer<>1
   _ERR=5 : Goto CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,24,32,48)
_P3=Aga Palette Set(3,240,65,45)
_P4=Aga Palette Set(4,35,205,230)
_P5=Aga Palette Set(5,250,215,70)
If _P0<>1 or _P1<>1 or _P3<>1 or _P4<>1 or _P5<>1
   _ERR=6 : Goto CLEANUP
End If
' Fill both buffers in pen 1 for the later front-buffer isolation probe.
_BGCOLOUR=1 : Gosub FILL_BG
If _BG<>1
   _ERR=7 : Goto CLEANUP
End If
Gosub SWAP_ONCE
If _SW<>1
   _ERR=8 : Goto CLEANUP
End If
_BGCOLOUR=1 : Gosub FILL_BG
If _BG<>1
   _ERR=9 : Goto CLEANUP
End If
' Create native AGAPIC v1/v2 images: 40x40, 24x24 coloured square.
For _I=0 To 1
   _V=1+_I : _B=12+_I : _COLOUR=3+_I
   _BGCOLOUR=0 : Gosub FILL_BG
   If _BG<>1
      _ERR=10 : Goto CLEANUP
   End If
   _D=Aga Blit Fill(8,8,24,24,_COLOUR)
   If _D<>1
      _ERR=11 : Goto CLEANUP
   End If
   _D=Aga Bank Image Capture(_B,0,0,40,40,0,_V)
   If _D<>1
      _ERR=12 : Goto CLEANUP
   End If
   If Aga Bank Image Info(_B,1)<>40 or Aga Bank Image Info(_B,2)<>40
      _ERR=13 : Goto CLEANUP
   End If
   If Aga Bank Image Info(_B,3)<>8
      _ERR=14 : Goto CLEANUP
   End If
   _SOURCE_OK=_SOURCE_OK+1
Next _I
' Create one FICON8 sprite (index 0 border transparent, inside index 5).
Reserve As Data 10,256
_D=Aga F Icon Bank Create(11,4)
If _D<>1
   _ERR=15 : Goto CLEANUP
End If
For _Y=0 To 15
   For _X=0 To 15
      _C=5
      If _X=0 or _Y=0 or _X=15 or _Y=15
         _C=0
      End If
      Poke Start(10)+_Y*16+_X,_C
   Next _X
Next _Y
_D=Aga F Icon Bank Put(11,2,10,0)
If _D<>1
   _ERR=16 : Goto CLEANUP
End If
_ICON_OK=1
' BOB1 3 descriptors, order v1 -> FICON -> v2; on-screen (100,100).
Reserve As Data 20,76
_DP=Start(20)
Loke _DP,$424F4231 : Doke _DP+4,1 : Doke _DP+6,20
Loke _DP+8,3 : Loke _DP+12,0
Loke _DP+16,100 : Loke _DP+20,100 : Loke _DP+24,12
Loke _DP+28,0 : Doke _DP+32,1 : Doke _DP+34,1
Loke _DP+36,105 : Loke _DP+40,105 : Loke _DP+44,11
Loke _DP+48,2 : Doke _DP+52,2 : Doke _DP+54,1
Loke _DP+56,108 : Loke _DP+60,108 : Loke _DP+64,13
Loke _DP+68,0 : Doke _DP+72,1 : Doke _DP+74,1
' Check invalid calls do not return success.
If Aga Bob Batch(20,0)<>0
   _ERR=17 : Goto CLEANUP
End If
_REJECT_OK=_REJECT_OK+1
If Aga Bob Batch(21,3)<>0
   _ERR=18 : Goto CLEANUP
End If
_REJECT_OK=_REJECT_OK+1
Doke _DP+52,3
If Aga Bob Batch(20,3)<>0
   _ERR=19 : Goto CLEANUP
End If
_REJECT_OK=_REJECT_OK+1
Doke _DP+52,2
' Stage 1: verify exact top/lower/border pixels by 1x1 AGAPIC decoding.
_BGCOLOUR=1 : Gosub FILL_BG
If _BG<>1
   _ERR=20 : Goto CLEANUP
End If
_D=Aga Bob Batch(20,3)
If _D<>1
   _ERR=21 : Goto CLEANUP
End If
_STAGE_ID=1
_PX=116 : _PY=116 : _WANT=4 : Gosub CHECK_PIXEL
_PX=110 : _PY=110 : _WANT=5 : Gosub CHECK_PIXEL
_PX=100 : _PY=100 : _WANT=1 : Gosub CHECK_PIXEL
_PX=130 : _PY=130 : _WANT=4 : Gosub CHECK_PIXEL
If _PIXEL_BAD<>0
   _ERR=22 : Goto CLEANUP
End If
' Stage 2: opaque v2 must OVERWRITE with index 0; masked keeps icon 5.
Doke _DP+74,0
_BGCOLOUR=1 : Gosub FILL_BG
If _BG<>1
   _ERR=23 : Goto CLEANUP
End If
_D=Aga Bob Batch(20,3)
If _D<>1
   _ERR=24 : Goto CLEANUP
End If
_STAGE_ID=2
_PX=110 : _PY=110 : _WANT=0 : Gosub CHECK_PIXEL
_PX=116 : _PY=116 : _WANT=4 : Gosub CHECK_PIXEL
If _PIXEL_BAD<>0
   _ERR=25 : Goto CLEANUP
End If
Doke _DP+74,1
' Stage 3: opaque FICON8 border index 0 vs interior index 5.
Doke _DP+54,0
_BGCOLOUR=1 : Gosub FILL_BG
If _BG<>1
   _ERR=26 : Goto CLEANUP
End If
_D=Aga Bob Batch(20,3)
If _D<>1
   _ERR=27 : Goto CLEANUP
End If
_STAGE_ID=3
_PX=105 : _PY=105 : _WANT=0 : Gosub CHECK_PIXEL
_PX=106 : _PY=106 : _WANT=5 : Gosub CHECK_PIXEL
If _PIXEL_BAD<>0
   _ERR=28 : Goto CLEANUP
End If
Doke _DP+54,1
' Stage 4: explicitly invert Z order, keeping exact same positions/sources.
Loke _DP+36,108 : Loke _DP+40,108 : Loke _DP+44,13
Loke _DP+48,0 : Doke _DP+52,1 : Doke _DP+54,1
Loke _DP+56,105 : Loke _DP+60,105 : Loke _DP+64,11
Loke _DP+68,2 : Doke _DP+72,2 : Doke _DP+74,1
_BGCOLOUR=1 : Gosub FILL_BG
If _BG<>1
   _ERR=29 : Goto CLEANUP
End If
_D=Aga Bob Batch(20,3)
If _D<>1
   _ERR=30 : Goto CLEANUP
End If
_STAGE_ID=4
_PX=116 : _PY=116 : _WANT=5 : Gosub CHECK_PIXEL
_PX=110 : _PY=110 : _WANT=5 : Gosub CHECK_PIXEL
If _PIXEL_BAD<>0
   _ERR=31 : Goto CLEANUP
End If
' Restore v1/icon/v2 descriptors exactly.
Loke _DP+36,105 : Loke _DP+40,105 : Loke _DP+44,11
Loke _DP+48,2 : Doke _DP+52,2 : Doke _DP+54,1
Loke _DP+56,108 : Loke _DP+60,108 : Loke _DP+64,13
Loke _DP+68,0 : Doke _DP+72,1 : Doke _DP+74,1
' Stage 5a: FICON clipping at negative signed X/Y.
Loke _DP+36,-8 : Loke _DP+40,-8
_BGCOLOUR=1 : Gosub FILL_BG
If _BG<>1
   _ERR=32 : Goto CLEANUP
End If
_D=Aga Bob Batch(20,3)
If _D<>1
   _ERR=33 : Goto CLEANUP
End If
_STAGE_ID=5
_PX=0 : _PY=0 : _WANT=5 : Gosub CHECK_PIXEL
_PX=7 : _PY=7 : _WANT=1 : Gosub CHECK_PIXEL
If _PIXEL_BAD<>0
   _ERR=34 : Goto CLEANUP
End If
' Stage 5b: FICON clipping near right/bottom border.
Loke _DP+36,250 : Loke _DP+40,315
_BGCOLOUR=1 : Gosub FILL_BG
If _BG<>1
   _ERR=35 : Goto CLEANUP
End If
_D=Aga Bob Batch(20,3)
If _D<>1
   _ERR=36 : Goto CLEANUP
End If
_PX=319 : _PY=255 : _WANT=5 : Gosub CHECK_PIXEL
_PX=315 : _PY=250 : _WANT=1 : Gosub CHECK_PIXEL
If _PIXEL_BAD<>0
   _ERR=37 : Goto CLEANUP
End If
' Stage 5c: AGAPIC v1 and v2 with signed clipping.
Loke _DP+16,-8 : Loke _DP+20,-8
Loke _DP+36,105 : Loke _DP+40,105
Loke _DP+56,240 : Loke _DP+60,300
_BGCOLOUR=1 : Gosub FILL_BG
If _BG<>1
   _ERR=38 : Goto CLEANUP
End If
_D=Aga Bob Batch(20,3)
If _D<>1
   _ERR=39 : Goto CLEANUP
End If
_PX=0 : _PY=0 : _WANT=3 : Gosub CHECK_PIXEL
_PX=25 : _PY=25 : _WANT=1 : Gosub CHECK_PIXEL
_PX=319 : _PY=255 : _WANT=4 : Gosub CHECK_PIXEL
_PX=300 : _PY=240 : _WANT=1 : Gosub CHECK_PIXEL
If _PIXEL_BAD<>0
   _ERR=40 : Goto CLEANUP
End If
' Front-buffer check: first explicit swap, former front must still be pen 1.
Gosub SWAP_ONCE
If _SW<>1
   _ERR=41 : Goto CLEANUP
End If
_STAGE_ID=5
_PX=116 : _PY=116 : _WANT=1 : Gosub CHECK_PIXEL
If _PIXEL_BAD<>0
   _ERR=42 : Goto CLEANUP
End If
' The only two swaps were explicit in the BASIC test, not inside Batch.
' Build three immutable BOB1 lists for draw-only 4,8,16 comparisons.
Reserve As Data 24,96
Reserve As Data 25,176
Reserve As Data 26,336
For _I=0 To 15
   _OX(_I)=20+(_I Mod 4)*28
   _OY(_I)=20+Int(_I/4)*24
   _OMODE(_I)=1 : _OICON(_I)=0
   _T=_I Mod 3
   _OBANK(_I)=12 : _OKIND(_I)=1
   If _T=1
      _OBANK(_I)=13
   End If
   If _T=2
      _OBANK(_I)=11 : _OKIND(_I)=2 : _OICON(_I)=2
   End If
Next _I
For _CASE=0 To 2
   _N=_NOBJ(_CASE) : _BN=_BANKS(_CASE) : _P=Start(_BN)
   Loke _P,$424F4231 : Doke _P+4,1 : Doke _P+6,20
   Loke _P+8,_N : Loke _P+12,0
   For _I=0 To _N-1
      _R=_P+16+20*_I
      Loke _R,_OY(_I) : Loke _R+4,_OX(_I)
      Loke _R+8,_OBANK(_I) : Loke _R+12,_OICON(_I)
      Doke _R+16,_OKIND(_I) : Doke _R+18,_OMODE(_I)
   Next _I
Next _CASE
' Full 144x144 pixel equivalence in v1 captured canonical RLE, for 4/8/16.
' Comparison uses separate output banks, not the renderer's return flags.
For _CASE=0 To 2
   _N=_NOBJ(_CASE) : _BN=_BANKS(_CASE)
   _BGCOLOUR=1 : Gosub FILL_BG
   If _BG<>1
      _ERR=43 : Goto CLEANUP
   End If
   Gosub DRAW_BASIC
   If _DRAWOK<>1
      _ERR=44 : Goto CLEANUP
   End If
   _D=Aga Bank Image Capture(27,0,0,144,144,-1,1)
   If _D<>1
      _ERR=45 : Goto CLEANUP
   End If
   _BGCOLOUR=1 : Gosub FILL_BG
   If _BG<>1
      _ERR=46 : Goto CLEANUP
   End If
   _D=Aga Bob Batch(_BN,_N)
   If _D<>1
      _ERR=47 : Goto CLEANUP
   End If
   _D=Aga Bank Image Capture(28,0,0,144,144,-1,1)
   If _D<>1
      _ERR=48 : Goto CLEANUP
   End If
   _S27=Start(27) : _S28=Start(28)
   _LEN=Leek(_S27+28) : _LEN2=Leek(_S28+28)
   If _LEN<=40 or _LEN<>_LEN2 or Length(27)<>Length(28)
      _ERR=49 : Goto CLEANUP
   End If
   _DIFFS=0
   For _J=0 To _LEN-1
      If Peek(_S27+_J)<>Peek(_S28+_J)
         _DIFFS=_DIFFS+1
         If _PARITY_FIRST=-1
            _PARITY_FIRST=_J : _PARITY_CASE=_N
         End If
      End If
   Next _J
   If _DIFFS<>0
      _PARITY_BAD=_PARITY_BAD+_DIFFS
      _ERR=50 : Goto CLEANUP
   End If
   _PARITY_BYTES=_PARITY_BYTES+_LEN
   _PARITY_OK=_PARITY_OK+1
   Erase 27 : Erase 28
Next _CASE
' Benchmark: 64 repeated draw-only frames, BASIC/Batch in AB then BA order.
' Fill outside timer; no Swap, Wait VBL, Z-sort, capture or allocation inside.
For _PASS=0 To 1
   For _CASE=0 To 2
      _N=_NOBJ(_CASE) : _BN=_BANKS(_CASE)
      For _ORD=0 To 1
         _BM=_ORD
         If _PASS=1
            _BM=1-_ORD
         End If
         _BGCOLOUR=1 : Gosub FILL_BG
         If _BG<>1
            _ERR=51 : Goto CLEANUP
         End If
         _T0=Timer
         For _ITER=1 To _REPS
            If _BM=0
               Gosub DRAW_BASIC
               _D=_DRAWOK
            Else
               _D=Aga Bob Batch(_BN,_N)
            End If
            If _D<>1
               _DRAW_ERR=_DRAW_ERR+1
               _ERR=52 : Goto CLEANUP
            End If
         Next _ITER
         _TIMES(_CASE,_BM,_PASS)=Timer-_T0
         If _TIMES(_CASE,_BM,_PASS)<=0
            _ERR=53 : Goto CLEANUP
         End If
         _BENCH_RUNS=_BENCH_RUNS+1
         _FRAMES=_FRAMES+_REPS
      Next _ORD
   Next _CASE
Next _PASS
For _CASE=0 To 2
   _TB=_TIMES(_CASE,0,0)+_TIMES(_CASE,0,1)
   _TN=_TIMES(_CASE,1,0)+_TIMES(_CASE,1,1)
   _TOTAL_BASIC=_TOTAL_BASIC+_TB
   _TOTAL_BATCH=_TOTAL_BATCH+_TN
Next _CASE
If _PIXEL_BAD<>0 or _PARITY_OK<>3 or _BENCH_RUNS<>12
   _ERR=54 : Goto CLEANUP
End If
If _PIXEL_OK<>19 or _SWAPS<>2 or _SOURCE_OK<>2
   _ERR=55 : Goto CLEANUP
End If
Goto CLEANUP

CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSEOK=1
End If
Amos To Front
If _ERR<>3
   For _B=10 To 28
      If Length(_B)<>0
         Erase _B
      End If
   Next _B
End If
If _ERR=0 and _CLOSEOK<>1
   _ERR=56
End If
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "M19 P2.4 ";_VERDICT$;" ERR ";_ERR
Print "PIXELS ";_PIXEL_OK;" BAD ";_PIXEL_BAD;" PARITY ";_PARITY_OK
Print "BASIC TICKS ";_TOTAL_BASIC;" BATCH ";_TOTAL_BATCH
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P24_BOBS_PIXELS_BENCH_01"
   Print #1,"LIBRARY_EXPECTED R87_V0.13.32"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"CPU ";_CPU$
   Print #1,"CPU_ATTNFLAGS ";_FLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"SOURCE_OK ";_SOURCE_OK
   Print #1,"ICON_OK ";_ICON_OK
   Print #1,"REJECT_OK ";_REJECT_OK
   Print #1,"PIXEL_OK ";_PIXEL_OK
   Print #1,"PIXEL_BAD ";_PIXEL_BAD
   Print #1,"PIX_CAPTURE_BAD ";_PIX_CAPTURE_BAD
   Print #1,"PIX_FIRST_STAGE ";_FIRST_STAGE
   Print #1,"PIX_FIRST_X ";_FIRST_X
   Print #1,"PIX_FIRST_Y ";_FIRST_Y
   Print #1,"PIX_FIRST_WANT ";_FIRST_EXPECT
   Print #1,"PIX_FIRST_GOT ";_FIRST_GOT
   For _S=1 To 5
      Print #1,"PIX_STAGE ";_S;" OK ";_STAGE(_S)
   Next _S
   Print #1,"PARITY_OK ";_PARITY_OK
   Print #1,"PARITY_BAD ";_PARITY_BAD
   Print #1,"PARITY_BYTES ";_PARITY_BYTES
   Print #1,"PARITY_FIRST_OFFSET ";_PARITY_FIRST
   Print #1,"PARITY_FIRST_CASE ";_PARITY_CASE
   Print #1,"BENCH_REPS ";_REPS
   Print #1,"BENCH_RUNS ";_BENCH_RUNS
   Print #1,"BENCH_FRAMES ";_FRAMES
   For _CASE=0 To 2
      _TB=_TIMES(_CASE,0,0)+_TIMES(_CASE,0,1)
      _TN=_TIMES(_CASE,1,0)+_TIMES(_CASE,1,1)
      Print #1,"BENCH_BOBS ";_NOBJ(_CASE);" BASIC_TICKS ";_TB;" BATCH_TICKS ";_TN;" SAVED_TICKS ";_TB-_TN
      Print #1,"PASS0_BOBS ";_NOBJ(_CASE);" BASIC ";_TIMES(_CASE,0,0);" BATCH ";_TIMES(_CASE,1,0)
      Print #1,"PASS1_BOBS ";_NOBJ(_CASE);" BASIC ";_TIMES(_CASE,0,1);" BATCH ";_TIMES(_CASE,1,1)
   Next _CASE
   Print #1,"TOTAL_BASIC_TICKS ";_TOTAL_BASIC
   Print #1,"TOTAL_BATCH_TICKS ";_TOTAL_BATCH
   Print #1,"DRAW_ERR ";_DRAW_ERR
   Print #1,"SAFE_RETRY ";_SAFE_RETRY
   Print #1,"SWAP_RETRY ";_SWAP_RETRY
   Print #1,"SWAPS ";_SWAPS
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"CLOSE_RETURNED ";_CLOSEOK
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End

FILL_BG:
_BG=0
For _TRY=1 To 12
   If _BG=0
      _BG=Aga Blit Fill(0,0,320,256,_BGCOLOUR)
   End If
   If _BG=0
      _SAFE_RETRY=_SAFE_RETRY+1
      Aga Wait Vbl
   End If
Next _TRY
Return

SWAP_ONCE:
_SW=0
For _TRY=1 To 12
   If _SW=0
      _SW=Aga Swap
   End If
   If _SW=0
      _SWAP_RETRY=_SWAP_RETRY+1
      Aga Wait Vbl
   End If
Next _TRY
If _SW=1
   _SWAPS=_SWAPS+1
End If
Return

DRAW_BASIC:
_DRAWOK=1
For _I=0 To _N-1
   If _OKIND(_I)=1
      _D=Aga Bank Image Draw(_OBANK(_I),_OX(_I),_OY(_I),_OMODE(_I))
   Else
      _D=Aga F Icon(_OBANK(_I),_OICON(_I),_OX(_I),_OY(_I),_OMODE(_I))
   End If
   If _D<>1
      _DRAWOK=0
      Return
   End If
Next _I
Return

CHECK_PIXEL:
' Native 1x1 AGAPIC v1 capture, independent decoder of 8 plane bits.
_GOT=-1 : _PIXCAP=0 : _PIXERR=0
For _TRY=1 To 12
   If _PIXCAP=0
      If Length(23)<>0
         Erase 23
      End If
      _PIXCAP=Aga Bank Image Capture(23,_PX,_PY,1,1,-1,1)
   End If
   If _PIXCAP=0
      _SAFE_RETRY=_SAFE_RETRY+1
      Aga Wait Vbl
   End If
Next _TRY
If _PIXCAP=1
   _PP=Start(23) : _STREAM=Leek(_PP+24)
   _END=Leek(_PP+28)
   If Deek(_PP+6)<>1 or Deek(_PP+12)<>1 or Deek(_PP+14)<>1
      _PIXERR=1
   End If
   If Deek(_PP+16)<>8 or _STREAM<40 or _STREAM+17<>_END
      _PIXERR=1
   End If
   If _PIXERR=0
      If Peek(_PP+_STREAM)<>0
         _PIXERR=1
      Else
         _GOT=0 : _WEIGHT=1
         For _PL=0 To 7
            If (Peek(_PP+_STREAM+1+2*_PL) And 128)<>0
               _GOT=_GOT+_WEIGHT
            End If
            _WEIGHT=_WEIGHT*2
         Next _PL
      End If
   End If
Else
   _PIXERR=1
End If
If _PIXERR<>0
   _PIX_CAPTURE_BAD=_PIX_CAPTURE_BAD+1
End If
If _GOT<>_WANT or _PIXERR<>0
   _PIXEL_BAD=_PIXEL_BAD+1
   If _FIRST_BAD=0
      _FIRST_BAD=1
      _FIRST_X=_PX : _FIRST_Y=_PY
      _FIRST_EXPECT=_WANT : _FIRST_GOT=_GOT
      _FIRST_STAGE=_STAGE_ID
   End If
Else
   _PIXEL_OK=_PIXEL_OK+1
   _STAGE(_STAGE_ID)=_STAGE(_STAGE_ID)+1
End If
Return
