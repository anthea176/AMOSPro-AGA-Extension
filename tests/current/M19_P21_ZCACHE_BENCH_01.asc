   Print #1,"N16_P1_CACHE_COMP_SAFE_RETRIES ";_SAFEC(2,1,1)
   Print #1,"N16_P1_CACHE_DISP_SWAP_RETRIES ";_SWCASE(2,1,1)
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"CHIP_DELTA ";_CHIP1-_CHIP0
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"FAST_DELTA ";_FAST1-_FAST0
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
Print "CLOSE RETURNED"
End

' Same object order for both modes. Cache invalidated by Z or visibility.
_GET_ORDER:
If _BMODE=0
   Gosub _SORT_OBJECTS
Else
   If _CACHE_DIRTY=1 or _CACHE_N<>_ACTIVE
      Gosub _SORT_OBJECTS
      _CACHE_DIRTY=0 : _CACHE_N=_ACTIVE
      _CACHE_BUILDS=_CACHE_BUILDS+1
   Else
      _CACHE_HITS=_CACHE_HITS+1
   End If
End If
Return

' Reuse validated P2.0 ordering: descending Z, stable ID tie.
_SORT_OBJECTS:
_SORTS=_SORTS+1
_COUNT=0
For _I=1 To _ACTIVE
   If _ALIVE(_I)=1 and _VISIBLE(_I)=1
      _COUNT=_COUNT+1
      _ORDER(_COUNT)=_I
   End If
Next _I
If _COUNT>=2
   For _SI=1 To _COUNT-1
      For _SJ=_SI+1 To _COUNT
         _A=_ORDER(_SI) : _B=_ORDER(_SJ)
         If _OZ(_A)>_OZ(_B) or (_OZ(_A)=_OZ(_B) and _A>_B)
            _ORDER(_SI)=_B : _ORDER(_SJ)=_A
         End If
      Next _SJ
   Next _SI
End If
Return

' Back buffer only, full background and all objects. No implicit Swap.
_DRAW_FRAME:
_ROK=0
_BG=0
For _TRY=1 To 12
   If _BG=0
      _BG=Aga Blit Fill(0,0,320,256,1)
   End If
   If _BG=0
      _SAFERETRY=_SAFERETRY+1
      Aga Wait Vbl
   End If
Next _TRY
If _BG<>1
   Return
End If
Gosub _GET_ORDER
If _COUNT<>_ACTIVE
   Return
End If
For _DRAW=1 To _COUNT
   _ID=_ORDER(_DRAW)
   _PX=_OX(_ID)+((_RUN+_ID) Mod 5)-_HX(_ID)
   _PY=_OY(_ID)+((_RUN+_ID*3) Mod 5)-_HY(_ID)
   _SOURCE=_BN1(_ID) : _ICONID=_IC1(_ID)
   If Length(_SOURCE)=0
      Return
   End If
   If _TYPE(_ID)=1
      _OK=Aga Bank Image Draw(_SOURCE,_PX,_PY,_OMODE(_ID))
   Else
      _OK=Aga F Icon(_SOURCE,_ICONID,_PX,_PY,_OMODE(_ID))
   End If
   If _OK<>1
      Return
   End If
   _DRAWS=_DRAWS+1
Next _DRAW
_ROK=1
Return
