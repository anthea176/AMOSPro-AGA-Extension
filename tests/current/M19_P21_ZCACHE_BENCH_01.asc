   Print #1,"N8_P1_BASE_DISP_SWAP_RETRIES ";_SWCASE(1,0,1)
   Print #1,"N8_P1_CACHE_SORT_TICKS ";_TM(0,1,1,1)
   Print #1,"N8_P1_CACHE_SORT_SORT_CALLS ";_SC(0,1,1,1)
   Print #1,"N8_P1_CACHE_COMP_TICKS ";_TM(1,1,1,1)
   Print #1,"N8_P1_CACHE_COMP_SORT_CALLS ";_SC(1,1,1,1)
   Print #1,"N8_P1_CACHE_DISP_TICKS ";_TM(2,1,1,1)
   Print #1,"N8_P1_CACHE_DISP_SORT_CALLS ";_SC(2,1,1,1)
   Print #1,"N8_P1_CACHE_COMP_DRAWS ";_DRAWCASE(1,1,1)
   Print #1,"N8_P1_CACHE_COMP_SAFE_RETRIES ";_SAFEC(1,1,1)
   Print #1,"N8_P1_CACHE_DISP_SWAP_RETRIES ";_SWCASE(1,1,1)
   Print #1,"N16_P1_BASE_SORT_TICKS ";_TM(0,2,0,1)
