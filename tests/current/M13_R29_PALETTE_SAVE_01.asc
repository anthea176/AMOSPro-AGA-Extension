' M13-R29-PALETTE-SAVE-01: save, overwrite and reload palette-only IFF.
' Needs R29 0.10.1 in APSystem, not R28 LAST_GOOD.
' Writes RAM:M13_R29_PALETTE_TEST.IFF (replaces existing file).
' No pixel BODY is saved; only BMHD and RGB24 CMAP.
Cls
Print "M13-R29-PALETTE-SAVE-01"
_FILE$="RAM:M13_R29_PALETTE_TEST.IFF"
_W=320
_H=256
_D=8
_MODE=$00021000
_OPEN=Aga Screen Open(_W,_H,256,_MODE)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_CLR=Aga Blit Clear(0,0,320,256)
_PANEL=Aga Blit Fill(25,70,270,116,28)
_BAR=Aga Blit Fill(25,192,270,14,224)
_TITLE=Aga Text(35,44,28,"M13 R29 SAVE IFF")
_P0=Aga Palette Set(0,0,0,0)
_P3=Aga Palette Set(3,0,0,128)
_P28=Aga Palette Set(28,0,255,0)
_P224=Aga Palette Set(224,12,34,56)
_BEFORE=Aga Palette Get(28)
' Save GREEN palette first.
_SAVE1=Aga Palette Save(_FILE$)
' Change palette and overwrite the exact same file with RED.
_PRED=Aga Palette Set(28,255,0,0)
_SAVE2=Aga Palette Save(_FILE$)
' Clear active RGB color, then reload from our saved IFF without BODY.
_PBLACK=Aga Palette Set(28,0,0,0)
_BLACK=Aga Palette Get(28)
_LOAD=Aga Palette Load(_FILE$)
_AFTER=Aga Palette Get(28)
_OTHER=Aga Palette Get(224)
_BLUE=Aga Palette Get(3)
_SWAP=Aga Swap
Amos To Back
For _I=1 To 100
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _CLR<>1 or _PANEL<>1 or _BAR<>1 or _TITLE<>1
   _RESULT=0
End If
If _P0<>1 or _P3<>1 or _P28<>1 or _P224<>1 or _PRED<>1 or _PBLACK<>1
   _RESULT=0
End If
If _SAVE1<>1 or _SAVE2<>1 or _LOAD<>1 or _SWAP<>1
   _RESULT=0
End If
If _BEFORE<>$00FF00 or _BLACK<>0 or _AFTER<>$FF0000
   _RESULT=0
End If
If _OTHER<>$0C2238 or _BLUE<>$000080
   _RESULT=0
End If
If _CLOSED<>-1
   _RESULT=0
End If
Print "M13-R29-PALETTE-SAVE-01"
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
Print "OPEN ";_OPEN;" DB ";_DB
Print "DRAW ";_CLR;" ";_PANEL;" ";_BAR;" ";_TITLE
Print "SAVE1 ";_SAVE1;" SAVE2 ";_SAVE2;" LOAD ";_LOAD
Print "BEFORE ";_BEFORE;" BLACK ";_BLACK;" AFTER ";_AFTER
Print "OTHER ";_OTHER;" BLUE ";_BLUE;" SWAP ";_SWAP
Print "CLOSED ";_CLOSED;" RESULT ";_RESULT
Print "CLOSE RETURNED"
End
