' M19 P2e.0 - original AMAL memory output to one AGA Bob
' Experimental WinUAE probe; no native AGA API changes
Set Buffer 20
Cls
_PRG=Prg State : _OPEN=0 : _ERR=0 : _OK=0
_AMAL_ON=0 : _SYNCHRO_OFF=0 : _CLOSE_RETURNED=0
_VALID=0 : _SWAPS=0 : _PIX_SAMPLES=0 : _FLAG_X=0 : _FLAG_Y=0 : _FLAG_A=0
_MOVE_X=0 : _MOVE_Y=0 : _IMAGE1=0 : _IMAGE2=0
_CHG_X=0 : _CHG_Y=0 : _CHG_A=0 : _OLD_VALID=0
_OLD_X=0 : _OLD_Y=0 : _OLD_A=0
_X=0 : _Y=0 : _IMAGE=0 : _FLAGS=0 : _FRAME=0
_VALUE=-1 : _EXPECTED=-1 : _PROBE_EXPECTED=-1
_BG0=0 : _BG1=0
_PREV_VALID=0 : _PREV_X=0 : _PREV_Y=0 : _PREV_EXPECTED=0
_LOG$="RAM:M19_P2E0_AMAL_BRIDGE.TXT"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(24)<>0 or Length(27)<>0 or Length(28)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
' Two opaque 1x1 images in one real AGBO bank.
_A=Aga Blit Fill(16,16,1,1,165)
_B=Aga Blit Fill(18,16,1,1,90)
If _A<>1 or _B<>1
   _ERR=5 : Goto _CLEANUP
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,16,16
Get AGA Bob 2,18,16,18,16
If Length(24)<=32
   _ERR=6 : Goto _CLEANUP
End If
_A=Aga Blit Fill(16,16,3,1,0)
If _A<>1
   _ERR=7 : Goto _CLEANUP
End If
' Pre-allocate the pixel probe bank before the first Bob SET.
_PROBE=Aga C Block Capture(27,96,100,8,1,0)
If _PROBE<>1 or Length(27)<>56
   _ERR=8 : Goto _CLEANUP
End If
' AMAL To Address requires an even writable address and eight bytes.
Reserve As Data 28,8
If Length(28)<>8
   _ERR=9 : Goto _CLEANUP
End If
_ADDR=Start(28)
If (_ADDR and 1)<>0
   _ERR=10 : Goto _CLEANUP
End If
For _W=0 To 3
   Doke _ADDR+_W*2,0
Next _W
' Prepare the first physical background BEFORE enabling Auto Update.
_BG0=Aga Blit Fill(96,100,48,32,0)
If _BG0<>1
   _ERR=22 : Goto _CLEANUP
End If
_MODE=Aga Bob Auto Update(1)
If _MODE<>1
   _ERR=11 : Goto _CLEANUP
End If
' Prime the second physical page while there is no active Bob.
_SWAP=Aga Swap
If _SWAP<>1
   _ERR=12 : Goto _CLEANUP
End If
_SWAPS=_SWAPS+1
Aga Wait Vbl
' Match the P2d PASS setup: initialize the OTHER physical back.
' The private Bob back selector refuses a still-pending Safe page.
_BG1=Aga Blit Fill(96,100,48,32,0)
If _BG1<>1
   _ERR=23 : Goto _CLEANUP
End If
' Synchronous AMAL only: no OCS Channel To Bob and no AMAL interrupts.
_SYNCHRO_OFF=1
Synchro Off
_AMAL$="Let X=96; Let Y=100; Let A=1; Loop: Move 32,16,32; Let A=2;"
_AMAL$=_AMAL$+"Move -32,-16,32; Let A=1; Jump Loop"
Amal 0,_AMAL$ To _ADDR
Amal On 0
_AMAL_ON=1
Aga Bob Bank 24
For _FRAME=1 To 240
   Synchro
   _FLAGS=Deek(_ADDR)
   _X=Deek(_ADDR+2) : _Y=Deek(_ADDR+4) : _IMAGE=Deek(_ADDR+6)
   If _X>=32768
      _X=_X-65536
   End If
   If _Y>=32768
      _Y=_Y-65536
   End If
   If (_FLAGS and 1)<>0
      _FLAG_X=_FLAG_X+1
   End If
   If (_FLAGS and 2)<>0
      _FLAG_Y=_FLAG_Y+1
   End If
   If (_FLAGS and 4)<>0
      _FLAG_A=_FLAG_A+1
   End If
   ' Zeroed memory is allowed until AMAL produces its first complete state.
   If _IMAGE=1 or _IMAGE=2
      If _X<96 or _X>128 or _Y<100 or _Y>116
         _ERR=13 : Goto _CLEANUP
      End If
      ' Actual channel changes: reliable even if flag word stays zero.
      If _OLD_VALID=1
         If _X<>_OLD_X
            _CHG_X=_CHG_X+1
         End If
         If _Y<>_OLD_Y
            _CHG_Y=_CHG_Y+1
         End If
         If _IMAGE<>_OLD_A
            _CHG_A=_CHG_A+1
         End If
      End If
      _OLD_X=_X : _OLD_Y=_Y : _OLD_A=_IMAGE : _OLD_VALID=1
      If _VALID=0
         _FIRST_X=_X : _FIRST_Y=_Y
      End If
      If _X<>_FIRST_X
         _MOVE_X=1
      End If
      If _Y<>_FIRST_Y
         _MOVE_Y=1
      End If
      If _IMAGE=1
         _IMAGE1=1 : _EXPECTED=165
      Else
         _IMAGE2=1 : _EXPECTED=90
      End If
      Aga Bob 1,_X,_Y,_IMAGE
      _BX=Aga X Bob(1) : _BY=Aga Y Bob(1) : _BI=Aga I Bob(1)
      If _BX<>_X or _BY<>_Y or _BI<>_IMAGE
         _ERR=14 : Goto _CLEANUP
      End If
      _SWAP=Aga Swap
      If _SWAP<>1
         _ERR=15 : Goto _CLEANUP
      End If
      _SWAPS=_SWAPS+1
      Aga Wait Vbl
      ' After Swap the old front is the new back for C Block Capture.
      ' Check the LAST presented Bob, not the one now in front.
      If _PREV_VALID=1
         If (_PREV_X and 7)=0
            _CAP=Aga C Block Capture(27,_PREV_X,_PREV_Y,8,1,0)
            If _CAP<>1 or Length(27)<>56
               _ERR=16 : Goto _CLEANUP
            End If
            _PROBE_EXPECTED=_PREV_EXPECTED
            _PTR=Start(27)+40 : _VALUE=0 : _POWER=1
            For _PLANE=0 To 7
               If (Peek(_PTR+2*_PLANE) and 128)<>0
                  _VALUE=_VALUE+_POWER
               End If
               _POWER=_POWER*2
            Next _PLANE
            If _VALUE<>_PROBE_EXPECTED
               _ERR=17 : Goto _CLEANUP
            End If
            _PIX_SAMPLES=_PIX_SAMPLES+1
         End If
      End If
      _PREV_VALID=1 : _PREV_X=_X : _PREV_Y=_Y
      _PREV_EXPECTED=_EXPECTED
      _VALID=_VALID+1
   Else
      If _VALID<>0
         _ERR=18 : Goto _CLEANUP
      End If
   End If
Next _FRAME
If _VALID<32 or _PIX_SAMPLES<2
   _ERR=19
End If
If _MOVE_X<>1 or _MOVE_Y<>1 or _IMAGE1<>1 or _IMAGE2<>1
   _ERR=20
End If
' AMAL manuals describe change bits, but Runtime Synchro produced 0.
' Keep raw bits diagnostic. Require real X/Y/image transitions instead.
If _CHG_X=0 or _CHG_Y=0 or _CHG_A=0
   _ERR=21
End If
_CLEANUP:
If _AMAL_ON=1
   Amal Off 0
End If
If _SYNCHRO_OFF=1
   Synchro On
End If
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
End If
If Length(28)<>0
   Erase 28
End If
If Length(27)<>0
   Erase 27
End If
If Length(24)<>0
   Erase 24
End If
If _ERR=0 and _CLOSE_RETURNED=1
   _OK=1
End If
_VERDICT$="FAIL"
If _OK=1
   _VERDICT$="PASS"
End If
Print "M19 P2e0 AMAL TO AGA ";_VERDICT$;" ERR ";_ERR
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 P2E0 AMAL BRIDGE"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"FRAME ";_FRAME
   Print #1,"VALID_SAMPLES ";_VALID
   Print #1,"SWAPS ";_SWAPS
   Print #1,"BG0 ";_BG0
   Print #1,"BG1 ";_BG1
   Print #1,"SWAP_RESULT ";_SWAP
   Print #1,"PIX_SAMPLES ";_PIX_SAMPLES
   Print #1,"MOVE_X ";_MOVE_X
   Print #1,"MOVE_Y ";_MOVE_Y
   Print #1,"IMAGE1 ";_IMAGE1
   Print #1,"IMAGE2 ";_IMAGE2
   Print #1,"FLAG_X ";_FLAG_X
   Print #1,"FLAG_Y ";_FLAG_Y
   Print #1,"FLAG_A ";_FLAG_A
   Print #1,"FLAG_WORD_LAST ";_FLAGS
   Print #1,"CHG_X ";_CHG_X
   Print #1,"CHG_Y ";_CHG_Y
   Print #1,"CHG_A ";_CHG_A
   Print #1,"LAST_X ";_X
   Print #1,"LAST_Y ";_Y
   Print #1,"LAST_IMAGE ";_IMAGE
   Print #1,"PIXEL_VALUE ";_VALUE
   Print #1,"PIXEL_EXPECTED ";_PROBE_EXPECTED
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
End
