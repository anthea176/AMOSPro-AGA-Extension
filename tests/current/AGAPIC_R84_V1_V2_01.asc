' R84 AGAPIC v1/v2 - bank metadata and version-selectable native capture.
' Gate B WinUAE Runtime first; Gate C fresh AMOS Compiler executable.
' AGA / 68020+ ; test both 4 and 8 planes. No c2p.library required.
' Reserved banks 11..15 MUST be free; only created banks are erased.
Cls
Print "R84 AGAPIC V1/V2 INFO + CAPTURE"
_RESULT=1
_ERR=0
_OPEN=0
_C11=0
_C12=0
_C13=0
_C14=0
_C15=0
_PASS4=0
_PASS8=0
_META_OK=0
_CAPTURE_OK=0
_STREAM_OK=0
_MASK_OK=0
_PALETTE_OK=0
_RELOAD_OK=0
_INVALID_OK=0
_DRAW_OK=0
_REGION_OK=0
_SWAP_OK=0
_CLOSE_COUNT=0
_CHIP0=Chip Free
_FAST0=Fast Free
_PRG=Prg State
_RUNMODE$="UNKNOWN"
_LOGFILE$="RAM:AGAPIC_R84_UNKNOWN.TXT"
If _PRG=0
   _RUNMODE$="INTERPRETED"
   _LOGFILE$="RAM:AGAPIC_R84_INTERPRETED.TXT"
End If
If _PRG=1
   _RUNMODE$="RUNTIME"
   _LOGFILE$="RAM:AGAPIC_R84_RUNTIME.TXT"
End If
If _PRG=-1
   _RUNMODE$="COMPILED"
   _LOGFILE$="RAM:AGAPIC_R84_COMPILED.TXT"
End If
_CPUFLAGS=0
_SYSBASE=Leek(4)
If _SYSBASE<>0
   _CPUFLAGS=Deek(_SYSBASE+296)
End If
If Aga Detect=0
   _ERR=1
   Goto CLEANUP
End If
For _PASS=1 To 2
   _COLORS=16
   _DEPTH=4
   If _PASS=2
      _COLORS=256
      _DEPTH=8
   End If
   ' Length tests bank presence without requiring a reserved bank.
   ' Start is ONLY valid below after successful capture of a bank.
   If Length(11)<>0 or Length(12)<>0 or Length(13)<>0
      _ERR=2
      Goto CLEANUP
   End If
   If Length(14)<>0 or Length(15)<>0
      _ERR=3
      Goto CLEANUP
   End If
   _OPEN=Aga Screen Open(320,256,_COLORS,$00021000)
   If _OPEN<>1
      _ERR=4
      Goto CLEANUP
   End If
   _DB=Aga Double Buffer
   If _DB<>1
      _ERR=5
      Goto CLEANUP
   End If
   _P0=Aga Palette Set(0,15,30,55)
   _P1=Aga Palette Set(1,250,40,80)
   _P2=Aga Palette Set(2,45,210,70)
   _BG=Aga Blit Fill(0,0,320,256,2)
   _BOX=Aga Box(40,40,104,80,1)
   _CIRCLE=Aga Circle(70,60,15,0)
   If _P0<>1 or _P1<>1 or _P2<>1 or _BG<>1
      _ERR=6
      Goto CLEANUP
   End If
   If _BOX<>1 or _CIRCLE<>1
      _ERR=7
      Goto CLEANUP
   End If
   ' The same source pixels are captured in both native formats.
   _C11=Aga Bank Image Capture(11,40,40,64,40,-1,1)
   _C12=Aga Bank Image Capture(12,40,40,64,40,-1,2)
   _C13=Aga Bank Image Capture(13,40,40,64,40,0,1)
   _C14=Aga Bank Image Capture(14,40,40,64,40,0,2)
   _C15=Aga Image Capture(15,40,40,64,40,-1)
   If _C11<>1 or _C12<>1 or _C13<>1
      _ERR=8
      Goto CLEANUP
   End If
   If _C14<>1 or _C15<>1
      _ERR=9
      Goto CLEANUP
   End If
   _CAPTURE_OK=1
   _W=Aga Bank Image Info(11,1)
   _H=Aga Bank Image Info(12,2)
   _D=Aga Bank Image Info(14,3)
   _V1COL=Aga Bank Image Info(11,4)
   _V1MOD=Aga Bank Image Info(11,5)
   _V2COL=Aga Bank Image Info(12,4)
   _V2MOD=Aga Bank Image Info(12,5)
   If _W<>64 or _H<>40 or _D<>_DEPTH
      _ERR=10
      Goto CLEANUP
   End If
   If _V1COL<>0 or _V1MOD<>0
      _ERR=11
      Goto CLEANUP
   End If
   If _V2COL<>_COLORS or _V2MOD<>$00021000
      _ERR=12
      Goto CLEANUP
   End If
   If Aga Bank Image Info(15,4)<>0 or Aga Bank Image Info(15,5)<>0
      _ERR=13
      Goto CLEANUP
   End If
   _META_OK=1
   _IV1=Aga Bank Image Info(4,1)
   _IV2=Aga Bank Image Info(11,6)
   _IV3=Aga Bank Image Info(15,0)
   _XV=Aga Bank Image Capture(12,40,40,64,40,-1,2)
   _XX=Aga Bank Image Capture(16,40,40,64,40,-1,0)
   _XY=Aga Bank Image Capture(16,40,40,64,40,-1,3)
   _XZ=Aga Bank Image Capture(16,280,40,64,40,-1,2)
   If _IV1<>-1 or _IV2<>-1 or _IV3<>-1
      _ERR=14
      Goto CLEANUP
   End If
   If _XV<>0 or _XX<>0 or _XY<>0 or _XZ<>0
      _ERR=15
      Goto CLEANUP
   End If
   If Length(16)<>0
      _ERR=16
      Goto CLEANUP
   End If
   _INVALID_OK=1
   ' Existing reserved banks: Start gives the payload ADDRESS, not size.
   ' Never replace these Start calls with Length: Leek/Peek need pointers.
   ' Compare the actual native row RLE stream byte by byte (v1/v2).
   _P11=Start(11)
   _P12=Start(12)
   _S11=Leek(_P11+24)
   _S12=Leek(_P12+24)
   _N11=Leek(_P11+28)-_S11
   _N12=Leek(_P12+28)-_S12
   If _N11<>_N12 or _N11<=0
      _ERR=17
      Goto CLEANUP
   End If
   For _I=0 To _N11-1
      If Peek(_P11+_S11+_I)<>Peek(_P12+_S12+_I)
         _ERR=18
         Goto CLEANUP
      End If
   Next _I
   _STREAM_OK=1
   _P13=Start(13)
   _P14=Start(14)
   _S13=Leek(_P13+24)
   _S14=Leek(_P14+24)
   _N13=Leek(_P13+28)-_S13
   _N14=Leek(_P14+28)-_S14
   If _N13<>_N14 or _N13<=0
      _ERR=19
      Goto CLEANUP
   End If
   For _I=0 To _N13-1
      If Peek(_P13+_S13+_I)<>Peek(_P14+_S14+_I)
         _ERR=20
         Goto CLEANUP
      End If
   Next _I
   _MASK_OK=1
   ' Round-trip through native AMOS ABK Save/Load, test both versions.
   If _PASS=1
      Save "RAM:R84_V1_4.abk",11
      Save "RAM:R84_V2_4.abk",12
      Erase 11
      Erase 12
      Load "RAM:R84_V1_4.abk",11
      Load "RAM:R84_V2_4.abk",12
   Else
      Save "RAM:R84_V1_8.abk",11
      Save "RAM:R84_V2_8.abk",12
      Erase 11
      Erase 12
      Load "RAM:R84_V1_8.abk",11
      Load "RAM:R84_V2_8.abk",12
   End If
   If Aga Bank Image Info(11,1)<>64 or Aga Bank Image Info(12,2)<>40
      _ERR=21
      Goto CLEANUP
   End If
   If Aga Bank Image Info(12,5)<>$00021000
      _ERR=22
      Goto CLEANUP
   End If
   _RELOAD_OK=1
   _SET=Aga Palette Set(1,0,0,0)
   _APPLY=Aga Bank Palette Apply(12,0)
   If _SET<>1 or _APPLY<>1 or Aga Palette Get(1)<>$FA2850
      _ERR=23
      Goto CLEANUP
   End If
   _PALETTE_OK=1
   _CLEAR=Aga Blit Clear(0,118,320,138)
   _DR1=Aga Bank Image Draw(11,24,155,0)
   _DR2=Aga Bank Image Draw(12,113,155,0)
   _DR3=Aga Bank Image Draw(13,205,155,1)
   _DR4=Aga Bank Image Draw(14,285,155,1)
   If _CLEAR<>1 or _DR1<>1 or _DR2<>1
      _ERR=24
      Goto CLEANUP
   End If
   If _DR3<>1 or _DR4<>1
      _ERR=25
      Goto CLEANUP
   End If
   _DRAW_OK=1
   _RG1=Aga Image Region(11,0,0,32,24,54,226,0)
   _RG2=Aga Image Region(12,0,0,32,24,159,226,0)
   If _RG1<>1 or _RG2<>1
      _ERR=26
      Goto CLEANUP
   End If
   _REGION_OK=1
   _SW=Aga Swap
   If _SW<>1
      _ERR=27
      Goto CLEANUP
   End If
   _SWAP_OK=1
   Amos To Back
   For _J=1 To 60
      Aga Wait Vbl
   Next _J
   Aga Screen Close
   _OPEN=0
   _CLOSE_COUNT=_CLOSE_COUNT+1
   Amos To Front
   Erase 11
   Erase 12
   Erase 13
   Erase 14
   Erase 15
   _C11=0
   _C12=0
   _C13=0
   _C14=0
   _C15=0
   If _PASS=1
      _PASS4=1
   Else
      _PASS8=1
   End If
Next _PASS
Goto CLEANUP

CLEANUP:
If _ERR<>0
   _RESULT=0
End If
If _OPEN=1
   Aga Screen Close
   _CLOSE_COUNT=_CLOSE_COUNT+1
End If
Amos To Front
If _C11=1 and Length(11)<>0
   Erase 11
End If
If _C12=1 and Length(12)<>0
   Erase 12
End If
If _C13=1 and Length(13)<>0
   Erase 13
End If
If _C14=1 and Length(14)<>0
   Erase 14
End If
If _C15=1 and Length(15)<>0
   Erase 15
End If
_CHIP1=Chip Free
_FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1 and _PASS4=1 and _PASS8=1
   _VERDICT$="PASS"
End If
Print "R84 AGAPIC V1/V2 ";_VERDICT$;" ERR ";_ERR
Print "4/8 PLANES ";_PASS4;" ";_PASS8;" CAP ";_CAPTURE_OK
Print "META/STREAM/MASK ";_META_OK;" ";_STREAM_OK;" ";_MASK_OK
Print "PALETTE/RELOAD/INVALID ";_PALETTE_OK;" ";_RELOAD_OK;" ";_INVALID_OK
Print "DRAW/REGION/SWAP ";_DRAW_OK;" ";_REGION_OK;" ";_SWAP_OK
Print "CHIP/Fast DELTA ";_CHIP1-_CHIP0;" ";_FAST1-_FAST0
Print "RESULT ";_RESULT;" ERR ";_ERR
_LOGERR=0
_CLOSEERR=0
Trap Open Out 1,_LOGFILE$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST AGAPIC_R84_V1_V2_01"
   Print #1,"VERSION R84 V0.13.29 CANDIDATE"
   Print #1,"RUN_MODE ";_RUNMODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"CPU_ATTNFLAGS ";_CPUFLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"PASS_4 ";_PASS4
   Print #1,"PASS_8 ";_PASS8
   Print #1,"CAPTURE_OK ";_CAPTURE_OK
   Print #1,"META_OK ";_META_OK
   Print #1,"RLE_EQUAL_OK ";_STREAM_OK
   Print #1,"MASK_EQUAL_OK ";_MASK_OK
   Print #1,"PALETTE_OK ";_PALETTE_OK
   Print #1,"RELOAD_OK ";_RELOAD_OK
   Print #1,"INVALID_OK ";_INVALID_OK
   Print #1,"DRAW_OK ";_DRAW_OK
   Print #1,"REGION_OK ";_REGION_OK
   Print #1,"SWAP_OK ";_SWAP_OK
   Print #1,"CLOSE_COUNT ";_CLOSE_COUNT
   Print #1,"ERR ";_ERR
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"CHIP_DELTA ";_CHIP1-_CHIP0
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"FAST_DELTA ";_FAST1-_FAST0
   Print #1,"CLOSE_RETURNED ";_CLOSE_COUNT
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOGFILE$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
End
