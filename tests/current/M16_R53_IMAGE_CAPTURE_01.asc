' M16-R53-IMAGE-CAPTURE-01 - EXPERIMENTAL WinUAE Gate B / C, NOT YET TESTED.
' MUST use R53 capture CANDIDATE in a disposable WinUAE configuration.
' Official R46 C1 LAST_GOOD does NOT contain Aga Image Capture.
' AMOS banks 11 and 12 MUST be unoccupied before this test. NO AUTO ERASE
' of occupied banks. If a bank is occupied, the program refuses to proceed.
' Capture reads the AGA BACK BUFFER and MUST NOT swap implicitly.
' TransparentIndex=-1: opaque; =0: colour 0 masked; other 0..15 allowed.
' Reference R46 Image Draw still requires Start(bank),Length(bank).
Cls
Print "M16/R53 IMAGE CAPTURE LINK FIX"
Print "CHECK NOSCREEN"
_NOSCREEN=Aga Image Capture(11,0,0,16,16,-1)
Print "NOSCREEN RETURN ";_NOSCREEN
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,255,30,180)
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,25,40,95)
_P3=Aga Palette Set(3,255,210,60)
_BG=Aga Blit Fill(0,0,320,256,2)
_A=Aga Box(40,40,104,80,1)
_B=Aga Box(120,40,184,80,3)
_C=Aga Circle(72,60,17,0)
_D=Aga Circle(152,60,17,0)
_E=Aga Draw(40,40,104,80,1)
_F=Aga Draw(120,80,184,40,1)
' Both calls must CREATE native AMOS DATA AGAPIC banks, not replace them.
Print "CAPTURE OPAQUE"
_C0=Aga Image Capture(11,40,40,64,40,-1)
Print "CAPTURE TRANSPARENT"
_C1=Aga Image Capture(12,120,40,64,40,0)
If _C0<>1 or _C1<>1
   Aga Screen Close
   Amos To Front
   Cls
   Print "CAPTURE FAILED (OR BANK 11/12 ALREADY RESERVED)"
   Print "CAP 11/12 ";_C0;" ";_C1
   Print "RETEST WITH FREE BANKS 11 AND 12"
   If _C0=1
      Erase 11
   End If
   If _C1=1
      Erase 12
   End If
   End
End If
_L0=Length(11)
_L1=Length(12)
_H0$=Peek$(Start(11),6)
_H1$=Peek$(Start(12),6)
_N0=Leek(Start(11)-16)
_N1=Leek(Start(12)-16)
_FLAGS0=Deek(Start(11)+8)
_FLAGS1=Deek(Start(12)+8)
' The two occupied banks must never be replaced by another capture.
_KEEP0=Start(11)
_KEEP1=Length(11)
_SUM0=0
For _K=0 To _KEEP1-1
   _SUM0=_SUM0+Peek(_KEEP0+_K)
Next _K
_COLL=Aga Image Capture(11,40,40,64,40,-1)
_PRES=1
If Start(11)<>_KEEP0 or Length(11)<>_KEEP1
   _PRES=0
End If
_SUM1=0
For _K=0 To _KEEP1-1
   _SUM1=_SUM1+Peek(_KEEP0+_K)
Next _K
If _SUM0<>_SUM1
   _PRES=0
End If
' All invalid captures must refuse without creating a new bank.
_BX=Aga Image Capture(13,-1,40,64,40,-1)
_BR=Aga Image Capture(13,280,40,64,40,-1)
_BY=Aga Image Capture(13,40,230,64,40,-1)
_BW=Aga Image Capture(13,40,40,0,40,-1)
_BH=Aga Image Capture(13,40,40,64,0,-1)
_BI=Aga Image Capture(13,40,40,64,40,16)
_BN=Aga Image Capture(4,40,40,64,40,-1)
' Draw the images below, using the ORIGINAL existing R46 Draw signature.
_CLR=Aga Blit Fill(0,119,320,137,2)
_D0=Aga Image Draw(Start(11),Length(11),24,147,0)
_D1=Aga Image Draw(Start(12),Length(12),122,147,1)
' Save / Erase / Load ABK round trip: only bank 11 created by this test.
Save "RAM:M16_R53_CAPTURE11.abk",11
Erase 11
Load "RAM:M16_R53_CAPTURE11.abk",11
_RELOAD=0
If Peek$(Start(11),6)="AGAPIC"
   _RELOAD=1
End If
_LR=Length(11)
_DR=Aga Image Draw(Start(11),_LR,222,147,0)
_TX=Aga Text(20,17,1,"R53 AGAPIC CAPTURE / BACK BUFFER")
_TX2=Aga Text(20,110,3,"SOURCE ABOVE / CAPTURED BELOW")
_SWAP=Aga Swap
If _SWAP=1
   Amos To Back
End If
For _I=1 To 175
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
' Remove ONLY banks created by this test.
Erase 11
Erase 12
_CF1=Chip Free
_RESULT=1
If _NOSCREEN<>0 or _FLAGS0<>0 or _FLAGS1<>1
   _RESULT=0
End If
If _OPEN<>1 or _DB<>1 or _BG<>1 or _A<>1 or _B<>1
   _RESULT=0
End If
If _C<>1 or _D<>1 or _E<>1 or _F<>1
   _RESULT=0
End If
If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
   _RESULT=0
End If
If _C0<>1 or _C1<>1 or _COLL<>0 or _PRES<>1
   _RESULT=0
End If
If _BX<>0 or _BR<>0 or _BY<>0 or _BW<>0 or _BH<>0
   _RESULT=0
End If
If _BI<>0 or _BN<>0
   _RESULT=0
End If
If _H0$<>"AGAPIC" or _H1$<>"AGAPIC" or _N0<>11 or _N1<>12
   _RESULT=0
End If
If _D0<>1 or _D1<>1 or _DR<>1 or _RELOAD<>1
   _RESULT=0
End If
If _TX<>1 or _TX2<>1 or _SWAP<>1
   _RESULT=0
End If
Cls
Print "M16/R53 IMAGE CAPTURE / INTERPRETER OR NEW COMPILED EXE"
Print "NOSCREEN ";_NOSCREEN;" FLAGS ";_FLAGS0;" ";_FLAGS1
Print "CAP 11 12 ";_C0;" ";_C1;" LEN ";_L0;" ";_L1
Print "COLL ";_COLL;" PRES ";_PRES;" INVALID ";_BX;" ";_BR;" ";_BY
Print "INVALID ";_BW;" ";_BH;" ";_BI;" ";_BN
Print "DRAW O/M/RELOAD ";_D0;" ";_D1;" ";_DR;" RL ";_RELOAD
Print "BANK NOS ";_N0;" ";_N1;" SWAP ";_SWAP
Print "CHIP BEFORE/END ";_CF0;" ";_CF1
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
