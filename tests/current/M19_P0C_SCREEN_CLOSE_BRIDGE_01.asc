' M19 P0c Screen Close bridge - ACTIVE Gates B/C test, not yet WinUAE validated.
' REQUIRES canonical dist/AMOSPro_AGA.Lib SHA256 277802d4aefbe007b86cb8a4dbb9f0703f3a24014971a1824ba38f82d7d7b51a
' Tests public native Screen Close only; private End arm and Chip staging NOT exposed.
' Import into EMPTY AMOS program via Project -> Merge ASCII; AGA 68030 JIT ON.
' Runtime and Compiled logs are separate; no IFF/ABK needed.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_P0C_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_P0C_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_P0C_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_P0C_COMPILED.TXT"
End If
_ERR=0 : _RESULT=0 : _OPEN=0 : _C1=0 : _C2=0 : _C3=0 : _DB=0
Print "M19 P0c AGA SCREEN CLOSE BRIDGE / THREE OPEN-CLOSE PASSES"
If Aga Detect=0
   _ERR=1 : Goto _FINAL
End If
' PASS 1: open and close without Double Buffer.
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=2 : Goto _FINAL
End If
Aga Screen Pattern
Amos To Back
For _I=1 To 8
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_OPEN=0 : _C1=1
' PASS 2: recreate with Double Buffer but no in-flight swap.
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _FINAL
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
Amos To Back
For _I=1 To 8
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_OPEN=0 : _C2=1
' PASS 3: verify reopen is possible after a DB close.
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=5 : Goto _FINAL
End If
Aga Screen Pattern
Amos To Back
For _I=1 To 8
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_OPEN=0 : _C3=1
Goto _FINAL
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   Amos To Front
   _OPEN=0
End If
_FINAL:
If _C1=1 and _C2=1 and _C3=1 and _ERR=0
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "M19 P0c ";_VERDICT$;" ERR ";_ERR
Print "CLOSE1 ";_C1;" CLOSE2_DB ";_C2;" CLOSE3_REOPEN ";_C3
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P0C_SCREEN_CLOSE_BRIDGE_01"
   Print #1,"CANDIDATE SHA256 277802d4aefbe007b86cb8a4dbb9f0703f3a24014971a1824ba38f82d7d7b51a"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"CLOSE_FIRST ";_C1
   Print #1,"CLOSE_WITH_DB ";_C2
   Print #1,"CLOSE_REOPEN ";_C3
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
