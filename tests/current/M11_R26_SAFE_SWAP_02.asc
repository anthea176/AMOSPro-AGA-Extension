' M11-R26-SAFE-SWAP-02 - 40 text frames and AGA swaps.
' R26 0.9.2. Choose examples/demo.iff (320x256x8 PAL).
' GREEN frame A / RED frame B; watch them alternate.
' R26 Aga Text probes Safe BEFORE every R25 Blitter call.
' A zero may mean not-Safe OR error; not proof of a Safe event.
' Bounded retries, no busy spin, no native AMOS Text.
Cls
Print "M11-R26-SAFE-SWAP-02"
Print "Choose demo.iff 320X256X8 PAL"
Print "Watch GREEN A and RED B alternating"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCEL"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8 or _C<>256 or _MODE<>$00021000
   Print "NEED demo.iff 320X256X8 PAL"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
_DONE=0
_PROBEOK=0
_PROBE0=0
_SWAP0=0
_SAFEERR=0
_SWAPERR=0
_DRAWERR=0
_ALT=0
_TX=0
_SW=0
Amos To Back
For _FRAME=1 To 40
   ' The old front may be unsafe immediately after Swap.
   _READY=0
   For _TRY=1 To 12
      If _READY=0
         _PROBE=Aga Text(24,24,28,"SAFE?")
         If _PROBE=1
            _READY=1
            _PROBEOK=_PROBEOK+1
         Else
            _PROBE0=_PROBE0+1
            Aga Wait Vbl
         End If
      End If
   Next _TRY
   If _READY=0
      _SAFEERR=1
      _FRAME=40
   Else
      ' Only now is it safe to call the older R25 Blitters.
      _CLEAR=Aga Blit Clear(0,0,320,256)
      _PANEL=Aga Blit Fill(16,40,288,168,3)
      If _ALT=0
         _TX=Aga Text(38,90,28,"FRAME A - GREEN")
         _LED=Aga Blit Fill(26,156,70,20,28)
      Else
         _TX=Aga Text(38,90,224,"FRAME B - RED")
         _LED=Aga Blit Fill(220,156,70,20,224)
      End If
      _TITLE=Aga Text(38,126,28,"R26 MULTI SWAP TEST")
      If _CLEAR<>1 or _PANEL<>1 or _LED<>1 or _TX<>1 or _TITLE<>1
         _DRAWERR=1
         _FRAME=40
      Else
         ' Disp can still be pending: retry Swap with a VBL bound.
         _SWREADY=0
         For _ST=1 To 12
            If _SWREADY=0
               _SW=Aga Swap
               If _SW=1
                  _SWREADY=1
               Else
                  _SWAP0=_SWAP0+1
                  Aga Wait Vbl
               End If
            End If
         Next _ST
         If _SWREADY=0
            _SWAPERR=1
            _FRAME=40
         Else
            _DONE=_DONE+1
            _ALT=1-_ALT
         End If
      End If
   End If
Next _FRAME
' Hold the last screen for a screenshot.
For _HOLD=1 To 120
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _LOAD<>1
   _RESULT=0
End If
If _DONE<>40 or _PROBEOK<>40
   _RESULT=0
End If
If _SAFEERR<>0 or _SWAPERR<>0 or _DRAWERR<>0
   _RESULT=0
End If
If _CLOSED<>-1
   _RESULT=0
End If
Print "M11-R26-SAFE-SWAP-02"
Print "IMAGE ";_W;" X ";_H;" PLANES ";_D
Print "OPEN ";_OPEN;" DB ";_DB;" LOAD ";_LOAD
Print "DONE ";_DONE;" PROBEOK ";_PROBEOK
Print "PROBE0 ";_PROBE0;" SWAP0 ";_SWAP0
Print "SAFEERR ";_SAFEERR;" SWAPERR ";_SWAPERR;" DRAWERR ";_DRAWERR
Print "CLOSED ";_CLOSED;" RESULT ";_RESULT
Print "CLOSE RETURNED"
End
