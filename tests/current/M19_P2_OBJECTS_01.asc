' M19 P2.0 - BASIC OBJECT MANAGER / PRIVATE AGA / MANUAL AMAL
' TEST ONLY: R84 LAST_GOOD unchanged. MC68020+ / 8 planes.
' Banks 11..23 must be free. No external assets, no native API.
' IDs are monotonic, image banks are owned by THIS TEST, not manager.
' SET BUFFER must be the first executable AMOS instruction.
Set Buffer 20
Cls
Print "M19 P2.0 OBJECT MANAGER"
_RESULT=1 : _ERR=0 : _OPEN=0 : _DB=0 : _CLOSED=0
_B11=0 : _B20=0 : _B21=0 : _LASTCAP=11
_B18=0 : _B19=0 : _AMAL=0 : _SYN=0
_CAPS=0 : _ICONS=0 : _PROBE=0 : _PIXDIFF=0
_FOK=0 : _DF=0 : _SF=0 : _MOVE0=0 : _MOVE1=0
_SHOWS=0 : _HIDES=0 : _DELETES=0 : _STALEREF=0
_BADFRAME=0 : _BADBANK=0 : _CREATECOUNT=0
_FRCH0=0 : _FRCH1=0 : _ZCHG=0 : _TIEOK=0
_CLIPCOUNT=0 : _CULLED=0 : _FOUR=0 : _DRAWS=0
_LASTX=-1 : _LASTY=-1 : _NEXTID=0
Dim _ALIVE(6),_TYPE(6),_BN1(6),_BN2(6),_IC1(6),_IC2(6)
Dim _FRAME(6),_OX(6),_OY(6),_HX(6),_HY(6),_OZ(6)
Dim _VISIBLE(6),_OMODE(6),_MOTION(6),_ORDER(6)
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN"
_LOG$="RAM:M19_P2_OBJECTS_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:M19_P2_OBJECTS_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:M19_P2_OBJECTS_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:M19_P2_OBJECTS_COMPILED.TXT"
End If
_CPU$="UNKNOWN" : _FLAGS=0
_SYS=Leek(4)
If _SYS<>0
   _FLAGS=Deek(_SYS+296)
   _CPU$="68000"
   If (_FLAGS And 1)<>0
      _CPU$="68010"
   End If
   If (_FLAGS And 2)<>0
      _CPU$="68020"
   End If
   If (_FLAGS And 4)<>0
      _CPU$="68030"
   End If
   If (_FLAGS And 8)<>0
      _CPU$="68040"
   End If
   If (_FLAGS And 128)<>0
      _CPU$="68060"
   End If
End If
If Aga Detect=0
   _ERR=1
   Goto CLEANUP
End If
' Bank23 is deliberately reserved as a MISSING source for a negative test.
For _B=11 To 23
   If Length(_B)<>0
      _ERR=2
      Goto CLEANUP
   End If
Next _B
Reserve As Data 11,16
_B11=1
_PTR=Start(11)
For _I=0 To 15
   Poke _PTR+_I,0
Next _I
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3
   Goto CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4
   Goto CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,22,35,65)
_P3=Aga Palette Set(3,250,65,60)
_P4=Aga Palette Set(4,255,180,35)
_P5=Aga Palette Set(5,30,215,230)
_P6=Aga Palette Set(6,60,255,150)
_P7=Aga Palette Set(7,245,235,60)
_P8=Aga Palette Set(8,215,85,250)
If _P0<>1 or _P1<>1 or _P3<>1 or _P4<>1
   _ERR=5
   Goto CLEANUP
End If
If _P5<>1 or _P6<>1 or _P7<>1 or _P8<>1
   _ERR=6
   Goto CLEANUP
End If
' Create six AGAPIC source frames, exactly as in P1.
For _I=0 To 5
   _B=12+_I : _COL=3+_I : _VERS=1 : _TRANS=0
   If (_I Mod 2)=1
      _VERS=2
   End If
   If _B=17
      _TRANS=-1
   End If
   _READY=0
   For _TRY=1 To 12
      If _READY=0
         _READY=Aga Blit Fill(8,8,24,24,0)
      End If
      If _READY=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _READY<>1
      _ERR=7
      Goto CLEANUP
   End If
   _P1=Aga Blit Fill(12,12,16,16,_COL)
   _P2=Aga Box(8,8,31,31,_COL)
   If (_I Mod 2)=0
      _P3=Aga Blit Fill(8,18,24,4,_COL)
   Else
      _P3=Aga Blit Fill(18,8,4,24,_COL)
   End If
   If _P1<>1 or _P2<>1 or _P3<>1
      _ERR=8
      Goto CLEANUP
   End If
   _OK=Aga Bank Image Capture(_B,8,8,24,24,_TRANS,_VERS)
   If _OK<>1
      _ERR=9
      Goto CLEANUP
   End If
   _LASTCAP=_B : _CAPS=_CAPS+1
   If Aga Bank Image Info(_B,1)<>24 or Aga Bank Image Info(_B,2)<>24
      _ERR=10
      Goto CLEANUP
   End If
   If Aga Bank Image Info(_B,3)<>8
      _ERR=11
      Goto CLEANUP
   End If
Next _I
' Create FICON8 bank 20 with four 16x16 source images.
_OK=Aga F Icon Bank Create(20,4)
If _OK<>1
   _ERR=12
   Goto CLEANUP
End If
_B20=1
Reserve As Data 21,256
_B21=1
_PIX=Start(21)
For _ICON=1 To 4
   For _Y=0 To 15
      For _X=0 To 15
         _COL=0
         If _X=0 or _Y=0 or _X=15 or _Y=15
            _COL=4+_ICON
         End If
         If _X>=4 and _X<=11 and _Y>=4 and _Y<=11
            _COL=4+_ICON
         End If
         If _X=_Y or _X=15-_Y
            _COL=4+_ICON
         End If
         Poke _PIX+_Y*16+_X,_COL
      Next _X
   Next _Y
   _OK=Aga F Icon Bank Put(20,_ICON,21,0)
   If _OK<>1
      _ERR=13
      Goto CLEANUP
   End If
   _ICONS=_ICONS+1
Next _ICON
' CREATE_OBJ receives NEW* values and allocates a never-reused ID.
' AGAPIC object 1, red/yellow frames, AMAL channel0.
_NK=1 : _NB1=12 : _NB2=13 : _NI1=0 : _NI2=0
_NX=120 : _NY=92 : _NHX=12 : _NHY=12
_NZ=20 : _NV=1 : _NM=1 : _NA=1
Gosub _CREATE_OBJ
If _CID<>1
   _ERR=14
   Goto CLEANUP
End If
' AGAPIC object 2, cyan/green frames, AMAL channel1.
_NK=1 : _NB1=14 : _NB2=15 : _NI1=0 : _NI2=0
_NX=120 : _NY=92 : _NHX=12 : _NHY=12
_NZ=30 : _NV=1 : _NM=1 : _NA=2
Gosub _CREATE_OBJ
If _CID<>2
   _ERR=15
   Goto CLEANUP
End If
' FICON8 object 3, BASIC motion.
_NK=2 : _NB1=20 : _NB2=20 : _NI1=1 : _NI2=2
_NX=220 : _NY=160 : _NHX=8 : _NHY=8
_NZ=5 : _NV=1 : _NM=1 : _NA=0
Gosub _CREATE_OBJ
If _CID<>3
   _ERR=16
   Goto CLEANUP
End If
' Opaque AGAPIC object 4, BASIC motion.
_NK=1 : _NB1=17 : _NB2=17 : _NI1=0 : _NI2=0
_NX=250 : _NY=85 : _NHX=12 : _NHY=12
_NZ=45 : _NV=1 : _NM=0 : _NA=0
Gosub _CREATE_OBJ
If _CID<>4
   _ERR=17
   Goto CLEANUP
End If
' Logical Z-order probe through the actual manager renderer.
Gosub _RENDER_OBJECTS
If _ROK<>1
   _ERR=18
   Goto CLEANUP
End If
_OK=Aga Bank Image Capture(18,120,92,1,1,-1,1)
If _OK<>1
   _ERR=19
   Goto CLEANUP
End If
_B18=1
_OZ(1)=40
Gosub _RENDER_OBJECTS
If _ROK<>1
   _ERR=20
   Goto CLEANUP
End If
_OK=Aga Bank Image Capture(19,120,92,1,1,-1,1)
If _OK<>1
   _ERR=21
   Goto CLEANUP
End If
_B19=1
_P18=Start(18) : _P19=Start(19)
_S18=Leek(_P18+24) : _S19=Leek(_P19+24)
_L18=Leek(_P18+28)-_S18
_L19=Leek(_P19+28)-_S19
If _L18<=0 or _L18<>_L19
   _ERR=22
   Goto CLEANUP
End If
For _I=0 To _L18-1
   If Peek(_P18+_S18+_I)<>Peek(_P19+_S19+_I)
      _PIXDIFF=1
   End If
Next _I
If _PIXDIFF<>1
   _ERR=23
   Goto CLEANUP
End If
_PROBE=1
' Equal Z must keep creation order (1 before 2).
_OZ(1)=20 : _OZ(2)=20
Gosub _SORT_OBJECTS
_POS1=0 : _POS2=0
For _I=1 To _COUNT
   If _ORDER(_I)=1
      _POS1=_I
   End If
   If _ORDER(_I)=2
      _POS2=_I
   End If
Next _I
If _POS1=0 or _POS2=0 or _POS1>=_POS2
   _ERR=24
   Goto CLEANUP
End If
_TIEOK=1
' Manual AMAL: bank11 must stay alive until Amal Off.
Doke _PTR,0 : Doke _PTR+2,50 : Doke _PTR+4,122 : Doke _PTR+6,1
Doke _PTR+8,0 : Doke _PTR+10,155 : Doke _PTR+12,20 : Doke _PTR+14,3
Synchro Off
_SYN=1
_A0$="Let X=50; Let Y=122; Let A=1; L: Let X=X+1; Pause; If X<270 Jump L; Let X=50; Jump L"
_A1$="Let X=155; Let Y=20; Let A=3; L: Let Y=Y+1; Pause; If Y<220 Jump L; Let Y=20; Jump L"
Amal 0,_A0$ To _PTR
Amal 1,_A1$ To _PTR+8
Amal On
_AMAL=1
Amos To Back
For _F=1 To 240
   Aga Wait Vbl
   Synchro
   ' AMAL updates position only; frame selection remains in BASIC.
   _OX(1)=Deek(_PTR+2) : _OY(1)=Deek(_PTR+4)
   _OX(2)=Deek(_PTR+10) : _OY(2)=Deek(_PTR+12)
   If _OX(1)<0 or _OX(1)>319 or _OY(1)<0 or _OY(1)>255
      _ERR=25
      Goto CLEANUP
   End If
   If _OX(2)<0 or _OX(2)>319 or _OY(2)<0 or _OY(2)>255
      _ERR=26
      Goto CLEANUP
   End If
   If _LASTX>=0 and _LASTX<>_OX(1)
      _MOVE0=_MOVE0+1
   End If
   If _LASTY>=0 and _LASTY<>_OY(2)
      _MOVE1=_MOVE1+1
   End If
   _LASTX=_OX(1) : _LASTY=_OY(2)
   If (_F Mod 16)=0
      _TARGET=1 : _NEWFRAME=3-_FRAME(1)
      Gosub _SET_FRAME
      If _OP<>1
         _ERR=27
         Goto CLEANUP
      End If
      _FRCH0=_FRCH0+1
   End If
   If (_F Mod 24)=0
      _TARGET=2 : _NEWFRAME=3-_FRAME(2)
      Gosub _SET_FRAME
      If _OP<>1
         _ERR=28
         Goto CLEANUP
      End If
      _FRCH1=_FRCH1+1
   End If
   ' BASIC object 3, with four anchored clipping test frames.
   _TARGET=3 : _NEWX=165+(_F Mod 75) : _NEWY=177
   If _F=35
      _NEWX=4 : _NEWY=177
   End If
   If _F=45
      _NEWX=316 : _NEWY=177
   End If
   If _F=55
      _NEWX=260 : _NEWY=4
   End If
   If _F=65
      _NEWX=260 : _NEWY=254
   End If
   If _F=75
      _NEWX=-50 : _NEWY=110
   End If
   Gosub _MOVE_OBJ
   If _OP<>1
      _ERR=29
      Goto CLEANUP
   End If
   If (_F Mod 20)=0
      _TARGET=3 : _NEWFRAME=3-_FRAME(3)
      Gosub _SET_FRAME
      If _OP<>1
         _ERR=30
         Goto CLEANUP
      End If
   End If
   If _ALIVE(4)=1
      _TARGET=4 : _NEWX=248-(_F Mod 60) : _NEWY=85
      Gosub _MOVE_OBJ
      If _OP<>1
         _ERR=31
         Goto CLEANUP
      End If
   End If
   ' Hide and show object 3, without erasing either source bank.
   If _F=85
      _TARGET=3 : _NEWVIS=0
      Gosub _SET_VISIBLE
      If _OP<>1
         _ERR=32
         Goto CLEANUP
      End If
      _HIDES=_HIDES+1
   End If
   If _F=105
      _TARGET=3 : _NEWVIS=1
      Gosub _SET_VISIBLE
      If _OP<>1
         _ERR=33
         Goto CLEANUP
      End If
      _SHOWS=_SHOWS+1
   End If
   ' Change Z and then restore tie (deterministic creation-order rule).
   If _F=60
      _OZ(1)=40 : _ZCHG=_ZCHG+1
   End If
   If _F=141
      _OZ(1)=20 : _ZCHG=_ZCHG+1
   End If
   ' Object 4 has BASIC motion, so it can be safely deleted.
   If _F=121
      _TARGET=4
      Gosub _DELETE_OBJ
      If _OP<>1 or _ALIVE(4)<>0
         _ERR=34
         Goto CLEANUP
      End If
      _DELETES=_DELETES+1
      ' Old reference must NOT modify a new object.
      _TARGET=4 : _NEWX=99 : _NEWY=99
      Gosub _MOVE_OBJ
      If _OP<>0
         _ERR=35
         Goto CLEANUP
      End If
      _STALEREF=_STALEREF+1
   End If
   If _F=122
      ' New FICON8 object gets ID5 (never reuse removed ID4).
      _NK=2 : _NB1=20 : _NB2=20 : _NI1=3 : _NI2=4
      _NX=303 : _NY=160 : _NHX=8 : _NHY=8
      _NZ=25 : _NV=1 : _NM=1 : _NA=0
      Gosub _CREATE_OBJ
      If _CID<>5
         _ERR=36
         Goto CLEANUP
      End If
   End If
   If _ALIVE(5)=1
      _TARGET=5 : _NEWX=300-(_F Mod 120) : _NEWY=20+(_F Mod 190)
      If _F=200
         _NEWX=370
      End If
      Gosub _MOVE_OBJ
      If _OP<>1
         _ERR=37
         Goto CLEANUP
      End If
      If (_F Mod 17)=0
         _TARGET=5 : _NEWFRAME=3-_FRAME(5)
         Gosub _SET_FRAME
         If _OP<>1
            _ERR=38
            Goto CLEANUP
         End If
      End If
   End If
   ' Prove invalid frame is rejected without state change.
   If _F=145
      _OLD=_FRAME(1) : _TARGET=1 : _NEWFRAME=3
      Gosub _SET_FRAME
      If _OP<>0 or _FRAME(1)<>_OLD
         _ERR=39
         Goto CLEANUP
      End If
      _BADFRAME=_BADFRAME+1
   End If
   ' Prove absent bank23 is rejected, no ID6 allocated.
   If _F=155
      _NK=1 : _NB1=23 : _NB2=13 : _NI1=0 : _NI2=0
      _NX=200 : _NY=100 : _NHX=12 : _NHY=12
      _NZ=10 : _NV=1 : _NM=1 : _NA=0
      Gosub _CREATE_OBJ
      If _CID<>0 or _NEXTID<>5
         _ERR=40
         Goto CLEANUP
      End If
      _BADBANK=_BADBANK+1
   End If
   Gosub _RENDER_OBJECTS
   If _ROK<>1
      _DF=_DF+1 : _ERR=41
      Goto CLEANUP
   End If
   _SW=0
   For _TRY=1 To 12
      If _SW=0
         _SW=Aga Swap
      End If
      If _SW=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _SW<>1
      _SF=_SF+1 : _ERR=42
      Goto CLEANUP
   End If
   _FOK=_FOK+1
   If _DRAWN>=4
      _FOUR=_FOUR+1
   End If
   If _F=35 or _F=45 or _F=55 or _F=65
      _CLIPCOUNT=_CLIPCOUNT+1
   End If
   _KEY=Aga Key
   If _KEY=69
      Goto CLEANUP
   End If
Next _F
Goto CLEANUP

CLEANUP:
' AMAL cannot write to a freed DATA bank.
If _AMAL=1
   Amal Off
End If
If _SYN=1
   Synchro On
End If
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _B19=1 and Length(19)<>0
   Erase 19
End If
If _B18=1 and Length(18)<>0
   Erase 18
End If
If _B21=1 and Length(21)<>0
   Erase 21
End If
If _B20=1 and Length(20)<>0
   Erase 20
End If
If _LASTCAP>=12
   For _B=12 To _LASTCAP
      If Length(_B)<>0
         Erase _B
      End If
   Next _B
End If
If _B11=1 and Length(11)<>0
   Erase 11
End If
If _ERR=0 and (_CAPS<>6 or _ICONS<>4 or _PROBE<>1 or _PIXDIFF<>1)
   _ERR=43
End If
If _ERR=0 and (_CREATECOUNT<>5 or _NEXTID<>5)
   _ERR=44
End If
If _ERR=0 and (_DELETES<>1 or _STALEREF<>1 or _BADFRAME<>1 or _BADBANK<>1)
   _ERR=45
End If
If _ERR=0 and (_HIDES<>1 or _SHOWS<>1 or _TIEOK<>1 or _ZCHG<>2)
   _ERR=46
End If
If _ERR=0 and (_FOK<180 or _MOVE0=0 or _MOVE1=0)
   _ERR=47
End If
If _ERR=0 and (_FRCH0<4 or _FRCH1<4 or _CLIPCOUNT<>4)
   _ERR=48
End If
If _ERR=0 and (_FOUR<120 or _CULLED<2 or _CLOSED<>1)
   _ERR=49
End If
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Cls
Print "M19 P2.0 ";_VERDICT$;" ERR ";_ERR
Print "CAP/ICON/PIX ";_CAPS;" ";_ICONS;" ";_PIXDIFF
Print "CREATE/DELETE/STALE ";_CREATECOUNT;" ";_DELETES;" ";_STALEREF
Print "HIDE/SHOW/BAD ";_HIDES;" ";_SHOWS;" ";_BADFRAME;" ";_BADBANK
Print "Z/TIE/CLIP/CULL ";_ZCHG;" ";_TIEOK;" ";_CLIPCOUNT;" ";_CULLED
Print "FRAME/MOVE ";_FOK;" ";_MOVE0;" ";_MOVE1
Print "DRAW/SWAP FAIL ";_DF;" ";_SF
Print "CLOSED ";_CLOSED;" CHIP/FAST ";_CHIP1-_CHIP0;" ";_FAST1-_FAST0
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P2_OBJECTS_01"
   Print #1,"VERSION R84 V0.13.29 LAST_GOOD"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"CPU ";_CPU$
   Print #1,"CPU_ATTNFLAGS ";_FLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"ERR ";_ERR
   Print #1,"CAP_OK ";_CAPS
   Print #1,"ICON_OK ";_ICONS
   Print #1,"PROBE_OK ";_PROBE
   Print #1,"PIXEL_DIFF ";_PIXDIFF
   Print #1,"CREATE_COUNT ";_CREATECOUNT
   Print #1,"NEXT_ID ";_NEXTID
   Print #1,"DELETE_COUNT ";_DELETES
   Print #1,"STALE_ID_REJECT ";_STALEREF
   Print #1,"BAD_FRAME_REJECT ";_BADFRAME
   Print #1,"BAD_BANK_REJECT ";_BADBANK
   Print #1,"HIDE_OK ";_HIDES
   Print #1,"SHOW_OK ";_SHOWS
   Print #1,"Z_CHANGE ";_ZCHG
   Print #1,"STABLE_TIE ";_TIEOK
   Print #1,"CLIP_OK ";_CLIPCOUNT
   Print #1,"CULLED ";_CULLED
   Print #1,"FOUR_VISIBLE_FRAMES ";_FOUR
   Print #1,"FRAME_OK ";_FOK
   Print #1,"MOVE_X0 ";_MOVE0
   Print #1,"MOVE_Y1 ";_MOVE1
   Print #1,"FRAME_SWITCH0 ";_FRCH0
   Print #1,"FRAME_SWITCH1 ";_FRCH1
   Print #1,"DRAW_FAIL ";_DF
   Print #1,"SWAP_FAIL ";_SF
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"CHIP_DELTA ";_CHIP1-_CHIP0
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"FAST_DELTA ";_FAST1-_FAST0
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
Print "CLOSE RETURNED"
End

' Subroutines below are purely BASIC manager logic (no native APIs).
_CREATE_OBJ:
_CID=0
If _NEXTID>=6
   Return
End If
If _NK<>1 and _NK<>2
   Return
End If
If _NM<>0 and _NM<>1
   Return
End If
If _NV<>0 and _NV<>1
   Return
End If
If _NA<0 or _NA>2
   Return
End If
If _NX<-512 or _NX>512 or _NY<-512 or _NY>512
   Return
End If
If Length(_NB1)=0 or Length(_NB2)=0
   Return
End If
If _NK=1
   If Aga Bank Image Info(_NB1,3)<>8 or Aga Bank Image Info(_NB2,3)<>8
      Return
   End If
   If Aga Bank Image Info(_NB1,1)<>24 or Aga Bank Image Info(_NB1,2)<>24
      Return
   End If
   If Aga Bank Image Info(_NB2,1)<>24 or Aga Bank Image Info(_NB2,2)<>24
      Return
   End If
   If _NHX<0 or _NHX>24 or _NHY<0 or _NHY>24
      Return
   End If
Else
   If _NB1<>20 or _NB2<>20
      Return
   End If
   If _NI1<1 or _NI1>4 or _NI2<1 or _NI2>4
      Return
   End If
   If _NHX<0 or _NHX>16 or _NHY<0 or _NHY>16
      Return
   End If
End If
_NEXTID=_NEXTID+1 : _CID=_NEXTID
_ALIVE(_CID)=1 : _TYPE(_CID)=_NK
_BN1(_CID)=_NB1 : _BN2(_CID)=_NB2
_IC1(_CID)=_NI1 : _IC2(_CID)=_NI2
_FRAME(_CID)=1
_OX(_CID)=_NX : _OY(_CID)=_NY
_HX(_CID)=_NHX : _HY(_CID)=_NHY
_OZ(_CID)=_NZ : _VISIBLE(_CID)=_NV
_OMODE(_CID)=_NM : _MOTION(_CID)=_NA
_CREATECOUNT=_CREATECOUNT+1
Return

_SET_FRAME:
_OP=0
If _TARGET<1 or _TARGET>_NEXTID
   Return
End If
If _ALIVE(_TARGET)<>1
   Return
End If
If _NEWFRAME<1 or _NEWFRAME>2
   Return
End If
_FRAME(_TARGET)=_NEWFRAME
_OP=1
Return

_SET_VISIBLE:
_OP=0
If _TARGET<1 or _TARGET>_NEXTID
   Return
End If
If _ALIVE(_TARGET)<>1
   Return
End If
If _NEWVIS<>0 and _NEWVIS<>1
   Return
End If
_VISIBLE(_TARGET)=_NEWVIS
_OP=1
Return

_MOVE_OBJ:
_OP=0
If _TARGET<1 or _TARGET>_NEXTID
   Return
End If
If _ALIVE(_TARGET)<>1
   Return
End If
If _NEWX<-512 or _NEWX>512 or _NEWY<-512 or _NEWY>512
   Return
End If
_OX(_TARGET)=_NEWX : _OY(_TARGET)=_NEWY
_OP=1
Return

_DELETE_OBJ:
_OP=0
If _TARGET<1 or _TARGET>_NEXTID
   Return
End If
If _ALIVE(_TARGET)<>1
   Return
End If
' Refuse deletion of AMAL-bound objects until channel detach is designed.
If _MOTION(_TARGET)<>0
   Return
End If
_ALIVE(_TARGET)=0 : _VISIBLE(_TARGET)=0
_OP=1
Return

_SORT_OBJECTS:
_COUNT=0
For _I=1 To _NEXTID
   If _ALIVE(_I)=1 and _VISIBLE(_I)=1
      _COUNT=_COUNT+1
      _ORDER(_COUNT)=_I
   End If
Next _I
' Explicit (Z, ID) ordering; even swapping is stable on equal Z.
If _COUNT>=2
   For _SI=1 To _COUNT-1
      For _SJ=_SI+1 To _COUNT
         _A=_ORDER(_SI) : _B=_ORDER(_SJ)
         If _OZ(_A)>_OZ(_B) or (_OZ(_A)=_OZ(_B) and _A>_B)
            _ORDER(_SI)=_B : _ORDER(_SJ)=_A
         End If
      Next _SJ
   Next _SI
End If
Return

_RENDER_OBJECTS:
_ROK=0 : _DRAWN=0
_BG=0
For _TRY=1 To 12
   If _BG=0
      _BG=Aga Blit Fill(0,0,320,256,1)
   End If
   If _BG=0
      Aga Wait Vbl
   End If
Next _TRY
If _BG<>1
   Return
End If
Gosub _SORT_OBJECTS
If _COUNT>=1
   For _DRAW=1 To _COUNT
      _ID=_ORDER(_DRAW)
      _PX=_OX(_ID)-_HX(_ID) : _PY=_OY(_ID)-_HY(_ID)
      _W=24 : _H=24
      If _TYPE(_ID)=2
         _W=16 : _H=16
      End If
      If _PX+_W<=0 or _PX>=320 or _PY+_H<=0 or _PY>=256
         _CULLED=_CULLED+1
      Else
         _SOURCE=_BN1(_ID) : _ICONID=_IC1(_ID)
         If _FRAME(_ID)=2
            _SOURCE=_BN2(_ID) : _ICONID=_IC2(_ID)
         End If
         If Length(_SOURCE)=0
            Return
         End If
         If _TYPE(_ID)=1
            _DRAWOK=Aga Bank Image Draw(_SOURCE,_PX,_PY,_OMODE(_ID))
         Else
            _DRAWOK=Aga F Icon(_SOURCE,_ICONID,_PX,_PY,_OMODE(_ID))
         End If
         If _DRAWOK<>1
            Return
         End If
         _DRAWN=_DRAWN+1
         _DRAWS=_DRAWS+1
      End If
   Next _DRAW
End If
_ROK=1
Return
