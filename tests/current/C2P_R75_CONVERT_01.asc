' R75 C2P full-frame interpreted WinUAE Gate B, not a Compiler test.
' Install R75 AMOSPro_AGA.Lib and LIBS:c2p.library before import.
' Bank 12 must be free. No GDB or PowerShell.
Cls
Print "C2P-R75-CONVERT-01"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_CF0=Chip Free
_NOS=Aga C2P Convert
_RESULT=1
If _NOS<>0
   _RESULT=0
End If
Reserve As Data 12,81920
_LEN=Length(12)
_PTR=Start(12)
If _LEN<>81920
   _RESULT=0
End If
' Fill a full 8-bit chunky test image once. Lower depth truncates high bits.
For _I=0 To 81919
   Poke _PTR+_I,_I Mod 256
Next _I
_COL=16
For _DEPTH=4 To 8
   _OPEN=Aga Screen Open(320,256,_COL,$00021000)
   _DB=0 : _C2P=0 : _CV0=0 : _SW0=0 : _CV1=0 : _SW1=0
   If _OPEN=1
      _DB=Aga Double Buffer
      For _I=0 To _COL-1
         _R=(_I*5) Mod 256
         _G=(_I*3) Mod 256
         _B=(_I*7) Mod 256
         _PAL=Aga Palette Set(_I,_R,_G,_B)
         If _PAL<>1
            _RESULT=0
         End If
      Next _I
      If _DB=1
         _C2P=Aga C2P Open(12)
         If _C2P=1
            _T=0
            Repeat
               _CV0=Aga C2P Convert
               _T=_T+1
               If _CV0=0
                  Aga Wait Vbl
               End If
            Until _CV0=1 or _T>=60
            _T=0
            Repeat
               _SW0=Aga Swap
               _T=_T+1
               If _SW0=0
                  Aga Wait Vbl
               End If
            Until _SW0=1 or _T>=60
            ' Modify chunky source: a solid stripe should appear on frame 2.
            For _Y=120 To 135
               For _X=0 To 319
                  Poke _PTR+_Y*320+_X,_COL-1
               Next _X
            Next _Y
            _T=0
            Repeat
               _CV1=Aga C2P Convert
               _T=_T+1
               If _CV1=0
                  Aga Wait Vbl
               End If
            Until _CV1=1 or _T>=60
            _T=0
            Repeat
               _SW1=Aga Swap
               _T=_T+1
               If _SW1=0
                  Aga Wait Vbl
               End If
            Until _SW1=1 or _T>=60
            If _COL=256
               ' Hold the final palette until ESC; Alt+Tab must not terminate.
               _K=-1
               Repeat
                  _K=Aga Key
                  Aga Wait Vbl
               Until _K=69
            Else
               For _I=1 To 30
                  Aga Wait Vbl
               Next _I
            End If
         End If
      End If
      Aga Screen Close
      Amos To Front
   End If
   _POST=Aga C2P Convert
   Print "COL ";_COL;" O/DB/C ";_OPEN;" ";_DB;" ";_C2P
   Print "CONV/SW 1 ";_CV0;" ";_SW0;" 2 ";_CV1;" ";_SW1;" POST ";_POST
   If _OPEN<>1 or _DB<>1 or _C2P<>1 or _CV0<>1 or _SW0<>1
      _RESULT=0
   End If
   If _CV1<>1 or _SW1<>1 or _POST<>0
      _RESULT=0
   End If
   _COL=_COL*2
Next _DEPTH
Erase 12
_CF1=Chip Free
Print "NOS ";_NOS;" CHIP BEFORE/AFTER ";_CF0;" ";_CF1
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
