' M15-R40-PLOT-01 : Gate B AMOS interpreted / WinUAE (NOT YET TESTED).
' Requires the new R40 0.11.1 candidate, not R38 LAST_GOOD.
' Plot must touch only the AGA back buffer and respect Safe; no IFF needed.
Cls
Print "M15-R40-PLOT-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_C0=Aga Palette Set(0,8,16,32)
_C1=Aga Palette Set(1,255,255,248)
_C2=Aga Palette Set(2,255,175,32)
_C3=Aga Palette Set(3,40,240,180)
_CLR=Aga Blit Clear(0,0,320,256)
_H=Aga Text(24,34,1,"M15 R40 - AGA PLOT")
_S=Aga Text(24,231,1,"192 PIXELS - 2 DIAGONALS")
_P00=Aga Plot(0,0,1)
_P10=Aga Plot(319,0,1)
_P01=Aga Plot(0,255,1)
_P11=Aga Plot(319,255,1)
_MID=Aga Plot(160,128,1)
_ZERO=Aga Plot(12,50,0)
_BADX=Aga Plot(-1,32,1)
_BADY=Aga Plot(16,-1,1)
_BADW=Aga Plot(320,100,1)
_BADH=Aga Plot(20,256,1)
_BADP=Aga Plot(12,36,256)
_BADN=Aga Plot(14,37,-1)
_ERR=0
For _I=0 To 95
   _A=Aga Plot(112+_I,80+_I,2)
   _B=Aga Plot(112+_I,175-_I,3)
   If _A<>1 or _B<>1
      _ERR=_ERR+1
   End If
Next _I
_SW=Aga Swap
If _SW=1
   Amos To Back
End If
' Back-buffer ownership must be Safe again after the first swap.
_BACK=0
For _I=1 To 30
   If _BACK=0
      _BACK=Aga Plot(160,128,1)
   End If
   Aga Wait Vbl
Next _I
For _I=1 To 135
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Plot(0,0,1)
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _C0<>1 or _C1<>1 or _C2<>1 or _C3<>1
   _RESULT=0
End If
If _CLR<>1 or _H<>1 or _S<>1
   _RESULT=0
End If
If _P00<>1 or _P10<>1 or _P01<>1 or _P11<>1 or _MID<>1
   _RESULT=0
End If
If _ZERO<>1 or _ERR<>0 or _SW<>1 or _BACK<>1
   _RESULT=0
End If
If _BADX<>0 or _BADY<>0 or _BADW<>0 or _BADH<>0
   _RESULT=0
End If
If _BADP<>0 or _BADN<>0 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Print "M15-R40-PLOT-01"
Print "OPEN ";_OPEN;" DB ";_DB;" CLEAR ";_CLR
Print "PALETTE ";_C0;" ";_C1;" ";_C2;" ";_C3
Print "CORNERS ";_P00;" ";_P10;" ";_P01;" ";_P11
Print "CENTER ";_MID;" PEN0 ";_ZERO
Print "DIAG 192 ERR ";_ERR
Print "BADXY ";_BADX;" ";_BADY;" ";_BADW;" ";_BADH
Print "BADPEN ";_BADP;" ";_BADN
Print "SWAP ";_SW;" BACKSAFE ";_BACK
Print "NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
