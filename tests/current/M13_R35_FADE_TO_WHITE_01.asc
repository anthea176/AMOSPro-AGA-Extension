' M13-R35-FADE-WHITE-01 - WinUAE Gate B only AFTER R35 Gate A PASS.
' Needs R35 0.10.7 candidate in APSystem, same slot, restart AMOS.
' Does NOT use or replace any AMOS bank or ABK.
' Draw + Aga Swap + Amos To Back BEFORE the slow 150-VBL fade.
Cls
Print "M13-R35-FADE-WHITE-01"
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_CLR=Aga Blit Clear(0,0,320,256)
_BOX0=Aga Blit Fill(12,20,296,90,28)
_BOX1=Aga Blit Fill(12,120,296,50,29)
_BOX2=Aga Blit Fill(12,180,296,50,30)
_P28=Aga Palette Set(28,255,0,0)
_P29=Aga Palette Set(29,0,255,0)
_P30=Aga Palette Set(30,0,0,255)
_P224=Aga Palette Set(224,21,43,65)
_FIRST=Aga Palette Get(28)
_SWAP=Aga Swap
If _SWAP<>1
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED"
   End
End If
Amos To Back
For _I=1 To 75
   Aga Wait Vbl
Next _I
' ALL indexed pens must go white; white shown for 75 more VBL.
_FADE150=Aga Fade To White(150)
_W28=Aga Palette Get(28)
_W29=Aga Palette Get(29)
_W30=Aga Palette Get(30)
_W224=Aga Palette Get(224)
For _I=1 To 75
   Aga Wait Vbl
Next _I
' Invalid durations must not modify the current palette.
_RESET=Aga Palette Set(28,120,200,40)
_BEFOREBAD=Aga Palette Get(28)
_BAD0=Aga Fade To White(0)
_BAD256=Aga Fade To White(256)
_BADNEG=Aga Fade To White(-1)
_BADL=Aga Fade To White(65536)
_AFTERBAD=Aga Palette Get(28)
' Duration 1 must produce exact white after one VBL.
_FADE1=Aga Fade To White(1)
_ONE=Aga Palette Get(28)
' Duration 2, then already-white idempotency.
_RESTORE=Aga Palette Set(28,255,255,0)
_FADE2=Aga Fade To White(2)
_TWO=Aga Palette Get(28)
_SAME=Aga Fade To White(3)
_SAME28=Aga Palette Get(28)
For _I=1 To 40
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Fade To White(3)
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _CLR<>1 or _SWAP<>1
   _RESULT=0
End If
If _BOX0<>1 or _BOX1<>1 or _BOX2<>1
   _RESULT=0
End If
If _P28<>1 or _P29<>1 or _P30<>1 or _P224<>1
   _RESULT=0
End If
If _FIRST<>16711680
   _RESULT=0
End If
If _FADE150<>1 or _W28<>16777215 or _W29<>16777215 or _W30<>16777215 or _W224<>16777215
   _RESULT=0
End If
If _RESET<>1 or _BEFOREBAD<>7915560 or _AFTERBAD<>_BEFOREBAD
   _RESULT=0
End If
If _BAD0<>0 or _BAD256<>0 or _BADNEG<>0 or _BADL<>0
   _RESULT=0
End If
If _FADE1<>1 or _ONE<>16777215 or _RESTORE<>1
   _RESULT=0
End If
If _FADE2<>1 or _TWO<>16777215 or _SAME<>1 or _SAME28<>16777215
   _RESULT=0
End If
If _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Print "M13-R35-FADE-WHITE-01"
Print "OPEN ";_OPEN;" DB ";_DB;" DRAW ";_BOX0;" ";_BOX1;" ";_BOX2
Print "FADE150 ";_FADE150;" WHITE ";_W28;" ";_W29
Print "WHITE2 ";_W30;" ";_W224
Print "BAD0 ";_BAD0;" BAD256 ";_BAD256;" BADNEG ";_BADNEG;" BADL ";_BADL
Print "BEFOREBAD ";_BEFOREBAD;" AFTERBAD ";_AFTERBAD
Print "FADE1 ";_FADE1;" ONE ";_ONE;" FADE2 ";_FADE2;" TWO ";_TWO
Print "SAME ";_SAME;" SAME28 ";_SAME28
Print "NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
