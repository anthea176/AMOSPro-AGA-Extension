' R79 C2P Zoom nearest-neighbour, Blit and Close, Gate B.
' RAM: text lifecycle log, mode and Exec CPU (new R79 test unvalidated).
' Install R79 and LIBS:c2p.library; banks 12 and 13 must be free.
_PRG_STATE=Prg State
_EXEC_MODE$="UNKNOWN"
_LOGFILE$="RAM:C2P_R79_UNKNOWN.TXT"
If _PRG_STATE=0
   _EXEC_MODE$="INTERPRETED"
   _LOGFILE$="RAM:C2P_R79_INTERPRETED.TXT"
End If
If _PRG_STATE=-1
   _EXEC_MODE$="COMPILED"
   _LOGFILE$="RAM:C2P_R79_COMPILED.TXT"
End If
If _PRG_STATE=1
   _EXEC_MODE$="RUNTIME"
   _LOGFILE$="RAM:C2P_R79_RUNTIME.TXT"
End If
' CPU from ExecBase.AttnFlags UWORD at offset 296.
_CPU$="UNKNOWN"
_CPUFLAGS=0
_SYSBASE=Leek(4)
If _SYSBASE<>0
   _CPUFLAGS=Deek(_SYSBASE+296)
   _CPU$="68000"
   If (_CPUFLAGS And 1)<>0
      _CPU$="68010"
   End If
   If (_CPUFLAGS And 2)<>0
      _CPU$="68020"
   End If
   If (_CPUFLAGS And 4)<>0
      _CPU$="68030"
   End If
   If (_CPUFLAGS And 8)<>0
      _CPU$="68040"
   End If
   If (_CPUFLAGS And 128)<>0
      _CPU$="68060"
   End If
End If
_CF0=Chip Free
_FF0=Fast Free
_RESULT=1
_ERR=0
_NOS=0
_PASSCOUNT=0
_FAILCOL=0
_CLOSE_COUNT=0
_DEPTH_TESTED=0
_C2PCLOSE_OK=0
_EMPTYCLOSE_OK=0
_REOPEN_OK=0
_BLIT_COPY_OK=0
_BLIT_PIXEL_OK=0
_BLIT_REJECT_OK=0
_BLIT_REOPEN_OK=0
_ZOOM_COPY_OK=0
_ZOOM_PIXEL_OK=0
_ZOOM_REJECT_OK=0
_ZOOM_REOPEN_OK=0
Cls
Print "C2P-R79-ZOOM-01"
Print "MODE ";_EXEC_MODE$;" CPU ";_CPU$
If Aga Detect=0
   Print "AGA NOT DETECTED"
   _RESULT=0
   _ERR=1
   Goto FINALIZE
End If
_NOS=Aga C2P Convert
If _NOS<>0
   _RESULT=0
End If
Reserve As Data 12,81920
_LEN=Length(12)
_PTR=Start(12)
If _LEN<>81920
   _RESULT=0
   _ERR=2
   Erase 12
   Goto FINALIZE
End If
' Fill a full 8-bit chunky test image once. Lower depth truncates high bits.
For _I=0 To 81919
   Poke _PTR+_I,_I Mod 256
Next _I
' An independent 32x32, 8-bit indexed source DATA bank.
Reserve As Data 13,1024
If Length(13)<>1024
   _RESULT=0
   _ERR=3
   Erase 13
   Erase 12
   Goto FINALIZE
End If
_SPRITE=Start(13)
For _Y=0 To 31
   For _X=0 To 31
      Poke _SPRITE+_Y*32+_X,(_X+_Y*5) Mod 256
   Next _X
Next _Y
Poke _SPRITE,0
_COL=16
For _DEPTH=4 To 8
   _DEPTH_TESTED=_DEPTH_TESTED+1
   _OPEN=Aga Screen Open(320,256,_COL,$00021000)
   _DB=0 : _C2P=0 : _CV0=0 : _SW0=0 : _CV1=0 : _SW1=0
   _CL1=0 : _CL2=-1 : _CL3=0 : _DEAD=-1 : _REOPEN=0 : _CV2=0 : _SW2=0 : _POSTCL=-1
   _BL_OK=0 : _BL_PIX=0 : _BL_BAD=0 : _BL_AGAIN=0 : _BL_DEAD=-1 : _BL_POST=-1
   _Z_OK=0 : _Z_PIX=0 : _Z_BAD=0 : _Z_AGAIN=0 : _Z_DEAD=-1 : _Z_POST=-1
   If _OPEN=1
      _DB=Aga Double Buffer
      For _I=0 To _COL-1
         _R=(_I*5) Mod 256
         _G=(_I*3) Mod 256
         _B=(_I*7) Mod 256
         _PAL=Aga Palette Set(_I,_R,_G,_B)
         If _PAL<>1
            _RESULT=0
         End If
      Next _I
      If _DB=1
         _C2P=Aga C2P Open(12)
         If _C2P=1
            ' Five opaque 8-bit blits including all four clipped edges.
            Poke _PTR+80*320+140,_COL-1
            _B0=Aga C2P Blit(13,32,0,0,32,32,140,80)
            _BLEFT=Aga C2P Blit(13,32,0,0,32,32,-7,20)
            _BRIGHT=Aga C2P Blit(13,32,0,0,32,32,315,45)
            _BTOP=Aga C2P Blit(13,32,0,0,32,32,20,-9)
            _BBOTTOM=Aga C2P Blit(13,32,0,0,32,32,230,252)
            If _B0=1 and _BLEFT=1 and _BRIGHT=1 and _BTOP=1 and _BBOTTOM=1
               _BL_OK=1
               _BLIT_COPY_OK=_BLIT_COPY_OK+1
            End If
            ' Exact chunky pixels including opaque palette index zero.
            If Peek(_PTR+80*320+140)=0 and Peek(_PTR+80*320+141)=1
               If Peek(_PTR+20*320)=7 and Peek(_PTR+45*320+319)=4
                  If Peek(_PTR+20)=45 and Peek(_PTR+255*320+230)=15
                     _BL_PIX=1
                     _BLIT_PIXEL_OK=_BLIT_PIXEL_OK+1
                  End If
               End If
            End If
            _TESTPIX=Peek(_PTR+4*320+4)
            _BAD1=Aga C2P Blit(12,320,0,0,32,32,4,4)
            _BAD2=Aga C2P Blit(13,32,20,0,20,32,4,4)
            _BAD3=Aga C2P Blit(14,32,0,0,32,32,4,4)
            _BAD4=Aga C2P Blit(13,0,0,0,32,32,4,4)
            _BAD5=Aga C2P Blit(13,32,0,0,32,32,320,4)
            If _BAD1=0 and _BAD2=0 and _BAD3=0 and _BAD4=0 and _BAD5=0
               If Peek(_PTR+4*320+4)=_TESTPIX
                  _BL_BAD=1
                  _BLIT_REJECT_OK=_BLIT_REJECT_OK+1
               End If
            End If
            ' Zoom samples preserve the original destination rectangle.
            Poke _PTR+32*320+96,_COL-1
            _ZUP=Aga C2P Zoom(13,32,0,0,32,32,96,32,64,64)
            _ZDOWN=Aga C2P Zoom(13,32,0,0,32,32,200,100,16,16)
            _ZNONINT=Aga C2P Zoom(13,32,3,7,13,11,40,190,29,7)
            _ZLEFT=Aga C2P Zoom(13,32,0,0,32,32,-8,80,64,64)
            _ZTOP=Aga C2P Zoom(13,32,0,0,32,32,10,-8,64,64)
            _ZRIGHT=Aga C2P Zoom(13,32,0,0,32,32,300,150,64,64)
            _ZBOTTOM=Aga C2P Zoom(13,32,0,0,32,32,250,230,64,64)
            If _ZUP=1 and _ZDOWN=1 and _ZNONINT=1 and _ZLEFT=1
               If _ZTOP=1 and _ZRIGHT=1 and _ZBOTTOM=1
                  _Z_OK=1
                  _ZOOM_COPY_OK=_ZOOM_COPY_OK+1
               End If
            End If
            ' Check nearest-neighbour pixels, original scales, index zero.
            _ZPIX1=0 : _ZPIX2=0 : _ZPIX3=0 : _ZPIX4=0
            If Peek(_PTR+32*320+96)=0 and Peek(_PTR+32*320+97)=0
               If Peek(_PTR+32*320+98)=1 and Peek(_PTR+34*320+98)=6
                  _ZPIX1=1
               End If
            End If
            If Peek(_PTR+100*320+201)=2 and Peek(_PTR+101*320+200)=10
               If Peek(_PTR+190*320+40)=38 and Peek(_PTR+196*320+68)=95
                  _ZPIX2=1
               End If
            End If
            If Peek(_PTR+80*320)=4 and Peek(_PTR+82*320)=9
               If Peek(_PTR+10)=20 and Peek(_PTR+12)=21
                  _ZPIX3=1
               End If
            End If
            If Peek(_PTR+150*320+319)=9 and Peek(_PTR+255*320+250)=60
               _ZPIX4=1
            End If
            If _ZPIX1=1 and _ZPIX2=1 and _ZPIX3=1 and _ZPIX4=1
               _Z_PIX=1
               _ZOOM_PIXEL_OK=_ZOOM_PIXEL_OK+1
            End If
            ' Invalid parameters and banks must never modify target pixels.
            _ZTESTPIX=Peek(_PTR+4*320+4)
            _ZBAD1=Aga C2P Zoom(12,320,0,0,32,32,10,10,64,64)
            _ZBAD2=Aga C2P Zoom(13,32,20,0,20,32,10,10,64,64)
            _ZBAD3=Aga C2P Zoom(14,32,0,0,32,32,10,10,64,64)
            _ZBAD4=Aga C2P Zoom(13,0,0,0,32,32,10,10,64,64)
            _ZBAD5=Aga C2P Zoom(13,32,0,0,32,32,-319,10,64,64)
            _ZBAD6=Aga C2P Zoom(13,32,0,0,32,32,10,10,0,64)
            If _ZBAD1=0 and _ZBAD2=0 and _ZBAD3=0
               If _ZBAD4=0 and _ZBAD5=0 and _ZBAD6=0
                  If Peek(_PTR+4*320+4)=_ZTESTPIX
                     _Z_BAD=1
                     _ZOOM_REJECT_OK=_ZOOM_REJECT_OK+1
                  End If
               End If
            End If
            _T=0
            Repeat
               _CV0=Aga C2P Convert
               _T=_T+1
               If _CV0=0
                  Aga Wait Vbl
               End If
            Until _CV0=1 or _T>=60
            _T=0
            Repeat
               _SW0=Aga Swap
               _T=_T+1
               If _SW0=0
                  Aga Wait Vbl
               End If
            Until _SW0=1 or _T>=60
            ' Modify chunky source: a solid stripe should appear on frame 2.
            For _Y=120 To 135
               For _X=0 To 319
                  Poke _PTR+_Y*320+_X,_COL-1
               Next _X
            Next _Y
            _T=0
            Repeat
               _CV1=Aga C2P Convert
               _T=_T+1
               If _CV1=0
                  Aga Wait Vbl
               End If
            Until _CV1=1 or _T>=60
            _T=0
            Repeat
               _SW1=Aga Swap
               _T=_T+1
               If _SW1=0
                  Aga Wait Vbl
               End If
            Until _SW1=1 or _T>=60
            ' Close C2P WITHOUT closing AGA screen; double Close must return 0.
            _CL1=Aga C2P Close
            _DEAD=Aga C2P Convert
            _BL_DEAD=Aga C2P Blit(13,32,0,0,16,16,40,40)
            _Z_DEAD=Aga C2P Zoom(13,32,0,0,16,16,40,40,32,32)
            _CL2=Aga C2P Close
            _REOPEN=Aga C2P Open(12)
            If _REOPEN=1
               _BL_AGAIN=Aga C2P Blit(13,32,0,0,32,32,260,50)
               _Z_AGAIN=Aga C2P Zoom(13,32,0,0,32,32,176,168,48,48)
               If _Z_AGAIN=1
                  _ZOOM_REOPEN_OK=_ZOOM_REOPEN_OK+1
               End If
               If _BL_AGAIN=1
                  _BLIT_REOPEN_OK=_BLIT_REOPEN_OK+1
               End If
               _T=0
               Repeat
                  _CV2=Aga C2P Convert
                  _T=_T+1
                  If _CV2=0
                     Aga Wait Vbl
                  End If
               Until _CV2=1 or _T>=60
               If _CV2=1
                  _T=0
                  Repeat
                     _SW2=Aga Swap
                     _T=_T+1
                     If _SW2=0
                        Aga Wait Vbl
                     End If
                  Until _SW2=1 or _T>=60
               End If
            End If
            _CL3=Aga C2P Close
            If _CL1=1 and _CL3=1
               _C2PCLOSE_OK=_C2PCLOSE_OK+1
            End If
            If _CL2=0 and _DEAD=0
               _EMPTYCLOSE_OK=_EMPTYCLOSE_OK+1
            End If
            If _REOPEN=1 and _CV2=1 and _SW2=1
               _REOPEN_OK=_REOPEN_OK+1
            End If
            ' Reveal the AGA Intuition screen before reading Aga Key.
            ' AMOS had been left in front after earlier test depths.
            Amos To Back
            If _COL=256
               ' AGA is now in front; ESC must reach Aga Key.
               _K=-1
               Repeat
                  _K=Aga Key
                  Aga Wait Vbl
               Until _K=69
            Else
               For _I=1 To 30
                  Aga Wait Vbl
               Next _I
            End If
         End If
      End If
      Aga Screen Close
      _CLOSE_COUNT=_CLOSE_COUNT+1
      Amos To Front
   End If
   _POST=Aga C2P Convert
   _POSTCL=Aga C2P Close
   _BL_POST=Aga C2P Blit(13,32,0,0,16,16,40,40)
   _Z_POST=Aga C2P Zoom(13,32,0,0,16,16,40,40,32,32)
   Print "COL ";_COL;" O/DB/C ";_OPEN;" ";_DB;" ";_C2P
   Print "CONV/SW 1 ";_CV0;" ";_SW0;" 2 ";_CV1;" ";_SW1;" 3 ";_CV2;" ";_SW2
   Print "CL/DEAD/CL/REOPEN/CL ";_CL1;" ";_DEAD;" ";_CL2;" ";_REOPEN;" ";_CL3
   Print "POST CONVERT/CLOSE/BLIT ";_POST;" ";_POSTCL;" ";_BL_POST
   Print "BLIT COPY/PIX/REJECT/REOPEN ";_BL_OK;" ";_BL_PIX;" ";_BL_BAD;" ";_BL_AGAIN
   Print "ZOOM COPY/PIX/REJECT/REOPEN ";_Z_OK;" ";_Z_PIX;" ";_Z_BAD;" ";_Z_AGAIN
   _DEPTH_OK=1
   If _OPEN<>1 or _DB<>1 or _C2P<>1 or _CV0<>1 or _SW0<>1
      _DEPTH_OK=0
   End If
   If _CV1<>1 or _SW1<>1 or _CV2<>1 or _SW2<>1
      _DEPTH_OK=0
   End If
   If _CL1<>1 or _DEAD<>0 or _CL2<>0 or _REOPEN<>1 or _CL3<>1
      _DEPTH_OK=0
   End If
   If _POST<>0 or _POSTCL<>0 or _BL_POST<>0 or _BL_DEAD<>0
      _DEPTH_OK=0
   End If
   If _BL_OK<>1 or _BL_PIX<>1 or _BL_BAD<>1 or _BL_AGAIN<>1
      _DEPTH_OK=0
   End If
   If _Z_OK<>1 or _Z_PIX<>1 or _Z_BAD<>1 or _Z_AGAIN<>1
      _DEPTH_OK=0
   End If
   If _Z_DEAD<>0 or _Z_POST<>0
      _DEPTH_OK=0
   End If
   If _DEPTH_OK=0
      _RESULT=0
      If _FAILCOL=0
         _FAILCOL=_COL
      End If
   Else
      _PASSCOUNT=_PASSCOUNT+1
   End If
   _COL=_COL*2
Next _DEPTH
Erase 13
Erase 12
FINALIZE:
' All measurements are obtained BEFORE RAM: file I/O.
_CF1=Chip Free
_FF1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
_LOGERR=0
_CLOSEERR=0
Trap Open Out 1,_LOGFILE$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST C2P-R79-ZOOM-01"
   Print #1,"VERSION R79 V0.13.24 CANDIDATE"
   Print #1,"RUN_MODE ";_EXEC_MODE$
   Print #1,"PRG_STATE ";_PRG_STATE
   Print #1,"CPU ";_CPU$
   Print #1,"CPU_ATTNFLAGS ";_CPUFLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"DEPTH_TESTED ";_DEPTH_TESTED
   Print #1,"PASS_DEPTH ";_PASSCOUNT
   Print #1,"FAIL_DEPTH ";_FAILCOL
   Print #1,"CLOSE_COUNT ";_CLOSE_COUNT
   Print #1,"C2P_CLOSE_OK ";_C2PCLOSE_OK
   Print #1,"EMPTY_CLOSE_OK ";_EMPTYCLOSE_OK
   Print #1,"REOPEN_OK ";_REOPEN_OK
   Print #1,"BLIT_COPY_OK ";_BLIT_COPY_OK
   Print #1,"BLIT_PIXEL_OK ";_BLIT_PIXEL_OK
   Print #1,"BLIT_REJECT_OK ";_BLIT_REJECT_OK
   Print #1,"BLIT_REOPEN_OK ";_BLIT_REOPEN_OK
   Print #1,"ZOOM_COPY_OK ";_ZOOM_COPY_OK
   Print #1,"ZOOM_PIXEL_OK ";_ZOOM_PIXEL_OK
   Print #1,"ZOOM_REJECT_OK ";_ZOOM_REJECT_OK
   Print #1,"ZOOM_REOPEN_OK ";_ZOOM_REOPEN_OK
   Print #1,"ERR ";_ERR
   Print #1,"NOS ";_NOS
   Print #1,"CHIP_BEFORE ";_CF0
   Print #1,"CHIP_AFTER ";_CF1
   Print #1,"CHIP_DELTA ";_CF0-_CF1
   Print #1,"FAST_BEFORE ";_FF0
   Print #1,"FAST_AFTER ";_FF1
   Print #1,"FAST_DELTA ";_FF0-_FF1
   Print #1,"CLOSE_RETURNED ";_CLOSE_COUNT
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Cls
Print "C2P-R79-ZOOM-01"
Print "MODE ";_EXEC_MODE$;" CPU ";_CPU$;" PRG STATE ";_PRG_STATE
Print "NOS ";_NOS;" PASS DEPTH ";_PASSCOUNT;" FAIL DEPTH ";_FAILCOL
Print "CHIP BEFORE/AFTER ";_CF0;" ";_CF1
Print "FAST BEFORE/AFTER ";_FF0;" ";_FF1
Print "SCREEN CLOSE ";_CLOSE_COUNT;" C2P CLOSE ";_C2PCLOSE_OK
Print "DOUBLE CLOSE ";_EMPTYCLOSE_OK;" REOPEN ";_REOPEN_OK;" ERR ";_ERR
Print "BLIT COPY/PIX/REJ/REOPEN ";_BLIT_COPY_OK;" ";_BLIT_PIXEL_OK;" ";_BLIT_REJECT_OK;" ";_BLIT_REOPEN_OK
Print "ZOOM COPY/PIX/REJ/REOPEN ";_ZOOM_COPY_OK;" ";_ZOOM_PIXEL_OK;" ";_ZOOM_REJECT_OK;" ";_ZOOM_REOPEN_OK
Print "RESULT ";_RESULT;" VERDICT ";_VERDICT$
Print "LOG FILE ";_LOGFILE$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
Print "CLOSE RETURNED"
End
