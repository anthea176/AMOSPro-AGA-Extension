' R77 C2P Close native lifecycle WinUAE Gate B; Gate C Compiler deferred.
' RAM: text lifecycle log, mode and Exec CPU (new R77 test unvalidated).
' Install R77 AMOSPro_AGA.Lib and LIBS:c2p.library; bank 12 must be free.
_PRG_STATE=Prg State
_EXEC_MODE$="UNKNOWN"
_LOGFILE$="RAM:C2P_R77_UNKNOWN.TXT"
If _PRG_STATE=0
   _EXEC_MODE$="INTERPRETED"
   _LOGFILE$="RAM:C2P_R77_INTERPRETED.TXT"
End If
If _PRG_STATE=-1
   _EXEC_MODE$="COMPILED"
   _LOGFILE$="RAM:C2P_R77_COMPILED.TXT"
End If
If _PRG_STATE=1
   _EXEC_MODE$="RUNTIME"
   _LOGFILE$="RAM:C2P_R77_RUNTIME.TXT"
End If
' CPU from ExecBase.AttnFlags UWORD at offset 296.
_CPU$="UNKNOWN"
_CPUFLAGS=0
_SYSBASE=Leek(4)
If _SYSBASE<>0
   _CPUFLAGS=Deek(_SYSBASE+296)
   _CPU$="68000"
   If (_CPUFLAGS And 1)<>0
      _CPU$="68010"
   End If
   If (_CPUFLAGS And 2)<>0
      _CPU$="68020"
   End If
   If (_CPUFLAGS And 4)<>0
      _CPU$="68030"
   End If
   If (_CPUFLAGS And 8)<>0
      _CPU$="68040"
   End If
   If (_CPUFLAGS And 128)<>0
      _CPU$="68060"
   End If
End If
_CF0=Chip Free
_FF0=Fast Free
_RESULT=1
_ERR=0
_NOS=0
_PASSCOUNT=0
_FAILCOL=0
_CLOSE_COUNT=0
_DEPTH_TESTED=0
_C2PCLOSE_OK=0
_EMPTYCLOSE_OK=0
_REOPEN_OK=0
Cls
Print "C2P-R77-CLOSE-01"
Print "MODE ";_EXEC_MODE$;" CPU ";_CPU$
If Aga Detect=0
   Print "AGA NOT DETECTED"
   _RESULT=0
   _ERR=1
   Goto FINALIZE
End If
_NOS=Aga C2P Convert
If _NOS<>0
   _RESULT=0
End If
Reserve As Data 12,81920
_LEN=Length(12)
_PTR=Start(12)
If _LEN<>81920
   _RESULT=0
   _ERR=2
   Erase 12
   Goto FINALIZE
End If
' Fill a full 8-bit chunky test image once. Lower depth truncates high bits.
For _I=0 To 81919
   Poke _PTR+_I,_I Mod 256
Next _I
_COL=16
For _DEPTH=4 To 8
   _DEPTH_TESTED=_DEPTH_TESTED+1
   _OPEN=Aga Screen Open(320,256,_COL,$00021000)
   _DB=0 : _C2P=0 : _CV0=0 : _SW0=0 : _CV1=0 : _SW1=0
   _CL1=0 : _CL2=-1 : _CL3=0 : _DEAD=-1 : _REOPEN=0 : _CV2=0 : _SW2=0 : _POSTCL=-1
   If _OPEN=1
      _DB=Aga Double Buffer
      For _I=0 To _COL-1
         _R=(_I*5) Mod 256
         _G=(_I*3) Mod 256
         _B=(_I*7) Mod 256
         _PAL=Aga Palette Set(_I,_R,_G,_B)
         If _PAL<>1
            _RESULT=0
         End If
      Next _I
      If _DB=1
         _C2P=Aga C2P Open(12)
         If _C2P=1
            _T=0
            Repeat
               _CV0=Aga C2P Convert
               _T=_T+1
               If _CV0=0
                  Aga Wait Vbl
               End If
            Until _CV0=1 or _T>=60
            _T=0
            Repeat
               _SW0=Aga Swap
               _T=_T+1
               If _SW0=0
                  Aga Wait Vbl
               End If
            Until _SW0=1 or _T>=60
            ' Modify chunky source: a solid stripe should appear on frame 2.
            For _Y=120 To 135
               For _X=0 To 319
                  Poke _PTR+_Y*320+_X,_COL-1
               Next _X
            Next _Y
            _T=0
            Repeat
               _CV1=Aga C2P Convert
               _T=_T+1
               If _CV1=0
                  Aga Wait Vbl
               End If
            Until _CV1=1 or _T>=60
            _T=0
            Repeat
               _SW1=Aga Swap
               _T=_T+1
               If _SW1=0
                  Aga Wait Vbl
               End If
            Until _SW1=1 or _T>=60
            ' Close C2P WITHOUT closing AGA screen; double Close must return 0.
            _CL1=Aga C2P Close
            _DEAD=Aga C2P Convert
            _CL2=Aga C2P Close
            _REOPEN=Aga C2P Open(12)
            If _REOPEN=1
               _T=0
               Repeat
                  _CV2=Aga C2P Convert
                  _T=_T+1
                  If _CV2=0
                     Aga Wait Vbl
                  End If
               Until _CV2=1 or _T>=60
               If _CV2=1
                  _T=0
                  Repeat
                     _SW2=Aga Swap
                     _T=_T+1
                     If _SW2=0
                        Aga Wait Vbl
                     End If
                  Until _SW2=1 or _T>=60
               End If
            End If
            _CL3=Aga C2P Close
            If _CL1=1 and _CL3=1
               _C2PCLOSE_OK=_C2PCLOSE_OK+1
            End If
            If _CL2=0 and _DEAD=0
               _EMPTYCLOSE_OK=_EMPTYCLOSE_OK+1
            End If
            If _REOPEN=1 and _CV2=1 and _SW2=1
               _REOPEN_OK=_REOPEN_OK+1
            End If
            ' Reveal the AGA Intuition screen before reading Aga Key.
            ' AMOS had been left in front after earlier test depths.
            Amos To Back
            If _COL=256
               ' AGA is now in front; ESC must reach Aga Key.
               _K=-1
               Repeat
                  _K=Aga Key
                  Aga Wait Vbl
               Until _K=69
            Else
               For _I=1 To 30
                  Aga Wait Vbl
               Next _I
            End If
         End If
      End If
      Aga Screen Close
      _CLOSE_COUNT=_CLOSE_COUNT+1
      Amos To Front
   End If
   _POST=Aga C2P Convert
   _POSTCL=Aga C2P Close
   Print "COL ";_COL;" O/DB/C ";_OPEN;" ";_DB;" ";_C2P
   Print "CONV/SW 1 ";_CV0;" ";_SW0;" 2 ";_CV1;" ";_SW1;" 3 ";_CV2;" ";_SW2
   Print "CL/DEAD/CL/REOPEN/CL ";_CL1;" ";_DEAD;" ";_CL2;" ";_REOPEN;" ";_CL3
   Print "POST CONVERT/CLOSE ";_POST;" ";_POSTCL
   _DEPTH_OK=1
   If _OPEN<>1 or _DB<>1 or _C2P<>1 or _CV0<>1 or _SW0<>1
      _DEPTH_OK=0
   End If
   If _CV1<>1 or _SW1<>1 or _CV2<>1 or _SW2<>1
      _DEPTH_OK=0
   End If
   If _CL1<>1 or _DEAD<>0 or _CL2<>0 or _REOPEN<>1 or _CL3<>1
      _DEPTH_OK=0
   End If
   If _POST<>0 or _POSTCL<>0
      _DEPTH_OK=0
   End If
   If _DEPTH_OK=0
      _RESULT=0
      If _FAILCOL=0
         _FAILCOL=_COL
      End If
   Else
      _PASSCOUNT=_PASSCOUNT+1
   End If
   _COL=_COL*2
Next _DEPTH
Erase 12
FINALIZE:
' All measurements are obtained BEFORE RAM: file I/O.
_CF1=Chip Free
_FF1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
_LOGERR=0
_CLOSEERR=0
Trap Open Out 1,_LOGFILE$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST C2P-R77-CLOSE-01"
   Print #1,"VERSION R77 V0.13.22 CANDIDATE"
   Print #1,"RUN_MODE ";_EXEC_MODE$
   Print #1,"PRG_STATE ";_PRG_STATE
   Print #1,"CPU ";_CPU$
   Print #1,"CPU_ATTNFLAGS ";_CPUFLAGS
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"DEPTH_TESTED ";_DEPTH_TESTED
   Print #1,"PASS_DEPTH ";_PASSCOUNT
   Print #1,"FAIL_DEPTH ";_FAILCOL
   Print #1,"CLOSE_COUNT ";_CLOSE_COUNT
   Print #1,"C2P_CLOSE_OK ";_C2PCLOSE_OK
   Print #1,"EMPTY_CLOSE_OK ";_EMPTYCLOSE_OK
   Print #1,"REOPEN_OK ";_REOPEN_OK
   Print #1,"ERR ";_ERR
   Print #1,"NOS ";_NOS
   Print #1,"CHIP_BEFORE ";_CF0
   Print #1,"CHIP_AFTER ";_CF1
   Print #1,"CHIP_DELTA ";_CF0-_CF1
   Print #1,"FAST_BEFORE ";_FF0
   Print #1,"FAST_AFTER ";_FF1
   Print #1,"FAST_DELTA ";_FF0-_FF1
   Print #1,"CLOSE_RETURNED ";_CLOSE_COUNT
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Cls
Print "C2P-R77-CLOSE-01"
Print "MODE ";_EXEC_MODE$;" CPU ";_CPU$;" PRG STATE ";_PRG_STATE
Print "NOS ";_NOS;" PASS DEPTH ";_PASSCOUNT;" FAIL DEPTH ";_FAILCOL
Print "CHIP BEFORE/AFTER ";_CF0;" ";_CF1
Print "FAST BEFORE/AFTER ";_FF0;" ";_FF1
Print "SCREEN CLOSE ";_CLOSE_COUNT;" C2P CLOSE ";_C2PCLOSE_OK
Print "DOUBLE CLOSE ";_EMPTYCLOSE_OK;" REOPEN ";_REOPEN_OK;" ERR ";_ERR
Print "RESULT ";_RESULT;" VERDICT ";_VERDICT$
Print "LOG FILE ";_LOGFILE$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
Print "CLOSE RETURNED"
End
