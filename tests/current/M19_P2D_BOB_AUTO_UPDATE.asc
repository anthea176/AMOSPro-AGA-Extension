' M19 P2d - auto-update, physical pages, and return to manual mode
Set Buffer 20
Cls
_OPEN=0 : _ERR=0 : _OK=0 : _CLOSE_RETURNED=0
_CHECKS=0 : _STEP=0 : _PIX=-1 : _VALUE=-1 : _EXPECTED=-1
_PROBE_PREALLOC=0 : _PRG=Prg State
_LOG$="RAM:M19_P2D_BOB_AUTO_UPDATE.TXT"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(24)<>0 or Length(25)<>0 or Length(27)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
_A=Aga Blit Fill(16,16,3,1,0)
_B=Aga Blit Fill(17,16,2,1,165)
_C=Aga Blit Fill(60,16,1,1,0)
_D=Aga Blit Fill(96,100,8,1,90)
If _A<>1 or _B<>1 or _C<>1 or _D<>1
   _ERR=5 : Goto _CLEANUP
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,18,16
Make AGA Bob Mask 1,0
Aga Bob Bank 25
Get AGA Bob 1,60,16,60,16
' Reserve the capture bank before the first Bob SET.
_PROBE_PREALLOC=Aga C Block Capture(27,96,100,8,1,0)
If _PROBE_PREALLOC<>1 or Length(27)<>56
   _ERR=6 : Goto _CLEANUP
End If
_BAD1=Aga Bob Auto Update(-1)
_BAD2=Aga Bob Auto Update(2)
If _BAD1<>0 or _BAD2<>0
   _ERR=7 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+2
_MODE=Aga Bob Auto Update(1)
If _MODE<>1
   _ERR=8 : Goto _CLEANUP
End If
' Present before the first Bob SET, then initialise the other physical page.
Gosub _PRESENT
If _ERR<>0
   Goto _CLEANUP
End If
_D=Aga Blit Fill(96,100,8,1,90)
If _D<>1
   _ERR=9 : Goto _CLEANUP
End If
Gosub _SET_BOBS
If _ERR<>0
   Goto _CLEANUP
End If
_STEP=1
_PAINTED=1
' First page uses auto-update alone. Prepare the second one explicitly.
Gosub _PRESENT
If _ERR<>0
   Goto _CLEANUP
End If
_UP=Aga Bob Update
If _UP<>1
   _ERR=10 : Goto _CLEANUP
End If
_BAD=Aga Bob Auto Update(0)
If _BAD<>0
   _ERR=11 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+1
Gosub _PRESENT
If _ERR<>0
   Goto _CLEANUP
End If
Gosub _CHECK_STRIPE
If _ERR<>0
   Goto _CLEANUP
End If
' Rotate both pages after Off, then probe each once it comes back.
_STEP=2
_PAINTED=0
Aga Bob Off 1
Aga Bob Off 2
For _FRAME=1 To 3
   Gosub _PRESENT
   If _ERR<>0
      Goto _CLEANUP
   End If
   If _FRAME>=2
      Gosub _CHECK_STRIPE
      If _ERR<>0
         Goto _CLEANUP
      End If
   End If
Next _FRAME
_STEP=3
_MODE=Aga Bob Auto Update(0)
If _MODE<>1
   _ERR=12 : Goto _CLEANUP
End If
Gosub _SET_BOBS
If _ERR<>0
   Goto _CLEANUP
End If
For _FRAME=1 To 2
   Gosub _PRESENT
   If _ERR<>0
      Goto _CLEANUP
   End If
Next _FRAME
Gosub _CHECK_STRIPE
If _ERR<>0
   Goto _CLEANUP
End If
_STEP=4
_PAINTED=1
_UP=Aga Bob Update
If _UP<>1
   _ERR=13 : Goto _CLEANUP
End If
Gosub _CHECK_STRIPE
If _ERR=0
   Gosub _PRESENT
End If
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
   If Length(24)<>0
      Erase 24
   End If
   If Length(25)<>0
      Erase 25
   End If
   If Length(27)<>0
      Erase 27
   End If
End If
If _ERR=0 and _CHECKS=43 and _CLOSE_RETURNED=1
   _OK=1
End If
_VERDICT$="FAIL"
If _OK=1
   _VERDICT$="PASS"
End If
Print "M19 P2d BOB AUTO UPDATE ";_VERDICT$;" ERR ";_ERR
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 P2D BOB AUTO UPDATE"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"PROBE_PREALLOC ";_PROBE_PREALLOC
   Print #1,"CHECKS ";_CHECKS
   Print #1,"STEP ";_STEP
   Print #1,"FRAME ";_FRAME
   Print #1,"PIXEL ";_PIX
   Print #1,"VALUE ";_VALUE
   Print #1,"EXPECTED ";_EXPECTED
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
End
_SET_BOBS:
Aga Bob Bank 24
Aga Bob 1,98,100,1
Aga Bob Bank 25
Aga Bob 2,103,100,1
_SET1=Aga Bob Planes(1,129)
_SET2=Aga Bob Planes(2,66)
If _SET1<>1 or _SET2<>1
   _ERR=14
End If
Return
_PRESENT:
_SWAP=Aga Swap
If _SWAP<>1
   _ERR=15
Else
   Aga Wait Vbl
End If
Return
_CHECK_STRIPE:
_CAP=Aga C Block Capture(27,96,100,8,1,0)
If _CAP<>1 or Length(27)<>56
   _ERR=16
Else
   _PTR=Start(27)+40 : _BIT=128
   For _PIX=0 To 7
      If _ERR=0
         _EXPECTED=90
         If _PAINTED=1
            If _PIX=3 or _PIX=4
               _EXPECTED=219
            End If
            If _PIX=7
               _EXPECTED=24
            End If
         End If
         _VALUE=0 : _PLANE_BIT=1
         For _PLANE=0 To 7
            _BYTE=Peek(_PTR+2*_PLANE)
            If (_BYTE and _BIT)<>0
               _VALUE=_VALUE+_PLANE_BIT
            End If
            _PLANE_BIT=_PLANE_BIT*2
         Next _PLANE
         If _VALUE<>_EXPECTED
            _ERR=17 : _BAD_PIXEL=_PIX
         Else
            _CHECKS=_CHECKS+1
         End If
         _BIT=_BIT/2
      End If
   Next _PIX
   If _ERR=17
      _PIX=_BAD_PIXEL
   End If
End If
Return
