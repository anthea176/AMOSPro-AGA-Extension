' M18-R63-CHIP-BLIT-01 : Gate B interpreted; Gate C once at END M18.
' R63 0.13.8 GATE A PASS; interpreted B pending; Compiler deferred.
' Requires FICON8 bank 10 and prestaged FICHIP8 Chip bank 11.
' CAUTION Load overwrites banks 10 and 11. Use disposable WinUAE.
' Format FICON8, four slots x 16x16x8, payload 1164 bytes.
Cls
Print "M18-R63-CHIP-BLIT-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
Load "M18_FICON8_SAMPLE_BANK10.abk",10
_CF_PRE11=Chip Free
_FF_PRE11=Fast Free
Load "M18_FICHIP8_SAMPLE_BANK11.abk",11
_CF_POST11=Chip Free
_FF_POST11=Fast Free
_DCHIP11=_CF_PRE11-_CF_POST11
_DFAST11=_FF_PRE11-_FF_POST11
If Start(10)=0 or Length(10)<>1164 or Start(11)=0 or Length(11)<>1168
   Print "FICON8 BANK 10 MISSING"
   End
End If
_FLAG11=Deek(Start(11)-12)
_BANK11_ADDR=Start(11)
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   Erase 11
   Erase 10
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 11
   Erase 10
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,32,48,96)
_P3=Aga Palette Set(3,255,192,64)
_P4=Aga Palette Set(255,255,255,255)
_SW0=0
For _TRY=1 To 20
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
_D0=0
_D1=0
_D2=0
_D3=0
_SHIFT=0
_CL=0
_CR=0
_CT=0
_CB=0
_OUT=0
_BADBANK=0
_BADICON=0
_BADMODE=0
_OLD=0
_SWAP=0
_B0=0 : _B1=0 : _B2=0 : _B3=0 : _BS=0
_BCL=0 : _BCR=0 : _BCT=0 : _BCB=0 : _BOUT=0
_BADCB=0 : _BADCI=0 : _BADCM=0
_BG=0
If _READY=1
   _BG=Aga Blit Fill(0,0,320,256,2)
   _D0=Aga F Icon(10,1,20,65,0)
   _D1=Aga F Icon(10,2,56,65,0)
   _D2=Aga F Icon(10,3,92,65,1)
   _D3=Aga F Icon(10,4,128,65,1)
   _SHIFT=Aga F Icon(10,3,165,67,0)
   _B0=Aga F Blit(11,1,20,115,0)
   _B1=Aga F Blit(11,2,56,115,0)
   _B2=Aga F Blit(11,3,92,115,1)
   _B3=Aga F Blit(11,4,128,115,1)
   _BS=Aga F Blit(11,3,165,117,0)
   _CL=Aga F Icon(10,4,-7,125,1)
   _CR=Aga F Icon(10,4,314,125,1)
   _CT=Aga F Icon(10,2,88,-5,0)
   _CB=Aga F Icon(10,3,124,252,0)
   _OUT=Aga F Icon(10,2,320,256,1)
   _BCL=Aga F Blit(11,4,-7,155,1)
   _BCR=Aga F Blit(11,4,314,155,1)
   _BCT=Aga F Blit(11,2,88,-5,0)
   _BCB=Aga F Blit(11,3,124,252,0)
   _BOUT=Aga F Blit(11,2,320,256,1)
   _BADCB=Aga F Blit(10,2,10,10,0)
   _BADCI=Aga F Blit(11,0,10,10,0)
   _BADCM=Aga F Blit(11,2,10,10,2)
   _BADBANK=Aga F Icon(4,2,10,10,0)
   _BADICON=Aga F Icon(10,0,10,10,0)
   _BADMODE=Aga F Icon(10,2,10,10,2)
   _OLD=Aga Image Region(10,0,0,16,16,10,10,0)
End If
For _TRY=1 To 20
   If _SWAP=0
      _SWAP=Aga Swap
   End If
   If _SWAP=0
      Aga Wait Vbl
   End If
Next _TRY
If _SWAP=1
   Amos To Back
End If
For _HOLD=1 To 125
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOS=Aga F Blit(11,2,10,10,0)
Erase 11
Erase 10
_CF1=Chip Free
_RESULT=1
If _OPEN<>1 or _DB<>1 or _SW0<>1 or _READY<>1 or _BG<>1
   _RESULT=0
End If
If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1 or _P4<>1
   _RESULT=0
End If
If _D0<>1 or _D1<>1 or _D2<>1 or _D3<>1 or _SHIFT<>1
   _RESULT=0
End If
If _CL<>1 or _CR<>1 or _CT<>1 or _CB<>1 or _OUT<>1
   _RESULT=0
End If
If _B0<>1 or _B1<>1 or _B2<>1 or _B3<>1 or _BS<>1
   _RESULT=0
End If
If _BCL<>1 or _BCR<>1 or _BCT<>1 or _BCB<>1 or _BOUT<>1
   _RESULT=0
End If
If _BADCB<>0 or _BADCI<>0 or _BADCM<>0
   _RESULT=0
End If
If _BADBANK<>0 or _BADICON<>0 or _BADMODE<>0 or _OLD<>0
   _RESULT=0
End If
If _NOS<>0 or _CLOSED<>-1 or _SWAP<>1 or _CF0<>_CF1
   _RESULT=0
End If
Cls
Print "M18-R63-CHIP-BLIT-01"
Print "R63 CHIP 256 / TEST INTERPRETED"
Print "OPEN ";_OPEN;" DB ";_DB;" SW0 ";_SW0;" SAFE ";_READY
Print "ICON ";_D0;" ";_D1;" ";_D2;" ";_D3;" S ";_SHIFT
Print "BLIT ";_B0;" ";_B1;" ";_B2;" ";_B3;" S ";_BS
Print "BCLP ";_BCL;" ";_BCR;" ";_BCT;" ";_BCB;" O ";_BOUT
Print "BCBAD ";_BADCB;" ";_BADCI;" ";_BADCM
Print "FICHIP 11 FLAGS ";_FLAG11
Print "BANK 11 START ";_BANK11_ADDR
Print "LOAD11 CHIP DELTA ";_DCHIP11
Print "LOAD11 FAST DELTA ";_DFAST11
Print "CLIP ";_CL;" ";_CR;" ";_CT;" ";_CB;" OUT ";_OUT
Print "BAD BANK/ID/MODE ";_BADBANK;" ";_BADICON;" ";_BADMODE
Print "R60 REJECT ";_OLD;" SWAP ";_SWAP;" NOS ";_NOS;" CLOSE ";_CLOSED
Print "CHIP BEFORE/END ";_CF0;" ";_CF1
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
