' M18 R66 FICHIP8 DYNAMIC CHIP CACHE - WINUAE INTERPRETED ONLY.
' Banks 11, 12, 13 MUST be free. Reserve As Data 13,256 overwrites.
' Saves RAM:M18_R66_FICHIP8.ABK; overwrites existing RAM: file.
' DO NOT use the AMOS Compiler until the final M18 gate.
Cls
Print "M18-R66-FICHIP-DYNAMIC-01"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_CF0=Chip Free : _FF0=Fast Free
_C0=Aga F Icon Bank Create(12,4)
_CFB=Chip Free
_C1=Aga F Chip Bank Create(11,4)
_CFC=Chip Free
If _C0<>1 or _C1<>1
   Print "BANK CREATE FAILED / CHECK FREE BANKS 11 12"
   End
End If
_CHIPDELTA=_CFB-_CFC
_LEN=Length(11) : _CNT=Deek(Start(11)+4)
_PTR=Start(11)
_DUP=Aga F Chip Bank Create(11,4)
_SAME=Start(11)
_BADCOUNT=Aga F Chip Bank Create(14,3)
_BADBANK=Aga F Chip Bank Create(4,4)
_R0=Peek(Start(11)+12+4*288)
_R1=Peek(Start(11)+12+4*288+1)
Reserve As Data 13,256
' First pattern: solid white, Stage first icon in cache.
For _I=0 To 255
   Poke Start(13)+_I,255
Next _I
_PUT0=Aga F Icon Bank Put(12,1,13,0)
_STAGE0=Aga F Chip Stage(12,11,1)
_OLDMASK=Deek(Start(11)+12+2)
' New source pattern, white frame + red/green diagonals, zero interior.
For _Y=0 To 15
   For _X=0 To 15
      _COL=0
      If _X=_Y
         _COL=4
      End If
      If _X=15-_Y
         _COL=5
      End If
      If _X=0 Or _X=15 Or _Y=0 Or _Y=15
         _COL=255
      End If
      Poke Start(13)+_Y*16+_X,_COL
   Next _X
Next _Y
_PUT1=Aga F Icon Bank Put(12,1,13,0)
_STALE=Deek(Start(11)+12+2)
_STAGE1=Aga F Chip Stage(12,11,1)
_NEWMASK=Deek(Start(11)+12+2)
_NEWPLANE=Deek(Start(11)+12+32+2)
_PUT2=Aga F Icon Bank Put(12,2,13,0)
_STAGE2=Aga F Chip Stage(12,11,2)
_MARK1=Peek(Start(11)+12+4*288)
_MARK2=Peek(Start(11)+12+4*288+1)
_MARK3=Peek(Start(11)+12+4*288+2)
_BADID=Aga F Chip Stage(12,11,5)
_BAD0=Aga F Chip Stage(12,11,0)
_ALIAS=Aga F Chip Stage(11,11,1)
_BADSRC=Aga F Chip Stage(4,11,1)
_BADDEST=Aga F Chip Stage(12,14,1)
_MARKCHECK=Peek(Start(11)+12+4*288)
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "AGA OPEN FAILED"
   Erase 11 : Erase 12 : Erase 13
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 11 : Erase 12 : Erase 13
   End
End If
_K0=Aga Palette Set(0,0,0,0)
_K2=Aga Palette Set(2,32,48,96)
_K4=Aga Palette Set(4,255,0,0)
_K5=Aga Palette Set(5,0,255,0)
_K255=Aga Palette Set(255,255,255,255)
_SW0=0
For _TRY=1 To 20
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
_BG=0 : _CPU=0 : _BLITM=0 : _BLITO=0 : _UNREADY=0
If _READY=1
   _BG=Aga Blit Fill(0,0,320,256,2)
   _CPU=Aga F Icon(12,1,30,60,1)
   _BLITM=Aga F Blit(11,1,90,60,1)
   _BLITO=Aga F Blit(11,2,150,60,0)
   _UNREADY=Aga F Blit(11,3,210,60,1)
End If
_SW1=0
For _TRY=1 To 20
   If _SW1=0
      _SW1=Aga Swap
   End If
   If _SW1=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW1=1
   Amos To Back
End If
' VISUAL x30 CPU transparent; x90 BLITTER transparent; x150 BLITTER opaque.
' WHITE frame, RED/GREEN diagonals. x210 unstaged must remain BLUE.
For _HOLD=1 To 125
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOS=Aga F Blit(11,1,20,20,1)
Erase 13
Erase 12
Erase 11
_CF1=Chip Free : _FF1=Fast Free
' Separate ABK persistence cycle (RAM: file affects later Free values).
_C2=Aga F Chip Bank Create(11,4)
_LPRE=Length(11)
_RPRE=Peek(Start(11)+12+4*288)
If _C2=1
   Save "RAM:M18_R66_FICHIP8.ABK",11
   Erase 11
   Load "RAM:M18_R66_FICHIP8.ABK",11
End If
_LSZ=Length(11)
_LCNT=Deek(Start(11)+4)
_LREADY=Peek(Start(11)+12+4*288)
Erase 11
_CFEND=Chip Free : _FFEND=Fast Free
_RESULT=1
If _C0<>1 or _C1<>1 or _C2<>1 or _CHIPDELTA<=0
   _RESULT=0
End If
If _LEN<>1168 or _CNT<>4 or _PTR<>_SAME
   _RESULT=0
End If
If _DUP<>0 or _BADCOUNT<>0 or _BADBANK<>0
   _RESULT=0
End If
If _R0<>0 or _R1<>0
   _RESULT=0
End If
If _PUT0<>1 or _PUT1<>1 or _PUT2<>1
   _RESULT=0
End If
If _STAGE0<>1 or _STAGE1<>1 or _STAGE2<>1
   _RESULT=0
End If
If _OLDMASK<>65535 or _STALE<>65535
   _RESULT=0
End If
If _NEWMASK<>49155 or _NEWPLANE<>32771
   _RESULT=0
End If
If _MARK1<>1 or _MARK2<>1 or _MARK3<>0 or _MARKCHECK<>1
   _RESULT=0
End If
If _BADID<>0 or _BAD0<>0 or _ALIAS<>0 or _BADSRC<>0 or _BADDEST<>0
   _RESULT=0
End If
If _OPEN<>1 or _DB<>1 or _SW0<>1 or _SW1<>1 or _READY<>1 or _BG<>1
   _RESULT=0
End If
If _K0<>1 or _K2<>1 or _K4<>1 or _K5<>1 or _K255<>1
   _RESULT=0
End If
If _CPU<>1 or _BLITM<>1 or _BLITO<>1 or _UNREADY<>0
   _RESULT=0
End If
If _NOS<>0 or _CLOSED<>-1 or _CF0<>_CF1 or _FF0<>_FF1
   _RESULT=0
End If
If _LPRE<>1168 or _RPRE<>0 or _LSZ<>1168 or _LCNT<>4 or _LREADY<>0
   _RESULT=0
End If
Cls
Print "M18-R66-FICHIP-DYNAMIC-01"
Print "CREATE FICON/CHIP ";_C0;" ";_C1;" DUP/BAD ";_DUP;" ";_BADCOUNT;" ";_BADBANK
Print "CHIP DELTA ";_CHIPDELTA;" LEN/COUNT ";_LEN;" ";_CNT
Print "STAGE INITIAL/RESTAGE/ICON2 ";_STAGE0;" ";_STAGE1;" ";_STAGE2
Print "PUT0/1/2 ";_PUT0;" ";_PUT1;" ";_PUT2
Print "OLD/STALE/NEW MASK ";_OLDMASK;" ";_STALE;" ";_NEWMASK
Print "PLANE1 ";_NEWPLANE;" READY1/2/3 ";_MARK1;" ";_MARK2;" ";_MARK3
Print "BAD ID0/5/ALIAS/SRC/DEST ";_BAD0;" ";_BADID;" ";_ALIAS;" ";_BADSRC;" ";_BADDEST
Print "OPEN/DB/SHOW ";_OPEN;" ";_DB;" ";_SW1
Print "CPU/MASKED/OPAQUE/UNREADY ";_CPU;" ";_BLITM;" ";_BLITO;" ";_UNREADY
Print "CHIP BEFORE/ERASE ";_CF0;" ";_CF1
Print "FAST BEFORE/ERASE ";_FF0;" ";_FF1
Print "ABK BEFORE/AFTER ";_LPRE;" ";_LSZ;" READY ";_RPRE;" ";_LREADY
Print "NOS/CLOSE ";_NOS;" ";_CLOSED
Print "CHIP/FAST AFTER RAM FILE ";_CFEND;" ";_FFEND
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
