' M19 P2.6 R87 - BOBS draw-only BASIC versus native Batch benchmark.
' Self-contained: creates AGAPIC v1/v2 sources by capture and FICON8 by Bank Put.
' 4/8/16 Bobs; 64 repetitions; AB then BA; no sort, VBL or Swap.
' Self-contained banks; exact same objects for both drawing methods.
Set Buffer 20
Cls
_RESULT=1 : _ERR=0 : _OPEN=0 : _CLOSED=0
_REPS=64 : _RUNS=0 : _BASIC_CALLS=0 : _BATCH_CALLS=0
_CAP=0 : _BASIC_BOBS=0 : _BATCH_BOBS=0
_BANKS_SAFE=0
Dim _OX(16),_OY(16),_SRC(16),_KIND(16),_ICON(16)
Dim _TIME(2,1,1)
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_P26_UNKNOWN.TXT"
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_P26_RUNTIME.TXT"
End If
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_P26_INTERPRETED.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_P26_COMPILED.TXT"
End If
Print "M19 P2.6 R87 BOBS DRAW BENCH"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
For _B=10 To 26
   If Length(_B)<>0
      _ERR=3 : Goto _CLEANUP
   End If
Next _B
_BANKS_SAFE=1
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto _CLEANUP
End If
If Aga Double Buffer<>1
   _ERR=5 : Goto _CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,24,32,48)
_P3=Aga Palette Set(3,240,65,45)
_P4=Aga Palette Set(4,35,205,230)
_P5=Aga Palette Set(5,250,215,70)
If _P0<>1 or _P1<>1 or _P3<>1 or _P4<>1 or _P5<>1
   _ERR=6 : Goto _CLEANUP
End If
' Build the AGAPIC v1/v2 sources exactly as in the R87 PASS smoke.
For _I=0 To 1
   _B=12+_I : _V=1+_I
   _D=Aga Blit Fill(0,0,320,256,0)
   If _D<>1
      _ERR=7 : Goto _CLEANUP
   End If
   _D=Aga Blit Fill(8,8,24,24,3+_I)
   If _D<>1
      _ERR=8 : Goto _CLEANUP
   End If
   _D=Aga Bank Image Capture(_B,0,0,40,40,0,_V)
   If _D<>1
      _ERR=9 : Goto _CLEANUP
   End If
   _CAP=_CAP+1
Next _I
' Generate FICON8 bank with 4 slots. Chunky source is a DATA bank.
Reserve As Data 10,256
' The FICON8 native creation command establishes the canonical bank.
_OK=Aga F Icon Bank Create(11,4)
If _OK<>1
   _ERR=10 : Goto _CLEANUP
End If
For _Y=0 To 15
   For _X=0 To 15
      _PIX=5
      If _X=0 or _Y=0 or _X=15 or _Y=15
         _PIX=0
      End If
      Poke Start(10)+_Y*16+_X,_PIX
   Next _X
Next _Y
_OK=Aga F Icon Bank Put(11,2,10,0)
If _OK<>1
   _ERR=11 : Goto _CLEANUP
End If

' Precompute one fixed list; both methods use these coordinates and banks.
For _I=1 To 16
   _OX(_I)=20+((_I-1) Mod 4)*44
   _OY(_I)=20+Int((_I-1)/4)*44
   _SRC(_I)=12 : _KIND(_I)=1 : _ICON(_I)=0
   If ((_I-1) Mod 3)=1
      _SRC(_I)=13
   End If
   If ((_I-1) Mod 3)=2
      _SRC(_I)=11 : _KIND(_I)=2 : _ICON(_I)=2
   End If
Next _I
' BOB1 descriptor banks. Size = 16 + Count*20 bytes exactly.
Reserve As Data 24,96
Reserve As Data 25,176
Reserve As Data 26,336
For _CASE=0 To 2
   _N=4
   If _CASE=1
      _N=8
   End If
   If _CASE=2
      _N=16
   End If
   _BN=24+_CASE : _P=Start(_BN)
   Loke _P,$424F4231 : Doke _P+4,1 : Doke _P+6,20
   Loke _P+8,_N : Loke _P+12,0
   For _I=1 To _N
      _R=_P+16+20*(_I-1)
      Loke _R,_OY(_I) : Loke _R+4,_OX(_I)
      Loke _R+8,_SRC(_I) : Loke _R+12,_ICON(_I)
      Doke _R+16,_KIND(_I) : Doke _R+18,1
   Next _I
Next _CASE
' Warm-up both APIs before timing. The source IDs/coords are valid.
_D=Aga Blit Fill(0,0,320,256,1)
If _D<>1
   _ERR=20 : Goto _CLEANUP
End If
_D=Aga Bank Image Draw(12,20,20,1)
If _D<>1
   _ERR=21 : Goto _CLEANUP
End If
_D=Aga F Icon(11,2,64,20,1)
If _D<>1
   _ERR=22 : Goto _CLEANUP
End If
_D=Aga Bob Batch(24,4)
If _D<>1
   _ERR=23 : Goto _CLEANUP
End If
' Draw-only: fill done BEFORE each timed run, no Swap or Wait Vbl.
' Two reversed passes: BASIC/BATCH then BATCH/BASIC.
For _PASS=0 To 1
   For _CASE=0 To 2
      _N=4
      If _CASE=1
         _N=8
      End If
      If _CASE=2
         _N=16
      End If
      _BN=24+_CASE
      For _ORDER=0 To 1
         _METHOD=_ORDER
         If _PASS=1
            _METHOD=1-_ORDER
         End If
         _D=Aga Blit Fill(0,0,320,256,1)
         If _D<>1
            _ERR=24 : Goto _CLEANUP
         End If
         _T0=Timer
         If _METHOD=0
            For _REP=1 To _REPS
               For _I=1 To _N
                  If _KIND(_I)=1
                     _D=Aga Bank Image Draw(_SRC(_I),_OX(_I),_OY(_I),1)
                  Else
                     _D=Aga F Icon(11,2,_OX(_I),_OY(_I),1)
                  End If
                  If _D<>1
                     _ERR=25 : Goto _CLEANUP
                  End If
               Next _I
            Next _REP
            _BASIC_CALLS=_BASIC_CALLS+_REPS*_N
            _BASIC_BOBS=_BASIC_BOBS+_REPS*_N
         Else
            For _REP=1 To _REPS
               _D=Aga Bob Batch(_BN,_N)
               If _D<>1
                  _ERR=26 : Goto _CLEANUP
               End If
            Next _REP
            _BATCH_CALLS=_BATCH_CALLS+_REPS
            _BATCH_BOBS=_BATCH_BOBS+_REPS*_N
         End If
         _TIME(_CASE,_METHOD,_PASS)=Timer-_T0
         If _TIME(_CASE,_METHOD,_PASS)<=0
            _ERR=27 : Goto _CLEANUP
         End If
         _RUNS=_RUNS+1
      Next _ORDER
   Next _CASE
Next _PASS
If _RUNS<>12 or _BASIC_BOBS<>3584 or _BATCH_BOBS<>3584
   _ERR=28 : Goto _CLEANUP
End If
If _BASIC_CALLS<>3584 or _BATCH_CALLS<>384
   _ERR=29 : Goto _CLEANUP
End If
Goto _CLEANUP

_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _BANKS_SAFE=1
   For _B=10 To 26
      If Length(_B)<>0
         Erase _B
      End If
   Next _B
End If
If _ERR=0 and (_CAP<>2 or _CLOSED<>1)
   _ERR=30
End If
If _ERR<>0
   _RESULT=0
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "R87 DRAW BENCH ";_VERDICT$;" ERR ";_ERR
Print "RUNS ";_RUNS;" BASIC ";_BASIC_CALLS;" BATCH ";_BATCH_CALLS
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P26_R87_DRAW_BENCH_01"
   Print #1,"LIBRARY_EXPECTED R87_V0.13.32"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"REPS ";_REPS
   Print #1,"BENCH_RUNS ";_RUNS
   Print #1,"BASIC_CALLS ";_BASIC_CALLS
   Print #1,"BATCH_CALLS ";_BATCH_CALLS
   Print #1,"BASIC_BOBS ";_BASIC_BOBS
   Print #1,"BATCH_BOBS ";_BATCH_BOBS
   For _CASE=0 To 2
      _N=4
      If _CASE=1
         _N=8
      End If
      If _CASE=2
         _N=16
      End If
      _BT=_TIME(_CASE,0,0)+_TIME(_CASE,0,1)
      _NT=_TIME(_CASE,1,0)+_TIME(_CASE,1,1)
      Print #1,"BOBS ";_N;" BASIC_TICKS ";_BT;" BATCH_TICKS ";_NT
      Print #1,"PASS0_N ";_N;" BASIC ";_TIME(_CASE,0,0);" BATCH ";_TIME(_CASE,1,0)
      Print #1,"PASS1_N ";_N;" BASIC ";_TIME(_CASE,0,1);" BATCH ";_TIME(_CASE,1,1)
   Next _CASE
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
