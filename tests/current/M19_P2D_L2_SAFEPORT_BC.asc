' P2d-L2 focused WinUAE probe - PREPARED, not an active campaign.
' RAM:AGA_DEMO_320x256_256c.iff = exact tests/current fixture.
Set Buffer 20
Cls
_PRG=Prg State : _ERR=0 : _OK=0 : _OPEN=0 : _OWN=0 : _PH=1
_CLOSE_RETURNED=0 : _CLOSED=-99 : _SWAPS=0 : _SWAP_REFUSALS=0
_SWAP_RECOVERED=0 : _IFF_FIRST=-1 : _IFF_RETRIES=0 : _IFF_OK=0
_FILL_OK=0 : _BIND_FIRST=-1 : _BIND_RETRIES=0 : _BIND_OK=0
_PIXEL_CHECKS=0 : _REF0=-1 : _REF1=-1 : _VALUE=-1
_LOG$="RAM:P2D_L2_INTERPRETED.TXT"
If _PRG=1
   _LOG$="RAM:P2D_L2_RUNTIME.TXT"
End If
If _PRG=-1
   _LOG$="RAM:P2D_L2_COMPILED.TXT"
End If
_FILE$="RAM:AGA_DEMO_320x256_256c.iff"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(24)<>0 or Length(27)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OWN=1
_W=Aga Pic Info(_FILE$,0) : _H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2) : _C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8 or _C<>256 or _MODE<>$00021000
   _ERR=3 : Goto _CLEANUP
End If
_CHIP0=Chip Free : _FAST0=Fast Free
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=5 : Goto _CLEANUP
End If
' Reference IFF load before the first Swap. Aligned pixel samples.
_REFLOAD=Aga Iff Load(_FILE$)
If _REFLOAD<>1
   _ERR=6 : Goto _CLEANUP
End If
_X=0 : _Y=0 : _BIT=128 : Gosub _READ_PIXEL
If _CAPOK<>1
   _ERR=7 : Goto _CLEANUP
End If
_REF0=_VALUE
_X=160 : _Y=128 : _BIT=128 : Gosub _READ_PIXEL
If _CAPOK<>1
   _ERR=7 : Goto _CLEANUP
End If
_REF1=_VALUE
_MARK=(_REF0+1) Mod 256
If _MARK=165
   _MARK=166
End If
' Seed both physical pages with a known different pen, without Bobs.
_A=Aga Blit Fill(0,0,320,256,_MARK)
If _A<>1
   _ERR=8 : Goto _CLEANUP
End If
Gosub _TRY_SWAP
If _SW<>1
   _ERR=9 : Goto _CLEANUP
End If
_A=Aga Blit Fill(0,0,320,256,_MARK)
For _TRY=1 To 4
   If _A<>1
      Aga Wait Vbl
      _A=Aga Blit Fill(0,0,320,256,_MARK)
   End If
Next _TRY
If _A<>1
   _ERR=8 : Goto _CLEANUP
End If
Gosub _TRY_SWAP
If _SW<>1
   _ERR=9 : Goto _CLEANUP
End If
' PH2: IFF is the very first operation after a successful Swap.
_PH=2
_LOAD=Aga Iff Load(_FILE$) : _IFF_FIRST=_LOAD
For _TRY=1 To 4
   If _LOAD<>1
      Aga Wait Vbl
      _IFF_RETRIES=_IFF_RETRIES+1
      _LOAD=Aga Iff Load(_FILE$)
   End If
Next _TRY
If _LOAD<>1
   _ERR=20 : Goto _CLEANUP
End If
_X=0 : _Y=0 : _BIT=128 : Gosub _READ_PIXEL
If _CAPOK<>1 or _VALUE<>_REF0
   _ERR=21 : Goto _CLEANUP
End If
_X=160 : _Y=128 : _BIT=128 : Gosub _READ_PIXEL
If _CAPOK<>1 or _VALUE<>_REF1
   _ERR=22 : Goto _CLEANUP
End If
_IFF_OK=1 : _PIXEL_CHECKS=_PIXEL_CHECKS+2
' Distinct underlay on the IFF page for the later Bob pixel oracle.
_A=Aga Blit Fill(96,100,20,18,0)
If _A<>1
   _ERR=24 : Goto _CLEANUP
End If
Gosub _TRY_SWAP
If _SW<>1
   _ERR=23 : Goto _CLEANUP
End If
' PH3: Back Fill directly after Swap; no prior Safe-acquiring writer.
_PH=3 : _FILLPEN=(_MARK+1) Mod 256
Aga Back Fill _FILLPEN
Aga Wait Vbl
_X=0 : _Y=0 : _BIT=128 : Gosub _READ_PIXEL
If _CAPOK<>1 or _VALUE<>_FILLPEN
   _ERR=30 : Goto _CLEANUP
End If
_X=312 : _Y=248 : _BIT=128 : Gosub _READ_PIXEL
If _CAPOK<>1 or _VALUE<>_FILLPEN
   _ERR=31 : Goto _CLEANUP
End If
_FILL_OK=1 : _PIXEL_CHECKS=_PIXEL_CHECKS+2
' Prepare one opaque 20x18 Bob, then remove source pixels.
_PH=4
_A=Aga Blit Fill(16,16,20,18,165)
If _A<>1
   _ERR=40 : Goto _CLEANUP
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,35,33
Make AGA Bob Mask 1,0
If Length(24)<=32
   _ERR=41 : Goto _CLEANUP
End If
_A=Aga Blit Fill(0,0,320,256,_MARK)
If _A<>1
   _ERR=42 : Goto _CLEANUP
End If
_MODE=Aga Bob Auto Update(1)
If _MODE<>1
   _ERR=43 : Goto _CLEANUP
End If
Amos To Back
' Last Swap without an active Bob. It arms Safe/Disp in the native code.
Gosub _TRY_SWAP
If _SW<>1
   _ERR=44 : Goto _CLEANUP
End If
' PH5: first Bind, no Fill, IFF, capture or Wait Vbl before first attempt.
_PH=5
Aga Bob 1,96,100,1
Gosub _TRY_SWAP
_BIND_FIRST=_FIRST : _BIND_RETRIES=_TRIES
If _SW<>1
   _ERR=50 : Goto _CLEANUP
End If
_BIND_OK=1
' One more presentation makes the prior displayed Bob page readable.
_PH=6
Aga Wait Vbl
Gosub _TRY_SWAP
If _SW<>1
   _ERR=60 : Goto _CLEANUP
End If
Aga Wait Vbl
_X=96 : _Y=100 : _BIT=128 : Gosub _READ_PIXEL
If _CAPOK<>1 or _VALUE<>165
   _ERR=61 : Goto _CLEANUP
End If
' Bottom-right pixel (115,117), aligned capture x112, mask bit 16.
_X=112 : _Y=117 : _BIT=16 : Gosub _READ_PIXEL
If _CAPOK<>1 or _VALUE<>165
   _ERR=62 : Goto _CLEANUP
End If
_PIXEL_CHECKS=_PIXEL_CHECKS+2
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
   _CLOSED=Aga Mouse X
   If _CLOSED<>-1 and _ERR=0
      _ERR=70
   End If
End If
If _OWN=1
   If _OPEN<>1 or _CLOSED=-1
      If Length(27)<>0
         Erase 27
      End If
      If Length(24)<>0
         Erase 24
      End If
   End If
End If
_CHIP1=Chip Free : _FAST1=Fast Free
If _ERR=0 and _IFF_OK=1 and _FILL_OK=1 and _BIND_OK=1 and _PIXEL_CHECKS=6 and _SWAPS=6 and _CLOSED=-1
   _OK=1
End If
_VERDICT$="FAIL"
If _OK=1
   _VERDICT$="PASS"
End If
Print "P2D L2 SAFEPORT ";_VERDICT$;" ERR ";_ERR;" PH ";_PH
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"SOURCE_TAG P2D_L2_SAFEPORT_V1_20261124"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"PHASE_LAST ";_PH
   Print #1,"IFF_FIRST ";_IFF_FIRST
   Print #1,"IFF_RETRIES ";_IFF_RETRIES
   Print #1,"IFF_OK ";_IFF_OK
   Print #1,"BACK_FILL_OK ";_FILL_OK
   Print #1,"FIRST_BIND_FIRST ";_BIND_FIRST
   Print #1,"FIRST_BIND_RETRIES ";_BIND_RETRIES
   Print #1,"FIRST_BIND_OK ";_BIND_OK
   Print #1,"PIXEL_CHECKS ";_PIXEL_CHECKS
   Print #1,"PIXEL_LAST ";_VALUE
   Print #1,"IFF_REF0 ";_REF0
   Print #1,"IFF_REF1 ";_REF1
   Print #1,"SWAPS ";_SWAPS
   Print #1,"SWAP_REFUSALS ";_SWAP_REFUSALS
   Print #1,"SWAP_RECOVERED ";_SWAP_RECOVERED
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"CLOSED_MOUSE_X ";_CLOSED
   Print #1,"CHIP_BEFORE ";_CHIP0;" AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0;" AFTER ";_FAST1
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
_TRY_SWAP:
_SW=Aga Swap : _FIRST=_SW : _TRIES=0
If _SW<>1
   _SWAP_REFUSALS=_SWAP_REFUSALS+1
   For _WAIT=1 To 4
      If _SW<>1
         Aga Wait Vbl
         _TRIES=_TRIES+1
         _SW=Aga Swap
      End If
   Next _WAIT
   If _SW=1
      _SWAP_RECOVERED=_SWAP_RECOVERED+1
   End If
End If
If _SW=1
   _SWAPS=_SWAPS+1
End If
Return
_READ_PIXEL:
_CAPOK=0 : _VALUE=-1
_CAP=Aga C Block Capture(27,_X,_Y,8,1,0)
If _CAP=1 and Length(27)=56
   _CAPOK=1 : _PTR=Start(27)+40 : _VALUE=0 : _POWER=1
   For _PLANE=0 To 7
      If (Peek(_PTR+2*_PLANE) and _BIT)<>0
         _VALUE=_VALUE+_POWER
      End If
      _POWER=_POWER*2
   Next _PLANE
End If
Return
