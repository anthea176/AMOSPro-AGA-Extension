' M19 P1a BOB GETTERS X/Y/I + P0 FREE + B8 CLEAR/UPDATE - RUNTIME
' P1a CANDIDATE SHA256 165a24edcd4c00074d6ddce4a98317f720ed3236d61ba006333574743b55063a
' AGA PAL 320X256X256, MC68020+; WINUAE 68030 JIT ON.
' 9 STAGES x 45 FRAMES: 2,1,0,2,4,8,16,64,16 BOBS; +3 BANK FREE FRAMES.
' NO TIMER OR BENCHMARK; 403 CLEAR, 405 UPDATE; BACK BUFFER ONLY.
Set Buffer 20
Cls
Dim _SEEN(1)
Dim _STAGE_OK(9),_STAGE_EXPECT(9)
_BANK1=24 : _BANK2=25 : _ERR=0 : _OPEN=0 : _DB=0
_OWN1=0 : _OWN2=0 : _FR_OK=0 : _PAGE=0
_UPDATE=0 : _CLEAR=0 : _SW=0 : _COPY=0 : _RESULT=0
_FILL_BAD=0 : _COPY_BAD=0 : _UPDATE_BAD=0 : _SW_BAD=0
_COUNT1=0 : _COUNT2=0 : _MASKFLAG=0
_CLOSE_CALLED=0 : _BANKS_ERASED=0 : _RETRY_VBL=0
_OFF_SENT=0 : _STAGES_OK=0 : _RUN=0
_CLEAR_BAD=0 : _CLEAR_OK=0 : _UPDATE_OK=0
_BF_CALLS=0 : _BF_CLEAR_OK=0 : _BF_UPD_OK=0
_BF_SWAP_OK=0 : _BF_REARM=0 : _BF_LEN1=0 : _BF_LEN2=0
_QID=0 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
_Q_CASES=0 : _Q_OK=0 : _Q_BAD=0 : _QX=0 : _QY=0 : _QI=0
_SEEN(0)=0 : _SEEN(1)=0
_LOG$="RAM:M19_P1A_BOB_GETTERS.TXT"
_PRG=Prg State : _MODE$="UNKNOWN"
If _PRG=0
   _MODE$="INTERPRETED"
End If
If _PRG=1
   _MODE$="RUNTIME"
End If
If _PRG=-1
   _MODE$="COMPILED"
End If
If _MODE$="UNKNOWN"
   _ERR=1 : Goto _CLEANUP
End If
Print "M19 P1A GETTERS X/Y/I + BANK FREE / UPDATE"
If Aga Detect=0
   _ERR=2 : Goto _CLEANUP
End If
If Length(_BANK1)<>0 or Length(_BANK2)<>0
   _ERR=3 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=5 : Goto _CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,18,26,51)
_P2=Aga Palette Set(2,38,53,85)
_P3=Aga Palette Set(3,68,88,115)
_P4=Aga Palette Set(4,255,64,48)
_P5=Aga Palette Set(5,255,228,38)
_P6=Aga Palette Set(6,44,122,103)
_P7=Aga Palette Set(7,144,176,191)
_P8=Aga Palette Set(8,43,72,99)
_P9=Aga Palette Set(9,172,116,54)
_A=Aga Blit Fill(0,0,320,256,0)
If _A<>1
   _ERR=6 : Goto _CLEANUP
End If
_A=Aga Blit Fill(12,16,17,15,4)
_B=Aga Blit Fill(17,21,5,5,0)
If _A<>1 or _B<>1
   _ERR=7 : Goto _CLEANUP
End If
Aga Bob Bank _BANK1
If Length(_BANK1)<>0
   _OWN1=1
End If
If Length(_BANK1)<>32
   _ERR=8 : Goto _CLEANUP
End If
Get AGA Bob 1,12,16,28,30
Make AGA Bob Mask 1,0
_COUNT1=Deek(Start(_BANK1)+8)
_MASKFLAG=Deek(Start(_BANK1)+42)
If _COUNT1<>1 or _MASKFLAG<>1
   _ERR=9 : Goto _CLEANUP
End If
_A=Aga Blit Fill(62,16,37,8,5)
If _A<>1
   _ERR=10 : Goto _CLEANUP
End If
Aga Bob Bank _BANK2
If Length(_BANK2)<>0
   _OWN2=1
End If
If Length(_BANK2)<>32
   _ERR=11 : Goto _CLEANUP
End If
Get AGA Bob 1,62,16,98,23
No AGA Bob Mask 1
_COUNT2=Deek(Start(_BANK2)+8)
If _COUNT2<>1
   _ERR=12 : Goto _CLEANUP
End If
' P1a: no Bob has been defined yet.
_QID=1 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
Gosub _QUERY_CHECK
If _ERR<>0
   Goto _CLEANUP
End If
' Initialize clean 32-pixel tile source on both physical pages.
For _WARM=1 To 2
   If _ERR=0
      Gosub _BUILD_SCENE
   End If
   If _ERR=0
      Gosub _RESTORE_ALL
   End If
   If _ERR=0
      Gosub _DO_SWAP
   End If
Next _WARM
If _ERR<>0
   Goto _CLEANUP
End If
Amos To Back
' Nine deterministic visual stages; NO FPS or performance samples.
For _STAGE=1 To 9
   _FIRST=1 : _LAST=2
   If _ERR=0 and _STAGE=2
      Aga Bob Off 1
      _QID=1 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
      Gosub _QUERY_CHECK
      _OFF_SENT=_OFF_SENT+1
      _FIRST=2 : _LAST=2
   End If
   If _ERR=0 and _STAGE=3
      Aga Bob Off 2
      _QID=2 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
      Gosub _QUERY_CHECK
      _OFF_SENT=_OFF_SENT+1
      _LAST=0
   End If
   If _STAGE=5
      _LAST=4
   End If
   If _STAGE=6
      _LAST=8
   End If
   If _STAGE=7
      _LAST=16
   End If
   If _STAGE=8
      _LAST=64
   End If
   If _ERR=0 and _STAGE=9
      For _ID=17 To 64
         Aga Bob Off _ID
         _OFF_SENT=_OFF_SENT+1
      Next _ID
      _LAST=16
   End If
   _EXPECT=0
   If _LAST>=_FIRST
      _EXPECT=_LAST-_FIRST+1
   End If
   _STAGE_EXPECT(_STAGE)=_EXPECT
   For _STEP=1 To 45
      ' First two physical page snapshots do not exist until Update.
      If _ERR=0 and _SEEN(_PAGE)=1
         _CLEAR=Aga Bob Clear
         If _CLEAR<>1
            _CLEAR_BAD=_CLEAR_BAD+1 : _ERR=18
         Else
            _CLEAR_OK=_CLEAR_OK+1
         End If
      End If
      If _ERR=0
         Gosub _HUD
      End If
      If _ERR=0
         Gosub _DYNAMIC_DECOR
      End If
      If _ERR=0 and _EXPECT>0
         For _ID=_FIRST To _LAST
            _X=((_ID-1) Mod 8)*40+(_STEP Mod 7)-3
            _Y=66+Int((_ID-1)/8)*22
            If _ID Mod 2=1
               Aga Bob Bank _BANK1
            Else
               Aga Bob Bank _BANK2
            End If
            Aga Bob _ID,_X,_Y,1
         Next _ID
      End If
      If _ERR=0
         _UPDATE=Aga Bob Update
         If _UPDATE<>1
            _UPDATE_BAD=_UPDATE_BAD+1 : _ERR=14
         Else
            _UPDATE_OK=_UPDATE_OK+1
            _SEEN(_PAGE)=1
         End If
      End If
      If _ERR=0
         Gosub _DO_SWAP
      End If
      If _ERR=0
         _STAGE_OK(_STAGE)=_STAGE_OK(_STAGE)+1
         _FR_OK=_FR_OK+1
         _PAGE=1-_PAGE
      End If
   Next _STEP
   If _ERR=0 and _STAGE_OK(_STAGE)=45
      _STAGES_OK=_STAGES_OK+1
   End If
Next _STAGE
' P1a: exact final XY of stage 9, inactive 17/64 and invalid IDs 0/65.
If _ERR=0
   _QID=1 : _QEX=0 : _QEY=66 : _QEI=1
   Gosub _QUERY_CHECK
   _QID=2 : _QEX=40 : _QEY=66 : _QEI=1
   Gosub _QUERY_CHECK
   _QID=17 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
   Gosub _QUERY_CHECK
   _QID=64 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
   Gosub _QUERY_CHECK
   _QID=0 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
   Gosub _QUERY_CHECK
   _QID=65 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
   Gosub _QUERY_CHECK
End If
' M19 P0: 405 B8 baseline frames unchanged; 3 extra bank-free frames.
If _ERR=0
   _BF_LEN1=Length(_BANK1) : _BF_LEN2=Length(_BANK2)
   If _BF_LEN1<=32 or _BF_LEN2<=32
      _ERR=19
   End If
End If
For _BF_PHASE=1 To 3
   If _ERR=0 and _BF_PHASE=1
      Aga Bob Bank Free _BANK1
      Aga Bob Bank Free _BANK1
      _QID=1 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
      Gosub _QUERY_CHECK
      _QID=2 : _QEX=40 : _QEY=66 : _QEI=1
      Gosub _QUERY_CHECK
      _BF_CALLS=_BF_CALLS+2
   End If
   If _ERR=0 and _BF_PHASE=2
      Aga Bob Bank Free _BANK2
      _QID=2 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
      Gosub _QUERY_CHECK
      _BF_CALLS=_BF_CALLS+1
   End If
   If _ERR=0 and _BF_PHASE=3
      Aga Bob Bank _BANK1
      Aga Bob 1,124,88,1
      _QID=1 : _QEX=124 : _QEY=88 : _QEI=1
      Gosub _QUERY_CHECK
      _QID=2 : _QEX=-32769 : _QEY=-32769 : _QEI=-32769
      Gosub _QUERY_CHECK
      _BF_REARM=1
   End If
   If _ERR=0
      _BFC=Aga Bob Clear
      If _BFC<>1
         _ERR=20
      Else
         _BF_CLEAR_OK=_BF_CLEAR_OK+1
      End If
   End If
   If _ERR=0
      _BFU=Aga Bob Update
      If _BFU<>1
         _ERR=21
      Else
         _BF_UPD_OK=_BF_UPD_OK+1
      End If
   End If
   If _ERR=0
      Gosub _DO_SWAP
      If _ERR=0
         _BF_SWAP_OK=_BF_SWAP_OK+1
         _PAGE=1-_PAGE
      End If
   End If
Next _BF_PHASE
If _ERR=0
   If Length(_BANK1)<>_BF_LEN1 or Length(_BANK2)<>_BF_LEN2
      _ERR=22
   End If
End If
If _ERR=0
   For _HOLD=1 To 25
      Aga Wait Vbl
   Next _HOLD
End If
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   Amos To Front
   _CLOSE_CALLED=1
End If
If _OWN1=1
   Erase _BANK1
   _BANKS_ERASED=_BANKS_ERASED+1
End If
If _OWN2=1
   Erase _BANK2
   _BANKS_ERASED=_BANKS_ERASED+1
End If
If _ERR=0 and _FR_OK=405 and _STAGES_OK=9 and _OFF_SENT=50
   If _BF_CALLS<>3 or _BF_CLEAR_OK<>3 or _BF_UPD_OK<>3
      _ERR=23
   End If
   If _BF_SWAP_OK<>3 or _BF_REARM<>1
      _ERR=24
   End If
End If
If _ERR=0 and _FR_OK=405 and _STAGES_OK=9 and _OFF_SENT=50
   If _Q_CASES<>14 or _Q_OK<>42 or _Q_BAD<>0
      _ERR=25
   End If
End If
If _ERR=0 and _FR_OK=405 and _STAGES_OK=9 and _OFF_SENT=50
   If _CLOSE_CALLED=1 and _BANKS_ERASED=2 and _DB=1
      If _CLEAR_OK=403 and _UPDATE_OK=405 and _CLEAR_BAD=0 and _UPDATE_BAD=0
         _RESULT=1
      End If
   End If
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PATH_OK"
End If
Print "M19 B8 CLEAR/UPDATE ";_VERDICT$;" ERR ";_ERR
Print "FRAMES ";_FR_OK;" / 405 STAGES ";_STAGES_OK;" / 9"
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19 P1A X Y I BOB + P0 BANK FREE ";_MODE$
   Print #1,"LIB_SHA256 165a24edcd4c00074d6ddce4a98317f720ed3236d61ba006333574743b55063a"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"FRAMES_TARGET 405"
   Print #1,"FRAMES_OK ";_FR_OK
   Print #1,"STAGES_TARGET 9"
   Print #1,"STAGES_OK ";_STAGES_OK
   Print #1,"DOUBLE_BUFFER ";_DB
   Print #1,"OFF_COMMANDS_ISSUED ";_OFF_SENT
   Print #1,"BANK_FREE_CALLS ";_BF_CALLS
   Print #1,"BANK_FREE_CLEAR_OK ";_BF_CLEAR_OK
   Print #1,"BANK_FREE_UPDATE_OK ";_BF_UPD_OK
   Print #1,"BANK_FREE_SWAP_OK ";_BF_SWAP_OK
   Print #1,"BANK_FREE_REARM ";_BF_REARM
   Print #1,"QUERY_CASES ";_Q_CASES
   Print #1,"QUERY_VALUES_OK ";_Q_OK
   Print #1,"QUERY_VALUES_BAD ";_Q_BAD
   Print #1,"QUERY_LAST_X ";_QX
   Print #1,"QUERY_LAST_Y ";_QY
   Print #1,"QUERY_LAST_I ";_QI
   Print #1,"BANK_FREE_BANK1_LENGTH ";_BF_LEN1
   Print #1,"BANK_FREE_BANK2_LENGTH ";_BF_LEN2
   For _REPORT=1 To 9
      Print #1,"STAGE ";_REPORT;" EXPECT_BOBS ";_STAGE_EXPECT(_REPORT)
      Print #1,"STAGE_FRAMES_OK ";_STAGE_OK(_REPORT)
   Next _REPORT
   Print #1,"FILL_FAILS ";_FILL_BAD
   Print #1,"COPY_FAILS ";_COPY_BAD
   Print #1,"CLEAR_OK ";_CLEAR_OK
   Print #1,"CLEAR_FAILS ";_CLEAR_BAD
   Print #1,"UPDATE_OK ";_UPDATE_OK
   Print #1,"UPDATE_FAILS ";_UPDATE_BAD
   Print #1,"SWAP_FAILS ";_SW_BAD
   Print #1,"RETRY_VBL ";_RETRY_VBL
   Print #1,"CLOSE_RETURNED ";_CLOSE_CALLED
   Print #1,"BANKS_ERASED ";_BANKS_ERASED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
' Stage description is drawn AFTER erasing its text band on back page.
_HUD:
_PX=0 : _PY=16 : _PW=320 : _PH=14 : _COL=1
Gosub _PAINT_RECT
If _ERR=0
   _TXT=0 : _TRY=0
   Repeat
      _TRY=_TRY+1
      If _STAGE=1
         _TXT=Aga Text(12,27,5,"1/9  TWO BOBS ACTIVE")
      End If
      If _STAGE=2
         _TXT=Aga Text(12,27,5,"2/9  BOB 1 OFF - ONE ACTIVE")
      End If
      If _STAGE=3
         _TXT=Aga Text(12,27,5,"3/9  ALL BOBS OFF")
      End If
      If _STAGE=4
         _TXT=Aga Text(12,27,5,"4/9  REACTIVATE 1 + 2")
      End If
      If _STAGE=5
         _TXT=Aga Text(12,27,5,"5/9  FOUR BOBS")
      End If
      If _STAGE=6
         _TXT=Aga Text(12,27,5,"6/9  EIGHT BOBS")
      End If
      If _STAGE=7
         _TXT=Aga Text(12,27,5,"7/9  SIXTEEN BOBS")
      End If
      If _STAGE=8
         _TXT=Aga Text(12,27,5,"8/9  SIXTY-FOUR BOBS")
      End If
      If _STAGE=9
         _TXT=Aga Text(12,27,5,"9/9  OFF 17-64 : 16 REMAIN")
      End If
      If _TXT=0 and _TRY<40
         Aga Wait Vbl
         _RETRY_VBL=_RETRY_VBL+1
      End If
   Until _TXT=1 or _TRY=40
   If _TXT<>1
      _FILL_BAD=_FILL_BAD+1 : _ERR=17
   End If
End If
Return
' Set the clean 32-pixel tile and a header outside its source area.
_BUILD_SCENE:
_PX=0 : _PY=0 : _PW=320 : _PH=64 : _COL=1
Gosub _PAINT_RECT
_PX=0 : _PY=0 : _PW=320 : _PH=3 : _COL=7
Gosub _PAINT_RECT
_PX=0 : _PY=30 : _PW=320 : _PH=2 : _COL=7
Gosub _PAINT_RECT
If _ERR=0
   _TX1=0 : _TRY=0
   Repeat
      _TRY=_TRY+1
      _TX1=Aga Text(12,15,7,"M19 B8 - BOB CLEAR/UPDATE")
      If _TX1=0 and _TRY<40
         Aga Wait Vbl
      End If
   Until _TX1=1 or _TRY=40
   If _TX1<>1
      _ERR=17
   End If
End If
If _ERR=0
   _TX2=0 : _TRY=0
   Repeat
      _TRY=_TRY+1
      _TX2=Aga Text(12,27,5,"9 STAGES / AUTO EXIT")
      If _TX2=0 and _TRY<40
         Aga Wait Vbl
      End If
   Until _TX2=1 or _TRY=40
   If _TX2<>1
      _ERR=17
   End If
End If
_PX=0 : _PY=32 : _PW=320 : _PH=32 : _COL=1
Gosub _PAINT_RECT
For _T=0 To 9
   _PX=_T*32+2 : _PY=35 : _PW=28 : _PH=25 : _COL=3
   Gosub _PAINT_RECT
   _PX=_T*32+4 : _PY=38 : _PW=20 : _PH=5 : _COL=7
   Gosub _PAINT_RECT
   _PX=_T*32+8 : _PY=48 : _PW=15 : _PH=3 : _COL=6
   Gosub _PAINT_RECT
   _PX=_T*32+4 : _PY=54 : _PW=22 : _PH=4 : _COL=8
   Gosub _PAINT_RECT
   _PX=_T*32+23 : _PY=55 : _PW=4 : _PH=4 : _COL=9
   Gosub _PAINT_RECT
Next _T
Return
' Decor is modified BETWEEN Clear and Update, before Bobs are painted.
_DYNAMIC_DECOR:
_PX=0 : _PY=224 : _PW=320 : _PH=16 : _COL=3
Gosub _PAINT_RECT
If _ERR=0
   _PX=(_STEP*5+_STAGE*13) Mod 288
   _PY=226 : _PW=24 : _PH=12 : _COL=9
   Gosub _PAINT_RECT
End If
Return
' Only copy clean source pixels from Y 32..63 into Y 64..255.
_RESTORE_ALL:
For _ROW=2 To 7
   If _ERR=0
      _DX=0 : _DY=_ROW*32 : _DW=320 : _DH=32
      Gosub _COPY_TILE_RECT
   End If
Next _ROW
Return
' Restore old positions on the correct hidden page, split at Y=32.
_COPY_TILE_RECT:
If _ERR=0
   If _DX<0
      _DW=_DW+_DX : _DX=0
   End If
   If _DY<64
      _DH=_DH+_DY-64 : _DY=64
   End If
   If _DX+_DW>320
      _DW=320-_DX
   End If
   If _DY+_DH>256
      _DH=256-_DY
   End If
   If _DW>0 and _DH>0
      _REST_H=_DH
      Repeat
         _SY=_DY
         Repeat
            _SY=_SY-32
         Until _SY<64
         _SLICE=_REST_H
         If _SLICE>64-_SY
            _SLICE=64-_SY
         End If
         _COPY=0 : _TRY=0
         Repeat
            _TRY=_TRY+1
            _COPY=Aga Blit Copy(_DX,_SY,_DX,_DY,_DW,_SLICE)
            If _COPY=0 and _TRY<40
               Aga Wait Vbl
               _RETRY_VBL=_RETRY_VBL+1
            End If
         Until _COPY=1 or _TRY=40
         If _COPY<>1
            _COPY_BAD=_COPY_BAD+1 : _ERR=13
         Else
            _DY=_DY+_SLICE
            _REST_H=_REST_H-_SLICE
         End If
      Until _REST_H=0 or _ERR<>0
   End If
End If
Return
' PAINT THE STATIC HEADER AND THE 32-PIXEL BACKGROUND SOURCE.
_PAINT_RECT:
If _ERR=0
   _PAINT=0 : _TRY=0
   Repeat
      _TRY=_TRY+1
      _PAINT=Aga Blit Fill(_PX,_PY,_PW,_PH,_COL)
      If _PAINT=0 and _TRY<40
         Aga Wait Vbl
         _RETRY_VBL=_RETRY_VBL+1
      End If
   Until _PAINT=1 or _TRY=40
   If _PAINT<>1
      _FILL_BAD=_FILL_BAD+1 : _ERR=16
   End If
End If
Return
' SWAP ONLY WHEN THE COMPLETE BACK PAGE IS READY.
_DO_SWAP:
_SW=0 : _TRY=0
Repeat
   _TRY=_TRY+1
   _SW=Aga Swap
   If _SW=0 and _TRY<40
      Aga Wait Vbl
      _RETRY_VBL=_RETRY_VBL+1
   End If
Until _SW=1 or _TRY=40
If _SW<>1
   _SW_BAD=_SW_BAD+1 : _ERR=15
End If
Return
' M19 P1a numeric getters: 3 checked values per probe, no rendering.
_QUERY_CHECK:
_Q_CASES=_Q_CASES+1
_QX=Aga X Bob(_QID)
_QY=Aga Y Bob(_QID)
_QI=Aga I Bob(_QID)
If _QX=_QEX
   _Q_OK=_Q_OK+1
Else
   _Q_BAD=_Q_BAD+1 : _ERR=25
End If
If _QY=_QEY
   _Q_OK=_Q_OK+1
Else
   _Q_BAD=_Q_BAD+1 : _ERR=25
End If
If _QI=_QEI
   _Q_OK=_Q_OK+1
Else
   _Q_BAD=_Q_BAD+1 : _ERR=25
End If
Return
