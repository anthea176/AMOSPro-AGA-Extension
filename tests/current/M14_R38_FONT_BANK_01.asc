' M14-R38-AMCAF-BANK-01 : Gate B AMOS interpreted / WinUAE.
' Requires R38 v0.11.0 after Gate A CPU/CI PASS, not LAST_GOOD until B.
' Copy AMCAF_FONT9.abk into RAM: before running; no AMCAF extension required.
Cls
Print "M14-R38-AMCAF-BANK-01"
Load "RAM:AMCAF_FONT9.abk",10
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(1,255,255,255)
_P1=Aga Palette Set(2,0,90,160)
_CLR=Aga Blit Clear(0,0,320,256)
_PANEL=Aga Blit Fill(14,25,292,198,2)
_SEL=Aga Font Bank Select(Start(10),Length(10))
_BADLEN=Aga Font Bank Select(Start(10),Length(10)-1)
Erase 10
_TX=Aga Text(28,72,1,"AMCAF FONT BANK - ERASED")
_OS=Aga Font Select("topaz.font",8)
_TXOS=Aga Text(28,108,1,"TOPAZ 8 - DISK FONT")
Load "RAM:AMCAF_FONT9.abk",10
_SEL2=Aga Font Bank Select(Start(10),Length(10))
Erase 10
_TX2=Aga Text(28,144,1,"AMCAF BANK AGAIN")
_RESET=Aga Font Select("",0)
_TXDEF=Aga Text(28,184,1,"DEFAULT FONT - R38")
_SWAP=Aga Swap
If _SWAP<>1
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED"
   End
End If
Amos To Back
For _I=1 To 210
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Font Bank Select(0,0)
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _P0<>1 or _P1<>1
   _RESULT=0
End If
If _CLR<>1 or _PANEL<>1 or _SEL<>1 or _BADLEN<>0
   _RESULT=0
End If
If _TX<>1 or _OS<>1 or _TXOS<>1
   _RESULT=0
End If
If _SEL2<>1 or _TX2<>1 or _RESET<>1 or _TXDEF<>1
   _RESULT=0
End If
If _SWAP<>1 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Print "M14-R38-AMCAF-BANK-01"
Print "OPEN ";_OPEN;" DB ";_DB;" PALETTE ";_P0;" ";_P1
Print "BANK ";_SEL;" BADLEN ";_BADLEN;" TXT ";_TX
Print "OS ";_OS;" TXOS ";_TXOS;" BANK2 ";_SEL2;" TX2 ";_TX2
Print "RESET ";_RESET;" DEFAULT ";_TXDEF
Print "SWAP ";_SWAP;" NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
