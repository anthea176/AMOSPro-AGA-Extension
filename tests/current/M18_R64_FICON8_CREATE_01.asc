' M18 R64: interpreted-only WinUAE Gate B. Bank 12 MUST be free.
' Creates an AMOS DATA FICON8 16x16x8 bank; no sample ABK required.
' Uses RAM:M18_R64_FICON8.ABK, overwritten if already present.
' Gate C manual AMOS Compiler is postponed to END of M18.
Cls
Print "M18-R64-FICON8-CREATE-01"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_CF0=Chip Free : _FF0=Fast Free
_C1=Aga F Icon Bank Create(12,4)
If _C1<>1
   Print "CREATE FAILED / BANK 12 OCCUPIED?"
   Print "NO EXISTING BANK ERASED"
   End
End If
_PTR=Start(12) : _SIZE=Length(12)
_HDR=Leek(Start(12))
_COUNT=Deek(Start(12)+4)
_W=Deek(Start(12)+6) : _H=Deek(Start(12)+8)
_D=Deek(Start(12)+10)
_NAME0=Leek(Start(12)-8) : _NAME1=Leek(Start(12)-4)
_MASK=Deek(Start(12)+12) : _PLANE=Deek(Start(12)+14)
_LMASK=Deek(Start(12)+12+3*288+15*18)
_LPLANE=Deek(Start(12)+12+3*288+15*18+2)
_DUP=Aga F Icon Bank Create(12,8)
_PTR2=Start(12)
_BADB=Aga F Icon Bank Create(4,4)
_BADL=Aga F Icon Bank Create(13,3)
_BADH=Aga F Icon Bank Create(13,4097)
Erase 12
_CF1=Chip Free : _FF1=Fast Free
_C2=Aga F Icon Bank Create(12,4)
If _C2<>1
   Print "SECOND CREATE FAILED"
   End
End If
Save "RAM:M18_R64_FICON8.ABK",12
Erase 12
Load "RAM:M18_R64_FICON8.ABK",12
_LOAD=Length(12) : _LCOUNT=Deek(Start(12)+4)
_REMASK=Deek(Start(12)+12)
_LDUP=Aga F Icon Bank Create(12,4)
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   Erase 12
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 12
   End
End If
_P0=Aga Palette Set(0,0,0,0)
_P2=Aga Palette Set(2,32,48,96)
_SW0=0
For _TRY=1 To 20
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
_BG=0 : _TRANS=0 : _OPAQUE=0 : _BADID=0
If _READY=1
   _BG=Aga Blit Fill(0,0,320,256,2)
   _TRANS=Aga F Icon(12,1,30,60,1)
   _OPAQUE=Aga F Icon(12,2,90,60,0)
   _BADID=Aga F Icon(12,5,140,60,0)
End If
_SW1=0
For _TRY=1 To 20
   If _SW1=0
      _SW1=Aga Swap
   End If
   If _SW1=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW1=1
   Amos To Back
End If
' VISUAL: Blue background, transparent x30, black square x90.
For _HOLD=1 To 125
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOS=Aga F Icon(12,2,10,10,0)
Erase 12
_CF_END=Chip Free : _FF_END=Fast Free
_RESULT=1
If _SIZE<>1164 or _HDR<>1164 or _COUNT<>4 or _W<>16 or _H<>16 or _D<>8
   _RESULT=0
End If
If _NAME0<>$4649434F or _NAME1<>$4E382020
   _RESULT=0
End If
If _MASK<>65535 and _MASK<>-1
   _RESULT=0
End If
If _LMASK<>65535 and _LMASK<>-1
   _RESULT=0
End If
If _REMask<>65535 and _REMask<>-1
   _RESULT=0
End If
If _PLANE<>0 or _LPLANE<>0
   _RESULT=0
End If
If _DUP<>0 or _PTR<>_PTR2 or _LDUP<>0
   _RESULT=0
End If
If _BADB<>0 or _BADL<>0 or _BADH<>0
   _RESULT=0
End If
If _CF0<>_CF1 or _FF0<>_FF1
   _RESULT=0
End If
If _LOAD<>1164 or _LCOUNT<>4 or _C2<>1
   _RESULT=0
End If
If _OPEN<>1 or _DB<>1 or _SW0<>1 or _SW1<>1 or _READY<>1 or _BG<>1
   _RESULT=0
End If
If _P0<>1 or _P2<>1 or _TRANS<>1 or _OPAQUE<>1 or _BADID<>0
   _RESULT=0
End If
If _NOS<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "M18-R64-FICON8-CREATE-01"
Print "CREATE ";_C1;" ";_C2;" DUP ";_DUP;" RELOAD DUP ";_LDUP
Print "SIZE/COUNT ";_SIZE;" ";_COUNT;" LOAD ";_LOAD;" ";_LCOUNT
Print "MASK FIRST/LAST ";_MASK;" ";_LMASK;" PLANES ";_PLANE;" ";_LPLANE
Print "BAD BANK/COUNT ";_BADB;" ";_BADL;" ";_BADH
Print "CHIP BEFORE/ERASE ";_CF0;" ";_CF1
Print "FAST BEFORE/ERASE ";_FF0;" ";_FF1
Print "OPEN/DB/SHOW ";_OPEN;" ";_DB;" ";_SW1
Print "TRANSPARENT/OPAQUE ";_TRANS;" ";_OPAQUE
Print "NOS/CLOSE ";_NOS;" ";_CLOSED
Print "CHIP/FAST AFTER RAM FILE ";_CF_END;" ";_FF_END
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
