' R74: interpret in AMOSPro (not compiled). Bank 12 MUST be free.
' Requires c2p.library v1.9 copied into LIBS: on the Amiga volume.
' No PowerShell, no GDB, no additional assets.
Cls
Print "C2P-R74-OPEN-01"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_CF0=Chip Free
Reserve As Data 12,81920
_LEN=Length(12)
_NOS=Aga C2P Open(12)
_BADBANK=Aga C2P Open(4)
_RESULT=1
If _NOS<>0 or _BADBANK<>0 or _LEN<>81920
   _RESULT=0
End If
_COL=16
For _DEPTH=4 To 8
   _OPEN=Aga Screen Open(320,256,_COL,$00021000)
   _DB=0 : _C2P=0 : _DUP=0
   If _OPEN=1
      _DB=Aga Double Buffer
      If _DB=1
         _C2P=Aga C2P Open(12)
         _DUP=Aga C2P Open(12)
      End If
      Aga Screen Close
      Amos To Front
   End If
   _POST=Aga C2P Open(12)
   Print "COL ";_COL;" OPEN ";_OPEN;" DB ";_DB;" C2P ";_C2P;" DUP ";_DUP;" POST ";_POST
   If _OPEN<>1 or _DB<>1 or _C2P<>1 or _DUP<>0 or _POST<>0
      _RESULT=0
   End If
   _COL=_COL*2
Next _DEPTH
Erase 12
_CF1=Chip Free
Print "NOS/BADBANK ";_NOS;" ";_BADBANK
Print "CHIP BEFORE/AFTER ";_CF0;" ";_CF1
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
