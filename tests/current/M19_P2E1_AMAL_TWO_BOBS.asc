' M19 P2e.1 - two synchronous AMAL channels to two independent AGA Bobs
' Runtime test candidate: not yet validated in WinUAE or AMOS Compiler
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _OPEN=0 : _ERR=0 : _OK=0
_SYNCHRO_OFF=0 : _AMAL0_ON=0 : _AMAL1_ON=0 : _CLOSE_RETURNED=0
_VALID=0 : _SWAPS=0 : _PIX0=0 : _PIX1=0
_BG0=0 : _BG1=0 : _SWAP=0 : _FRAME=0
_SWAP_REFUSALS=0 : _SWAP_RECOVERED=0 : _RETRY_VBLS=0
_SWAP_FIRST_FAIL_FRAME=0 : _SWAP_LAST_FAIL_FRAME=0
_SWAP_LAST_TRIES=0 : _SWAP_RETRY_LIMIT=4
_CHG0X=0 : _CHG0Y=0 : _CHG0A=0 : _CHG1X=0 : _CHG1Y=0 : _CHG1A=0
_SEEN01=0 : _SEEN02=0 : _SEEN11=0 : _SEEN12=0
_FLAG0_X=0 : _FLAG0_Y=0 : _FLAG0_A=0
_FLAG1_X=0 : _FLAG1_Y=0 : _FLAG1_A=0
_OLD_VALID=0 : _PREV_VALID=0 : _PIX_ID=0 : _PIX_EXPECTED=0 : _VALUE=-1
_LOG$="RAM:M19_P2E1_AMAL_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:M19_P2E1_AMAL_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:M19_P2E1_AMAL_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:M19_P2E1_AMAL_COMPILED.TXT"
End If
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(24)<>0 or Length(27)<>0 or Length(28)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
' Asymmetric 16x16 F / L silhouettes, pen 0 transparent.
' Both have a visible top-left pixel for the existing pixel oracle.
_A=Aga Blit Fill(16,16,48,16,0)
_B=Aga Blit Fill(16,16,3,16,165)
_C=Aga Blit Fill(19,16,12,3,165)
_D=Aga Blit Fill(19,22,9,3,165)
_E=Aga Blit Fill(48,16,3,16,90)
_F=Aga Blit Fill(51,29,13,3,90)
If _A<>1 or _B<>1 or _C<>1 or _D<>1 or _E<>1 or _F<>1
   _ERR=5 : Goto _CLEANUP
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,31,31
Get AGA Bob 2,48,16,63,31
Make AGA Bob Mask 1,0
Make AGA Bob Mask 2,0
If Length(24)<=32
   _ERR=6 : Goto _CLEANUP
End If
_A=Aga Blit Fill(16,16,48,16,0)
If _A<>1
   _ERR=7 : Goto _CLEANUP
End If
_PROBE=Aga C Block Capture(27,96,100,8,1,0)
If _PROBE<>1 or Length(27)<>56
   _ERR=8 : Goto _CLEANUP
End If
' 8 bytes per channel; neither channel owns an AGA or OCS Bob.
Reserve As Data 28,16
If Length(28)<>16
   _ERR=9 : Goto _CLEANUP
End If
_ADDR0=Start(28) : _ADDR1=_ADDR0+8
If (_ADDR0 and 1)<>0 or (_ADDR1 and 1)<>0
   _ERR=10 : Goto _CLEANUP
End If
For _W=0 To 7
   Doke _ADDR0+_W*2,0
Next _W
' Initialize both physical backgrounds before any Bob SET.
_BG0=Aga Blit Fill(88,88,160,112,0)
If _BG0<>1
   _ERR=22 : Goto _CLEANUP
End If
_MODE=Aga Bob Auto Update(1)
If _MODE<>1
   _ERR=11 : Goto _CLEANUP
End If
_SWAP=Aga Swap
If _SWAP<>1
   _ERR=12 : Goto _CLEANUP
End If
_SWAPS=_SWAPS+1
Aga Wait Vbl
_BG1=Aga Blit Fill(88,88,160,112,0)
If _BG1<>1
   _ERR=23 : Goto _CLEANUP
End If
' Put the private AGA Intuition screen ahead of the native AMOS screen.
Amos To Back
' Manual synchronous AMAL: one Synchro advances both channels.
_SYNCHRO_OFF=1
Synchro Off
_AMAL0$="Let X=96; Let Y=100; Let A=1; Loop: Move 32,16,32; Let A=2;"
_AMAL0$=_AMAL0$+"Move -32,-16,32; Let A=1; Jump Loop"
_AMAL1$="Let X=192; Let Y=160; Let A=2; Loop: Move 32,-16,32; Let A=1;"
_AMAL1$=_AMAL1$+"Move -32,16,32; Let A=2; Jump Loop"
Amal 0,_AMAL0$ To _ADDR0
Amal 1,_AMAL1$ To _ADDR1
Amal On 0
_AMAL0_ON=1
Amal On 1
_AMAL1_ON=1
Aga Bob Bank 24
For _FRAME=1 To 240
   Synchro
   _RAW0=Deek(_ADDR0) : _RAW1=Deek(_ADDR1)
   _BYTE0=Peek(_ADDR0) : _BYTE1=Peek(_ADDR1)
   If (_BYTE0 and 1)<>0
      _FLAG0_X=_FLAG0_X+1
   End If
   If (_BYTE0 and 2)<>0
      _FLAG0_Y=_FLAG0_Y+1
   End If
   If (_BYTE0 and 4)<>0
      _FLAG0_A=_FLAG0_A+1
   End If
   If (_BYTE1 and 1)<>0
      _FLAG1_X=_FLAG1_X+1
   End If
   If (_BYTE1 and 2)<>0
      _FLAG1_Y=_FLAG1_Y+1
   End If
   If (_BYTE1 and 4)<>0
      _FLAG1_A=_FLAG1_A+1
   End If
   _X0=Deek(_ADDR0+2) : _Y0=Deek(_ADDR0+4) : _I0=Deek(_ADDR0+6)
   _X1=Deek(_ADDR1+2) : _Y1=Deek(_ADDR1+4) : _I1=Deek(_ADDR1+6)
   If _X0>=32768
      _X0=_X0-65536
   End If
   If _Y0>=32768
      _Y0=_Y0-65536
   End If
   If _X1>=32768
      _X1=_X1-65536
   End If
   If _Y1>=32768
      _Y1=_Y1-65536
   End If
   If (_I0=1 or _I0=2) and (_I1=1 or _I1=2)
      If _X0<96 or _X0>128 or _Y0<100 or _Y0>116
         _ERR=13 : Goto _CLEANUP
      End If
      If _X1<192 or _X1>224 or _Y1<144 or _Y1>160
         _ERR=13 : Goto _CLEANUP
      End If
      If _OLD_VALID=1
         If _X0<>_OLDX0
            _CHG0X=_CHG0X+1
         End If
         If _Y0<>_OLDY0
            _CHG0Y=_CHG0Y+1
         End If
         If _I0<>_OLDI0
            _CHG0A=_CHG0A+1
         End If
         If _X1<>_OLDX1
            _CHG1X=_CHG1X+1
         End If
         If _Y1<>_OLDY1
            _CHG1Y=_CHG1Y+1
         End If
         If _I1<>_OLDI1
            _CHG1A=_CHG1A+1
         End If
      End If
      _OLDX0=_X0 : _OLDY0=_Y0 : _OLDI0=_I0
      _OLDX1=_X1 : _OLDY1=_Y1 : _OLDI1=_I1 : _OLD_VALID=1
      If _I0=1
         _SEEN01=1 : _EXPECT0=165
      Else
         _SEEN02=1 : _EXPECT0=90
      End If
      If _I1=1
         _SEEN11=1 : _EXPECT1=165
      Else
         _SEEN12=1 : _EXPECT1=90
      End If
      Aga Bob 1,_X0,_Y0,_I0
      Aga Bob 2,_X1,_Y1,_I1
      _BX=Aga X Bob(1) : _BY=Aga Y Bob(1) : _BI=Aga I Bob(1)
      If _BX<>_X0 or _BY<>_Y0 or _BI<>_I0
         _ERR=14 : Goto _CLEANUP
      End If
      _BX=Aga X Bob(2) : _BY=Aga Y Bob(2) : _BI=Aga I Bob(2)
      If _BX<>_X1 or _BY<>_Y1 or _BI<>_I1
         _ERR=14 : Goto _CLEANUP
      End If
      _SWAP=Aga Swap
      If _SWAP<>1
         ' Keep the first refusal visible; retry only after a full VBL.
         ' READY can recover; B8 DIRTY must remain refused.
         _SWAP_REFUSALS=_SWAP_REFUSALS+1
         If _SWAP_FIRST_FAIL_FRAME=0
            _SWAP_FIRST_FAIL_FRAME=_FRAME
         End If
         _SWAP_LAST_FAIL_FRAME=_FRAME
         _SWAP_LAST_TRIES=0
         For _WAIT_TRY=1 To _SWAP_RETRY_LIMIT
            If _SWAP<>1
               Aga Wait Vbl
               _RETRY_VBLS=_RETRY_VBLS+1
               _SWAP_LAST_TRIES=_WAIT_TRY
               _SWAP=Aga Swap
            End If
         Next _WAIT_TRY
         If _SWAP=1
            _SWAP_RECOVERED=_SWAP_RECOVERED+1
         Else
            _ERR=15 : Goto _CLEANUP
         End If
      End If
      _SWAPS=_SWAPS+1
      Aga Wait Vbl
      ' C Block Capture sees the prior displayed frame in the new back.
      If _PREV_VALID=1
         If (_PREVX0 and 7)=0
            _CAP=Aga C Block Capture(27,_PREVX0,_PREVY0,8,1,0)
            If _CAP<>1 or Length(27)<>56
               _ERR=16 : Goto _CLEANUP
            End If
            _PTR=Start(27)+40 : _VALUE=0 : _POWER=1
            For _PLANE=0 To 7
               If (Peek(_PTR+2*_PLANE) and 128)<>0
                  _VALUE=_VALUE+_POWER
               End If
               _POWER=_POWER*2
            Next _PLANE
            If _VALUE<>_PREVEXP0
               _PIX_ID=1 : _PIX_EXPECTED=_PREVEXP0
               _ERR=17 : Goto _CLEANUP
            End If
            _PIX0=_PIX0+1
         End If
         If (_PREVX1 and 7)=0
            _CAP=Aga C Block Capture(27,_PREVX1,_PREVY1,8,1,0)
            If _CAP<>1 or Length(27)<>56
               _ERR=16 : Goto _CLEANUP
            End If
            _PTR=Start(27)+40 : _VALUE=0 : _POWER=1
            For _PLANE=0 To 7
               If (Peek(_PTR+2*_PLANE) and 128)<>0
                  _VALUE=_VALUE+_POWER
               End If
               _POWER=_POWER*2
            Next _PLANE
            If _VALUE<>_PREVEXP1
               _PIX_ID=2 : _PIX_EXPECTED=_PREVEXP1
               _ERR=17 : Goto _CLEANUP
            End If
            _PIX1=_PIX1+1
         End If
      End If
      _PREVX0=_X0 : _PREVY0=_Y0 : _PREVEXP0=_EXPECT0
      _PREVX1=_X1 : _PREVY1=_Y1 : _PREVEXP1=_EXPECT1
      _PREV_VALID=1 : _VALID=_VALID+1
   Else
      If _VALID<>0
         _ERR=18 : Goto _CLEANUP
      End If
   End If
Next _FRAME
If _VALID<200 or _PIX0<2 or _PIX1<2
   _ERR=19
End If
If _CHG0X=0 or _CHG0Y=0 or _CHG0A=0
   _ERR=20
End If
If _CHG1X=0 or _CHG1Y=0 or _CHG1A=0
   _ERR=20
End If
If _SEEN01=0 or _SEEN02=0 or _SEEN11=0 or _SEEN12=0
   _ERR=21
End If
_CLEANUP:
If _AMAL1_ON=1
   Amal Off 1
End If
If _AMAL0_ON=1
   Amal Off 0
End If
If _SYNCHRO_OFF=1
   Synchro On
End If
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
End If
If Length(28)<>0
   Erase 28
End If
If Length(27)<>0
   Erase 27
End If
If Length(24)<>0
   Erase 24
End If
If _ERR=0 and _CLOSE_RETURNED=1
   _OK=1
End If
_VERDICT$="FAIL"
If _OK=1
   _VERDICT$="PASS"
End If
Print "M19 P2e1 TWO AMAL BOBS ";_VERDICT$;" ERR ";_ERR
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 P2E1 AMAL TWO BOBS"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"FRAME ";_FRAME
   Print #1,"VALID_SAMPLES ";_VALID
   Print #1,"SWAPS ";_SWAPS
   Print #1,"SWAP_REFUSALS ";_SWAP_REFUSALS
   Print #1,"SWAP_RECOVERED ";_SWAP_RECOVERED
   Print #1,"RETRY_VBLS ";_RETRY_VBLS
   Print #1,"SWAP_RETRY_LIMIT ";_SWAP_RETRY_LIMIT
   Print #1,"FIRST_REFUSAL_FRAME ";_SWAP_FIRST_FAIL_FRAME
   Print #1,"LAST_REFUSAL_FRAME ";_SWAP_LAST_FAIL_FRAME
   Print #1,"LAST_REFUSAL_TRIES ";_SWAP_LAST_TRIES
   Print #1,"LAST_SWAP_RESULT ";_SWAP
   Print #1,"BG0 ";_BG0
   Print #1,"BG1 ";_BG1
   Print #1,"PIX0 ";_PIX0
   Print #1,"PIX1 ";_PIX1
   Print #1,"CHG0_X ";_CHG0X
   Print #1,"CHG0_Y ";_CHG0Y
   Print #1,"CHG0_A ";_CHG0A
   Print #1,"CHG1_X ";_CHG1X
   Print #1,"CHG1_Y ";_CHG1Y
   Print #1,"CHG1_A ";_CHG1A
   Print #1,"SEEN01 ";_SEEN01
   Print #1,"SEEN02 ";_SEEN02
   Print #1,"SEEN11 ";_SEEN11
   Print #1,"SEEN12 ";_SEEN12
   Print #1,"RAW0_LAST ";_RAW0
   Print #1,"RAW1_LAST ";_RAW1
   Print #1,"BYTE0_LAST ";_BYTE0
   Print #1,"BYTE1_LAST ";_BYTE1
   Print #1,"FLAG0_X ";_FLAG0_X
   Print #1,"FLAG0_Y ";_FLAG0_Y
   Print #1,"FLAG0_A ";_FLAG0_A
   Print #1,"FLAG1_X ";_FLAG1_X
   Print #1,"FLAG1_Y ";_FLAG1_Y
   Print #1,"FLAG1_A ";_FLAG1_A
   Print #1,"PIXEL_ID ";_PIX_ID
   Print #1,"PIXEL_VALUE ";_VALUE
   Print #1,"PIXEL_EXPECTED ";_PIX_EXPECTED
   Print #1,"LAST0_X ";_X0
   Print #1,"LAST0_Y ";_Y0
   Print #1,"LAST0_IMAGE ";_I0
   Print #1,"LAST1_X ";_X1
   Print #1,"LAST1_Y ";_Y1
   Print #1,"LAST1_IMAGE ";_I1
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "SWAP FIRST REFUSALS ";_SWAP_REFUSALS;" RECOVERED ";_SWAP_RECOVERED
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
