' M13-R30-AGAPAL-BANK-INIT-01
' Requires R30 0.10.2 dist/AMOSPro_AGA.Lib installed in APSystem.
' The function takes Start(bank) (an address), NOT a bank number.
' WARNING: overwrites native AMOS banks 10 and 11 and
' RAM:R30_AGAPAL_TEST.ABK; no pixel or palette screen changes.
Cls
Print "M13-R30-AGAPAL-BANK-INIT-01"
_B=10
_N=8
_LEN=16+_N*776
Reserve As Data _B,_LEN
_PTR=Start(_B)
_OK=Aga Palette Bank Init(_PTR,_N)
_NAME$=Peek$(_PTR-8,8)
_HEADER$=Peek$(_PTR,6)
_VERSION=Deek(_PTR+6)
_COUNT=Deek(_PTR+8)
_OFF0=Leek(_PTR+16)
_OFF7=Leek(_PTR+72)
_RGB0=Peek(_PTR+80)
' Zero and excessive palette counts must fail without modifying data.
_BAD0=Aga Palette Bank Init(_PTR,0)
_BAD257=Aga Palette Bank Init(_PTR,257)
_STILL=Peek$(_PTR,6)
' A bank with the wrong capacity must not be modified on failure.
Reserve As Data 11,6000
_PTR11=Start(11)
Poke _PTR11,99
_BADSIZE=Aga Palette Bank Init(_PTR11,8)
_SENTINEL=Peek(_PTR11)
Erase 11
' Re-initialize previously modified palette data (expected zero).
Poke _PTR+80,99
_REINIT=Aga Palette Bank Init(_PTR,_N)
_ZERO=Peek(_PTR+80)
' Save native ABK through AMOS, erase and load it again.
Save "RAM:R30_AGAPAL_TEST.ABK",_B
Erase _B
Load "RAM:R30_AGAPAL_TEST.ABK",_B
_PTR=Start(_B)
_RESTNAME$=Peek$(_PTR-8,8)
_RESTHEAD$=Peek$(_PTR,6)
_RESTVER=Deek(_PTR+6)
_RESTCOUNT=Deek(_PTR+8)
_RESTSIZE=Length(_B)
_REST0=Leek(_PTR+16)
_REST7=Leek(_PTR+72)
_INDEXOK=1
For _I=0 To _N-1
   _ENTRY=_PTR+16+8*_I
   _EXPECTED=16+8*_N+768*_I
   If Leek(_ENTRY)<>_EXPECTED
      _INDEXOK=0
   End If
   If Deek(_ENTRY+4)<>0
      _INDEXOK=0
   End If
   If Deek(_ENTRY+6)<>0
      _INDEXOK=0
   End If
   If Peek(_PTR+_EXPECTED)<>0
      _INDEXOK=0
   End If
Next _I
_RESULT=1
If _OK<>1 or _REINIT<>1
   _RESULT=0
End If
If _BAD0<>0 or _BAD257<>0 or _BADSIZE<>0 or _SENTINEL<>99
   _RESULT=0
End If
If _NAME$<>"AGAPAL  " or _HEADER$<>"AGAPAL" or _STILL<>"AGAPAL"
   _RESULT=0
End If
If _VERSION<>1 or _COUNT<>8 or _OFF0<>80 or _OFF7<>5456
   _RESULT=0
End If
If _RGB0<>0 or _ZERO<>0
   _RESULT=0
End If
If _RESTNAME$<>"AGAPAL  " or _RESTHEAD$<>"AGAPAL"
   _RESULT=0
End If
If _RESTVER<>1 or _RESTCOUNT<>8 or _RESTSIZE<>6224
   _RESULT=0
End If
If _REST0<>80 or _REST7<>5456 or _INDEXOK<>1
   _RESULT=0
End If
Print "INIT ";_OK;" REINIT ";_REINIT
Print "HEADER ";_HEADER$;" V";_VERSION;" COUNT ";_COUNT
Print "OFFSET0 ";_OFF0;" OFFSET7 ";_OFF7
Print "BAD0 ";_BAD0;" BAD257 ";_BAD257;" BADSIZE ";_BADSIZE
Print "SENTINEL ";_SENTINEL;" ZERO ";_ZERO
Print "ABK RESTORED ";_RESTNAME$;" SIZE ";_RESTSIZE
Print "REST0 ";_REST0;" REST7 ";_REST7;" INDEX ";_INDEXOK
Print "RESULT ";_RESULT
Erase _B
Print "CLOSE RETURNED"
End
