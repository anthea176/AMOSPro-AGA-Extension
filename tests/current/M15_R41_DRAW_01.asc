' M15-R41-DRAW-01 : AMOS interpreted/WinUAE Gate B (NOT TESTED YET).
' Requires R41 v0.11.2 candidate, NOT R40 LAST_GOOD.
' Draws 8 directions plus four safely clipped crossing lines.
' No external IFF or ABK needed. Inspect visual output AND final values.
Cls
Print "M15-R41-DRAW-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,255,128,32)
_P3=Aga Palette Set(3,128,255,128)
_P4=Aga Palette Set(4,80,160,255)
_P5=Aga Palette Set(5,255,80,160)
_P6=Aga Palette Set(6,255,240,32)
_P7=Aga Palette Set(7,208,128,255)
_P8=Aga Palette Set(8,64,255,240)
_CLR=Aga Blit Clear(0,0,320,256)
_T1=Aga Text(20,25,1,"M15 / R41 - AGA DRAW")
_T2=Aga Text(20,236,1,"CLIPPED LINES SAFE")
' Outer rectangle; all endpoints are on the valid pixel boundary.
_B0=Aga Draw(0,0,319,0,1)
_B1=Aga Draw(319,0,319,255,1)
_B2=Aga Draw(319,255,0,255,1)
_B3=Aga Draw(0,255,0,0,1)
' Four crossing lines with deliberately out-of-screen endpoints.
_C0=Aga Draw(-64,-64,384,320,2)
_C1=Aga Draw(-64,320,384,-64,3)
_C2=Aga Draw(-64,128,384,128,4)
_C3=Aga Draw(160,-64,160,320,5)
' Eight 1-pixel star spokes: all octants, native fast Move/Draw.
_L1=Aga Draw(160,128,270,180,1)
_L2=Aga Draw(160,128,200,225,2)
_L3=Aga Draw(160,128,120,225,3)
_L4=Aga Draw(160,128,50,180,4)
_L5=Aga Draw(160,128,50,80,5)
_L6=Aga Draw(160,128,120,40,6)
_L7=Aga Draw(160,128,200,40,7)
_L8=Aga Draw(160,128,270,80,8)
_CENTER=Aga Draw(160,128,160,128,8)
' Completely offscreen: should not draw any pixel or corrupt memory.
_O0=Aga Draw(-30,5,-1,250,1)
_O1=Aga Draw(320,5,350,250,1)
_O2=Aga Draw(2,-30,315,-1,1)
_O3=Aga Draw(2,256,315,300,1)
' Invalid 32-bit endpoints are refused, NOT truncated to 16-bit.
_LONG=Aga Draw(32768,50,20,50,1)
_NEG=Aga Draw(-32769,50,20,50,1)
_BADP=Aga Draw(0,0,10,10,256)
_BADN=Aga Draw(0,0,10,10,-1)
_ERR=0
If _L1<>1 or _L2<>1 or _L3<>1 or _L4<>1
   _ERR=_ERR+1
End If
If _L5<>1 or _L6<>1 or _L7<>1 or _L8<>1
   _ERR=_ERR+1
End If
_SW=Aga Swap
If _SW=1
   Amos To Back
End If
' The newly inactive back buffer must become Safe before this line.
_SAFE=0
For _I=1 To 30
   If _SAFE=0
      _SAFE=Aga Draw(-10,100,329,200,2)
   End If
   Aga Wait Vbl
Next _I
For _I=1 To 135
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Draw(0,0,10,10,1)
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _CLR<>1 or _T1<>1 or _T2<>1
   _RESULT=0
End If
If _P1<>1 or _P2<>1 or _P3<>1 or _P4<>1
   _RESULT=0
End If
If _P5<>1 or _P6<>1 or _P7<>1 or _P8<>1
   _RESULT=0
End If
If _B0<>1 or _B1<>1 or _B2<>1 or _B3<>1
   _RESULT=0
End If
If _C0<>1 or _C1<>1 or _C2<>1 or _C3<>1
   _RESULT=0
End If
If _ERR<>0 or _CENTER<>1 or _SW<>1 or _SAFE<>1
   _RESULT=0
End If
If _O0<>0 or _O1<>0 or _O2<>0 or _O3<>0
   _RESULT=0
End If
If _LONG<>0 or _NEG<>0 or _BADP<>0 or _BADN<>0
   _RESULT=0
End If
If _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "M15-R41-DRAW-01"
Print "OPEN ";_OPEN;" DB ";_DB;" CLEAR ";_CLR
Print "BORDER ";_B0;" ";_B1;" ";_B2;" ";_B3
Print "CLIPPED ";_C0;" ";_C1;" ";_C2;" ";_C3
Print "STAR 8 ERR ";_ERR;" CENTER ";_CENTER
Print "OUTSIDE ";_O0;" ";_O1;" ";_O2;" ";_O3
Print "BADLONG ";_LONG;" ";_NEG
Print "BADPEN ";_BADP;" ";_BADN
Print "SWAP ";_SW;" BACKSAFE ";_SAFE
Print "NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
