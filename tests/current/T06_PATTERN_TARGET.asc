' T06A P2d-L2: locate Pattern pixels after a settled Swap.
' WinUAE only. No IFF/ABK. Bank 27 must be free.
' Never call Pattern while Safe is pending in this first probe.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:T06_PATTERN_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:T06_PATTERN_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:T06_PATTERN_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:T06_PATTERN_COMPILED.TXT"
End If
_ERR=0 : _OK=0 : _PH=1 : _OPEN=0 : _OWN=0
_SINGLE_RETURNED=0 : _SINGLE_CLOSED=0 : _CLOSE_RETURNED=0 : _CLOSED=-99
_PROBE_COMPLETE=0 : _TARGET$="UNKNOWN" : _SWAPS=0 : _SWAP_REFUSALS=0
_SWAP_RECOVERED=0 : _CAP_RETRIES=0 : _FILL_RETRIES=0
_BACK_MARK=17 : _FRONT_MARK=239 : _BACK_KIND=-1 : _FRONT_KIND=-1
_B0=-1 : _B1=-1 : _B2=-1 : _F0=-1 : _F1=-1 : _F2=-1
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(27)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OWN=1
' Historical single-buffer Pattern example: visual observation only.
Print "T06 PH1 SINGLE PATTERN - GRADIENT"
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
Aga Screen Pattern
_SINGLE_RETURNED=1
Amos To Back
For _I=1 To 100
   Aga Wait Vbl
Next _I
Aga Screen Close
_CLOSE_RETURNED=1
Amos To Front
_CLOSED=Aga Mouse X
If _CLOSED<>-1
   _ERR=4 : Goto _REPORT
End If
_SINGLE_CLOSED=1 : _OPEN=0 : _CLOSE_RETURNED=0
' New screen: independently mark both physical pages, no Bobs.
_PH=2
Print "T06 PH2 DOUBLE BUFFER - SEED TWO PAGES"
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=5 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=6 : Goto _CLEANUP
End If
Amos To Back
_PEN=_BACK_MARK : Gosub _FILL
If _A<>1
   _ERR=10 : Goto _CLEANUP
End If
_EXPECT=_BACK_MARK : Gosub _SAMPLE
If _CAPOK<>1 or _KIND<>0
   _ERR=11 : Goto _CLEANUP
End If
Gosub _SWAP
If _SW<>1
   _ERR=12 : Goto _CLEANUP
End If
_PEN=_FRONT_MARK : Gosub _FILL
If _A<>1
   _ERR=13 : Goto _CLEANUP
End If
_EXPECT=_FRONT_MARK : Gosub _SAMPLE
If _CAPOK<>1 or _KIND<>0
   _ERR=14 : Goto _CLEANUP
End If
Gosub _SWAP
If _SW<>1
   _ERR=15 : Goto _CLEANUP
End If
' Let the display settle. Successful capture also checks/acquires Safe.
_PH=3
For _I=1 To 3
   Aga Wait Vbl
Next _I
_EXPECT=_BACK_MARK : Gosub _SAMPLE
If _CAPOK<>1 or _KIND<>0
   _ERR=20 : Goto _CLEANUP
End If
' Pattern's palette and pixel effects are different. Read indices only.
_PH=4
Aga Screen Pattern
For _I=1 To 3
   Aga Wait Vbl
Next _I
_EXPECT=_BACK_MARK : Gosub _SAMPLE
If _CAPOK<>1
   _ERR=30 : Goto _CLEANUP
End If
_BACK_KIND=_KIND : _B0=_P0 : _B1=_P1 : _B2=_P2
' Read the old front by making it back. Do not fill either page again.
' This is a diagnostic Swap, even if Pattern drew on the wrong page.
If _BACK_KIND=2
   _ERR=31 : Goto _CLEANUP
End If
_PH=5
Gosub _SWAP
If _SW<>1
   _ERR=40 : Goto _CLEANUP
End If
For _I=1 To 3
   Aga Wait Vbl
Next _I
_EXPECT=_FRONT_MARK : Gosub _SAMPLE
If _CAPOK<>1
   _ERR=41 : Goto _CLEANUP
End If
_FRONT_KIND=_KIND : _F0=_P0 : _F1=_P1 : _F2=_P2
_PROBE_COMPLETE=1
_TARGET$="MIXED"
If _BACK_KIND=1 and _FRONT_KIND=0
   _TARGET$="BACK"
   _OK=1
End If
If _BACK_KIND=0 and _FRONT_KIND=1
   _TARGET$="FRONT"
End If
If _BACK_KIND=1 and _FRONT_KIND=1
   _TARGET$="BOTH"
End If
If _BACK_KIND=0 and _FRONT_KIND=0
   _TARGET$="NONE"
End If
If _OK<>1
   _ERR=50
End If
For _I=1 To 100
   Aga Wait Vbl
Next _I
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
   _CLOSED=Aga Mouse X
   If _CLOSED<>-1
      _OK=0
      If _ERR=0
         _ERR=60
      End If
   End If
End If
If _OWN=1
   If _OPEN<>1 or _CLOSED=-1
      If Length(27)<>0
         Erase 27
      End If
   End If
End If
_REPORT:
_VERDICT$="FAIL"
If _OK=1 and _ERR=0 and _PROBE_COMPLETE=1 and _CLOSED=-1
   _VERDICT$="PASS"
End If
Print "T06 TARGET ";_TARGET$;" ";_VERDICT$;" ERR ";_ERR
Print "BACK ";_B0;" ";_B1;" ";_B2;" FRONT ";_F0;" ";_F1;" ";_F2
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST T06 PATTERN TARGET"
   Print #1,"SOURCE_TAG T06_PATTERN_TARGET_V1_20261124"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"PHASE_LAST ";_PH
   Print #1,"SINGLE_RETURNED ";_SINGLE_RETURNED
   Print #1,"SINGLE_CLOSED ";_SINGLE_CLOSED
   Print #1,"PROBE_COMPLETE ";_PROBE_COMPLETE
   Print #1,"TARGET ";_TARGET$
   Print #1,"BACK_KIND ";_BACK_KIND
   Print #1,"FRONT_KIND ";_FRONT_KIND
   Print #1,"BACK_Y64 ";_B0
   Print #1,"BACK_Y128 ";_B1
   Print #1,"BACK_Y192 ";_B2
   Print #1,"FRONT_Y64 ";_F0
   Print #1,"FRONT_Y128 ";_F1
   Print #1,"FRONT_Y192 ";_F2
   Print #1,"SWAPS ";_SWAPS
   Print #1,"SWAP_REFUSALS ";_SWAP_REFUSALS
   Print #1,"SWAP_RECOVERED ";_SWAP_RECOVERED
   Print #1,"CAP_RETRIES ";_CAP_RETRIES
   Print #1,"FILL_RETRIES ";_FILL_RETRIES
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"CLOSED_MOUSE_X ";_CLOSED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
_FILL:
_A=Aga Blit Fill(0,0,320,256,_PEN)
For _TRY=1 To 4
   If _A<>1
      Aga Wait Vbl
      _FILL_RETRIES=_FILL_RETRIES+1
      _A=Aga Blit Fill(0,0,320,256,_PEN)
   End If
Next _TRY
Return
_SWAP:
_SW=Aga Swap
If _SW<>1
   _SWAP_REFUSALS=_SWAP_REFUSALS+1
   For _TRY=1 To 4
      If _SW<>1
         Aga Wait Vbl
         _SW=Aga Swap
      End If
   Next _TRY
   If _SW=1
      _SWAP_RECOVERED=_SWAP_RECOVERED+1
   End If
End If
If _SW=1
   _SWAPS=_SWAPS+1
End If
Return
_SAMPLE:
' KIND 0=original mark; 1=expected gradient; 2=mixed/other.
_KIND=2 : _P0=-1 : _P1=-1 : _P2=-1
_Y=64 : Gosub _READ_PIXEL
If _CAPOK<>1
   Return
End If
_P0=_VALUE
_Y=128 : Gosub _READ_PIXEL
If _CAPOK<>1
   Return
End If
_P1=_VALUE
_Y=192 : Gosub _READ_PIXEL
If _CAPOK<>1
   Return
End If
_P2=_VALUE
If _P0=_EXPECT and _P1=_EXPECT and _P2=_EXPECT
   _KIND=0
End If
If _P0=64 and _P1=128 and _P2=192
   _KIND=1
End If
Return
_READ_PIXEL:
_CAPOK=0 : _VALUE=-1
_CAP=Aga C Block Capture(27,160,_Y,8,1,0)
For _TRY=1 To 4
   If _CAP<>1
      Aga Wait Vbl
      _CAP_RETRIES=_CAP_RETRIES+1
      _CAP=Aga C Block Capture(27,160,_Y,8,1,0)
   End If
Next _TRY
If _CAP=1 and Length(27)=56
   _CAPOK=1 : _PTR=Start(27)+40 : _VALUE=0 : _POWER=1
   For _PLANE=0 To 7
      If (Peek(_PTR+2*_PLANE) and 128)<>0
         _VALUE=_VALUE+_POWER
      End If
      _POWER=_POWER*2
   Next _PLANE
End If
Return
