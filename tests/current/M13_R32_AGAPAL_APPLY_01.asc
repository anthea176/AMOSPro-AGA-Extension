' M13-R32-AGAPAL-APPLY-01 — Gate B AMOS interpreted / WinUAE.
' Requires R32 0.10.4 candidate installed in APSystem (not R31 LAST_GOOD).
' WARNING: replaces AMOS banks 10 and 11, RAM:R32_AGAPAL_APPLY.ABK.
' Apply uses Start(bank), not the numeric bank number.
Cls
Print "M13-R32-AGAPAL-APPLY-01"
_B=10
_N=8
Reserve As Data _B,6224
_PTR=Start(_B)
_INIT=Aga Palette Bank Init(_PTR,_N)
If _INIT<>1
   Print "INIT FAILED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_CLR=Aga Blit Clear(0,0,320,256)
_PANEL=Aga Blit Fill(25,70,270,115,28)
_BAR=Aga Blit Fill(25,204,270,12,224)
_P3=Aga Palette Set(3,10,20,30)
_P224=Aga Palette Set(224,12,34,56)
_GREEN=Aga Palette Set(28,0,255,0)
_CAP0=Aga Palette Bank Capture(_PTR,0)
_RED=Aga Palette Set(28,255,0,0)
_CAP1=Aga Palette Bank Capture(_PTR,1)
_BLUE=Aga Palette Set(28,0,0,255)
_ALT224=Aga Palette Set(224,88,99,111)
_BEFORE=Aga Palette Get(28)
_AP0=Aga Palette Bank Apply(_PTR,0)
_GOTGREEN=Aga Palette Get(28)
_RESTORE224=Aga Palette Get(224)
_AP1=Aga Palette Bank Apply(_PTR,1)
_GOTRED=Aga Palette Get(28)
' Partial palette: only pens 0..3 are reapplied; pen 28 stays blue.
_BLUE2=Aga Palette Set(28,0,0,255)
_WHITE3=Aga Palette Set(3,255,255,255)
Poke _PTR+20,0
Poke _PTR+21,4
_PART=Aga Palette Bank Apply(_PTR,0)
_PART3=Aga Palette Get(3)
_PART28=Aga Palette Get(28)
' Invalid indices, empty slot, bad DATA capacity cannot alter screen.
_BADNEG=Aga Palette Bank Apply(_PTR,-1)
_BAD8=Aga Palette Bank Apply(_PTR,8)
_EMPTY=Aga Palette Bank Apply(_PTR,2)
Reserve As Data 11,6000
_PTR11=Start(11)
Poke _PTR11,99
_BADSIZE=Aga Palette Bank Apply(_PTR11,0)
_SENTINEL=Peek(_PTR11)
Erase 11
_AFTERBAD=Aga Palette Get(28)
' Invalid palette color count 257 must be rejected, then restore 256.
Poke _PTR+28,1
Poke _PTR+29,1
_BADCOUNT=Aga Palette Bank Apply(_PTR,1)
Poke _PTR+28,1
Poke _PTR+29,0
_AFTERCOUNT=Aga Palette Get(28)
' Persist native AMOS ABK and re-apply after native Load.
Save "RAM:R32_AGAPAL_APPLY.ABK",_B
Erase _B
Load "RAM:R32_AGAPAL_APPLY.ABK",_B
_PTR=Start(_B)
_RESTNAME$=Peek$(_PTR-8,8)
_RESTHEAD$=Peek$(_PTR,6)
_RESTSIZE=Length(_B)
_RESTCOUNT0=Deek(_PTR+20)
_RESTCOUNT1=Deek(_PTR+28)
_FROMABK=Aga Palette Bank Apply(_PTR,1)
_RESTRED=Aga Palette Get(28)
_PARTABK=Aga Palette Bank Apply(_PTR,0)
_REST3=Aga Palette Get(3)
_REST28=Aga Palette Get(28)
_SWAP=Aga Swap
Amos To Back
For _I=1 To 80
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Palette Bank Apply(_PTR,1)
_CLOSED=Aga Mouse X
_RESULT=1
If _INIT<>1 or _OPEN<>1 or _DB<>1
   _RESULT=0
End If
If _CLR<>1 or _PANEL<>1 or _BAR<>1 or _SWAP<>1
   _RESULT=0
End If
If _P3<>1 or _P224<>1 or _GREEN<>1 or _RED<>1
   _RESULT=0
End If
If _BLUE<>1 or _ALT224<>1 or _BLUE2<>1 or _WHITE3<>1
   _RESULT=0
End If
If _CAP0<>1 or _CAP1<>1 or _AP0<>1 or _AP1<>1
   _RESULT=0
End If
If _BEFORE<>255 or _GOTGREEN<>65280 or _GOTRED<>16711680
   _RESULT=0
End If
If _RESTORE224<>795192
   _RESULT=0
End If
If _PART<>1 or _PART3<>660510 or _PART28<>255
   _RESULT=0
End If
If _BADNEG<>0 or _BAD8<>0 or _EMPTY<>0 or _BADSIZE<>0
   _RESULT=0
End If
If _BADCOUNT<>0 or _SENTINEL<>99
   _RESULT=0
End If
If _AFTERBAD<>255 or _AFTERCOUNT<>255
   _RESULT=0
End If
If _RESTNAME$<>"AGAPAL  " or _RESTHEAD$<>"AGAPAL"
   _RESULT=0
End If
If _RESTSIZE<>6224 or _RESTCOUNT0<>4 or _RESTCOUNT1<>256
   _RESULT=0
End If
If _FROMABK<>1 or _RESTRED<>16711680 or _PARTABK<>1
   _RESULT=0
End If
If _REST3<>660510 or _REST28<>16711680
   _RESULT=0
End If
If _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Print "M13-R32-AGAPAL-APPLY-01"
Print "INIT ";_INIT;" OPEN ";_OPEN;" DB ";_DB
Print "CAP0 ";_CAP0;" CAP1 ";_CAP1
Print "AP0 ";_AP0;" AP1 ";_AP1;" PART ";_PART
Print "GREEN ";_GOTGREEN;" RED ";_GOTRED;" BLUE ";_BEFORE
Print "PEN224 ";_RESTORE224;" PART3 ";_PART3;" PART28 ";_PART28
Print "BADNEG ";_BADNEG;" BAD8 ";_BAD8;" EMPTY ";_EMPTY
Print "BADSIZE ";_BADSIZE;" BADCOUNT ";_BADCOUNT
Print "AFTERBAD ";_AFTERBAD;" AFTERCOUNT ";_AFTERCOUNT
Print "ABK ";_RESTNAME$;" SIZE ";_RESTSIZE
Print "COUNT0 ";_RESTCOUNT0;" COUNT1 ";_RESTCOUNT1
Print "RELOAD ";_FROMABK;" ";_RESTRED;" PART ";_PARTABK
Print "REST3 ";_REST3;" REST28 ";_REST28
Print "NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Erase _B
Print "CLOSE RETURNED"
End
