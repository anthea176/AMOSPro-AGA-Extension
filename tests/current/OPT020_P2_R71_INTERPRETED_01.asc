' OPT020/P2 R71 - WinUAE AGA 68020/68030, interpreted ONLY.
' GATE B only. NEVER run AMOS Compiler during this test.
' R71 P1e+P2: Region & Draw native CPU020, no public API changes.
' AGAPIC v1 64x40x4 bank 10; Load replaces an existing bank.
' Check opaque, mask, clipped, source bank and no-screen refusal.
' Only one active ASC. R68 LAST_GOOD and archives are protected.
Print "OPT020-P2-R71-INTERPRETED-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
Load "M16_AGAPIC_SAMPLE_BANK10.abk",10
_BASE=Start(10)
_LEN=Length(10)
If _BASE=0 or _LEN<>1836
   Print "AGAPIC BANK 10 MISSING"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   Erase 10
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 10
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,255,40,190)
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,20,35,65)
_P3=Aga Palette Set(3,255,202,50)
_SW0=0
For _TRY=1 To 20
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
_D0=0
_D1=0
_D2=0
_D3=0
_SHIFT=0
_CL=0
_CR=0
_CT=0
_CB=0
_OUT=0
_EDGE=0
_PART=0
_MASKOPAQUE=0
_P2OPA=0
_P2MSK=0
_P2SHIFT=0
_P2LEFT=0
_P2RIGHT=0
_P2TOP=0
_P2BOTTOM=0
_P2OUT=0
_P2BADP=0
_P2BADL=0
_P2BADM=0
_P2BADX=0
_BADB=0
_BADX=0
_BADY=0
_BADW=0
_BADM=0
_OLD=0
_SWAP=0
If _READY=1
   _BG=Aga Blit Fill(0,0,320,256,2)
   _P2OPA=Aga Image Draw(_BASE,_LEN,18,20,0)
   _P2MSK=Aga Image Draw(_BASE,_LEN,108,20,1)
   _P2SHIFT=Aga Image Draw(_BASE,_LEN,197,22,1)
   _P2LEFT=Aga Image Draw(_BASE,_LEN,-15,196,1)
   _P2RIGHT=Aga Image Draw(_BASE,_LEN,291,182,0)
   _P2TOP=Aga Image Draw(_BASE,_LEN,256,-17,1)
   _P2BOTTOM=Aga Image Draw(_BASE,_LEN,105,241,1)
   _P2OUT=Aga Image Draw(_BASE,_LEN,320,256,0)
   _P2BADP=Aga Image Draw(0,_LEN,20,20,1)
   _P2BADL=Aga Image Draw(_BASE,20,20,20,0)
   _P2BADM=Aga Image Draw(_BASE,_LEN,20,20,2)
   _P2BADX=Aga Image Draw(_BASE,_LEN,32768,20,0)
   _D0=Aga Image Region(10,0,0,32,20,20,65,0)
   _D1=Aga Image Region(10,32,0,32,20,88,65,1)
   _D2=Aga Image Region(10,0,20,32,20,156,65,0)
   _D3=Aga Image Region(10,32,20,32,20,224,65,1)
   _SHIFT=Aga Image Region(10,19,7,19,11,271,99,1)
   _CL=Aga Image Region(10,0,0,19,11,-7,140,1)
   _CR=Aga Image Region(10,0,0,19,11,310,141,1)
   _CT=Aga Image Region(10,0,0,19,11,80,-5,1)
   _CB=Aga Image Region(10,0,0,19,11,130,251,1)
   _OUT=Aga Image Region(10,0,0,19,11,320,256,1)
   _EDGE=Aga Image Region(10,0,0,16,16,304,208,0)
   _PART=Aga Image Region(10,1,1,17,12,313,240,1)
   _MASKOPAQUE=Aga Image Region(10,19,7,17,11,40,205,0)
   _BADB=Aga Image Region(4,0,0,16,16,10,10,0)
   _BADX=Aga Image Region(10,-1,0,16,16,10,10,0)
   _BADY=Aga Image Region(10,0,39,16,2,10,10,0)
   _BADW=Aga Image Region(10,0,0,0,16,10,10,0)
   _BADM=Aga Image Region(10,0,0,16,16,10,10,2)
   _OLD=Aga Bank Image Draw(10,116,169,0)
End If
For _TRY=1 To 20
   If _SWAP=0
      _SWAP=Aga Swap
   End If
   If _SWAP=0
      Aga Wait Vbl
   End If
Next _TRY
If _SWAP=1
   Amos To Back
End If
For _HOLD=1 To 125
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOS=Aga Image Region(10,0,0,16,16,25,25,0)
_P2NOS=Aga Image Draw(_BASE,_LEN,25,25,0)
Erase 10
_CF1=Chip Free
_RESULT=1
If _OPEN<>1 or _DB<>1 or _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
   _RESULT=0
End If
If _SW0<>1 or _READY<>1 or _BG<>1 or _SWAP<>1
   _RESULT=0
End If
If _P2OPA<>1 or _P2MSK<>1 or _P2SHIFT<>1 or _P2LEFT<>1 or _P2RIGHT<>1
   _RESULT=0
End If
If _P2TOP<>1 or _P2BOTTOM<>1 or _P2OUT<>1
   _RESULT=0
End If
If _P2BADP<>0 or _P2BADL<>0 or _P2BADM<>0 or _P2BADX<>0 or _P2NOS<>0
   _RESULT=0
End If
If _D0<>1 or _D1<>1 or _D2<>1 or _D3<>1 or _SHIFT<>1
   _RESULT=0
End If
If _CL<>1 or _CR<>1 or _CT<>1 or _CB<>1 or _OUT<>1 or _EDGE<>1 or _PART<>1 or _MASKOPAQUE<>1
   _RESULT=0
End If
If _BADB<>0 or _BADX<>0 or _BADY<>0 or _BADW<>0 or _BADM<>0
   _RESULT=0
End If
If _OLD<>1 or _NOS<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "OPT020-P2-R71-INTERPRETED-01"
Print "OPT020 P1e+P2 - GATE B ONLY"
Print "P2 O/M/SHIFT ";_P2OPA;" ";_P2MSK;" ";_P2SHIFT
Print "P2 CLIP L/R/T/B ";_P2LEFT;" ";_P2RIGHT;" ";_P2TOP;" ";_P2BOTTOM
Print "P2 OUT/BAD P/L/M/X/NOS ";_P2OUT;" ";_P2BADP;" ";_P2BADL;" ";_P2BADM;" ";_P2BADX;" ";_P2NOS
Print "OPEN ";_OPEN;" DB ";_DB;" SW0 ";_SW0;" SAFE ";_READY
Print "FRAMES ";_D0;" ";_D1;" ";_D2;" ";_D3;" SHIFT ";_SHIFT
Print "CLIP ";_CL;" ";_CR;" ";_CT;" ";_CB;" OUT ";_OUT
Print "EDGE/PART/MASK OPAQUE ";_EDGE;" ";_PART;" ";_MASKOPAQUE
Print "BAD BANK/X/Y/W/M ";_BADB;" ";_BADX;" ";_BADY;" ";_BADW;" ";_BADM
Print "LEGACY ";_OLD;" SWAP ";_SWAP;" NOS ";_NOS;" CLOSE ";_CLOSED
Print "CHIP BEFORE/END ";_CF0;" ";_CF1
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
