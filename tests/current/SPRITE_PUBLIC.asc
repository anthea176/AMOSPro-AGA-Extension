' M19 S1-P2l-c - detailed idle refusal, two launches.
' Reset once before phase 1; never reset between phases.
Set Buffer 20
Cls
_PRG=Prg State
_MODE$="UNKNOWN"
_LOG$="RAM:M19_P2LC_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:M19_P2LC_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:M19_P2LC_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:M19_P2LC_COMPILED.TXT"
End If
Print "1 = DISPLAY AFTER RESET"
Print "2 = QUARANTINE WITHOUT RESET"
Input "PHASE (1 OR 2)";_PHASE
If _PHASE<>1 and _PHASE<>2
   Print "INVALID PHASE"
   End
End If
If _PHASE=1
   _LOG$="RAM:M19_P2LC_P1_"+_MODE$+".TXT"
Else
   _LOG$="RAM:M19_P2LC_P2_"+_MODE$+".TXT"
End If
_ERR=0 : _CLEAN_ERR=0 : _RESULT=0 : _OPEN=0 : _BANK_OWN=0
_HIDDEN=0 : _ATTEMPT=0 : _SPRITE_RC=-999 : _MOVE_RC=-999
_OFF_RC=-999 : _BANK_FREE_RC=-999 : _CURSOR_RC=-999
_CLOSE_RETURNED=0 : _CLOSED=0 : _MOVES=0 : _ERASED=0
_CPU=Deek(Leek(4)+296) and $FFFF
_DIAG_START=-999 : _DIAG_ACTIVE=-999
_DIAG_CLOSE=-999 : _DIAG_FRONT=-999
_DIAG_OK=0 : _OBS$="NOT TESTED"
_CHIP0=Chip Free : _FAST0=Fast Free
If Aga Detect=0
   _ERR=1
End If
If Length(29)<>0
   _ERR=2
End If
If _ERR=0
   _DIAG_START=Aga Sprite Bank Free(-19000)
End If
If _ERR=0
   Trap Load "AGSP_S1P1E_FINAL.ABK",29
   _IO=Errtrap
   If Length(29)<>0
      _BANK_OWN=1
   End If
   If _IO<>0 or Length(29)<>512
      _ERR=3
   End If
End If
If _ERR=0
   _OPEN=Aga Screen Open(320,256,256,$21000)
   If _OPEN<>1
      _ERR=4
   End If
End If
If _ERR=0
   _OK=Aga Double Buffer
   If _OK<>1
      _ERR=5
   End If
End If
If _ERR=0
   _OK=Aga Blit Fill(0,0,320,256,0)
   If _OK<>1
      _ERR=6
   End If
End If
If _ERR=0
   _OK=Aga Swap
   If _OK<>1
      _ERR=7
   Else
      Aga Wait Vbl
   End If
End If
If _ERR=0
   _P0=Aga Palette Set(0,12,20,30)
   _P1=Aga Palette Set(21,255,70,40)
   _P2=Aga Palette Set(22,36,220,117)
   _P3=Aga Palette Set(23,26,115,255)
   If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
      _ERR=8
   End If
End If
If _ERR=0
   _OK=Aga Mouse Cursor(0)
   If _OK<>1
      _ERR=9
   Else
      _HIDDEN=1
      Aga Wait Vbl
   End If
End If
If _ERR=0
   Aga Sprite Bank 29
   Amos To Back
   Aga Wait Vbl
   _ATTEMPT=1
   _SPRITE_RC=Aga Sprite(1,32,112,3)
   If _PHASE=1
      If _SPRITE_RC<>1
         _ERR=10
      End If
   Else
      If _SPRITE_RC<>-123
         _ERR=13
      End If
   End If
End If
If _ERR=0
   Erase 29
   _BANK_OWN=0
   If Length(29)<>0
      _ERR=11
   Else
      _ERASED=1
   End If
End If
If _ERR=0 and _PHASE=1
   For _FRAME=1 To 100
      If _ERR=0
         _MOVE_RC=Aga Sprite(1,32+_FRAME*2,112,3)
         If _MOVE_RC=1
            _MOVES=_MOVES+1
            Aga Wait Vbl
         Else
            _ERR=12
         End If
      End If
   Next _FRAME
End If
If _ERR=0
   For _I=1 To 50
      Aga Wait Vbl
   Next _I
End If
If _ERR=0
   _DIAG_ACTIVE=Aga Sprite Bank Free(-19000)
End If
If _ATTEMPT=1
   _OFF_RC=Aga Sprite Off(1)
   If _OFF_RC<>1
      _CLEAN_ERR=_CLEAN_ERR or 1
   End If
End If
If _OPEN=1
   If _HIDDEN=1
      _CURSOR_RC=Aga Mouse Cursor(1)
      If _CURSOR_RC<>1
         _CLEAN_ERR=_CLEAN_ERR or 2
      End If
   End If
   Aga Screen Close
   _CLOSE_RETURNED=1
   If _ERR=0 and _CLEAN_ERR=0
      _DIAG_CLOSE=Aga Sprite Bank Free(-19000)
   End If
   Amos To Front
   For _I=1 To 4
      Wait Vbl
   Next _I
   If Aga Mouse X=-1
      _CLOSED=1
      If _ERR=0 and _CLEAN_ERR=0
         _DIAG_FRONT=Aga Sprite Bank Free(-19000)
      End If
   Else
      _CLEAN_ERR=_CLEAN_ERR or 4
   End If
   _BANK_FREE_RC=Aga Sprite Bank Free(29)
   If _ATTEMPT=1 and _BANK_FREE_RC<>0
      _CLEAN_ERR=_CLEAN_ERR or 8
   End If
End If
If _BANK_OWN=1
   Erase 29
End If
Amos To Front
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _ERR=0 and _CLEAN_ERR=0 and _ERASED=1 and _CLOSED=1
   If _OFF_RC=1 and _CURSOR_RC=1 and _BANK_FREE_RC=0
      If _PHASE=1
         If _SPRITE_RC=1 and _MOVE_RC=1 and _MOVES=100
            _RESULT=1
            _VERDICT$="PASS_DISPLAY_CLOSE_RETAINED_ONLY"
         End If
      Else
         If _SPRITE_RC=-123 and _MOVE_RC=-999 and _MOVES=0
            _RESULT=1
            _VERDICT$="PASS_QUARANTINE_NO_NEW_DISPLAY"
         End If
      End If
   End If
End If
' Keep sequence and diagnostic verdicts independent.
_DS_OK=0
If _DIAG_START<=-180 and _DIAG_START>=-190
   _DS_OK=1
End If
If _DIAG_START<=-257 and _DIAG_START>=-319
   _DS_OK=1
End If
_DA_OK=0
If _DIAG_ACTIVE<=-180 and _DIAG_ACTIVE>=-190
   _DA_OK=1
End If
If _DIAG_ACTIVE<=-257 and _DIAG_ACTIVE>=-319
   _DA_OK=1
End If
_DC_OK=0
If _DIAG_CLOSE<=-180 and _DIAG_CLOSE>=-190
   _DC_OK=1
End If
If _DIAG_CLOSE<=-257 and _DIAG_CLOSE>=-319
   _DC_OK=1
End If
_DF_OK=0
If _DIAG_FRONT<=-180 and _DIAG_FRONT>=-190
   _DF_OK=1
End If
If _DIAG_FRONT<=-257 and _DIAG_FRONT>=-319
   _DF_OK=1
End If
If _RESULT=1
   _OBS$="DIAG_ROUTE_FAIL"
   If _PHASE=1
      If _DIAG_START=-131 and _DIAG_ACTIVE=-180
         _DIAG_OK=1
      End If
   Else
      If _DS_OK=1
         If _DA_OK=1
            _DIAG_OK=1
         End If
      End If
   End If
   If _DC_OK=0
      _DIAG_OK=0
   End If
   If _DF_OK=0
      _DIAG_OK=0
   End If
   If _DIAG_START=-189 or _DIAG_ACTIVE=-189 or _DIAG_CLOSE=-189 or _DIAG_FRONT=-189
      _DIAG_OK=0
   End If
   If _DIAG_OK=1
      _OBS$="OBS_PENDING"
      If _DIAG_CLOSE=-190 or _DIAG_FRONT=-190
         _OBS$="OBS_COMPATIBLE_ONLY"
      End If
   End If
End If
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO<>0
   Print "LOG OPEN FAILED ";_IO
   End
End If
Print #1,"SOURCE_TAG M19_S1P2LC_IDLE_DETAIL_V1"
Print #1,"PHASE ";_PHASE
Print #1,"PRG_STATE ";_PRG
Print #1,"RUN_MODE ";_MODE$
Print #1,"CPU_ATTNFLAGS ";_CPU
Print #1,"SPRITE_RC ";_SPRITE_RC;" MOVE_RC ";_MOVE_RC
Print #1,"MOVES ";_MOVES;" SOURCE_ERASED ";_ERASED
Print #1,"OFF_RC ";_OFF_RC;" CURSOR_RC ";_CURSOR_RC
Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED;" CLOSED ";_CLOSED
Print #1,"BANK_FREE_RC ";_BANK_FREE_RC;" CLEAN_ERR ";_CLEAN_ERR
Print #1,"CHIP_BEFORE ";_CHIP0;" CHIP_AFTER ";_CHIP1
Print #1,"FAST_BEFORE ";_FAST0;" FAST_AFTER ";_FAST1
Print #1,"DIAG_START ";_DIAG_START;" DIAG_ACTIVE ";_DIAG_ACTIVE
Print #1,"DIAG_CLOSE ";_DIAG_CLOSE;" DIAG_FRONT ";_DIAG_FRONT
Print #1,"DIAG_ROUTE_OK ";_DIAG_OK;" OBSERVATION ";_OBS$
Print #1,"DMA_FREE_PROVEN 0"
Print #1,"RESULT ";_RESULT;" ERR ";_ERR
Print #1,"VERDICT ";_VERDICT$
Trap Close 1
Print _VERDICT$;" ERR ";_ERR;" CLEAN_ERR ";_CLEAN_ERR
Print _OBS$
Print "RAM LOG ";_LOG$
End
