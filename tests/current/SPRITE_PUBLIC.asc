' M19 S2b - 3 independent sprites, 300 changes, targeted Off and 2 active closes.
Set Buffer 20
Cls
_PRG=Prg State
_MODE$="UNKNOWN"
_LOG$="RAM:M19_S2B_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:M19_S2B_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:M19_S2B_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:M19_S2B_COMPILED.TXT"
End If
_ERR=0 : _CLEAN_ERR=0 : _RESULT=0 : _BANK_OWN=0
_OPENED=0 : _CLOSED=0 : _SHOWN=0 : _MOVED=0 : _OFF_COUNT=0 : _AUTO_COUNT=0
_SPRITE_RC=-999 : _MOVE_RC=-999 : _OFF_RC=-999 : _FREE_RC=-999 : _CURSOR_RC=-999
_CPU=Deek(Leek(4)+296) and $FFFF
_SCREEN_NO=0 : _CYCLE=0 : _OPEN=0 : _HIDDEN=0 : _ATTEMPT=0
_CHIP_CYCLE0=0 : _FAST_CYCLE0=0 : _CHIP_LOSS=0 : _FAST_LOSS=0
_CHIP_SCREEN_LOSS=0 : _FAST_SCREEN_LOSS=0 : _FIRST_CHIP=0 : _FIRST_FAST=0
_DC=0 : _DF=0 : _OK=0 : _I=0 : _P0=0 : _P1=0 : _P2=0 : _P3=0
_CHANGED=0 : _CHANGE_RC=-999 : _FULL_RC=-999 : _FULL_COUNT=0
_ID2=42 : _J=0 : _FRAME=0 : _N=0 : _SX=0 : _SY=0 : _BASE=0
Dim _IDS(3),_BASES(3)
_IDS(1)=17 : _IDS(2)=42 : _IDS(3)=64
_BASES(1)=3 : _BASES(2)=5 : _BASES(3)=7
Dim _CHIP_CLOSED(2),_FAST_CLOSED(2)
_CHIP0=Chip Free : _FAST0=Fast Free
If Aga Detect=0
   _ERR=1
End If
If Length(29)<>0
   _ERR=2
End If
If _ERR=0
   Trap Load "AGSP_S2B_MULTI.ABK",29
   _IO=Errtrap
   If Length(29)<>0
      _BANK_OWN=1
   End If
   If _IO<>0 or Length(29)<>992
      _ERR=3
   End If
End If
For _SCREEN_NO=1 To 2
   If _ERR=0 and _CLEAN_ERR=0
      _OPEN=0 : _HIDDEN=0 : _ATTEMPT=0
      If _ERR=0
         _OPEN=Aga Screen Open(320,256,256,$21000)
         If _OPEN<>1
            _ERR=4
         End If
      End If
      If _ERR=0
         _OK=Aga Double Buffer
         If _OK<>1
            _ERR=5
         End If
      End If
      If _ERR=0
         _OK=Aga Blit Fill(0,0,320,256,0)
         If _OK<>1
            _ERR=6
         End If
      End If
      If _ERR=0
         _OK=Aga Swap
         If _OK<>1
            _ERR=7
         Else
            Aga Wait Vbl
         End If
      End If
      If _ERR=0
         _P0=Aga Palette Set(0,12,20,30)
         _P1=Aga Palette Set(21,255,70,40)
         _P2=Aga Palette Set(22,36,220,117)
         _P3=Aga Palette Set(23,26,115,255)
         If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
            _ERR=8
         End If
         _P1=Aga Palette Set(25,248,216,90)
         _P2=Aga Palette Set(26,52,197,224)
         _P3=Aga Palette Set(27,104,73,187)
         If _P1<>1 or _P2<>1 or _P3<>1
            _ERR=8
         End If
         _P1=Aga Palette Set(29,255,129,201)
         _P2=Aga Palette Set(30,107,195,79)
         _P3=Aga Palette Set(31,254,254,254)
         If _P1<>1 or _P2<>1 or _P3<>1
            _ERR=8
         End If
      End If
      If _ERR=0
         _OK=Aga Mouse Cursor(0)
         If _OK<>1
            _ERR=9
         Else
            _HIDDEN=1
            Aga Wait Vbl
         End If
      End If
      If _OPEN=1
         _OPENED=_OPENED+1
      End If
      If _ERR=0
         Aga Sprite Bank 29
         Amos To Back
         Aga Wait Vbl
         _ATTEMPT=1 : _ID2=42 : _IDS(2)=42
         For _J=1 To 3
            If _ERR=0
               _N=_IDS(_J) : _BASE=_BASES(_J)
               _SY=24+_J*56
               _SPRITE_RC=Aga Sprite(_N,32,_SY,_BASE)
               If _SPRITE_RC<>1
                  _ERR=10
               Else
                  _SHOWN=_SHOWN+1
               End If
            End If
         Next _J
         If _ERR=0
            _FULL_RC=Aga Sprite(1,16,24,3)
            If _FULL_RC=-206
               _FULL_COUNT=_FULL_COUNT+1
            Else
               _ERR=16
            End If
         End If
         If _ERR=0
            For _I=1 To 25
               Aga Wait Vbl
            Next _I
         End If
         _CHIP_CYCLE0=Chip Free : _FAST_CYCLE0=Fast Free
         For _CYCLE=1 To 50
            If _ERR=0
               _FRAME=_CYCLE mod 2
               For _J=1 To 3
                  If _ERR=0
                     _N=_IDS(_J) : _BASE=_BASES(_J)
                     _SX=32+_CYCLE*4 : _SY=24+_J*56
                     If _J=2
                        _SX=240-_CYCLE*4
                     End If
                     _CHANGE_RC=Aga Sprite(_N,_SX,_SY,_BASE+_FRAME)
                     If _CHANGE_RC<>1
                        _ERR=11
                     Else
                        _CHANGED=_CHANGED+1
                        _MOVE_RC=Aga Sprite(_N,_SX+2,_SY,_BASE+_FRAME)
                        If _MOVE_RC<>1
                           _ERR=12
                        Else
                           _MOVED=_MOVED+1
                        End If
                     End If
                  End If
               Next _J
               _DC=_CHIP_CYCLE0-Chip Free
               _DF=_FAST_CYCLE0-Fast Free
               If _DC>_CHIP_LOSS
                  _CHIP_LOSS=_DC
               End If
               If _DF>_FAST_LOSS
                  _FAST_LOSS=_DF
               End If
            End If
         Next _CYCLE
         If _ERR=0
            _OFF_RC=Aga Sprite Off(42)
            If _OFF_RC<>1
               _ERR=13
            Else
               _OFF_COUNT=_OFF_COUNT+1
               For _I=1 To 25
                  Aga Wait Vbl
               Next _I
               _SPRITE_RC=Aga Sprite(9,160,136,5)
               If _SPRITE_RC<>1
                  _ERR=15
               Else
                  _ID2=9 : _SHOWN=_SHOWN+1
               End If
            End If
         End If
         If _ERR=0
            _AUTO_COUNT=_AUTO_COUNT+3
            For _I=1 To 25
               Aga Wait Vbl
            Next _I
         End If
      End If
      If _OPEN=1
         If _ERR<>0 and _ATTEMPT=1
            _OFF_RC=Aga Sprite Off(17)
            If _OFF_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 1
            End If
            _OFF_RC=Aga Sprite Off(_ID2)
            If _OFF_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 1
            End If
            _OFF_RC=Aga Sprite Off(64)
            If _OFF_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 1
            End If
            _OFF_RC=Aga Sprite Off(1)
            If _OFF_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 1
            End If
         End If
         If _HIDDEN=1
            _CURSOR_RC=Aga Mouse Cursor(1)
            If _CURSOR_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 2
            End If
         End If
         Aga Screen Close
         Amos To Front
         For _I=1 To 4
            Wait Vbl
         Next _I
         If Aga Mouse X=-1
            _CLOSED=_CLOSED+1
         Else
            _CLEAN_ERR=_CLEAN_ERR or 4
         End If
         _FREE_RC=Aga Sprite Bank Free(29)
         If _FREE_RC<>1
            _CLEAN_ERR=_CLEAN_ERR or 8
         End If
         _CHIP_CLOSED(_SCREEN_NO)=Chip Free
         _FAST_CLOSED(_SCREEN_NO)=Fast Free
         If _SCREEN_NO=1
            _FIRST_CHIP=_CHIP_CLOSED(1)
            _FIRST_FAST=_FAST_CLOSED(1)
         Else
            _DC=_FIRST_CHIP-_CHIP_CLOSED(_SCREEN_NO)
            _DF=_FIRST_FAST-_FAST_CLOSED(_SCREEN_NO)
            If _DC>_CHIP_SCREEN_LOSS
               _CHIP_SCREEN_LOSS=_DC
            End If
            If _DF>_FAST_SCREEN_LOSS
               _FAST_SCREEN_LOSS=_DF
            End If
         End If
      End If
   End If
Next _SCREEN_NO
If _BANK_OWN=1
   Erase 29
   If Length(29)<>0
      _CLEAN_ERR=_CLEAN_ERR or 16
   End If
End If
Amos To Front
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _ERR=0 and _CLEAN_ERR=0
   If _SHOWN=8 and _CHANGED=300 and _MOVED=300 and _OFF_COUNT=2 and _AUTO_COUNT=6 and _FULL_COUNT=2
      If _OPENED=2 and _CLOSED=2
         If _CHIP_SCREEN_LOSS=0 and _FAST_SCREEN_LOSS=0 and _CHIP0=_CHIP1 and _FAST0=_FAST1
            _RESULT=1
            _VERDICT$="PASS_S2B_MULTI_SPRITE"
         Else
            _ERR=14
         End If
      End If
   End If
End If
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO<>0
   Print "LOG OPEN FAILED ";_IO
   End
End If
Print #1,"SOURCE_TAG M19_S2B_MULTI_SPRITE_V1"
Print #1,"PRG_STATE ";_PRG
Print #1,"RUN_MODE ";_MODE$
Print #1,"CPU_ATTNFLAGS ";_CPU
Print #1,"OPENED ";_OPENED;" CLOSED ";_CLOSED
Print #1,"SATURATION ";_FULL_COUNT;" FULL_RC ";_FULL_RC
Print #1,"CHANGED ";_CHANGED;" CHANGE_RC ";_CHANGE_RC
Print #1,"SHOWN ";_SHOWN;" MOVED ";_MOVED;" OFF_COUNT ";_OFF_COUNT;" AUTO_CLOSE ";_AUTO_COUNT
Print #1,"SPRITE_RC ";_SPRITE_RC;" MOVE_RC ";_MOVE_RC;" OFF_RC ";_OFF_RC;" FREE_RC ";_FREE_RC
Print #1,"CHIP_CYCLE_LOSS ";_CHIP_LOSS;" FAST_CYCLE_LOSS ";_FAST_LOSS
Print #1,"CHIP_SCREEN_LOSS ";_CHIP_SCREEN_LOSS;" FAST_SCREEN_LOSS ";_FAST_SCREEN_LOSS
Print #1,"CHIP_BEFORE ";_CHIP0;" CHIP_AFTER ";_CHIP1
Print #1,"FAST_BEFORE ";_FAST0;" FAST_AFTER ";_FAST1
For _I=1 To 2
   Print #1,"SCREEN ";_I;" CHIP ";_CHIP_CLOSED(_I);" FAST ";_FAST_CLOSED(_I)
Next _I
Print #1,"RESULT ";_RESULT;" ERR ";_ERR;" CLEAN_ERR ";_CLEAN_ERR
Print #1,"VERDICT ";_VERDICT$
Trap Close 1
Print _VERDICT$;" ERR ";_ERR;" CLEAN_ERR ";_CLEAN_ERR
Print "RAM LOG ";_LOG$
End
