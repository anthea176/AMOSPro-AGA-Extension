' M19 S1-P2j - one-shot native display, no exposed Chip free.
' Snapshot required. Exact AGSP fixture, image 3. Runtime first.
Set Buffer 20
Cls
_PRG=Prg State
_MODE$="UNKNOWN"
_LOG$="RAM:M19_S1P2J_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:M19_S1P2J_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:M19_S1P2J_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:M19_S1P2J_COMPILED.TXT"
End If
_ERR=0 : _CLEAN_ERR=0 : _RESULT=0 : _OPEN=0 : _BANK_OWN=0
_HIDDEN=0 : _ATTEMPT=0 : _SPRITE_RC=-999 : _MOVE_RC=-999
_OFF_RC=-999 : _BANK_FREE_RC=-999 : _CURSOR_RC=-999
_CLOSE_RETURNED=0 : _CLOSED=0 : _MOVES=0 : _ERASED=0
_CPU=Deek(Leek(4)+296) and $FFFF
_CHIP0=Chip Free : _FAST0=Fast Free
If Aga Detect=0
   _ERR=1
End If
If Length(29)<>0
   _ERR=2
End If
If _ERR=0
   Trap Load "AGSP_S1P1E_FINAL.ABK",29
   _IO=Errtrap
   If Length(29)<>0
      _BANK_OWN=1
   End If
   If _IO<>0 or Length(29)<>512
      _ERR=3
   End If
End If
If _ERR=0
   _OPEN=Aga Screen Open(320,256,256,$21000)
   If _OPEN<>1
      _ERR=4
   End If
End If
If _ERR=0
   _OK=Aga Double Buffer
   If _OK<>1
      _ERR=5
   End If
End If
If _ERR=0
   _OK=Aga Blit Fill(0,0,320,256,0)
   If _OK<>1
      _ERR=6
   End If
End If
If _ERR=0
   _OK=Aga Swap
   If _OK<>1
      _ERR=7
   Else
      Aga Wait Vbl
   End If
End If
If _ERR=0
   _P0=Aga Palette Set(0,12,20,30)
   _P1=Aga Palette Set(21,255,70,40)
   _P2=Aga Palette Set(22,36,220,117)
   _P3=Aga Palette Set(23,26,115,255)
   If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
      _ERR=8
   End If
End If
If _ERR=0
   _OK=Aga Mouse Cursor(0)
   If _OK<>1
      _ERR=9
   Else
      _HIDDEN=1
      Aga Wait Vbl
   End If
End If
If _ERR=0
   Aga Sprite Bank 29
   Amos To Back
   Aga Wait Vbl
   _ATTEMPT=1
   _SPRITE_RC=Aga Sprite(1,32,112,3)
   If _SPRITE_RC<>1
      _ERR=10
   End If
End If
If _ERR=0
   Erase 29
   _BANK_OWN=0
   If Length(29)<>0
      _ERR=11
   Else
      _ERASED=1
   End If
End If
If _ERR=0
   For _FRAME=1 To 100
      If _ERR=0
         _MOVE_RC=Aga Sprite(1,32+_FRAME*2,112,3)
         If _MOVE_RC=1
            _MOVES=_MOVES+1
            Aga Wait Vbl
         Else
            _ERR=12
         End If
      End If
   Next _FRAME
End If
If _ERR=0
   For _I=1 To 50
      Aga Wait Vbl
   Next _I
End If
If _ATTEMPT=1
   _OFF_RC=Aga Sprite Off(1)
   If _OFF_RC<>1
      _CLEAN_ERR=_CLEAN_ERR or 1
   End If
End If
If _OPEN=1
   If _HIDDEN=1
      _CURSOR_RC=Aga Mouse Cursor(1)
      If _CURSOR_RC<>1
         _CLEAN_ERR=_CLEAN_ERR or 2
      End If
   End If
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
   For _I=1 To 4
      Wait Vbl
   Next _I
   If Aga Mouse X=-1
      _CLOSED=1
   Else
      _CLEAN_ERR=_CLEAN_ERR or 4
   End If
   _BANK_FREE_RC=Aga Sprite Bank Free(29)
   If _SPRITE_RC=1 and _BANK_FREE_RC<>0
      _CLEAN_ERR=_CLEAN_ERR or 8
   End If
End If
If _BANK_OWN=1
   Erase 29
End If
Amos To Front
_CHIP1=Chip Free : _FAST1=Fast Free
If _ERR=0 and _CLEAN_ERR=0 and _MOVES=100 and _ERASED=1 and _CLOSED=1
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS_DISPLAY_CLOSE_RETAINED_ONLY"
End If
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO<>0
   Print "LOG OPEN FAILED ";_IO
   End
End If
Print #1,"SOURCE_TAG M19_S1P2J_PUBLIC_V1"
Print #1,"PRG_STATE ";_PRG
Print #1,"RUN_MODE ";_MODE$
Print #1,"CPU_ATTNFLAGS ";_CPU
Print #1,"SPRITE_RC ";_SPRITE_RC;" MOVE_RC ";_MOVE_RC
Print #1,"MOVES ";_MOVES;" SOURCE_ERASED ";_ERASED
Print #1,"OFF_RC ";_OFF_RC;" CURSOR_RC ";_CURSOR_RC
Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED;" CLOSED ";_CLOSED
Print #1,"BANK_FREE_RC ";_BANK_FREE_RC;" CLEAN_ERR ";_CLEAN_ERR
Print #1,"CHIP_BEFORE ";_CHIP0;" CHIP_AFTER ";_CHIP1
Print #1,"FAST_BEFORE ";_FAST0;" FAST_AFTER ";_FAST1
Print #1,"DMA_FREE_PROVEN 0"
Print #1,"RESULT ";_RESULT;" ERR ";_ERR
Print #1,"VERDICT ";_VERDICT$
Trap Close 1
Print _VERDICT$;" ERR ";_ERR;" CLEAN_ERR ";_CLEAN_ERR
Print "RAM LOG ";_LOG$
End
