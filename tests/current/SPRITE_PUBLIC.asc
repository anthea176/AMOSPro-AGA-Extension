' M19 S2f - fixed-width clipping, signed hotspots, 16/32/64px.
Set Buffer 20
Cls
_PRG=Prg State
_MODE$="UNKNOWN"
_LOG$="RAM:M19_S2F_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:M19_S2F_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:M19_S2F_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:M19_S2F_COMPILED.TXT"
End If
_ERR=0 : _CLEAN_ERR=0 : _RESULT=0 : _BANK_OWN=0
_CAP_OWN=0 : _CAP_OK=0 : _CAP_REFUSED=0 : _CAP_FREE=-999 : _CAP_PTR=0
_PIC_OWN=0 : _PIC_VER=0 : _PIC_RC=-999 : _PIC_DRAW_RC=-999
_PIC_CAP=0 : _PIC_META=0 : _PIC_NEG=0 : _PIC_DRAW=0 : _PIC_LEN=0
_PIC_W=0 : _PIC_H=0 : _PIC_D=0 : _PIC_COL=0 : _PIC_MODE=0
_PIC_BAD=-999 : _PIC_DUP=-999 : _PIC_EXPECT_COL=0 : _PIC_EXPECT_MODE=0
_OPENED=0 : _CLOSED=0 : _SHOWN=0 : _MOVED=0 : _OFF_COUNT=0 : _AUTO_COUNT=0
_SPRITE_RC=-999 : _MOVE_RC=-999 : _OFF_RC=-999 : _FREE_RC=-999 : _CURSOR_RC=-999
_CPU=Deek(Leek(4)+296) and $FFFF
_SCREEN_NO=0 : _CYCLE=0 : _OPEN=0 : _HIDDEN=0 : _ATTEMPT=0
_CHIP_CYCLE0=0 : _FAST_CYCLE0=0 : _CHIP_LOSS=0 : _FAST_LOSS=0
_CHIP_SCREEN_LOSS=0 : _FAST_SCREEN_LOSS=0 : _FIRST_CHIP=0 : _FIRST_FAST=0
_DC=0 : _DF=0 : _OK=0 : _I=0 : _P0=0 : _P1=0 : _P2=0 : _P3=0
_CHANGED=0 : _CHANGE_RC=-999 : _FULL_RC=-999 : _FULL_COUNT=0
_ID2=42 : _J=0 : _FRAME=0 : _N=0 : _SX=0 : _SY=0 : _BASE=0
_WIDTH=16 : _GROUP=0 : _MIX=0 : _OTHER=9 : _CAP_X2=25
_CAP_LEN1=136 : _CAP_LEN2=360 : _WIDTH_REFUSED=0 : _WIDTH_RC=-999
_CLIP_COUNT=0 : _OUT_COUNT=0 : _RESTORE_COUNT=0 : _CLIP_CHANGE=0
_CLIP_RC=-999 : _OUT_RC=-999 : _OVERFLOW=0 : _OVERFLOW_RC=-999
_CLIP_SHOW=0 : _ERASE_MOVES=0 : _ERASE_RC=-999
_EDGE=0 : _OX=0 : _OY=0 : _HOLD=0
Dim _IDS(3),_BASES(3)
_IDS(1)=17 : _IDS(2)=42 : _IDS(3)=64
_BASES(1)=3 : _BASES(2)=5 : _BASES(3)=7
Dim _CHIP_CLOSED(9),_FAST_CLOSED(9)
_CHIP0=Chip Free : _FAST0=Fast Free
If Aga Detect=0
   _ERR=1
End If
If Length(29)<>0
   _ERR=2
End If
If Length(30)<>0
   _ERR=17
End If
If _ERR=0
   Trap Load "AGSP_HOTSPOT_TEST.ABK",29
   _IO=Errtrap
   If Length(29)<>0
      _BANK_OWN=1
   End If
   If _IO<>0 or Length(29)<>6816
      _ERR=3
   End If
End If
For _SCREEN_NO=1 To 9
   _WIDTH=16 : _GROUP=0 : _OTHER=9
   If _SCREEN_NO>3
      _WIDTH=32 : _GROUP=1 : _OTHER=1
   End If
   If _SCREEN_NO>6
      _WIDTH=64 : _GROUP=2
   End If
   _MIX=(_SCREEN_NO-1) mod 3
   _CAP_X2=9+_WIDTH : _CAP_LEN1=128+_WIDTH/2 : _CAP_LEN2=224+_WIDTH*8+_WIDTH/2
   If _ERR=0 and _CLEAN_ERR=0
      _OPEN=0 : _HIDDEN=0 : _ATTEMPT=0
      If _ERR=0
         _OPEN=Aga Screen Open(320,256,256,$21000)
         If _OPEN<>1
            _ERR=4
         End If
      End If
      If _ERR=0
         _OK=Aga Double Buffer
         If _OK<>1
            _ERR=5
         End If
      End If
      If _ERR=0
         _OK=Aga Blit Fill(0,0,320,256,0)
         If _OK<>1
            _ERR=6
         End If
      End If
      If _ERR=0
         _OK=Aga Swap
         If _OK<>1
            _ERR=7
         Else
            Aga Wait Vbl
         End If
      End If
      If _ERR=0
         _P0=Aga Palette Set(0,12,20,30)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(16,200,100,51)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(17,208,32,80)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(18,128,64,255)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(19,0,64,128)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(20,255,192,128)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(21,255,32,32)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(22,255,144,32)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(23,255,255,0)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(24,128,64,0)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(25,0,64,255)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(26,0,223,255)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(27,255,255,255)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(28,128,128,128)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(29,0,176,0)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(30,128,255,0)
         If _P0<>1
            _ERR=8
         End If
         _P0=Aga Palette Set(31,255,0,255)
         If _P0<>1
            _ERR=8
         End If
      End If
      If _ERR=0
         _PIC_RC=Aga Blit Fill(5,5,19,9,21)
         If _PIC_RC<>1
            _ERR=18
         End If
      End If
      For _PIC_VER=1 To 2
         If _ERR=0
            _PIC_RC=Aga Bank Image Capture(30,5,5,19,9,-1,_PIC_VER)
            _PIC_LEN=Length(30)
            If _PIC_LEN<>0
               _PIC_OWN=1
            End If
            If _PIC_RC<>1 or _PIC_OWN<>1
               _ERR=19
            Else
               _PIC_CAP=_PIC_CAP+1
            End If
         End If
         If _ERR=0
            _PIC_W=Aga Bank Image Info(30,1)
            _PIC_H=Aga Bank Image Info(30,2)
            _PIC_D=Aga Bank Image Info(30,3)
            _PIC_COL=Aga Bank Image Info(30,4)
            _PIC_MODE=Aga Bank Image Info(30,5)
            _PIC_EXPECT_COL=0 : _PIC_EXPECT_MODE=0
            If _PIC_VER=2
               _PIC_EXPECT_COL=256 : _PIC_EXPECT_MODE=$21000
            End If
            If _PIC_W<>19 or _PIC_H<>9 or _PIC_D<>8 or _PIC_COL<>_PIC_EXPECT_COL or _PIC_MODE<>_PIC_EXPECT_MODE
               _ERR=20
            Else
               _PIC_META=_PIC_META+1
            End If
         End If
         If _ERR=0
            _PIC_BAD=Aga Bank Image Info(30,6)
            _PIC_DUP=Aga Bank Image Capture(30,5,5,19,9,-1,_PIC_VER)
            If _PIC_BAD<>-1 or _PIC_DUP<>0 or Length(30)<>_PIC_LEN
               _ERR=21
            Else
               _PIC_NEG=_PIC_NEG+1
            End If
         End If
         If _ERR=0
            _PIC_DRAW_RC=Aga Bank Image Draw(30,40+_PIC_VER*40,5,0)
            If _PIC_DRAW_RC<>1
               _ERR=22
            Else
               _PIC_DRAW=_PIC_DRAW+1
            End If
         End If
         If _PIC_OWN=1
            Erase 30
            If Length(30)<>0
               _CLEAN_ERR=_CLEAN_ERR or 32
               _ERR=23
            Else
               _PIC_OWN=0
            End If
         End If
      Next _PIC_VER
      If _ERR=0 and _CLEAN_ERR=0
         _OK=Aga Swap
         If _OK<>1
            _ERR=24
         Else
            Aga Wait Vbl
         End If
      End If
      If _ERR=0
         _OK=Aga Blit Fill(10,200,_WIDTH,16,0)
         If _OK<>1
            _ERR=25
         End If
         For _I=1 To 15
            If _ERR=0
               _OK=Aga Blit Fill(10+_I,200,1,16,16+_I)
               If _OK<>1
                  _ERR=25
               End If
            End If
         Next _I
      End If
      If _ERR=0
         Aga Sprite Bank 30
         If Length(30)<>0
            _CAP_OWN=1
         End If
         If Length(30)<>32
            _ERR=26
         End If
      End If
      If _ERR=0
         Get Aga Sprite 1,10,200,_CAP_X2,200,0
         If Length(30)<>_CAP_LEN1
            _ERR=27
         Else
            _CAP_PTR=Start(30)
            If Deek(_CAP_PTR+8)<>1 or Leek(_CAP_PTR+24)<>2 or Deek(_CAP_PTR+34)<>_WIDTH or Deek(_CAP_PTR+38)<>4
               _ERR=27
            Else
               _CAP_OK=_CAP_OK+1
            End If
         End If
      End If
      If _ERR=0
         Get Aga Sprite 2,10,200,_CAP_X2,215,0
         If Length(30)<>_CAP_LEN2
            _ERR=28
         Else
            _CAP_PTR=Start(30)
            If Deek(_CAP_PTR+8)<>2 or Leek(_CAP_PTR+24)<>3 or Deek(_CAP_PTR+82)<>_WIDTH or Deek(_CAP_PTR+86)<>4
               _ERR=28
            Else
               _CAP_OK=_CAP_OK+1
            End If
         End If
      End If
      If _ERR=0
         _OK=Aga Blit Fill(10,200,1,16,16)
         If _OK<>1
            _ERR=29
         Else
            Get Aga Sprite 3,10,200,_CAP_X2,215,0
            If Length(30)<>_CAP_LEN2
               _ERR=29
            Else
               _CAP_PTR=Start(30)
               If Deek(_CAP_PTR+8)<>2 or Leek(_CAP_PTR+24)<>3
                  _ERR=29
               Else
                  _CAP_REFUSED=_CAP_REFUSED+1
               End If
            End If
         End If
      End If
      If _CAP_OWN=1
         _CAP_FREE=Aga Sprite Bank Free(30)
         If _CAP_FREE<>1
            _CLEAN_ERR=_CLEAN_ERR or 64
         Else
            Erase 30
            If Length(30)<>0
               _CLEAN_ERR=_CLEAN_ERR or 64
            Else
               _CAP_OWN=0
            End If
         End If
      End If
      If _ERR=0
         _OK=Aga Mouse Cursor(0)
         If _OK<>1
            _ERR=9
         Else
            _HIDDEN=1
            Aga Wait Vbl
         End If
      End If
      If _OPEN=1
         _OPENED=_OPENED+1
      End If
      If _ERR=0
         Aga Sprite Bank 29
         Amos To Back
         Aga Wait Vbl
         _ATTEMPT=1 : _ID2=42 : _IDS(2)=42
         _BASES(1)=1+_GROUP*8 : _BASES(2)=3+_GROUP*8 : _BASES(3)=5+_GROUP*8
         If _MIX=1
            _BASES(2)=7+_GROUP*8
         End If
         If _MIX=2
            _BASES(1)=7+_GROUP*8 : _BASES(2)=7+_GROUP*8 : _BASES(3)=7+_GROUP*8
            _OTHER=_OTHER+6
         End If
         For _J=1 To 3
            If _ERR=0
               _N=_IDS(_J) : _BASE=_BASES(_J)
               _SY=24+_J*56
               _SPRITE_RC=Aga Sprite(_N,32,_SY,_BASE)
               If _SPRITE_RC<>1
                  _ERR=10
               Else
                  _SHOWN=_SHOWN+1
                  If _J=1
                     _WIDTH_RC=Aga Sprite(1,80,24,_OTHER)
                     If _WIDTH_RC=-206
                        _WIDTH_REFUSED=_WIDTH_REFUSED+1
                     Else
                        _ERR=30
                     End If
                  End If
               End If
            End If
         Next _J
         If _ERR=0
            _FULL_RC=Aga Sprite(1,80,24,_BASES(1))
            If _FULL_RC=-206
               _FULL_COUNT=_FULL_COUNT+1
            Else
               _ERR=16
            End If
         End If
         If _ERR=0
            For _I=1 To 25
               Aga Wait Vbl
            Next _I
         End If
         _CHIP_CYCLE0=Chip Free : _FAST_CYCLE0=Fast Free
         For _CYCLE=1 To 12
            If _ERR=0
               _FRAME=_CYCLE mod 2
               For _J=1 To 3
                  If _ERR=0
                     _N=_IDS(_J) : _BASE=_BASES(_J)
                     _SX=20+_CYCLE*16 : _SY=24+_J*56
                     If _J=2
                        _SX=240-_CYCLE*16
                     End If
                     If _CYCLE<=2
                        _SX=32
                     End If
                     _CHANGE_RC=Aga Sprite(_N,_SX,_SY,_BASE+_FRAME)
                     If _CHANGE_RC<>1
                        _ERR=11
                     Else
                        _CHANGED=_CHANGED+1
                        _MOVE_RC=Aga Sprite(_N,_SX+2,_SY,_BASE+_FRAME)
                        If _MOVE_RC<>1
                           _ERR=12
                        Else
                           _MOVED=_MOVED+1
                        End If
                     End If
                  End If
               Next _J
               If _CYCLE<=2
                  For _I=1 To 10
                     Aga Wait Vbl
                  Next _I
               End If
               If _CYCLE=1
                  _CHIP_CYCLE0=Chip Free : _FAST_CYCLE0=Fast Free
               End If
               _DC=_CHIP_CYCLE0-Chip Free
               _DF=_FAST_CYCLE0-Fast Free
               If _DC>_CHIP_LOSS
                  _CHIP_LOSS=_DC
               End If
               If _DF>_FAST_LOSS
                  _FAST_LOSS=_DF
               End If
            End If
         Next _CYCLE
         ' Keep the measured, fully visible animation above unchanged.
         ' Now test every edge/corner and disjoint edge for all three IDs.
         For _J=1 To 3
            If _ERR=0
               _N=_IDS(_J) : _BASE=_BASES(_J)
               _SY=24+_J*56
               _HOLD=2
               If _J=1
                  _HOLD=8
               End If
               For _EDGE=1 To 13
                  If _ERR=0
                     If _EDGE=1
                        _OX=-_WIDTH/2 : _OY=_SY-8
                     End If
                     If _EDGE=2
                        _OX=320-_WIDTH/2 : _OY=_SY-8
                     End If
                     If _EDGE=3
                        _OX=32+_J*60 : _OY=-8
                     End If
                     If _EDGE=4
                        _OX=32+_J*60 : _OY=248
                     End If
                     If _EDGE=5
                        _OX=-_WIDTH/2 : _OY=-8
                     End If
                     If _EDGE=6
                        _OX=320-_WIDTH/2 : _OY=-8
                     End If
                     If _EDGE=7
                        _OX=-_WIDTH/2 : _OY=248
                     End If
                     If _EDGE=8
                        _OX=320-_WIDTH/2 : _OY=248
                     End If
                     If _EDGE=9
                        _OX=-_WIDTH : _OY=_SY-8
                     End If
                     If _EDGE=10
                        _OX=320 : _OY=_SY-8
                     End If
                     If _EDGE=11
                        _OX=32+_J*60 : _OY=-16
                     End If
                     If _EDGE=12
                        _OX=32+_J*60 : _OY=256
                     End If
                     If _EDGE=13
                        _OX=32-_WIDTH/2 : _OY=_SY-8
                     End If
                     _CLIP_RC=Aga Sprite(_N,_OX+_WIDTH/2,_OY+8,_BASE)
                     If _CLIP_RC<>1
                        _ERR=31
                     Else
                        If _EDGE<=8
                           _CLIP_COUNT=_CLIP_COUNT+1
                        Else
                           If _EDGE<=12
                              _OUT_COUNT=_OUT_COUNT+1
                              _OUT_RC=_CLIP_RC
                           Else
                              _RESTORE_COUNT=_RESTORE_COUNT+1
                           End If
                        End If
                        For _I=1 To _HOLD
                           Aga Wait Vbl
                        Next _I
                     End If
                  End If
               Next _EDGE
               If _ERR=0
                  ' Even frame has a signed hotspot (-3,-4).
                  _CLIP_RC=Aga Sprite(_N,-6,244,_BASE+1)
                  If _CLIP_RC<>1
                     _ERR=32
                  Else
                     _CLIP_CHANGE=_CLIP_CHANGE+1
                     For _I=1 To _HOLD
                        Aga Wait Vbl
                     Next _I
                  End If
               End If
               If _ERR=0
                  _CLIP_RC=Aga Sprite(_N,32,_SY,_BASE)
                  If _CLIP_RC<>1
                     _ERR=32
                  Else
                     _CLIP_CHANGE=_CLIP_CHANGE+1
                  End If
               End If
            End If
         Next _J
         If _ERR=0
            ' Subtraction of a positive hotspot must overflow signed LONG.
            _OVERFLOW_RC=Aga Sprite(17,-2147483647,8,_BASES(1))
            If _OVERFLOW_RC=-128
               _OVERFLOW=_OVERFLOW+1
            Else
               _ERR=33
            End If
         End If
         If _ERR=0
            _OFF_RC=Aga Sprite Off(42)
            If _OFF_RC<>1
               _ERR=13
            Else
               _OFF_COUNT=_OFF_COUNT+1
               For _I=1 To 25
                  Aga Wait Vbl
               Next _I
               _SPRITE_RC=Aga Sprite(9,319+_WIDTH/2,136,_BASES(2))
               If _SPRITE_RC<>1
                  _ERR=15
               Else
                  _ID2=9 : _SHOWN=_SHOWN+1
                  _CLIP_SHOW=_CLIP_SHOW+1
                  For _I=1 To 16
                     Aga Wait Vbl
                  Next _I
                  _CLIP_RC=Aga Sprite(9,160,136,_BASES(2))
                  If _CLIP_RC<>1
                     _ERR=34
                  End If
               End If
            End If
         End If
         ' Last screen: delete the source while all three sprites are live.
         ' Only same-image calls may use the retained original.
         If _ERR=0 and _SCREEN_NO=9 and _BANK_OWN=1
            Erase 29
            If Length(29)<>0
               _ERR=35
            Else
               _BANK_OWN=0
               For _J=1 To 3
                  If _ERR=0
                     _N=_IDS(_J) : _BASE=_BASES(_J)
                     If _J=2
                        _N=_ID2
                     End If
                     _SY=24+_J*56
                     For _EDGE=1 To 3
                        If _ERR=0
                           _OX=-1 : _OY=-1
                           If _EDGE=2
                              _OX=320 : _OY=256
                           End If
                           If _EDGE=3
                              _OX=32 : _OY=_SY-8
                           End If
                           _ERASE_RC=Aga Sprite(_N,_OX+_WIDTH/2,_OY+8,_BASE)
                           If _ERASE_RC<>1
                              _ERR=36
                           Else
                              _ERASE_MOVES=_ERASE_MOVES+1
                              For _I=1 To 8
                                 Aga Wait Vbl
                              Next _I
                           End If
                        End If
                     Next _EDGE
                  End If
               Next _J
            End If
         End If
         If _ERR=0
            _AUTO_COUNT=_AUTO_COUNT+3
            For _I=1 To 25
               Aga Wait Vbl
            Next _I
         End If
      End If
      If _OPEN=1
         If _ERR<>0 and _ATTEMPT=1
            _OFF_RC=Aga Sprite Off(17)
            If _OFF_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 1
            End If
            _OFF_RC=Aga Sprite Off(_ID2)
            If _OFF_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 1
            End If
            _OFF_RC=Aga Sprite Off(64)
            If _OFF_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 1
            End If
            _OFF_RC=Aga Sprite Off(1)
            If _OFF_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 1
            End If
         End If
         If _HIDDEN=1
            _CURSOR_RC=Aga Mouse Cursor(1)
            If _CURSOR_RC<>1
               _CLEAN_ERR=_CLEAN_ERR or 2
            End If
         End If
         Aga Screen Close
         Amos To Front
         For _I=1 To 4
            Wait Vbl
         Next _I
         If Aga Mouse X=-1
            _CLOSED=_CLOSED+1
         Else
            _CLEAN_ERR=_CLEAN_ERR or 4
         End If
         _FREE_RC=Aga Sprite Bank Free(29)
         If _FREE_RC<>1
            _CLEAN_ERR=_CLEAN_ERR or 8
         End If
         _CHIP_CLOSED(_SCREEN_NO)=Chip Free
         _FAST_CLOSED(_SCREEN_NO)=Fast Free
         If _SCREEN_NO=1
            _FIRST_CHIP=_CHIP_CLOSED(1)
            _FIRST_FAST=_FAST_CLOSED(1)
         Else
            _DC=_FIRST_CHIP-_CHIP_CLOSED(_SCREEN_NO)
            _DF=_FIRST_FAST-_FAST_CLOSED(_SCREEN_NO)
            If _DC>_CHIP_SCREEN_LOSS
               _CHIP_SCREEN_LOSS=_DC
            End If
            If _DF>_FAST_SCREEN_LOSS
               _FAST_SCREEN_LOSS=_DF
            End If
         End If
      End If
   End If
Next _SCREEN_NO
If _CAP_OWN=1
   _CAP_FREE=Aga Sprite Bank Free(30)
   If _CAP_FREE=1
      Erase 30
      If Length(30)=0
         _CAP_OWN=0
      End If
   End If
   If _CAP_OWN=1
      _CLEAN_ERR=_CLEAN_ERR or 64
   End If
End If
If _PIC_OWN=1
   Erase 30
   If Length(30)<>0
      _CLEAN_ERR=_CLEAN_ERR or 32
   Else
      _PIC_OWN=0
   End If
End If
If _BANK_OWN=1
   Erase 29
   If Length(29)<>0
      _CLEAN_ERR=_CLEAN_ERR or 16
   End If
End If
Amos To Front
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _ERR=0 and _CLEAN_ERR=0
   If _SHOWN=36 and _CHANGED=324 and _MOVED=324 and _OFF_COUNT=9 and _AUTO_COUNT=27 and _FULL_COUNT=9 and _WIDTH_REFUSED=9 and _OVERFLOW=9
      If _OPENED=9 and _CLOSED=9 and _PIC_CAP=18 and _PIC_META=18 and _PIC_NEG=18 and _PIC_DRAW=18 and _PIC_OWN=0 and _CAP_OK=18 and _CAP_REFUSED=9 and _CAP_OWN=0
         If _CLIP_COUNT=216 and _OUT_COUNT=108 and _RESTORE_COUNT=27 and _CLIP_CHANGE=54 and _CLIP_SHOW=9 and _ERASE_MOVES=9 and _BANK_OWN=0
            If _CHIP_SCREEN_LOSS=0 and _FAST_SCREEN_LOSS=0 and _CHIP0=_CHIP1 and _FAST0=_FAST1 and _CHIP_LOSS=0 and _FAST_LOSS=0
               _RESULT=1
               _VERDICT$="PASS_S2F_CLIPPING"
            Else
               _ERR=14
            End If
         Else
            _ERR=37
         End If
      End If
   End If
End If
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO<>0
   Print "LOG OPEN FAILED ";_IO
   End
End If
Print #1,"SOURCE_TAG M19_S2F_CLIPPING_V1"
Print #1,"PRG_STATE ";_PRG
Print #1,"RUN_MODE ";_MODE$
Print #1,"CPU_ATTNFLAGS ";_CPU
Print #1,"OPENED ";_OPENED;" CLOSED ";_CLOSED
Print #1,"SATURATION ";_FULL_COUNT;" FULL_RC ";_FULL_RC
Print #1,"WIDTH_REFUSED ";_WIDTH_REFUSED;" WIDTH_RC ";_WIDTH_RC
Print #1,"CLIPPED ";_CLIP_COUNT;" OUTSIDE ";_OUT_COUNT;" RESTORED ";_RESTORE_COUNT;" CLIP_CHANGE ";_CLIP_CHANGE
Print #1,"CLIP_RC ";_CLIP_RC;" OUT_RC ";_OUT_RC;" OVERFLOW ";_OVERFLOW;" OVERFLOW_RC ";_OVERFLOW_RC
Print #1,"CLIP_SHOW ";_CLIP_SHOW;" ERASE_MOVES ";_ERASE_MOVES;" ERASE_RC ";_ERASE_RC;" BANK_OWN ";_BANK_OWN
Print #1,"CHANGED ";_CHANGED;" CHANGE_RC ";_CHANGE_RC
Print #1,"SHOWN ";_SHOWN;" MOVED ";_MOVED;" OFF_COUNT ";_OFF_COUNT;" AUTO_CLOSE ";_AUTO_COUNT
Print #1,"SPRITE_RC ";_SPRITE_RC;" MOVE_RC ";_MOVE_RC;" OFF_RC ";_OFF_RC;" FREE_RC ";_FREE_RC
Print #1,"AGAPIC_CAPTURE ";_PIC_CAP;" META ";_PIC_META;" NEGATIVE ";_PIC_NEG;" DRAW ";_PIC_DRAW
Print #1,"AGAPIC_W ";_PIC_W;" H ";_PIC_H;" DEPTH ";_PIC_D;" COLORS ";_PIC_COL;" MODE ";_PIC_MODE
Print #1,"AGAPIC_RC ";_PIC_RC;" INFO_BAD ";_PIC_BAD;" DUP_RC ";_PIC_DUP;" DRAW_RC ";_PIC_DRAW_RC;" OWN ";_PIC_OWN
Print #1,"AGSP_CAPTURED ";_CAP_OK;" REFUSED ";_CAP_REFUSED;" FREE_RC ";_CAP_FREE;" OWN ";_CAP_OWN
Print #1,"CHIP_CYCLE_LOSS ";_CHIP_LOSS;" FAST_CYCLE_LOSS ";_FAST_LOSS
Print #1,"CHIP_SCREEN_LOSS ";_CHIP_SCREEN_LOSS;" FAST_SCREEN_LOSS ";_FAST_SCREEN_LOSS
Print #1,"CHIP_BEFORE ";_CHIP0;" CHIP_AFTER ";_CHIP1
Print #1,"FAST_BEFORE ";_FAST0;" FAST_AFTER ";_FAST1
For _I=1 To 9
   Print #1,"SCREEN ";_I;" CHIP ";_CHIP_CLOSED(_I);" FAST ";_FAST_CLOSED(_I)
Next _I
Print #1,"RESULT ";_RESULT;" ERR ";_ERR;" CLEAN_ERR ";_CLEAN_ERR
Print #1,"VERDICT ";_VERDICT$
Trap Close 1
Print _VERDICT$;" ERR ";_ERR;" CLEAN_ERR ";_CLEAN_ERR
Print "RAM LOG ";_LOG$
End
