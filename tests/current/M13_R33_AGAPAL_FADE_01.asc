' M13-R33-AGAPAL-FADE-01 - WinUAE Gate B only AFTER R33 Gate A PASS.
' Requires R33 0.10.5 candidate in APSystem, same slot, restart AMOS.
' WARNING: replaces banks 10/11 and RAM:R33_AGAPAL_FADE.ABK.
' ALL bank arguments are real Start(bank) from a live AMOS DATA bank.
Cls
Print "M13-R33-AGAPAL-FADE-01"
_B=10
_N=8
Reserve As Data _B,6224
_PTR=Start(_B)
_INIT=Aga Palette Bank Init(_PTR,_N)
If _INIT<>1
   Print "INIT FAILED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_CLR=Aga Blit Clear(0,0,320,256)
_BOX=Aga Blit Fill(25,70,270,115,28)
_BAR=Aga Blit Fill(25,204,270,12,224)
_P3=Aga Palette Set(3,10,20,30)
_P224=Aga Palette Set(224,12,34,56)
_GREEN=Aga Palette Set(28,0,255,0)
_CAP0=Aga Palette Bank Capture(_PTR,0)
_BLUE=Aga Palette Set(28,0,0,255)
_CAP1=Aga Palette Bank Capture(_PTR,1)
_RED=Aga Palette Set(28,255,0,0)
_FADE0=Aga Fade To Bank(_PTR,0,12)
_GETGREEN=Aga Palette Get(28)
_FADE1=Aga Fade To Bank(_PTR,1,1)
_GETBLUE=Aga Palette Get(28)
' The second fade starts and ends on the same blue color.
_SAME=Aga Fade To Bank(_PTR,1,2)
_GETSAME=Aga Palette Get(28)
' Partial palette: only pens 0..3 fade, pen 28 stays red.
_RED2=Aga Palette Set(28,255,0,0)
_WHITE3=Aga Palette Set(3,255,255,255)
Poke _PTR+20,0
Poke _PTR+21,4
_PART=Aga Fade To Bank(_PTR,0,3)
_PART3=Aga Palette Get(3)
_PART28=Aga Palette Get(28)
' All invalid calls reject before WaitTOF or any screen changes.
_BAD0=Aga Fade To Bank(_PTR,0,0)
_BAD256=Aga Fade To Bank(_PTR,0,256)
_BADNEG=Aga Fade To Bank(_PTR,0,-1)
_BADINDEX=Aga Fade To Bank(_PTR,8,3)
_EMPTY=Aga Fade To Bank(_PTR,2,3)
Reserve As Data 11,6000
_PTR11=Start(11)
Poke _PTR11,99
_BADSIZE=Aga Fade To Bank(_PTR11,0,3)
_SENTINEL=Peek(_PTR11)
Erase 11
_AFTERBAD=Aga Palette Get(28)
' Restore full blue palette from AMOS native ABK.
Save "RAM:R33_AGAPAL_FADE.ABK",_B
Erase _B
Load "RAM:R33_AGAPAL_FADE.ABK",_B
_PTR=Start(_B)
_RESTNAME$=Peek$(_PTR-8,8)
_RESTHEAD$=Peek$(_PTR,6)
_RESTSIZE=Length(_B)
_COUNT0=Deek(_PTR+20)
_COUNT1=Deek(_PTR+28)
_RELOAD=Aga Fade To Bank(_PTR,1,5)
_RESTBLUE=Aga Palette Get(28)
_SWAP=Aga Swap
Amos To Back
For _I=1 To 60
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Fade To Bank(_PTR,1,3)
_CLOSED=Aga Mouse X
_RESULT=1
If _INIT<>1 or _OPEN<>1 or _DB<>1 or _CLR<>1 or _BOX<>1 or _BAR<>1 or _SWAP<>1
   _RESULT=0
End If
If _P3<>1 or _P224<>1 or _GREEN<>1 or _BLUE<>1 or _RED<>1
   _RESULT=0
End If
If _CAP0<>1 or _CAP1<>1 or _FADE0<>1 or _FADE1<>1 or _SAME<>1
   _RESULT=0
End If
If _GETGREEN<>65280 or _GETBLUE<>255 or _GETSAME<>255
   _RESULT=0
End If
If _RED2<>1 or _WHITE3<>1 or _PART<>1
   _RESULT=0
End If
If _PART3<>660510 or _PART28<>16711680
   _RESULT=0
End If
If _BAD0<>0 or _BAD256<>0 or _BADNEG<>0 or _BADINDEX<>0
   _RESULT=0
End If
If _EMPTY<>0 or _BADSIZE<>0 or _SENTINEL<>99
   _RESULT=0
End If
If _AFTERBAD<>16711680
   _RESULT=0
End If
If _RESTNAME$<>"AGAPAL  " or _RESTHEAD$<>"AGAPAL"
   _RESULT=0
End If
If _RESTSIZE<>6224 or _COUNT0<>4 or _COUNT1<>256
   _RESULT=0
End If
If _RELOAD<>1 or _RESTBLUE<>255
   _RESULT=0
End If
If _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Print "M13-R33-AGAPAL-FADE-01"
Print "INIT ";_INIT;" OPEN ";_OPEN;" DB ";_DB
Print "CAP0 ";_CAP0;" CAP1 ";_CAP1
Print "FADE0 ";_FADE0;" GREEN ";_GETGREEN
Print "FADE1 ";_FADE1;" BLUE ";_GETBLUE;" SAME ";_SAME;" ";_GETSAME
Print "PART ";_PART;" PEN3 ";_PART3;" PEN28 ";_PART28
Print "BAD0 ";_BAD0;" BAD256 ";_BAD256;" BADNEG ";_BADNEG
Print "BADINDEX ";_BADINDEX;" EMPTY ";_EMPTY;" BADSIZE ";_BADSIZE
Print "AFTERBAD ";_AFTERBAD;" SENTINEL ";_SENTINEL
Print "ABK ";_RESTHEAD$;" SIZE ";_RESTSIZE
Print "COUNT0 ";_COUNT0;" COUNT1 ";_COUNT1
Print "RELOAD ";_RELOAD;" BLUE ";_RESTBLUE
Print "NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
