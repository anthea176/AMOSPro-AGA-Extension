' M19 P2.2 - FOURTH BOBS AP20 UNIT PROBE ONLY (DESIGN TEST)
' DO NOT RUN WITH R84; REQUIRES THE EXPERIMENTAL 4-UNIT PROBE LIB.
' No object rendering yet, this only checks loader and 68020 entry.
' For later B/C gates, do not use in place of M19 P2.1 active benchmark.
Set Buffer 20
Cls
Print "M19 P2.2 FOURTH AP20 UNIT"
_RESULT=1 : _ERR=0 : _P=0 : _D=0
_LOG$="RAM:M19_P22_4UNIT_RUNTIME.TXT"
_PRG=Prg State
If _PRG=-1
   _LOG$="RAM:M19_P22_4UNIT_COMPILED.TXT"
End If
If _PRG=0
   _LOG$="RAM:M19_P22_4UNIT_INTERPRETED.TXT"
End If
_D=Aga Detect
If _D=0
   _ERR=1
End If
_P=Aga Bob Probe
If _P<>1
   _ERR=2
End If
If _ERR<>0
   _RESULT=0
End If
_VERDICT$="PASS"
If _RESULT<>1
   _VERDICT$="FAIL"
End If
Print "DETECT ";_D;" BOB PROBE ";_P
Print _VERDICT$;" ERR ";_ERR
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P22_4UNIT_PROBE_01"
   Print #1,"LIBRARY EXPERIMENTAL_4UNIT_GATE_A_ONLY"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"ERR ";_ERR
   Print #1,"AGA_DETECT ";_D
   Print #1,"BOB_PROBE ";_P
   Print #1,"CLOSE_RETURNED 1"
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
Print "CLOSE RETURNED"
End
