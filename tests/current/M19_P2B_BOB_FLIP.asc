' M19 P2b - signed anchor, mirrored AGBO bitplanes and mask collision
Set Buffer 20
Cls
_OPEN=0 : _ERR=0 : _OK=0 : _CLOSE_RETURNED=0
_PROBE_PREALLOC=0 : _CHECKS=0 : _RUN=-1 : _X=-1 : _Y=-1 : _SAMPLE=-1
_RECT=-99 : _MASK=-99 : _BADMODE=-99
_PRG=Prg State
_LOG$="RAM:M19_P2B_BOB_FLIP.TXT"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(24)<>0 or Length(25)<>0 or Length(27)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
_A=Aga Blit Fill(16,16,17,3,0)
_B=Aga Blit Fill(17,17,1,1,1)
_C=Aga Blit Fill(60,16,1,1,2)
_D=Aga Blit Fill(96,98,8,5,0)
If _A<>1 or _B<>1 or _C<>1 or _D<>1
   _ERR=5 : Goto _CLEANUP
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,32,18
Make AGA Bob Mask 1,0
Aga Bob Bank 25
Get AGA Bob 1,60,16,60,16
' Allocate the CBlock before binding Bobs. Later captures reuse its storage.
_PROBE_PREALLOC=Aga C Block Capture(27,96,101,8,1,0)
If _PROBE_PREALLOC<>1 or Length(27)<>56
   _ERR=13 : Goto _CLEANUP
End If
' Prepare both now-populated AGBO banks in Chip, including the off-screen target.
Aga Bob Bank 24
Aga Bob 1,100,100,1
Aga Bob Bank 25
Aga Bob 2,101,101,1
For _RUN=0 To 3
   Aga Bob Off 2
   _SET=Aga Bob Flip(1,_RUN)
   If _SET<>1
      _ERR=6 : Goto _CLEANUP
   End If
   _X=101 : _Y=101 : _BIT=4
   If (_RUN and 1)<>0
      _X=99 : _BIT=16
   End If
   If (_RUN and 2)<>0
      _Y=99
   End If
   _UP=Aga Bob Update
   If _UP<>1
      _ERR=7 : Goto _CLEANUP
   End If
   _CAP=Aga C Block Capture(27,96,_Y,8,1,0)
   If _CAP<>1 or Length(27)<>56
      _ERR=8 : Goto _CLEANUP
   End If
   _SAMPLE=Peek(Start(27)+40)
   If _SAMPLE<>_BIT
      _ERR=9 : Goto _CLEANUP
   End If
   _CHECKS=_CHECKS+1
   Aga Bob 2,_X,_Y,1
   _RECT=Aga Bob Col(1,2,0)
   _MASK=Aga Bob Col(1,2,1)
   If _RECT<>1 or _MASK<>1
      _ERR=10 : Goto _CLEANUP
   End If
   _CHECKS=_CHECKS+2
   Aga Bob 2,100,100,1
   _RECT=Aga Bob Col(1,2,0)
   _MASK=Aga Bob Col(1,2,1)
   If _RECT<>1 or _MASK<>0
      _ERR=11 : Goto _CLEANUP
   End If
   _CHECKS=_CHECKS+2
Next _RUN
_BADMODE=Aga Bob Flip(1,4)
If _BADMODE<>0
   _ERR=12 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+1
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
   If Length(24)<>0
      Erase 24
   End If
   If Length(25)<>0
      Erase 25
   End If
   If Length(27)<>0
      Erase 27
   End If
End If
If _ERR=0 and _CHECKS=21 and _CLOSE_RETURNED=1
   _OK=1
End If
_VERDICT$="FAIL"
If _OK=1
   _VERDICT$="PASS"
End If
Print "M19 P2b BOB FLIP ";_VERDICT$;" ERR ";_ERR
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 P2B BOB FLIP"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"PROBE_PREALLOC ";_PROBE_PREALLOC
   Print #1,"CHECKS ";_CHECKS
   Print #1,"MODE ";_RUN
   Print #1,"PIXEL_X ";_X
   Print #1,"PIXEL_Y ";_Y
   Print #1,"PLANE_0 ";_SAMPLE
   Print #1,"RECT ";_RECT
   Print #1,"MASK ";_MASK
   Print #1,"BADMODE ";_BADMODE
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
End
