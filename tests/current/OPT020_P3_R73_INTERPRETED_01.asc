' OPT020/P3 R73 - WinUAE AGA 68020/68030, interpreted ONLY.
' GATE B only. NEVER run AMOS Compiler during this test.
' R73 P1e+P2+P3: FIcon capture/draw 020, no public API changes.
' AGAPIC4 on 16 colors, then FICON8 on 256 colors. Two screen phases.
' Check opaque, mask, clipped, source bank and no-screen refusal.
' Only one active ASC. R68 LAST_GOOD and archives are protected.
Print "OPT020-P3-R73-INTERPRETED-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
Load "M16_AGAPIC_SAMPLE_BANK10.abk",10
Load "M18_FICON8_SAMPLE_BANK10.abk",11
_BASE=Start(10)
_LEN=Length(10)
If _BASE=0 or _LEN<>1836 or Start(11)=0 or Length(11)<>1164
   Print "AGAPIC OR FICON8 BANK MISSING"
   Erase 10 : Erase 11
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   Erase 10 : Erase 11
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 10 : Erase 11
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,255,40,190)
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,20,35,65)
_P3=Aga Palette Set(3,255,202,50)
_SW0=0
For _TRY=1 To 20
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Clear(0,0,320,256)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
_D0=0
_D1=0
_D2=0
_D3=0
_SHIFT=0
_CL=0
_CR=0
_CT=0
_CB=0
_OUT=0
_EDGE=0
_PART=0
_MASKOPAQUE=0
_P2OPA=0
_P2MSK=0
_P2SHIFT=0
_P2LEFT=0
_P2RIGHT=0
_P2TOP=0
_P2BOTTOM=0
_P2OUT=0
_P2BADP=0
_P2BADL=0
_P2BADM=0
_P2BADX=0
_BADB=0
_BADX=0
_BADY=0
_BADW=0
_BADM=0
_OLD=0
_SWAP=0
_FOPA=0 : _FMASK=0 : _FSHIFT=0
_FCL=0 : _FCR=0 : _FCT=0 : _FCB=0 : _FOUT=0
_FBADBANK=0 : _FBADID=0 : _FBADMODE=0
_FCAP=0 : _FEQ=0 : _FCBADX=0 : _FCBADBANK=0 : _FCBADID=0
If _READY=1
   _BG=Aga Blit Fill(0,0,320,256,2)
   _P2OPA=Aga Image Draw(_BASE,_LEN,18,20,0)
   _P2MSK=Aga Image Draw(_BASE,_LEN,108,20,1)
   _P2SHIFT=Aga Image Draw(_BASE,_LEN,197,22,1)
   _P2LEFT=Aga Image Draw(_BASE,_LEN,-15,196,1)
   _P2RIGHT=Aga Image Draw(_BASE,_LEN,291,182,0)
   _P2TOP=Aga Image Draw(_BASE,_LEN,256,-17,1)
   _P2BOTTOM=Aga Image Draw(_BASE,_LEN,105,241,1)
   _P2OUT=Aga Image Draw(_BASE,_LEN,320,256,0)
   _P2BADP=Aga Image Draw(0,_LEN,20,20,1)
   _P2BADL=Aga Image Draw(_BASE,20,20,20,0)
   _P2BADM=Aga Image Draw(_BASE,_LEN,20,20,2)
   _P2BADX=Aga Image Draw(_BASE,_LEN,32768,20,0)
   _D0=Aga Image Region(10,0,0,32,20,20,65,0)
   _D1=Aga Image Region(10,32,0,32,20,88,65,1)
   _D2=Aga Image Region(10,0,20,32,20,156,65,0)
   _D3=Aga Image Region(10,32,20,32,20,224,65,1)
   _SHIFT=Aga Image Region(10,19,7,19,11,271,99,1)
   _CL=Aga Image Region(10,0,0,19,11,-7,140,1)
   _CR=Aga Image Region(10,0,0,19,11,310,141,1)
   _CT=Aga Image Region(10,0,0,19,11,80,-5,1)
   _CB=Aga Image Region(10,0,0,19,11,130,251,1)
   _OUT=Aga Image Region(10,0,0,19,11,320,256,1)
   _EDGE=Aga Image Region(10,0,0,16,16,304,208,0)
   _PART=Aga Image Region(10,1,1,17,12,313,240,1)
   _MASKOPAQUE=Aga Image Region(10,19,7,17,11,40,205,0)
   _BADB=Aga Image Region(4,0,0,16,16,10,10,0)
   _BADX=Aga Image Region(10,-1,0,16,16,10,10,0)
   _BADY=Aga Image Region(10,0,39,16,2,10,10,0)
   _BADW=Aga Image Region(10,0,0,0,16,10,10,0)
   _BADM=Aga Image Region(10,0,0,16,16,10,10,2)
   _OLD=Aga Bank Image Draw(10,116,169,0)
End If
For _TRY=1 To 20
   If _SWAP=0
      _SWAP=Aga Swap
   End If
   If _SWAP=0
      Aga Wait Vbl
   End If
Next _TRY
If _SWAP=1
   Amos To Back
End If
For _HOLD=1 To 125
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOS=Aga Image Region(10,0,0,16,16,25,25,0)
_P2NOS=Aga Image Draw(_BASE,_LEN,25,25,0)
_CFMID=Chip Free
' P3: new 8-plane screen (AGAPIC4/P1e/P2 require 4 planes).
_OPEN8=Aga Screen Open(320,256,256,$00021000)
_DB8=0 : _SW08=0 : _READY8=0 : _BG8=0 : _SWAP8=0
_FP0=0 : _FP1=0 : _FP2=0 : _FP3=0 : _FP255=0
If _OPEN8=1
   _DB8=Aga Double Buffer
   If _DB8=1
      _FP0=Aga Palette Set(0,255,40,190)
      _FP1=Aga Palette Set(1,255,255,255)
      _FP2=Aga Palette Set(2,20,35,65)
      _FP3=Aga Palette Set(3,255,202,50)
      _FP255=Aga Palette Set(255,255,255,255)
      For _TRY=1 To 20
         If _SW08=0
            _SW08=Aga Swap
         End If
         If _SW08=0
            Aga Wait Vbl
         End If
      Next _TRY
      Amos To Back
      For _TRY=1 To 40
         If _READY8=0
            _READY8=Aga Blit Clear(0,0,320,256)
         End If
         If _READY8=0
            Aga Wait Vbl
         End If
      Next _TRY
      If _READY8=1
         _BG8=Aga Blit Fill(0,0,320,256,2)
      ' P3: capture opaque icon from the BACK bitmap; compare all 288 bytes.
      _FOPA=Aga F Icon(11,1,31,104,0)
      _FCAP=Aga F Icon Capture(11,4,31,104)
      _FEQ=1
      For _I=0 To 287
         If Peek(Start(11)+12+_I)<>Peek(Start(11)+12+864+_I)
            _FEQ=0
         End If
      Next _I
      _FMASK=Aga F Icon(11,4,61,105,1)
      _FSHIFT=Aga F Icon(11,2,133,110,0)
      _FCL=Aga F Icon(11,3,-7,154,1)
      _FCR=Aga F Icon(11,3,314,154,1)
      _FCT=Aga F Icon(11,1,220,-5,0)
      _FCB=Aga F Icon(11,2,251,252,0)
      _FOUT=Aga F Icon(11,2,320,256,0)
      _FBADBANK=Aga F Icon(4,2,120,120,0)
      _FBADID=Aga F Icon(11,0,120,120,0)
      _FBADMODE=Aga F Icon(11,2,120,120,2)
      _FCBADX=Aga F Icon Capture(11,4,305,44)
      _FCBADBANK=Aga F Icon Capture(4,2,31,44)
      _FCBADID=Aga F Icon Capture(11,5,31,44)
      End If
      For _TRY=1 To 20
         If _SWAP8=0
            _SWAP8=Aga Swap
         End If
         If _SWAP8=0
            Aga Wait Vbl
         End If
      Next _TRY
      If _SWAP8=1
         Amos To Back
      End If
      For _HOLD=1 To 125
         Aga Wait Vbl
      Next _HOLD
   End If
   Aga Screen Close
   Amos To Front
End If
_CLOSED8=Aga Mouse X
_FNOS=Aga F Icon(11,2,25,25,0)
_FCAPNOS=Aga F Icon Capture(11,4,25,25)
Erase 11
Erase 10
_CF1=Chip Free
_RESULT=1
If _OPEN<>1 or _DB<>1 or _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
   _RESULT=0
End If
If _SW0<>1 or _READY<>1 or _BG<>1 or _SWAP<>1
   _RESULT=0
End If
If _P2OPA<>1 or _P2MSK<>1 or _P2SHIFT<>1 or _P2LEFT<>1 or _P2RIGHT<>1
   _RESULT=0
End If
If _P2TOP<>1 or _P2BOTTOM<>1 or _P2OUT<>1
   _RESULT=0
End If
If _P2BADP<>0 or _P2BADL<>0 or _P2BADM<>0 or _P2BADX<>0 or _P2NOS<>0
   _RESULT=0
End If
If _D0<>1 or _D1<>1 or _D2<>1 or _D3<>1 or _SHIFT<>1
   _RESULT=0
End If
If _CL<>1 or _CR<>1 or _CT<>1 or _CB<>1 or _OUT<>1 or _EDGE<>1 or _PART<>1 or _MASKOPAQUE<>1
   _RESULT=0
End If
If _BADB<>0 or _BADX<>0 or _BADY<>0 or _BADW<>0 or _BADM<>0
   _RESULT=0
End If
If _OLD<>1 or _NOS<>0 or _CLOSED<>-1
   _RESULT=0
End If
If _OPEN8<>1 or _DB8<>1 or _SW08<>1 or _READY8<>1 or _BG8<>1 or _SWAP8<>1
   _RESULT=0
End If
If _FP0<>1 or _FP1<>1 or _FP2<>1 or _FP3<>1 or _FP255<>1
   _RESULT=0
End If
If _CF0<>_CFMID or _CFMID<>_CF1 or _CLOSED8<>-1
   _RESULT=0
End If
If _FOPA<>1 or _FMASK<>1 or _FSHIFT<>1 or _FCAP<>1 or _FEQ<>1
   _RESULT=0
End If
If _FCL<>1 or _FCR<>1 or _FCT<>1 or _FCB<>1 or _FOUT<>1
   _RESULT=0
End If
If _FBADBANK<>0 or _FBADID<>0 or _FBADMODE<>0
   _RESULT=0
End If
If _FCBADX<>0 or _FCBADBANK<>0 or _FCBADID<>0
   _RESULT=0
End If
If _FNOS<>0 or _FCAPNOS<>0 or _CF0<>_CF1
   _RESULT=0
End If
Cls
Print "OPT020-P3-R73-INTERPRETED-01"
Print "OPT020 P1e+P2+P3 - GATE B ONLY"
Print "P2 O/M/SHIFT ";_P2OPA;" ";_P2MSK;" ";_P2SHIFT
Print "P2 CLIP L/R/T/B ";_P2LEFT;" ";_P2RIGHT;" ";_P2TOP;" ";_P2BOTTOM
Print "P2 OUT/BAD P/L/M/X/NOS ";_P2OUT;" ";_P2BADP;" ";_P2BADL;" ";_P2BADM;" ";_P2BADX;" ";_P2NOS
Print "OPEN ";_OPEN;" DB ";_DB;" SW0 ";_SW0;" SAFE ";_READY
Print "FRAMES ";_D0;" ";_D1;" ";_D2;" ";_D3;" SHIFT ";_SHIFT
Print "CLIP ";_CL;" ";_CR;" ";_CT;" ";_CB;" OUT ";_OUT
Print "EDGE/PART/MASK OPAQUE ";_EDGE;" ";_PART;" ";_MASKOPAQUE
Print "BAD BANK/X/Y/W/M ";_BADB;" ";_BADX;" ";_BADY;" ";_BADW;" ";_BADM
Print "LEGACY ";_OLD;" SWAP ";_SWAP;" NOS ";_NOS;" CLOSE ";_CLOSED
Print "P3 OPEN/DB/SW0/SAFE ";_OPEN8;" ";_DB8;" ";_SW08;" ";_READY8
Print "P3 FILL/SWAP/CLOSE ";_BG8;" ";_SWAP8;" ";_CLOSED8
Print "FICON DRAW O/M/SHIFT ";_FOPA;" ";_FMASK;" ";_FSHIFT
Print "FICON CAP/EQ288 ";_FCAP;" ";_FEQ
Print "FICON CLIP L/R/T/B/OUT ";_FCL;" ";_FCR;" ";_FCT;" ";_FCB;" ";_FOUT
Print "FICON BAD B/I/M CAPX/B/I ";_FBADBANK;" ";_FBADID;" ";_FBADMODE;" ";_FCBADX;" ";_FCBADBANK;" ";_FCBADID
Print "FICON NOS DRAW/CAP ";_FNOS;" ";_FCAPNOS
Print "CHIP START/MID/END ";_CF0;" ";_CFMID;" ";_CF1
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
