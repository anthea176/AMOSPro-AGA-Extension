' M15BIS-R44-CURSOR-01 : Gate B AMOS/WinUAE NOT TESTED.
' R44 0.11.5 candidate; R43 LAST_GOOD stays untouched.
' Visual phases: VISIBLE -> HIDDEN -> VISIBLE -> HIDDEN -> CLOSE.
' Move mouse over AGA; try Workbench focus while hidden if possible.
' Chip samples occur after first allocation; 500 toggles same Window.
Cls
Print "M15BIS-R44-CURSOR-01"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_CFBEFORE=Chip Free
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_PA=Aga Palette Set(1,255,255,255)
_PB=Aga Palette Set(2,255,210,65)
_PC=Aga Palette Set(3,100,220,255)
_CLR=Aga Blit Clear(0,0,320,256)
_T0=Aga Text(26,25,1,"R44 - MOUSE CURSOR")
_T1=Aga Text(10,67,2,"VISIBLE - HIDDEN")
_T2=Aga Text(10,94,3,"MOVE MOUSE IN AGA")
_T3=Aga Text(10,223,1,"500 SWITCHES / NO LEAK")
_B1=Aga Box(5,40,314,240,3)
_C1=Aga Circle(160,142,40,2)
_SHOW0=Aga Mouse Cursor(1)
_BAD2=Aga Mouse Cursor(2)
_BADM=Aga Mouse Cursor(-1)
_SW=Aga Swap
If _SW=1
   Amos To Back
End If
' Initially visible; allow observer to see default cursor.
For _I=1 To 110
   Aga Wait Vbl
Next _I
' Hide once: lazy allocation must succeed.
_HIDE0=Aga Mouse Cursor(0)
_CF0=Chip Free
Dreg(1)=$20002
_BIG0=Execall(-216)
_MX=Aga Mouse X
_MY=Aga Mouse Y
_BUTTONS=Aga Mouse Buttons
' Stay hidden while user moves pointer/clicks.
For _I=1 To 100
   Aga Wait Vbl
Next _I
_ERR=0
For _I=1 To 500
   _S=Aga Mouse Cursor(1)
   _H=Aga Mouse Cursor(0)
   If _S<>1 or _H<>1
      _ERR=_ERR+1
   End If
Next _I
_CF1=Chip Free
Dreg(1)=$20002
_BIG1=Execall(-216)
_DROP=_CF0-_CF1
_BDROP=_BIG0-_BIG1
_SHOW1=Aga Mouse Cursor(1)
' Reappear for visual inspection.
For _I=1 To 105
   Aga Wait Vbl
Next _I
_SHOW2=Aga Mouse Cursor(1)
_HIDE1=Aga Mouse Cursor(0)
' Close intentionally WHILE HIDDEN to test automatic restoration.
For _I=1 To 100
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Mouse Cursor(0)
_CLOSED=Aga Mouse X
_CFEND=Chip Free
_WARN=0
If _DROP>2048
   _WARN=1
End If
_RESULT=1
If _OPEN<>1 or _DB<>1 or _PA<>1 or _PB<>1 or _PC<>1
   _RESULT=0
End If
If _CLR<>1 or _T0<>1 or _T1<>1 or _T2<>1 or _T3<>1
   _RESULT=0
End If
If _B1<>1 or _C1<>1 or _SW<>1
   _RESULT=0
End If
If _SHOW0<>1 or _HIDE0<>1 or _SHOW1<>1 or _SHOW2<>1 or _HIDE1<>1
   _RESULT=0
End If
If _BAD2<>0 or _BADM<>0 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
If _ERR<>0
   _RESULT=0
End If
Cls
Print "M15BIS-R44-CURSOR-01"
Print "OPEN ";_OPEN;" DB ";_DB;" SWAP ";_SW
Print "SHOW ";_SHOW0;" ";_SHOW1;" ";_SHOW2
Print "HIDE ";_HIDE0;" ";_HIDE1
Print "BAD ";_BAD2;" ";_BADM;" NOSCREEN ";_NOSCREEN
Print "SWITCHES 500 ERR ";_ERR
Print "MOUSE X/Y ";_MX;" ";_MY;" BUTTONS ";_BUTTONS
Print "CHIP FREE ";_CF0;" ";_CF1;" DROP ";_DROP
Print "BIG FREE ";_BIG0;" ";_BIG1;" DROP ";_BDROP
Print "CHIP WARN ";_WARN;" (not proof)"
Print "CHIP BEFORE/END ";_CFBEFORE;" ";_CFEND
Print "CLOSED ";_CLOSED;" RESULT ";_RESULT
Print "CLOSE RETURNED"
End
