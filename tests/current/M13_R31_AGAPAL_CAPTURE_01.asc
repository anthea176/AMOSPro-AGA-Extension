' M13-R31-AGAPAL-CAPTURE-01 — Gate B, interpreted AMOS/WinUAE.
' Requires the R31 0.10.3 candidate in APSystem, not R30 LAST_GOOD.
' Tests only Aga Palette Bank Capture(Start(bank),zero-based index).
' WARNING: overwrites AMOS banks 10 and 11, plus
' RAM:R31_AGAPAL_CAPTURE.ABK. This file contains an AMOS-native ABK.
Cls
Print "M13-R31-AGAPAL-CAPTURE-01"
_B=10
_N=8
Reserve As Data _B,6224
_PTR=Start(_B)
_INIT=Aga Palette Bank Init(_PTR,_N)
If _INIT<>1
   Print "INIT FAILED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DB FAILED"
   End
End If
_CLR=Aga Blit Clear(0,0,320,256)
_PANEL=Aga Blit Fill(25,70,270,116,28)
_BAR=Aga Blit Fill(25,196,270,14,224)
_TITLE=Aga Text(35,44,28,"R31 AGAPAL CAPTURE")
_P3=Aga Palette Set(3,10,20,30)
_P224=Aga Palette Set(224,12,34,56)
_GREEN=Aga Palette Set(28,0,255,0)
_CAP0=Aga Palette Bank Capture(_PTR,0)
_FIRSTGREEN=Peek(_PTR+80+28*3+1)
_FIRST224=Peek(_PTR+80+224*3+2)
_RED=Aga Palette Set(28,255,0,0)
_CAP1=Aga Palette Bank Capture(_PTR,1)
_P1RED=Peek(_PTR+848+28*3)
_P0STILLGREEN=Peek(_PTR+80+28*3+1)
_BLUE=Aga Palette Set(28,0,0,255)
_BEFORE=Aga Palette Get(28)
_OVERWRITE=Aga Palette Bank Capture(_PTR,0)
_AFTER=Aga Palette Get(28)
_P0R=Peek(_PTR+80+28*3)
_P0G=Peek(_PTR+80+28*3+1)
_P0B=Peek(_PTR+80+28*3+2)
_P1STILLRED=Peek(_PTR+848+28*3)
_COUNT0=Deek(_PTR+20)
_COUNT1=Deek(_PTR+28)
_BADNEG=Aga Palette Bank Capture(_PTR,-1)
_BAD8=Aga Palette Bank Capture(_PTR,8)
_PRESERVE=Peek(_PTR+80+28*3+2)
Reserve As Data 11,6000
_PTR11=Start(11)
Poke _PTR11,99
_BADSIZE=Aga Palette Bank Capture(_PTR11,0)
_SENTINEL=Peek(_PTR11)
Erase 11
_SWAP=Aga Swap
Amos To Back
For _I=1 To 100
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOSCREEN=Aga Palette Bank Capture(_PTR,0)
_STILLBLUE=Peek(_PTR+80+28*3+2)
Save "RAM:R31_AGAPAL_CAPTURE.ABK",_B
Erase _B
Load "RAM:R31_AGAPAL_CAPTURE.ABK",_B
_PTR=Start(_B)
_RESTNAME$=Peek$(_PTR-8,8)
_RESTHEAD$=Peek$(_PTR,6)
_RESTSIZE=Length(_B)
_RESTCOUNT0=Deek(_PTR+20)
_RESTCOUNT1=Deek(_PTR+28)
_RESTBLUE=Peek(_PTR+80+28*3+2)
_RESTRED=Peek(_PTR+848+28*3)
_REST3=Peek(_PTR+80+3*3)
_REST224=Peek(_PTR+848+224*3+2)
_RESULT=1
If _INIT<>1 or _OPEN<>1 or _DB<>1
   _RESULT=0
End If
If _CLR<>1 or _PANEL<>1 or _BAR<>1 or _TITLE<>1
   _RESULT=0
End If
If _P3<>1 or _P224<>1 or _GREEN<>1 or _RED<>1 or _BLUE<>1
   _RESULT=0
End If
If _CAP0<>1 or _CAP1<>1 or _OVERWRITE<>1
   _RESULT=0
End If
If _FIRSTGREEN<>255 or _FIRST224<>56 or _P0STILLGREEN<>255
   _RESULT=0
End If
If _BEFORE<>255 or _AFTER<>255
   _RESULT=0
End If
If _P0R<>0 or _P0G<>0 or _P0B<>255 or _P1STILLRED<>255 or _P1RED<>255
   _RESULT=0
End If
If _COUNT0<>256 or _COUNT1<>256
   _RESULT=0
End If
If _BADNEG<>0 or _BAD8<>0 or _BADSIZE<>0 or _SENTINEL<>99
   _RESULT=0
End If
If _PRESERVE<>255 or _STILLBLUE<>255 or _NOSCREEN<>0
   _RESULT=0
End If
If _SWAP<>1 or _CLOSED<>-1
   _RESULT=0
End If
If _RESTNAME$<>"AGAPAL  " or _RESTHEAD$<>"AGAPAL" or _RESTSIZE<>6224
   _RESULT=0
End If
If _RESTCOUNT0<>256 or _RESTCOUNT1<>256
   _RESULT=0
End If
If _RESTBLUE<>255 or _RESTRED<>255 or _REST3<>10 or _REST224<>56
   _RESULT=0
End If
Print "M13-R31-AGAPAL-CAPTURE-01"
Print "INIT ";_INIT;" OPEN ";_OPEN;" DB ";_DB
Print "CAP0 ";_CAP0;" CAP1 ";_CAP1;" OVER ";_OVERWRITE
Print "GREEN ";_FIRSTGREEN;" RED ";_P1RED;" BLUE ";_P0B
Print "COUNT0 ";_COUNT0;" COUNT1 ";_COUNT1
Print "BEFORE ";_BEFORE;" AFTER ";_AFTER
Print "BADNEG ";_BADNEG;" BAD8 ";_BAD8;" BADSIZE ";_BADSIZE
Print "NOSCREEN ";_NOSCREEN;" SENTINEL ";_SENTINEL
Print "ABK ";_RESTNAME$;" SIZE ";_RESTSIZE
Print "RELOAD ";_RESTBLUE;" ";_RESTRED;" ";_REST3;" ";_REST224
Print "CLOSED ";_CLOSED;" RESULT ";_RESULT
Erase _B
Print "CLOSE RETURNED"
End
