' M19 P2c - destination write mask, independent AGBO opacity, and Flip
Set Buffer 20
Cls
_OPEN=0 : _ERR=0 : _OK=0 : _CLOSE_RETURNED=0
_CHECKS=0 : _RUN=-1 : _PIX=-1 : _VALUE=-1 : _EXPECTED=-1
_PROBE_PREALLOC=0 : _PRG=Prg State
_LOG$="RAM:M19_P2C_BOB_PLANES.TXT"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(24)<>0 or Length(25)<>0 or Length(27)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
_A=Aga Blit Fill(16,16,3,1,0)
_B=Aga Blit Fill(17,16,2,1,165)
_C=Aga Blit Fill(60,16,1,1,0)
_D=Aga Blit Fill(96,100,8,1,90)
If _A<>1 or _B<>1 or _C<>1 or _D<>1
   _ERR=5 : Goto _CLEANUP
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,18,16
Make AGA Bob Mask 1,0
Aga Bob Bank 25
Get AGA Bob 1,60,16,60,16
' Allocate the probe before binding Bobs to the AMOS bank list.
_PROBE_PREALLOC=Aga C Block Capture(27,96,100,8,1,0)
If _PROBE_PREALLOC<>1 or Length(27)<>56
   _ERR=6 : Goto _CLEANUP
End If
Aga Bob Bank 24
Aga Bob 1,98,100,1
Aga Bob Bank 25
Aga Bob 2,103,100,1
For _RUN=0 To 3
   _MASK1=129 : _MASK2=66 : _FLIP=0
   _LEFT=3 : _RIGHT=4 : _PAINT=219 : _OPAQUE=24
   If _RUN=0
      _PAINT=165 : _OPAQUE=0
   Else
      If _RUN=2
         _MASK1=0 : _MASK2=0 : _PAINT=90 : _OPAQUE=90
      End If
      If _RUN=3
         _FLIP=1 : _LEFT=0 : _RIGHT=1
      End If
      _SET1=Aga Bob Planes(1,_MASK1)
      _SET2=Aga Bob Planes(2,_MASK2)
      _F=Aga Bob Flip(1,_FLIP)
      If _SET1<>1 or _SET2<>1 or _F<>1
         _ERR=7 : Goto _CLEANUP
      End If
   End If
   _UP=Aga Bob Update
   If _UP<>1
      _ERR=8 : Goto _CLEANUP
   End If
   _CAP=Aga C Block Capture(27,96,100,8,1,0)
   If _CAP<>1 or Length(27)<>56
      _ERR=9 : Goto _CLEANUP
   End If
   _PTR=Start(27)+40 : _BIT=128
   For _PIX=0 To 7
      _EXPECTED=90
      If _PIX>=_LEFT and _PIX<=_RIGHT
         _EXPECTED=_PAINT
      End If
      If _PIX=7
         _EXPECTED=_OPAQUE
      End If
      _VALUE=0 : _PLANE_BIT=1
      For _PLANE=0 To 7
         _BYTE=Peek(_PTR+2*_PLANE)
         If (_BYTE and _BIT)<>0
            _VALUE=_VALUE+_PLANE_BIT
         End If
         _PLANE_BIT=_PLANE_BIT*2
      Next _PLANE
      If _VALUE<>_EXPECTED
         _ERR=10 : Goto _CLEANUP
      End If
      _CHECKS=_CHECKS+1
      _BIT=_BIT/2
   Next _PIX
Next _RUN
_BAD1=Aga Bob Planes(1,-1)
_BAD2=Aga Bob Planes(1,256)
If _BAD1<>0 or _BAD2<>0
   _ERR=11 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+2
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
   If Length(24)<>0
      Erase 24
   End If
   If Length(25)<>0
      Erase 25
   End If
   If Length(27)<>0
      Erase 27
   End If
End If
If _ERR=0 and _CHECKS=34 and _CLOSE_RETURNED=1
   _OK=1
End If
_VERDICT$="FAIL"
If _OK=1
   _VERDICT$="PASS"
End If
Print "M19 P2c BOB PLANES ";_VERDICT$;" ERR ";_ERR
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 P2C BOB PLANES"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"PROBE_PREALLOC ";_PROBE_PREALLOC
   Print #1,"CHECKS ";_CHECKS
   Print #1,"MODE ";_RUN
   Print #1,"PIXEL ";_PIX
   Print #1,"VALUE ";_VALUE
   Print #1,"EXPECTED ";_EXPECTED
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
End
