' M19 B7-M1 A/B/C FILL VERSUS DIRTY RECT BENCH - RUNTIME ONLY
' LIB SHA256 838245ce1ad2a4120bb2512df8b2147ae89dc6b3eebe2ba2a9f633f2e9a56403
' WINUAE AGA PAL 68030 JIT ON. NO COMPILER TEST.
' 6 RUNS: A B C C B A; 120 FRAMES EACH; TIMER IS 1/50 SEC.
' A=FULL FILL+4 BOBS; B=FULL FILL+SWAP; C=DIRTY FILL+4 BOBS.
' C PRIMES BOTH PAGES WITH A FULL FILL BEFORE DIRTY CLEAR.
Set Buffer 20
Cls
Dim _TICKS(6),_FPS10(6),_FRAMES(6),_CASES(6)
Dim _OX1(1),_OY1(1),_OX2(1),_OY2(1)
Dim _OX3(1),_OY3(1),_OX4(1),_OY4(1)
_BANK1=24 : _BANK2=25 : _ERR=0 : _OPEN=0 : _DB=0
_OWN1=0 : _OWN2=0 : _FR_OK=0 : _TARGET=120
_DRAW=0 : _SW=0 : _CLEAR=0 : _CLOSE_CALLED=0 : _BANKS_ERASED=0
_CLEAR_BAD=0 : _DRAW_BAD=0 : _SW_BAD=0 : _RETRY_VBL=0
_COUNT1=0 : _COUNT2=0 : _MASKFLAG=0 : _RESULT=0
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_B7M1_CLEAR_BENCH.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
End If
If _PRG=1
   _MODE$="RUNTIME"
End If
If _PRG=-1
   _ERR=1 : Goto _CLEANUP
End If
Print "M19 B7-M1 FULL / NO BOB / DIRTY BENCH"
If Aga Detect=0
   _ERR=2 : Goto _CLEANUP
End If
If Length(_BANK1)<>0 or Length(_BANK2)<>0
   _ERR=3 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=5 : Goto _CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,20,32,64)
_P4=Aga Palette Set(4,255,64,48)
_P5=Aga Palette Set(5,255,228,38)
_A=Aga Blit Fill(0,0,320,256,0)
If _A<>1
   _ERR=6 : Goto _CLEANUP
End If
_A=Aga Blit Fill(12,16,17,15,4)
_B=Aga Blit Fill(17,21,5,5,0)
If _A<>1 or _B<>1
   _ERR=7 : Goto _CLEANUP
End If
Aga Bob Bank _BANK1
If Length(_BANK1)<>0
   _OWN1=1
End If
If Length(_BANK1)<>32
   _ERR=8 : Goto _CLEANUP
End If
Get AGA Bob 1,12,16,28,30
Make AGA Bob Mask 1,0
_COUNT1=Deek(Start(_BANK1)+8)
_MASKFLAG=Deek(Start(_BANK1)+42)
If _COUNT1<>1 or _MASKFLAG<>1
   _ERR=9 : Goto _CLEANUP
End If
_A=Aga Blit Fill(62,16,37,8,5)
If _A<>1
   _ERR=10 : Goto _CLEANUP
End If
Aga Bob Bank _BANK2
If Length(_BANK2)<>0
   _OWN2=1
End If
If Length(_BANK2)<>32
   _ERR=11 : Goto _CLEANUP
End If
Get AGA Bob 1,62,16,98,23
No AGA Bob Mask 1
_COUNT2=Deek(Start(_BANK2)+8)
If _COUNT2<>1
   _ERR=12 : Goto _CLEANUP
End If
' PREPARE BOTH BACK PAGES OUTSIDE ALL MEASUREMENTS.
For _WARM=1 To 2
   If _ERR=0
      _EX=0 : _EY=0 : _EW=320 : _EH=256
      Gosub _ERASE_RECT
   End If
   If _ERR=0
      Gosub _DO_SWAP
   End If
Next _WARM
If _ERR<>0
   Goto _CLEANUP
End If
Amos To Back
' RUN ORDER IS A/B/C/C/B/A TO REDUCE ORDER BIAS.
For _RUN=1 To 6
   If _ERR=0
      _CASE=_RUN
      If _RUN=4
         _CASE=3
      End If
      If _RUN=5
         _CASE=2
      End If
      If _RUN=6
         _CASE=1
      End If
      _CASES(_RUN)=_CASE
      _PAGE=0
      _T0=Timer
      For _FRAME=1 To 120
         If _ERR=0
            _PHASE=_FRAME
            If _FRAME>60
               _PHASE=120-_FRAME
            End If
            _X1=-10+_PHASE*5 : _Y1=72
            _X2=315-_PHASE*5 : _Y2=110
            _X3=-5+_PHASE*2 : _Y3=170-_PHASE
            _X4=315-_PHASE*3 : _Y4=200-_PHASE
            If _CASE=3 and _FRAME>2
               _EX=_OX1(_PAGE) : _EY=_OY1(_PAGE) : _EW=17 : _EH=15
               Gosub _ERASE_RECT
               If _ERR=0
                  _EX=_OX2(_PAGE) : _EY=_OY2(_PAGE) : _EW=37 : _EH=8
                  Gosub _ERASE_RECT
               End If
               If _ERR=0
                  _EX=_OX3(_PAGE) : _EY=_OY3(_PAGE) : _EW=17 : _EH=15
                  Gosub _ERASE_RECT
               End If
               If _ERR=0
                  _EX=_OX4(_PAGE) : _EY=_OY4(_PAGE) : _EW=37 : _EH=8
                  Gosub _ERASE_RECT
               End If
            Else
               _EX=0 : _EY=0 : _EW=320 : _EH=256
               Gosub _ERASE_RECT
            End If
         End If
         If _ERR=0 and _CASE<>2
            Aga Bob Bank _BANK1
            Aga Bob 1,_X1,_Y1,1
            Aga Bob 3,_X3,_Y3,1
            Aga Bob Bank _BANK2
            Aga Bob 2,_X2,_Y2,1
            Aga Bob 4,_X4,_Y4,1
            _DRAW=Aga Bob Draw
            If _DRAW<>1
               _DRAW_BAD=_DRAW_BAD+1 : _ERR=14
            End If
         End If
         If _ERR=0
            Gosub _DO_SWAP
         End If
         If _ERR=0
            _FR_OK=_FR_OK+1
            _FRAMES(_RUN)=_FRAMES(_RUN)+1
            If _CASE=3
               _OX1(_PAGE)=_X1 : _OY1(_PAGE)=_Y1
               _OX2(_PAGE)=_X2 : _OY2(_PAGE)=_Y2
               _OX3(_PAGE)=_X3 : _OY3(_PAGE)=_Y3
               _OX4(_PAGE)=_X4 : _OY4(_PAGE)=_Y4
               _PAGE=1-_PAGE
            End If
         End If
      Next _FRAME
      _TICKS(_RUN)=Timer-_T0
      If _TICKS(_RUN)>0
         _FPS10(_RUN)=_FRAMES(_RUN)*500/_TICKS(_RUN)
      End If
   End If
Next _RUN
If _ERR<>0
   Goto _CLEANUP
End If
' HOLD OUTSIDE MEASURED WINDOWS TO SEE THE LAST FRAME.
For _HOLD=1 To 40
   Aga Wait Vbl
Next _HOLD
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   Amos To Front
   _CLOSE_CALLED=1
End If
If _OWN1=1
   Erase _BANK1
   _BANKS_ERASED=_BANKS_ERASED+1
End If
If _OWN2=1
   Erase _BANK2
   _BANKS_ERASED=_BANKS_ERASED+1
End If
If _ERR=0 and _FR_OK=720 and _DB=1 and _CLOSE_CALLED=1
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PATH_OK"
End If
Print "M19 B7-M1 BENCH ";_VERDICT$;" ERR ";_ERR
Print "FRAMES ";_FR_OK;" / 720"
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P0J_B7_ANIM_RUNTIME_03 ABC BENCH"
   Print #1,"CANDIDATE SHA256 838245ce1ad2a4120bb2512df8b2147ae89dc6b3eebe2ba2a9f633f2e9a56403"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"FRAMES_TARGET 720"
   Print #1,"FRAMES_OK ";_FR_OK
   Print #1,"BOBS_PER_FRAME_A_C 4"
   Print #1,"BOBS_PER_FRAME_B 0"
   Print #1,"DOUBLE_BUFFER ";_DB
   Print #1,"IMAGE_COUNT1 ";_COUNT1
   Print #1,"IMAGE_COUNT2 ";_COUNT2
   Print #1,"MASK_FLAG ";_MASKFLAG
   Print #1,"CASE_A FULL_FILL_DRAW_SWAP"
   Print #1,"CASE_B FULL_FILL_SWAP_NO_DRAW"
   Print #1,"CASE_C DIRTY_RECT_DRAW_SWAP"
   Print #1,"C_PRIMING_FRAMES_PER_RUN 2"
   Print #1,"TIMER_TICKS_PER_SECOND 50"
   For _REPORT=1 To 6
      Print #1,"RUN ";_REPORT;" CASE ";_CASES(_REPORT)
      Print #1,"RUN_FRAMES ";_FRAMES(_REPORT)
      Print #1,"RUN_TICKS ";_TICKS(_REPORT)
      Print #1,"RUN_FPS_X10 ";_FPS10(_REPORT)
   Next _REPORT
   Print #1,"CLEAR_FAILS ";_CLEAR_BAD
   Print #1,"DRAW_FAILS ";_DRAW_BAD
   Print #1,"SWAP_FAILS ";_SW_BAD
   Print #1,"RETRY_VBL ";_RETRY_VBL
   Print #1,"CLOSE_CALLED ";_CLOSE_CALLED
   Print #1,"BANKS_ERASED ";_BANKS_ERASED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
' FILL WITH CLIPPING, GUARDED RETRIES; ONLY WAIT ON REFUSAL.
_ERASE_RECT:
If _EX<0
   _EW=_EW+_EX : _EX=0
End If
If _EY<0
   _EH=_EH+_EY : _EY=0
End If
If _EX+_EW>320
   _EW=320-_EX
End If
If _EY+_EH>256
   _EH=256-_EY
End If
If _EW>0 and _EH>0
   _CLEAR=0 : _TRY=0
   Repeat
      _TRY=_TRY+1
      _CLEAR=Aga Blit Fill(_EX,_EY,_EW,_EH,1)
      If _CLEAR=0 and _TRY<40
         Aga Wait Vbl
         _RETRY_VBL=_RETRY_VBL+1
      End If
   Until _CLEAR=1 or _TRY=40
   If _CLEAR<>1
      _CLEAR_BAD=_CLEAR_BAD+1 : _ERR=13
   End If
End If
Return
' SWAP SUCCESS ONLY; GUARD DIRTY PREVENTS PARTIAL PRESENTATION.
_DO_SWAP:
_SW=0 : _TRY=0
Repeat
   _TRY=_TRY+1
   _SW=Aga Swap
   If _SW=0 and _TRY<40
      Aga Wait Vbl
      _RETRY_VBL=_RETRY_VBL+1
   End If
Until _SW=1 or _TRY=40
If _SW<>1
   _SW_BAD=_SW_BAD+1 : _ERR=15
End If
Return
