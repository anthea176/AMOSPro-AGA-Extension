' M19 P0j-b7-m1 - 120 FRAME BOB ANIMATION - RUNTIME ONLY
' B7-M1 SHA256 838245ce1ad2a4120bb2512df8b2147ae89dc6b3eebe2ba2a9f633f2e9a56403
' AGA PAL 320X256X256 - 68030 JIT ON. NO COMPILER TEST.
' USE PROJECT -> MERGE ASCII. BANKS 24 AND 25 MUST BE FREE.
' IF NEEDED, ERASE ALL IN A THROWAWAY TEST SESSION FIRST.
Set Buffer 20
Cls
_BANK1=24 : _BANK2=25 : _ERR=0 : _OPEN=0 : _DB=0
_OWN1=0 : _OWN2=0 : _FR_OK=0 : _TARGET=120
_DRAW=0 : _SW=0 : _CLEAR=0 : _CLOSE_CALLED=0 : _BANKS_ERASED=0
_CLEAR_BAD=0 : _DRAW_BAD=0 : _SW_BAD=0
_COUNT1=0 : _COUNT2=0 : _MASKFLAG=0 : _RESULT=0
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_B7_ANIM_RUNTIME.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
End If
If _PRG=1
   _MODE$="RUNTIME"
End If
If _PRG=-1
   _ERR=1 : Goto _CLEANUP
End If
Print "M19 B7-M1 - FOUR MOVING BOBS / DOUBLE BUFFER"
If Aga Detect=0
   _ERR=2 : Goto _CLEANUP
End If
If Length(_BANK1)<>0 or Length(_BANK2)<>0
   _ERR=3 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=5 : Goto _CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,20,32,64)
_P4=Aga Palette Set(4,255,64,48)
_P5=Aga Palette Set(5,255,228,38)
_A=Aga Blit Fill(0,0,320,256,0)
If _A<>1
   _ERR=6 : Goto _CLEANUP
End If
_A=Aga Blit Fill(12,16,17,15,4)
_B=Aga Blit Fill(17,21,5,5,0)
If _A<>1 or _B<>1
   _ERR=7 : Goto _CLEANUP
End If
Aga Bob Bank _BANK1
If Length(_BANK1)<>0
   _OWN1=1
End If
If Length(_BANK1)<>32
   _ERR=8 : Goto _CLEANUP
End If
Get AGA Bob 1,12,16,28,30
Make AGA Bob Mask 1,0
_COUNT1=Deek(Start(_BANK1)+8)
_MASKFLAG=Deek(Start(_BANK1)+42)
If _COUNT1<>1 or _MASKFLAG<>1
   _ERR=9 : Goto _CLEANUP
End If
_A=Aga Blit Fill(62,16,37,8,5)
If _A<>1
   _ERR=10 : Goto _CLEANUP
End If
Aga Bob Bank _BANK2
If Length(_BANK2)<>0
   _OWN2=1
End If
If Length(_BANK2)<>32
   _ERR=11 : Goto _CLEANUP
End If
Get AGA Bob 1,62,16,98,23
No AGA Bob Mask 1
_COUNT2=Deek(Start(_BANK2)+8)
If _COUNT2<>1
   _ERR=12 : Goto _CLEANUP
End If
' EACH ITERATION CLEARS THE HIDDEN BUFFER BEFORE DRAW AND SWAP.
' MOVEMENT IS A 60 FRAME OUT-AND-BACK; EDGE BOBS TEST CLIPPING.
For _FRAME=1 To 120
   If _ERR=0
      _CLEAR=0
      For _TRY=1 To 40
         If _CLEAR=0
            _CLEAR=Aga Blit Fill(0,0,320,256,1)
         End If
         If _CLEAR=0
            Aga Wait Vbl
         End If
      Next _TRY
      If _CLEAR<>1
         _CLEAR_BAD=_CLEAR_BAD+1 : _ERR=13
      End If
   End If
   If _ERR=0
      _PHASE=_FRAME
      If _FRAME>60
         _PHASE=120-_FRAME
      End If
      _X1=-10+_PHASE*5
      _X2=315-_PHASE*5
      Aga Bob Bank _BANK1
      Aga Bob 1,_X1,72,1
      Aga Bob 3,-5,170,1
      Aga Bob Bank _BANK2
      Aga Bob 2,_X2,110,1
      Aga Bob 4,315,200,1
      _DRAW=Aga Bob Draw
      If _DRAW<>1
         _DRAW_BAD=_DRAW_BAD+1 : _ERR=14
      End If
   End If
   If _ERR=0
      _SW=0
      For _TRY=1 To 40
         If _SW=0
            _SW=Aga Swap
         End If
         If _SW=0
            Aga Wait Vbl
         End If
      Next _TRY
      If _SW<>1
         _SW_BAD=_SW_BAD+1 : _ERR=15
      End If
   End If
   If _ERR=0
      _FR_OK=_FR_OK+1
      If _FR_OK=1
         Amos To Back
      End If
      Aga Wait Vbl
   End If
Next _FRAME
If _ERR<>0
   Goto _CLEANUP
End If
For _HOLD=1 To 40
   Aga Wait Vbl
Next _HOLD
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   Amos To Front
   _CLOSE_CALLED=1
End If
If _OWN1=1
   Erase _BANK1
   _BANKS_ERASED=_BANKS_ERASED+1
End If
If _OWN2=1
   Erase _BANK2
   _BANKS_ERASED=_BANKS_ERASED+1
End If
If _ERR=0 and _FR_OK=_TARGET and _DB=1 and _CLOSE_CALLED=1
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PATH_OK"
End If
Print "M19 B7-M1 ANIM ";_VERDICT$;" ERR ";_ERR
Print "FRAMES ";_FR_OK;" / ";_TARGET
Print "DRAW ";_DRAW;" SWAP ";_SW;" CLOSE CALLED ";_CLOSE_CALLED
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P0J_B7_ANIM_RUNTIME_03"
   Print #1,"CANDIDATE SHA256 838245ce1ad2a4120bb2512df8b2147ae89dc6b3eebe2ba2a9f633f2e9a56403"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"FRAMES_TARGET ";_TARGET
   Print #1,"FRAMES_OK ";_FR_OK
   Print #1,"BOBS_PER_FRAME 4"
   Print #1,"DOUBLE_BUFFER ";_DB
   Print #1,"IMAGE_COUNT1 ";_COUNT1
   Print #1,"IMAGE_COUNT2 ";_COUNT2
   Print #1,"MASK_FLAG ";_MASKFLAG
   Print #1,"CLEAR_FAILS ";_CLEAR_BAD
   Print #1,"DRAW_FAILS ";_DRAW_BAD
   Print #1,"SWAP_FAILS ";_SW_BAD
   Print #1,"CLOSE_CALLED ";_CLOSE_CALLED
   Print #1,"BANKS_ERASED ";_BANKS_ERASED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
