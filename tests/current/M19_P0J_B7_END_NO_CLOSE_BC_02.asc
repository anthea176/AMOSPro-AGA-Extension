' M19 P0j-b7 - END CALLBACK WITHOUT EXPLICIT AGA SCREEN CLOSE
' TARGET: B7 102072 BYTES, MC68020+, AMOS PRO / REAL COMPILER V2
' SHA256 f69e048b9478145e9dae2c5ebbdec39736ad7df5dfa0034a201feb863078ab0b
' WINUAE AGA PAL, 68030/JIT ON. BANKS 24/25 MUST BE FREE.
' IMPORT WITH PROJECT -> MERGE ASCII INTO AN EMPTY AMOS PROGRAM.
' BEFORE_END LOG IS NOT PROOF OF END SUCCESS. VERIFY RETURN MANUALLY.
Set Buffer 20
Cls
_BANK1=24 : _BANK2=25 : _ERR=0 : _OPEN=0
_OWN1=0 : _OWN2=0 : _DB=0 : _DRAW=0 : _SW=0
_PA=0 : _PB=0 : _PC=0 : _PD=0 : _SRC1=0 : _SRC2=0 : _BG=0
_COUNT1=0 : _COUNT2=0 : _MASKFLAG=0 : _LEN1=0 : _LEN2=0
_LOGERR=0 : _CLOSEERR=0
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_B7_END_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_B7_END_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_B7_END_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_B7_END_COMPILED.TXT"
End If
Print "M19 B7 END WITHOUT AGA SCREEN CLOSE"
If Aga Detect=0
   _ERR=1 : Goto _FAIL
End If
If Length(_BANK1)<>0 or Length(_BANK2)<>0
   _ERR=2 : Goto _FAIL
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _FAIL
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _FAIL
End If
_PA=Aga Palette Set(0,0,0,0)
_PB=Aga Palette Set(1,20,32,64)
_PC=Aga Palette Set(4,255,64,48)
_PD=Aga Palette Set(5,255,228,38)
_SRC1=Aga Blit Fill(0,0,320,256,0)
If _SRC1<>1
   _ERR=5 : Goto _FAIL
End If
_SRC1=Aga Blit Fill(12,16,17,15,4)
_A=Aga Blit Fill(17,21,5,5,0)
If _SRC1<>1 or _A<>1
   _ERR=6 : Goto _FAIL
End If
Aga Bob Bank _BANK1
_LEN1=Length(_BANK1)
If _LEN1<>0
   _OWN1=1
End If
If _LEN1<>32
   _ERR=7 : Goto _FAIL
End If
Get AGA Bob 1,12,16,28,30
Make AGA Bob Mask 1,0
_COUNT1=Deek(Start(_BANK1)+8)
_MASKFLAG=Deek(Start(_BANK1)+42)
If _COUNT1<>1 or _MASKFLAG<>1
   _ERR=8 : Goto _FAIL
End If
_SRC2=Aga Blit Fill(62,16,37,8,5)
If _SRC2<>1
   _ERR=9 : Goto _FAIL
End If
Aga Bob Bank _BANK2
_LEN2=Length(_BANK2)
If _LEN2<>0
   _OWN2=1
End If
If _LEN2<>32
   _ERR=10 : Goto _FAIL
End If
Get AGA Bob 1,62,16,98,23
No AGA Bob Mask 1
_COUNT2=Deek(Start(_BANK2)+8)
If _COUNT2<>1
   _ERR=11 : Goto _FAIL
End If
_BG=Aga Blit Fill(0,0,320,256,1)
If _BG<>1
   _ERR=12 : Goto _FAIL
End If
Aga Bob Bank _BANK1
Aga Bob 1,103,72,1
Aga Bob 3,-5,170,1
Aga Bob Bank _BANK2
Aga Bob 2,180,110,1
Aga Bob 4,315,200,1
_DRAW=Aga Bob Draw
If _DRAW<>1
   _ERR=13 : Goto _FAIL
End If
For _TRY=1 To 40
   If _SW=0
      _SW=Aga Swap
   End If
   If _SW=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW<>1
   _ERR=14 : Goto _FAIL
End If
Amos To Back
For _HOLD=1 To 120
   Aga Wait Vbl
Next _HOLD
' WRITE AND CLOSE THE PRE-END JOURNAL BEFORE TRIGGERING THE CALLBACK.
' END IS THE ONLY SUCCESS EXIT. NO SCREEN CLOSE, FRONT OR ERASE HERE.
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR<>0
   _ERR=15 : Goto _FAIL
End If
Print #1,"TEST M19_P0J_B7_END_NO_CLOSE_BC_02"
Print #1,"CANDIDATE SHA256 f69e048b9478145e9dae2c5ebbdec39736ad7df5dfa0034a201feb863078ab0b"
Print #1,"RUN_MODE ";_MODE$
Print #1,"PRG_STATE ";_PRG
Print #1,"PRE_END_OK 1"
Print #1,"DRAW ";_DRAW
Print #1,"SWAP ";_SW
Print #1,"IMAGE_COUNT1 ";_COUNT1
Print #1,"IMAGE_COUNT2 ";_COUNT2
Print #1,"MASK_FLAG ";_MASKFLAG
Print #1,"SCREEN_OPEN_BEFORE_END ";_OPEN
Print #1,"EXPLICIT_SCREEN_CLOSE 0"
Print #1,"POST_END_STATUS UNOBSERVABLE_IN_PROGRAM"
Trap Close 1
_CLOSEERR=Errtrap
If _CLOSEERR<>0
   _ERR=16 : Goto _FAIL
End If
' EXPECT: END INVOKES B7 END CALLBACK AND RETURNS TO CALLER.
' A SUCCESSFUL RETURN MUST BE OBSERVED OUTSIDE THIS PROGRAM.
End
_FAIL:
' FAILURE PATH ONLY: EXPLICIT CLEANUP, NOT A VALID END TEST.
If _OPEN=1
   Aga Screen Close
   Amos To Front
End If
If _OWN1=1
   Erase _BANK1
End If
If _OWN2=1
   Erase _BANK2
End If
Print "M19 B7 END TEST NOT REACHED, ERR ";_ERR
End
