' M19 P0b MC68020: AGA BOB BANK, GET, MAKE/NO INDEPENDENT MASK.
' TEST CANDIDATE ONLY; no actual Bob drawing instruction yet.
' NO EXTERNAL FILES: generates all source pixels with Aga Blit Fill.
' Use an EMPTY AMOS program with BANK 24 FREE; WinUAE 68030/JIT ON for functional tests.
' Output: RAM:M19_P0B_68020_BOBS.ABK and RAM:M19_P0B_*.TXT.
Set Buffer 20
Cls
_BANK=24 : _ERR=0 : _RESULT=0 : _OPEN=0 : _CLOSED=0
_S1=0 : _S2=0 : _S3=0 : _S4=0 : _RELOADED=0 : _SW=0
_M1=0 : _M2=0 : _M3=0 : _M4=0 : _M5=0 : _MASK_OK=0
_FILE$="RAM:M19_P0B_68020_BOBS.ABK"
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_P0B_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_P0B_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_P0B_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_P0B_COMPILED.TXT"
End If
Print "M19 P0b MC68020 / BANK + GET + MASK"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(_BANK)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
' All rectangles are drawn on the PRIVATE AGA back buffer.
_D0=Aga Blit Fill(0,0,320,256,1)
_D1=Aga Blit Fill(13,16,17,15,255)
_D2=Aga Blit Fill(65,16,37,8,37)
_D3=Aga Blit Fill(33,16,31,16,127)
_D4=Aga Blit Fill(13,16,1,15,0)
If _D0<>1 or _D1<>1 or _D2<>1 or _D3<>1 or _D4<>1
   _ERR=5 : Goto _CLEANUP
End If
Aga Bob Bank _BANK
If Length(_BANK)<>32
   _ERR=6 : Goto _CLEANUP
End If
If Peek$(Start(_BANK),4)<>"AGBO"
   _ERR=7 : Goto _CLEANUP
End If
' Image #1: 17 x 15, stride 4, depth 8, 480 bytes.
Get AGA Bob 1,13,16,29,30
_S1=Length(_BANK)
If _S1<>552
   _ERR=8 : Goto _CLEANUP
End If
' Image #3 inserted first: 37 x 8, stride 6, 384 bytes.
Get AGA Bob 3,65,16,101,23
_S2=Length(_BANK)
If _S2<>976
   _ERR=9 : Goto _CLEANUP
End If
' Insert image #2 between #1 and #3: 31 x 16, 512 bytes.
Get AGA Bob 2,33,16,63,31
_S3=Length(_BANK)
If _S3<>1528
   _ERR=10 : Goto _CLEANUP
End If
' Replace #2 by 1 x 1 (16 bytes): preserve #1 and #3.
Get AGA Bob 2,40,20,40,20
_S4=Length(_BANK)
If _S4<>1032
   _ERR=11 : Goto _CLEANUP
End If
If Deek(Start(_BANK)+8)<>3
   _ERR=12 : Goto _CLEANUP
End If
If Leek(Start(_BANK)+20)<>_S4
   _ERR=13 : Goto _CLEANUP
End If
' Make three independent one-bit masks. Colour 0 is explicit,
' not a global rule: image #1 has one transparent pixel per row.
Make AGA Bob Mask 1,0
_M1=Length(_BANK)
If _M1<>1092
   _ERR=18 : Goto _CLEANUP
End If
If Deek(Start(_BANK)+42)<>1 or Leek(Start(_BANK)+52)<>632
   _ERR=19 : Goto _CLEANUP
End If
If Deek(Start(_BANK)+632)<>32767
   _ERR=20 : Goto _CLEANUP
End If
' Image #2 is one pixel of colour 127; the mask becomes zero.
Make AGA Bob Mask 2,127
_M2=Length(_BANK)
If _M2<>1094
   _ERR=21 : Goto _CLEANUP
End If
' Image #3 colour 37: add then remove its mask.
Make AGA Bob Mask 3,37
_M3=Length(_BANK)
If _M3<>1142
   _ERR=22 : Goto _CLEANUP
End If
No AGA Bob Mask 2
_M4=Length(_BANK)
If _M4<>1140
   _ERR=23 : Goto _CLEANUP
End If
No AGA Bob Mask 3
_M5=Length(_BANK)
If _M5<>1092
   _ERR=24 : Goto _CLEANUP
End If
If Deek(Start(_BANK)+82)<>0 or Deek(Start(_BANK)+122)<>0
   _ERR=25 : Goto _CLEANUP
End If
' Removing an absent mask is a no-op: no generation increment.
_GEN=Leek(Start(_BANK)+24)
No AGA Bob Mask 3
If Length(_BANK)<>1092 or Leek(Start(_BANK)+24)<>_GEN
   _ERR=26 : Goto _CLEANUP
End If
_MASK_OK=1
' Present source rectangles briefly; capture itself does NOT draw Bobs.
For _TRY=1 To 12
   If _SW=0
      _SW=Aga Swap
      If _SW=0
         Aga Wait Vbl
      End If
   End If
Next _TRY
If _SW<>1
   _ERR=14 : Goto _CLEANUP
End If
Amos To Back
For _FRAME=1 To 100
   Aga Wait Vbl
Next _FRAME
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   Amos To Front
   _CLOSED=1
End If
' Test native AMOS ABK Save/Load only after AGA screen is closed.
If _ERR=0
   Save _FILE$,_BANK
   Erase _BANK
   Load _FILE$,_BANK
   Aga Bob Bank _BANK
   If Length(_BANK)<>1092
      _ERR=15
   Else
      If Peek$(Start(_BANK),4)<>"AGBO"
         _ERR=16
      Else
         If Deek(Start(_BANK)+8)<>3
            _ERR=17
         Else
            If Deek(Start(_BANK)+42)<>1 or Deek(Start(_BANK)+632)<>32767
               _ERR=27
            Else
               _RELOADED=1
            End If
         End If
      End If
   End If
End If
If _ERR=0 and _CLOSED=1 and _RELOADED=1 and _MASK_OK=1
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "M19 P0b MC68020 ";_VERDICT$;" ERR ";_ERR
Print "MASKS ";_MASK_OK;" SIZES ";_M1;" ";_M2;" ";_M3;" ";_M4;" ";_M5
Print "BANK ";_BANK;" SIZE ";_S1;" ";_S2;" ";_S3;" ";_S4
Print "ABK RELOADED ";_RELOADED;" CLOSE RETURNED ";_CLOSED
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P0B_MC68020_MASK_BANK"
   Print #1,"CANDIDATE SHA256 f272a98a9d07eb66dc515fc4598b16f9fd64cb55d84c36ec29068f9f074a44d9"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"IMAGE_COUNT 3"
   Print #1,"SIZE_AFTER_1 ";_S1
   Print #1,"SIZE_AFTER_2 ";_S2
   Print #1,"SIZE_AFTER_3 ";_S3
   Print #1,"SIZE_AFTER_REPLACE ";_S4
   Print #1,"ABK_RELOADED ";_RELOADED
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
