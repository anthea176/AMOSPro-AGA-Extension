' M19 AP20 V2 ISLANDS - COMPILER/INTERPRETER GATES B/C (NOT YET TESTED).
' REQUIRES canonical dist/AMOSPro_AGA.Lib AP20 V2 ISLANDS: 96908 bytes.
' SHA256 34f4e3c13f9a079e3e586e50b054b83459bb32bd7c5d15211b55437275e6bf56
' AGA WinUAE 68030/JIT ON, AMOS Professional + actual Compiler V2.
' No external IFF/ABK; AMOS bank 24 must be free or test refuses.
' Import into EMPTY AMOS program using Project -> Merge ASCII.
' Run Runtime and separately freshly compiled AMOS executable, save both logs.
' Status counters are NOT visual pixel proof: inspect four Bobs after Swap.
Set Buffer 20
Cls
_BANK=24 : _ERR=0 : _RESULT=0 : _OPEN=0 : _CLOSED=0 : _OWN=0
_DB=0 : _B1=0 : _B2=0 : _B3=0 : _B4=0 : _NEG=0 : _SW=0
_P0=0 : _P1=0 : _P4=0 : _P5=0 : _LENGTH=0 : _COUNT=0 : _MASKFLAG=0
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_AP20_ISLANDS_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_AP20_ISLANDS_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_AP20_ISLANDS_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_AP20_ISLANDS_COMPILED.TXT"
End If
Print "M19 AP20 ISLANDS / V2 COMPILER + BOB BLIT"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(_BANK)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
Aga Bob Bank _BANK
If Length(_BANK)<>32
   _ERR=5 : Goto _CLEANUP
End If
_OWN=1
If Peek$(Start(_BANK),4)<>"AGBO"
   _ERR=6 : Goto _CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,20,32,64)
_P4=Aga Palette Set(4,255,64,48)
_P5=Aga Palette Set(5,255,228,38)
_A=Aga Blit Fill(0,0,320,256,0)
_S1=Aga Blit Fill(12,16,17,15,4)
_S2=Aga Blit Fill(17,21,5,5,0)
_S3=Aga Blit Fill(62,16,37,8,5)
If _A<>1 or _S1<>1 or _S2<>1 or _S3<>1
   _ERR=7 : Goto _CLEANUP
End If
Get AGA Bob 1,12,16,28,30
Get AGA Bob 2,62,16,98,23
_COUNT=Deek(Start(_BANK)+8)
If _COUNT<>2
   _ERR=8 : Goto _CLEANUP
End If
Make AGA Bob Mask 1,0
No AGA Bob Mask 2
_MASKFLAG=Deek(Start(_BANK)+42)
_LENGTH=Length(_BANK)
If _MASKFLAG<>1 or _LENGTH<>1036
   _ERR=9 : Goto _CLEANUP
End If
' Source pictures are now in the official AGBO AMOS bank.
' Blit #1 triggers the first PRIVATE Chip preparation and End arm.
_BG=Aga Blit Fill(0,0,320,256,1)
If _BG<>1
   _ERR=10 : Goto _CLEANUP
End If
_B1=Aga Bob Blit(1,103,72)
_B2=Aga Bob Blit(2,180,110)
_B3=Aga Bob Blit(1,-5,170)
_B4=Aga Bob Blit(2,315,200)
_NEG=Aga Bob Blit(4000,100,100)
If _B1<>1 or _B2<>1 or _B3<>1 or _B4<>1 or _NEG<>0
   _ERR=11 : Goto _CLEANUP
End If
' The Bob calls NEVER swap. Present the completed back buffer explicitly.
For _TRY=1 To 40
   If _SW=0
      _SW=Aga Swap
   End If
   If _SW=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW<>1
   _ERR=12 : Goto _CLEANUP
End If
Amos To Back
' Observe four Bobs including two clipped at the left and right edges.
For _HOLD=1 To 120
   Aga Wait Vbl
Next _HOLD
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   Amos To Front
   _OPEN=0 : _CLOSED=1
End If
If _OWN=1
   Erase _BANK
   _OWN=0
End If
If _ERR=0 and _CLOSED=1 and _SW=1 and _B1=1 and _B2=1 and _B3=1 and _B4=1 and _NEG=0
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "M19 AP20 ";_VERDICT$;" ERR ";_ERR
Print "BLITS ";_B1;" ";_B2;" ";_B3;" ";_B4;" MISS ";_NEG
Print "SWAP ";_SW;" MASK ";_MASKFLAG;" CLOSE ";_CLOSED
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_AP20_ISLANDS_01"
   Print #1,"CANDIDATE SHA256 34f4e3c13f9a079e3e586e50b054b83459bb32bd7c5d15211b55437275e6bf56"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"IMAGE_COUNT ";_COUNT
   Print #1,"BANK_LENGTH ";_LENGTH
   Print #1,"MASK_FLAG ";_MASKFLAG
   Print #1,"BLIT1 ";_B1
   Print #1,"BLIT2 ";_B2
   Print #1,"CLIP_LEFT ";_B3
   Print #1,"CLIP_RIGHT ";_B4
   Print #1,"MISSING_IMAGE ";_NEG
   Print #1,"SWAP ";_SW
   Print #1,"CLOSE ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
