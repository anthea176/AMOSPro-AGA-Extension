' M19 P2.8 R88 - AGPC independent alpha / Blitter masked vs AGAPIC RLE.
' Same pixels, v1/v2, 8 full-image parities, draw-only and full-frame FPS.
' External banks from the R88 Gate A bundle. Never install into LAST_GOOD.
Set Buffer 20
Cls
_RESULT=1 : _ERR=0 : _OPEN=0 : _CLOSED=0 : _BANKS_SAFE=0
_PARITY_OK=0 : _PARITY_BAD=0 : _REJECT=0 : _MICRO_RUNS=0
_FRAME_RUNS=0 : _SWAPS=0 : _FRAME_COUNT=0 : _SWAP_RETRY=0
_FILL_RETRY=0 : _RLE_CALLS=0 : _CACHE_CALLS=0
_REPS=64 : _FRAMES=24
Dim _OX(16),_OY(16),_RLEBANK(16),_CACHEBANK(16)
Dim _MICRO(2,1,1),_FRAMETIME(2,1,1)
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:M19_P28_UNKNOWN.TXT"
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_P28_RUNTIME.TXT"
End If
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_P28_INTERPRETED.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_P28_COMPILED.TXT"
End If
Print "M19 P2.8 R88 AGPC MASKED BLITTER"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
For _B=10 To 15
   If Length(_B)<>0
      _ERR=2 : Goto _CLEANUP
   End If
Next _B
_BANKS_SAFE=1
' Load the exactly matching source and AGPC snapshot banks from the bundle.
Load "AGAPIC_P28_V1_BANK10.abk",10
Load "AGPC_P28_V1_BANK11.abk",11
Load "AGAPIC_P28_V2_BANK12.abk",12
Load "AGPC_P28_V2_BANK13.abk",13
For _B=10 To 13
   If Length(_B)=0
      _ERR=3 : Goto _CLEANUP
   End If
Next _B
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto _CLEANUP
End If
If Aga Double Buffer<>1
   _ERR=5 : Goto _CLEANUP
End If
For _I=1 To 16
   _OX(_I)=20+((_I-1) Mod 4)*44
   _OY(_I)=20+Int((_I-1)/4)*44
   _RLEBANK(_I)=10 : _CACHEBANK(_I)=11
   If (_I Mod 2)=0
      _RLEBANK(_I)=12 : _CACHEBANK(_I)=13
   End If
Next _I
' Invalid calls must reject without presenting an incomplete back buffer.
_D=Aga Cache Blit(11,20,20,2)
If _D<>0
   _ERR=6 : Goto _CLEANUP
End If
_REJECT=_REJECT+1
_D=Aga Cache Blit(20,20,20,1)
If _D<>0
   _ERR=7 : Goto _CLEANUP
End If
_REJECT=_REJECT+1
' Compare 8 complete 32x32 AGAPIC captures against the same source pixels.
For _CASE=1 To 8
   _RLE=10 : _CACHE=11 : _DMODE=0
   _X=32 : _Y=40 : _RX=24 : _RY=32
   If (_CASE Mod 2)=0
      _RLE=12 : _CACHE=13
   End If
   If _CASE>=3
      _DMODE=1
   End If
   If _CASE=2 or _CASE=4
      _X=33
   End If
   If _CASE=5
      _X=-3 : _RX=0
   End If
   If _CASE=6
      _X=312 : _Y=244 : _RX=288 : _RY=224
   End If
   If _CASE=7
      _Y=-3 : _RY=0
   End If
   If _CASE=8
      _Y=252 : _RY=224
   End If
   _D=Aga Blit Fill(0,0,320,256,1)
   If _D<>1
      _ERR=8 : Goto _CLEANUP
   End If
   _D=Aga Bank Image Draw(_RLE,_X,_Y,_DMODE)
   If _D<>1
      _ERR=9 : Goto _CLEANUP
   End If
   _D=Aga Bank Image Capture(14,_RX,_RY,32,32,-1,1)
   If _D<>1
      _ERR=10 : Goto _CLEANUP
   End If
   _D=Aga Blit Fill(0,0,320,256,1)
   If _D<>1
      _ERR=11 : Goto _CLEANUP
   End If
   _D=Aga Cache Blit(_CACHE,_X,_Y,_DMODE)
   If _D<>1
      _ERR=12 : Goto _CLEANUP
   End If
   _D=Aga Bank Image Capture(15,_RX,_RY,32,32,-1,1)
   If _D<>1
      _ERR=13 : Goto _CLEANUP
   End If
   _DIFFER=0
   If Length(14)<>Length(15)
      _DIFFER=1
   Else
      _L=Length(14)
      If _L<1
         _DIFFER=1
      Else
         For _J=1 To _L
            If Peek(Start(14)+_J-1)<>Peek(Start(15)+_J-1)
               _DIFFER=1
            End If
         Next _J
      End If
   End If
   Erase 14 : Erase 15
   If _DIFFER<>0
      _PARITY_BAD=_PARITY_BAD+1
      _ERR=14 : Goto _CLEANUP
   End If
   _PARITY_OK=_PARITY_OK+1
Next _CASE
' Warmup after correctness has already been established.
_D=Aga Bank Image Draw(10,20,20,1)
If _D<>1
   _ERR=15 : Goto _CLEANUP
End If
_D=Aga Cache Blit(11,20,20,1)
If _D<>1
   _ERR=16 : Goto _CLEANUP
End If
' 64 repeated draws, AB then BA. Fill is outside every timed series.
For _PASS=0 To 1
   For _CASE=0 To 2
      _N=4
      If _CASE=1
         _N=8
      End If
      If _CASE=2
         _N=16
      End If
      For _ORDER=0 To 1
         _METHOD=_ORDER
         If _PASS=1
            _METHOD=1-_ORDER
         End If
         _D=Aga Blit Fill(0,0,320,256,1)
         If _D<>1
            _ERR=17 : Goto _CLEANUP
         End If
         _T0=Timer
         For _REP=1 To _REPS
            For _I=1 To _N
               If _METHOD=0
                  _D=Aga Bank Image Draw(_RLEBANK(_I),_OX(_I),_OY(_I),1)
               Else
                  _D=Aga Cache Blit(_CACHEBANK(_I),_OX(_I),_OY(_I),1)
               End If
               If _D<>1
                  _ERR=18 : Goto _CLEANUP
               End If
            Next _I
         Next _REP
         _MICRO(_CASE,_METHOD,_PASS)=Timer-_T0
         If _METHOD=0
            _RLE_CALLS=_RLE_CALLS+_N*_REPS
         Else
            _CACHE_CALLS=_CACHE_CALLS+_N*_REPS
         End If
         _MICRO_RUNS=_MICRO_RUNS+1
      Next _ORDER
   Next _CASE
Next _PASS
If _MICRO_RUNS<>12 or _RLE_CALLS<>3584 or _CACHE_CALLS<>3584
   _ERR=19 : Goto _CLEANUP
End If
' Full-frame measurement INCLUDING VBL, clear, draw and Swap.
Amos To Back
For _PASS=0 To 1
   For _CASE=0 To 2
      _N=4
      If _CASE=1
         _N=8
      End If
      If _CASE=2
         _N=16
      End If
      For _ORDER=0 To 1
         _METHOD=_ORDER
         If _PASS=1
            _METHOD=1-_ORDER
         End If
         _T0=Timer
         For _FRAME=1 To _FRAMES
            Aga Wait Vbl
            _BG=0
            For _TRY=1 To 12
               If _BG=0
                  _BG=Aga Blit Fill(0,0,320,256,1)
               End If
               If _BG=0
                  _FILL_RETRY=_FILL_RETRY+1
                  Aga Wait Vbl
               End If
            Next _TRY
            If _BG<>1
               _ERR=20 : Goto _CLEANUP
            End If
            For _I=1 To _N
               If _METHOD=0
                  _D=Aga Bank Image Draw(_RLEBANK(_I),_OX(_I),_OY(_I),1)
               Else
                  _D=Aga Cache Blit(_CACHEBANK(_I),_OX(_I),_OY(_I),1)
               End If
               If _D<>1
                  _ERR=21 : Goto _CLEANUP
               End If
            Next _I
            _SW=0
            For _TRY=1 To 12
               If _SW=0
                  _SW=Aga Swap
               End If
               If _SW=0
                  _SWAP_RETRY=_SWAP_RETRY+1
                  Aga Wait Vbl
               End If
            Next _TRY
            If _SW<>1
               _ERR=22 : Goto _CLEANUP
            End If
            _SWAPS=_SWAPS+1
            _FRAME_COUNT=_FRAME_COUNT+1
         Next _FRAME
         _FRAMETIME(_CASE,_METHOD,_PASS)=Timer-_T0
         _FRAME_RUNS=_FRAME_RUNS+1
      Next _ORDER
   Next _CASE
Next _PASS
If _FRAME_RUNS<>12 or _FRAME_COUNT<>288 or _SWAPS<>288
   _ERR=23 : Goto _CLEANUP
End If
If _PARITY_OK<>8 or _PARITY_BAD<>0 or _REJECT<>2
   _ERR=24 : Goto _CLEANUP
End If
Goto _CLEANUP

_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _BANKS_SAFE=1
   For _B=10 To 15
      If Length(_B)<>0
         Erase _B
      End If
   Next _B
End If
If _ERR<>0 or _CLOSED<>1
   _RESULT=0
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "M19 P2.8 R88 ";_VERDICT$;" ERR ";_ERR
Print "PARITY ";_PARITY_OK;"/8  FRAMES ";_FRAME_COUNT
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19_P28_R88_CACHE_BLIT_FPS_01"
   Print #1,"LIBRARY_EXPECTED R88_V0.13.33"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"PARITY_OK ";_PARITY_OK
   Print #1,"PARITY_BAD ";_PARITY_BAD
   Print #1,"REJECT ";_REJECT
   Print #1,"REPS ";_REPS
   Print #1,"MICRO_RUNS ";_MICRO_RUNS
   Print #1,"RLE_CALLS ";_RLE_CALLS
   Print #1,"CACHE_CALLS ";_CACHE_CALLS
   For _CASE=0 To 2
      _N=4
      If _CASE=1
         _N=8
      End If
      If _CASE=2
         _N=16
      End If
      _RT=_MICRO(_CASE,0,0)+_MICRO(_CASE,0,1)
      _CT=_MICRO(_CASE,1,0)+_MICRO(_CASE,1,1)
      Print #1,"DRAW_BOBS ";_N;" RLE_TICKS ";_RT;" CACHE_TICKS ";_CT
      Print #1,"DRAW_PASS0 ";_N;" RLE ";_MICRO(_CASE,0,0);" CACHE ";_MICRO(_CASE,1,0)
      Print #1,"DRAW_PASS1 ";_N;" RLE ";_MICRO(_CASE,0,1);" CACHE ";_MICRO(_CASE,1,1)
   Next _CASE
   Print #1,"FRAME_RUNS ";_FRAME_RUNS
   Print #1,"FRAMES_PER_RUN ";_FRAMES
   Print #1,"FRAMES_TOTAL ";_FRAME_COUNT
   Print #1,"SWAPS ";_SWAPS
   Print #1,"FILL_RETRIES ";_FILL_RETRY
   Print #1,"SWAP_RETRIES ";_SWAP_RETRY
   For _CASE=0 To 2
      _N=4
      If _CASE=1
         _N=8
      End If
      If _CASE=2
         _N=16
      End If
      _RT=_FRAMETIME(_CASE,0,0)+_FRAMETIME(_CASE,0,1)
      _CT=_FRAMETIME(_CASE,1,0)+_FRAMETIME(_CASE,1,1)
      Print #1,"FRAME_BOBS ";_N;" RLE_TICKS ";_RT;" CACHE_TICKS ";_CT
      Print #1,"FRAME_PASS0 ";_N;" RLE ";_FRAMETIME(_CASE,0,0);" CACHE ";_FRAMETIME(_CASE,1,0)
      Print #1,"FRAME_PASS1 ";_N;" RLE ";_FRAMETIME(_CASE,0,1);" CACHE ";_FRAMETIME(_CASE,1,1)
   Next _CASE
   Print #1,"CHIP_BEFORE ";_CHIP0
   Print #1,"CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0
   Print #1,"FAST_AFTER ";_FAST1
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
