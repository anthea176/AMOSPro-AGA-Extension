' M18/R67 FICON8 DIRECT AGA BACK BUFFER CAPTURE.
' WINUAE INTERPRETED ONLY - NO AMOS COMPILER UNTIL FINAL M18.
' Banks 11,12,13 must be FREE. Reserve As Data 13,256 may overwrite.
' RAM:M18_R67_FICON8.ABK is written/overwritten.
Cls
Print "M18-R67-FICON8-CAPTURE-01"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_C0=Aga F Icon Bank Create(12,4)
_C1=Aga F Chip Bank Create(11,4)
If _C0<>1 or _C1<>1
   Print "BANKS 11/12 OCCUPIED OR NO CHIP"
   End
End If
Reserve As Data 13,256
For _Y=0 To 15
   For _X=0 To 15
      _COL=0
      If _X=_Y
         _COL=4
      End If
      If _X=15-_Y
         _COL=5
      End If
      If _X=0 Or _X=15 Or _Y=0 Or _Y=15
         _COL=255
      End If
      Poke Start(13)+_Y*16+_X,_COL
   Next _X
Next _Y
_PUT=Aga F Icon Bank Put(12,1,13,0)
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   Erase 11 : Erase 12 : Erase 13
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 11 : Erase 12 : Erase 13
   End
End If
_K0=Aga Palette Set(0,0,0,0)
_K2=Aga Palette Set(2,32,48,96)
_K4=Aga Palette Set(4,255,0,0)
_K5=Aga Palette Set(5,0,255,0)
_K255=Aga Palette Set(255,255,255,255)
_SW0=0
For _TRY=1 To 20
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
' Draw in OPAQUE mode. Colour-zero pixels are REAL screen index 0.
_SRC1=0
For _TRY=1 To 40
   If _SRC1=0
      _SRC1=Aga F Icon(12,1,31,44,0)
   End If
   If _SRC1=0
      Aga Wait Vbl
   End If
Next _TRY
_CMEM0=Chip Free : _FMEM0=Fast Free
_CAP2=Aga F Icon Capture(12,2,31,44)
_SRC2=Aga F Icon(12,1,16,80,0)
_CAP3=Aga F Icon Capture(12,3,16,80)
_CMEM1=Chip Free : _FMEM1=Fast Free
_EQ2=1 : _EQ3=1
For _I=0 To 287
   If Peek(Start(12)+12+_I)<>Peek(Start(12)+12+288+_I)
      _EQ2=0
   End If
   If Peek(Start(12)+12+_I)<>Peek(Start(12)+12+576+_I)
      _EQ3=0
   End If
Next _I
_BADX=Aga F Icon Capture(12,2,305,44)
_BADY=Aga F Icon Capture(12,2,31,241)
_BADNEG=Aga F Icon Capture(12,2,-1,44)
_BADID=Aga F Icon Capture(12,5,31,44)
_BADBANK=Aga F Icon Capture(4,2,31,44)
_BAD0=Aga F Icon Capture(12,0,31,44)
' Save POPULATED FICON8, erase, reload, compare again.
_SAVE_LEN=Length(12)
Save "RAM:M18_R67_FICON8.ABK",12
Erase 12
Load "RAM:M18_R67_FICON8.ABK",12
_LOAD_LEN=Length(12)
_LOAD_EQ2=1 : _LOAD_EQ3=1
For _I=0 To 287
   If Peek(Start(12)+12+_I)<>Peek(Start(12)+12+288+_I)
      _LOAD_EQ2=0
   End If
   If Peek(Start(12)+12+_I)<>Peek(Start(12)+12+576+_I)
      _LOAD_EQ3=0
   End If
Next _I
_STAGE2=Aga F Chip Stage(12,11,2)
_STAGE3=Aga F Chip Stage(12,11,3)
_READY2=Peek(Start(11)+12+4*288+1)
_READY3=Peek(Start(11)+12+4*288+2)
_READY4=Peek(Start(11)+12+4*288+3)
_READY=0
For _TRY=1 To 40
   If _READY=0
      _READY=Aga Blit Fill(0,0,320,256,2)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
_OPAQUE=0 : _BLIT=0 : _CPU=0 : _UNREADY=0
If _READY=1
   _OPAQUE=Aga F Blit(11,3,150,120,0)
   _BLIT=Aga F Blit(11,2,90,120,1)
   _CPU=Aga F Icon(12,2,30,120,1)
   _UNREADY=Aga F Blit(11,4,210,120,1)
End If
_SW1=0
For _TRY=1 To 20
   If _SW1=0
      _SW1=Aga Swap
   End If
   If _SW1=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW1=1
   Amos To Back
End If
' VISUAL: 3 white frames with red/green diagonals.
' X30 CPU transparent, X90 Blitter transparent = blue interior.
' X150 Blitter opaque = black interior; X210 must remain blue.
For _HOLD=1 To 125
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
_NOS=Aga F Icon Capture(12,2,31,44)
Erase 13
Erase 12
Erase 11
_CFEND=Chip Free : _FFEND=Fast Free
_RESULT=1
If _C0<>1 or _C1<>1 or _PUT<>1 or _OPEN<>1 or _DB<>1 or _SW0<>1
   _RESULT=0
End If
If _SRC1<>1 or _SRC2<>1 or _CAP2<>1 or _CAP3<>1
   _RESULT=0
End If
If _EQ2<>1 or _EQ3<>1 or _LOAD_EQ2<>1 or _LOAD_EQ3<>1
   _RESULT=0
End If
If _CMEM0<>_CMEM1 or _FMEM0<>_FMEM1
   _RESULT=0
End If
If _BADX<>0 or _BADY<>0 or _BADNEG<>0 or _BADID<>0 or _BADBANK<>0 or _BAD0<>0
   _RESULT=0
End If
If _SAVE_LEN<>1164 or _LOAD_LEN<>1164 or _STAGE2<>1 or _STAGE3<>1
   _RESULT=0
End If
If _READY2<>1 or _READY3<>1 or _READY4<>0
   _RESULT=0
End If
If _K0<>1 or _K2<>1 or _K4<>1 or _K5<>1 or _K255<>1
   _RESULT=0
End If
If _READY<>1 or _OPAQUE<>1 or _BLIT<>1 or _CPU<>1 or _UNREADY<>0 or _SW1<>1
   _RESULT=0
End If
If _NOS<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "M18-R67-FICON8-CAPTURE-01"
Print "BANK FICON/CHIP ";_C0;" ";_C1;" PUT ";_PUT
Print "OPEN/DB/SWAPS ";_OPEN;" ";_DB;" ";_SW0;" ";_SW1
Print "DRAW SOURCE NONALIGN/ALIGN ";_SRC1;" ";_SRC2
Print "CAPTURE NONALIGN/ALIGN ";_CAP2;" ";_CAP3
Print "PIXELS 288 BYTE EQ2/EQ3 ";_EQ2;" ";_EQ3
Print "BAD X/Y/NEG/ID/BANK/0 ";_BADX;" ";_BADY;" ";_BADNEG;" ";_BADID;" ";_BADBANK;" ";_BAD0
Print "CHIP BEFORE/AFTER CAPTURE ";_CMEM0;" ";_CMEM1
Print "FAST BEFORE/AFTER CAPTURE ";_FMEM0;" ";_FMEM1
Print "ABK SAVE/LOAD LEN ";_SAVE_LEN;" ";_LOAD_LEN
Print "ABK RELOADED EQ2/EQ3 ";_LOAD_EQ2;" ";_LOAD_EQ3
Print "STAGE2/3 READY2/3/4 ";_STAGE2;" ";_STAGE3;" ";_READY2;" ";_READY3;" ";_READY4
Print "CPU/MASKED/OPAQUE/UNREADY ";_CPU;" ";_BLIT;" ";_OPAQUE;" ";_UNREADY
Print "NOS/CLOSE ";_NOS;" ";_CLOSED
Print "CHIP/FAST AFTER RAM FILE ";_CFEND;" ";_FFEND
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
Do
   Wait Vbl
Loop
