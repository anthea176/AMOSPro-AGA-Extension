' M13-R36-PALETTE-CYCLE-01 - WinUAE Gate B (after Gate A only).
' Requires R36 0.10.8 candidate, installed in same APSystem slot.
' Single call = one exact RGB32 rotation, NO implicit VBL.
' No AMOS banks, ABK/IFF files or external assets are touched.
Cls
Print "M13-R36-PALETTE-CYCLE-01"
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_CLR=Aga Blit Clear(0,0,320,256)
_B0=Aga Blit Fill(12,30,68,170,28)
_B1=Aga Blit Fill(86,30,68,170,29)
_B2=Aga Blit Fill(160,30,68,170,30)
_B3=Aga Blit Fill(234,30,68,170,31)
_P0=Aga Palette Set(28,255,0,0)
_P1=Aga Palette Set(29,0,255,0)
_P2=Aga Palette Set(30,0,0,255)
_P3=Aga Palette Set(31,255,255,0)
_ORIG0=Aga Palette Get(28)
_ORIG3=Aga Palette Get(31)
_SWAP=Aga Swap
If _SWAP<>1
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED"
   End
End If
Amos To Back
For _I=1 To 50
   Aga Wait Vbl
Next _I
' Twenty rotations, one every 8 VBL: visible movement for 160 VBL.
_CYCOK=1
For _I=1 To 20
   _T=Aga Palette Cycle(28,31,1)
   If _T<>1
      _CYCOK=0
   End If
   For _J=1 To 8
      Aga Wait Vbl
   Next _J
Next _I
' 20 rotations of 4 colours restore the original palette.
_BACK0=Aga Palette Get(28)
_BACK3=Aga Palette Get(31)
_FWD=Aga Palette Cycle(28,31,1)
_F0=Aga Palette Get(28)
_F1=Aga Palette Get(29)
_F2=Aga Palette Get(30)
_F3=Aga Palette Get(31)
_REV=Aga Palette Cycle(28,31,-1)
_R0=Aga Palette Get(28)
_R3=Aga Palette Get(31)
' Reverse cycle once (different result), then reverse it.
_NEG=Aga Palette Cycle(28,31,-1)
_N0=Aga Palette Get(28)
_N3=Aga Palette Get(31)
_POS=Aga Palette Cycle(28,31,1)
_RESET0=Aga Palette Get(28)
_RESET3=Aga Palette Get(31)
' Invalid arguments must have no effect.
_BADFIRST=Aga Palette Cycle(-1,31,1)
_BADEQ=Aga Palette Cycle(28,28,1)
_BADORDER=Aga Palette Cycle(31,28,1)
_BADLAST=Aga Palette Cycle(28,256,1)
_BADDIR0=Aga Palette Cycle(28,31,0)
_BADDIR2=Aga Palette Cycle(28,31,2)
_BADDIRN=Aga Palette Cycle(28,31,-2)
_AFTERBAD=Aga Palette Get(28)
For _I=1 To 45
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Palette Cycle(28,31,1)
_CLOSED=Aga Mouse X
_RESULT=1
If _OPEN<>1 or _DB<>1 or _CLR<>1 or _SWAP<>1
   _RESULT=0
End If
If _B0<>1 or _B1<>1 or _B2<>1 or _B3<>1
   _RESULT=0
End If
If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
   _RESULT=0
End If
If _ORIG0<>16711680 or _ORIG3<>16776960
   _RESULT=0
End If
If _CYCOK<>1 or _BACK0<>16711680 or _BACK3<>16776960
   _RESULT=0
End If
If _FWD<>1 or _F0<>16776960 or _F1<>16711680
   _RESULT=0
End If
If _F2<>65280 or _F3<>255
   _RESULT=0
End If
If _REV<>1 or _R0<>16711680 or _R3<>16776960
   _RESULT=0
End If
If _NEG<>1 or _N0<>65280 or _N3<>16711680
   _RESULT=0
End If
If _POS<>1 or _RESET0<>16711680 or _RESET3<>16776960
   _RESULT=0
End If
If _BADFIRST<>0 or _BADEQ<>0 or _BADORDER<>0 or _BADLAST<>0
   _RESULT=0
End If
If _BADDIR0<>0 or _BADDIR2<>0 or _BADDIRN<>0
   _RESULT=0
End If
If _AFTERBAD<>16711680 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Print "M13-R36-PALETTE-CYCLE-01"
Print "OPEN ";_OPEN;" DB ";_DB;" DRAW ";_B0;" ";_B1;" ";_B2;" ";_B3
Print "CYC20 ";_CYCOK;" RESTORED ";_BACK0;" ";_BACK3
Print "FWD ";_FWD;" COLOR ";_F0;" ";_F1;" ";_F2;" ";_F3
Print "REV ";_REV;" RESTORE ";_R0;" ";_R3
Print "NEG ";_NEG;" COLOR ";_N0;" ";_N3;" POS ";_POS
Print "RESET ";_RESET0;" ";_RESET3
Print "BADFIRST ";_BADFIRST;" BADEQ ";_BADEQ;" BADORDER ";_BADORDER
Print "BADLAST ";_BADLAST;" DIR0 ";_BADDIR0;" DIR2 ";_BADDIR2;" DIRN ";_BADDIRN
Print "AFTERBAD ";_AFTERBAD;" NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
