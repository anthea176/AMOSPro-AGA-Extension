' T06B P2d-L2b: Pattern immediately after successful Swap.
' No pre-Pattern VBL or Safe-acquiring writer/capture. Bank 27 free.
' Twelve rounds, alternating physical pages. No external resources.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:T06B_SAFE_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:T06B_SAFE_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:T06B_SAFE_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:T06B_SAFE_COMPILED.TXT"
End If
_ERR=0 : _OK=0 : _OPEN=0 : _OWN=0 : _CLOSED=-99 : _CLOSE_RETURNED=0
_ROUNDS=12 : _VALID=0 : _ROUND_LAST=0 : _PATTERN_CALLS=0 : _BACK_OK=0 : _FRONT_OK=0
_SWAPS=0 : _SWAP_REFUSALS=0 : _SWAP_RECOVERED=0 : _FILL_RETRIES=0 : _CAP_RETRIES=0
_B0=-1 : _B1=-1 : _B2=-1 : _F0=-1 : _F1=-1 : _F2=-1
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(27)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OWN=1
Print "T06B PATTERN AFTER SWAP - 12 ROUNDS"
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
Amos To Back
For _ROUND=1 To _ROUNDS
   If _ERR=0
      _ROUND_LAST=_ROUND
      Gosub _ROUND_TEST
   End If
Next _ROUND
If _ERR=0 and _VALID=_ROUNDS and _PATTERN_CALLS=_ROUNDS and _SWAPS=3*_ROUNDS
   _OK=1
End If
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
   _CLOSED=Aga Mouse X
   If _CLOSED<>-1
      _OK=0
      If _ERR=0
         _ERR=60
      End If
   End If
End If
If _OWN=1
   If _OPEN<>1 or _CLOSED=-1
      If Length(27)<>0
         Erase 27
      End If
   End If
End If
_VERDICT$="FAIL"
If _OK=1 and _ERR=0 and _CLOSED=-1 and _SWAP_REFUSALS=_SWAP_RECOVERED
   _VERDICT$="PASS"
End If
Print "T06B ";_VERDICT$;" ERR ";_ERR;" ROUNDS ";_VALID;"/";_ROUNDS
Print "BACK ";_B0;" ";_B1;" ";_B2;" FRONT ";_F0;" ";_F1;" ";_F2
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST T06B PATTERN SAFE"
   Print #1,"SOURCE_TAG T06B_PATTERN_SAFE_20261124"
   Print #1,"LIB_EXPECTED P2d-L2b"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"ROUNDS_EXPECTED ";_ROUNDS
   Print #1,"ROUND_LAST ";_ROUND_LAST
   Print #1,"VALID_ROUNDS ";_VALID
   Print #1,"PATTERN_CALLS ";_PATTERN_CALLS
   Print #1,"PRE_PATTERN_VBLS 0"
   Print #1,"BACK_OK ";_BACK_OK
   Print #1,"FRONT_OK ";_FRONT_OK
   Print #1,"BACK_Y64 ";_B0
   Print #1,"BACK_Y128 ";_B1
   Print #1,"BACK_Y192 ";_B2
   Print #1,"FRONT_Y64 ";_F0
   Print #1,"FRONT_Y128 ";_F1
   Print #1,"FRONT_Y192 ";_F2
   Print #1,"SWAPS ";_SWAPS
   Print #1,"SWAP_REFUSALS ";_SWAP_REFUSALS
   Print #1,"SWAP_RECOVERED ";_SWAP_RECOVERED
   Print #1,"FILL_RETRIES ";_FILL_RETRIES
   Print #1,"CAP_RETRIES ";_CAP_RETRIES
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"CLOSED_MOUSE_X ";_CLOSED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
_ROUND_TEST:
_B0=-1 : _B1=-1 : _B2=-1 : _F0=-1 : _F1=-1 : _F2=-1
_PEN=17 : Gosub _FILL
If _A<>1
   _ERR=10 : Return
End If
Gosub _SAMPLE
If _CAPOK<>1 or _P0<>17 or _P1<>17 or _P2<>17
   _ERR=11 : Return
End If
Gosub _SWAP
If _SW<>1
   _ERR=12 : Return
End If
_PEN=239 : Gosub _FILL
If _A<>1
   _ERR=13 : Return
End If
Gosub _SAMPLE
If _CAPOK<>1 or _P0<>239 or _P1<>239 or _P2<>239
   _ERR=14 : Return
End If
Gosub _SWAP
If _SW<>1
   _ERR=15 : Return
End If
' Successful Swap -> Pattern: no VBL, capture, fill or other AGA call.
Aga Screen Pattern
_PATTERN_CALLS=_PATTERN_CALLS+1
Gosub _SAMPLE
_B0=_P0 : _B1=_P1 : _B2=_P2
If _CAPOK<>1
   _ERR=30 : Return
End If
If _B0<>64 or _B1<>128 or _B2<>192
   _ERR=31 : Return
End If
_BACK_OK=_BACK_OK+1
' Read the formerly displayed page only after valid back pixels.
Gosub _SWAP
If _SW<>1
   _ERR=40 : Return
End If
Gosub _SAMPLE
_F0=_P0 : _F1=_P1 : _F2=_P2
If _CAPOK<>1
   _ERR=41 : Return
End If
If _F0<>239 or _F1<>239 or _F2<>239
   _ERR=42 : Return
End If
_FRONT_OK=_FRONT_OK+1 : _VALID=_VALID+1
Return
_FILL:
_A=Aga Blit Fill(0,0,320,256,_PEN)
For _TRY=1 To 4
   If _A<>1
      Aga Wait Vbl
      _FILL_RETRIES=_FILL_RETRIES+1
      _A=Aga Blit Fill(0,0,320,256,_PEN)
   End If
Next _TRY
Return
_SWAP:
_SW=Aga Swap
If _SW<>1
   _SWAP_REFUSALS=_SWAP_REFUSALS+1
   For _TRY=1 To 4
      If _SW<>1
         Aga Wait Vbl
         _SW=Aga Swap
      End If
   Next _TRY
   If _SW=1
      _SWAP_RECOVERED=_SWAP_RECOVERED+1
   End If
End If
If _SW=1
   _SWAPS=_SWAPS+1
End If
Return
_SAMPLE:
_P0=-1 : _P1=-1 : _P2=-1
_Y=64 : Gosub _READ_PIXEL
If _CAPOK<>1
   Return
End If
_P0=_VALUE
_Y=128 : Gosub _READ_PIXEL
If _CAPOK<>1
   Return
End If
_P1=_VALUE
_Y=192 : Gosub _READ_PIXEL
If _CAPOK<>1
   Return
End If
_P2=_VALUE
Return
_READ_PIXEL:
_CAPOK=0 : _VALUE=-1
_CAP=Aga C Block Capture(27,160,_Y,8,1,0)
For _TRY=1 To 4
   If _CAP<>1
      Aga Wait Vbl
      _CAP_RETRIES=_CAP_RETRIES+1
      _CAP=Aga C Block Capture(27,160,_Y,8,1,0)
   End If
Next _TRY
If _CAP=1 and Length(27)=56
   _CAPOK=1 : _PTR=Start(27)+40 : _VALUE=0 : _POWER=1
   For _PLANE=0 To 7
      If (Peek(_PTR+2*_PLANE) and 128)<>0
         _VALUE=_VALUE+_POWER
      End If
      _POWER=_POWER*2
   Next _PLANE
End If
Return
