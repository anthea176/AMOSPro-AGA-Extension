' L3 T14A P2d-L2b - repeated screen and cursor cleanup.
' Warm up single/DB once, then measure 12 identical pairs.
' No banks, external resources, Bobs, Copper or C2P.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:T14_CLOSE_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:T14_CLOSE_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:T14_CLOSE_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:T14_CLOSE_COMPILED.TXT"
End If
Dim _CHIP(12),_FAST(12)
_ERR=0 : _OK=0 : _MEM_STABLE=0 : _OPEN=0 : _CLOSED=-99
_PAIR=0 : _PAIR_LAST=0 : _PAIRS_OK=0 : _CYCLES=0 : _DB_MODE=0
_SINGLE_OK=0 : _DB_OK=0 : _CLOSE_RETURNED=0 : _SWAPS=0
_SWAP_REFUSALS=0 : _SWAP_RECOVERED=0 : _FILL_RETRIES=0
_CURSOR_OK=0 : _CUR=0 : _DB=0 : _SW=0 : _FILL=0 : _TRY=0
_CHIP0=0 : _FAST0=0 : _CHIP1=0 : _FAST1=0 : _CHIP_LOSS=0 : _FAST_LOSS=0
_DIFF_PAIRS=0 : _I=0 : _IO=0 : _VERDICT$="FAIL"
If Aga Detect=0
   _ERR=1 : Goto _REPORT
End If
Print "T14A OPEN CLOSE - WARMUP + 12 PAIRS"
For _PAIR=0 To 12
   If _ERR=0
      _PAIR_LAST=_PAIR
      _DB_MODE=0 : Gosub _CYCLE
      If _ERR=0
         _DB_MODE=1 : Gosub _CYCLE
      End If
      If _ERR=0
         _CHIP(_PAIR)=Chip Free : _FAST(_PAIR)=Fast Free
         If _PAIR=0
            _CHIP0=_CHIP(0) : _FAST0=_FAST(0)
         Else
            _PAIRS_OK=_PAIRS_OK+1
            If _CHIP(_PAIR)<>_CHIP0 or _FAST(_PAIR)<>_FAST0
               _DIFF_PAIRS=_DIFF_PAIRS+1
            End If
         End If
      End If
   End If
Next _PAIR
If _ERR=0 and _PAIRS_OK=12 and _SINGLE_OK=13 and _DB_OK=13 and _CLOSE_RETURNED=26 and _SWAPS=13 and _CURSOR_OK=104
   _OK=1
   _CHIP1=_CHIP(12) : _FAST1=_FAST(12)
   _CHIP_LOSS=_CHIP0-_CHIP1 : _FAST_LOSS=_FAST0-_FAST1
   _VERDICT$="REVIEW"
   If _DIFF_PAIRS=0
      _MEM_STABLE=1 : _VERDICT$="PASS"
   End If
End If
_REPORT:
Print "T14A ";_VERDICT$;" ERR ";_ERR;" PAIRS ";_PAIRS_OK;"/12"
Print "CHIP LOSS ";_CHIP_LOSS;" FAST LOSS ";_FAST_LOSS
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST T14A CLOSE MEMORY"
   Print #1,"SOURCE_TAG T14A_CLOSE_MEMORY_20261124"
   Print #1,"LIB_EXPECTED P2d-L2b"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"PAIR_LAST ";_PAIR_LAST
   Print #1,"PAIRS_OK ";_PAIRS_OK
   Print #1,"CYCLES ";_CYCLES
   Print #1,"SINGLE_OK ";_SINGLE_OK
   Print #1,"DB_OK ";_DB_OK
   Print #1,"CURSOR_OK ";_CURSOR_OK
   Print #1,"SWAPS ";_SWAPS
   Print #1,"SWAP_REFUSALS ";_SWAP_REFUSALS
   Print #1,"SWAP_RECOVERED ";_SWAP_RECOVERED
   Print #1,"FILL_RETRIES ";_FILL_RETRIES
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"CLOSED_MOUSE_X ";_CLOSED
   Print #1,"CHIP_BASELINE ";_CHIP0
   Print #1,"FAST_BASELINE ";_FAST0
   Print #1,"CHIP_FINAL ";_CHIP1
   Print #1,"FAST_FINAL ";_FAST1
   Print #1,"CHIP_LOSS ";_CHIP_LOSS
   Print #1,"FAST_LOSS ";_FAST_LOSS
   Print #1,"DIFF_PAIRS ";_DIFF_PAIRS
   Print #1,"MEM_STABLE ";_MEM_STABLE
   For _I=0 To 12
      Print #1,"PAIR ";_I;" CHIP ";_CHIP(_I);" FAST ";_FAST(_I)
   Next _I
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
_CYCLE:
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=10 : Return
End If
If _DB_MODE=1
   _DB=Aga Double Buffer
   If _DB<>1
      _ERR=11 : Gosub _CLOSE : Return
   End If
End If
Aga Screen Pattern
Amos To Back
_CUR=Aga Mouse Cursor(0)
If _CUR<>1
   _ERR=12 : Gosub _CLOSE : Return
End If
_CURSOR_OK=_CURSOR_OK+1
_CUR=Aga Mouse Cursor(0)
If _CUR<>1
   _ERR=13 : Gosub _CLOSE : Return
End If
_CURSOR_OK=_CURSOR_OK+1
_CUR=Aga Mouse Cursor(1)
If _CUR<>1
   _ERR=14 : Gosub _CLOSE : Return
End If
_CURSOR_OK=_CURSOR_OK+1
_CUR=Aga Mouse Cursor(0)
If _CUR<>1
   _ERR=15 : Gosub _CLOSE : Return
End If
_CURSOR_OK=_CURSOR_OK+1
If _DB_MODE=1
   _FILL=Aga Blit Fill(0,0,320,256,17)
   For _TRY=1 To 4
      If _FILL<>1
         Aga Wait Vbl
         _FILL_RETRIES=_FILL_RETRIES+1
         _FILL=Aga Blit Fill(0,0,320,256,17)
      End If
   Next _TRY
   If _FILL<>1
      _ERR=20 : Gosub _CLOSE : Return
   End If
   _SW=Aga Swap
   If _SW<>1
      _SWAP_REFUSALS=_SWAP_REFUSALS+1
      For _TRY=1 To 4
         If _SW<>1
            Aga Wait Vbl
            _SW=Aga Swap
         End If
      Next _TRY
      If _SW=1
         _SWAP_RECOVERED=_SWAP_RECOVERED+1
      End If
   End If
   If _SW<>1
      _ERR=21 : Gosub _CLOSE : Return
   End If
   _SWAPS=_SWAPS+1
End If
' Close with hidden cursor, no explicit VBL after successful Swap.
Gosub _CLOSE
If _ERR=0
   _CYCLES=_CYCLES+1
   If _DB_MODE=0
      _SINGLE_OK=_SINGLE_OK+1
   Else
      _DB_OK=_DB_OK+1
   End If
End If
Return
_CLOSE:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=_CLOSE_RETURNED+1
   Amos To Front
   _CLOSED=Aga Mouse X
   If _CLOSED<>-1
      If _ERR=0
         _ERR=60
      End If
   Else
      _OPEN=0
   End If
End If
Return
