' M19 S0 ViewPort read-only inspection with PROMOTED P2d.
' No new AGA token, native code, memory write or Sprite DMA.
' MC68020/AGA/AMOS Pro. Uses documented Areg/Leek/Deek.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _ERR=0 : _RESULT=0
_LOG$="RAM:M19_S0_VP_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_S0_VP_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_S0_VP_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_S0_VP_COMPILED.TXT"
End If
_OPEN=0 : _CLOSE_RETURNED=0 : _DB=0 : _SWAP=0 : _SWAP_TRIES=0
_A5=0 : _STATE=0 : _SCREEN=0 : _WINDOW=0 : _WSCREEN=0 : _VIEWPORT=0
_SW=0 : _SH=0 : _VPW=0 : _VPH=0 : _COLOR_MAP=0 : _SPRINS=0 : _UCOPINS=0
_MODES_OPEN=0 : _MODES_DB=0 : _MODES_HIDE=0 : _MODES_SHOW=0
_MODES_SWAP=0 : _SPRITES_OPEN=0 : _SPRITES_DB=0 : _SPRITES_SWAP=0
_CURSOR_HIDE=-1 : _CURSOR_SHOW=-1 : _SPRITE_BIT=0
_VISUAL=0 : _VBL_COUNT=0 : _IO=-1
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=2 : Goto _CLEANUP
End If
' AMOS AREG(5) is the documented read-only AMOS data-zone register.
_A5=Areg(5)
If _A5<4096 or (_A5 and 1)<>0
   _ERR=3 : Goto _CLEANUP
End If
' A5+$1C8 points to the live AGA context in the exact P2d source.
_STATE=Leek(_A5+456)
If _STATE<4096 or (_STATE and 1)<>0
   _ERR=4 : Goto _CLEANUP
End If
_SCREEN=Leek(_STATE)
_WINDOW=Leek(_STATE+36)
If _SCREEN<4096 or _WINDOW<4096
   _ERR=5 : Goto _CLEANUP
End If
If (_SCREEN and 1)<>0 or (_WINDOW and 1)<>0
   _ERR=5 : Goto _CLEANUP
End If
_WSCREEN=Leek(_WINDOW+46)
If _WSCREEN<>_SCREEN
   _ERR=6 : Goto _CLEANUP
End If
_SW=Deek(_SCREEN+12) : _SH=Deek(_SCREEN+14)
If _SW<>320 or _SH<>256
   _ERR=7 : Goto _CLEANUP
End If
' NDK: Screen.ViewPort +44; ViewPort.Modes +32; SPRITES=$4000.
_VIEWPORT=_SCREEN+44
_VPW=Deek(_VIEWPORT+24) : _VPH=Deek(_VIEWPORT+26)
_MODES_OPEN=Deek(_VIEWPORT+32)
_COLOR_MAP=Leek(_VIEWPORT+4)
_SPRINS=Leek(_VIEWPORT+12)
_UCOPINS=Leek(_VIEWPORT+20)
If (_MODES_OPEN and $4000)<>0
   _SPRITES_OPEN=1
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=8 : Goto _CLEANUP
End If
_MODES_DB=Deek(_VIEWPORT+32)
If (_MODES_DB and $4000)<>0
   _SPRITES_DB=1
End If
' Probe cursor mode transitions on the same private AGA window.
_CURSOR_HIDE=Aga Mouse Cursor(0)
_MODES_HIDE=Deek(_VIEWPORT+32)
_CURSOR_SHOW=Aga Mouse Cursor(1)
_MODES_SHOW=Deek(_VIEWPORT+32)
' Display unmistakable asymmetric F/L glyphs; never test square Bobs.
_P0=Aga Palette Set(0,10,14,24)
_P1=Aga Palette Set(165,255,176,48)
_P2=Aga Palette Set(90,56,208,255)
If _P0<>1 or _P1<>1 or _P2<>1
   _ERR=9 : Goto _CLEANUP
End If
_B0=Aga Blit Fill(28,48,10,88,165)
_B1=Aga Blit Fill(38,48,62,10,165)
_B2=Aga Blit Fill(38,88,44,10,165)
_B3=Aga Blit Fill(180,48,10,88,90)
_B4=Aga Blit Fill(190,126,64,10,90)
If _B0<>1 or _B1<>1 or _B2<>1 or _B3<>1 or _B4<>1
   _ERR=10 : Goto _CLEANUP
End If
Amos To Back
For _TRY=1 To 4
   If _SWAP<>1
      _SWAP=Aga Swap
      _SWAP_TRIES=_SWAP_TRIES+1
      If _SWAP<>1
         Aga Wait Vbl
      End If
   End If
Next _TRY
If _SWAP<>1
   _ERR=11 : Goto _CLEANUP
End If
_MODES_SWAP=Deek(_VIEWPORT+32)
If (_MODES_SWAP and $4000)<>0
   _SPRITES_SWAP=1
End If
_VISUAL=1
For _FRAME=1 To 90
   Aga Wait Vbl
   _VBL_COUNT=_VBL_COUNT+1
Next _FRAME
' SPRITES=0 is a valid observation, not a false PASS.
_SPRITE_BIT=_SPRITES_SWAP
_CLEANUP:
If _OPEN=1
   _RESTORE=Aga Mouse Cursor(1)
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
End If
If _ERR=0 and _CLOSE_RETURNED=1 and _VISUAL=1
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS_CONTEXT_ONLY"
End If
Print "M19 S0 VIEWPORT ";_VERDICT$;" ERR ";_ERR
Print "SCREEN ";_SW;" x ";_SH;" VP ";_VPW;" x ";_VPH
Print "SPRITES OPEN/DB/SWAP ";_SPRITES_OPEN;"/";_SPRITES_DB;"/";_SPRITES_SWAP
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 S0 VIEWPORT PROBE"
   Print #1,"SOURCE_TAG M19_S0_VP_AREG_V1"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"A5 ";_A5
   Print #1,"STATE ";_STATE
   Print #1,"SCREEN ";_SCREEN
   Print #1,"WINDOW ";_WINDOW
   Print #1,"WINDOW_SCREEN ";_WSCREEN
   Print #1,"VIEWPORT ";_VIEWPORT
   Print #1,"SCREEN_WIDTH ";_SW
   Print #1,"SCREEN_HEIGHT ";_SH
   Print #1,"VIEWPORT_WIDTH ";_VPW
   Print #1,"VIEWPORT_HEIGHT ";_VPH
   Print #1,"COLOR_MAP ";_COLOR_MAP
   Print #1,"SPRINS ";_SPRINS
   Print #1,"UCOPINS ";_UCOPINS
   Print #1,"MODES_OPEN ";_MODES_OPEN
   Print #1,"MODES_DB ";_MODES_DB
   Print #1,"MODES_CURSOR_HIDDEN ";_MODES_HIDE
   Print #1,"MODES_CURSOR_VISIBLE ";_MODES_SHOW
   Print #1,"MODES_SWAP ";_MODES_SWAP
   Print #1,"SPRITES_OPEN ";_SPRITES_OPEN
   Print #1,"SPRITES_DB ";_SPRITES_DB
   Print #1,"SPRITES_SWAP ";_SPRITES_SWAP
   Print #1,"CURSOR_HIDE ";_CURSOR_HIDE
   Print #1,"CURSOR_SHOW ";_CURSOR_SHOW
   Print #1,"DB ";_DB
   Print #1,"SWAP ";_SWAP
   Print #1,"SWAP_TRIES ";_SWAP_TRIES
   Print #1,"VISUAL ";_VISUAL
   Print #1,"VBL_COUNT ";_VBL_COUNT
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
