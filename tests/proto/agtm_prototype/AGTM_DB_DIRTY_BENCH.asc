' AGTM DB DIRTY BENCH - experimental AMOS, not distributed.
' P2d-L2b reference; MC68020+ AGA. Banks 20..24 must be free.
' Two physical pages, two layers, 12 camera moves and map edits.
' Validate incremental vs full first, then AB/BA timed series.
Set Buffer 20
Cls
Dim _CX(12),_CY(12),_EX(12),_EY(12),_PCX(1),_PCY(1),_REV(1)
Dim _DRAW_TIME(1,1),_FRAME_TIME(1,1),_GROUND_N(1,1),_OVER_N(1,1),_COPY_N(1,1),_PATCH_N(1,1)
Dim _MASKS(7)
_CX(0)=32 : _CY(0)=32
_CX(1)=33 : _CY(1)=32 : _CX(2)=34 : _CY(2)=32
_CX(3)=34 : _CY(3)=40 : _CX(4)=34 : _CY(4)=48
_CX(5)=42 : _CY(5)=56 : _CX(6)=50 : _CY(6)=64
_CX(7)=34 : _CY(7)=48 : _CX(8)=18 : _CY(8)=32
_CX(9)=18 : _CY(9)=32 : _CX(10)=18 : _CY(10)=32
_CX(11)=19 : _CY(11)=31 : _CX(12)=20 : _CY(12)=30
For _I=1 To 12
   _EX(_I)=6+(_I Mod 4) : _EY(_I)=6+(_I Mod 3)
Next _I
_EX(7)=50 : _EY(7)=25
_MASKS(0)=128
For _I=1 To 7
   _MASKS(_I)=Int(_MASKS(_I-1)/2)
Next _I
_ERR=0 : _RESULT=0 : _OPEN=0 : _CLOSED=0 : _OWN=0
_RUN=-1 : _FRAME=0 : _METHOD=-1 : _PASS=-1 : _BACK=0
_SWAPS=0 : _WAITS=0 : _SAFE_WAITS=0 : _RUNS=0 : _CHECKS=0
_BYTES=0 : _BAD=0 : _FIRST_BAD=-1 : _SAMPLES=0 : _SAMPLE_BAD=0
_BAD_X=-1 : _BAD_Y=-1 : _BAD_EXPECT=-1 : _BAD_ACTUAL=-1
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:AGTM_DB_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:AGTM_DB_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:AGTM_DB_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:AGTM_DB_COMPILED.TXT"
End If
Print "AGTM DB DIRTY BENCH"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
For _BN=20 To 24
   If Length(_BN)<>0
      _ERR=2 : Goto _CLEANUP
   End If
Next _BN
_OWN=1
Reserve As Data 20,4096
Reserve As Data 21,4160
If Length(20)<>4096 or Length(21)<>4160
   _ERR=3 : Goto _CLEANUP
End If
_OK=Aga F Icon Bank Create(22,16)
If _OK<>1 or Length(22)<>4620
   _ERR=4 : Goto _CLEANUP
End If
For _ID=1 To 16
   _SRC=Start(20)+(_ID-1)*256
   For _Y=0 To 15
      For _X=0 To 15
         _PEN=(_ID*29+_X*7+_Y*13) Mod 256
         If _X=0 or _Y=0
            _PEN=0
         End If
         If _X=_Y
            _PEN=255
         End If
         Poke _SRC+_Y*16+_X,_PEN
      Next _X
   Next _Y
   _OK=Aga F Icon Bank Put(22,_ID,20,(_ID-1)*256)
   If _OK<>1
      _ERR=5 : Goto _CLEANUP
   End If
Next _ID
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=6 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=7 : Goto _CLEANUP
End If
For _I=0 To 255
   _R=(_I And 7)*36 : _G=(Int(_I/8) And 7)*36 : _BLUE=Int(_I/64)*85
   _OK=Aga Palette Set(_I,_R,_G,_BLUE)
   If _OK<>1
      _ERR=8 : Goto _CLEANUP
   End If
Next _I
' Run 0 = validation; 1/2 = FULL/SCROLL, 3/4 = SCROLL/FULL.
For _RUN=0 To 4
   _METHOD=1 : _PASS=0
   If _RUN=1 or _RUN=4
      _METHOD=0
   End If
   If _RUN>=3
      _PASS=1
   End If
   _FRAME=0
   Gosub _RESET_MAP
   Gosub _INIT_PAGES
   If _ERR<>0
      Goto _CLEANUP
   End If
   Amos To Back
   _GROUND=0 : _OVER=0 : _COPIES=0 : _PATCHES=0 : _DT=0
   _SERIES_START=Timer
   For _FRAME=1 To 12
      _CAMX=_CX(_FRAME) : _CAMY=_CY(_FRAME)
      Gosub _EDIT_MAP
      _DRAW_START=Timer
      If _METHOD=0
         Gosub _FULL
      Else
         Gosub _DIRTY
      End If
      _DT=_DT+Timer-_DRAW_START
      If _ERR<>0
         Goto _CLEANUP
      End If
      If _RUN=0
         Gosub _VERIFY
         If _ERR<>0
            Goto _CLEANUP
         End If
      End If
      _PCX(_BACK)=_CAMX : _PCY(_BACK)=_CAMY : _REV(_BACK)=_FRAME
      Gosub _PRESENT
      If _ERR<>0
         Goto _CLEANUP
      End If
   Next _FRAME
   If _RUN>0
      _FRAME_TIME(_METHOD,_PASS)=Timer-_SERIES_START
      _DRAW_TIME(_METHOD,_PASS)=_DT
      _GROUND_N(_METHOD,_PASS)=_GROUND : _OVER_N(_METHOD,_PASS)=_OVER
      _COPY_N(_METHOD,_PASS)=_COPIES : _PATCH_N(_METHOD,_PASS)=_PATCHES
      _RUNS=_RUNS+1
   End If
Next _RUN
If _CHECKS<>12 or _BYTES<>983040 or _SAMPLES<>72 or _RUNS<>4 or _SWAPS<>70
   _ERR=9 : Goto _CLEANUP
End If
For _I=1 To 50
   Aga Wait Vbl
Next _I
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _OWN=1
   For _BN=20 To 24
      If Length(_BN)<>0
         Erase _BN
      End If
   Next _BN
End If
If _ERR=0 and _CLOSED=1 and _BAD=0 and _SAMPLE_BAD=0
   _RESULT=1
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "AGTM DB ";_VERDICT$;" ERR ";_ERR
Print "CHECKS ";_CHECKS;" BYTES ";_BYTES;" BAD ";_BAD
For _P=0 To 1
   Print "PASS ";_P;" DRAW FULL/SCROLL ";_DRAW_TIME(0,_P);"/";_DRAW_TIME(1,_P)
   Print "FRAME FULL/SCROLL ";_FRAME_TIME(0,_P);"/";_FRAME_TIME(1,_P)
Next _P
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
_CLOSEERR=0
If _LOGERR=0
   Print #1,"TEST AGTM_DB_DIRTY_BENCH"
   Print #1,"LIBRARY_EXPECTED P2D_L2B"
   Print #1,"RUN_MODE ";_MODE$;" PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT;" ERR ";_ERR;" VERDICT ";_VERDICT$
   Print #1,"RUN ";_RUN;" FRAME ";_FRAME;" METHOD ";_METHOD;" BACK ";_BACK;" CAM ";_CAMX;" ";_CAMY
   Print #1,"CHECKS ";_CHECKS;" COMPARE_BYTES ";_BYTES;" BYTE_MISMATCH ";_BAD;" FIRST_BAD ";_FIRST_BAD
   Print #1,"ORACLE_CHECKS ";_SAMPLES;" ORACLE_BAD ";_SAMPLE_BAD
   Print #1,"BAD_X ";_BAD_X;" BAD_Y ";_BAD_Y;" EXPECTED ";_BAD_EXPECT;" ACTUAL ";_BAD_ACTUAL
   Print #1,"BENCH_RUNS ";_RUNS;" FRAMES_PER_RUN 12"
   For _P=0 To 1
      For _M=0 To 1
         Print #1,"PASS ";_P;" METHOD ";_M;" DRAW_TICKS ";_DRAW_TIME(_M,_P);" FRAME_TICKS ";_FRAME_TIME(_M,_P)
         Print #1,"GROUND ";_GROUND_N(_M,_P);" OVER ";_OVER_N(_M,_P);" COPIES ";_COPY_N(_M,_P);" PATCHES ";_PATCH_N(_M,_P)
      Next _M
   Next _P
   Print #1,"SWAPS ";_SWAPS;" SWAP_WAITS ";_WAITS;" INIT_SAFE_WAITS ";_SAFE_WAITS
   Print #1,"CHIP_BEFORE ";_CHIP0;" CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0;" FAST_AFTER ";_FAST1
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
_RESET_MAP:
' AGTM v1, 64x32 cells, two 2048-byte layers, zero-based IDs.
_MP=Start(21)
Loke _MP,$4147544D
Doke _MP+4,1 : Doke _MP+6,64
Doke _MP+8,64 : Doke _MP+10,32
Poke _MP+12,16 : Poke _MP+13,16 : Poke _MP+14,2 : Poke _MP+15,1
Doke _MP+16,16 : Doke _MP+18,0
Loke _MP+20,64 : Loke _MP+24,2048
Loke _MP+28,64 : Loke _MP+32,4096
For _I=36 To 63
   Poke _MP+_I,0
Next _I
For _Y=0 To 31
   For _X=0 To 63
      _OFF=_Y*64+_X
      Poke _MP+64+_OFF,(_X*3+_Y*5+Int(_X/3)+Int(_Y/5)) Mod 16
      _TOP=0
      If ((_X+2*_Y) Mod 4)=0
         _TOP=1+((_X+_Y) Mod 15)
      End If
      Poke _MP+2112+_OFF,_TOP
   Next _X
Next _Y
Return
_INIT_PAGES:
_CAMX=_CX(0) : _CAMY=_CY(0)
For _INIT=0 To 1
   If _ERR=0
      _READY=0
      For _TRY=1 To 20
         If _READY<>1
            _READY=Aga Blit Fill(0,0,320,256,0)
            If _READY<>1
               Aga Wait Vbl
               _SAFE_WAITS=_SAFE_WAITS+1
            End If
         End If
      Next _TRY
      If _READY<>1
         _ERR=10
      Else
         Gosub _FULL
         If _ERR=0
            _PCX(_BACK)=_CAMX : _PCY(_BACK)=_CAMY : _REV(_BACK)=0
            Gosub _PRESENT
         End If
      End If
   End If
Next _INIT
Return
_PRESENT:
_SW=0
For _TRY=1 To 20
   If _SW<>1
      _SW=Aga Swap
      If _SW<>1
         Aga Wait Vbl
         _WAITS=_WAITS+1
      End If
   End If
Next _TRY
If _SW<>1
   _ERR=11
Else
   _SWAPS=_SWAPS+1
   _BACK=1-_BACK
   Aga Wait Vbl
End If
Return
_EDIT_MAP:
' One edit per frame, both pages must see every missed edit.
_MP=Start(21)+64+_EY(_FRAME)*64+_EX(_FRAME)
If (_FRAME Mod 2)=1
   Poke _MP,(Peek(_MP)+5) Mod 16
Else
   _MP=_MP+2048
   If Peek(_MP)=0
      Poke _MP,1+(_FRAME Mod 15)
   Else
      Poke _MP,0
   End If
End If
Return
_FULL:
_L=Int(_CAMX/16) : _R=Int((_CAMX+319)/16)
_T=Int(_CAMY/16) : _B=Int((_CAMY+255)/16)
Gosub _REGION
Return
_DIRTY:
_OX=_PCX(_BACK) : _OY=_PCY(_BACK)
_DX=_CAMX-_OX : _DY=_CAMY-_OY
If Abs(_DX)>=320 or Abs(_DY)>=256
   _ERR=12
Else
   If _DX<>0 or _DY<>0
      _SX=0 : _SY=0 : _TX=0 : _TY=0
      If _DX>0
         _SX=_DX
      Else
         _TX=0-_DX
      End If
      If _DY>0
         _SY=_DY
      Else
         _TY=0-_DY
      End If
      _OK=Aga Blit Copy(_SX,_SY,_TX,_TY,320-Abs(_DX),256-Abs(_DY))
      If _OK<>1
         _ERR=13
      Else
         _COPIES=_COPIES+1
      End If
   End If
End If
' Paint complete tiles touching exposed strips; corner duplicates allowed.
If _ERR=0 and _DX<>0
   _T=Int(_CAMY/16) : _B=Int((_CAMY+255)/16)
   If _DX>0
      _L=Int((_OX+320)/16) : _R=Int((_CAMX+319)/16)
   Else
      _L=Int(_CAMX/16) : _R=Int((_OX-1)/16)
   End If
   Gosub _REGION
End If
If _ERR=0 and _DY<>0
   _L=Int(_CAMX/16) : _R=Int((_CAMX+319)/16)
   If _DY>0
      _T=Int((_OY+256)/16) : _B=Int((_CAMY+255)/16)
   Else
      _T=Int(_CAMY/16) : _B=Int((_OY-1)/16)
   End If
   Gosub _REGION
End If
' Replay missed edits using current map, repaint both layers.
If _ERR=0 and _REV(_BACK)<_FRAME
   _MAPBASE=Start(21)+64
   For _EDIT=_REV(_BACK)+1 To _FRAME
      _TC=_EX(_EDIT) : _TR=_EY(_EDIT)
      If _TC>=Int(_CAMX/16) and _TC<=Int((_CAMX+319)/16)
         If _TR>=Int(_CAMY/16) and _TR<=Int((_CAMY+255)/16)
            If _ERR=0
               Gosub _CELL
               _PATCHES=_PATCHES+1
            End If
         End If
      End If
   Next _EDIT
End If
Return
_REGION:
If _L<0 or _R>63 or _L>_R or _T<0 or _B>31 or _T>_B
   _ERR=14
Else
   _MAPBASE=Start(21)+64
   For _TR=_T To _B
      For _TC=_L To _R
         If _ERR=0
            Gosub _CELL
         End If
      Next _TC
   Next _TR
End If
Return
_CELL:
_OFF=_TR*64+_TC
_XP=_TC*16-_CAMX : _YP=_TR*16-_CAMY
_ID=Peek(_MAPBASE+_OFF)+1
_OK=Aga F Icon(22,_ID,_XP,_YP,0)
If _OK<>1
   _ERR=15
Else
   _GROUND=_GROUND+1
   _ID=Peek(_MAPBASE+2048+_OFF)
   If _ID<>0
      _OK=Aga F Icon(22,_ID+1,_XP,_YP,1)
      If _OK<>1
         _ERR=16
      Else
         _OVER=_OVER+1
      End If
   End If
End If
Return
_VERIFY:
' Compare actual incremental back page to full redraw before Swap.
_CA=Aga C Block Capture(23,0,0,320,256,0)
If _CA<>1 or Length(23)<>81960
   _ERR=17
Else
   Gosub _FULL
   If _ERR=0
      _CB=Aga C Block Capture(24,0,0,320,256,0)
      If _CB<>1 or Length(24)<>81960
         _ERR=18
      Else
         _SA=Start(23)+40 : _SB=Start(24)+40
         For _I=0 To 20479
            _OFF=_I*4
            If Leek(_SA+_OFF)<>Leek(_SB+_OFF)
               For _J=0 To 3
                  If Peek(_SA+_OFF+_J)<>Peek(_SB+_OFF+_J)
                     _BAD=_BAD+1
                     If _FIRST_BAD=-1
                        _FIRST_BAD=_OFF+_J
                     End If
                  End If
               Next _J
            End If
         Next _I
         _BYTES=_BYTES+81920
         Gosub _ORACLE
         _CHECKS=_CHECKS+1
         If _BAD<>0 or _SAMPLE_BAD<>0
            _ERR=19
         End If
      End If
   End If
End If
Return
_ORACLE:
' Sample original chunky tiles independently, including current edited cell.
_FORX=_EX(_FRAME)*16-_CAMX : _FORY=_EY(_FRAME)*16-_CAMY
For _S=0 To 5
   _QX=0 : _QY=0
   If _S=1
      _QX=319 : _QY=255
   End If
   If _S=2
      _QX=159 : _QY=127
   End If
   If _S=3
      _QX=7 : _QY=8
   End If
   If _S=4
      _QX=_FORX : _QY=_FORY+1
   End If
   If _S=5
      _QX=_FORX+6 : _QY=_FORY+5
   End If
   If _QX<0 or _QX>319 or _QY<0 or _QY>255
      _QX=160 : _QY=128
   End If
   _WX=_CAMX+_QX : _WY=_CAMY+_QY
   _MP=Start(21)+64+Int(_WY/16)*64+Int(_WX/16)
   _TP=Start(20)+(_WY Mod 16)*16+(_WX Mod 16)
   _EXPECT=Peek(_TP+Peek(_MP)*256)
   _TOP=Peek(_MP+2048)
   If _TOP<>0
      _PEN=Peek(_TP+_TOP*256)
      If _PEN<>0
         _EXPECT=_PEN
      End If
   End If
   _OFF=_QY*40+Int(_QX/8) : _MASK=_MASKS(_QX Mod 8)
   _ACTUAL=0 : _POWER=1
   For _PLANE=0 To 7
      If (Peek(_SA+_PLANE*10240+_OFF) And _MASK)<>0
         _ACTUAL=_ACTUAL+_POWER
      End If
      _POWER=_POWER*2
   Next _PLANE
   _SAMPLES=_SAMPLES+1
   If _ACTUAL<>_EXPECT
      _SAMPLE_BAD=_SAMPLE_BAD+1
      If _BAD_X=-1
         _BAD_X=_QX : _BAD_Y=_QY : _BAD_EXPECT=_EXPECT : _BAD_ACTUAL=_ACTUAL
      End If
   End If
Next _S
Return
