' AGTM FINE SCROLL BENCH - standalone prototype, not distributed.
' Target P2d-L2b, MC68020+ AGA PAL. Banks 20..24 must be free.
' One opaque layer, pixel exact horizontal scrolling 1/8/16 px.
' Verify 12 transitions before measuring continuous out-and-back runs.
Set Buffer 20
Cls
Dim _STEP_LIST(2),_BASE_LIST(2),_TIME(2,1,1),_DRAWN(2,1,1),_COPIES(2,1,1)
Dim _SAMPLE_X(11),_SAMPLE_Y(6),_BIT_MASK(7)
_STEP_LIST(0)=1 : _STEP_LIST(1)=8 : _STEP_LIST(2)=16
_BASE_LIST(0)=14 : _BASE_LIST(1)=0 : _BASE_LIST(2)=0
_SAMPLE_X(0)=0 : _SAMPLE_X(1)=1 : _SAMPLE_X(2)=7 : _SAMPLE_X(3)=8
_SAMPLE_X(4)=15 : _SAMPLE_X(5)=16 : _SAMPLE_X(6)=159 : _SAMPLE_X(7)=303
_SAMPLE_X(8)=304 : _SAMPLE_X(9)=311 : _SAMPLE_X(10)=318 : _SAMPLE_X(11)=319
_SAMPLE_Y(0)=0 : _SAMPLE_Y(1)=1 : _SAMPLE_Y(2)=15 : _SAMPLE_Y(3)=16
_SAMPLE_Y(4)=127 : _SAMPLE_Y(5)=254 : _SAMPLE_Y(6)=255
_BIT_MASK(0)=128
For _I=1 To 7
   _BIT_MASK(_I)=Int(_BIT_MASK(_I-1)/2)
Next _I
_ERR=0 : _RESULT=0 : _OPEN=0 : _CLOSED=0 : _BANKS_SAFE=0
_RUNS=0 : _CHECKS=0 : _COMPARE_BYTES=0 : _BYTE_BAD=0 : _FIRST_BAD=-1
_ORACLE_CHECKS=0 : _ORACLE_BAD=0 : _FIRST_PX=-1 : _FIRST_PY=-1
_EXPECTED=0 : _ACTUAL=0 : _FAIL_EXPECTED=-1 : _FAIL_ACTUAL=-1
_CASE=-1 : _CAM=0 : _DIR=0 : _METHOD=-1 : _PASS=-1 : _STAGE=0
_ICONS=0 : _BLITS=0 : _SWAPS=0 : _SAFE_WAITS=0 : _SWAP_WAITS=0
_STEPS=4 : _LOW_TICKS=0
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:AGTM_FINE_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:AGTM_FINE_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:AGTM_FINE_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:AGTM_FINE_COMPILED.TXT"
End If
Print "AGTM FINE SCROLL - 1 / 8 / 16 PX"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
For _B=20 To 24
   If Length(_B)<>0
      _ERR=2 : Goto _CLEANUP
   End If
Next _B
_BANKS_SAFE=1
Reserve As Data 20,4096
Reserve As Data 21,1088
If Length(20)<>4096 or Length(21)<>1088
   _ERR=3 : Goto _CLEANUP
End If
_OK=Aga F Icon Bank Create(22,16)
If _OK<>1 or Length(22)<>4620
   _ERR=4 : Goto _CLEANUP
End If
' Keep the original chunky pixels for an independent sampled oracle.
For _ID=1 To 16
   _SRC=Start(20)+(_ID-1)*256
   For _Y=0 To 15
      For _X=0 To 15
         _PEN=(_ID*29+_X*7+_Y*13) Mod 256
         If _X=0 or _Y=0
            _PEN=0
         End If
         If _X=_Y
            _PEN=255
         End If
         Poke _SRC+_Y*16+_X,_PEN
      Next _X
   Next _Y
   _OK=Aga F Icon Bank Put(22,_ID,20,(_ID-1)*256)
   If _OK<>1
      _ERR=5 : Goto _CLEANUP
   End If
Next _ID
' Canonical AGTM v1, 64x16 cells, 16 tiles, one opaque layer.
_MP=Start(21)
Loke _MP,$4147544D
Doke _MP+4,1 : Doke _MP+6,64
Doke _MP+8,64 : Doke _MP+10,16
Poke _MP+12,16 : Poke _MP+13,16
Poke _MP+14,1 : Poke _MP+15,1
Doke _MP+16,16 : Doke _MP+18,0
Loke _MP+20,64 : Loke _MP+24,1024
Loke _MP+28,64 : Loke _MP+32,1024
For _I=36 To 63
   Poke _MP+_I,0
Next _I
For _Y=0 To 15
   For _X=0 To 63
      Poke _MP+64+_Y*64+_X,(_X*3+_Y*5+Int(_X/3)+Int(_Y/5)) Mod 16
   Next _X
Next _Y
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=6 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=7 : Goto _CLEANUP
End If
For _I=0 To 255
   _R=(_I And 7)*36 : _G=(Int(_I/8) And 7)*36 : _BLUE=Int(_I/64)*85
   _OK=Aga Palette Set(_I,_R,_G,_BLUE)
   If _OK<>1
      _ERR=8 : Goto _CLEANUP
   End If
Next _I
' Acquire a safe back buffer before any measured drawing.
_READY=0
For _TRY=1 To 20
   If _READY<>1
      _READY=Aga Blit Fill(0,0,320,256,0)
      If _READY<>1
         Aga Wait Vbl
         _SAFE_WAITS=_SAFE_WAITS+1
      End If
   End If
Next _TRY
If _READY<>1
   _ERR=9 : Goto _CLEANUP
End If
' Phase 1: two steps out and two back, each compared before timing.
_STAGE=1
For _CASE=0 To 2
   _STEP=_STEP_LIST(_CASE) : _BASE=_BASE_LIST(_CASE) : _CAM=_BASE
   Gosub _DRAW_FULL
   If _ERR<>0
      Goto _CLEANUP
   End If
   For _DIR=0 To 1
      For _REP=1 To 2
         Gosub _ADVANCE_CAMERA
         Gosub _DRAW_SCROLL
         If _ERR=0
            Gosub _VERIFY_FRAME
         End If
         If _ERR<>0
            Goto _CLEANUP
         End If
      Next _REP
   Next _DIR
Next _CASE
If _CHECKS<>12 or _COMPARE_BYTES<>983040 or _ORACLE_CHECKS<>1008
   _ERR=10 : Goto _CLEANUP
End If
' Phase 2: AB/BA, each series timed once, no per-frame Timer rounding.
_STAGE=2
For _CASE=0 To 2
   _STEP=_STEP_LIST(_CASE) : _BASE=_BASE_LIST(_CASE)
   For _PASS=0 To 1
      For _ORDER=0 To 1
         _METHOD=_ORDER
         If _PASS=1
            _METHOD=1-_ORDER
         End If
         _CAM=_BASE
         Gosub _DRAW_FULL
         If _ERR<>0
            Goto _CLEANUP
         End If
         _ICONS=0 : _BLITS=0
         _T0=Timer
         For _DIR=0 To 1
            For _REP=1 To _STEPS
               If _ERR=0
                  Gosub _ADVANCE_CAMERA
                  If _METHOD=0
                     Gosub _DRAW_FULL
                  Else
                     Gosub _DRAW_SCROLL
                  End If
               End If
            Next _REP
         Next _DIR
         _TIME(_CASE,_METHOD,_PASS)=Timer-_T0
         If _ERR<>0
            Goto _CLEANUP
         End If
         If _CAM<>_BASE
            _ERR=11 : Goto _CLEANUP
         End If
         _DRAWN(_CASE,_METHOD,_PASS)=_ICONS
         _COPIES(_CASE,_METHOD,_PASS)=_BLITS
         If _METHOD=0
            If _BLITS<>0
               _ERR=12 : Goto _CLEANUP
            End If
         Else
            If _BLITS<>2*_STEPS
               _ERR=13 : Goto _CLEANUP
            End If
         End If
         If _TIME(_CASE,_METHOD,_PASS)<5
            _LOW_TICKS=_LOW_TICKS+1
         End If
         _RUNS=_RUNS+1
      Next _ORDER
   Next _PASS
Next _CASE
' Present only a fully verified and completed background.
_STAGE=3
_SW=0
For _TRY=1 To 20
   If _SW<>1
      _SW=Aga Swap
      If _SW<>1
         Aga Wait Vbl
         _SWAP_WAITS=_SWAP_WAITS+1
      End If
   End If
Next _TRY
If _SW<>1
   _ERR=14 : Goto _CLEANUP
End If
_SWAPS=1
Amos To Back
For _HOLD=1 To 100
   Aga Wait Vbl
Next _HOLD
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _BANKS_SAFE=1
   For _B=20 To 24
      If Length(_B)<>0
         Erase _B
      End If
   Next _B
End If
If _ERR=0 and _CLOSED=1 and _RUNS=12 and _CHECKS=12 and _SWAPS=1
   If _BYTE_BAD=0 and _ORACLE_BAD=0
      _RESULT=1
   End If
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "AGTM FINE ";_VERDICT$;" ERR ";_ERR
Print "CHECKS ";_CHECKS;" BYTES ";_COMPARE_BYTES;" BAD ";_BYTE_BAD
Print "ORACLE ";_ORACLE_CHECKS;" BAD ";_ORACLE_BAD
For _C=0 To 2
   Print "STEP ";_STEP_LIST(_C);" FULL ";_TIME(_C,0,0)+_TIME(_C,0,1);" SCROLL ";_TIME(_C,1,0)+_TIME(_C,1,1)
Next _C
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST AGTM_FINE_SCROLL_BENCH"
   Print #1,"LIBRARY_EXPECTED P2D_L2B"
   Print #1,"RUN_MODE ";_MODE$;" PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT;" ERR ";_ERR;" VERDICT ";_VERDICT$
   Print #1,"STAGE ";_STAGE;" CASE ";_CASE;" CAM ";_CAM;" DIR ";_DIR;" METHOD ";_METHOD;" PASS ";_PASS
   Print #1,"CHECKS ";_CHECKS;" COMPARE_BYTES ";_COMPARE_BYTES;" BYTE_MISMATCH ";_BYTE_BAD;" FIRST_BAD_OFFSET ";_FIRST_BAD
   Print #1,"ORACLE_CHECKS ";_ORACLE_CHECKS;" ORACLE_BAD ";_ORACLE_BAD
   Print #1,"FIRST_ORACLE_X ";_FIRST_PX;" Y ";_FIRST_PY;" EXPECTED ";_FAIL_EXPECTED;" ACTUAL ";_FAIL_ACTUAL
   Print #1,"BENCH_RUNS ";_RUNS;" STEPS_PER_DIR ";_STEPS;" LOW_TICK_RUNS ";_LOW_TICKS
   For _C=0 To 2
      For _P=0 To 1
         Print #1,"STEP ";_STEP_LIST(_C);" PASS ";_P;" FULL ";_TIME(_C,0,_P);" SCROLL ";_TIME(_C,1,_P)
         Print #1,"FULL_ICONS ";_DRAWN(_C,0,_P);" SCROLL_ICONS ";_DRAWN(_C,1,_P);" SCROLL_COPIES ";_COPIES(_C,1,_P)
      Next _P
   Next _C
   Print #1,"SWAPS ";_SWAPS;" SAFE_WAITS ";_SAFE_WAITS;" SWAP_WAITS ";_SWAP_WAITS
   Print #1,"CHIP_BEFORE ";_CHIP0;" CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0;" FAST_AFTER ";_FAST1
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
_ADVANCE_CAMERA:
_OLD_CAM=_CAM
If _DIR=0
   _CAM=_CAM+_STEP
Else
   _CAM=_CAM-_STEP
End If
Return
_DRAW_FULL:
_FIRST_COL=Int(_CAM/16) : _LAST_COL=Int((_CAM+319)/16)
Gosub _DRAW_COLS
Return
_DRAW_SCROLL:
If _CAM>_OLD_CAM
   _DELTA=_CAM-_OLD_CAM
   _CP=Aga Blit Copy(_DELTA,0,0,0,320-_DELTA,256)
   _FIRST_COL=Int((_OLD_CAM+320)/16) : _LAST_COL=Int((_CAM+319)/16)
Else
   _DELTA=_OLD_CAM-_CAM
   _CP=Aga Blit Copy(0,0,_DELTA,0,320-_DELTA,256)
   _FIRST_COL=Int(_CAM/16) : _LAST_COL=Int((_OLD_CAM-1)/16)
End If
If _CP<>1
   _ERR=15
Else
   _BLITS=_BLITS+1
   Gosub _DRAW_COLS
End If
Return
_DRAW_COLS:
If _FIRST_COL<0 or _LAST_COL>63 or _FIRST_COL>_LAST_COL
   _ERR=16
Else
   _MAPBASE=Start(21)+64
   For _RY=0 To 15
      For _TC=_FIRST_COL To _LAST_COL
         If _ERR=0
            _ID=Peek(_MAPBASE+_RY*64+_TC)+1
            _DX=_TC*16-_CAM
            _OK=Aga F Icon(22,_ID,_DX,_RY*16,0)
            If _OK<>1
               _ERR=17
            Else
               _ICONS=_ICONS+1
            End If
         End If
      Next _TC
   Next _RY
End If
Return
_VERIFY_FRAME:
' Capture the incremental image, then compare to a fresh full redraw.
_CA=Aga C Block Capture(23,0,0,320,256,0)
If _CA<>1 or Length(23)<>81960
   _ERR=18
Else
   Gosub _DRAW_FULL
   If _ERR=0
      _CB=Aga C Block Capture(24,0,0,320,256,0)
      If _CB<>1 or Length(24)<>81960
         _ERR=19
      Else
         Gosub _COMPARE_PLANES
         Gosub _CHECK_ORACLE
         _CHECKS=_CHECKS+1
         If _BYTE_BAD<>0 or _ORACLE_BAD<>0
            _ERR=20
         End If
      End If
   End If
End If
Return
_COMPARE_PLANES:
_SRC_A=Start(23)+40 : _SRC_B=Start(24)+40
' Longword equality checks every byte; count individual bytes on mismatch.
For _I=0 To 20479
   _OFF=_I*4
   If Leek(_SRC_A+_OFF)<>Leek(_SRC_B+_OFF)
      For _J=0 To 3
         If Peek(_SRC_A+_OFF+_J)<>Peek(_SRC_B+_OFF+_J)
            _BYTE_BAD=_BYTE_BAD+1
            If _FIRST_BAD=-1
               _FIRST_BAD=_OFF+_J
            End If
         End If
      Next _J
   End If
Next _I
_COMPARE_BYTES=_COMPARE_BYTES+81920
Return
_CHECK_ORACLE:
' Read actual pixels directly from planar capture, compare to chunky source.
_SRC_A=Start(23)+40 : _TILEBASE=Start(20) : _MAPBASE=Start(21)+64
For _SY=0 To 6
   _PY=_SAMPLE_Y(_SY)
   For _SX=0 To 11
      _PX=_SAMPLE_X(_SX) : _WX=_CAM+_PX
      _TILE=Peek(_MAPBASE+Int(_PY/16)*64+Int(_WX/16))
      _EXPECTED=Peek(_TILEBASE+_TILE*256+(_PY Mod 16)*16+(_WX Mod 16))
      _OFFSET=_PY*40+Int(_PX/8) : _MASK=_BIT_MASK(_PX Mod 8)
      _ACTUAL=0 : _POWER=1
      For _PLANE=0 To 7
         If (Peek(_SRC_A+_PLANE*10240+_OFFSET) And _MASK)<>0
            _ACTUAL=_ACTUAL+_POWER
         End If
         _POWER=_POWER*2
      Next _PLANE
      _ORACLE_CHECKS=_ORACLE_CHECKS+1
      If _ACTUAL<>_EXPECTED
         _ORACLE_BAD=_ORACLE_BAD+1
         If _FIRST_PX=-1
            _FIRST_PX=_PX : _FIRST_PY=_PY : _FAIL_EXPECTED=_EXPECTED : _FAIL_ACTUAL=_ACTUAL
         End If
      End If
   Next _SX
Next _SY
Return
