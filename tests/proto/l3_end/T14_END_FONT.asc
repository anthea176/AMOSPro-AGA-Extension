' L3 T14C: End with active B8/C2P/Copper/system font, then reopen.
' Run the same program twice, 1 then 2, no AMOS restart or bank edits.
' Banks 12 and 24 initially free. LIBS:c2p.library and topaz.font 9.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:T14_END_UNKNOWN.TXT"
_ERR=0 : _OPEN=0 : _OWN=0 : _PH=0 : _RUN=0 : _RETRY=0
_PREP=0 : _END_READY=0 : _POST_OK=0 : _FONT_OK=0 : _BOB_OK=0
_C2P_OK=0 : _COPPER_OK=0 : _CLOSE_OK=0 : _CLOSED=-99
_BASE_CHIP=-1 : _BASE_FAST=-1 : _POST_CHIP=-1 : _POST_FAST=-1
_BANK12_START=-1 : _BANK24_START=-1 : _RESULT=0 : _VERDICT$="FAIL"
If _PRG=1
   _MODE$="RUNTIME"
End If
If _PRG=0
   _MODE$="INTERPRETED"
End If
If _PRG=-1
   _MODE$="COMPILED"
End If
Print "T14C END / FONT - SAME PROGRAM TWICE"
Input "1=PREPARE AND END, 2=CHECK AND REOPEN";_RUN
If _RUN=1
   _LOG$="RAM:T14_END_BEFORE_"+_MODE$+".TXT"
Else
   _LOG$="RAM:T14_END_AFTER_"+_MODE$+".TXT"
End If
If _RUN<>1 and _RUN<>2
   _ERR=1 : Goto _REPORT
End If
If Aga Detect=0
   _ERR=2 : Goto _REPORT
End If
_BANK12_START=Length(12) : _BANK24_START=Length(24)
If _RUN=1
   If _BANK12_START<>0 or _BANK24_START<>0
      _ERR=3 : Goto _REPORT
   End If
Else
   ' Check before reopening or freeing any surviving AMOS DATA bank.
   _PH=1
   Gosub _CHECK_CLOSED
   If _ERR<>0
      Goto _REPORT
   End If
   If _BANK12_START<>0
      If _BANK12_START<>81920
         _ERR=5 : Goto _REPORT
      End If
      If Peek(Start(12))<>90 or Peek(Start(12)+81919)<>90
         _ERR=6 : Goto _REPORT
      End If
   End If
   If _BANK24_START<>0
      If _BANK24_START<=32 or _BANK24_START>1024
         _ERR=7 : Goto _REPORT
      End If
      If Leek(Start(24))<>$4147424F or Deek(Start(24)+8)<>1
         _ERR=8 : Goto _REPORT
      End If
   End If
   _OWN=1
   Gosub _ERASE_BANKS
   _POST_CHIP=Chip Free : _POST_FAST=Fast Free : _POST_OK=1
End If
_OWN=1
' Identical full setup in both passes. Explicit Close is the control.
Gosub _PREPARE
Gosub _CLEANUP
If _ERR<>0
   Goto _REPORT
End If
_BASE_CHIP=Chip Free : _BASE_FAST=Fast Free
If _RUN=2
   _RESULT=1 : _VERDICT$="PASS" : Goto _REPORT
End If
' Second setup on pass 1: leave every resource live at program End.
Gosub _PREPARE
If _ERR<>0
   Gosub _CLEANUP
   Goto _REPORT
End If
_END_READY=1 : _VERDICT$="READY_FOR_END"
_REPORT:
' No explicit Close on the successful pass-1 path.
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST T14C END FONT"
   Print #1,"SOURCE_TAG T14C_END_FONT_20261124"
   Print #1,"LIB_EXPECTED P2d-L2b"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RUN ";_RUN
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"PHASE_LAST ";_PH
   Print #1,"PREP_OK ";_PREP
   Print #1,"FONT_OK ";_FONT_OK
   Print #1,"BOB_OK ";_BOB_OK
   Print #1,"C2P_OK ";_C2P_OK
   Print #1,"COPPER_OK ";_COPPER_OK
   Print #1,"CLOSE_OK ";_CLOSE_OK
   Print #1,"END_READY ";_END_READY
   Print #1,"POST_END_OK ";_POST_OK
   Print #1,"BANK12_AT_START ";_BANK12_START
   Print #1,"BANK24_AT_START ";_BANK24_START
   Print #1,"CHIP_AFTER_EXPLICIT_CLOSE ";_BASE_CHIP
   Print #1,"FAST_AFTER_EXPLICIT_CLOSE ";_BASE_FAST
   Print #1,"CHIP_AFTER_END ";_POST_CHIP
   Print #1,"FAST_AFTER_END ";_POST_FAST
   Print #1,"CLOSED_MOUSE_X ";_CLOSED
   Print #1,"SWAP_RETRIES ";_RETRY
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
If _END_READY=1 and _IO=0
   End
End If
If _OPEN=1
   Gosub _CLEANUP
End If
Print "T14C ";_VERDICT$;" ERR ";_ERR;" LOG ";_LOG$
End
_PREPARE:
_PH=2
Reserve As Data 12,81920
If Length(12)<>81920
   _ERR=10 : Return
End If
For _I=0 To 81919
   Poke Start(12)+_I,90
Next _I
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=11 : Return
End If
If Aga Double Buffer<>1
   _ERR=12 : Return
End If
Amos To Back
_D=Aga C2P Open(12)
If _D<>1
   _ERR=13 : Return
End If
_D=Aga C2P Convert
If _D<>1
   _ERR=14 : Return
End If
_C2P_OK=_C2P_OK+1
_PH=3
_D=Aga Palette Set(90,0,40,80)
_E=Aga Palette Set(165,255,230,0)
_F=Aga Palette Set(1,255,255,255)
If _D<>1 or _E<>1 or _F<>1
   _ERR=20 : Return
End If
_D=Aga Font Select("topaz.font",9)
_E=Aga Font Select("topaz.font",0)
_F=Aga Text(24,60,1,"END TEST - LIVE FONT")
If _D<>1 or _E<>0 or _F<>1
   _ERR=21 : Return
End If
_FONT_OK=_FONT_OK+1
_D=Aga Blit Fill(16,16,16,16,165)
If _D<>1
   _ERR=22 : Return
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,31,31
If Length(24)<=32 or Length(24)>1024
   _ERR=23 : Return
End If
If Deek(Start(24)+8)<>1
   _ERR=24 : Return
End If
_D=Aga Blit Fill(16,16,16,16,90)
If _D<>1
   _ERR=25 : Return
End If
Aga Bob 1,96,100,1
If Aga I Bob(1)<>1 or Aga X Bob(1)<>96 or Aga Y Bob(1)<>100
   _ERR=26 : Return
End If
_PH=4
_C=Aga Copper Clear
_W=Aga Copper Wait(20,0)
_M=Aga Copper Move($180,$F00)
_E=Aga Copper End
If _C<>1 or _W<>1 or _M<>1 or _E<>1
   _ERR=30 : Return
End If
_D=Aga Copper On
If _D<>1
   _ERR=31 : Return
End If
_COPPER_OK=_COPPER_OK+1
_D=Aga Bob Update
If _D<>1
   _ERR=32 : Return
End If
_SW=Aga Swap
For _TRY=1 To 4
   If _SW<>1
      Aga Wait Vbl
      _RETRY=_RETRY+1
      _SW=Aga Swap
   End If
Next _TRY
If _SW<>1
   _ERR=33 : Return
End If
_BOB_OK=_BOB_OK+1 : _PREP=_PREP+1
For _I=1 To 10
   Aga Wait Vbl
Next _I
Return
_CHECK_CLOSED:
_CLOSED=Aga Mouse X
_D=Aga I Bob(1)
_E=Aga C2P Close
_F=Aga C2P Convert
_G=Aga Font Select("topaz.font",8)
If _CLOSED<>-1 or _D<>-32769 or _E<>0 or _F<>0 or _G<>0
   If _ERR=0
      _ERR=60
   End If
End If
Return
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   Amos To Front
   _CLOSED=Aga Mouse X
   If _CLOSED<>-1
      If _ERR=0
         _ERR=61
      End If
      Return
   End If
   _OPEN=0
   If _ERR=0
      Gosub _CHECK_CLOSED
      If _ERR=0
         _CLOSE_OK=_CLOSE_OK+1
      End If
   End If
End If
If _ERR=60 or _ERR=61
   Return
End If
Gosub _ERASE_BANKS
Return
_ERASE_BANKS:
If _OWN=1
   If Length(12)<>0
      Erase 12
   End If
   If Length(24)<>0
      Erase 24
   End If
End If
Return
