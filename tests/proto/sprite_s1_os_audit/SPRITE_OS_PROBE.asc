' M19 S1-P2d: automatic read-only OS sprite/copper audit on P1i.
' Fixed fixture only, NOT a generic AGSP reader or native P2a execution.
' Snapshot before running. Published AllocVec stays allocated until reset.
Set Buffer 20
Cls
_PRG=Prg State : _ERR=0 : _RESULT=0 : _OPEN=0 : _HIDDEN=0
_PTR=0 : _BANK_OWN=0 : _OWN=-1 : _GUARD=-1 : _EXPOSED=0
_ARMED=0 : _BLANK_SET=0 : _MOVES=0 : _CLOSED=0 : _FREES=0
_HELD=0 : _PAL_OK=0 : _SRC_ERASED=0 : _VBL_BLANK=0
_POST=0 : _SAMPLES=0 : _AUDIT_BAD=0 : _POSITIVE=0 : _BLANK_POS=0
_POST_REFS=0 : _FREE_REFS=-1 : _CLOSE_REFS=-1 : _FINAL_REFS=-1
Dim _CP(15),_SEEN(15),_SP(7),_ADDR(7)
_MODE$="UNKNOWN" : _LOG$="RAM:M19_S1P2D_OS_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_S1P2D_OS_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_S1P2D_OS_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_S1P2D_OS_COMPILED.TXT"
End If
If _PRG<>1
   Print "RUNTIME ONLY"
   End
End If
_CHIP0=Chip Free : _FAST0=Fast Free
_CPU=Deek(Leek(4)+296) and $FFFF
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO<>0
   Print "LOG OPEN FAILED ";_IO
   End
End If
Print #1,"SOURCE_TAG M19_S1P2D_OS_V1"
Print #1,"PRG_STATE ";_PRG
Print #1,"RUN_MODE ";_MODE$
Print #1,"CPU_ATTNFLAGS ";_CPU
Print #1,"CHIP_BEFORE ";_CHIP0;" FAST_BEFORE ";_FAST0
If Aga Detect=0
   _ERR=1
   Goto _CLEANUP
End If
If Length(29)<>0
   _ERR=2
   Goto _CLEANUP
End If
Trap Load "AGSP_S1P1E_FINAL.ABK",29
_IO=Errtrap
If Length(29)<>0
   _BANK_OWN=1
End If
If _IO<>0 or Length(29)<>512
   _ERR=3
   Goto _CLEANUP
End If
_SRC=Start(29)
_P=_SRC : _SIZE=512
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=4
   Goto _CLEANUP
End If
' Verify the exact known header and complete entry for ID 3.
If Leek(_SRC)<>$41475350 or Leek(_SRC+4)<>$10000 or Leek(_SRC+8)<>$30030
   _ERR=5
   Goto _CLEANUP
End If
If Leek(_SRC+12)<>32 or Leek(_SRC+16)<>176 or Leek(_SRC+20)<>512 or Leek(_SRC+24)<>5 or Leek(_SRC+28)<>0
   _ERR=5
   Goto _CLEANUP
End If
_ENT=_SRC+128
If Leek(_ENT)<>$30010 or Leek(_ENT+4)<>$100002 or Leek(_ENT+8)<>$20000
   _ERR=6
   Goto _CLEANUP
End If
If Leek(_ENT+12)<>400 or Leek(_ENT+16)<>64 or Leek(_ENT+20)<>464 or Leek(_ENT+24)<>48
   _ERR=6
   Goto _CLEANUP
End If
If Leek(_ENT+28)<>0 or Leek(_ENT+32)<>$30000 or Leek(_ENT+36)<>0 or Leek(_ENT+40)<>0 or Leek(_ENT+44)<>0
   _ERR=6
   Goto _CLEANUP
End If
' Validate exact pixels and palette for image 3 before copying.
For _ROW=0 To 15
   _V=$5555
   If (_ROW and 1)<>0
      _V=$AAAA
   End If
   If (Deek(_SRC+400+_ROW*2) and $FFFF)<>_V
      _ERR=7
   End If
   _V=$3333
   If (_ROW and 3)=1
      _V=$6666
   End If
   If (_ROW and 3)=2
      _V=$CCCC
   End If
   If (_ROW and 3)=3
      _V=$9999
   End If
   If (Deek(_SRC+432+_ROW*2) and $FFFF)<>_V
      _ERR=7
   End If
Next _ROW
If Leek(_SRC+464)<>$FF or Leek(_SRC+468)<>$462824DC or Leek(_SRC+472)<>$751A73FF
   _ERR=7
End If
If _ERR<>0
   Goto _CLEANUP
End If
' Exact P2b private allocation, no debugger marker needed.
' Exec allocation, NOT an AMOS bank: End/Erase must not reclaim DMA data.
Dreg(0)=244 : Dreg(1)=$10003
_PTR=Execall(-684)
If _PTR=0
   _ERR=8
   Goto _CLEANUP
End If
_P=_PTR : _SIZE=244
Gosub _RAM_SPAN
If _RAM_OK=0 or (_M0 and 2)=0 or (_M1 and 2)=0
   _ERR=9
   Goto _CLEANUP
End If
_IMAGE=_PTR+48 : _BLANK=_PTR+120 : _PAIR=_PTR+192 : _TAG=_PTR+204
Doke _PTR+4,16 : Doke _PTR+10,$FFFF
Loke _PTR+12,192 : Doke _PTR+16,3 : Doke _PTR+18,3
Loke _PTR+20,5 : Loke _PTR+40,48 : Loke _PTR+44,120
Doke _PAIR+4,16 : Doke _PAIR+10,$FFFF
For _I=0 To 11
   Poke _PTR+28+_I,Peek(_SRC+464+_I)
Next _I
For _ROW=0 To 15
   Doke _IMAGE+4+_ROW*4,Deek(_SRC+400+_ROW*2)
   Doke _IMAGE+6+_ROW*4,Deek(_SRC+432+_ROW*2)
Next _ROW
Erase 29
_BANK_OWN=0
If Length(29)<>0
   _ERR=10
   Goto _CLEANUP
End If
_SRC_ERASED=1
Print #1,"CHIP_BLOCK ";_PTR;" IMAGE ";_IMAGE;" BLANK ";_BLANK;" BYTES 244"
_OPEN=Aga Screen Open(320,256,256,$21000)
If _OPEN<>1
   _ERR=11
   Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=12
   Goto _CLEANUP
End If
_F=Aga Blit Fill(0,0,320,256,0)
If _F<>1
   _ERR=13
   Goto _CLEANUP
End If
_SW=Aga Swap
If _SW<>1
   _ERR=14
   Goto _CLEANUP
End If
Aga Wait Vbl
_A5=Areg(5) : _P=_A5+456 : _SIZE=4
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
_STATE=Leek(_A5+456) : _P=_STATE : _SIZE=40
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
_SCREEN=Leek(_STATE) : _WINDOW=Leek(_STATE+36) : _GFX=Leek(_STATE+8)
_P=_SCREEN : _SIZE=80
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
_P=_WINDOW : _SIZE=50
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
If Leek(_WINDOW+46)<>_SCREEN
   _ERR=15
   Goto _CLEANUP
End If
_P=_GFX : _SIZE=24
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
_VP=_SCREEN+44 : _CM=Leek(_VP+4)
If Deek(_GFX+20)<39 or (Deek(_VP+32) and $FFFF)<>$5000
   _ERR=16
   Goto _CLEANUP
End If
_P=_CM : _SIZE=52
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=16
   Goto _CLEANUP
End If
If Peek(_CM+1)<>2 or Deek(_CM+2)<>256
   _ERR=16
   Goto _CLEANUP
End If
_OK=Aga Mouse Cursor(0)
If _OK<>1
   _ERR=17
   Goto _CLEANUP
End If
_HIDDEN=1
Aga Wait Vbl
_PHASE=0 : Gosub _AUDIT
' Acquire both members of the palette pair, never commandeer cursor 0/1.
Areg(0)=_PTR : Dreg(0)=2
_GET=Gfxcall(-408) and $FFFF
If _GET<8
   _OWN=_GET : _EXPOSED=1
End If
If _GET<>2 or (Deek(_PTR+10) and $FFFF)<>2
   _ERR=18
   Goto _CLEANUP
End If
Areg(0)=_PAIR : Dreg(0)=3
_GET=Gfxcall(-408) and $FFFF
If _GET<8 and _GET<>_OWN
   _GUARD=_GET : _EXPOSED=1
End If
If _GET<>3 or (Deek(_PAIR+10) and $FFFF)<>3
   _ERR=19
   Goto _CLEANUP
End If
' Query again after channel acquisition. Only the measured mode accepted.
Loke _TAG,$80000028 : Loke _TAG+4,$6A5A5A5A
Loke _TAG+8,$80000029 : Loke _TAG+12,$6A5A5A5A
Loke _TAG+16,$80000032 : Loke _TAG+20,$6A5A5A5A
Loke _TAG+24,$80000034 : Loke _TAG+28,$6A5A5A5A
Loke _TAG+32,0 : Loke _TAG+36,0
Areg(0)=_CM : Areg(1)=_TAG
_RC=Gfxcall(-708)
Print #1,"VC_RC ";_RC;" EVEN ";Leek(_TAG+4);" ODD ";Leek(_TAG+12);" RES ";Leek(_TAG+20);" PRI ";Leek(_TAG+28)
If _RC<>0 or Leek(_TAG+4)<>16 or Leek(_TAG+12)<>16 or Leek(_TAG+20)<>255 or Leek(_TAG+28)<>4 or Peek(_CM+18)<>1
   _ERR=20
   Goto _CLEANUP
End If
_P0=Aga Palette Set(0,12,20,30)
If _P0<>1
   _ERR=21
   Goto _CLEANUP
End If
For _I=1 To 3
   _RGB=_PTR+28+_I*3
   _OK=Aga Palette Set(20+_I,Peek(_RGB),Peek(_RGB+1),Peek(_RGB+2))
   If _OK<>1
      _ERR=21
   End If
Next _I
If _ERR<>0
   Goto _CLEANUP
End If
Areg(0)=_CM : Dreg(0)=21 : Dreg(1)=3 : Areg(1)=_TAG
_IGNORE=Gfxcall(-900)
For _I=0 To 8
   If Peek(_TAG+_I*4)<>Peek(_PTR+31+_I)
      _ERR=22
   End If
Next _I
If _ERR<>0
   Goto _CLEANUP
End If
_PAL_OK=1
Print #1,"CHANNEL ";_OWN;" GUARD ";_GUARD;" PALETTE_FIRST 21"
' Only channel 2 is published; channel 3 is reserved, never displayed.
_ARMED=1
Areg(0)=_VP : Areg(1)=_PTR : Areg(2)=_IMAGE
_IGNORE=Gfxcall(-420)
Amos To Back
If Leek(_PTR)<>_IMAGE
   _ERR=23
   Goto _CLEANUP
End If
For _FRAME=1 To 100
   _X=30+_FRAME*2
   Areg(0)=_VP : Areg(1)=_PTR : Dreg(0)=_X : Dreg(1)=112
   _IGNORE=Gfxcall(-426)
   Aga Wait Vbl
   _MOVES=_MOVES+1
Next _FRAME
_PHASE=1 : Gosub _AUDIT
For _I=1 To 150
   Aga Wait Vbl
Next _I
_CLEANUP:
If _ARMED=1 and _OWN=2 and _OPEN=1
   Areg(0)=_VP : Areg(1)=_PTR : Areg(2)=_BLANK
   _IGNORE=Gfxcall(-420)
   If Leek(_PTR)=_BLANK
      _BLANK_SET=1
   Else
      If _ERR=0
         _ERR=24
      End If
   End If
   For _I=1 To 150
      Aga Wait Vbl
      _VBL_BLANK=_VBL_BLANK+1
   Next _I
   If _ERR=0
      _PHASE=2 : Gosub _AUDIT
   End If
End If
If _GUARD>=0
   Dreg(0)=_GUARD
   _IGNORE=Gfxcall(-414)
   _FREES=_FREES+1 : _GUARD=-1
End If
If _OWN>=0
   Dreg(0)=_OWN
   _IGNORE=Gfxcall(-414)
   _FREES=_FREES+1 : _OWN=-1
End If
If _ERR=0 and _FREES=2 and _OPEN=1
   _PHASE=3 : Gosub _AUDIT
End If
If _OPEN=1
   If _HIDDEN=1
      _OK=Aga Mouse Cursor(1)
      If _OK<>1 and _ERR=0
         _ERR=25
      End If
   End If
   Aga Screen Close
   _CLOSED=1
   Amos To Front
   For _I=1 To 3
      _IGNORE=Gfxcall(-270)
   Next _I
End If
Amos To Front
If _BANK_OWN=1
   Erase 29
End If
If _ERR=0 and _CLOSED=1 and _FREES=2 and _BLANK_SET=1 and _EXPOSED=1
   _PHASE=4 : Gosub _AUDIT
   For _I=1 To 60
      _IGNORE=Gfxcall(-270)
      _POST=_POST+1
   Next _I
   _PHASE=5 : Gosub _AUDIT
End If
If _PTR<>0
   If _EXPOSED=0
      Areg(1)=_PTR
      _IGNORE=Execall(-690)
   Else
      _HELD=244
   End If
End If
If _ERR=0 and _MOVES=100 and _FREES=2 and _BLANK_SET=1 and _CLOSED=1 and _HELD=244 and _SRC_ERASED=1 and _PAL_OK=1 and _POST=60 and _VBL_BLANK=150
   _RESULT=1
End If
If _ERR=0 and _RESULT=0
   _ERR=26
End If
_VERDICT$="FAIL_SEQUENCE"
If _RESULT=1
   _VERDICT$="INCONCLUSIVE_OS_REFS"
   If _AUDIT_BAD=0 and _SAMPLES=6 and _POSITIVE=1 and _BLANK_POS=1
      _VERDICT$="FAIL_OS_REFS_RETAINED"
      If _CLOSE_REFS=0 and _FINAL_REFS=0
         _VERDICT$="PASS_OS_REFERENCE_SNAPSHOTS_ONLY"
      End If
   End If
End If
Print #1,"SOURCE_ERASED ";_SRC_ERASED
Print #1,"PALETTE_OK ";_PAL_OK
Print #1,"MOVES ";_MOVES
Print #1,"BLANK_SET ";_BLANK_SET;" BLANK_VBL ";_VBL_BLANK
Print #1,"FREES ";_FREES;" CLOSE_RETURNED ";_CLOSED
_CHIP1=Chip Free : _FAST1=Fast Free
Print #1,"SAMPLES ";_SAMPLES;" AUDIT_BAD ";_AUDIT_BAD;" POST_WAITTOF ";_POST
Print #1,"ACTIVE_POSITIVE ";_POSITIVE;" BLANK_POSITIVE ";_BLANK_POS
Print #1,"FREE_REFS ";_FREE_REFS;" CLOSE_REFS ";_CLOSE_REFS;" FINAL_REFS ";_FINAL_REFS
Print #1,"CHIP_AFTER ";_CHIP1;" FAST_AFTER ";_FAST1
Print #1,"CHIP_HELD ";_HELD;" DMA_FREE_PROVEN 0"
Print #1,"RESULT ";_RESULT
Print #1,"ERR ";_ERR
Print #1,"VERDICT ";_VERDICT$
Trap Close 1
Print _VERDICT$;" ERR ";_ERR
Print _LOG$
Print "SAVE LOG: NO DEBUGGER NEEDED."
Print "RESTORE SNAPSHOT; DO NOT FREE THE BLOCK."
End
_RAM_SPAN:
_RAM_OK=0 : _M0=0 : _M1=0
If _P<4096 or (_P and 1)<>0 or _P>$7FFFFFFF-_SIZE
   Return
End If
Areg(1)=_P
_M0=Execall(-534)
Areg(1)=_P+_SIZE-1
_M1=Execall(-534)
If _M0<>0 and _M1<>0
   _RAM_OK=1
End If
Return

_AUDIT:
' GfxBase and copinit fixed NDK V39/V40 offsets. No writes to OS.
' No dereference of the active View or LOF/SHF pointers.
_SAMPLES=_SAMPLES+1
_P=_GFX : _SIZE=34
Gosub _RAM_SPAN
If _RAM_OK=0
   Goto _AUDIT_INVALID
End If
_GV=Deek(_GFX+20) and $FFFF
_GSIZE=Deek(_GFX+18) and $FFFF
If _GV<39 or _GV>40 or _GSIZE<212
   Goto _AUDIT_INVALID
End If
_P=_GFX : _SIZE=212
Gosub _RAM_SPAN
If _RAM_OK=0
   Goto _AUDIT_INVALID
End If
_AV=Leek(_GFX+34) : _CI=Leek(_GFX+38)
_LF=Leek(_GFX+50) : _SF=Leek(_GFX+54)
_RES=Peek(_GFX+166) and $FF : _SS=Leek(_GFX+208)
Print #1,"PHASE ";_PHASE;" GFXVER ";_GV;" RES ";_RES;" VIEW ";Hex$(_AV,8)
Print #1,"COPINIT ";Hex$(_CI,8);" LOF ";Hex$(_LF,8);" SHF ";Hex$(_SF,8);" TABLE ";Hex$(_SS,8)
_P=_CI : _SIZE=152
Gosub _RAM_SPAN
If _RAM_OK=0 or (_M0 and 2)=0 or (_M1 and 2)=0
   Goto _AUDIT_INVALID
End If
_P=_SS : _SIZE=32
Gosub _RAM_SPAN
If _RAM_OK=0
   Goto _AUDIT_INVALID
End If
For _AJ=0 To 15
   _SEEN(_AJ)=0 : _CP(_AJ)=0
Next _AJ
' sprstrtup: exactly 16 Copper MOVE pairs, 64 bytes at +88.
For _AJ=0 To 15
   _REG=Deek(_CI+88+_AJ*4) and $FFFF
   _VAL=Deek(_CI+90+_AJ*4) and $FFFF
   If _REG<$120 or _REG>$13E or (_REG and 1)<>0
      Print #1,"BAD_COP_REG ";_AJ;" ";Hex$(_REG,4)
      Goto _AUDIT_INVALID
   End If
   _SLOT=(_REG-$120)/2
   If _SEEN(_SLOT)<>0
      Goto _AUDIT_INVALID
   End If
   _SEEN(_SLOT)=1 : _CP(_SLOT)=_VAL
Next _AJ
_REFS=0 : _COP_REFS=0 : _TAB_REFS=0
For _AJ=0 To 7
   If _CP(_AJ*2)>$7FFF
      Goto _AUDIT_INVALID
   End If
   _ADDR(_AJ)=_CP(_AJ*2)*65536+_CP(_AJ*2+1)
   _SP(_AJ)=Leek(_SS+_AJ*4)
   If _ADDR(_AJ)>=_PTR and _ADDR(_AJ)<_PTR+244
      _COP_REFS=_COP_REFS+1
   End If
   If _SP(_AJ)>=_PTR and _SP(_AJ)<_PTR+244
      _TAB_REFS=_TAB_REFS+1
   End If
Next _AJ
' Reject a changing snapshot, without following unrelated descriptors.
If _CI<>Leek(_GFX+38) or _SS<>Leek(_GFX+208) or _RES<>(Peek(_GFX+166) and $FF)
   Goto _AUDIT_INVALID
End If
For _AJ=0 To 15
   _REG=Deek(_CI+88+_AJ*4) and $FFFF
   If _REG<$120 or _REG>$13E or (_REG and 1)<>0
      Goto _AUDIT_INVALID
   End If
   _SLOT=(_REG-$120)/2
   If _CP(_SLOT)<>(Deek(_CI+90+_AJ*4) and $FFFF)
      Goto _AUDIT_INVALID
   End If
Next _AJ
For _AJ=0 To 7
   If _SP(_AJ)<>Leek(_SS+_AJ*4)
      Goto _AUDIT_INVALID
   End If
Next _AJ
For _AJ=0 To 7
   Print #1,"SPR ";_AJ;" COP ";Hex$(_ADDR(_AJ),8);" DESC ";Hex$(_SP(_AJ),8)
Next _AJ
_REFS=_COP_REFS+_TAB_REFS
Print #1,"PHASE_REFS ";_PHASE;" COP ";_COP_REFS;" DESC ";_TAB_REFS
If _PHASE=1
   If (_RES and 12)=12 and _ADDR(2)=_IMAGE and _SP(2)=_PTR and _SP(3)=_PAIR
      _POSITIVE=1
   End If
End If
If _PHASE=2
   If _ADDR(2)=_BLANK and _SP(2)=_PTR
      _BLANK_POS=1
   End If
End If
If _PHASE=3
   _FREE_REFS=_REFS
End If
If _PHASE=4
   _CLOSE_REFS=_REFS
End If
If _PHASE=5
   _FINAL_REFS=_REFS
End If
Return
_AUDIT_INVALID:
_AUDIT_BAD=_AUDIT_BAD+1
Print #1,"AUDIT_INVALID PHASE ";_PHASE
Return
