   Print #1,"FLIP_PIXEL_ID ";_FLIP_PIXEL_ID
   Print #1,"FLIP_PIXEL_VALUE ";_FLIP_PIXEL_VALUE
   Print #1,"FLIP_PIXEL_EXPECTED ";_FLIP_PIXEL_EXPECTED
   Print #1,"FLIP_PIXEL_MODE ";_FLIP_PIXEL_MODE
   Print #1,"PLANES_STAGES ";_PLANES_STAGES
