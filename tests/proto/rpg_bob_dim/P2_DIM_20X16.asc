   Print #1,"FLIP_MODE0_LAST ";_FLIP_MODE0
   Print #1,"FLIP_MODE1_LAST ";_FLIP_MODE1
   Print #1,"FLIP_RET0 ";_FLIP_RET0
   Print #1,"FLIP_RET1 ";_FLIP_RET1
