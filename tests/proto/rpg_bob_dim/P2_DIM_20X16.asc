' P2d dimensions differential: verified P2_ALL_IN_ONE phase 1 only
' Keep real Bob Auto Update and 240 AMAL frames. No RPG IFF, no external ABK.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _OPEN=0 : _ERR=0 : _OK=0
_SYNCHRO_OFF=0 : _AMAL0_ON=0 : _AMAL1_ON=0 : _CLOSE_RETURNED=0
_VALID=0 : _SWAPS=0 : _PIX0=0 : _PIX1=0
_BG0=0 : _BG1=0 : _SWAP=0 : _FRAME=0
_SWAP_REFUSALS=0 : _SWAP_RECOVERED=0 : _RETRY_VBLS=0
_SWAP_FIRST_FAIL_FRAME=0 : _SWAP_LAST_FAIL_FRAME=0
_SWAP_LAST_TRIES=0 : _SWAP_RETRY_LIMIT=4
_PH=1 : _LAST_REFUSAL_PHASE=0
_COL_CHECKS=0 : _COL_RECT=0 : _COL_MASK=0 : _COL_BAD=-99
_COL_RECT_ONLY=0 : _COL_MASK_ONLY=0 : _COL_FAR_RECT=0
_COL_FAR_MASK=0 : _COL_UNCHANGED=0 : _COL_PLANES_RET=0
_FLIP_STAGES=0 : _FLIP_CALLS=0 : _FLIP_SWAPS=0
_FLIP_PIX0=0 : _FLIP_PIX1=0 : _FLIP_HOLD_VBLS=45
_FLIP_STAGE_LAST=-1 : _FLIP_BADMODE=-99
_FLIP_PIXEL_ID=0 : _FLIP_PIXEL_VALUE=-1 : _FLIP_PIXEL_EXPECTED=0
_FLIP_PIXEL_MODE=-1 : _FLIP_RET0=0 : _FLIP_RET1=0
_FLIP_MODE0=0 : _FLIP_MODE1=0
_PLANES_STAGES=0 : _PLANES_SWAPS=0
_PLANES_PIX0=0 : _PLANES_PIX1=0 : _PLANES_HOLD_VBLS=40
_PLANES_STAGE_LAST=-1 : _PLANES_BAD1=-99 : _PLANES_BAD2=-99
_PLANES_PIXEL_ID=0 : _PLANES_PIXEL_VALUE=-1 : _PLANES_PIXEL_EXPECTED=0
_PLANES_RET0=0 : _PLANES_RET1=0
_PLANES_MASK0=255 : _PLANES_MASK1=255
_AUTO_OFF=0
_CHG0X=0 : _CHG0Y=0 : _CHG0A=0 : _CHG1X=0 : _CHG1Y=0 : _CHG1A=0
_SEEN01=0 : _SEEN02=0 : _SEEN11=0 : _SEEN12=0
_FLAG0_X=0 : _FLAG0_Y=0 : _FLAG0_A=0
_FLAG1_X=0 : _FLAG1_Y=0 : _FLAG1_A=0
_OLD_VALID=0 : _PREV_VALID=0 : _PIX_ID=0 : _PIX_EXPECTED=0 : _VALUE=-1
_LOG$="RAM:P2_DIM20X16_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:P2_DIM20X16_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:P2_DIM20X16_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:P2_DIM20X16_COMPILED.TXT"
End If
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(24)<>0 or Length(27)<>0 or Length(28)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
' Visible palette for both 16x16 AMAL and 32x32 P2 showcase glyphs.
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(165,255,176,48)
_P2=Aga Palette Set(90,56,208,255)
_P3=Aga Palette Set(1,255,64,64)
_P4=Aga Palette Set(2,64,255,96)
_P5=Aga Palette Set(129,255,232,72)
_P6=Aga Palette Set(66,168,92,245)
If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
   _ERR=29 : Goto _CLEANUP
End If
If _P4<>1 or _P5<>1 or _P6<>1
   _ERR=29 : Goto _CLEANUP
End If
' Asymmetric 16x16 F / L silhouettes, pen 0 transparent.
' Both have a visible top-left pixel for the existing pixel oracle.
_A=Aga Blit Fill(16,16,48,18,0)
_B=Aga Blit Fill(16,16,3,16,165)
_C=Aga Blit Fill(19,16,12,3,165)
_D=Aga Blit Fill(19,22,9,3,165)
_E=Aga Blit Fill(48,16,3,16,90)
_F=Aga Blit Fill(51,29,13,3,90)
If _A<>1 or _B<>1 or _C<>1 or _D<>1 or _E<>1 or _F<>1
   _ERR=5 : Goto _CLEANUP
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,35,31
Get AGA Bob 2,48,16,63,31
Make AGA Bob Mask 1,0
Make AGA Bob Mask 2,0
' Larger asymmetric 32x32 F/L frames for visible Flip/Planes phases.
_A=Aga Blit Fill(80,16,32,32,0)
_B=Aga Blit Fill(80,16,6,32,165)
_C=Aga Blit Fill(86,16,26,6,165)
_D=Aga Blit Fill(86,28,16,6,165)
_E=Aga Blit Fill(103,17,5,4,90)
_F=Aga Blit Fill(128,16,32,32,0)
_G=Aga Blit Fill(128,16,6,32,90)
_H=Aga Blit Fill(134,42,26,6,90)
_J=Aga Blit Fill(147,43,5,4,165)
If _A<>1 or _B<>1 or _C<>1 or _D<>1 or _E<>1
   _ERR=5 : Goto _CLEANUP
End If
If _F<>1 or _G<>1 or _H<>1 or _J<>1
   _ERR=5 : Goto _CLEANUP
End If
Get AGA Bob 3,80,16,111,47
Get AGA Bob 4,128,16,159,47
Make AGA Bob Mask 3,0
Make AGA Bob Mask 4,0
If Length(24)<=32
   _ERR=6 : Goto _CLEANUP
End If
_A=Aga Blit Fill(16,16,144,32,0)
If _A<>1
   _ERR=7 : Goto _CLEANUP
End If
_PROBE=Aga C Block Capture(27,96,100,8,1,0)
If _PROBE<>1 or Length(27)<>56
   _ERR=8 : Goto _CLEANUP
End If
' 8 bytes per channel; neither channel owns an AGA or OCS Bob.
Reserve As Data 28,16
If Length(28)<>16
   _ERR=9 : Goto _CLEANUP
End If
_ADDR0=Start(28) : _ADDR1=_ADDR0+8
If (_ADDR0 and 1)<>0 or (_ADDR1 and 1)<>0
   _ERR=10 : Goto _CLEANUP
End If
For _W=0 To 7
   Doke _ADDR0+_W*2,0
Next _W
' Initialize both physical backgrounds before any Bob SET.
_BG0=Aga Blit Fill(88,88,160,112,0)
If _BG0<>1
   _ERR=22 : Goto _CLEANUP
End If
_MODE=Aga Bob Auto Update(1)
If _MODE<>1
   _ERR=11 : Goto _CLEANUP
End If
_SWAP=Aga Swap
If _SWAP<>1
   _ERR=12 : Goto _CLEANUP
End If
_SWAPS=_SWAPS+1
Aga Wait Vbl
_BG1=Aga Blit Fill(88,88,160,112,0)
If _BG1<>1
   _ERR=23 : Goto _CLEANUP
End If
' Put the private AGA Intuition screen ahead of the native AMOS screen.
Amos To Back
' Manual synchronous AMAL: one Synchro advances both channels.
_SYNCHRO_OFF=1
Synchro Off
_AMAL0$="Let X=96; Let Y=100; Let A=1; Loop: Move 32,16,32; Let A=2;"
_AMAL0$=_AMAL0$+"Move -32,-16,32; Let A=1; Jump Loop"
_AMAL1$="Let X=192; Let Y=160; Let A=2; Loop: Move 32,-16,32; Let A=1;"
_AMAL1$=_AMAL1$+"Move -32,16,32; Let A=2; Jump Loop"
Amal 0,_AMAL0$ To _ADDR0
Amal 1,_AMAL1$ To _ADDR1
Amal On 0
_AMAL0_ON=1
Amal On 1
_AMAL1_ON=1
Aga Bob Bank 24
For _FRAME=1 To 240
   Synchro
   _RAW0=Deek(_ADDR0) : _RAW1=Deek(_ADDR1)
   _BYTE0=Peek(_ADDR0) : _BYTE1=Peek(_ADDR1)
   If (_BYTE0 and 1)<>0
      _FLAG0_X=_FLAG0_X+1
   End If
   If (_BYTE0 and 2)<>0
      _FLAG0_Y=_FLAG0_Y+1
   End If
   If (_BYTE0 and 4)<>0
      _FLAG0_A=_FLAG0_A+1
   End If
   If (_BYTE1 and 1)<>0
      _FLAG1_X=_FLAG1_X+1
   End If
   If (_BYTE1 and 2)<>0
      _FLAG1_Y=_FLAG1_Y+1
   End If
   If (_BYTE1 and 4)<>0
      _FLAG1_A=_FLAG1_A+1
   End If
   _X0=Deek(_ADDR0+2) : _Y0=Deek(_ADDR0+4) : _I0=Deek(_ADDR0+6)
   _X1=Deek(_ADDR1+2) : _Y1=Deek(_ADDR1+4) : _I1=Deek(_ADDR1+6)
   If _X0>=32768
      _X0=_X0-65536
   End If
   If _Y0>=32768
      _Y0=_Y0-65536
   End If
   If _X1>=32768
      _X1=_X1-65536
   End If
   If _Y1>=32768
      _Y1=_Y1-65536
   End If
   If (_I0=1 or _I0=2) and (_I1=1 or _I1=2)
      If _X0<96 or _X0>128 or _Y0<100 or _Y0>116
         _ERR=13 : Goto _CLEANUP
      End If
      If _X1<192 or _X1>224 or _Y1<144 or _Y1>160
         _ERR=13 : Goto _CLEANUP
      End If
      If _OLD_VALID=1
         If _X0<>_OLDX0
            _CHG0X=_CHG0X+1
         End If
         If _Y0<>_OLDY0
            _CHG0Y=_CHG0Y+1
         End If
         If _I0<>_OLDI0
            _CHG0A=_CHG0A+1
         End If
         If _X1<>_OLDX1
            _CHG1X=_CHG1X+1
         End If
         If _Y1<>_OLDY1
            _CHG1Y=_CHG1Y+1
         End If
         If _I1<>_OLDI1
            _CHG1A=_CHG1A+1
         End If
      End If
      _OLDX0=_X0 : _OLDY0=_Y0 : _OLDI0=_I0
      _OLDX1=_X1 : _OLDY1=_Y1 : _OLDI1=_I1 : _OLD_VALID=1
      If _I0=1
         _SEEN01=1 : _EXPECT0=165
      Else
         _SEEN02=1 : _EXPECT0=90
      End If
      If _I1=1
         _SEEN11=1 : _EXPECT1=165
      Else
         _SEEN12=1 : _EXPECT1=90
      End If
      Aga Bob 1,_X0,_Y0,_I0
      Aga Bob 2,_X1,_Y1,_I1
      _BX=Aga X Bob(1) : _BY=Aga Y Bob(1) : _BI=Aga I Bob(1)
      If _BX<>_X0 or _BY<>_Y0 or _BI<>_I0
         _ERR=14 : Goto _CLEANUP
      End If
      _BX=Aga X Bob(2) : _BY=Aga Y Bob(2) : _BI=Aga I Bob(2)
      If _BX<>_X1 or _BY<>_Y1 or _BI<>_I1
         _ERR=14 : Goto _CLEANUP
      End If
      _SWAP=Aga Swap
      If _SWAP<>1
         ' Keep the first refusal visible; retry only after a full VBL.
         ' READY can recover; B8 DIRTY must remain refused.
         _SWAP_REFUSALS=_SWAP_REFUSALS+1
         If _SWAP_FIRST_FAIL_FRAME=0
            _SWAP_FIRST_FAIL_FRAME=_FRAME
         End If
         _SWAP_LAST_FAIL_FRAME=_FRAME
         _LAST_REFUSAL_PHASE=_PH
         _SWAP_LAST_TRIES=0
         For _WAIT_TRY=1 To _SWAP_RETRY_LIMIT
            If _SWAP<>1
               Aga Wait Vbl
               _RETRY_VBLS=_RETRY_VBLS+1
               _SWAP_LAST_TRIES=_WAIT_TRY
               _SWAP=Aga Swap
            End If
         Next _WAIT_TRY
         If _SWAP=1
            _SWAP_RECOVERED=_SWAP_RECOVERED+1
         Else
            _ERR=15 : Goto _CLEANUP
         End If
      End If
      _SWAPS=_SWAPS+1
      Aga Wait Vbl
      ' C Block Capture sees the prior displayed frame in the new back.
      If _PREV_VALID=1
         If (_PREVX0 and 7)=0
            _CAP=Aga C Block Capture(27,_PREVX0,_PREVY0,8,1,0)
            If _CAP<>1 or Length(27)<>56
               _ERR=16 : Goto _CLEANUP
            End If
            _PTR=Start(27)+40 : _VALUE=0 : _POWER=1
            For _PLANE=0 To 7
               If (Peek(_PTR+2*_PLANE) and 128)<>0
                  _VALUE=_VALUE+_POWER
               End If
               _POWER=_POWER*2
            Next _PLANE
            If _VALUE<>_PREVEXP0
               _PIX_ID=1 : _PIX_EXPECTED=_PREVEXP0
               _ERR=17 : Goto _CLEANUP
            End If
            _PIX0=_PIX0+1
         End If
         If (_PREVX1 and 7)=0
            _CAP=Aga C Block Capture(27,_PREVX1,_PREVY1,8,1,0)
            If _CAP<>1 or Length(27)<>56
               _ERR=16 : Goto _CLEANUP
            End If
            _PTR=Start(27)+40 : _VALUE=0 : _POWER=1
            For _PLANE=0 To 7
               If (Peek(_PTR+2*_PLANE) and 128)<>0
                  _VALUE=_VALUE+_POWER
               End If
               _POWER=_POWER*2
            Next _PLANE
            If _VALUE<>_PREVEXP1
               _PIX_ID=2 : _PIX_EXPECTED=_PREVEXP1
               _ERR=17 : Goto _CLEANUP
            End If
            _PIX1=_PIX1+1
         End If
      End If
      _PREVX0=_X0 : _PREVY0=_Y0 : _PREVEXP0=_EXPECT0
      _PREVX1=_X1 : _PREVY1=_Y1 : _PREVEXP1=_EXPECT1
      _PREV_VALID=1 : _VALID=_VALID+1
   Else
      If _VALID<>0
         _ERR=18 : Goto _CLEANUP
      End If
   End If
Next _FRAME
If _VALID<200 or _PIX0<2 or _PIX1<2
   _ERR=19
End If
If _CHG0X=0 or _CHG0Y=0 or _CHG0A=0
   _ERR=20
End If
If _CHG1X=0 or _CHG1Y=0 or _CHG1A=0
   _ERR=20
End If
If _SEEN01=0 or _SEEN02=0 or _SEEN11=0 or _SEEN12=0
   _ERR=21
End If
' End comparison after the 240-frame P2d phase. Later pixel oracles are
' intentionally excluded because changing Bob geometry changes their inputs.
Goto _CLEANUP
' P2a: collision rectangle vs opaque mask, independent of P2c planes.
If _ERR=0
   If _AMAL1_ON=1
      Amal Off 1
      _AMAL1_ON=0
   End If
   If _AMAL0_ON=1
      Amal Off 0
      _AMAL0_ON=0
   End If
   If _SYNCHRO_OFF=1
      Synchro On
      _SYNCHRO_OFF=0
   End If
   _PH=2
   _FRET0=Aga Bob Flip(1,0)
   _FRET1=Aga Bob Flip(2,0)
   If _FRET0<>1 or _FRET1<>1
      _ERR=30 : Goto _CLEANUP
   End If
   ' Case 1: same origin: vertical strokes actually intersect.
   Aga Bob 1,96,110,1
   Aga Bob 2,96,110,2
   _COL_RECT=Aga Bob Col(1,2,0)
   _COL_MASK=Aga Bob Col(1,2,1)
   If _COL_RECT<>1 or _COL_MASK<>1
      _ERR=31 : Goto _CLEANUP
   End If
   _COL_CHECKS=_COL_CHECKS+2
   ' Case 2: rectangles intersect, colored pixels do not.
   Aga Bob 2,108,122,2
   _COL_RECT_ONLY=Aga Bob Col(1,2,0)
   _COL_MASK_ONLY=Aga Bob Col(1,2,1)
   If _COL_RECT_ONLY<>1 or _COL_MASK_ONLY<>0
      _ERR=32 : Goto _CLEANUP
   End If
   _COL_CHECKS=_COL_CHECKS+2
   ' Case 3: no rectangle intersection.
   Aga Bob 2,192,150,2
   _COL_FAR_RECT=Aga Bob Col(1,2,0)
   _COL_FAR_MASK=Aga Bob Col(1,2,1)
   If _COL_FAR_RECT<>0 or _COL_FAR_MASK<>0
      _ERR=33 : Goto _CLEANUP
   End If
   _COL_CHECKS=_COL_CHECKS+2
   _COL_BAD=Aga Bob Col(1,2,2)
   If _COL_BAD<>-1
      _ERR=34 : Goto _CLEANUP
   End If
   _COL_CHECKS=_COL_CHECKS+1
   ' P2c plane mask 0 must NOT change a P2a geometry collision.
   Aga Bob 2,96,110,2
   _SET0=Aga Bob Planes(1,0)
   _SET1=Aga Bob Planes(2,0)
   _COL_UNCHANGED=Aga Bob Col(1,2,1)
   If _SET0<>1 or _SET1<>1 or _COL_UNCHANGED<>1
      _ERR=35 : Goto _CLEANUP
   End If
   _COL_CHECKS=_COL_CHECKS+1
   _SET0=Aga Bob Planes(1,255)
   _SET1=Aga Bob Planes(2,255)
   _COL_PLANES_RET=_SET0+_SET1
   If _SET0<>1 or _SET1<>1
      _ERR=36 : Goto _CLEANUP
   End If
   If _COL_CHECKS<>8
      _ERR=37 : Goto _CLEANUP
   End If
End If
' P2b: four actual visible orientations, with pixel-exact probes.
If _ERR=0
   _PH=3
   _BASE0X=80 : _BASE0Y=115 : _BASE1X=208 : _BASE1Y=115
   ' Modes 0..3 for Bob1 and complementary modes for Bob2.
   ' Extra stage 4 makes stage 3 available for a back-buffer capture.
   For _FLIP_STAGE=0 To 4
      _FLIP_STAGE_LAST=_FLIP_STAGE
      If _FLIP_STAGE<4
         _FLIP_MODE0=_FLIP_STAGE : _FLIP_MODE1=3-_FLIP_STAGE
         _DRAW0X=_BASE0X : _DRAW0Y=_BASE0Y
         _DRAW1X=_BASE1X : _DRAW1Y=_BASE1Y
         If (_FLIP_MODE0 and 1)<>0
            _DRAW0X=_DRAW0X+31
         End If
         If (_FLIP_MODE0 and 2)<>0
            _DRAW0Y=_DRAW0Y+31
         End If
         If (_FLIP_MODE1 and 1)<>0
            _DRAW1X=_DRAW1X+31
         End If
         If (_FLIP_MODE1 and 2)<>0
            _DRAW1Y=_DRAW1Y+31
         End If
         Aga Bob 1,_DRAW0X,_DRAW0Y,3
         Aga Bob 2,_DRAW1X,_DRAW1Y,4
         _FLIP_RET0=Aga Bob Flip(1,_FLIP_MODE0)
         _FLIP_RET1=Aga Bob Flip(2,_FLIP_MODE1)
         If _FLIP_RET0<>1 or _FLIP_RET1<>1
            _ERR=40 : Goto _CLEANUP
         End If
         _FLIP_CALLS=_FLIP_CALLS+2
         _FLIP_STAGES=_FLIP_STAGES+1
      End If
      _SWAP=Aga Swap
      If _SWAP<>1
         _SWAP_REFUSALS=_SWAP_REFUSALS+1
         If _SWAP_FIRST_FAIL_FRAME=0
            _SWAP_FIRST_FAIL_FRAME=241+_FLIP_STAGE
         End If
         _SWAP_LAST_FAIL_FRAME=241+_FLIP_STAGE
         _LAST_REFUSAL_PHASE=_PH
         _SWAP_LAST_TRIES=0
         For _WAIT_TRY=1 To _SWAP_RETRY_LIMIT
            If _SWAP<>1
               Aga Wait Vbl
               _RETRY_VBLS=_RETRY_VBLS+1
               _SWAP_LAST_TRIES=_WAIT_TRY
               _SWAP=Aga Swap
            End If
         Next _WAIT_TRY
         If _SWAP=1
            _SWAP_RECOVERED=_SWAP_RECOVERED+1
         Else
            _ERR=41 : Goto _CLEANUP
         End If
      End If
      _SWAPS=_SWAPS+1 : _FLIP_SWAPS=_FLIP_SWAPS+1
      Aga Wait Vbl
      If _FLIP_STAGE>0
         ' The previous displayed frame is now in the back buffer.
         ' F probes: left stem (H-sensitive), lower bar (V-sensitive).
         ' L probes: stem, lower-left, lower-right.
         For _FLIP_TEST=1 To 5
            _FP_MASK=128
            If _FLIP_TEST=1
               _FPX=_BASE0X : _FPY=_BASE0Y+7
               _FEXP=165
               If (_PREV_FLIP_MODE0 and 1)<>0
                  _FEXP=0
               End If
               _FTEST_MODE=_PREV_FLIP_MODE0
            End If
            If _FLIP_TEST=2
               _FPX=_BASE0X+16 : _FPY=_BASE0Y+31
               _FEXP=0
               If (_PREV_FLIP_MODE0 and 2)<>0
                  _FEXP=165
               End If
               _FTEST_MODE=_PREV_FLIP_MODE0
            End If
            If _FLIP_TEST=3
               _FPX=_BASE1X : _FPY=_BASE1Y+7
               _FEXP=90
               If (_PREV_FLIP_MODE1 and 1)<>0
                  _FEXP=0
               End If
               _FTEST_MODE=_PREV_FLIP_MODE1
            End If
            If _FLIP_TEST=4
               _FPX=_BASE1X : _FPY=_BASE1Y+31
               _FEXP=90
               If _PREV_FLIP_MODE1=3
                  _FEXP=0
               End If
               _FTEST_MODE=_PREV_FLIP_MODE1
            End If
            If _FLIP_TEST=5
               _FPX=_BASE1X+31 : _FPY=_BASE1Y+31
               _FEXP=90
               If _PREV_FLIP_MODE1=2
                  _FEXP=0
               End If
               _FTEST_MODE=_PREV_FLIP_MODE1
            End If
            _FCAPX=_FPX-(_FPX and 7)
            If (_FPX and 7)=7
               _FP_MASK=1
            End If
            _CAP=Aga C Block Capture(27,_FCAPX,_FPY,8,1,0)
            If _CAP<>1 or Length(27)<>56
               _FLIP_PIXEL_ID=_FLIP_TEST
               _FLIP_PIXEL_MODE=_FTEST_MODE
               _ERR=42 : Goto _CLEANUP
            End If
            _PTR=Start(27)+40 : _FP_VALUE=0 : _POWER=1
            For _PLANE=0 To 7
               If (Peek(_PTR+2*_PLANE) and _FP_MASK)<>0
                  _FP_VALUE=_FP_VALUE+_POWER
               End If
               _POWER=_POWER*2
            Next _PLANE
            If _FP_VALUE<>_FEXP
               _FLIP_PIXEL_ID=_FLIP_TEST
               _FLIP_PIXEL_VALUE=_FP_VALUE
               _FLIP_PIXEL_EXPECTED=_FEXP
               _FLIP_PIXEL_MODE=_FTEST_MODE
               _ERR=43 : Goto _CLEANUP
            End If
            If _FLIP_TEST<=2
               _FLIP_PIX0=_FLIP_PIX0+1
            Else
               _FLIP_PIX1=_FLIP_PIX1+1
            End If
         Next _FLIP_TEST
      End If
      If _FLIP_STAGE<4
         _PREV_FLIP_MODE0=_FLIP_MODE0
         _PREV_FLIP_MODE1=_FLIP_MODE1
         For _HOLD=1 To _FLIP_HOLD_VBLS
            Aga Wait Vbl
         Next _HOLD
      End If
   Next _FLIP_STAGE
   If _FLIP_STAGES<>4 or _FLIP_CALLS<>8 or _FLIP_SWAPS<>5
      _ERR=44 : Goto _CLEANUP
   End If
   If _FLIP_PIX0<>8 or _FLIP_PIX1<>12
      _ERR=44 : Goto _CLEANUP
   End If
   _FLIP_BADMODE=Aga Bob Flip(1,4)
   If _FLIP_BADMODE<>0
      _ERR=45 : Goto _CLEANUP
   End If
End If
' P2c: test destination-plane selection on both F32/L32 Bobs.
If _ERR=0
   _PH=4
   Aga Bob 1,_BASE0X,_BASE0Y,3
   Aga Bob 2,_BASE1X,_BASE1Y,4
   _FRET0=Aga Bob Flip(1,0)
   _FRET1=Aga Bob Flip(2,0)
   If _FRET0<>1 or _FRET1<>1
      _ERR=50 : Goto _CLEANUP
   End If
   ' Masks: full color, two single planes, invisible, mixed, full again.
   ' Stage 5 is a final Swap to inspect stage 4 in the new back.
   For _PLANES_STAGE=0 To 5
      _PLANES_STAGE_LAST=_PLANES_STAGE
      If _PLANES_STAGE<5
         _PLANES_MASK0=255 : _PLANES_MASK1=255
         If _PLANES_STAGE=1
            _PLANES_MASK0=1 : _PLANES_MASK1=2
         End If
         If _PLANES_STAGE=2
            _PLANES_MASK0=0 : _PLANES_MASK1=0
         End If
         If _PLANES_STAGE=3
            _PLANES_MASK0=129 : _PLANES_MASK1=66
         End If
         _PLANES_RET0=Aga Bob Planes(1,_PLANES_MASK0)
         _PLANES_RET1=Aga Bob Planes(2,_PLANES_MASK1)
         If _PLANES_RET0<>1 or _PLANES_RET1<>1
            _ERR=51 : Goto _CLEANUP
         End If
         _PLANES_STAGES=_PLANES_STAGES+1
      End If
      _SWAP=Aga Swap
      If _SWAP<>1
         _SWAP_REFUSALS=_SWAP_REFUSALS+1
         If _SWAP_FIRST_FAIL_FRAME=0
            _SWAP_FIRST_FAIL_FRAME=246+_PLANES_STAGE
         End If
         _SWAP_LAST_FAIL_FRAME=246+_PLANES_STAGE
         _LAST_REFUSAL_PHASE=_PH
         _SWAP_LAST_TRIES=0
         For _WAIT_TRY=1 To _SWAP_RETRY_LIMIT
            If _SWAP<>1
               Aga Wait Vbl
               _RETRY_VBLS=_RETRY_VBLS+1
               _SWAP_LAST_TRIES=_WAIT_TRY
               _SWAP=Aga Swap
            End If
         Next _WAIT_TRY
         If _SWAP=1
            _SWAP_RECOVERED=_SWAP_RECOVERED+1
         Else
            _ERR=52 : Goto _CLEANUP
         End If
      End If
      _SWAPS=_SWAPS+1 : _PLANES_SWAPS=_PLANES_SWAPS+1
      Aga Wait Vbl
      If _PLANES_STAGE>0
         ' Read one guaranteed-opaque original-source pixel per Bob.
         For _PLANES_TEST=1 To 2
            _PPX=_BASE0X : _PPY=_BASE0Y+7
            _PEXP=_PREV_PLANES_EXP0
            If _PLANES_TEST=2
               _PPX=_BASE1X : _PPY=_BASE1Y+7
               _PEXP=_PREV_PLANES_EXP1
            End If
            _CAP=Aga C Block Capture(27,_PPX,_PPY,8,1,0)
            If _CAP<>1 or Length(27)<>56
               _PLANES_PIXEL_ID=_PLANES_TEST
               _ERR=53 : Goto _CLEANUP
            End If
            _PTR=Start(27)+40 : _PP_VALUE=0 : _POWER=1
            For _PLANE=0 To 7
               If (Peek(_PTR+2*_PLANE) and 128)<>0
                  _PP_VALUE=_PP_VALUE+_POWER
               End If
               _POWER=_POWER*2
            Next _PLANE
            If _PP_VALUE<>_PEXP
               _PLANES_PIXEL_ID=_PLANES_TEST
               _PLANES_PIXEL_VALUE=_PP_VALUE
               _PLANES_PIXEL_EXPECTED=_PEXP
               _ERR=54 : Goto _CLEANUP
            End If
            If _PLANES_TEST=1
               _PLANES_PIX0=_PLANES_PIX0+1
            Else
               _PLANES_PIX1=_PLANES_PIX1+1
            End If
         Next _PLANES_TEST
      End If
      If _PLANES_STAGE<5
         _PREV_PLANES_EXP0=165 and _PLANES_MASK0
         _PREV_PLANES_EXP1=90 and _PLANES_MASK1
         For _HOLD=1 To _PLANES_HOLD_VBLS
            Aga Wait Vbl
         Next _HOLD
      End If
   Next _PLANES_STAGE
   If _PLANES_STAGES<>5 or _PLANES_SWAPS<>6
      _ERR=55 : Goto _CLEANUP
   End If
   If _PLANES_PIX0<>5 or _PLANES_PIX1<>5
      _ERR=55 : Goto _CLEANUP
   End If
   _PLANES_BAD1=Aga Bob Planes(1,-1)
   _PLANES_BAD2=Aga Bob Planes(2,256)
   If _PLANES_BAD1<>0 or _PLANES_BAD2<>0
      _ERR=56 : Goto _CLEANUP
   End If
   ' P2d: verify the optional auto mode returns to manual cleanly.
   _AUTO_OFF=Aga Bob Auto Update(0)
   If _AUTO_OFF<>1
      _ERR=57 : Goto _CLEANUP
   End If
End If
_CLEANUP:
If _AMAL1_ON=1
   Amal Off 1
End If
If _AMAL0_ON=1
   Amal Off 0
End If
If _SYNCHRO_OFF=1
   Synchro On
End If
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
End If
If Length(28)<>0
   Erase 28
End If
If Length(27)<>0
   Erase 27
End If
If Length(24)<>0
   Erase 24
End If
If _ERR=0 and _CLOSE_RETURNED=1
   _OK=1
End If
_VERDICT$="FAIL"
If _OK=1
   _VERDICT$="PASS"
End If
Print "P2 BOB DIM 20X16 ";_VERDICT$;" ERR ";_ERR
Print "AMAL ";_VALID;" COLLISIONS ";_COL_CHECKS
Print "FLIP PIXELS ";_FLIP_PIX0+_FLIP_PIX1
Print "PLANES PIXELS ";_PLANES_PIX0+_PLANES_PIX1
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 P2 DIM 20X16"
   Print #1,"SOURCE_TAG P2_DIM_20X16_FROM_P2_FULL_20261123"
   Print #1,"BOB1_WIDTH 20"
   Print #1,"BOB1_HEIGHT 16"
   Print #1,"PHASE_LAST ";_PH
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
