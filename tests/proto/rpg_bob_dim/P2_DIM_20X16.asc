   Print #1,"PLANES_PIX0 ";_PLANES_PIX0
   Print #1,"PLANES_PIX1 ";_PLANES_PIX1
   Print #1,"PLANES_HOLD_VBLS ";_PLANES_HOLD_VBLS
   Print #1,"PLANES_STAGE_LAST ";_PLANES_STAGE_LAST
   Print #1,"PLANES_MASK0_LAST ";_PLANES_MASK0
   Print #1,"PLANES_MASK1_LAST ";_PLANES_MASK1
   Print #1,"PLANES_RET0 ";_PLANES_RET0
   Print #1,"PLANES_RET1 ";_PLANES_RET1
   Print #1,"PLANES_BAD_MASK1 ";_PLANES_BAD1
   Print #1,"PLANES_BAD_MASK2 ";_PLANES_BAD2
   Print #1,"PLANES_PIXEL_ID ";_PLANES_PIXEL_ID
   Print #1,"PLANES_PIXEL_VALUE ";_PLANES_PIXEL_VALUE
