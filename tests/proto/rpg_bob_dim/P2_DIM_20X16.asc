   Print #1,"COL_MASK_ONLY ";_COL_MASK_ONLY
   Print #1,"COL_FAR_RECT ";_COL_FAR_RECT
   Print #1,"COL_FAR_MASK ";_COL_FAR_MASK
   Print #1,"COL_BAD_MODE ";_COL_BAD
   Print #1,"COL_PLANES0_HIT ";_COL_UNCHANGED
   Print #1,"COL_PLANES_RESTORE ";_COL_PLANES_RET
   Print #1,"FLIP_STAGES ";_FLIP_STAGES
