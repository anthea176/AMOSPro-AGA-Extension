' M19 S1-P2c: DMA watchpoint checkpoints, one-shot WinUAE on P1i.
' Fixed fixture only, NOT a generic AGSP reader or native P2a execution.
' Snapshot before running. Published AllocVec stays allocated until reset.
Set Buffer 20
Cls
_PRG=Prg State : _ERR=0 : _RESULT=0 : _OPEN=0 : _HIDDEN=0
_PTR=0 : _BANK_OWN=0 : _OWN=-1 : _GUARD=-1 : _EXPOSED=0
_ARMED=0 : _BLANK_SET=0 : _MOVES=0 : _CLOSED=0 : _FREES=0
_HELD=0 : _PAL_OK=0 : _SRC_ERASED=0 : _VBL_BLANK=0
_MARK=0 : _MARKS=0 : _POST=0
_MODE$="UNKNOWN" : _LOG$="RAM:M19_S1P2C_DMA_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_S1P2C_DMA_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_S1P2C_DMA_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_S1P2C_DMA_COMPILED.TXT"
End If
If _PRG<>1
   Print "RUNTIME ONLY"
   End
End If
_CHIP0=Chip Free : _FAST0=Fast Free
_CPU=Deek(Leek(4)+296) and $FFFF
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO<>0
   Print "LOG OPEN FAILED ";_IO
   End
End If
Print #1,"SOURCE_TAG M19_S1P2C_DMA_V1"
Print #1,"PRG_STATE ";_PRG
Print #1,"RUN_MODE ";_MODE$
Print #1,"CPU_ATTNFLAGS ";_CPU
Print #1,"CHIP_BEFORE ";_CHIP0;" FAST_BEFORE ";_FAST0
If Aga Detect=0
   _ERR=1
   Goto _CLEANUP
End If
If Length(29)<>0
   _ERR=2
   Goto _CLEANUP
End If
Trap Load "AGSP_S1P1E_FINAL.ABK",29
_IO=Errtrap
If Length(29)<>0
   _BANK_OWN=1
End If
If _IO<>0 or Length(29)<>512
   _ERR=3
   Goto _CLEANUP
End If
_SRC=Start(29)
_P=_SRC : _SIZE=512
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=4
   Goto _CLEANUP
End If
' Verify the exact known header and complete entry for ID 3.
If Leek(_SRC)<>$41475350 or Leek(_SRC+4)<>$10000 or Leek(_SRC+8)<>$30030
   _ERR=5
   Goto _CLEANUP
End If
If Leek(_SRC+12)<>32 or Leek(_SRC+16)<>176 or Leek(_SRC+20)<>512 or Leek(_SRC+24)<>5 or Leek(_SRC+28)<>0
   _ERR=5
   Goto _CLEANUP
End If
_ENT=_SRC+128
If Leek(_ENT)<>$30010 or Leek(_ENT+4)<>$100002 or Leek(_ENT+8)<>$20000
   _ERR=6
   Goto _CLEANUP
End If
If Leek(_ENT+12)<>400 or Leek(_ENT+16)<>64 or Leek(_ENT+20)<>464 or Leek(_ENT+24)<>48
   _ERR=6
   Goto _CLEANUP
End If
If Leek(_ENT+28)<>0 or Leek(_ENT+32)<>$30000 or Leek(_ENT+36)<>0 or Leek(_ENT+40)<>0 or Leek(_ENT+44)<>0
   _ERR=6
   Goto _CLEANUP
End If
' Validate exact pixels and palette for image 3 before copying.
For _ROW=0 To 15
   _V=$5555
   If (_ROW and 1)<>0
      _V=$AAAA
   End If
   If (Deek(_SRC+400+_ROW*2) and $FFFF)<>_V
      _ERR=7
   End If
   _V=$3333
   If (_ROW and 3)=1
      _V=$6666
   End If
   If (_ROW and 3)=2
      _V=$CCCC
   End If
   If (_ROW and 3)=3
      _V=$9999
   End If
   If (Deek(_SRC+432+_ROW*2) and $FFFF)<>_V
      _ERR=7
   End If
Next _ROW
If Leek(_SRC+464)<>$FF or Leek(_SRC+468)<>$462824DC or Leek(_SRC+472)<>$751A73FF
   _ERR=7
End If
If _ERR<>0
   Goto _CLEANUP
End If
' P2b 244-byte layout unchanged; 4 extra bytes for debugger marker.
' Exec allocation, NOT an AMOS bank: End/Erase must not reclaim DMA data.
Dreg(0)=248 : Dreg(1)=$10003
_PTR=Execall(-684)
If _PTR=0
   _ERR=8
   Goto _CLEANUP
End If
_P=_PTR : _SIZE=248
Gosub _RAM_SPAN
If _RAM_OK=0 or (_M0 and 2)=0 or (_M1 and 2)=0
   _ERR=9
   Goto _CLEANUP
End If
_IMAGE=_PTR+48 : _BLANK=_PTR+120 : _PAIR=_PTR+192 : _TAG=_PTR+204
_MARK=_PTR+244
Doke _PTR+4,16 : Doke _PTR+10,$FFFF
Loke _PTR+12,192 : Doke _PTR+16,3 : Doke _PTR+18,3
Loke _PTR+20,5 : Loke _PTR+40,48 : Loke _PTR+44,120
Doke _PAIR+4,16 : Doke _PAIR+10,$FFFF
For _I=0 To 11
   Poke _PTR+28+_I,Peek(_SRC+464+_I)
Next _I
For _ROW=0 To 15
   Doke _IMAGE+4+_ROW*4,Deek(_SRC+400+_ROW*2)
   Doke _IMAGE+6+_ROW*4,Deek(_SRC+432+_ROW*2)
Next _ROW
Erase 29
_BANK_OWN=0
If Length(29)<>0
   _ERR=10
   Goto _CLEANUP
End If
_SRC_ERASED=1
Print #1,"CHIP_BLOCK ";_PTR;" IMAGE ";_IMAGE;" BLANK ";_BLANK;" BYTES 248"
Print #1,"BASE_HEX ";Hex$(_PTR,8);" MARK_HEX ";Hex$(_MARK,8)
Print #1,"IMAGE_HEX ";Hex$(_IMAGE,8);" BLANK_HEX ";Hex$(_BLANK,8)
Print "S1-P2c: set debugger marker BEFORE continuing."
Print "w 0 ";Hex$(_MARK,8);" 1 W CPU"
Print "DMA watch (set at marker 1 and 2):"
Print "w 1 ";Hex$(_PTR,8);" $F8 RW DMA"
Print "IMAGE ";Hex$(_IMAGE,8);" BLANK ";Hex$(_BLANK,8)
Print "Shift+F12, set w 0, then g."
Print "Return here and press a key."
Wait Key
_OPEN=Aga Screen Open(320,256,256,$21000)
If _OPEN<>1
   _ERR=11
   Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=12
   Goto _CLEANUP
End If
_F=Aga Blit Fill(0,0,320,256,0)
If _F<>1
   _ERR=13
   Goto _CLEANUP
End If
_SW=Aga Swap
If _SW<>1
   _ERR=14
   Goto _CLEANUP
End If
Aga Wait Vbl
_A5=Areg(5) : _P=_A5+456 : _SIZE=4
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
_STATE=Leek(_A5+456) : _P=_STATE : _SIZE=40
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
_SCREEN=Leek(_STATE) : _WINDOW=Leek(_STATE+36) : _GFX=Leek(_STATE+8)
_P=_SCREEN : _SIZE=80
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
_P=_WINDOW : _SIZE=50
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
If Leek(_WINDOW+46)<>_SCREEN
   _ERR=15
   Goto _CLEANUP
End If
_P=_GFX : _SIZE=24
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Goto _CLEANUP
End If
_VP=_SCREEN+44 : _CM=Leek(_VP+4)
If Deek(_GFX+20)<39 or (Deek(_VP+32) and $FFFF)<>$5000
   _ERR=16
   Goto _CLEANUP
End If
_P=_CM : _SIZE=52
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=16
   Goto _CLEANUP
End If
If Peek(_CM+1)<>2 or Deek(_CM+2)<>256
   _ERR=16
   Goto _CLEANUP
End If
_OK=Aga Mouse Cursor(0)
If _OK<>1
   _ERR=17
   Goto _CLEANUP
End If
_HIDDEN=1
Aga Wait Vbl
' Acquire both members of the palette pair, never commandeer cursor 0/1.
Areg(0)=_PTR : Dreg(0)=2
_GET=Gfxcall(-408) and $FFFF
If _GET<8
   _OWN=_GET : _EXPOSED=1
End If
If _GET<>2 or (Deek(_PTR+10) and $FFFF)<>2
   _ERR=18
   Goto _CLEANUP
End If
Areg(0)=_PAIR : Dreg(0)=3
_GET=Gfxcall(-408) and $FFFF
If _GET<8 and _GET<>_OWN
   _GUARD=_GET : _EXPOSED=1
End If
If _GET<>3 or (Deek(_PAIR+10) and $FFFF)<>3
   _ERR=19
   Goto _CLEANUP
End If
' Query again after channel acquisition. Only the measured mode accepted.
Loke _TAG,$80000028 : Loke _TAG+4,$6A5A5A5A
Loke _TAG+8,$80000029 : Loke _TAG+12,$6A5A5A5A
Loke _TAG+16,$80000032 : Loke _TAG+20,$6A5A5A5A
Loke _TAG+24,$80000034 : Loke _TAG+28,$6A5A5A5A
Loke _TAG+32,0 : Loke _TAG+36,0
Areg(0)=_CM : Areg(1)=_TAG
_RC=Gfxcall(-708)
Print #1,"VC_RC ";_RC;" EVEN ";Leek(_TAG+4);" ODD ";Leek(_TAG+12);" RES ";Leek(_TAG+20);" PRI ";Leek(_TAG+28)
If _RC<>0 or Leek(_TAG+4)<>16 or Leek(_TAG+12)<>16 or Leek(_TAG+20)<>255 or Leek(_TAG+28)<>4 or Peek(_CM+18)<>1
   _ERR=20
   Goto _CLEANUP
End If
_P0=Aga Palette Set(0,12,20,30)
If _P0<>1
   _ERR=21
   Goto _CLEANUP
End If
For _I=1 To 3
   _RGB=_PTR+28+_I*3
   _OK=Aga Palette Set(20+_I,Peek(_RGB),Peek(_RGB+1),Peek(_RGB+2))
   If _OK<>1
      _ERR=21
   End If
Next _I
If _ERR<>0
   Goto _CLEANUP
End If
Areg(0)=_CM : Dreg(0)=21 : Dreg(1)=3 : Areg(1)=_TAG
_IGNORE=Gfxcall(-900)
For _I=0 To 8
   If Peek(_TAG+_I*4)<>Peek(_PTR+31+_I)
      _ERR=22
   End If
Next _I
If _ERR<>0
   Goto _CLEANUP
End If
_PAL_OK=1
Print #1,"CHANNEL ";_OWN;" GUARD ";_GUARD;" PALETTE_FIRST 21"
' Only channel 2 is published; channel 3 is reserved, never displayed.
_ARMED=1
Areg(0)=_VP : Areg(1)=_PTR : Areg(2)=_IMAGE
_IGNORE=Gfxcall(-420)
Amos To Back
If Leek(_PTR)<>_IMAGE
   _ERR=23
   Goto _CLEANUP
End If
For _FRAME=1 To 100
   _X=30+_FRAME*2
   Areg(0)=_VP : Areg(1)=_PTR : Dreg(0)=_X : Dreg(1)=112
   _IGNORE=Gfxcall(-426)
   Aga Wait Vbl
   _MOVES=_MOVES+1
Next _FRAME
' Checkpoint 1: sprite is visible. Watch DMA for positive control.
_MARKS=1
Print #1,"MARKER 1 ACTIVE"
Poke _MARK,1
' Hold visible while positive watchpoint is armed by the operator.
For _I=1 To 150
   Aga Wait Vbl
Next _I
_CLEANUP:
If _ARMED=1 and _OWN=2 and _OPEN=1
   Areg(0)=_VP : Areg(1)=_PTR : Areg(2)=_BLANK
   _IGNORE=Gfxcall(-420)
   If Leek(_PTR)=_BLANK
      _BLANK_SET=1
   Else
      If _ERR=0
         _ERR=24
      End If
   End If
   For _I=1 To 150
      Aga Wait Vbl
      _VBL_BLANK=_VBL_BLANK+1
   Next _I
End If
If _GUARD>=0
   Dreg(0)=_GUARD
   _IGNORE=Gfxcall(-414)
   _FREES=_FREES+1 : _GUARD=-1
End If
If _OWN>=0
   Dreg(0)=_OWN
   _IGNORE=Gfxcall(-414)
   _FREES=_FREES+1 : _OWN=-1
End If
If _OPEN=1
   If _HIDDEN=1
      _OK=Aga Mouse Cursor(1)
      If _OK<>1 and _ERR=0
         _ERR=25
      End If
   End If
   Aga Screen Close
   _CLOSED=1
   Amos To Front
   For _I=1 To 3
      _IGNORE=Gfxcall(-270)
   Next _I
End If
Amos To Front
If _BANK_OWN=1
   Erase 29
End If
If _ERR=0 and _MARKS=1 and _CLOSED=1 and _FREES=2 and _BLANK_SET=1 and _EXPOSED=1
   ' Checkpoint 2: close returned + 3 WaitTOF, DMA still quarantined.
   _MARKS=2
   Print #1,"MARKER 2 CLOSED"
   Poke _MARK,2
   For _I=1 To 300
      _IGNORE=Gfxcall(-270)
      _POST=_POST+1
   Next _I
   ' Checkpoint 3: 300 additional WaitTOF, still no FreeVec.
   _MARKS=3
   Print #1,"MARKER 3 OBSERVATION_END"
   Poke _MARK,3
End If
If _PTR<>0
   If _EXPOSED=0
      Areg(1)=_PTR
      _IGNORE=Execall(-690)
   Else
      _HELD=248
   End If
End If
If _ERR=0 and _MOVES=100 and _FREES=2 and _BLANK_SET=1 and _CLOSED=1 and _HELD=248 and _SRC_ERASED=1 and _PAL_OK=1 and _MARKS=3 and _POST=300 and _VBL_BLANK=150
   _RESULT=1
End If
If _ERR=0 and _RESULT=0
   _ERR=26
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS_DMA_OBSERVATION_SEQUENCE_ONLY"
End If
Print #1,"SOURCE_ERASED ";_SRC_ERASED
Print #1,"PALETTE_OK ";_PAL_OK
Print #1,"MOVES ";_MOVES
Print #1,"BLANK_SET ";_BLANK_SET;" BLANK_VBL ";_VBL_BLANK
Print #1,"FREES ";_FREES;" CLOSE_RETURNED ";_CLOSED
_CHIP1=Chip Free : _FAST1=Fast Free
Print #1,"MARKERS ";_MARKS;" POST_WAITTOF ";_POST
Print #1,"CHIP_AFTER ";_CHIP1;" FAST_AFTER ";_FAST1
Print #1,"CHIP_HELD ";_HELD;" DMA_FREE_PROVEN 0"
Print #1,"RESULT ";_RESULT
Print #1,"ERR ";_ERR
Print #1,"VERDICT ";_VERDICT$
Trap Close 1
Print _VERDICT$;" ERR ";_ERR
Print _LOG$
Print "SAVE LOG AND DEBUGGER TRANSCRIPT."
Print "RESTORE SNAPSHOT; DO NOT FREE THE BLOCK."
End
_RAM_SPAN:
_RAM_OK=0 : _M0=0 : _M1=0
If _P<4096 or (_P and 1)<>0 or _P>$7FFFFFFF-_SIZE
   Return
End If
Areg(1)=_P
_M0=Execall(-534)
Areg(1)=_P+_SIZE-1
_M1=Execall(-534)
If _M0<>0 and _M1<>0
   _RAM_OK=1
End If
Return
