' L3 T10A AGBO Bank Free and B8 Close - P2d-L2b.
' Banks 24,25,27 must be free. Warmup + 4 measured cycles.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:T10_BANK_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:T10_BANK_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:T10_BANK_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:T10_BANK_COMPILED.TXT"
End If
Dim _DATA(1,1023),_LEN(1),_CHIP(4),_FAST(4)
_ERR=0 : _OK=0 : _OPEN=0 : _OWN=0 : _CLOSED=-99
_CYCLES=0 : _CYCLE_LAST=0 : _READY_OK=0 : _FREE_OK=0 : _REPEAT_OK=0
_REARM_OK=0 : _BANKS_OK=0 : _PIXELS=0 : _UPDATES=0 : _SWAPS=0
_CLOSE_RETURNED=0 : _RETRY_VBLS=0 : _CAP_RETRIES=0 : _FILL_RETRIES=0
_GAIN=0 : _GAIN_MIN=0 : _DIFF=0 : _MEM_STABLE=0 : _CHIP_LOSS=0 : _FAST_LOSS=0
_P0=-1 : _P1=-1 : _PH=0 : _VERDICT$="FAIL"
If Aga Detect=0
   _ERR=1 : Goto _REPORT
End If
If Length(24)<>0 or Length(25)<>0 or Length(27)<>0
   _ERR=2 : Goto _REPORT
End If
_OWN=1
Print "T10A AGBO FREE - WARMUP + 4 CYCLES"
For _CYCLE=0 To 4
   If _ERR=0
      _CYCLE_LAST=_CYCLE
      Gosub _CYCLE_TEST
      Gosub _CLEANUP
      If _ERR=0
         _CYCLES=_CYCLES+1
         _CHIP(_CYCLE)=Chip Free : _FAST(_CYCLE)=Fast Free
         If _CYCLE>0
            If _CHIP(_CYCLE)<>_CHIP(0) or _FAST(_CYCLE)<>_FAST(0)
               _DIFF=_DIFF+1
            End If
         End If
      End If
   End If
Next _CYCLE
If _ERR=0 and _CYCLES=5 and _READY_OK=5 and _FREE_OK=5 and _REPEAT_OK=5 and _REARM_OK=5
   If _BANKS_OK=5 and _PIXELS=30 and _UPDATES=25 and _SWAPS=30 and _CLOSE_RETURNED=5
      _OK=1 : _VERDICT$="REVIEW"
      _CHIP_LOSS=_CHIP(0)-_CHIP(4) : _FAST_LOSS=_FAST(0)-_FAST(4)
      If _DIFF=0 and _GAIN_MIN>0
         _MEM_STABLE=1 : _VERDICT$="PASS"
      End If
   End If
End If
_REPORT:
Print "T10A ";_VERDICT$;" ERR ";_ERR;" PH ";_PH;" CYCLES ";_CYCLES
Print "CHIP LOSS ";_CHIP_LOSS;" FAST LOSS ";_FAST_LOSS
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST T10A AGBO BANK MEMORY"
   Print #1,"SOURCE_TAG T10A_BANK_MEMORY_20261124"
   Print #1,"LIB_EXPECTED P2d-L2b"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"PHASE_LAST ";_PH
   Print #1,"CYCLE_LAST ";_CYCLE_LAST
   Print #1,"CYCLES ";_CYCLES
   Print #1,"READY_REFUSAL_OK ";_READY_OK
   Print #1,"CLEAN_FREE_OK ";_FREE_OK
   Print #1,"REPEAT_FREE_OK ";_REPEAT_OK
   Print #1,"REARM_OK ";_REARM_OK
   Print #1,"BANKS_PRESERVED ";_BANKS_OK
   Print #1,"PIXELS_OK ";_PIXELS
   Print #1,"PIXEL1_LAST ";_P0
   Print #1,"PIXEL2_LAST ";_P1
   Print #1,"UPDATES ";_UPDATES
   Print #1,"SWAPS ";_SWAPS
   Print #1,"RETRY_VBLS ";_RETRY_VBLS
   Print #1,"CAP_RETRIES ";_CAP_RETRIES
   Print #1,"FILL_RETRIES ";_FILL_RETRIES
   Print #1,"FREE_CHIP_GAIN_MIN ";_GAIN_MIN
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"CLOSED_MOUSE_X ";_CLOSED
   Print #1,"CHIP_LOSS ";_CHIP_LOSS
   Print #1,"FAST_LOSS ";_FAST_LOSS
   Print #1,"DIFF_CYCLES ";_DIFF
   Print #1,"MEM_STABLE ";_MEM_STABLE
   For _I=0 To 4
      Print #1,"CYCLE ";_I;" CHIP ";_CHIP(_I);" FAST ";_FAST(_I)
   Next _I
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
_CYCLE_TEST:
_PH=1 : _P0=-1 : _P1=-1
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=10 : Return
End If
If Aga Double Buffer<>1
   _ERR=11 : Return
End If
If Aga I Bob(1)<>-32769 or Aga I Bob(2)<>-32769
   _ERR=12 : Return
End If
_A=Aga Blit Fill(16,16,16,16,165)
_B=Aga Blit Fill(48,16,16,16,90)
If _A<>1 or _B<>1
   _ERR=13 : Return
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,31,31
Aga Bob Bank 25
Get AGA Bob 1,48,16,63,31
For _K=0 To 1
   _BANK=24+_K : _LEN(_K)=Length(_BANK)
   If _LEN(_K)<=32 or _LEN(_K)>1024
      _ERR=14 : Return
   End If
   If Deek(Start(_BANK)+8)<>1
      _ERR=15 : Return
   End If
Next _K
Gosub _FILL
If _ERR<>0
   Return
End If
Gosub _SWAP
If _ERR<>0
   Return
End If
Gosub _FILL
If _ERR<>0
   Return
End If
Amos To Back
Aga Bob Bank 24
Aga Bob 1,96,100,1
Aga Bob Bank 25
Aga Bob 2,160,100,1
Gosub _BOTH_ACTIVE
If _ERR<>0
   Return
End If
For _K=0 To 1
   _BANK=24+_K
   If Length(_BANK)<>_LEN(_K)
      _ERR=16 : Return
   End If
   For _J=0 To _LEN(_K)-1
      _DATA(_K,_J)=Peek(Start(_BANK)+_J)
   Next _J
Next _K
_PH=2
Gosub _UPDATE
If _ERR<>0
   Return
End If
' READY frame: Bank Free must be refused without mutating slots or DATA.
_CF=Chip Free : _FF=Fast Free
Aga Bob Bank Free 24
Gosub _BOTH_ACTIVE
If _ERR<>0
   Return
End If
If Chip Free<>_CF or Fast Free<>_FF
   _ERR=21 : Return
End If
Gosub _CHECK_BANKS
If _ERR<>0
   Return
End If
_READY_OK=_READY_OK+1
Gosub _SWAP
If _ERR<>0
   Return
End If
_PH=3
' CLEAN after successful Swap: release only bank 24 private cache.
_CF=Chip Free
Aga Bob Bank Free 24
_GAIN=_CF-Chip Free : _GAIN=0-_GAIN
If _CYCLE=0 or _GAIN<_GAIN_MIN
   _GAIN_MIN=_GAIN
End If
Gosub _ONE_ACTIVE
If _ERR<>0
   Return
End If
Gosub _CHECK_BANKS
If _ERR<>0
   Return
End If
_FREE_OK=_FREE_OK+1
_CF=Chip Free : _FF=Fast Free
Aga Bob Bank Free 24
Gosub _ONE_ACTIVE
If _ERR<>0
   Return
End If
If Chip Free<>_CF or Fast Free<>_FF
   _ERR=22 : Return
End If
Gosub _CHECK_BANKS
If _ERR<>0
   Return
End If
_REPEAT_OK=_REPEAT_OK+1
_PH=4
Gosub _UPDATE_SWAP
If _ERR<>0
   Return
End If
' Old displayed page still contained both Bobs.
_EXPECT=165 : Gosub _PIXEL_PAIR
If _ERR<>0
   Return
End If
Gosub _UPDATE_SWAP
If _ERR<>0
   Return
End If
' Survivor frame: bank 24 restored to background, bank 25 unchanged.
_EXPECT=17 : Gosub _PIXEL_PAIR
If _ERR<>0
   Return
End If
_PH=5
Aga Bob Bank 24
Aga Bob 1,96,100,1
Gosub _BOTH_ACTIVE
If _ERR<>0
   Return
End If
Gosub _UPDATE_SWAP
If _ERR<>0
   Return
End If
Gosub _UPDATE_SWAP
If _ERR<>0
   Return
End If
_EXPECT=165 : Gosub _PIXEL_PAIR
If _ERR<>0
   Return
End If
Gosub _CHECK_BANKS
If _ERR=0
   _REARM_OK=_REARM_OK+1
End If
Return
_FILL:
_F=Aga Blit Fill(0,0,320,256,17)
For _TRY=1 To 4
   If _F<>1
      Aga Wait Vbl
      _FILL_RETRIES=_FILL_RETRIES+1
      _F=Aga Blit Fill(0,0,320,256,17)
   End If
Next _TRY
If _F<>1
   _ERR=17
End If
Return
_UPDATE:
_U=Aga Bob Update
If _U<>1
   _ERR=30
Else
   _UPDATES=_UPDATES+1
End If
Return
_UPDATE_SWAP:
Gosub _UPDATE
If _ERR=0
   Gosub _SWAP
End If
Return
_SWAP:
_SW=Aga Swap
For _TRY=1 To 4
   If _SW<>1
      Aga Wait Vbl
      _RETRY_VBLS=_RETRY_VBLS+1
      _SW=Aga Swap
   End If
Next _TRY
If _SW<>1
   _ERR=31
Else
   _SWAPS=_SWAPS+1
   Aga Wait Vbl
End If
Return
_BOTH_ACTIVE:
If Aga X Bob(1)<>96 or Aga Y Bob(1)<>100 or Aga I Bob(1)<>1
   _ERR=40 : Return
End If
Gosub _SECOND_ACTIVE
Return
_ONE_ACTIVE:
If Aga X Bob(1)<>-32769 or Aga Y Bob(1)<>-32769 or Aga I Bob(1)<>-32769
   _ERR=41 : Return
End If
Gosub _SECOND_ACTIVE
Return
_SECOND_ACTIVE:
If Aga X Bob(2)<>160 or Aga Y Bob(2)<>100 or Aga I Bob(2)<>1
   _ERR=42
End If
Return
_CHECK_BANKS:
For _K=0 To 1
   _BANK=24+_K
   If _LEN(_K)<=32 or _LEN(_K)>1024 or Length(_BANK)<>_LEN(_K)
      _ERR=43 : Return
   End If
   For _J=0 To _LEN(_K)-1
      If Peek(Start(_BANK)+_J)<>_DATA(_K,_J)
         _ERR=44 : Return
      End If
   Next _J
Next _K
Return
_PIXEL_PAIR:
_X=96 : Gosub _READ_PIXEL
_P0=_VALUE
If _CAPOK<>1 or _P0<>_EXPECT
   _ERR=50 : Return
End If
_PIXELS=_PIXELS+1
_X=160 : Gosub _READ_PIXEL
_P1=_VALUE
If _CAPOK<>1 or _P1<>90
   _ERR=51 : Return
End If
_PIXELS=_PIXELS+1
Return
_READ_PIXEL:
_CAPOK=0 : _VALUE=-1
_CAP=Aga C Block Capture(27,_X,100,8,1,0)
For _TRY=1 To 4
   If _CAP<>1
      Aga Wait Vbl
      _CAP_RETRIES=_CAP_RETRIES+1
      _CAP=Aga C Block Capture(27,_X,100,8,1,0)
   End If
Next _TRY
If _CAP=1 and Length(27)=56
   _CAPOK=1 : _PTR=Start(27)+40 : _VALUE=0 : _POWER=1
   For _PLANE=0 To 7
      If (Peek(_PTR+2*_PLANE) and 128)<>0
         _VALUE=_VALUE+_POWER
      End If
      _POWER=_POWER*2
   Next _PLANE
End If
Return
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=_CLOSE_RETURNED+1
   Amos To Front
   _CLOSED=Aga Mouse X
   If _CLOSED<>-1
      If _ERR=0
         _ERR=60
      End If
      Return
   End If
   _OPEN=0
   If _ERR=0
      Gosub _CHECK_BANKS
      If _ERR=0
         _BANKS_OK=_BANKS_OK+1
      End If
   End If
End If
If _OWN=1
   If Length(27)<>0
      Erase 27
   End If
   If Length(24)<>0
      Erase 24
   End If
   If Length(25)<>0
      Erase 25
   End If
End If
Return
