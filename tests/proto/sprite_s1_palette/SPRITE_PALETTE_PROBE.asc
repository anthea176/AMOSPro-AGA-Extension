' M19 S1-P2 palette observation on exact P1i. NO sprite DMA.
' VideoControl GET tags only. No hardware or palette register writes.
' Source: S0d state/Screen contract, NDK V39 graphics/videocontrol.h.
' WinUAE snapshot first; Runtime 68030 JIT ON AGA PAL.
Set Buffer 20
Cls
_PRG=Prg State : _ERR=0 : _RESULT=0 : _SAMPLES=0
_OPEN=0 : _BANK=0 : _BANK_OWN=0 : _HIDDEN=0 : _CLOSED=0
_LOG$="RAM:M19_S1P2_PALETTE_UNKNOWN.TXT"
If _PRG=0
   _LOG$="RAM:M19_S1P2_PALETTE_INTERPRETED.TXT"
End If
If _PRG=1
   _LOG$="RAM:M19_S1P2_PALETTE_RUNTIME.TXT"
End If
If _PRG=-1
   _LOG$="RAM:M19_S1P2_PALETTE_COMPILED.TXT"
End If
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO<>0
   Print "LOG OPEN FAILED ";_IO
   End
End If
Print #1,"SOURCE_TAG M19_S1P2_PALETTE_GET_V1"
Print #1,"PRG_STATE ";_PRG
If Aga Detect=0
   _ERR=1
   Goto _CLEANUP
End If
For _I=100 To 255
   If _BANK=0
      If Length(_I)=0
         _BANK=_I
      End If
   End If
Next _I
If _BANK=0
   _ERR=2
   Goto _CLEANUP
End If
Trap Reserve As Chip Work _BANK,40
_IO=Errtrap
If _IO<>0
   _ERR=3
   Goto _CLEANUP
End If
_BANK_OWN=1
_TAG=Start(_BANK)
_OPEN=Aga Screen Open(320,256,256,$21000)
If _OPEN<>1
   _ERR=4
   Goto _CLEANUP
End If
_STAGE=1
Gosub _SAMPLE
If _ERR<>0
   Goto _CLEANUP
End If
_OK=Aga Double Buffer
If _OK<>1
   _ERR=5
   Goto _CLEANUP
End If
_STAGE=2
Gosub _SAMPLE
If _ERR<>0
   Goto _CLEANUP
End If
_OK=Aga Mouse Cursor(0)
If _OK<>1
   _ERR=6
   Goto _CLEANUP
End If
_HIDDEN=1
Aga Wait Vbl
_STAGE=3
Gosub _SAMPLE
If _ERR<>0
   Goto _CLEANUP
End If
_OK=Aga Mouse Cursor(1)
If _OK<>1
   _ERR=7
   Goto _CLEANUP
End If
_HIDDEN=0
Aga Wait Vbl
_STAGE=4
Gosub _SAMPLE
_CLEANUP:
If _OPEN=1
   If _HIDDEN=1
      _OK=Aga Mouse Cursor(1)
      If _OK<>1 and _ERR=0
         _ERR=8
      End If
   End If
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _BANK_OWN=1
   Erase _BANK
End If
If _ERR=0 and _SAMPLES=4 and _CLOSED=1
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS_PALETTE_QUERY_ONLY"
End If
Print #1,"SAMPLES ";_SAMPLES
Print #1,"CLOSE_RETURNED ";_CLOSED
Print #1,"RESULT ";_RESULT
Print #1,"ERR ";_ERR
Print #1,"VERDICT ";_VERDICT$
Trap Close 1
Print _VERDICT$;" ERR ";_ERR
Print _LOG$
End
_SAMPLE:
Print #1,"STAGE ";_STAGE
_A5=Areg(5)
_P=_A5+456 : _SIZE=4
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=10
   Return
End If
_STATE=Leek(_A5+456)
_P=_STATE : _SIZE=40
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=11
   Return
End If
_SCREEN=Leek(_STATE) : _WINDOW=Leek(_STATE+36) : _GFX=Leek(_STATE+8)
_P=_SCREEN : _SIZE=80
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=12
   Return
End If
_P=_WINDOW : _SIZE=50
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=13
   Return
End If
If Leek(_WINDOW+46)<>_SCREEN
   _ERR=14
   Return
End If
_P=_GFX : _SIZE=24
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=15
   Return
End If
_VERSION=Deek(_GFX+20) and $FFFF
_VP=_SCREEN+44 : _CM=Leek(_VP+4) : _MODES=Deek(_VP+32) and $FFFF
If _VERSION<39 or (_MODES and $4000)=0
   _ERR=16
   Return
End If
_P=_CM : _SIZE=52
Gosub _RAM_SPAN
If _RAM_OK=0
   _ERR=17
   Return
End If
If Peek(_CM+1)<>2 or Deek(_CM+2)<>256
   _ERR=18
   Return
End If
' VideoControl GET may rewrite the taglist. Reinitialize every sample.
Loke _TAG,$80000028 : Loke _TAG+4,$6A5A5A5A
Loke _TAG+8,$80000029 : Loke _TAG+12,$6A5A5A5A
Loke _TAG+16,$80000032 : Loke _TAG+20,$6A5A5A5A
Loke _TAG+24,$80000034 : Loke _TAG+28,$6A5A5A5A
Loke _TAG+32,0 : Loke _TAG+36,0
Areg(0)=_CM : Areg(1)=_TAG
_RC=Gfxcall(-708)
Print #1,"GFX_VERSION ";_VERSION;" VP_MODES ";_MODES;" VC_RC ";_RC
Print #1,"EVEN_TAG ";Leek(_TAG);" EVEN_BASE ";Leek(_TAG+4)
Print #1,"ODD_TAG ";Leek(_TAG+8);" ODD_BASE ";Leek(_TAG+12)
Print #1,"RES_TAG ";Leek(_TAG+16);" SPR_RES ";Leek(_TAG+20)
Print #1,"PRI_TAG ";Leek(_TAG+24);" PF1_PRI ";Leek(_TAG+28)
Print #1,"RAW_EVEN ";Deek(_CM+44) and $FFFF;" RAW_ODD ";Deek(_CM+46) and $FFFF
Print #1,"RAW_RES ";Peek(_CM+17);" RAW_DEFAULT ";Peek(_CM+18)
If _RC<>0
   _ERR=19
   Return
End If
For _I=4 To 28 Step 8
   If Leek(_TAG+_I)=$6A5A5A5A
      _ERR=20
   End If
Next _I
If _ERR=0
   _SAMPLES=_SAMPLES+1
End If
Return
_RAM_SPAN:
' Region endpoints only; allocation ownership is the trusted P1i/OS state.
_RAM_OK=0
If _P<4096 or (_P and 1)<>0 or _P>$7FFFFFFF-_SIZE
   Return
End If
Areg(1)=_P
_M0=Execall(-534)
Areg(1)=_P+_SIZE-1
_M1=Execall(-534)
If _M0<>0 and _M1<>0
   _RAM_OK=1
End If
Return
