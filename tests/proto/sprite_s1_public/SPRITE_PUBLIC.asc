' M19 S1-P2i - public Sprite lifecycle, real AGSP bank image 3.
' Install the matching Lib. Snapshot before test. No debugger needed.
Set Buffer 20
Cls
Dim _CHIP(3),_FAST(3)
_PRG=Prg State : _ERR=0 : _RESULT=0
_CYCLES=0 : _MOVES=0 : _ERASED=0 : _RECOVERED=0 : _RESHOWN=0
_MODE$="UNKNOWN" : _LOG$="RAM:M19_S1_PUBLIC_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_S1_PUBLIC_INTERP.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_S1_PUBLIC_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_S1_PUBLIC_COMPILED.TXT"
End If
_CPU=Deek(Leek(4)+296) and $FFFF
_CHIP(0)=Chip Free : _FAST(0)=Fast Free
If Aga Detect=0
   _ERR=1
End If
If Length(29)<>0
   _ERR=2
End If
For _CYCLE=1 To 3
   If _ERR=0
      Gosub _RUN_CYCLE
      _CHIP(_CYCLE)=Chip Free : _FAST(_CYCLE)=Fast Free
      If _ERR=0
         _CYCLES=_CYCLES+1
      End If
   End If
Next _CYCLE
If _ERR=0 and _CYCLES=3 and _MOVES=300 and _ERASED=3 and _RECOVERED=3 and _RESHOWN=1
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS_S1_PUBLIC_SEQUENCE_ONLY"
End If
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO<>0
   Print "LOG OPEN FAILED ";_IO
   End
End If
Print #1,"SOURCE_TAG M19_S1P2I_PUBLIC_V1"
Print #1,"PRG_STATE ";_PRG;" RUN_MODE ";_MODE$
Print #1,"CPU_ATTNFLAGS ";_CPU
For _I=0 To 3
   Print #1,"CYCLE ";_I;" CHIP_FREE ";_CHIP(_I);" FAST_FREE ";_FAST(_I)
Next _I
Print #1,"CYCLES ";_CYCLES;" MOVES ";_MOVES
Print #1,"SOURCE_ERASED ";_ERASED;" RESHOW ";_RESHOWN;" RECOVERED ";_RECOVERED
Print #1,"RESULT ";_RESULT;" ERR ";_ERR
Print #1,"VERDICT ";_VERDICT$
Trap Close 1
Print _VERDICT$;" ERR ";_ERR
Print _LOG$
Print "Save log and report the visible Sprite."
End
_RUN_CYCLE:
_OPEN=0 : _BANK_OWN=0 : _HIDDEN=0 : _SHOWN=0
If Length(29)<>0
   _ERR=2
   Return
End If
Trap Load "AGSP_S1P1E_FINAL.ABK",29
_IO=Errtrap
If Length(29)<>0
   _BANK_OWN=1
End If
If _IO<>0 or Length(29)<>512
   _ERR=3
   Goto _CYCLE_CLEANUP
End If
_OK=Aga Screen Open(320,256,256,$21000)
If _OK<>1
   _ERR=4
   Goto _CYCLE_CLEANUP
End If
_OPEN=1
_OK=Aga Double Buffer
If _OK<>1
   _ERR=5
   Goto _CYCLE_CLEANUP
End If
_OK=Aga Blit Fill(0,0,320,256,0)
If _OK<>1
   _ERR=6
   Goto _CYCLE_CLEANUP
End If
_OK=Aga Swap
If _OK<>1
   _ERR=7
   Goto _CYCLE_CLEANUP
End If
_OK=Aga Palette Set(0,12,20,30)
If _OK<>1
   _ERR=8
End If
_OK=Aga Palette Set(21,255,70,40)
If _OK<>1
   _ERR=8
End If
_OK=Aga Palette Set(22,36,220,117)
If _OK<>1
   _ERR=8
End If
_OK=Aga Palette Set(23,26,115,255)
If _OK<>1
   _ERR=8
End If
If _ERR<>0
   Goto _CYCLE_CLEANUP
End If
_OK=Aga Mouse Cursor(0)
If _OK<>1
   _ERR=9
   Goto _CYCLE_CLEANUP
End If
_HIDDEN=1
Aga Wait Vbl
Aga Sprite Bank 29
_OK=Aga Sprite(1,32,112,3)
If _OK<>1
   _ERR=10
   Goto _CYCLE_CLEANUP
End If
_SHOWN=1
Amos To Back
Erase 29
_BANK_OWN=0
If Length(29)<>0
   _ERR=11
   Goto _CYCLE_CLEANUP
End If
_ERASED=_ERASED+1
For _FRAME=1 To 100
   If _ERR=0
      _OK=Aga Sprite(1,32+_FRAME*2,112,3)
      If _OK=1
         _MOVES=_MOVES+1
         Aga Wait Vbl
      Else
         _ERR=12
      End If
   End If
Next _FRAME
If _ERR<>0
   Goto _CYCLE_CLEANUP
End If
For _I=1 To 25
   Aga Wait Vbl
Next _I
If _CYCLE=1
   _OK=Aga Sprite Off(1)
   If _OK<>1
      _ERR=13
      Goto _CYCLE_CLEANUP
   End If
   For _I=1 To 25
      Aga Wait Vbl
   Next _I
   _OK=Aga Sprite(1,32,112,3)
   If _OK<>1
      _ERR=14
      Goto _CYCLE_CLEANUP
   End If
   _RESHOWN=_RESHOWN+1
   For _I=1 To 25
      Aga Wait Vbl
   Next _I
End If
If _CYCLE=3
   _OK=Aga Sprite Bank Free(29)
   If _OK<>1
      _ERR=15
   End If
End If
_CYCLE_CLEANUP:
If _OPEN=1
   If _HIDDEN=1
      _OK=Aga Mouse Cursor(1)
   End If
   Aga Screen Close
   Amos To Front
   For _I=1 To 4
      Wait Vbl
   Next _I
   _CLOSED=Aga Mouse X
   If _CLOSED<>-1
      If _ERR=0
         _ERR=17
      End If
   End If
   _OK=Aga Sprite Bank Free(29)
   If _OK=1 and _CLOSED=-1
      If _SHOWN=1
         _RECOVERED=_RECOVERED+1
      End If
   Else
      If _ERR=0
         _ERR=16
      End If
   End If
End If
If _BANK_OWN=1
   Erase 29
End If
Amos To Front
Return
