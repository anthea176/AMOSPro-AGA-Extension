' L3 T11A P2d-L2b - FICON/FICHIP restage and repeated cleanup.
' Banks 11,12,13,27 must be free. No external resources.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:T11_CACHE_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED"
   _LOG$="RAM:T11_CACHE_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME"
   _LOG$="RAM:T11_CACHE_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED"
   _LOG$="RAM:T11_CACHE_COMPILED.TXT"
End If
Dim _CHIP(6),_FAST(6)
_ERR=0 : _OK=0 : _OWN=0 : _OPEN=0 : _CLOSED=-99
_CYCLE_LAST=0 : _CYCLES=0 : _STAGES=0 : _PIXELS=0 : _UNREADY_OK=0
_CLOSE_RETURNED=0 : _BANKS_OK=0 : _FILL_RETRIES=0 : _SWAP_RETRIES=0
_SWAPS=0 : _MEM_STABLE=0 : _DIFF=0 : _CHIP_LOSS=0 : _FAST_LOSS=0
_CACHE_DELTA=0 : _CACHE_MIN=0 : _P0=-1 : _P1=-1 : _P2=-1 : _P3=-1 : _P4=-1
_VERDICT$="FAIL"
If Aga Detect=0
   _ERR=1 : Goto _REPORT
End If
If Length(11)<>0 or Length(12)<>0 or Length(13)<>0 or Length(27)<>0
   _ERR=2 : Goto _REPORT
End If
_OWN=1
Print "T11A FICON FICHIP - WARMUP + 6 CYCLES"
For _CYCLE=0 To 6
   If _ERR=0
      _CYCLE_LAST=_CYCLE
      Gosub _CYCLE_TEST
      Gosub _CLEANUP
      If _ERR=0
         _CYCLES=_CYCLES+1
         _CHIP(_CYCLE)=Chip Free : _FAST(_CYCLE)=Fast Free
         If _CYCLE>0
            If _CHIP(_CYCLE)<>_CHIP(0) or _FAST(_CYCLE)<>_FAST(0)
               _DIFF=_DIFF+1
            End If
         End If
      End If
   End If
Next _CYCLE
If _ERR=0 and _CYCLES=7 and _STAGES=14 and _PIXELS=35 and _UNREADY_OK=7 and _BANKS_OK=7 and _SWAPS=7 and _CLOSE_RETURNED=7
   _OK=1 : _VERDICT$="REVIEW"
   _CHIP_LOSS=_CHIP(0)-_CHIP(6) : _FAST_LOSS=_FAST(0)-_FAST(6)
   If _DIFF=0
      _MEM_STABLE=1 : _VERDICT$="PASS"
   End If
End If
_REPORT:
Print "T11A ";_VERDICT$;" ERR ";_ERR;" CYCLES ";_CYCLES
Print "CHIP LOSS ";_CHIP_LOSS;" FAST LOSS ";_FAST_LOSS
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST T11A CACHE MEMORY"
   Print #1,"SOURCE_TAG T11A_CACHE_MEMORY_20261124"
   Print #1,"LIB_EXPECTED P2d-L2b"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"CYCLE_LAST ";_CYCLE_LAST
   Print #1,"CYCLES ";_CYCLES
   Print #1,"STAGES ";_STAGES
   Print #1,"PIXELS_OK ";_PIXELS
   Print #1,"UNREADY_OK ";_UNREADY_OK
   Print #1,"BANKS_PRESERVED ";_BANKS_OK
   Print #1,"OLD_PIXEL ";_P0
   Print #1,"STALE_PIXEL ";_P1
   Print #1,"RESTAGED_PIXEL ";_P2
   Print #1,"CPU_PIXEL ";_P3
   Print #1,"UNREADY_PIXEL ";_P4
   Print #1,"CACHE_CHIP_MIN ";_CACHE_MIN
   Print #1,"SWAPS ";_SWAPS
   Print #1,"SWAP_RETRIES ";_SWAP_RETRIES
   Print #1,"FILL_RETRIES ";_FILL_RETRIES
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"CLOSED_MOUSE_X ";_CLOSED
   Print #1,"CHIP_LOSS ";_CHIP_LOSS
   Print #1,"FAST_LOSS ";_FAST_LOSS
   Print #1,"DIFF_CYCLES ";_DIFF
   Print #1,"MEM_STABLE ";_MEM_STABLE
   For _I=0 To 6
      Print #1,"CYCLE ";_I;" CHIP ";_CHIP(_I);" FAST ";_FAST(_I)
   Next _I
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
_CYCLE_TEST:
_OPEN=0 : _P0=-1 : _P1=-1 : _P2=-1 : _P3=-1 : _P4=-1
Reserve As Data 13,256
If Length(13)<>256
   _ERR=10 : Return
End If
_D=Aga F Icon Bank Create(12,4)
If _D<>1 or Length(12)<>1164
   _ERR=11 : Return
End If
_CF=Chip Free
_D=Aga F Chip Bank Create(11,4)
If _D<>1 or Length(11)<>1168
   _ERR=12 : Return
End If
_CACHE_DELTA=_CF-Chip Free
If _CACHE_DELTA<=0
   _ERR=13 : Return
End If
If _CYCLE=0 or _CACHE_DELTA<_CACHE_MIN
   _CACHE_MIN=_CACHE_DELTA
End If
_READY=Start(11)+12+4*288
If Peek(_READY)<>0 or Peek(_READY+1)<>0
   _ERR=14 : Return
End If
For _I=0 To 255
   Poke Start(13)+_I,165
Next _I
_D=Aga F Icon Bank Put(12,1,13,0)
If _D<>1
   _ERR=15 : Return
End If
_D=Aga F Chip Stage(12,11,1)
If _D<>1 or Peek(_READY)<>1 or Peek(_READY+1)<>0
   _ERR=16 : Return
End If
_STAGES=_STAGES+1
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=20 : Return
End If
If Aga Double Buffer<>1
   _ERR=21 : Return
End If
Amos To Back
_D=Aga Blit Fill(0,0,320,256,17)
For _TRY=1 To 4
   If _D<>1
      Aga Wait Vbl
      _FILL_RETRIES=_FILL_RETRIES+1
      _D=Aga Blit Fill(0,0,320,256,17)
   End If
Next _TRY
If _D<>1
   _ERR=22 : Return
End If
_D=Aga F Blit(11,1,32,40,0)
If _D<>1
   _ERR=23 : Return
End If
For _I=0 To 255
   Poke Start(13)+_I,90
Next _I
_D=Aga F Icon Bank Put(12,1,13,0)
If _D<>1
   _ERR=24 : Return
End If
' Old cache must still draw old content until explicit Stage.
_D=Aga F Blit(11,1,64,40,0)
If _D<>1
   _ERR=25 : Return
End If
_D=Aga F Chip Stage(12,11,1)
If _D<>1 or Peek(_READY)<>1 or Peek(_READY+1)<>0
   _ERR=26 : Return
End If
_STAGES=_STAGES+1
_D=Aga F Blit(11,1,96,40,0)
If _D<>1
   _ERR=27 : Return
End If
_D=Aga F Icon(12,1,128,40,0)
If _D<>1
   _ERR=28 : Return
End If
_D=Aga F Blit(11,2,160,40,0)
If _D<>0
   _ERR=29 : Return
End If
_UNREADY_OK=_UNREADY_OK+1
For _POINT=0 To 4
   If _ERR=0
      _X=32+32*_POINT : Gosub _READ_PIXEL
      If _CAPOK<>1
         _ERR=30
      Else
         _EXPECT=165
         If _POINT>=2
            _EXPECT=90
         End If
         If _POINT=4
            _EXPECT=17
         End If
         If _POINT=0
            _P0=_VALUE
         End If
         If _POINT=1
            _P1=_VALUE
         End If
         If _POINT=2
            _P2=_VALUE
         End If
         If _POINT=3
            _P3=_VALUE
         End If
         If _POINT=4
            _P4=_VALUE
         End If
         If _VALUE<>_EXPECT
            _ERR=31+_POINT
         Else
            _PIXELS=_PIXELS+1
         End If
      End If
   End If
Next _POINT
If _ERR<>0
   Return
End If
_SW=Aga Swap
For _TRY=1 To 4
   If _SW<>1
      Aga Wait Vbl
      _SWAP_RETRIES=_SWAP_RETRIES+1
      _SW=Aga Swap
   End If
Next _TRY
If _SW<>1
   _ERR=40 : Return
End If
_SWAPS=_SWAPS+1
Return
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=_CLOSE_RETURNED+1
   Amos To Front
   _CLOSED=Aga Mouse X
   If _CLOSED<>-1
      If _ERR=0
         _ERR=60
      End If
      Return
   End If
   _OPEN=0
   If _ERR=0
      If Length(11)=1168 and Length(12)=1164 and Length(13)=256 and Length(27)=56
         _BANKS_OK=_BANKS_OK+1
      Else
         _ERR=61
      End If
   End If
End If
If _OWN=1
   If Length(27)<>0
      Erase 27
   End If
   If Length(11)<>0
      Erase 11
   End If
   If Length(12)<>0
      Erase 12
   End If
   If Length(13)<>0
      Erase 13
   End If
End If
Return
_READ_PIXEL:
_CAPOK=0 : _VALUE=-1
_CAP=Aga C Block Capture(27,_X,40,8,1,0)
If _CAP=1 and Length(27)=56
   _CAPOK=1 : _PTR=Start(27)+40 : _POWER=1 : _VALUE=0
   For _PLANE=0 To 7
      If (Peek(_PTR+2*_PLANE) and 128)<>0
         _VALUE=_VALUE+_POWER
      End If
      _POWER=_POWER*2
   Next _PLANE
End If
Return
