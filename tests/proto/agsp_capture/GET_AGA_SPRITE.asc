' M19 S1-P1e Get AGA Sprite AMOS Runtime test; NOT a distributed example.
' SOURCE_TAG M19_S1P1E_GET_AGSP_V1 
' REQUIRES a TEST candidate Lib exposing Aga Sprite Bank and Get AGA Sprite. 
' Place the fixture AGSP_CAPTURE_320X256.iff beside this ASC.
' The active P2d Lib does NOT support these two new commands.
Set Buffer 20
Cls 
_PRG=Prg State : _MODE$="UNKNOWN" : _ERR=0 : _RESULT=0
_LOG$="RAM:M19_S1P1E_AGSP_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_S1P1E_AGSP_INTERPRETED.TXT"
End If 
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_S1P1E_AGSP_RUNTIME.TXT"
End If 
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_S1P1E_AGSP_COMPILED.TXT"
End If 
_OPEN=0 : _BANK_OWN=0 : _CAPTURED=0 : _REFUSED=0
_SAVED=0 : _RELOADED=0 : _RECAPTURED=0 : _IO=-1
_IF$=Dir$+"AGSP_CAPTURE_320X256.iff"
If Length(29)<>0
   _ERR=1
   Goto CLEANUP
End If 
If Aga Detect=0
   _ERR=2
   Goto CLEANUP
End If 
_OK=Aga Screen Open(320,256,256,$21000)
If _OK<>1
   _ERR=3
   Goto CLEANUP
End If 
_OPEN=1
_OK=Aga Double Buffer
If _OK<>1
   _ERR=4
   Goto CLEANUP
End If 
_OK=Aga Iff Load(_IF$)
If _OK<>1
   _ERR=5
   Goto CLEANUP
End If 
_OK=Aga Palette Load(_IF$)
If _OK<>1
   _ERR=6
   Goto CLEANUP
End If 
' The IFF is still on the inactive buffer: do NOT swap before capture. 
Aga Sprite Bank 29
If Length(29)<>32
   _ERR=7
   Goto CLEANUP
End If 
_BANK_OWN=1
_PTR=Start(29)
If Peek$(_PTR,4)<>"AGSP"
   _ERR=8
   Goto CLEANUP
End If 
' Zone A: 3 RGB24 opaque colors + transparent, width exactly 16. 
Get Aga Sprite 1,13,5,28,20,0
If Length(29)<>192
   _ERR=9
   Goto CLEANUP
End If 
_PTR=Start(29)
If Deek(_PTR+8)<>1 or Leek(_PTR+24)<>2
   _ERR=10
   Goto CLEANUP
End If 
_CAPTURED=_CAPTURED+1
' Zone B: second image; keep first and grow multi-image directory. 
Get Aga Sprite 2,80,5,95,20,0
If Length(29)<>352
   _ERR=11
   Goto CLEANUP
End If 
_PTR=Start(29)
If Deek(_PTR+8)<>2 or Leek(_PTR+24)<>3
   _ERR=12
   Goto CLEANUP
End If 
_CAPTURED=_CAPTURED+1
' Zone C has 4 distinct opaque colors and MUST be rejected in S1.
Get Aga Sprite 3,48,5,63,20,0
If Length(29)<>352
   _ERR=13
   Goto CLEANUP
End If 
_PTR=Start(29)
If Deek(_PTR+8)<>2 or Leek(_PTR+24)<>3
   _ERR=14
   Goto CLEANUP
End If 
_REFUSED=1
' Replace image 1 with zone B: count and size unchanged, generation +1.
Get Aga Sprite 1,80,5,95,20,0
If Length(29)<>352
   _ERR=15
   Goto CLEANUP
End If 
_PTR=Start(29)
If Deek(_PTR+8)<>2 or Leek(_PTR+24)<>4
   _ERR=16
   Goto CLEANUP
End If 
_CAPTURED=_CAPTURED+1
Trap Save "RAM:AGSP_S1P1E_SAVED.ABK",29
_IO=Errtrap
If _IO<>0
   _ERR=17
   Goto CLEANUP
End If 
_SAVED=1
Erase 29
_BANK_OWN=0
If Length(29)<>0
   _ERR=18
   Goto CLEANUP
End If 
Trap Load "RAM:AGSP_S1P1E_SAVED.ABK",29
_IO=Errtrap
If _IO<>0
   _ERR=19
   Goto CLEANUP
End If 
_BANK_OWN=1
If Length(29)<>352
   _ERR=20
   Goto CLEANUP
End If 
_PTR=Start(29)
If Deek(_PTR+8)<>2 or Leek(_PTR+24)<>4
   _ERR=21
   Goto CLEANUP
End If 
_RELOADED=1
' Reselect loaded DATA, whose flags may be normalized by AMOS. 
Aga Sprite Bank 29
Get Aga Sprite 3,13,5,28,20,0
If Length(29)<>512
   _ERR=22
   Goto CLEANUP
End If 
_PTR=Start(29)
If Deek(_PTR+8)<>3 or Leek(_PTR+24)<>5
   _ERR=23
   Goto CLEANUP
End If 
_RECAPTURED=1
Trap Save "RAM:AGSP_S1P1E_FINAL.ABK",29
_IO=Errtrap
If _IO<>0
   _ERR=24
   Goto CLEANUP
End If 
_RESULT=1
CLEANUP:
If _BANK_OWN=1
   Erase 29
End If 
If _OPEN=1
   Aga Screen Close 
End If 
Amos To Front 
_VERDICT$="FAIL"
If _RESULT=1 and _ERR=0
   _VERDICT$="PASS_CAPTURE_AGSP_DATA_ONLY"
End If 
Print "S1-P1e Get AGA Sprite ";_VERDICT$;" ERR ";_ERR
Print "CAPTURED ";_CAPTURED;" REFUSED ";_REFUSED
Print "SAVED ";_SAVED;" RELOADED ";_RELOADED;" RECAPTURED ";_RECAPTURED
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 S1P1E Get AGA Sprite"
   Print #1,"SOURCE_TAG M19_S1P1E_GET_AGSP_V1"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"CAPTURED ";_CAPTURED
   Print #1,"REFUSED ";_REFUSED
   Print #1,"SAVED ";_SAVED
   Print #1,"RELOADED ";_RELOADED
   Print #1,"RECAPTURED ";_RECAPTURED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If 
End 
