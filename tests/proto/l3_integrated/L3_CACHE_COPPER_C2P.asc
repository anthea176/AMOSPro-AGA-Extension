' L3 T10B/T14B/T16A - P2d-L2b. Four cycles including warmup.
' LIBS:c2p.library required. Banks 11,12,13,27 must be free.
' AGPC v1 fixture payload embedded, no external ABK.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:L3_FINAL_UNKNOWN.TXT"
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:L3_FINAL_RUNTIME.TXT"
End If
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:L3_FINAL_INTERPRETED.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:L3_FINAL_COMPILED.TXT"
End If
Dim _CHIP(3),_FAST(3)
_ERR=0 : _OK=0 : _OWN=0 : _OPEN=0 : _PH=0 : _CYCLE_LAST=0
_CYCLES=0 : _FAST_REFUSED=0 : _AGPC_OK=0 : _PIXELS=0 : _C2P_OK=0
_C2P_EXPLICIT=0 : _C2P_AUTO=0 : _COPPER_ON=0 : _COPPER_OFF=0
_COPPER_AUTO=0 : _SWAPS=0 : _CLOSES=0 : _CLOSED=-99 : _BANKS_OK=0
_DIFF=0 : _MEM_STABLE=0 : _CHIP_LOSS=0 : _FAST_LOSS=0 : _PIX=-1
_CAP_RETRIES=0 : _SWAP_RETRIES=0 : _CHIP_GAIN_MIN=0 : _VERDICT$="FAIL"
If Aga Detect=0
   _ERR=1 : Goto _REPORT
End If
If Length(11)<>0 or Length(12)<>0 or Length(13)<>0 or Length(27)<>0
   _ERR=2 : Goto _REPORT
End If
_OWN=1
Print "L3 AGPC / C2P / COPPER"
For _CYCLE=0 To 3
   If _ERR=0
      _CYCLE_LAST=_CYCLE
      Gosub _CYCLE_TEST
      Gosub _CLEANUP
      If _ERR=0
         _CYCLES=_CYCLES+1
         _CHIP(_CYCLE)=Chip Free : _FAST(_CYCLE)=Fast Free
         If _CYCLE>0
            If _CHIP(_CYCLE)<>_CHIP(0) or _FAST(_CYCLE)<>_FAST(0)
               _DIFF=_DIFF+1
            End If
         End If
      End If
   End If
Next _CYCLE
If _ERR=0 and _CYCLES=4 and _FAST_REFUSED=4 and _AGPC_OK=4 and _PIXELS=24
   If _C2P_OK=4 and _C2P_EXPLICIT=4 and _C2P_AUTO=4 and _COPPER_ON=4 and _COPPER_OFF=2 and _COPPER_AUTO=2
      If _SWAPS=4 and _CLOSES=4 and _BANKS_OK=4
         _OK=1 : _VERDICT$="REVIEW"
         _CHIP_LOSS=_CHIP(0)-_CHIP(3) : _FAST_LOSS=_FAST(0)-_FAST(3)
         If _DIFF=0
            _MEM_STABLE=1 : _VERDICT$="PASS"
         End If
      End If
   End If
End If
_REPORT:
Print "L3 ";_VERDICT$;" ERR ";_ERR;" PH ";_PH;" CYCLE ";_CYCLE_LAST
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST L3 CACHE COPPER C2P"
   Print #1,"SOURCE_TAG L3_CACHE_COPPER_C2P_20261124"
   Print #1,"LIB_EXPECTED P2d-L2b"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"PHASE_LAST ";_PH
   Print #1,"CYCLE_LAST ";_CYCLE_LAST
   Print #1,"CYCLES ";_CYCLES
   Print #1,"FAST_REFUSED ";_FAST_REFUSED
   Print #1,"AGPC_OK ";_AGPC_OK
   Print #1,"PIXELS_OK ";_PIXELS
   Print #1,"PIXEL_LAST ";_PIX
   Print #1,"CACHE_CHIP_MIN ";_CHIP_GAIN_MIN
   Print #1,"C2P_OK ";_C2P_OK
   Print #1,"C2P_EXPLICIT ";_C2P_EXPLICIT
   Print #1,"C2P_AUTO ";_C2P_AUTO
   Print #1,"COPPER_ON ";_COPPER_ON
   Print #1,"COPPER_OFF ";_COPPER_OFF
   Print #1,"COPPER_AUTO ";_COPPER_AUTO
   Print #1,"SWAPS ";_SWAPS
   Print #1,"SWAP_RETRIES ";_SWAP_RETRIES
   Print #1,"CAP_RETRIES ";_CAP_RETRIES
   Print #1,"CLOSE_RETURNED ";_CLOSES
   Print #1,"CLOSED_MOUSE_X ";_CLOSED
   Print #1,"BANKS_PRESERVED ";_BANKS_OK
   Print #1,"CHIP_LOSS ";_CHIP_LOSS
   Print #1,"FAST_LOSS ";_FAST_LOSS
   Print #1,"DIFF_CYCLES ";_DIFF
   Print #1,"MEM_STABLE ";_MEM_STABLE
   For _I=0 To 3
      Print #1,"CYCLE ";_I;" CHIP ";_CHIP(_I);" FAST ";_FAST(_I)
   Next _I
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
_CYCLE_TEST:
_PH=1
_CF=Chip Free : _FF=Fast Free
Reserve As Data 11,360
If Length(11)<>360
   _ERR=10 : Return
End If
If Chip Free<>_CF or Fast Free>=_FF
   _ERR=11 : Return
End If
Restore _FIXTURE
For _I=0 To 359
   Read _V
   Poke Start(11)+_I,_V
Next _I
For _I=0 To 7
   Read _V
   Poke Start(11)-8+_I,_V
Next _I
_CF=Chip Free
Reserve As Chip Data 13,360
If Length(13)<>360
   _ERR=12 : Return
End If
_DELTA=_CF-Chip Free
If _DELTA<=0 or Deek(Start(13)-12)<>3
   _ERR=13 : Return
End If
If _CYCLE=0 or _DELTA<_CHIP_GAIN_MIN
   _CHIP_GAIN_MIN=_DELTA
End If
For _I=0 To 359
   Poke Start(13)+_I,Peek(Start(11)+_I)
Next _I
For _I=0 To 7
   Poke Start(13)-8+_I,Peek(Start(11)-8+_I)
Next _I
Reserve As Data 12,81920
If Length(12)<>81920
   _ERR=14 : Return
End If
For _I=0 To 81919
   Poke Start(12)+_I,90
Next _I
_PH=2
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=20 : Return
End If
If Aga Double Buffer<>1
   _ERR=21 : Return
End If
Amos To Back
_D=Aga Blit Fill(0,0,320,256,17)
If _D<>1
   _ERR=22 : Return
End If
_D=Aga Cache Blit(11,32,40,0)
If _D<>0
   _ERR=23 : Return
End If
_X=40 : _Y=44 : _EXPECT=17 : Gosub _CHECK_PIXEL
If _ERR<>0
   Return
End If
_FAST_REFUSED=_FAST_REFUSED+1
_D=Aga Cache Blit(13,64,40,0)
If _D<>1
   _ERR=24 : Return
End If
_D=Aga Cache Blit(13,96,40,1)
If _D<>1
   _ERR=25 : Return
End If
_X=72 : _Y=44 : _EXPECT=108 : Gosub _CHECK_PIXEL
If _ERR<>0
   Return
End If
_X=104 : _Y=44 : _EXPECT=17 : Gosub _CHECK_PIXEL
If _ERR<>0
   Return
End If
_X=104 : _Y=46 : _EXPECT=0 : Gosub _CHECK_PIXEL
If _ERR<>0
   Return
End If
_X=104 : _Y=40 : _EXPECT=56 : Gosub _CHECK_PIXEL
If _ERR<>0
   Return
End If
_AGPC_OK=_AGPC_OK+1
_PH=3
_D=Aga C2P Open(12)
If _D<>1
   _ERR=30 : Return
End If
_D=Aga C2P Open(12)
If _D<>0
   _ERR=31 : Return
End If
_D=Aga C2P Convert
If _D<>1
   _ERR=32 : Return
End If
_X=160 : _Y=100 : _EXPECT=90 : Gosub _CHECK_PIXEL
If _ERR<>0
   Return
End If
_C2P_OK=_C2P_OK+1
_D=Aga C2P Close
_E=Aga C2P Close
_F=Aga C2P Convert
If _D<>1 or _E<>0 or _F<>0
   _ERR=33 : Return
End If
_C2P_EXPLICIT=_C2P_EXPLICIT+1
_D=Aga C2P Open(12)
If _D<>1
   _ERR=34 : Return
End If
_PH=4
_C=Aga Copper Clear
_W=Aga Copper Wait(20,0)
_M=Aga Copper Move($180,$F00)
_E=Aga Copper End
If _C<>1 or _W<>1 or _M<>1 or _E<>1
   _ERR=40 : Return
End If
_E=Aga Copper End
_M=Aga Copper Move($180,$0F0)
If _E<>0 or _M<>0
   _ERR=41 : Return
End If
_D=Aga Copper On
If _D<>1
   _ERR=42 : Return
End If
_COPPER_ON=_COPPER_ON+1
_SW=Aga Swap
For _TRY=1 To 4
   If _SW<>1
      Aga Wait Vbl
      _SWAP_RETRIES=_SWAP_RETRIES+1
      _SW=Aga Swap
   End If
Next _TRY
If _SW<>1
   _ERR=43 : Return
End If
_SWAPS=_SWAPS+1
For _I=1 To 10
   Aga Wait Vbl
Next _I
If (_CYCLE Mod 2)=0
   _D=Aga Copper Off
   _E=Aga Copper Off
   If _D<>1 or _E<>1
      _ERR=44 : Return
   End If
   _COPPER_OFF=_COPPER_OFF+1
End If
' Leave C2P open in all cycles, Copper on in odd cycles.
Return
_CHECK_PIXEL:
_PIX=-1 : _CAP=Aga C Block Capture(27,_X,_Y,8,1,0)
For _TRY=1 To 4
   If _CAP<>1
      Aga Wait Vbl
      _CAP_RETRIES=_CAP_RETRIES+1
      _CAP=Aga C Block Capture(27,_X,_Y,8,1,0)
   End If
Next _TRY
If _CAP<>1 or Length(27)<>56
   _ERR=50 : Return
End If
_PTR=Start(27)+40 : _POWER=1 : _PIX=0
For _PLANE=0 To 7
   If (Peek(_PTR+2*_PLANE) and 128)<>0
      _PIX=_PIX+_POWER
   End If
   _POWER=_POWER*2
Next _PLANE
If _PIX<>_EXPECT
   _ERR=51 : Return
End If
_PIXELS=_PIXELS+1
Return
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSES=_CLOSES+1
   Amos To Front
   _CLOSED=Aga Mouse X
   If _CLOSED<>-1
      If _ERR=0
         _ERR=60
      End If
      Return
   End If
   _OPEN=0
   If _ERR=0
      _D=Aga C2P Close
      _E=Aga C2P Convert
      If _D<>0 or _E<>0
         _ERR=61
      Else
         _C2P_AUTO=_C2P_AUTO+1
         If (_CYCLE Mod 2)=1
            _COPPER_AUTO=_COPPER_AUTO+1
         End If
      End If
      If Length(11)<>360 or Length(13)<>360 or Length(12)<>81920 or Length(27)<>56
         _ERR=62
      Else
         Restore _FIXTURE
         For _I=0 To 359
            Read _V
            If Peek(Start(11)+_I)<>_V or Peek(Start(13)+_I)<>_V
               _ERR=63
            End If
         Next _I
         If Peek(Start(12))<>90 or Peek(Start(12)+81919)<>90
            _ERR=64
         End If
         If _ERR=0
            _BANKS_OK=_BANKS_OK+1
         End If
      End If
   End If
End If
If _OWN=1
   If Length(27)<>0
      Erase 27
   End If
   If Length(11)<>0
      Erase 11
   End If
   If Length(12)<>0
      Erase 12
   End If
   If Length(13)<>0
      Erase 13
   End If
End If
Return
_FIXTURE:
Data 65,71,80,67,0,1,0,3,0,16,0,16,0,8,0,2,255,255,255,255,0,0,0,72
Data 0,0,0,104,0,0,1,104,0,0,0,1,0,0,0,0,97,67,166,131,251,142,144,154
Data 133,223,248,218,41,54,204,144,176,126,67,242,111,249,65,193,141,105,141,198,131,161,105,72
Data 127,235,223,243,247,238,253,223,255,63,255,95,190,247,237,253,251,255,246,255,239,191,95,238
Data 159,249,119,250,253,247,255,111,84,85,168,170,81,85,162,170,69,85,138,170,21,84,42,168
Data 85,81,170,162,85,69,170,138,85,21,170,42,84,85,168,170,102,100,49,51,153,145,196,204
Data 102,70,19,51,153,24,76,204,100,98,51,51,145,137,204,204,70,38,51,50,24,153,204,200
Data 120,120,193,195,26,22,240,224,135,135,28,60,161,96,14,13,120,120,195,195,22,14,224,208
Data 135,135,60,60,96,225,13,11,42,213,169,82,177,66,85,170,66,141,74,149,171,84,36,88
Data 213,42,82,161,66,165,170,85,141,18,149,106,84,169,88,161,24,204,101,49,136,198,51,137
Data 206,67,25,140,39,50,28,196,49,25,202,103,49,140,102,19,156,142,51,24,76,101,57,152
Data 6,193,29,11,120,54,240,104,193,192,7,131,31,14,124,60,240,248,193,224,7,131,14,15
Data 92,62,176,120,66,224,5,131,0,61,0,251,3,246,7,232,47,192,223,128,191,0,124,1
Data 240,3,192,23,0,111,1,223,3,190,15,120,62,224,253,128,0,0,0,0,0,1,0,7
Data 0,31,0,63,0,126,2,253,13,251,59,247,247,239,239,223,223,190,191,120,126,224,253,128
Data 65,71,80,67,65,67,72,69
