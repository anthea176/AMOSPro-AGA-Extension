' M19 BOBS P0: host-built ABK Load/Save/Erase/Load preview ONLY.
' NO Aga Bob Bank / Get AGA Bob native command is invoked.
' Requires M19_BOBS_HERO_BANK10.abk in the AMOS current directory.
' WARNING: overwrites AMOS bank 10 and RAM:M19_BOBS_P0_COPY.ABK.
Cls
Print "M19 BOBS P0 ABK LOAD SAVE"
_B=10
Load "M19_BOBS_HERO_BANK10.abk",_B
_LEN=Length(_B)
_RESULT=1
If _LEN<>131072
   Print "INVALID BANK LENGTH ";_LEN
   End
End If
_PTR=Start(_B)
If Peek$(_PTR-8,8)<>"AGABOB  "
   _RESULT=0
End If
If Peek$(_PTR,8)<>"AGABOB01"
   _RESULT=0
End If
If Deek(_PTR+8)<>1 or Deek(_PTR+10)<>128
   _RESULT=0
End If
If Deek(_PTR+12)<>3
   _RESULT=0
End If
If Leek(_PTR+16)<>131072 or Leek(_PTR+24)<>40
   _RESULT=0
End If
If Leek(_PTR+28)<>24 or Leek(_PTR+32)<>3112
   _RESULT=0
End If
' Image 1: 31x19x4, 4-byte stride, mask present.
If Deek(_PTR+40)<>1 or Deek(_PTR+42)<>31
   _RESULT=0
End If
If Deek(_PTR+44)<>19 or Deek(_PTR+46)<>4
   _RESULT=0
End If
If Deek(_PTR+48)<>4 or Deek(_PTR+50)<>1
   _RESULT=0
End If
' Image 2: 37x20x8, 6-byte stride, mask present.
If Deek(_PTR+64)<>2 or Deek(_PTR+66)<>37
   _RESULT=0
End If
If Deek(_PTR+68)<>20 or Deek(_PTR+70)<>8
   _RESULT=0
End If
If Deek(_PTR+72)<>6 or Deek(_PTR+74)<>1
   _RESULT=0
End If
' Image 3: 1x1x1, no mask, zero-index remains opaque.
If Deek(_PTR+88)<>3 or Deek(_PTR+90)<>1
   _RESULT=0
End If
If Deek(_PTR+92)<>1 or Deek(_PTR+94)<>1
   _RESULT=0
End If
If Deek(_PTR+98)<>0
   _RESULT=0
End If
Save "RAM:M19_BOBS_P0_COPY.ABK",_B
Erase _B
Load "RAM:M19_BOBS_P0_COPY.ABK",_B
_PTR=Start(_B)
If Length(_B)<>131072
   _RESULT=0
End If
If Peek$(_PTR,8)<>"AGABOB01"
   _RESULT=0
End If
If Deek(_PTR+12)<>3 or Deek(_PTR+98)<>0
   _RESULT=0
End If
Print "ABK ROUNDTRIP RESULT ";_RESULT
Print "NATIVE BOB API NOT TESTED"
List Bank
Erase _B
End
