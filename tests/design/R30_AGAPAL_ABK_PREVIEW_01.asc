' R30-AGAPAL-ABK-PREVIEW-01 (AMOS native commands ONLY).
' NOT an Aga Palette Bank Init AP20 extension test.
' Destroys any existing bank 10 and RAM:R30_AGAPAL_TEST.ABK.
' Verifies the 16+N*(8+768) indexed palette layout, Save/Load ABK.
Cls
Print "R30-AGAPAL-ABK-PREVIEW-01"
_B=10
_N=8
_BYTES=16+_N*776
Reserve As Data _B,_BYTES
_BASE=Start(_B)
' External AMOS name, saved in the AmBk header.
Poke$ _BASE-8,"AGAPAL  "
' Internal AGAPAL v1 header, big endian on 68000.
Poke$ _BASE,"AGAPAL"
Doke _BASE+6,1
Doke _BASE+8,_N
Doke _BASE+10,0
Loke _BASE+12,0
' Index: offset LONG, count WORD=0, flags WORD=0.
For _I=0 To _N-1
   _ENTRY=_BASE+16+8*_I
   _OFFSET=16+_N*8+_I*768
   Loke _ENTRY,_OFFSET
   Doke _ENTRY+4,0
   Doke _ENTRY+6,0
Next _I
' Empty palette bytes must be deterministic, not uninitialised RAM.
For _I=16+8*_N To _BYTES-1
   Poke _BASE+_I,0
Next _I
_SIZE=Length(_B)
' Writes an actual AMOS ABK, NOT a raw binary file.
Save "RAM:R30_AGAPAL_TEST.ABK",_B
Erase _B
Load "RAM:R30_AGAPAL_TEST.ABK",_B
_BASE=Start(_B)
_OK=1
If Length(_B)<>_BYTES
   _OK=0
End If
If Peek$(_BASE-8,8)<>"AGAPAL  "
   _OK=0
End If
If Peek$(_BASE,6)<>"AGAPAL"
   _OK=0
End If
If Deek(_BASE+6)<>1
   _OK=0
End If
If Deek(_BASE+8)<>_N
   _OK=0
End If
For _I=0 To _N-1
   _ENTRY=_BASE+16+8*_I
   _EXPECT=16+8*_N+768*_I
   If Leek(_ENTRY)<>_EXPECT
      _OK=0
   End If
   If Deek(_ENTRY+4)<>0
      _OK=0
   End If
   If Deek(_ENTRY+6)<>0
      _OK=0
   End If
Next _I
Print "BANK ";_B;" PALETTES ";_N;" BYTES ";_SIZE
Print "HEADER ";Peek$(_BASE,6);" V";Deek(_BASE+6)
Print "OFFSET0 ";Leek(_BASE+16)
Print "OFFSET7 ";Leek(_BASE+72)
Print "ABK SAVE/LOAD RESULT ";_OK
Print "EXPECTED LENGTH 6224 OFFSET0 80 OFFSET7 5456"
List Bank
Print "END OF R30 FORMAT PREVIEW"
End
