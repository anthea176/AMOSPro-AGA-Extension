' M19 R90 - TWO NATIVE MASKED AGA BOBS, EXPLICIT AGA SWAP.
' Experimental R90 ONLY. Requires free AMOS bank 10.
' Creates two source images directly on the private AGA screen.
' No external image, no AMCAF, no hidden BankToChip command.
Set Buffer 20
Cls
_ERR=0 : _OPEN=0 : _DB=0 : _OWN=0 : _SWAPS=0
_READY=0 : _DRAWN=0 : _MASKED=0 : _BANKOK=0
_LOG$="RAM:M19_R90_BOBS_RUNTIME.TXT"
_MODE$="RUNTIME"
If Prg State=0
   _MODE$="INTERPRETED"
End If
If Prg State=-1
   _MODE$="COMPILED"
   _LOG$="RAM:M19_R90_BOBS_COMPILED.TXT"
End If
Print "M19 R90 NATIVE BOBS MASK + ANIMATION"
If Aga Detect=0
   _ERR=1 : Goto _DONE
End If
If Length(10)<>0
   _ERR=2 : Goto _DONE
End If
Aga Bob Bank 10
If Length(10)<>131072
   _ERR=3 : Goto _DONE
End If
_OWN=1 : _BANKOK=1
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto _DONE
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=5 : Goto _DONE
End If
_K0=Aga Palette Set(0,0,0,0)
_K1=Aga Palette Set(1,16,24,60)
_K2=Aga Palette Set(2,25,45,90)
_K4=Aga Palette Set(4,255,50,50)
_K5=Aga Palette Set(5,255,220,20)
_K6=Aga Palette Set(6,30,240,100)
Amos To Back
_READY=0
For _TRY=1 To 32
   If _READY=0
      _READY=Aga Blit Fill(0,0,320,256,0)
   End If
   If _READY=0
      Aga Wait Vbl
   End If
Next _TRY
If _READY<>1
   _ERR=6 : Goto _DONE
End If
_A=Aga Blit Fill(0,0,20,20,4)
_B=Aga Blit Fill(5,5,10,10,0)
_C=Aga Blit Fill(8,8,4,4,6)
_D=Aga Blit Fill(32,0,32,24,5)
_E=Aga Blit Fill(36,4,24,16,0)
_F=Aga Blit Fill(40,8,16,8,6)
If _A<>1 or _B<>1 or _C<>1 or _D<>1 or _E<>1 or _F<>1
   _ERR=7 : Goto _DONE
End If
Get AGA Bob 1,0,0,19,19
Get AGA Bob 2,32,0,63,23
If Deek(Start(10)+12)<>2
   _ERR=8 : Goto _DONE
End If
Make AGA Bob Mask 1,0
Make AGA Bob Mask 2,0
_M1=Leek(Start(10)+40+16)
_M2=Leek(Start(10)+40+24+16)
If _M1=0 or _M2=0
   _ERR=9 : Goto _DONE
End If
_MASKED=1
Save "RAM:M19_R90_TWO_BOBS.ABK",10
Erase 10
_OWN=0
Load "RAM:M19_R90_TWO_BOBS.ABK",10
_OWN=1
Aga Bob Bank 10
If Length(10)<>131072 or Deek(Start(10)+12)<>2
   _ERR=10 : Goto _DONE
End If
For _FRAME=1 To 180
   _X=10+((_FRAME*2) Mod 260)
   _Y=80+Int((_FRAME Mod 50)/2)
   _X2=280-((_FRAME*2) Mod 260)
   Aga Bob 1,_X,_Y,1
   Aga Bob 2,_X2,135,2
   If _FRAME=130
      Aga Bob Off 2
   End If
   _READY=0
   For _TRY=1 To 32
      If _READY=0
         _READY=Aga Blit Fill(0,0,320,256,2)
      End If
      If _READY=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _READY<>1
      _ERR=11 : Goto _DONE
   End If
   Aga Bob Draw
   _DRAWN=_DRAWN+1
   _SW=0
   For _TRY=1 To 32
      If _SW=0
         _SW=Aga Swap
      End If
      If _SW=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _SW<>1
      _ERR=12 : Goto _DONE
   End If
   _SWAPS=_SWAPS+1
Next _FRAME
For _HOLD=1 To 50
   Aga Wait Vbl
Next _HOLD
_DONE:
If _OPEN=1
   Aga Screen Close
End If
Amos To Front
If _OWN=1
   Erase 10
End If
_VERDICT$="FAIL"
If _ERR=0 and _SWAPS=180 and _DRAWN=180 and _MASKED=1
   _VERDICT$="PASS"
End If
Print "M19 R90 BOBS ";_VERDICT$;" ERR ";_ERR
Print "DRAWN ";_DRAWN;" SWAPS ";_SWAPS
Print "MASKS ";_MASKED;" BANK ";_BANKOK
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"M19 R90 TWO NATIVE MASKED BOBS"
   Print #1,"LIB_EXPECTED R90 v0.13.35"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";Prg State
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"ERR ";_ERR
   Print #1,"DRAWN ";_DRAWN
   Print #1,"SWAPS ";_SWAPS
   Print #1,"MASKED ";_MASKED
   Print #1,"BANK_CREATED ";_BANKOK
   Print #1,"CLOSE_RETURNED ";_OPEN
   Trap Close 1
End If
Print "LOG ";_LOG$;" WRITE_ERR ";_LOGERR
End
