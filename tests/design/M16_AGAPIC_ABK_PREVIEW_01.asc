' M16 P0 AGAPIC: AMOS-native ABK LOAD/HEADER preview only.
' NO new AP20 function and NO AGA image rendering in R44.
' Put M16_AGAPIC_SAMPLE_BANK10.abk in the AMOS current directory.
' WARNING: Load overwrites AMOS bank 10 (keep bank 10 available).
' Use List Bank to check F for Fast or C for Chip allocation.
Cls
Print "M16-AGAPIC-ABK-PREVIEW-01"
_B=10
Load "M16_AGAPIC_SAMPLE_BANK10.abk",_B
_BASE=Start(_B)
_SIZE=Length(_B)
_RESULT=1
If _BASE=0 or _SIZE<200
   Print "INVALID OR MISSING AGAPIC DATA BANK"
   End
End If
If Peek$(_BASE-8,8)<>"AGAPIC  "
   _RESULT=0
End If
If Peek$(_BASE,6)<>"AGAPIC"
   _RESULT=0
End If
If Deek(_BASE+6)<>1
   _RESULT=0
End If
If Deek(_BASE+8)<>1
   _RESULT=0
End If
If Deek(_BASE+10)<>1
   _RESULT=0
End If
If Deek(_BASE+12)<>64 or Deek(_BASE+14)<>40
   _RESULT=0
End If
If Deek(_BASE+16)<>4 or Deek(_BASE+18)<>10
   _RESULT=0
End If
If Leek(_BASE+20)<>32
   _RESULT=0
End If
If Leek(_BASE+24)<>196
   _RESULT=0
End If
If Leek(_BASE+28)<>_SIZE
   _RESULT=0
End If
If Leek(_BASE+32)<>196
   _RESULT=0
End If
If Leek(_BASE+32+40*4)<>_SIZE
   _RESULT=0
End If
Print "BANK ";_B;" BYTES ";_SIZE
Print "MAGIC ";Peek$(_BASE,6);" V";Deek(_BASE+6)
Print "MASK ";Deek(_BASE+8);" CODEC ";Deek(_BASE+10)
Print "W ";Deek(_BASE+12);" H ";Deek(_BASE+14)
Print "DEPTH ";Deek(_BASE+16);" GROUP ";Deek(_BASE+18)
Print "TABLE ";Leek(_BASE+20);" STREAM ";Leek(_BASE+24)
Print "ROW0 ";Leek(_BASE+32);" END ";Leek(_BASE+192)
Print "EXPECTED F IN LIST BANK IF FAST AVAILABLE"
Print "ABK FORMAT RESULT ";_RESULT
List Bank
Print "NO IMAGE DRAW COMMAND YET"
End
