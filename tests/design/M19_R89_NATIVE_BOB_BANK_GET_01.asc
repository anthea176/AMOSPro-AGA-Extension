' M19 R89 NATIVE MULTI-IMAGE AGA BANK/CAPTURE - EXPERIMENTAL ONLY.
' Requires R89 v0.13.34 build artifact in extension slot 14.
' Test uses only AMOS/native commands; bank 10 MUST be free.
' Never execute under R84 or R88. Logs in RAM: and no external assets.
Set Buffer 20
Cls
_ERR=0 : _OPEN=0 : _DB=0 : _OWN=0 : _SAVED=0 : _RELOAD=0
_LOG$="RAM:M19_R89_BOB_CAPTURE.TXT"
Print "M19 R89 AGA BOB BANK + GET - NATIVE TEST"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(10)<>0
   _ERR=2 : Goto _CLEANUP
End If
Aga Bob Bank 10
If Length(10)<>131072
   _ERR=3 : Goto _CLEANUP
End If
_OWN=1
If Leek(Start(10))<>$41474142 or Leek(Start(10)+4)<>$4F423031
   _ERR=4 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=5 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=6 : Goto _CLEANUP
End If
Amos To Back
_K0=Aga Palette Set(0,0,0,0)
_K4=Aga Palette Set(4,255,0,0)
_FILL=0
For _TRY=1 To 40
   If _FILL=0
      _FILL=Aga Blit Fill(0,0,320,256,4)
   End If
   If _FILL=0
      Aga Wait Vbl
   End If
Next _TRY
If _FILL<>1
   _ERR=7 : Goto _CLEANUP
End If
Get AGA Bob 1,20,30,36,36
Get AGA Bob 2,100,40,136,54
Get AGA Bob 3,319,255,319,255
If Deek(Start(10)+12)<>3
   _ERR=8 : Goto _CLEANUP
End If
_D=Start(10)+40
If Leek(_D)<>1 or Deek(_D+4)<>17 or Deek(_D+6)<>7
   _ERR=9 : Goto _CLEANUP
End If
If Deek(_D+8)<>8 or Deek(_D+10)<>4
   _ERR=10 : Goto _CLEANUP
End If
_D2=Start(10)+40+24
If Leek(_D2)<>1 or Deek(_D2+4)<>37 or Deek(_D2+6)<>15
   _ERR=11 : Goto _CLEANUP
End If
_D3=Start(10)+40+48
If Leek(_D3)<>1 or Deek(_D3+4)<>1 or Deek(_D3+6)<>1
   _ERR=12 : Goto _CLEANUP
End If
Get AGA Bob 1,10,10,26,16
If Deek(Start(10)+12)<>3
   _ERR=13 : Goto _CLEANUP
End If
Get AGA Bob 129,0,0,1,1
Get AGA Bob 4,-1,0,0,0
If Deek(Start(10)+12)<>3
   _ERR=14 : Goto _CLEANUP
End If
Save "RAM:M19_R89_BOB_CAPTURE.ABK",10
_SAVED=1
Erase 10
_OWN=0
Load "RAM:M19_R89_BOB_CAPTURE.ABK",10
_OWN=1
Aga Bob Bank 10
If Length(10)<>131072 or Deek(Start(10)+12)<>3
   _ERR=15 : Goto _CLEANUP
End If
_RELOAD=1
Get AGA Bob 4,0,0,0,0
If Deek(Start(10)+12)<>4
   _ERR=16 : Goto _CLEANUP
End If
_CLEANUP:
If _OPEN=1
   Aga Screen Close
End If
Amos To Front
If _OWN=1
   Erase 10
End If
_CLOSED=Aga Mouse X
_VERDICT$="FAIL"
If _ERR=0 and _CLOSED=-1
   _VERDICT$="PASS"
End If
Print "M19 R89 BOBS BANK/CAPTURE ";_VERDICT$;" ERR ";_ERR
Print "OPEN ";_OPEN;" DB ";_DB;" SAVE ";_SAVED;" LOAD ";_RELOAD
Trap Open Out 1,_LOG$
_LERR=Errtrap
If _LERR=0
   Print #1,"M19 R89 NATIVE BOB BANK + GET"
   Print #1,"LIBRARY_EXPECTED R89_v0.13.34 EXPERIMENTAL"
   Print #1,"PRG_STATE ";Prg State
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"ERR ";_ERR
   Print #1,"SAVE ";_SAVED
   Print #1,"LOAD ";_RELOAD
   Print #1,"CLOSED ";_CLOSED
   Trap Close 1
End If
Print "LOG ";_LOG$;" ERR ";_LERR
End
