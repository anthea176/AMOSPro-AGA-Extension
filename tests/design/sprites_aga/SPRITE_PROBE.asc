' M19 S0d - 3 cycles AGA Sprite, cursor and RGB4 Copper robustness.
' EXPERIMENTAL source; no native S1 API and no formal DMA-detach proof.
' Based on the S0c Runtime PASS 16x16 sprite. Use WinUAE snapshot first.
' Gfxcall: GetSprite -408, ChangeSprite -420, MoveSprite -426,
' FreeSprite -414, WaitTOF -270. NO direct hardware writes.
' One reusable 156-byte Chip Work bank per cycle, 3 cycles total.
' Cycle 1 baseline; cycle 2 cursor toggles; cycle 3 Copper On/Off.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _ERR=0 : _RESULT=0
_LOG$="RAM:M19_S0D_ROB_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_S0D_ROB_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_S0D_ROB_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_S0D_ROB_COMPILED.TXT"
End If
_OPENS=0 : _CLOSES=0 : _CYCLES_OK=0 : _GETS=0 : _FREES=0
_BANK_FREES=0 : _BANK_HELD_ANY=0 : _MOVES=0 : _VBL_PRE=0 : _TOF_POST=0
_HIDE_OK=0 : _SHOW_OK=0 : _COP_ON_OK=0 : _COP_OFF_OK=0
_CH1=-1 : _CH2=-1 : _CH3=-1 : _BAD_CYCLE=0 : _ERR_STAGE=0
_DBS=0
_OWN=-1 : _CYCLE=0 : _IO=-1 : _S0D_TAG$="M19_S0D_ROB_V1"
For _CYCLE=1 To 3
   ' Reset cycle state even after an earlier error, to prevent double cleanup.
   _OPEN=0 : _BANK=0 : _BANK_OWN=0 : _BANK_CLEAN=0
   _A5=0 : _STATE=0 : _SCREEN=0 : _WINDOW=0 : _VIEWPORT=0
   _PTR=0 : _IMAGE=0 : _BLANK=0 : _MODES=0 : _DB=0
   _OWN=-1 : _PIXELS_ARMED=0 : _BLANK_SET=0
   _POSTWAIT=0 : _PREWAIT=0 : _FRAMES=0 : _FREE=0
   _COPPER_TOUCHED=0 : _CLOSE_RETURNED=0 : _BANK_HELD=0
   _CURSOR_RESTORE=0
   If _ERR=0
      If Aga Detect=0
         _ERR=1 : _ERR_STAGE=1
      End If
   End If
   If _ERR=0
      _OPEN=Aga Screen Open(320,256,256,$00021000)
      If _OPEN<>1
         _ERR=2 : _ERR_STAGE=2
      Else
         _OPENS=_OPENS+1
      End If
   End If
   If _ERR=0
      _A5=Areg(5)
      If _A5<4096 or (_A5 and 1)<>0
         _ERR=3 : _ERR_STAGE=3
      End If
   End If
   If _ERR=0
      _STATE=Leek(_A5+456)
      If _STATE<4096 or (_STATE and 1)<>0
         _ERR=4 : _ERR_STAGE=4
      End If
   End If
   If _ERR=0
      _SCREEN=Leek(_STATE)
      _WINDOW=Leek(_STATE+36)
      If _SCREEN<4096 or _WINDOW<4096
         _ERR=5 : _ERR_STAGE=5
      End If
   End If
   If _ERR=0
      If (_SCREEN and 1)<>0 or (_WINDOW and 1)<>0
         _ERR=6 : _ERR_STAGE=6
      End If
   End If
   If _ERR=0
      If Leek(_WINDOW+46)<>_SCREEN
         _ERR=7 : _ERR_STAGE=7
      End If
   End If
   If _ERR=0
      _VIEWPORT=_SCREEN+44
      _MODES=Deek(_VIEWPORT+32)
      If (_MODES and $4000)=0
         _ERR=8 : _ERR_STAGE=8
      End If
   End If
   If _ERR=0
      ' Copper reference tests used Double Buffer before Copper Clear.
      _DB=Aga Double Buffer
      If _DB<>1
         _ERR=29 : _ERR_STAGE=29
      Else
         _DBS=_DBS+1
      End If
   End If
   If _ERR=0
      For _I=100 To 255
         If _BANK=0
            If Length(_I)=0
               _BANK=_I
            End If
         End If
      Next _I
      If _BANK=0
         _ERR=9 : _ERR_STAGE=9
      End If
   End If
   If _ERR=0
      Trap Reserve As Chip Work _BANK,156
      _RES_ERR=Errtrap
      If _RES_ERR<>0
         _ERR=10 : _ERR_STAGE=10
      Else
         _BANK_OWN=1
      End If
   End If
   If _ERR=0
      _PTR=Start(_BANK) : _IMAGE=_PTR+12 : _BLANK=_IMAGE+72
      If _PTR<4096 or (_PTR and 1)<>0
         _ERR=11 : _ERR_STAGE=11
      End If
   End If
   If _ERR=0
      Loke _PTR,0 : Doke _PTR+4,16 : Doke _PTR+6,0
      Doke _PTR+8,0 : Doke _PTR+10,$FFFF
      For _I=0 To 70 Step 2
         Doke _IMAGE+_I,0
         Doke _BLANK+_I,0
      Next _I
      For _ROW=0 To 15
         _PL0=$8000 : _PL1=0
         If _ROW=0 or _ROW=1
            _PL0=$FFF0
         End If
         If _ROW=6 or _ROW=7
            _PL0=$FFC0
         End If
         If _ROW=12 or _ROW=13
            _PL1=$8000
         End If
         Doke _IMAGE+4+_ROW*4,_PL0
         Doke _IMAGE+6+_ROW*4,_PL1
      Next _ROW
   End If
   If _ERR=0
      _CURSOR_SHOW=Aga Mouse Cursor(1)
      If _CURSOR_SHOW<>1
         _ERR=12 : _ERR_STAGE=12
      Else
         _SHOW_OK=_SHOW_OK+1
      End If
   End If
   If _ERR=0
      If _CYCLE=2
         _CURSOR_HIDE=Aga Mouse Cursor(0)
         If _CURSOR_HIDE<>1
            _ERR=13 : _ERR_STAGE=13
         Else
            _HIDE_OK=_HIDE_OK+1
         End If
      End If
   End If
   If _ERR=0
      Areg(0)=_PTR : Dreg(0)=-1
      _GET=Gfxcall(-408)
      _CHANNEL=_GET and $FFFF
      If _CHANNEL=65535 or _CHANNEL>7
         _ERR=14 : _ERR_STAGE=14
      Else
         _OWN=_CHANNEL : _GETS=_GETS+1
         If _CYCLE=1
            _CH1=_CHANNEL
         End If
         If _CYCLE=2
            _CH2=_CHANNEL
         End If
         If _CYCLE=3
            _CH3=_CHANNEL
         End If
      End If
   End If
   If _ERR=0
      If Deek(_PTR+10)<>_CHANNEL
         _ERR=15 : _ERR_STAGE=15
      End If
   End If
   If _ERR=0
      _COLOR_BASE=16+((_CHANNEL and 6)*2)
      _P0=Aga Palette Set(0,12,20,30)
      _P1=Aga Palette Set(_COLOR_BASE+1,255,70,50)
      _P2=Aga Palette Set(_COLOR_BASE+2,250,230,80)
      _P3=Aga Palette Set(_COLOR_BASE+3,80,250,140)
      If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
         _ERR=16 : _ERR_STAGE=16
      End If
   End If
   If _ERR=0
      Areg(0)=_VIEWPORT : Areg(1)=_PTR : Areg(2)=_IMAGE
      _IGNORE=Gfxcall(-420)
      _PIXELS_ARMED=1
      Amos To Back
   End If
   If _ERR=0
      For _FRAME=1 To 36
         If _ERR=0
            Areg(0)=_VIEWPORT : Areg(1)=_PTR
            Dreg(0)=35+_FRAME*5 : Dreg(1)=70+_CYCLE*28
            _IGNORE=Gfxcall(-426)
            Aga Wait Vbl
            _FRAMES=_FRAMES+1 : _MOVES=_MOVES+1
         End If
         If _ERR=0 and _CYCLE=2 and _FRAME=12
            _CURSOR_SHOW=Aga Mouse Cursor(1)
            If _CURSOR_SHOW<>1
               _ERR=17 : _ERR_STAGE=17
            Else
               _SHOW_OK=_SHOW_OK+1
            End If
         End If
         If _ERR=0 and _CYCLE=2 and _FRAME=24
            _CURSOR_HIDE=Aga Mouse Cursor(0)
            If _CURSOR_HIDE<>1
               _ERR=18 : _ERR_STAGE=18
            Else
               _HIDE_OK=_HIDE_OK+1
            End If
         End If
         If _ERR=0 and _CYCLE=3 and _FRAME=8
            _CC=Aga Copper Clear
            If _CC<>1
               _ERR=19 : _ERR_STAGE=19
            Else
               _COPPER_TOUCHED=1
            End If
            If _ERR=0
               _CW1=Aga Copper Wait(30,0)
               _CM1=Aga Copper Move($180,$F00)
               _CW2=Aga Copper Wait(180,0)
               _CM2=Aga Copper Move($180,$008)
               _CE=Aga Copper End
               If _CW1<>1 or _CM1<>1 or _CW2<>1 or _CM2<>1 or _CE<>1
                  _ERR=20 : _ERR_STAGE=20
               End If
            End If
            If _ERR=0
               _CON=Aga Copper On
               If _CON<>1
                  _ERR=21 : _ERR_STAGE=21
               Else
                  _COP_ON_OK=_COP_ON_OK+1
               End If
            End If
         End If
         If _ERR=0 and _CYCLE=3 and _FRAME=25
            _COFF=Aga Copper Off
            If _COFF<>1
               _ERR=22 : _ERR_STAGE=22
            Else
               _COP_OFF_OK=_COP_OFF_OK+1
               _COPPER_TOUCHED=0
            End If
         End If
      Next _FRAME
   End If
   ' Cleanup for EACH cycle even if an earlier stage failed.
   If _COPPER_TOUCHED=1
      _COFF=Aga Copper Off
      If _COFF=1
         _COP_OFF_OK=_COP_OFF_OK+1
         _COPPER_TOUCHED=0
      Else
         If _ERR=0
            _ERR=23 : _ERR_STAGE=23
         End If
      End If
   End If
   If _OWN>=0
      If _PIXELS_ARMED=1
         Areg(0)=_VIEWPORT : Areg(1)=_PTR : Areg(2)=_BLANK
         _IGNORE=Gfxcall(-420)
         _BLANK_SET=1
         For _J=1 To 2
            Aga Wait Vbl
            _PREWAIT=_PREWAIT+1 : _VBL_PRE=_VBL_PRE+1
         Next _J
      End If
      Dreg(0)=_OWN
      _IGNORE=Gfxcall(-414)
      _FREE=1 : _FREES=_FREES+1 : _OWN=-1
   End If
   If _OPEN=1
      _CURSOR_RESTORE=Aga Mouse Cursor(1)
      If _CURSOR_RESTORE<>1
         If _ERR=0
            _ERR=24 : _ERR_STAGE=24
         End If
      Else
         _SHOW_OK=_SHOW_OK+1
      End If
      Aga Screen Close
      _CLOSE_RETURNED=1 : _CLOSES=_CLOSES+1
      Amos To Front
      For _J=1 To 3
         _IGNORE=Gfxcall(-270)
         _POSTWAIT=_POSTWAIT+1 : _TOF_POST=_TOF_POST+1
      Next _J
   End If
   If _BANK_OWN=1
      If _CLOSE_RETURNED=1 and _POSTWAIT=3 and _OWN=-1 and _COPPER_TOUCHED=0
         Erase _BANK
         _BANK_CLEAN=1 : _BANK_FREES=_BANK_FREES+1
      Else
         _BANK_HELD=1 : _BANK_HELD_ANY=1
         If _ERR=0
            _ERR=25 : _ERR_STAGE=25
         End If
      End If
   End If
   If _ERR=0
      If _FRAMES=36 and _FREE=1 and _BLANK_SET=1 and _PREWAIT=2
         If _CLOSE_RETURNED=1 and _POSTWAIT=3 and _BANK_CLEAN=1
            _CYCLES_OK=_CYCLES_OK+1
         Else
            _ERR=26 : _ERR_STAGE=26
         End If
      Else
         _ERR=27 : _ERR_STAGE=27
      End If
   End If
   If _ERR<>0 and _BAD_CYCLE=0
      _BAD_CYCLE=_CYCLE
   End If
Next _CYCLE
If _ERR=0 and _CYCLES_OK=3 and _OPENS=3 and _CLOSES=3
   If _GETS=3 and _FREES=3 and _BANK_FREES=3 and _MOVES=108
      If _COP_ON_OK=1 and _COP_OFF_OK=1 and _HIDE_OK=2 and _SHOW_OK=7 and _DBS=3
         If _BANK_HELD_ANY=0 and _OWN=-1
            _RESULT=1
         End If
      End If
   End If
End If
If _RESULT=0 and _ERR=0
   _ERR=28 : _ERR_STAGE=28 : _BAD_CYCLE=3
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS_ROBUSTNESS_SEQUENCE_ONLY"
End If
Print "S0d ";_VERDICT$;" ERR ";_ERR
Print "CYCLES ";_CYCLES_OK;" / 3 MOVES ";_MOVES
Print "SHOW ";_SHOW_OK;" HIDE ";_HIDE_OK;" COPPER ";_COP_ON_OK;" / ";_COP_OFF_OK
Print "VISUAL CHECK REQUIRED: sprite F and Copper raster in cycle 3"
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 S0D SPRITE ROBUSTNESS"
   Print #1,"SOURCE_TAG ";_S0D_TAG$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"ERR_STAGE ";_ERR_STAGE
   Print #1,"BAD_CYCLE ";_BAD_CYCLE
   Print #1,"CYCLES_OK ";_CYCLES_OK
   Print #1,"OPENS ";_OPENS
   Print #1,"CLOSES ";_CLOSES
   Print #1,"DOUBLE_BUFFER_OK ";_DBS
   Print #1,"GETS ";_GETS
   Print #1,"FREES ";_FREES
   Print #1,"CHANNEL_1 ";_CH1
   Print #1,"CHANNEL_2 ";_CH2
   Print #1,"CHANNEL_3 ";_CH3
   Print #1,"MOVES ";_MOVES
   Print #1,"CURSOR_HIDE_OK ";_HIDE_OK
   Print #1,"CURSOR_SHOW_OK ";_SHOW_OK
   Print #1,"COPPER_ON_OK ";_COP_ON_OK
   Print #1,"COPPER_OFF_OK ";_COP_OFF_OK
   Print #1,"PRE_FREE_VBL_TOTAL ";_VBL_PRE
   Print #1,"POST_CLOSE_TOF_TOTAL ";_TOF_POST
   Print #1,"BANK_FREES ";_BANK_FREES
   Print #1,"BANK_HELD_ANY ";_BANK_HELD_ANY
   Print #1,"OWN_REMAINING ";_OWN
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
