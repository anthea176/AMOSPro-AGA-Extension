' S0b: OS Sprite channel acquisition test on AGA private screen.
' No custom AGA API, no Sprite DMA image, no hardware register writes.
' GetSprite/FreeSprite change OS channel ownership temporarily.
' MC68020+ AGA, AMOS Professional, P2d. WinUAE snapshot advised.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _ERR=0 : _RESULT=0
_LOG$="RAM:M19_S0B_SPR_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_S0B_SPR_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_S0B_SPR_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_S0B_SPR_COMPILED.TXT"
End If
_OPEN=0 : _CLOSE_RETURNED=0 : _OWN=-1 : _BANK=0 : _BANK_OWN=0
_A5=0 : _STATE=0 : _SCREEN=0 : _WINDOW=0 : _VIEWPORT=0
_MODEWORD=0 : _SPRITES_FLAG=0 : _PTR=0 : _IO=-1
_CURSOR_SHOW=-1 : _CURSOR_HIDE=-1 : _CURSOR_RESTORE=-1
_GET_SHOW=0 : _GET_HIDE=0 : _NUM_SHOW=-2 : _NUM_HIDE=-2
_MEM_SHOW=-2 : _MEM_HIDE=-2 : _FREE_SHOW=0 : _FREE_HIDE=0
_PROBES=0 : _RELEASED_CLEANUP=0 : _BANK_CLEAN=0
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=2 : Goto _CLEANUP
End If
_A5=Areg(5)
If _A5<4096 or (_A5 and 1)<>0
   _ERR=3 : Goto _CLEANUP
End If
_STATE=Leek(_A5+456)
If _STATE<4096 or (_STATE and 1)<>0
   _ERR=4 : Goto _CLEANUP
End If
_SCREEN=Leek(_STATE)
_WINDOW=Leek(_STATE+36)
If _SCREEN<4096 or _WINDOW<4096
   _ERR=5 : Goto _CLEANUP
End If
If (_SCREEN and 1)<>0 or (_WINDOW and 1)<>0
   _ERR=5 : Goto _CLEANUP
End If
If Leek(_WINDOW+46)<>_SCREEN
   _ERR=6 : Goto _CLEANUP
End If
_VIEWPORT=_SCREEN+44
_MODEWORD=Deek(_VIEWPORT+32)
If (_MODEWORD and $4000)<>0
   _SPRITES_FLAG=1
End If
' Select a free Work bank; never erase an existing bank.
For _I=100 To 255
   If _BANK=0
      If Length(_I)=0
         _BANK=_I
      End If
   End If
Next _I
If _BANK=0
   _ERR=7 : Goto _CLEANUP
End If
Trap Reserve As Work _BANK,12
_RES_ERR=Errtrap
If _RES_ERR<>0
   _ERR=8 : Goto _CLEANUP
End If
_BANK_OWN=1
_PTR=Start(_BANK)
If _PTR<4096 or (_PTR and 1)<>0
   _ERR=9 : Goto _CLEANUP
End If
Amos To Back
_CURSOR_SHOW=Aga Mouse Cursor(1)
If _CURSOR_SHOW<>1
   _ERR=10 : Goto _CLEANUP
End If
Aga Wait Vbl
' First call: cursor shown. 12-byte SimpleSprite metadata only.
Loke _PTR,0 : Loke _PTR+4,0 : Loke _PTR+8,0
Doke _PTR+10,$FFFF
Areg(0)=_PTR : Dreg(0)=-1
_GET_SHOW=Gfxcall(-408)
_NUM_SHOW=_GET_SHOW and $FFFF
_MEM_SHOW=Deek(_PTR+10)
_PROBES=_PROBES+1
If _NUM_SHOW<>65535
   If _NUM_SHOW<0 or _NUM_SHOW>7
      _ERR=11 : Goto _CLEANUP
   End If
   _OWN=_NUM_SHOW
   Dreg(0)=_OWN
   _DISCARD=Gfxcall(-414)
   _OWN=-1 : _FREE_SHOW=1
   If _MEM_SHOW<>_NUM_SHOW
      _ERR=12 : Goto _CLEANUP
   End If
Else
   If _MEM_SHOW<>65535
      _ERR=13 : Goto _CLEANUP
   End If
End If
_CURSOR_HIDE=Aga Mouse Cursor(0)
If _CURSOR_HIDE<>1
   _ERR=14 : Goto _CLEANUP
End If
Aga Wait Vbl
' Second call: cursor hidden; no assumed channel released by cursor.
Loke _PTR,0 : Loke _PTR+4,0 : Loke _PTR+8,0
Doke _PTR+10,$FFFF
Areg(0)=_PTR : Dreg(0)=-1
_GET_HIDE=Gfxcall(-408)
_NUM_HIDE=_GET_HIDE and $FFFF
_MEM_HIDE=Deek(_PTR+10)
_PROBES=_PROBES+1
If _NUM_HIDE<>65535
   If _NUM_HIDE<0 or _NUM_HIDE>7
      _ERR=15 : Goto _CLEANUP
   End If
   _OWN=_NUM_HIDE
   Dreg(0)=_OWN
   _DISCARD=Gfxcall(-414)
   _OWN=-1 : _FREE_HIDE=1
   If _MEM_HIDE<>_NUM_HIDE
      _ERR=16 : Goto _CLEANUP
   End If
Else
   If _MEM_HIDE<>65535
      _ERR=17 : Goto _CLEANUP
   End If
End If
_CLEANUP:
' No MoveSprite or ChangeSprite: no Sprite DMA image is installed.
If _OWN>=0
   Dreg(0)=_OWN
   _DISCARD=Gfxcall(-414)
   _OWN=-1 : _RELEASED_CLEANUP=1
End If
If _OPEN=1
   _CURSOR_RESTORE=Aga Mouse Cursor(1)
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
End If
If _BANK_OWN=1
   Erase _BANK
   _BANK_CLEAN=1
End If
If _ERR=0 and _PROBES=2 and _CLOSE_RETURNED=1 and _BANK_CLEAN=1
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS_CHANNEL_PROBE_ONLY"
End If
Print "S0b ";_VERDICT$;" ERR ";_ERR
Print "CHANNEL SHOW/HIDE ";_NUM_SHOW;" / ";_NUM_HIDE
Print "65535 means no free channel. No DMA display tested."
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 S0B SPRITE CHANNEL PROBE"
   Print #1,"SOURCE_TAG M19_S0B_GETSPRITE_V1"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"A5 ";_A5
   Print #1,"STATE ";_STATE
   Print #1,"SCREEN ";_SCREEN
   Print #1,"VIEWPORT ";_VIEWPORT
   Print #1,"MODES ";_MODEWORD
   Print #1,"SPRITES_FLAG ";_SPRITES_FLAG
   Print #1,"WORK_BANK ";_BANK
   Print #1,"SIMPLESPRITE_PTR ";_PTR
   Print #1,"CURSOR_SHOW ";_CURSOR_SHOW
   Print #1,"GET_SHOW_RAW ";_GET_SHOW
   Print #1,"GET_SHOW_CHANNEL ";_NUM_SHOW
   Print #1,"GET_SHOW_STRUCT_NUM ";_MEM_SHOW
   Print #1,"FREE_SHOW ";_FREE_SHOW
   Print #1,"CURSOR_HIDE ";_CURSOR_HIDE
   Print #1,"GET_HIDE_RAW ";_GET_HIDE
   Print #1,"GET_HIDE_CHANNEL ";_NUM_HIDE
   Print #1,"GET_HIDE_STRUCT_NUM ";_MEM_HIDE
   Print #1,"FREE_HIDE ";_FREE_HIDE
   Print #1,"PROBES ";_PROBES
   Print #1,"OWN_REMAINING ";_OWN
   Print #1,"RELEASED_CLEANUP ";_RELEASED_CLEANUP
   Print #1,"CURSOR_RESTORE ";_CURSOR_RESTORE
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"BANK_CLEAN ";_BANK_CLEAN
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
