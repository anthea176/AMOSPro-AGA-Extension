' M19 S0c - first 16x16 SimpleSprite visible on private AGA screen.
' EXPERIMENTAL: source-only; no claim of verified DMA detach on hardware.
' Gfxcall graphics.library: GetSprite -408, ChangeSprite -420,
' MoveSprite -426, FreeSprite -414, WaitTOF -270.
' Uses one 156-byte Chip Work bank: SimpleSprite(12) + image(72) + blank(72).
' No new AGA token, Lib, Copper/DMA register write, or S1 API.
' TAKE A WINUAE SNAPSHOT BEFORE RUNTIME. Do not test Compiler yet.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _ERR=0 : _RESULT=0
_LOG$="RAM:M19_S0C_VIS_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_S0C_VIS_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_S0C_VIS_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_S0C_VIS_COMPILED.TXT"
End If
_OPEN=0 : _CLOSE_RETURNED=0 : _BANK=0 : _BANK_OWN=0
_A5=0 : _STATE=0 : _SCREEN=0 : _WINDOW=0 : _VIEWPORT=0
_MODES=0 : _SPRITES_FLAG=0 : _PTR=0 : _IMAGE=0 : _BLANK=0
_OWN=-1 : _CHANNEL=-2 : _STRUCT_NUM=-2 : _FREE=0
_CURSOR_SHOW=-1 : _CURSOR_RESTORE=-1 : _IO=-1
_PIXELS_ARMED=0 : _BLANK_SET=0 : _PREWAIT=0 : _POSTWAIT=0
_FRAMES=0 : _BANK_CLEAN=0 : _BANK_HELD=0 : _PALETTE_OK=0
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=2 : Goto _CLEANUP
End If
_A5=Areg(5)
If _A5<4096 or (_A5 and 1)<>0
   _ERR=3 : Goto _CLEANUP
End If
_STATE=Leek(_A5+456)
If _STATE<4096 or (_STATE and 1)<>0
   _ERR=4 : Goto _CLEANUP
End If
_SCREEN=Leek(_STATE)
_WINDOW=Leek(_STATE+36)
If _SCREEN<4096 or _WINDOW<4096
   _ERR=5 : Goto _CLEANUP
End If
If (_SCREEN and 1)<>0 or (_WINDOW and 1)<>0
   _ERR=5 : Goto _CLEANUP
End If
If Leek(_WINDOW+46)<>_SCREEN
   _ERR=6 : Goto _CLEANUP
End If
_VIEWPORT=_SCREEN+44
_MODES=Deek(_VIEWPORT+32)
If (_MODES and $4000)<>0
   _SPRITES_FLAG=1
End If
' A missing flag makes this experiment invalid; never force the bit.
If _SPRITES_FLAG<>1
   _ERR=7 : Goto _CLEANUP
End If
' The only owned bank is temporary Chip RAM, including DMA image.
For _I=100 To 255
   If _BANK=0
      If Length(_I)=0
         _BANK=_I
      End If
   End If
Next _I
If _BANK=0
   _ERR=8 : Goto _CLEANUP
End If
Trap Reserve As Chip Work _BANK,156
_RES_ERR=Errtrap
If _RES_ERR<>0
   _ERR=9 : Goto _CLEANUP
End If
_BANK_OWN=1
_PTR=Start(_BANK) : _IMAGE=_PTR+12 : _BLANK=_IMAGE+72
If _PTR<4096 or (_PTR and 1)<>0
   _ERR=10 : Goto _CLEANUP
End If
' NDK SimpleSprite: posctldata Long, height/x/y/num Words.
Loke _PTR,0 : Doke _PTR+4,16 : Doke _PTR+6,0
Doke _PTR+8,0 : Doke _PTR+10,$FFFF
' Spriteimage: position/control 4 bytes + 16*4 rows + 4-byte stop.
For _I=0 To 70 Step 2
   Doke _IMAGE+_I,0
   Doke _BLANK+_I,0
Next _I
' Asymmetric F shape in two bitplanes (never a symmetric square).
For _ROW=0 To 15
   _PL0=$8000 : _PL1=0
   If _ROW=0 or _ROW=1
      _PL0=$FFF0
   End If
   If _ROW=6 or _ROW=7
      _PL0=$FFC0
   End If
   If _ROW=12 or _ROW=13
      _PL1=$8000
   End If
   Doke _IMAGE+4+_ROW*4,_PL0
   Doke _IMAGE+6+_ROW*4,_PL1
Next _ROW
_CURSOR_SHOW=Aga Mouse Cursor(1)
If _CURSOR_SHOW<>1
   _ERR=11 : Goto _CLEANUP
End If
Areg(0)=_PTR : Dreg(0)=-1
_GET=Gfxcall(-408)
_CHANNEL=_GET and $FFFF
_STRUCT_NUM=Deek(_PTR+10)
If _CHANNEL=65535
   _ERR=12 : Goto _CLEANUP
End If
If _CHANNEL>7
   _ERR=13 : Goto _CLEANUP
End If
_OWN=_CHANNEL
If _STRUCT_NUM<>_CHANNEL
   _ERR=14 : Goto _CLEANUP
End If
' Sprite 0/1: pens 17..19, sprite 2/3: pens 21..23, etc.
_COLOR_BASE=16+((_CHANNEL and 6)*2)
_P0=Aga Palette Set(0,12,20,30)
_P1=Aga Palette Set(_COLOR_BASE+1,255,70,50)
_P2=Aga Palette Set(_COLOR_BASE+2,250,230,80)
_P3=Aga Palette Set(_COLOR_BASE+3,80,250,140)
If _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
   _ERR=15 : Goto _CLEANUP
End If
_PALETTE_OK=1
' The image remains owned in Chip until the old View is withdrawn.
Areg(0)=_VIEWPORT : Areg(1)=_PTR : Areg(2)=_IMAGE
_IGNORE=Gfxcall(-420)
_PIXELS_ARMED=1
Amos To Back
For _FRAME=1 To 100
   Areg(0)=_VIEWPORT : Areg(1)=_PTR
   Dreg(0)=35+_FRAME*2 : Dreg(1)=96
   _IGNORE=Gfxcall(-426)
   Aga Wait Vbl
   _FRAMES=_FRAMES+1
Next _FRAME
_CLEANUP:
' First redirect the allocated Sprite to an all-zero Chip image.
' FreeSprite only releases OS ownership: it is NOT a DMA detach proof.
If _OWN>=0
   If _PIXELS_ARMED=1
      Areg(0)=_VIEWPORT : Areg(1)=_PTR : Areg(2)=_BLANK
      _IGNORE=Gfxcall(-420)
      _BLANK_SET=1
      For _J=1 To 2
         Aga Wait Vbl
         _PREWAIT=_PREWAIT+1
      Next _J
   End If
   Dreg(0)=_OWN
   _IGNORE=Gfxcall(-414)
   _FREE=1 : _OWN=-1
End If
If _OPEN=1
   _CURSOR_RESTORE=Aga Mouse Cursor(1)
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
   ' After changing View, allow the old Copper display to expire.
   For _J=1 To 3
      _IGNORE=Gfxcall(-270)
      _POSTWAIT=_POSTWAIT+1
   Next _J
End If
If _BANK_OWN=1
   If _OPEN=0 or (_CLOSE_RETURNED=1 and _POSTWAIT=3 and _OWN=-1)
      Erase _BANK
      _BANK_CLEAN=1
   Else
      ' Fail closed: do not free memory that old display may still read.
      _BANK_HELD=1
   End If
End If
If _ERR=0 and _FRAMES=100 and _FREE=1 and _BLANK_SET=1
   If _PREWAIT=2 and _CLOSE_RETURNED=1 and _POSTWAIT=3 and _BANK_CLEAN=1
      _RESULT=1
   End If
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS_SEQUENCE_ONLY"
End If
Print "M19 S0c SPRITE 16x16 ";_VERDICT$;" ERR ";_ERR
Print "CHANNEL ";_CHANNEL;" FRAMES ";_FRAMES
Print "VISUAL CHECK REQUIRED - send screenshot and TXT"
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 S0C SPRITE 16X16 VISIBLE"
   Print #1,"SOURCE_TAG M19_S0C_SPR16_VIS_V1"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"A5 ";_A5
   Print #1,"SCREEN ";_SCREEN
   Print #1,"VIEWPORT ";_VIEWPORT
   Print #1,"MODES ";_MODES
   Print #1,"SPRITES_FLAG ";_SPRITES_FLAG
   Print #1,"CHIP_BANK ";_BANK
   Print #1,"SIMPLESPRITE_PTR ";_PTR
   Print #1,"IMAGE_PTR ";_IMAGE
   Print #1,"BLANK_PTR ";_BLANK
   Print #1,"GET_CHANNEL ";_CHANNEL
   Print #1,"STRUCT_CHANNEL ";_STRUCT_NUM
   Print #1,"COLOR_BASE ";_COLOR_BASE
   Print #1,"PALETTE_OK ";_PALETTE_OK
   Print #1,"PIXELS_ARMED ";_PIXELS_ARMED
   Print #1,"MOVE_FRAMES ";_FRAMES
   Print #1,"BLANK_SET ";_BLANK_SET
   Print #1,"PRE_FREE_VBL ";_PREWAIT
   Print #1,"FREE_SPRITE ";_FREE
   Print #1,"OWN_REMAINING ";_OWN
   Print #1,"CURSOR_RESTORE ";_CURSOR_RESTORE
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"POST_CLOSE_TOF ";_POSTWAIT
   Print #1,"BANK_CLEAN ";_BANK_CLEAN
   Print #1,"BANK_HELD ";_BANK_HELD
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
