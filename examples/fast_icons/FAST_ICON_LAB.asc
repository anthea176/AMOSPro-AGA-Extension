' FAST ICON LAB - AMOSPro AGA R67 / 256 colour visual showcase.
' Self-contained: NO IFF, NO ABK, NO AMCAF, NO DISK WRITE.
' Requires working R67 candidate in APSystem. Interpreted AMOS.
' BANKS 11, 12 AND 13 MUST BE FREE. DATA reserve replaces bank 13.
' CLICK or ANY KEY to exit, or automatic exit after 1200 frames.
'
' FICON8  bank 12: source icons (CPU, may be Fast RAM).
' FICHIP8 bank 11: DMA-ready Chip cache (Blitter).
' DATA    bank 13: temporary 256 byte chunky pixel buffer.
'
' 1  Bank Create -> 2 Bank Put -> 3 Chip Bank Create/Stage.
' 4  Modify source -> Stage again (NO automatic refresh).
' 5  Draw to AGA back buffer -> Icon Capture X31 -> Stage.
' 6  Display each icon CPU masked/opaque and Blitter masked/opaque.
Cls
Print "FAST ICON LAB - AMOSPRO AGA R67"
If Aga Detect=0
   Print "AGA CHIPSET REQUIRED"
   End
End If
_CHIP0=Chip Free : _FAST0=Fast Free
_FICON=Aga F Icon Bank Create(12,8)
If _FICON<>1
   Print "BANK 12 BUSY OR NO MEMORY"
   End
End If
_CHIP=Aga F Chip Bank Create(11,8)
If _CHIP<>1
   Erase 12
   Print "BANK 11 BUSY OR NOT ENOUGH CHIP RAM"
   End
End If
' Reserve As Data is an AMOS command, not an AGA extension call.
Reserve As Data 13,256
_ERR=0 : _PUTS=0 : _STAGES=0
' Build four different 16x16 indexed icons with no artwork files.
For _ID=1 To 4
   For _Y=0 To 15
      For _X=0 To 15
         _INK=0
         If _ID=1
            ' Cross: 255 white border, red/green crossing.
            If _X=_Y
               _INK=4
            End If
            If _X+_Y=15
               _INK=5
            End If
            If _X=0 or _X=15 or _Y=0 or _Y=15
               _INK=255
            End If
         End If
         If _ID=2
            ' Gem: palette pen 9 violet, 7 cyan, 10 steel.
            _R=Abs(_X-7)+Abs(_Y-7)
            If _R<=7
               _INK=9
            End If
            If _R<=4
               _INK=7
            End If
            If _Y>7 and _R<7
               _INK=10
            End If
            If _R=7
               _INK=255
            End If
         End If
         If _ID=3
            ' Potion: outlined neck, bottle and green liquid.
            If _X>=6 and _X<=9 and _Y>=2 and _Y<=4
               _INK=10
            End If
            If _X>=4 and _X<=11 and _Y>=6 and _Y<=13
               _INK=7
            End If
            If _X>=5 and _X<=10 and _Y>=10 and _Y<=12
               _INK=5
            End If
            If _X=4 or _X=11
               If _Y>=6 and _Y<=13
                  _INK=255
               End If
            End If
            If _Y=13 and _X>=4 and _X<=11
               _INK=255
            End If
            If _Y=2 and _X>=5 and _X<=10
               _INK=255
            End If
         End If
         If _ID=4
            ' Spark: gold and orange rays with a white centre.
            If _X=7 or _X=8 or _Y=7 or _Y=8
               _INK=6
            End If
            If Abs(_X-7)=Abs(_Y-7) and Abs(_X-7)<=5
               _INK=12
            End If
            If _X>=6 and _X<=9 and _Y>=6 and _Y<=9
               _INK=255
            End If
         End If
         Poke Start(13)+_Y*16+_X,_INK
      Next _X
   Next _Y
   _OK=Aga F Icon Bank Put(12,_ID,13,0)
   If _OK<>1
      _ERR=1
   Else
      _PUTS=_PUTS+1
   End If
Next _ID
' Convert the four icons to the Chip Blitter format.
If _ERR=0
   For _ID=1 To 4
      _OK=Aga F Chip Stage(12,11,_ID)
      If _OK<>1
         _ERR=2
      Else
         _STAGES=_STAGES+1
      End If
   Next _ID
End If
' Demonstrate explicit re-staging: recolour GEM in the source bank.
If _ERR=0
   For _Y=0 To 15
      For _X=0 To 15
         _R=Abs(_X-7)+Abs(_Y-7)
         _INK=0
         If _R<=7
            _INK=11
         End If
         If _R<=4
            _INK=12
         End If
         If _Y>7 and _R<7
            _INK=6
         End If
         If _R=7
            _INK=255
         End If
         Poke Start(13)+_Y*16+_X,_INK
      Next _X
   Next _Y
   _REPUT=Aga F Icon Bank Put(12,2,13,0)
   _RESTAGE=Aga F Chip Stage(12,11,2)
   If _REPUT<>1 or _RESTAGE<>1
      _ERR=3
   End If
End If
If _ERR<>0
   Erase 13 : Erase 12 : Erase 11
   Print "ICON PREPARATION FAILED ";_ERR
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Erase 13 : Erase 12 : Erase 11
   Print "AGA SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase 13 : Erase 12 : Erase 11
   Print "AGA DOUBLE BUFFER FAILED"
   End
End If
' Hand-picked RGB palette. Pen 255 proves the full 8-plane path.
_P=Aga Palette Set(0,0,0,0)
_P=Aga Palette Set(1,12,21,42)
_P=Aga Palette Set(2,29,44,72)
_P=Aga Palette Set(3,35,54,84)
_P=Aga Palette Set(4,255,80,99)
_P=Aga Palette Set(5,83,239,158)
_P=Aga Palette Set(6,255,210,92)
_P=Aga Palette Set(7,86,219,255)
_P=Aga Palette Set(8,234,243,255)
_P=Aga Palette Set(9,171,106,255)
_P=Aga Palette Set(10,105,157,201)
_P=Aga Palette Set(11,240,102,170)
_P=Aga Palette Set(12,255,157,88)
_P=Aga Palette Set(255,255,255,255)
' First swap grants a usable inactive back buffer, as in the R67 test.
_FIRSTSWAP=0
For _TRY=1 To 20
   If _FIRSTSWAP=0
      _FIRSTSWAP=Aga Swap
   End If
   If _FIRSTSWAP=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_CAP=0 : _EQUAL=0 : _CAPSTAGE=0
If _FIRSTSWAP=1
   _SRCDRAW=0
   For _TRY=1 To 20
      If _SRCDRAW=0
         _SRCDRAW=Aga F Icon(12,2,31,45,0)
      End If
      If _SRCDRAW=0
         Aga Wait Vbl
      End If
   Next _TRY
   If _SRCDRAW=1
      ' Capture into icon 5, from an unaligned X=31 position.
      _CAP=Aga F Icon Capture(12,5,31,45)
   End If
   If _CAP=1
      ' Check ALL 288 bytes, including transparency and 8 colour planes.
      _EQUAL=1
      For _I=0 To 287
         If Peek(Start(12)+12+288+_I)<>Peek(Start(12)+12+4*288+_I)
            _EQUAL=0
         End If
      Next _I
      _CAPSTAGE=Aga F Chip Stage(12,11,5)
   End If
End If
If _FIRSTSWAP<>1 or _CAP<>1 or _EQUAL<>1 or _CAPSTAGE<>1
   _ERR=4
End If
' Scene layout: 5 rows x 4 modes, animated highlight bar.
_SHOWN=0 : _SAFE_RETRIES=0 : _SWAP_RETRIES=0
_BARX=10
If _ERR=0
   _KEY=Aga Key
   _PRESS=Aga Mouse Pressed
   For _FRAME=1 To 1200
      _READY=0
      For _TRY=1 To 20
         If _READY=0
            _READY=Aga Blit Clear(0,0,320,256)
            If _READY=0
               _SAFE_RETRIES=_SAFE_RETRIES+1
               Aga Wait Vbl
            End If
         End If
      Next _TRY
      If _READY<>1
         _ERR=5
         _FRAME=1200
      Else
         _DRAWERR=0
         _BG=Aga Blit Fill(0,0,320,256,1)
         _HEAD=Aga Blit Fill(8,8,304,51,2)
         _TOP=Aga Blit Fill(8,8,304,3,7)
         _DIV=Aga Blit Fill(8,57,304,2,3)
         _BAR=Aga Blit Fill(_BARX,57,12,2,12)
         _BARX=_BARX+4
         If _BARX>292
            _BARX=10
         End If
         _TITLE=Aga Text(18,29,255,"FAST ICON LAB / AGA 256")
         _SUB=Aga Text(18,47,7,"CREATE  PUT  CAPTURE  STAGE")
         _T0=Aga Text(14,77,255,"SOURCE")
         _T1=Aga Text(101,77,7,"CPU T")
         _T2=Aga Text(154,77,12,"CPU O")
         _T3=Aga Text(209,77,7,"BLIT T")
         _T4=Aga Text(264,77,12,"BLIT O")
         If _BG<>1 or _HEAD<>1 or _TOP<>1 or _DIV<>1 or _BAR<>1
            _DRAWERR=1
         End If
         If _TITLE<>1 or _SUB<>1 or _T0<>1 or _T1<>1 or _T2<>1 or _T3<>1 or _T4<>1
            _DRAWERR=1
         End If
         For _ID=1 To 5
            _RY=90+(_ID-1)*27
            _INK=2
            If _ID=2 or _ID=4
               _INK=3
            End If
            _CARD=Aga Blit Fill(8,_RY-4,304,25,_INK)
            If _ID=1
               _NAME=Aga Text(14,_RY+13,255,"01 CROSS")
            End If
            If _ID=2
               _NAME=Aga Text(14,_RY+13,255,"02 GEM*")
            End If
            If _ID=3
               _NAME=Aga Text(14,_RY+13,255,"03 ELIXIR")
            End If
            If _ID=4
               _NAME=Aga Text(14,_RY+13,255,"04 SPARK")
            End If
            If _ID=5
               _NAME=Aga Text(14,_RY+13,7,"05 CAPTURE")
            End If
            _CT=Aga F Icon(12,_ID,109,_RY,1)
            _CO=Aga F Icon(12,_ID,164,_RY,0)
            _BT=Aga F Blit(11,_ID,219,_RY,1)
            _BO=Aga F Blit(11,_ID,274,_RY,0)
            If _CARD<>1 or _NAME<>1 or _CT<>1 or _CO<>1 or _BT<>1 or _BO<>1
               _DRAWERR=1
            End If
         Next _ID
         _FOOT=Aga Blit Fill(8,227,304,24,2)
         _F1=Aga Text(14,240,7,"X31 CAPTURE / CHIP RESTAGED")
         _F2=Aga Text(14,250,255,"KEY OR CLICK TO EXIT")
         If _FOOT<>1 or _F1<>1 or _F2<>1 or _DRAWERR<>0
            _ERR=6
            _FRAME=1200
         Else
            _SW=0
            For _ST=1 To 20
               If _SW=0
                  _SW=Aga Swap
                  If _SW=0
                     _SWAP_RETRIES=_SWAP_RETRIES+1
                     Aga Wait Vbl
                  End If
               End If
            Next _ST
            If _SW<>1
               _ERR=7
               _FRAME=1200
            Else
               _SHOWN=_SHOWN+1
               _KEY=Aga Key
               _PRESS=Aga Mouse Pressed
               If _KEY>=0 or _PRESS>0
                  _FRAME=1200
               End If
               Aga Wait Vbl
            End If
         End If
      End If
   Next _FRAME
End If
Aga Screen Close
Amos To Front
_CLOSED=Aga Mouse X
Erase 13 : Erase 12 : Erase 11
_CHIP1=Chip Free : _FAST1=Fast Free
_RESULT=1
If _ERR<>0 or _EQUAL<>1 or _CAPSTAGE<>1 or _SHOWN=0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "FAST ICON LAB / AGA 256 / R67"
Print "BANK CREATE FICON/CHIP ";_FICON;" ";_CHIP
Print "BANK PUT ";_PUTS;" / 4"
Print "INITIAL CHIP STAGES ";_STAGES;" / 4"
Print "GEM REPUT / RESTAGE ";_REPUT;" ";_RESTAGE
Print "CAPTURE X31 / EQ288 / STAGE ";_CAP;" ";_EQUAL;" ";_CAPSTAGE
Print "FRAMES ";_SHOWN;" SAFE RETRIES ";_SAFE_RETRIES
Print "SWAP RETRIES ";_SWAP_RETRIES
Print "CHIP BEFORE/AFTER ";_CHIP0;" ";_CHIP1
Print "FAST BEFORE/AFTER ";_FAST0;" ";_FAST1
Print "ERROR ";_ERR;" (0=OK)"
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
