' M13 R33 - visual fade demonstration (not a Gate B regression test).
' Requires AMOSPro_AGA.Lib R33 0.10.5 or later.
' WARNING: Reserve As Data overwrites AMOS bank 12.
' The real display uses Aga Swap AND Amos To Back BEFORE the first fade.
' PAL: each 150 VBL fade is nominally 3 seconds (may be longer on 68000).
Cls
Print "R33 VISUAL FADE - BANK 12 WILL BE REPLACED"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_B=12
Reserve As Data _B,6224
_PTR=Start(_B)
_INIT=Aga Palette Bank Init(_PTR,8)
If _INIT<>1
   Print "AGAPAL INIT FAILED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_CLR=Aga Blit Clear(0,0,320,256)
_BOX0=Aga Blit Fill(12,20,296,90,28)
_BOX1=Aga Blit Fill(12,120,296,50,29)
_BOX2=Aga Blit Fill(12,180,296,50,30)
_BG=Aga Palette Set(0,0,0,0)
_WHITE=Aga Palette Set(224,255,255,255)
' Slot 0: RED / ORANGE / YELLOW
_S0=Aga Palette Set(28,255,0,0)
_S1=Aga Palette Set(29,255,96,0)
_S2=Aga Palette Set(30,255,255,0)
_CAP0=Aga Palette Bank Capture(_PTR,0)
' Slot 1: GREEN / TURQUOISE / SKY BLUE
_S3=Aga Palette Set(28,0,255,0)
_S4=Aga Palette Set(29,0,255,160)
_S5=Aga Palette Set(30,0,140,255)
_CAP1=Aga Palette Bank Capture(_PTR,1)
' Slot 2: BLUE / PURPLE / PINK
_S6=Aga Palette Set(28,0,0,255)
_S7=Aga Palette Set(29,90,0,255)
_S8=Aga Palette Set(30,255,0,180)
_CAP2=Aga Palette Bank Capture(_PTR,2)
' Restore RED first. Pictures already exist in the BACK buffer.
_START=Aga Palette Bank Apply(_PTR,0)
' CRITICAL: present the picture before animating its ColorMap.
_SWAP=Aga Swap
If _SWAP<>1
   Aga Screen Close
   Amos To Front
   Print "FIRST SWAP FAILED"
   End
End If
Amos To Back
' Initial red scene: about two seconds.
For _I=1 To 100
   Aga Wait Vbl
Next _I
' RED -> GREEN (150 VBL / approximately 3 seconds at PAL refresh).
_GREEN=Aga Fade To Bank(_PTR,1,150)
For _I=1 To 75
   Aga Wait Vbl
Next _I
' GREEN -> BLUE
_BLUE=Aga Fade To Bank(_PTR,2,150)
For _I=1 To 75
   Aga Wait Vbl
Next _I
' BLUE -> RED
_RED=Aga Fade To Bank(_PTR,0,150)
For _I=1 To 100
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_RESULT=1
If _CLR<>1 or _BOX0<>1 or _BOX1<>1 or _BOX2<>1
   _RESULT=0
End If
If _CAP0<>1 or _CAP1<>1 or _CAP2<>1 or _START<>1
   _RESULT=0
End If
If _GREEN<>1 or _BLUE<>1 or _RED<>1
   _RESULT=0
End If
If _BG<>1 or _WHITE<>1 or _S0<>1 or _S1<>1 or _S2<>1
   _RESULT=0
End If
If _S3<>1 or _S4<>1 or _S5<>1 or _S6<>1 or _S7<>1 or _S8<>1
   _RESULT=0
End If
Print "M13 R33 VISUAL FADE DEMO"
Print "CAPS ";_CAP0;" ";_CAP1;" ";_CAP2;" SWAP ";_SWAP
Print "GREEN ";_GREEN;" BLUE ";_BLUE;" RED ";_RED
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
