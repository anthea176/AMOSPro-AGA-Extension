' COPPER - four coloured raster bands, no image needed.
' Press any key to close the AGA screen.
Cls
Print "AGA COPPER - RED GREEN BLUE BLACK"
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
Aga Back Fill 0
_C=Aga Copper Clear
_W1=Aga Copper Wait(20,0)
_M1=Aga Copper Move($180,$F00)
_W2=Aga Copper Wait(80,0)
_M2=Aga Copper Move($180,$0F0)
_W3=Aga Copper Wait(140,0)
_M3=Aga Copper Move($180,$00F)
_W4=Aga Copper Wait(200,0)
_M4=Aga Copper Move($180,$000)
_E=Aga Copper End
If _C<>1 or _W1<>1 or _M1<>1 or _W2<>1 or _M2<>1
   _OFF=Aga Copper Off
   Aga Screen Close
   Amos To Front
   Print "COPPER SETUP FAILED"
   End
End If
If _W3<>1 or _M3<>1 or _W4<>1 or _M4<>1 or _E<>1
   _OFF=Aga Copper Off
   Aga Screen Close
   Amos To Front
   Print "COPPER SETUP FAILED"
   End
End If
_ON=Aga Copper On
_SW=Aga Swap
If _ON<>1 or _SW<>1
   _OFF=Aga Copper Off
   Aga Screen Close
   Amos To Front
   Print "COPPER ON OR SWAP FAILED"
   End
End If
Amos To Back
_K=Aga Wait Key
_OFF=Aga Copper Off
Aga Screen Close
Amos To Front
Print "COPPER OK - OFF ";_OFF;" KEY ";_K
End
