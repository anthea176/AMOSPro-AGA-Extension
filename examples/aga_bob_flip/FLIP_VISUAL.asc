' AGA BOB FLIP - four visible orientations of one asymmetric F glyph
' P2d working Lib, runtime visual example; not a new AGA API
Set Buffer 20
Cls
_OPEN=0 : _ERR=0 : _CLOSE_RETURNED=0 : _KEY=-1 : _SWAPS=0
_LOG$="RAM:AGA_BOB_FLIP_VISUAL.TXT"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(24)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
' Non-symmetric F: the upper bar and accent make H, V and HV obvious.
_A=Aga Blit Fill(16,16,32,32,0)
_B=Aga Blit Fill(16,16,6,32,165)
_C=Aga Blit Fill(22,16,26,6,165)
_D=Aga Blit Fill(22,28,16,6,165)
_E=Aga Blit Fill(39,17,5,4,90)
If _A<>1 or _B<>1 or _C<>1 or _D<>1 or _E<>1
   _ERR=5 : Goto _CLEANUP
End If
Aga Bob Bank 24
Get AGA Bob 1,16,16,47,47
Make AGA Bob Mask 1,0
If Length(24)<=32
   _ERR=6 : Goto _CLEANUP
End If
' First physical page, then second. Both have the same panel labels.
_BG0=Aga Blit Fill(0,0,320,256,0)
If _BG0<>1
   _ERR=7 : Goto _CLEANUP
End If
_T0=Aga Text(48,62,28,"NORMAL")
_T1=Aga Text(207,62,28,"HORIZONTAL")
_T2=Aga Text(48,161,28,"VERTICAL")
_T3=Aga Text(207,161,28,"H + V")
_MODE=Aga Bob Auto Update(1)
If _MODE<>1
   _ERR=8 : Goto _CLEANUP
End If
_SWAP=Aga Swap
If _SWAP<>1
   _ERR=9 : Goto _CLEANUP
End If
_SWAPS=_SWAPS+1
Aga Wait Vbl
_BG1=Aga Blit Fill(0,0,320,256,0)
If _BG1<>1
   _ERR=10 : Goto _CLEANUP
End If
_T0=Aga Text(48,62,28,"NORMAL")
_T1=Aga Text(207,62,28,"HORIZONTAL")
_T2=Aga Text(48,161,28,"VERTICAL")
_T3=Aga Text(207,161,28,"H + V")
Aga Bob Bank 24
' Flip mirrors the hotspot: compensate by 31 px to align each glyph.
Aga Bob 1,58,75,1
Aga Bob 2,249,75,1
Aga Bob 3,58,205,1
Aga Bob 4,249,205,1
_F0=Aga Bob Flip(1,0)
_F1=Aga Bob Flip(2,1)
_F2=Aga Bob Flip(3,2)
_F3=Aga Bob Flip(4,3)
If _F0<>1 or _F1<>1 or _F2<>1 or _F3<>1
   _ERR=11 : Goto _CLEANUP
End If
_SWAP=Aga Swap
If _SWAP<>1
   _ERR=12 : Goto _CLEANUP
End If
_SWAPS=_SWAPS+1
Aga Wait Vbl
' Bring the AGA Intuition screen to the front automatically.
Amos To Back
_KEY=Aga Wait Key
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSE_RETURNED=1
   Amos To Front
End If
If Length(24)<>0
   Erase 24
End If
_OK=0
If _ERR=0 and _CLOSE_RETURNED=1
   _OK=1
End If
_VERDICT$="FAIL"
If _OK=1
   _VERDICT$="PASS"
End If
Print "AGA BOB FLIP VISUAL ";_VERDICT$;" ERR ";_ERR
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST AGA BOB FLIP VISUAL"
   Print #1,"PRG_STATE ";Prg State
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"FLIP0 ";_F0
   Print #1,"FLIP1 ";_F1
   Print #1,"FLIP2 ";_F2
   Print #1,"FLIP3 ";_F3
   Print #1,"SWAPS ";_SWAPS
   Print #1,"CLOSE_RETURNED ";_CLOSE_RETURNED
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
End
