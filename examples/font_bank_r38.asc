' R38 - display two AMCAF BankFont files on one AGA screen.
' Run from the examples/ directory (AmigaDOS current directory).
' WARNING: Load replaces AMOS bank 25. Paths use AmigaDOS '/'.
' Requires AMOSPro_AGA.Lib R38 v0.11.0 or later; AMCAF not required.
Cls
Print "R38 - TWO AMCAF BANKFONTS"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_C0=Aga Palette Set(0,8,12,28)
_C1=Aga Palette Set(1,250,250,245)
_C2=Aga Palette Set(2,255,200,78)
_C3=Aga Palette Set(3,24,57,92)
_BG=Aga Blit Clear(0,0,320,256)
_A=Aga Blit Fill(12,42,296,88,3)
_B=Aga Blit Fill(12,138,296,87,3)
_HEAD=Aga Text(16,29,2,"R38 - AMCAF BANKFONTS")
If _C0<>1 or _C1<>1 or _C2<>1 or _C3<>1
   Aga Screen Close
   Amos To Front
   Print "PALETTE SETUP FAILED"
   End
End If
If _BG<>1 or _A<>1 or _B<>1 or _HEAD<>1
   Aga Screen Close
   Amos To Front
   Print "BACKGROUND DRAW FAILED"
   End
End If
' Both source ABKs have bank number 25. Use it sequentially.
Load "Amcaf Fonts/Hwarf1252S.abk",25
_SEL1=Aga Font Bank Select(Start(25),Length(25))
If _SEL1<>1
   Erase 25
   Aga Screen Close
   Amos To Front
   Print "HWARF BANKFONT SELECT FAILED"
   End
End If
' The selected font is now held in a private Chip RAM copy.
Erase 25
_H1=Aga Text(22,79,1,"HWARF 1252 S")
_H2=Aga Text(22,113,2,"AaBbCc 0123456789")
' Select the second BankFont; the first font is released.
Load "Amcaf Fonts/Pix3M-1252L.abk",25
_SEL2=Aga Font Bank Select(Start(25),Length(25))
If _SEL2<>1
   Erase 25
   Aga Screen Close
   Amos To Front
   Print "PIX3M BANKFONT SELECT FAILED"
   End
End If
Erase 25
_P1=Aga Text(22,170,1,"PIX3M 1252 L")
_P2=Aga Text(22,211,2,"AaBb 0123")
' Reset to the system font, releasing the private BankFont.
_RESET=Aga Font Select("",0)
_FOOT=Aga Text(18,244,2,"PRESS A KEY TO CLOSE")
_RESULT=1
If _H1<>1 or _H2<>1 or _P1<>1 or _P2<>1
   _RESULT=0
End If
If _RESET<>1 or _FOOT<>1
   _RESULT=0
End If
If _RESULT<>1
   Aga Screen Close
   Amos To Front
   Print "FONT TEXT DRAW FAILED"
   End
End If
' Present only after the entire scene has been drawn.
_SW=Aga Swap
If _SW<>1
   Aga Screen Close
   Amos To Front
   Print "AGA SWAP FAILED"
   End
End If
Amos To Back
_KEY=Aga Wait Key
Aga Screen Close
Amos To Front
Print "HWARF ";_SEL1;" PIX3M ";_SEL2
Print "TEXT ";_H1;" ";_H2;" ";_P1;" ";_P2
Print "RESET ";_RESET;" SWAP ";_SW;" RESULT ";_RESULT
Print "CLOSE RETURNED"
End
