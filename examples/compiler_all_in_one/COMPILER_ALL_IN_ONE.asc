' R46 C1 - AMOS Compiler AGA integrated regression, NOT YET TESTED.
' One compiled program: image, 2D, fonts, cursor, double buffer, close.
' Use R46 C1 experimental AGA library, not the unpatched R46.
' Run from the folder containing both included ABK files.
' Load replaces AMOS banks 10 (AGAPIC) and 25 (AMCAF BankFont).
' Use Project / Merge ASCII in AMOS, then COMPILE and run in WinUAE.
Cls
Print "R46 C1 / COMPILER ALL IN ONE"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
Load "AGAPIC_SAMPLE_BANK10.abk",10
_BASE=Start(10)
_LEN=Length(10)
If _BASE=0 or _LEN<>1836
   Print "AGAPIC BANK 10 MISSING"
   End
End If
If Peek$(_BASE,6)<>"AGAPIC"
   Print "AGAPIC MAGIC BAD"
   End
End If
_CFBEFORE=Chip Free
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,255,40,190)
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,20,35,65)
_P3=Aga Palette Set(3,255,202,50)
_ERRPAL=0
For _C=4 To 15
   _R=_C*15
   _G=255-_C*13
   _B=_C*16
   _PC=Aga Palette Set(_C,_R,_G,_B)
   If _PC<>1
      _ERRPAL=_ERRPAL+1
   End If
Next _C
' 2D/blitter, image drawing, clipping and invalid-call protection.
_CLR=Aga Blit Clear(0,0,320,256)
_BG=Aga Blit Fill(0,0,320,256,2)
_B0=Aga Box(14,57,94,112,1)
_B1=Aga Box(106,57,186,112,1)
_B2=Aga Box(198,57,278,112,1)
_D0=Aga Image Draw(_BASE,_LEN,20,61,0)
_D1=Aga Image Draw(_BASE,_LEN,112,61,1)
_D2=Aga Image Draw(_BASE,_LEN,204,61,1)
_CL=Aga Image Draw(_BASE,_LEN,-14,139,1)
_CR=Aga Image Draw(_BASE,_LEN,287,141,1)
_CT=Aga Image Draw(_BASE,_LEN,132,-16,1)
_CB=Aga Image Draw(_BASE,_LEN,128,238,1)
_BADM=Aga Image Draw(_BASE,_LEN,20,61,2)
_BADP=Aga Image Draw(0,_LEN,20,61,1)
_BADL=Aga Image Draw(_BASE,20,20,61,1)
_OUT=Aga Image Draw(_BASE,_LEN,320,256,1)
_LINE=Aga Draw(18,127,302,127,3)
_BOX=Aga Box(57,133,263,235,4)
_CIRCLE=Aga Circle(160,183,25,6)
_PLOT=Aga Plot(160,183,7)
_T0=Aga Text(12,16,1,"R46 C1 COMPILER / ALL IN ONE")
_T1=Aga Text(14,43,3,"OPAQUE / MASK / SHIFT")
_T2=Aga Text(15,248,1,"CURSOR - FONT - IMAGE - 2D")
' AMCAF BankFont (private copy survives Erase 25).
Load "Hwarf1252S.abk",25
_FB=Aga Font Bank Select(Start(25),Length(25))
_BADFONT=Aga Font Bank Select(Start(25),Length(25)-1)
Erase 25
If _FB=1
   _TXB=Aga Text(70,155,1,"HWARF AMCAF FONT")
Else
   _TXB=0
End If
' DiskFont, then reset: releases the old font and restores default.
_FOS=Aga Font Select("topaz.font",8)
_TXOS=Aga Text(70,186,7,"TOPAZ 8 DISK FONT")
_FR=Aga Font Select("",0)
_TXDEF=Aga Text(70,216,3,"DEFAULT FONT")
' Cursor state: start visible, then hide; reject invalid mode.
_SHOW0=Aga Mouse Cursor(1)
_BADCUR=Aga Mouse Cursor(2)
_SW=Aga Swap
If _SW=1
   Amos To Back
End If
' Wait until the new back buffer becomes safe for CPU image drawing.
_BACK=0
For _I=1 To 25
   If _BACK=0
      _BACK=Aga Image Draw(_BASE,_LEN,135,100,1)
   End If
   Aga Wait Vbl
Next _I
' Observe the visible pointer and the completed scene.
For _I=1 To 75
   Aga Wait Vbl
Next _I
_HIDE0=Aga Mouse Cursor(0)
_CURERR=0
For _I=1 To 250
   _S=Aga Mouse Cursor(1)
   _H=Aga Mouse Cursor(0)
   If _S<>1 or _H<>1
      _CURERR=_CURERR+1
   End If
Next _I
' Display pointer, then close the AGA screen with it hidden.
_SHOW1=Aga Mouse Cursor(1)
For _I=1 To 75
   Aga Wait Vbl
Next _I
_HIDE1=Aga Mouse Cursor(0)
For _I=1 To 75
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSIMG=Aga Image Draw(_BASE,_LEN,20,61,1)
_NOSCUR=Aga Mouse Cursor(0)
_NOSFONT=Aga Font Select("topaz.font",8)
_NOSBANK=Aga Font Bank Select(0,0)
_CLOSED=Aga Mouse X
_CFEND=Chip Free
_DROP=_CFBEFORE-_CFEND
Erase 10
' Functional results. Chip drop is diagnostic, not a false hard FAIL.
_RESULT=1
If _OPEN<>1 or _DB<>1 or _P0<>1 or _P1<>1 or _P2<>1 or _P3<>1
   _RESULT=0
End If
If _ERRPAL<>0 or _CLR<>1 or _BG<>1
   _RESULT=0
End If
If _B0<>1 or _B1<>1 or _B2<>1 or _LINE<>1
   _RESULT=0
End If
If _BOX<>1 or _CIRCLE<>1 or _PLOT<>1
   _RESULT=0
End If
If _D0<>1 or _D1<>1 or _D2<>1
   _RESULT=0
End If
If _CL<>1 or _CR<>1 or _CT<>1 or _CB<>1
   _RESULT=0
End If
If _BADM<>0 or _BADP<>0 or _BADL<>0 or _OUT<>1
   _RESULT=0
End If
If _T0<>1 or _T1<>1 or _T2<>1
   _RESULT=0
End If
If _FB<>1 or _BADFONT<>0 or _TXB<>1
   _RESULT=0
End If
If _FOS<>1 or _TXOS<>1 or _FR<>1 or _TXDEF<>1
   _RESULT=0
End If
If _SHOW0<>1 or _HIDE0<>1 or _SHOW1<>1 or _HIDE1<>1
   _RESULT=0
End If
If _BADCUR<>0 or _CURERR<>0 or _SW<>1 or _BACK<>1
   _RESULT=0
End If
If _NOSIMG<>0 or _NOSCUR<>0 or _NOSFONT<>0 or _NOSBANK<>0
   _RESULT=0
End If
If _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "R46 C1 / COMPILER ALL IN ONE"
Print "OPEN ";_OPEN;" DB ";_DB;" SWAP ";_SW;" BACKSAFE ";_BACK
Print "IMAGE O/M/S ";_D0;" ";_D1;" ";_D2
Print "CLIP L/R/T/B ";_CL;" ";_CR;" ";_CT;" ";_CB
Print "BAD M/P/L ";_BADM;" ";_BADP;" ";_BADL;" OUT ";_OUT
Print "2D ";_B0;" ";_LINE;" ";_CIRCLE;" ";_PLOT
Print "FONT BANK ";_FB;" BAD ";_BADFONT
Print "FONT OS ";_FOS;" RESET ";_FR;" TEXT ";_TXB;" ";_TXOS;" ";_TXDEF
Print "CUR 500 ERR ";_CURERR;" SHOW ";_SHOW0;" ";_SHOW1
Print "CUR HIDE ";_HIDE0;" ";_HIDE1;" BAD ";_BADCUR
Print "CHIP BEFORE/END ";_CFBEFORE;" ";_CFEND;" DROP ";_DROP
Print "CLOSED ";_CLOSED;" NO IMG/CUR/FONT/BANK ";_NOSIMG;" ";_NOSCUR;" ";_NOSFONT;" ";_NOSBANK
Print "PALETTE ERR ";_ERRPAL;" RESULT ";_RESULT
Print "CLOSE RETURNED"
Wait 200
End
