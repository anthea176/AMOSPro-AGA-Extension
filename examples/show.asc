' SHOW - animated AGA R27 showcase (not a regression test).
' Choose examples/demo.iff for PAL mode and colour indices.
' Draws its own pixels: the IFF picture is never shown.
' BLUE=3 GREEN=28 RED=224, 0=background.
' Mouse moves the little cursor. Left click / key exits.
' Requires AMOSPro_AGA.Lib R27 0.9.3 or later.
Cls
Print "AGA SHOWCASE R27 - SELECT demo.iff"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8 or _C<>256 or _MODE<>$00021000
   Print "SELECT examples/demo.iff (320X256X8 PAL)"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "AGA OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
_P=Aga Mouse Pressed
_PX=24
_DX=3
_SHOWN=0
_RETRY=0
_SWAP0=0
_ERR=0
Amos To Back
For _FRAME=1 To 600
   ' R27 Clear checks Safe itself. Never draw if it returns 0.
   _READY=0
   For _TRY=1 To 12
      If _READY=0
         _CLEAR=Aga Blit Clear(0,0,320,256)
         If _CLEAR=1
            _READY=1
         Else
            _RETRY=_RETRY+1
            Aga Wait Vbl
         End If
      End If
   Next _TRY
   If _READY=0
      _ERR=1
      _FRAME=600
   Else
      _PX=_PX+_DX
      If _PX>=261
         _PX=261
         _DX=-3
      End If
      If _PX<=24
         _PX=24
         _DX=3
      End If
      _HIT=Aga Rect Overlap(_PX,146,36,16,132,130,52,44)
      If _HIT=1
         _INK=224
      Else
         _INK=28
      End If
      ' Neon header and framed playfield.
      _HEAD=Aga Blit Fill(10,10,300,49,3)
      _TOP=Aga Blit Fill(10,10,300,3,28)
      _BOT=Aga Blit Fill(10,56,300,3,224)
      _T1=Aga Text(24,35,28,"AMOSPRO AGA / LIVE")
      _T2=Aga Text(24,51,224,"R27 SAFE BLITTER SHOWCASE")
      _PANEL=Aga Blit Fill(10,66,300,146,3)
      _FIELD=Aga Blit Fill(18,111,284,90,0)
      _LABEL=Aga Text(22,91,28,"BLITTER / COPY / COLLISION")
      _TICKERR=0
      For _I=0 To 7
         _TICK=Aga Blit Fill(24+_I*35,102,12,3,28)
         If _TICK<>1
            _TICKERR=1
         End If
      Next _I
      ' Target and its illuminated top edge.
      _ZONE=Aga Blit Fill(132,130,52,44,3)
      _EDGE=Aga Blit Fill(132,130,52,3,224)
      ' Animated block and its mirrored Blitter copy.
      _MOV=Aga Blit Fill(_PX,146,36,16,_INK)
      _REF=Aga Blit Copy(_PX,146,_PX,181,36,16)
      If _HIT=1
         _STATUS=Aga Text(239,91,224,"HIT")
      Else
         _STATUS=Aga Text(235,91,28,"FREE")
      End If
      _LOW=Aga Blit Fill(18,203,284,3,224)
      _T3=Aga Text(22,232,28,"MOVE MOUSE / CLICK TO EXIT")
      _T4=Aga Text(22,248,224,"R27 / SAFE / 68000 / AGA")
      ' Cursor marker on our independent AGA screen.
      _MX=Aga Mouse X
      _MY=Aga Mouse Y
      If _MX<0
         _MX=0
      End If
      If _MY<0
         _MY=0
      End If
      If _MX>314
         _MX=314
      End If
      If _MY>250
         _MY=250
      End If
      _CUR=Aga Blit Fill(_MX,_MY,6,6,224)
      _DRAWERR=0
      If _HEAD<>1 or _TOP<>1 or _BOT<>1 or _PANEL<>1 or _FIELD<>1
         _DRAWERR=1
      End If
      If _T1<>1 or _T2<>1 or _LABEL<>1 or _STATUS<>1
         _DRAWERR=1
      End If
      If _ZONE<>1 or _EDGE<>1 or _MOV<>1 or _REF<>1 or _TICKERR<>0
         _DRAWERR=1
      End If
      If _LOW<>1 or _T3<>1 or _T4<>1 or _CUR<>1
         _DRAWERR=1
      End If
      If _DRAWERR<>0
         _ERR=2
         _FRAME=600
      Else
         _SWREADY=0
         For _ST=1 To 12
            If _SWREADY=0
               _SW=Aga Swap
               If _SW=1
                  _SWREADY=1
               Else
                  _SWAP0=_SWAP0+1
                  Aga Wait Vbl
               End If
            End If
         Next _ST
         If _SWREADY=0
            _ERR=3
            _FRAME=600
         Else
            _SHOWN=_SHOWN+1
            _P=Aga Mouse Pressed
            _K=Aga Key
            If _P=1 or _P=3 or _K>=0
               _FRAME=600
            End If
            Aga Wait Vbl
         End If
      End If
   End If
Next _FRAME
Aga Screen Close
Amos To Front
Print "AGA SHOWCASE - FRAMES ";_SHOWN
Print "SAFE RETRIES ";_RETRY;" SWAP RETRIES ";_SWAP0
Print "ERROR ";_ERR;" (0=OK 1=SAFE 2=DRAW 3=SWAP)"
Print "CLOSE RETURNED"
End
