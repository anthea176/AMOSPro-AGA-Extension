' AGTM TILE BENCH - experimental AMOS Professional / MC68020+ / AGA.
' Requires M19 P2d. No AGTM native commands, no IFF or external assets.
' A: full tilemap redraw (320 opaque FICON8 tiles per viewport).
' B: in-place Blit Copy (304x256) plus 16 exposed tiles.
' Each trial starts from the same 320x256 camera-0 background.
' Exact pixels verified by two full planar C Block captures, outside Timer.
' This is a standalone example, NOT the active AGA regression ASC.
Set Buffer 20
Cls
Dim _TIME(1,1)
_RESULT=0 : _ERR=0 : _OPEN=0 : _DB=0 : _CLOSED=0
_REPS=4 : _RUNS=0 : _CALLS_A=0 : _CALLS_B=0
_PIXEL_BAD=0 : _PIXELS_OK=0 : _CAP_A=0 : _CAP_B=0
_SWAPS=0 : _RETRY_VBL=0 : _BANKS_SAFE=0
_CHIP0=Chip Free : _FAST0=Fast Free
_PRG=Prg State : _MODE$="UNKNOWN" : _LOG$="RAM:AGTM_BENCH_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:AGTM_BENCH_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:AGTM_BENCH_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:AGTM_BENCH_COMPILED.TXT"
End If
Print "AGTM TILE BENCH - FULL VS SCROLL"
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
For _B=20 To 24
   If Length(_B)<>0
      _ERR=2 : Goto _CLEANUP
   End If
Next _B
_BANKS_SAFE=1
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
For _I=0 To 8
   _P=Aga Palette Set(_I,_I*25,_I*20,_I*18)
   If _P<>1
      _ERR=5 : Goto _CLEANUP
   End If
Next _I
' Create a chunky source bank, a canonical AGTM map bank and FICON8 tiles.
Reserve As Data 20,256
Reserve As Data 21,416
_OK=Aga F Icon Bank Create(22,4)
If _OK<>1
   _ERR=6 : Goto _CLEANUP
End If
For _ID=1 To 4
   For _Y=0 To 15
      For _X=0 To 15
         _COL=_ID+1
         If _X=0 or _Y=0 or _X=15 or _Y=15
            _COL=0
         End If
         If _X=_Y
            _COL=8
         End If
         Poke Start(20)+_Y*16+_X,_COL
      Next _X
   Next _Y
   _OK=Aga F Icon Bank Put(22,_ID,20,0)
   If _OK<>1
      _ERR=7 : Goto _CLEANUP
   End If
Next _ID
' AGTM v1 data payload: 64-byte header, 22x16 indices, one layer.
_MP=Start(21)
Loke _MP,$4147544D
Doke _MP+4,1 : Doke _MP+6,64
Doke _MP+8,22 : Doke _MP+10,16
Poke _MP+12,16 : Poke _MP+13,16
Poke _MP+14,1 : Poke _MP+15,1
Doke _MP+16,4 : Doke _MP+18,0
Loke _MP+20,22 : Loke _MP+24,352
Loke _MP+28,64 : Loke _MP+32,352
For _I=36 To 63
   Poke _MP+_I,0
Next _I
For _Y=0 To 15
   For _X=0 To 21
      Poke _MP+64+_Y*22+_X,(_X+2*_Y) Mod 4
   Next _X
Next _Y
If Length(21)<>416 or Leek(Start(21))<>$4147544D
   _ERR=8 : Goto _CLEANUP
End If
If Deek(Start(21)+8)<>22 or Deek(Start(21)+10)<>16
   _ERR=9 : Goto _CLEANUP
End If
' Two AB/BA passes. Initial full camera-0 render is outside Timer.
For _PASS=0 To 1
   For _ORDER=0 To 1
      If _ERR=0
         _METHOD=_ORDER
         If _PASS=1
            _METHOD=1-_ORDER
         End If
         _TICKS=0
         For _REP=1 To _REPS
            If _ERR=0
               _CAM=0
               Gosub _DRAW_FULL
            End If
            If _ERR=0
               _T0=Timer
               If _METHOD=0
                  _CAM=1
                  Gosub _DRAW_FULL
                  _CALLS_A=_CALLS_A+320
               Else
                  Gosub _DRAW_SCROLL
                  _CALLS_B=_CALLS_B+17
               End If
               _TICKS=_TICKS+Timer-_T0
            End If
         Next _REP
         If _ERR=0
            _TIME(_METHOD,_PASS)=_TICKS
            _RUNS=_RUNS+1
         End If
         If _ERR=0 and _PASS=0
            Gosub _CAPTURE_RESULT
         End If
      End If
   Next _ORDER
Next _PASS
If _ERR<>0
   Goto _CLEANUP
End If
' Compare all 81920 planar bytes, rather than a few sampled pixels.
If _CAP_A<>1 or _CAP_B<>1
   _ERR=10 : Goto _CLEANUP
End If
_SRC_A=Start(23)+40 : _SRC_B=Start(24)+40
For _I=0 To 81919
   If Peek(_SRC_A+_I)<>Peek(_SRC_B+_I)
      _PIXEL_BAD=_PIXEL_BAD+1
   End If
Next _I
If _PIXEL_BAD<>0
   _ERR=11 : Goto _CLEANUP
End If
_PIXELS_OK=81920
' Preview final camera-1 image, keeping VBL/Swap outside Timer.
_SW=Aga Swap
For _TRY=1 To 20
   If _SW<>1
      Aga Wait Vbl
      _RETRY_VBL=_RETRY_VBL+1
      _SW=Aga Swap
   End If
Next _TRY
If _SW<>1
   _ERR=12 : Goto _CLEANUP
End If
_SWAPS=1
Amos To Back
For _HOLD=1 To 100
   Aga Wait Vbl
Next _HOLD
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   _CLOSED=1
End If
Amos To Front
If _BANKS_SAFE=1
   For _B=20 To 24
      If Length(_B)<>0
         Erase _B
      End If
   Next _B
End If
If _ERR=0 and _CLOSED=1 and _RUNS=4 and _PIXELS_OK=81920
   _RESULT=1
End If
_CHIP1=Chip Free : _FAST1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "AGTM BENCH ";_VERDICT$;" ERR ";_ERR
Print "RUNS ";_RUNS;" PIXELS OK ";_PIXELS_OK
Print "PASS0 FULL/SCROLL ";_TIME(0,0);"/";_TIME(1,0)
Print "PASS1 FULL/SCROLL ";_TIME(0,1);"/";_TIME(1,1)
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST AGTM_TILE_BENCH"
   Print #1,"LIBRARY_EXPECTED M19_P2D"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"REPS ";_REPS
   Print #1,"BENCH_RUNS ";_RUNS
   Print #1,"PASS0_FULL ";_TIME(0,0);" SCROLL ";_TIME(1,0)
   Print #1,"PASS1_FULL ";_TIME(0,1);" SCROLL ";_TIME(1,1)
   Print #1,"FULL_CALLS ";_CALLS_A
   Print #1,"SCROLL_CALLS ";_CALLS_B
   Print #1,"CAP_A ";_CAP_A;" CAP_B ";_CAP_B
   Print #1,"PIXELS_OK ";_PIXELS_OK;" PIXEL_BAD ";_PIXEL_BAD
   Print #1,"SWAPS ";_SWAPS;" RETRY_VBL ";_RETRY_VBL
   Print #1,"CHIP_BEFORE ";_CHIP0;" CHIP_AFTER ";_CHIP1
   Print #1,"FAST_BEFORE ";_FAST0;" FAST_AFTER ";_FAST1
   Print #1,"CLOSE_RETURNED ";_CLOSED
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
' Draw the 20x16 tile viewport. _CAM is the logical tile X offset.
_DRAW_FULL:
_MAPBASE=Start(21)+64
For _RY=0 To 15
   If _ERR=0
      For _RX=0 To 19
         _ID=Peek(_MAPBASE+_RY*22+_RX+_CAM)+1
         _DR=Aga F Icon(22,_ID,_RX*16,_RY*16,0)
         If _DR<>1
            _ERR=13
         End If
      Next _RX
   End If
Next _RY
Return
' In-place scroll 16 px to the left, then draw the new last column.
_DRAW_SCROLL:
_CP=Aga Blit Copy(16,0,0,0,304,256)
If _CP<>1
   _ERR=14
End If
If _ERR=0
   _MAPBASE=Start(21)+64
   For _RY=0 To 15
      _ID=Peek(_MAPBASE+_RY*22+20)+1
      _DR=Aga F Icon(22,_ID,304,_RY*16,0)
      If _DR<>1
         _ERR=15
      End If
   Next _RY
End If
Return
' Capture full back-bitplanes for exact equality after the first pass.
_CAPTURE_RESULT:
If _METHOD=0
   _CA=Aga C Block Capture(23,0,0,320,256,0)
   If _CA<>1 or Length(23)<>81960
      _ERR=16
   Else
      _CAP_A=1
   End If
Else
   _CB=Aga C Block Capture(24,0,0,320,256,0)
   If _CB<>1 or Length(24)<>81960
      _ERR=17
   Else
      _CAP_B=1
   End If
End If
Return
