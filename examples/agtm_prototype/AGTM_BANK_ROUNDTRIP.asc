' AGTM BANK ROUNDTRIP - AMOS Professional DATA bank / .ABK.
' No new AGA command; bank 26 MUST be free. No external input.
' Produces RAM:AGTM_V1_TEST.ABK (can overwrite an existing RAM: file).
' This is a prototype, not an active regression ASC.
Set Buffer 20
Cls
_RESULT=0 : _ERR=0 : _SAVEERR=0 : _LOADERR=0 : _BAD=0
_OWN=0 : _BANK=26 : _FILE$="RAM:AGTM_V1_TEST.ABK"
_PRG=Prg State : _MODE$="UNKNOWN"
_LOG$="RAM:AGTM_BANK_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:AGTM_BANK_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:AGTM_BANK_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:AGTM_BANK_COMPILED.TXT"
End If
Print "AGTM V1 - BANK SAVE/LOAD"
If Length(_BANK)<>0
   _ERR=1 : Goto _CLEANUP
End If
Reserve As Data 26,416
_OWN=1
If Length(26)<>416
   _ERR=2 : Goto _CLEANUP
End If
_P=Start(26)
' 64-byte AGTM v1 header: 22 columns, 16 rows, 1 layer, 4 tiles.
Loke _P,$4147544D
Doke _P+4,1 : Doke _P+6,64
Doke _P+8,22 : Doke _P+10,16
Poke _P+12,16 : Poke _P+13,16
Poke _P+14,1 : Poke _P+15,1
Doke _P+16,4 : Doke _P+18,0
Loke _P+20,22 : Loke _P+24,352
Loke _P+28,64 : Loke _P+32,352
For _I=36 To 63
   Poke _P+_I,0
Next _I
For _Y=0 To 15
   For _X=0 To 21
      _ID=((_X+2*_Y) Mod 4)+1
      Poke _P+64+_Y*22+_X,_ID
   Next _X
Next _Y
If Leek(_P)<>$4147544D or Deek(_P+6)<>64
   _ERR=3 : Goto _CLEANUP
End If
' Save/Erase/Load using AMOS native DATA-bank persistence.
Trap Save _FILE$,26
_SAVEERR=Errtrap
If _SAVEERR<>0
   _ERR=4 : Goto _CLEANUP
End If
Erase 26
_OWN=0
Trap Load _FILE$,26
_LOADERR=Errtrap
If _LOADERR<>0
   _ERR=5 : Goto _CLEANUP
End If
_OWN=1
If Length(26)<>416
   _ERR=6 : Goto _CLEANUP
End If
_P=Start(26)
If Leek(_P)<>$4147544D or Deek(_P+4)<>1 or Deek(_P+6)<>64
   _ERR=7 : Goto _CLEANUP
End If
If Deek(_P+8)<>22 or Deek(_P+10)<>16
   _ERR=8 : Goto _CLEANUP
End If
If Leek(_P+20)<>22 or Leek(_P+24)<>352
   _ERR=9 : Goto _CLEANUP
End If
If Leek(_P+28)<>64 or Leek(_P+32)<>352
   _ERR=10 : Goto _CLEANUP
End If
For _I=36 To 63
   If Peek(_P+_I)<>0
      _BAD=_BAD+1
   End If
Next _I
For _Y=0 To 15
   For _X=0 To 21
      _ID=((_X+2*_Y) Mod 4)+1
      If Peek(_P+64+_Y*22+_X)<>_ID
         _BAD=_BAD+1
      End If
   Next _X
Next _Y
If _BAD<>0
   _ERR=11 : Goto _CLEANUP
End If
_RESULT=1
_CLEANUP:
If _OWN=1
   If Length(26)<>0
      Erase 26
   End If
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
Print "AGTM BANK ";_VERDICT$;" ERR ";_ERR
Print "SAVEERR ";_SAVEERR;" LOADERR ";_LOADERR;" BAD ";_BAD
_LOGERR=0 : _CLOSEERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST AGTM_BANK_ROUNDTRIP"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"SAVE_ERROR ";_SAVEERR
   Print #1,"LOAD_ERROR ";_LOADERR
   Print #1,"BYTE_MISMATCH ";_BAD
   Print #1,"PAYLOAD_LENGTH 416"
   Print #1,"FILE ";_FILE$
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Print "RAM LOG ";_LOG$;" OPEN ";_LOGERR;" CLOSE ";_CLOSEERR
End
