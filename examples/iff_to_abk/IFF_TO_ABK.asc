' IFF -> AGAPIC ABK -> RELOAD -> AGA DISPLAY.
' Use promoted R68 LAST_GOOD (not the R70 development candidate).
' AMOS Professional: Project / Merge ASCII.
' Erase 11 is deliberate: an existing bank 11 WILL BE DELETED.
' Output pair: RAM:IFF_TO_ABK.abk and RAM:IFF_TO_ABK.iff.
' AGAPIC has PIXELS only; save colour palette in companion .iff.
Cls
Print "IFF TO ABK - SELECT AN IFF / ILBM"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_B=11
_ABK$="RAM:IFF_TO_ABK.abk"
_PALFILE$=Left$(_ABK$,Len(_ABK$)-4)+".iff"
Erase _B
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<1 or _H<1 or _D<1 or _D>8 or _C<2 or _C>256 or _MODE<0
   Print "UNSUPPORTED INDEXED IFF / ILBM"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "AGA SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
' Save the CMAP as its own palette-only IFF BEFORE changing the palette.
' This companion file uses the same basename as the ABK.
_PSAVE=Aga Palette Save(_PALFILE$)
If _PSAVE<>1
   Aga Screen Close
   Amos To Front
   Print "PALETTE SAVE FAILED"
   End
End If
' Capture BEFORE the first swap: Capture reads the BACK buffer.
' -1 means OPAQUE, including colour index 0.
_CAP=Aga Image Capture(_B,0,0,_W,_H,-1)
If _CAP<>1
   Aga Screen Close
   Amos To Front
   Print "IMAGE CAPTURE FAILED (BANK 11 / MEMORY)"
   End
End If
_SIZE=Length(_B)
If Start(_B)=0 or _SIZE<32
   Aga Screen Close
   Amos To Front
   Print "INVALID CAPTURED BANK"
   End
End If
If Peek$(Start(_B),6)<>"AGAPIC"
   Aga Screen Close
   Amos To Front
   Print "NOT AN AGAPIC BANK"
   End
End If
' AMOS Save writes the native ABK wrapper around the AGAPIC DATA bank.
Save _ABK$,_B
' Show the original IFF briefly.
_SW0=Aga Swap
If _SW0<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "FIRST SWAP FAILED"
   End
End If
Amos To Back
For _I=1 To 60
   Aga Wait Vbl
Next _I
' Destroy the original in-memory DATA bank after saving it.
Erase _B
' Wipe the BACK buffer and display the loading message.
_CLEAR=0
For _TRY=1 To 20
   If _CLEAR=0
      _CLEAR=Aga Blit Clear(0,0,_W,_H)
      If _CLEAR=0
         Aga Wait Vbl
      End If
   End If
Next _TRY
If _CLEAR<>1
   Aga Screen Close
   Amos To Front
   Print "CLEAR FAILED (BUFFER NOT SAFE)"
   End
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,255,255,255)
_TX=Aga Text(24,112,1,"CHARGEMENT ABK")
If _P0<>1 or _P1<>1 or _TX<>1
   Aga Screen Close
   Amos To Front
   Print "LOADING MESSAGE FAILED"
   End
End If
_SW1=Aga Swap
If _SW1<>1
   Aga Screen Close
   Amos To Front
   Print "MESSAGE SWAP FAILED"
   End
End If
For _I=1 To 60
   Aga Wait Vbl
Next _I
' Load the ABK from disk: the AGAPIC DATA bank is recreated.
Load _ABK$,_B
If Start(_B)=0
   Aga Screen Close
   Amos To Front
   Print "ABK LOAD FAILED"
   End
End If
If Peek$(Start(_B),6)<>"AGAPIC" or Length(_B)<>_SIZE
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "INVALID RELOADED ABK"
   End
End If
' Wipe the BACK buffer again; never reuse pixels from the old IFF.
_CLEAR2=0
For _TRY=1 To 20
   If _CLEAR2=0
      _CLEAR2=Aga Blit Clear(0,0,_W,_H)
      If _CLEAR2=0
         Aga Wait Vbl
      End If
   End If
Next _TRY
If _CLEAR2<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "RECONSTRUCTION CLEAR FAILED"
   End
End If
_DRAW=0
For _TRY=1 To 20
   If _DRAW=0
      _DRAW=Aga Bank Image Draw(_B,0,0,0)
      If _DRAW=0
         Aga Wait Vbl
      End If
   End If
Next _TRY
If _DRAW<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "AGAPIC DRAW FAILED"
   End
End If
' AGAPIC stores no CMAP; restore palette from saved companion.
' The original source IFF is not used during reconstruction.
_PAL=Aga Palette Load(_PALFILE$)
If _PAL<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "PALETTE LOAD FAILED"
   End
End If
_SW2=Aga Swap
If _SW2<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "FINAL SWAP FAILED"
   End
End If
' Reconstructed image stays visible until a keyboard key is pressed.
_K=Aga Wait Key
Aga Screen Close
Amos To Front
Erase _B
Print "IFF -> ABK -> IFF PALETTE / AGAPIC PIXELS"
Print "ABK SAVED AS ";_ABK$
Print "PALETTE SAVED AS ";_PALFILE$
Print "AGAPIC BYTES ";_SIZE;" KEY ";_K
Print "RESULT 1"
Print "CLOSE RETURNED"
End
