' ABK VIEWER - select AGAPIC ABK, load its companion palette IFF.
' Compatible with IFF_TO_ABK.asc output pair (.abk / .iff).
' PAL LowRes 320x256, indexed 2..256 colours; no source IFF needed.
' Erase 11 is intentional and destroys its previous contents.
Cls
Print "ABK VIEWER - SELECT AN AGAPIC .abk"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_B=11
_ABK$=Fsel$("**")
If _ABK$=""
   Print "CANCELLED"
   End
End If
If Len(_ABK$)<5
   Print "SELECT A FILE WITH .abk EXTENSION"
   End
End If
_PALFILE$=Left$(_ABK$,Len(_ABK$)-4)+".iff"
Erase _B
Load _ABK$,_B
' A successful Load recreates an AMOS DATA bank with AGAPIC contents.
_A=Start(_B)
_SIZE=Length(_B)
If _A=0 or _SIZE<36
   Erase _B
   Print "INVALID ABK BANK"
   End
End If
If Peek$(_A,6)<>"AGAPIC" or Deek(_A+6)<>1
   Erase _B
   Print "NOT AN AGAPIC V1 DATA BANK"
   End
End If
_W=Deek(_A+12)
_H=Deek(_A+14)
_D=Deek(_A+16)
If _W<1 or _W>320 or _H<1 or _H>256 or _D<1 or _D>8
   Erase _B
   Print "ABK OUT OF PAL 320X256 LIMITS"
   End
End If
_C=1
For _I=1 To _D
   _C=_C*2
Next _I
_OPEN=Aga Screen Open(320,256,_C,$00021000)
If _OPEN<>1
   Erase _B
   Print "AGA SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "DOUBLE BUFFER FAILED"
   End
End If
' The palette companion has BMHD/CMAP but no image BODY.
' This command loads palette only; AGAPIC supplies all pixels.
_PAL=Aga Palette Load(_PALFILE$)
If _PAL<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "COMPANION PALETTE NOT FOUND"
   Print _PALFILE$
   End
End If
' Clear the AGA BACK buffer first, including unused screen borders.
_CLEAR=0
For _TRY=1 To 20
   If _CLEAR=0
      _CLEAR=Aga Blit Clear(0,0,320,256)
      If _CLEAR=0
         Aga Wait Vbl
      End If
   End If
Next _TRY
If _CLEAR<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "BACK BUFFER CLEAR FAILED"
   End
End If
' Draw the reloaded ABK on the private AGA BACK buffer.
_DRAW=0
For _TRY=1 To 20
   If _DRAW=0
      _DRAW=Aga Bank Image Draw(_B,0,0,0)
      If _DRAW=0
         Aga Wait Vbl
      End If
   End If
Next _TRY
If _DRAW<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "AGAPIC DRAW FAILED"
   End
End If
_SWAP=Aga Swap
If _SWAP<>1
   Aga Screen Close
   Amos To Front
   Erase _B
   Print "AGA SWAP FAILED"
   End
End If
Amos To Back
_K=Aga Wait Key
Aga Screen Close
Amos To Front
Erase _B
Print "ABK VIEWER - KEY ";_K
Print "AGAPIC SIZE ";_SIZE;"  WIDTH ";_W;" HEIGHT ";_H
Print "PALETTE ";_PALFILE$
Print "RESULT 1"
Print "CLOSE RETURNED"
End
