' R54 - NEW BANK NUMBER API, backward compatible with R53/R46.
' First try under AMOS interpreted, then compile a NEW executable.
' Copy M16_AGAPIC_SAMPLE_BANK10.abk and Hwarf1252S.abk beside this ASC.
' LOAD overwrites banks 10 and 25: test in disposable WinUAE only.
Cls
Print "R54 BANK NUMBER HELPERS"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
Load "AGAPIC_SAMPLE_BANK10.abk",10
Load "Hwarf1252S.abk",25
If Start(10)=0 or Start(25)=0
   Print "REFERENCE BANKS MISSING"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,16,$00021000)
If _OPEN<>1
   Print "OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,255,40,190)
_P1=Aga Palette Set(1,255,255,255)
_P2=Aga Palette Set(2,20,35,65)
_CLEAR=Aga Blit Clear(0,0,320,256)
_FILL=Aga Blit Fill(0,0,320,256,2)
_DN=Aga Bank Image Draw(10,20,70,0)
_DO=Aga Image Draw(Start(10),Length(10),120,70,0)
_DM=Aga Bank Image Draw(10,220,70,1)
_BADIMG=Aga Bank Image Draw(4,20,70,0)
_FN=Aga Bank Font Select(25)
_TN=Aga Text(25,143,1,"NEW BANK FONT SELECT")
_FO=Aga Font Bank Select(Start(25),Length(25))
_TO=Aga Text(25,174,1,"OLD FONT BANK SELECT")
_BADFONT=Aga Bank Font Select(4)
Erase 25
_TL=Aga Text(25,205,1,"FONT AFTER ERASE 25")
_RESET=Aga Font Select("",0)
_SWAP=Aga Swap
If _SWAP=1
   Amos To Back
End If
For _I=1 To 75
   Aga Wait Vbl
Next _I
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Bank Image Draw(10,20,70,0)
Erase 10
_CF1=Chip Free
_RESULT=1
If _OPEN<>1 or _DB<>1 or _P0<>1 or _P1<>1 or _P2<>1
   _RESULT=0
End If
If _CLEAR<>1 or _FILL<>1 or _DN<>1 or _DO<>1 or _DM<>1
   _RESULT=0
End If
If _BADIMG<>0 or _BADFONT<>0 or _NOSCREEN<>0
   _RESULT=0
End If
If _FN<>1 or _FO<>1 or _TN<>1 or _TO<>1 or _TL<>1
   _RESULT=0
End If
If _RESET<>1 or _SWAP<>1
   _RESULT=0
End If
Print "DRAW NEW O/M OLD ";_DN;" ";_DM;" ";_DO
Print "FONT NEW/OLD/TEXT ";_FN;" ";_FO;" ";_TN;" ";_TO;" ";_TL
Print "INVALID IMG/FONT ";_BADIMG;" ";_BADFONT;" NOS ";_NOSCREEN
Print "CHIP BEFORE/END ";_CF0;" ";_CF1
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
