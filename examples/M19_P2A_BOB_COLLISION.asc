' M19 P2a - Bob collision Runtime smoke test / MC68020 AGA
' API: Aga Bob Col(A,B,Mode) = 1 hit, 0 no hit, -1 invalid
' Bank 24 = 16x15 image with transparent centre; bank 25 = 4x4 opaque
Set Buffer 20
Cls
_BANK1=24 : _BANK2=25 : _OWN1=0 : _OWN2=0
_OPEN=0 : _DB=0 : _ERR=0 : _OK=0 : _CHECKS=0
_RECT1=-99 : _MASK1=-99 : _RECT2=-99 : _MASK2=-99
_CLIPPED=-99 : _RESET=-99 : _OFF=-99 : _BADMODE=-99
_LOG$="RAM:M19_P2A_BOB_COL.TXT"
_PRG=Prg State
_MODE$="UNKNOWN"
If _PRG=0
   _MODE$="INTERPRETED"
End If
If _PRG=1
   _MODE$="RUNTIME"
End If
If _PRG=-1
   _MODE$="COMPILED"
End If
If Aga Detect=0
   _ERR=1 : Goto _CLEANUP
End If
If Length(_BANK1)<>0 or Length(_BANK2)<>0
   _ERR=2 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=3 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=4 : Goto _CLEANUP
End If
_A=Aga Palette Set(0,0,0,0)
_A=Aga Palette Set(4,255,64,48)
_A=Aga Palette Set(5,255,228,38)
_A=Aga Blit Fill(12,16,16,15,4)
_B=Aga Blit Fill(17,21,5,5,0)
_C=Aga Blit Fill(62,16,4,4,5)
If _A<>1 or _B<>1 or _C<>1
   _ERR=5 : Goto _CLEANUP
End If
Aga Bob Bank _BANK1
If Length(_BANK1)<>0
   _OWN1=1
End If
Get AGA Bob 1,12,16,28,30
Make AGA Bob Mask 1,0
Aga Bob Bank _BANK2
If Length(_BANK2)<>0
   _OWN2=1
End If
Get AGA Bob 1,62,16,66,20
No AGA Bob Mask 1
Aga Bob Bank _BANK1
Aga Bob 1,100,100,1
Aga Bob Bank _BANK2
Aga Bob 2,105,105,1
_UP=Aga Bob Update
If _UP<>1
   _ERR=6 : Goto _CLEANUP
End If
_RECT1=Aga Bob Col(1,2,0)
_MASK1=Aga Bob Col(1,2,1)
If _RECT1<>1 or _MASK1<>0
   _ERR=7 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+2
Aga Bob 2,110,105,1
_UP=Aga Bob Update
If _UP<>1
   _ERR=8 : Goto _CLEANUP
End If
_RECT2=Aga Bob Col(1,2,0)
_MASK2=Aga Bob Col(1,2,1)
If _RECT2<>1 or _MASK2<>1
   _ERR=9 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+2
_LIM=Aga Limit Bob(1,100,100,3,3)
_CLIPPED=Aga Bob Col(1,2,0)
If _LIM<>1 or _CLIPPED<>0
   _ERR=10 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+1
_LIM=Aga Limit Bob(1,0,0,0,0)
_RESET=Aga Bob Col(1,2,0)
If _LIM<>1 or _RESET<>1
   _ERR=11 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+1
_BADMODE=Aga Bob Col(1,2,2)
If _BADMODE<>-1
   _ERR=12 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+1
Aga Bob Off 2
_OFF=Aga Bob Col(1,2,1)
If _OFF<>-1
   _ERR=13 : Goto _CLEANUP
End If
_CHECKS=_CHECKS+1
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   Amos To Front
End If
If _OWN1=1
   Erase _BANK1
End If
If _OWN2=1
   Erase _BANK2
End If
If _ERR=0 and _CHECKS=8
   _OK=1
End If
_VERDICT$="FAIL"
If _OK=1
   _VERDICT$="PASS"
End If
Print "M19 P2a COLLISION ";_VERDICT$;" ERR ";_ERR
Print "RECT1 ";_RECT1;" MASK1 ";_MASK1
Print "RECT2 ";_RECT2;" MASK2 ";_MASK2
Print "CLIP ";_CLIPPED;" RESET ";_RESET
Print "BADMODE ";_BADMODE;" OFF ";_OFF
_LOGERR=0
Trap Open Out 1,_LOG$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST M19 P2A BOB COLLISION"
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RESULT ";_OK
   Print #1,"ERR ";_ERR
   Print #1,"CHECKS ";_CHECKS
   Print #1,"RECT_HOLE ";_RECT1
   Print #1,"MASK_HOLE ";_MASK1
   Print #1,"RECT_SOLID ";_RECT2
   Print #1,"MASK_SOLID ";_MASK2
   Print #1,"CLIPPED ";_CLIPPED
   Print #1,"RESET ";_RESET
   Print #1,"BAD_MODE ";_BADMODE
   Print #1,"BOB_OFF ";_OFF
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
End
