' AGA BOBS - LOCAL BACKGROUND RESTORATION
' Standalone AMOS Professional example. MC68020+ AGA PAL.
' Requires B7-m1 library. RUNTIME ONLY; Compiler not qualified.
' 4 Bobs, two screen buffers, per-page dirty rectangles.
' Title is fixed (Y 0..31); clean tile master is at Y 32..63.
' KEY OR MOUSE CLICK: EXIT. AUTO EXIT AFTER 2400 FRAMES.
Set Buffer 20
Cls
Dim _OX1(1),_OY1(1),_OX2(1),_OY2(1)
Dim _OX3(1),_OY3(1),_OX4(1),_OY4(1)
_BANK1=24 : _BANK2=25 : _ERR=0 : _OPEN=0 : _DB=0
_OWN1=0 : _OWN2=0 : _FRAMES=0 : _PAGE=0 : _QUIT=0
_DRAW=0 : _SW=0 : _COPY=0 : _RESULT=0
_FILL_BAD=0 : _COPY_BAD=0 : _DRAW_BAD=0 : _SW_BAD=0
_COUNT1=0 : _COUNT2=0 : _MASKFLAG=0
_CLOSE_CALLED=0 : _BANKS_ERASED=0 : _RETRY_VBL=0
_PRG=Prg State
If _PRG=-1
   _ERR=1 : Goto _CLEANUP
End If
Print "AGA BOBS - LOCAL RESTORE"
If Aga Detect=0
   _ERR=2 : Goto _CLEANUP
End If
If Length(_BANK1)<>0 or Length(_BANK2)<>0
   _ERR=3 : Goto _CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=4 : Goto _CLEANUP
End If
_DB=Aga Double Buffer
If _DB<>1
   _ERR=5 : Goto _CLEANUP
End If
_P0=Aga Palette Set(0,0,0,0)
_P1=Aga Palette Set(1,18,26,51)
_P2=Aga Palette Set(2,38,53,85)
_P3=Aga Palette Set(3,68,88,115)
_P4=Aga Palette Set(4,255,64,48)
_P5=Aga Palette Set(5,255,228,38)
_P6=Aga Palette Set(6,44,122,103)
_P7=Aga Palette Set(7,144,176,191)
_P8=Aga Palette Set(8,43,72,99)
_P9=Aga Palette Set(9,172,116,54)
_A=Aga Blit Fill(0,0,320,256,0)
If _A<>1
   _ERR=6 : Goto _CLEANUP
End If
_A=Aga Blit Fill(12,16,17,15,4)
_B=Aga Blit Fill(17,21,5,5,0)
If _A<>1 or _B<>1
   _ERR=7 : Goto _CLEANUP
End If
Aga Bob Bank _BANK1
If Length(_BANK1)<>0
   _OWN1=1
End If
If Length(_BANK1)<>32
   _ERR=8 : Goto _CLEANUP
End If
Get AGA Bob 1,12,16,28,30
Make AGA Bob Mask 1,0
_COUNT1=Deek(Start(_BANK1)+8)
_MASKFLAG=Deek(Start(_BANK1)+42)
If _COUNT1<>1 or _MASKFLAG<>1
   _ERR=9 : Goto _CLEANUP
End If
_A=Aga Blit Fill(62,16,37,8,5)
If _A<>1
   _ERR=10 : Goto _CLEANUP
End If
Aga Bob Bank _BANK2
If Length(_BANK2)<>0
   _OWN2=1
End If
If Length(_BANK2)<>32
   _ERR=11 : Goto _CLEANUP
End If
Get AGA Bob 1,62,16,98,23
No AGA Bob Mask 1
_COUNT2=Deek(Start(_BANK2)+8)
If _COUNT2<>1
   _ERR=12 : Goto _CLEANUP
End If
' Prepare matching scene sources in EACH AGA back buffer.
For _WARM=1 To 2
   If _ERR=0
      Gosub _BUILD_SCENE
   End If
   If _ERR=0
      Gosub _RESTORE_ALL
   End If
   If _ERR=0
      Gosub _DO_SWAP
   End If
Next _WARM
If _ERR<>0
   Goto _CLEANUP
End If
Amos To Back
' Consume the launch event before checking for exit.
_KEY=Aga Key : _CLICK=Aga Mouse Pressed
' Animated example: no benchmark, no Timer, no repeated full Clear.
For _PASS=1 To 20
   For _FRAME=1 To 120
      If _ERR=0 and _QUIT=0
         _PHASE=_FRAME
         If _FRAME>60
            _PHASE=120-_FRAME
         End If
         _X1=-10+_PHASE*5 : _Y1=72
         _X2=315-_PHASE*5 : _Y2=110
         _X3=-5+_PHASE*2 : _Y3=170-_PHASE
         _X4=315-_PHASE*3 : _Y4=200-_PHASE
         If _FRAMES<2
            Gosub _RESTORE_ALL
         Else
            _DX=_OX1(_PAGE) : _DY=_OY1(_PAGE) : _DW=17 : _DH=15
            Gosub _COPY_TILE_RECT
            If _ERR=0
               _DX=_OX2(_PAGE) : _DY=_OY2(_PAGE) : _DW=37 : _DH=8
               Gosub _COPY_TILE_RECT
            End If
            If _ERR=0
               _DX=_OX3(_PAGE) : _DY=_OY3(_PAGE) : _DW=17 : _DH=15
               Gosub _COPY_TILE_RECT
            End If
            If _ERR=0
               _DX=_OX4(_PAGE) : _DY=_OY4(_PAGE) : _DW=37 : _DH=8
               Gosub _COPY_TILE_RECT
            End If
         End If
         If _ERR=0
            Aga Bob Bank _BANK1
            Aga Bob 1,_X1,_Y1,1
            Aga Bob 3,_X3,_Y3,1
            Aga Bob Bank _BANK2
            Aga Bob 2,_X2,_Y2,1
            Aga Bob 4,_X4,_Y4,1
            _DRAW=Aga Bob Draw
            If _DRAW<>1
               _DRAW_BAD=_DRAW_BAD+1 : _ERR=14
            End If
         End If
         If _ERR=0
            Gosub _DO_SWAP
         End If
         If _ERR=0
            _FRAMES=_FRAMES+1
            _OX1(_PAGE)=_X1 : _OY1(_PAGE)=_Y1
            _OX2(_PAGE)=_X2 : _OY2(_PAGE)=_Y2
            _OX3(_PAGE)=_X3 : _OY3(_PAGE)=_Y3
            _OX4(_PAGE)=_X4 : _OY4(_PAGE)=_Y4
            _PAGE=1-_PAGE
            _KEY=Aga Key : _CLICK=Aga Mouse Pressed
            If _KEY>0 or _CLICK>0
               _QUIT=1
            End If
         End If
      End If
   Next _FRAME
Next _PASS
_CLEANUP:
If _OPEN=1
   Aga Screen Close
   Amos To Front
   _CLOSE_CALLED=1
End If
If _OWN1=1
   Erase _BANK1
   _BANKS_ERASED=_BANKS_ERASED+1
End If
If _OWN2=1
   Erase _BANK2
   _BANKS_ERASED=_BANKS_ERASED+1
End If
If _ERR=0 and _FRAMES>0 and _CLOSE_CALLED=1
   _RESULT=1
End If
Print "AGA BOBS / LOCAL RESTORE"
Print "RESULT ";_RESULT;" ERR ";_ERR
Print "FRAMES ";_FRAMES;" DRAW FAIL ";_DRAW_BAD
Print "COPY FAIL ";_COPY_BAD;" SWAP FAIL ";_SW_BAD
Print "CLOSE ";_CLOSE_CALLED;" BANKS ERASED ";_BANKS_ERASED
End
' Set the clean 32-pixel tile and a header outside its source area.
_BUILD_SCENE:
_PX=0 : _PY=0 : _PW=320 : _PH=64 : _COL=1
Gosub _PAINT_RECT
_PX=0 : _PY=0 : _PW=320 : _PH=3 : _COL=7
Gosub _PAINT_RECT
_PX=0 : _PY=30 : _PW=320 : _PH=2 : _COL=7
Gosub _PAINT_RECT
If _ERR=0
   _TX1=0 : _TRY=0
   Repeat
      _TRY=_TRY+1
      _TX1=Aga Text(12,15,7,"AGA BOBS - LOCAL RESTORE")
      If _TX1=0 and _TRY<40
         Aga Wait Vbl
      End If
   Until _TX1=1 or _TRY=40
   If _TX1<>1
      _ERR=17
   End If
End If
If _ERR=0
   _TX2=0 : _TRY=0
   Repeat
      _TRY=_TRY+1
      _TX2=Aga Text(12,27,5,"4 BOBS / KEY OR CLICK TO EXIT")
      If _TX2=0 and _TRY<40
         Aga Wait Vbl
      End If
   Until _TX2=1 or _TRY=40
   If _TX2<>1
      _ERR=17
   End If
End If
_PX=0 : _PY=32 : _PW=320 : _PH=32 : _COL=1
Gosub _PAINT_RECT
For _T=0 To 9
   _PX=_T*32+2 : _PY=35 : _PW=28 : _PH=25 : _COL=3
   Gosub _PAINT_RECT
   _PX=_T*32+4 : _PY=38 : _PW=20 : _PH=5 : _COL=7
   Gosub _PAINT_RECT
   _PX=_T*32+8 : _PY=48 : _PW=15 : _PH=3 : _COL=6
   Gosub _PAINT_RECT
   _PX=_T*32+4 : _PY=54 : _PW=22 : _PH=4 : _COL=8
   Gosub _PAINT_RECT
   _PX=_T*32+23 : _PY=55 : _PW=4 : _PH=4 : _COL=9
   Gosub _PAINT_RECT
Next _T
Return
' Only copy clean source pixels from Y 32..63 into Y 64..255.
_RESTORE_ALL:
For _ROW=2 To 7
   If _ERR=0
      _DX=0 : _DY=_ROW*32 : _DW=320 : _DH=32
      Gosub _COPY_TILE_RECT
   End If
Next _ROW
Return
' Restore old positions on the correct hidden page, split at Y=32.
_COPY_TILE_RECT:
If _ERR=0
   If _DX<0
      _DW=_DW+_DX : _DX=0
   End If
   If _DY<64
      _DH=_DH+_DY-64 : _DY=64
   End If
   If _DX+_DW>320
      _DW=320-_DX
   End If
   If _DY+_DH>256
      _DH=256-_DY
   End If
   If _DW>0 and _DH>0
      _REST_H=_DH
      Repeat
         _SY=_DY
         Repeat
            _SY=_SY-32
         Until _SY<64
         _SLICE=_REST_H
         If _SLICE>64-_SY
            _SLICE=64-_SY
         End If
         _COPY=0 : _TRY=0
         Repeat
            _TRY=_TRY+1
            _COPY=Aga Blit Copy(_DX,_SY,_DX,_DY,_DW,_SLICE)
            If _COPY=0 and _TRY<40
               Aga Wait Vbl
               _RETRY_VBL=_RETRY_VBL+1
            End If
         Until _COPY=1 or _TRY=40
         If _COPY<>1
            _COPY_BAD=_COPY_BAD+1 : _ERR=13
         Else
            _DY=_DY+_SLICE
            _REST_H=_REST_H-_SLICE
         End If
      Until _REST_H=0 or _ERR<>0
   End If
End If
Return
' PAINT THE STATIC HEADER AND THE 32-PIXEL BACKGROUND SOURCE.
_PAINT_RECT:
If _ERR=0
   _PAINT=0 : _TRY=0
   Repeat
      _TRY=_TRY+1
      _PAINT=Aga Blit Fill(_PX,_PY,_PW,_PH,_COL)
      If _PAINT=0 and _TRY<40
         Aga Wait Vbl
         _RETRY_VBL=_RETRY_VBL+1
      End If
   Until _PAINT=1 or _TRY=40
   If _PAINT<>1
      _FILL_BAD=_FILL_BAD+1 : _ERR=16
   End If
End If
Return
' SWAP ONLY WHEN THE COMPLETE BACK PAGE IS READY.
_DO_SWAP:
_SW=0 : _TRY=0
Repeat
   _TRY=_TRY+1
   _SW=Aga Swap
   If _SW=0 and _TRY<40
      Aga Wait Vbl
      _RETRY_VBL=_RETRY_VBL+1
   End If
Until _SW=1 or _TRY=40
If _SW<>1
   _SW_BAD=_SW_BAD+1 : _ERR=15
End If
Return
