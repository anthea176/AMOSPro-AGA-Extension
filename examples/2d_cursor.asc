' M15 + M15bis - interactive AGA 2D and cursor showcase.
' Requires AMOSPro_AGA.Lib R44 v0.11.5 or later.
' NO IFF, no fonts and no additional AMCAF banks required.
' Plot = stars + centre; Draw = axes + moving crosshair.
' Box = frames + reticle; Circle = radar + reticle ring.
' R44 Mouse Cursor hides/shows ONLY the private AGA pointer.
' RIGHT CLICK toggles native cursor; LEFT CLICK or KEY exits.
' Auto exit after 600 frames. Only interpreted AMOS tested
' functions are used; this standalone demo itself is UNTESTED.
Cls
Print "M15 / M15BIS - AGA 2D SHOWCASE"
If Aga Detect=0
   Print "AGA CHIPSET NOT DETECTED"
   End
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_PA=Aga Palette Set(1,245,248,255)
_PB=Aga Palette Set(2,80,208,255)
_PC=Aga Palette Set(3,255,110,190)
_PD=Aga Palette Set(4,255,222,95)
_PE=Aga Palette Set(5,172,140,255)
_PF=Aga Palette Set(6,23,45,80)
_PG=Aga Palette Set(7,110,255,178)
_PH=Aga Palette Set(8,255,88,100)
If _PA<>1 or _PB<>1 or _PC<>1 or _PD<>1
   Aga Screen Close
   Amos To Front
   Print "PALETTE FAILED"
   End
End If
If _PE<>1 or _PF<>1 or _PG<>1 or _PH<>1
   Aga Screen Close
   Amos To Front
   Print "PALETTE FAILED"
   End
End If
' Hide the Intuition pointer. Our crosshair will follow the mouse.
_VISIBLE=0
_CUR=Aga Mouse Cursor(0)
If _CUR<>1
   Aga Screen Close
   Amos To Front
   Print "CURSOR INITIALIZATION FAILED"
   End
End If
' Discard input events from loading the example.
_P=Aga Mouse Pressed
_K=Aga Key
_ERR=0
_SHOWN=0
_TOGGLES=0
_SAFE_RETRIES=0
_SWAP_RETRIES=0
Amos To Back
For _FRAME=1 To 600
   If _ERR=0
      ' Always wait for an available back buffer BEFORE drawing.
      _READY=0
      For _TRY=1 To 12
         If _READY=0
            _CLEAR=Aga Blit Clear(0,0,320,256)
            If _CLEAR=1
               _READY=1
            Else
               _SAFE_RETRIES=_SAFE_RETRIES+1
               Aga Wait Vbl
            End If
         End If
      Next _TRY
      If _READY=0
         _ERR=1
         _FRAME=600
      Else
         ' Background panels; everything below is drawn on the back.
         _TOP=Aga Blit Fill(8,8,304,48,6)
         _FOOT=Aga Blit Fill(8,219,304,32,6)
         ' BOX: window borders and a square around the radar.
         _B0=Aga Box(5,5,314,250,2)
         _B1=Aga Box(11,61,308,215,2)
         _B2=Aga Box(92,66,228,204,3)
         ' DRAW: X/Y axes and diagonals.
         _L0=Aga Draw(160,69,160,201,6)
         _L1=Aga Draw(94,135,226,135,6)
         _L2=Aga Draw(114,89,206,181,5)
         _L3=Aga Draw(114,181,206,89,5)
         ' CIRCLE: three coloured concentric outlines.
         _C0=Aga Circle(160,135,65,7)
         _C1=Aga Circle(160,135,45,4)
         _C2=Aga Circle(160,135,23,3)
         ' PLOT: a field of individual stars.
         _BAD=0
         For _I=0 To 22
            _PX=18+_I*12
            _PY=73+(_I And 3)*39
            _DOT=Aga Plot(_PX,_PY,2)
            If _DOT<>1
               _BAD=1
            End If
         Next _I
         _CENTER=Aga Plot(160,135,1)
         ' Read mouse even while the native pointer is hidden.
         _MX=Aga Mouse X
         _MY=Aga Mouse Y
         If _MX<0
            _MX=0
         End If
         If _MX>319
            _MX=319
         End If
         If _MY<65
            _MY=65
         End If
         If _MY>210
            _MY=210
         End If
         ' Moving crosshair: all four M15 primitives cooperate.
         _RING=Aga Circle(_MX,_MY,10,1)
         _HLINE=Aga Draw(_MX-16,_MY,_MX+16,_MY,1)
         _VLINE=Aga Draw(_MX,_MY-16,_MX,_MY+16,1)
         _BOX=Aga Box(_MX-4,_MY-4,_MX+4,_MY+4,4)
         _POINT=Aga Plot(_MX,_MY,8)
         ' AGA text and distinct cursor-state label.
         _TITLE=Aga Text(16,28,1,"M15 + M15BIS / AGA 2D")
         _SUB=Aga Text(16,47,2,"PLOT / DRAW / BOX / CIRCLE")
         If _VISIBLE=0
            _STATUS=Aga Text(245,47,4,"HIDDEN")
         Else
            _STATUS=Aga Text(245,47,7,"VISIBLE")
         End If
         _HELP=Aga Text(14,233,1,"RIGHT: CURSOR / LEFT: EXIT")
         _HELP2=Aga Text(14,247,2,"KEY: EXIT / 600 FRAMES MAX")
         If _TOP<>1 or _FOOT<>1 or _B0<>1 or _B1<>1 or _B2<>1
            _BAD=1
         End If
         If _L0<>1 or _L1<>1 or _L2<>1 or _L3<>1
            _BAD=1
         End If
         If _C0<>1 or _C1<>1 or _C2<>1 or _CENTER<>1
            _BAD=1
         End If
         If _RING<>1 or _HLINE<>1 or _VLINE<>1 or _BOX<>1 or _POINT<>1
            _BAD=1
         End If
         If _TITLE<>1 or _SUB<>1 or _STATUS<>1 or _HELP<>1 or _HELP2<>1
            _BAD=1
         End If
         If _BAD<>0
            _ERR=2
            _FRAME=600
         Else
            ' Present the completed frame; bounded Swap retries.
            _SWREADY=0
            For _ST=1 To 12
               If _SWREADY=0
                  _SW=Aga Swap
                  If _SW=1
                     _SWREADY=1
                  Else
                     _SWAP_RETRIES=_SWAP_RETRIES+1
                     Aga Wait Vbl
                  End If
               End If
            Next _ST
            If _SWREADY=0
               _ERR=3
               _FRAME=600
            Else
               _SHOWN=_SHOWN+1
               _P=Aga Mouse Pressed
               _K=Aga Key
               ' RIGHT button is bit 2; left is bit 1.
               If _P=2 or _P=3
                  _VISIBLE=1-_VISIBLE
                  _CUR=Aga Mouse Cursor(_VISIBLE)
                  If _CUR<>1
                     _ERR=4
                     _FRAME=600
                  Else
                     _TOGGLES=_TOGGLES+1
                  End If
               End If
               If _P=1 or _P=3 or _K>=0
                  _FRAME=600
               End If
               Aga Wait Vbl
            End If
         End If
      End If
   End If
Next _FRAME
' Close while the pointer may be hidden: R44 restores it.
Aga Screen Close
Amos To Front
_NOSCREEN=Aga Mouse Cursor(0)
_CLOSED=Aga Mouse X
_RESULT=1
If _ERR<>0 or _SHOWN=0 or _NOSCREEN<>0 or _CLOSED<>-1
   _RESULT=0
End If
Cls
Print "M15 + M15BIS - 2D SHOWCASE"
Print "FRAMES ";_SHOWN;" CURSOR TOGGLES ";_TOGGLES
Print "SAFE RETRIES ";_SAFE_RETRIES;" SWAP RETRIES ";_SWAP_RETRIES
Print "NOSCREEN ";_NOSCREEN;" CLOSED ";_CLOSED
Print "ERROR ";_ERR;" (0=OK 1=SAFE 2=DRAW 3=SWAP 4=CURSOR)"
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
