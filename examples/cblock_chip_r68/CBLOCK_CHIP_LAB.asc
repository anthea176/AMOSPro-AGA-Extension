' M18/R68 - CBlock Chip Lab - public demo, interpreted AMOS.
' NEED R68 v0.13.13. Bank 11 MUST BE FREE. No IFF or ABK.
' Method is ALWAYS chosen by the AMOS programmer:
' 0=CPU8 (8-pixel alignment), 1=CPU16 (16-pixel), 2=Blitter.
' This demo does not select a method automatically.
Cls
Print "M18 R68 CBLOCK CHIP LAB"
If Aga Detect=0
   Print "AGA NOT DETECTED"
   End
End If
_CF0=Chip Free
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "AGA OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_P0=Aga Palette Set(0,0,0,0)
_P2=Aga Palette Set(2,32,48,96)
_P4=Aga Palette Set(4,255,0,0)
_P5=Aga Palette Set(5,0,255,0)
_P255=Aga Palette Set(255,255,255,255)
_SW0=0
For _TRY=1 To 40
   If _SW0=0
      _SW0=Aga Swap
   End If
   If _SW0=0
      Aga Wait Vbl
   End If
Next _TRY
Amos To Back
_BG=0
For _TRY=1 To 40
   If _BG=0
      _BG=Aga Blit Fill(0,0,320,256,2)
   End If
   If _BG=0
      Aga Wait Vbl
   End If
Next _TRY
_ERR=0
If _P0<>1 or _P2<>1 or _P4<>1 or _P5<>1 or _P255<>1
   Inc _ERR
End If
If _SW0<>1 or _BG<>1
   Inc _ERR
End If
' Draw a 32x32 white frame with a black hole on the AGA back buffer.
_SRC=Aga Blit Fill(16,48,32,32,255)
_HOLE=Aga Blit Fill(24,56,16,16,0)
If _SRC<>1 or _HOLE<>1
   Inc _ERR
End If
' Explicit CAPTURE method: Blitter. Source X and Width are aligned.
_CAPMODE=2
_CAP=Aga C Block Capture(11,16,48,32,32,_CAPMODE)
If _CAP=1
   _LEN=Length(11)
   _PTR=Start(11)
   _CHIP1=Chip Free
   ' Overwrite the original with red, then Restore via CPU16.
   _PAINT=Aga Blit Fill(16,48,32,32,4)
   _RESTMODE=1
   _REST=Aga C Block Restore(11,_RESTMODE)
   ' Display the SAME captured block through all THREE paths.
   _CPU8=Aga C Block Draw(11,8,144,0)
   _BLIT=Aga C Block Draw(11,96,144,2)
   _CPU16=Aga C Block Draw(11,176,144,1)
   _REUSE=Aga C Block Capture(11,16,48,32,32,0)
   _SAME=0
   If _REUSE=1
      If Start(11)=_PTR
         _SAME=1
      End If
   End If
   If _PAINT<>1 or _REST<>1 or _CPU8<>1 or _BLIT<>1 or _CPU16<>1
      Inc _ERR
   End If
   If _REUSE<>1 or _SAME<>1 or Chip Free<>_CHIP1 or _LEN<>1064
      Inc _ERR
   End If
Else
   Inc _ERR
End If
_SW1=0
For _TRY=1 To 40
   If _SW1=0
      _SW1=Aga Swap
   End If
   If _SW1=0
      Aga Wait Vbl
   End If
Next _TRY
If _SW1<>1
   Inc _ERR
End If
If _SW1=1
   Amos To Back
End If
For _HOLD=1 To 180
   Aga Wait Vbl
Next _HOLD
Aga Screen Close
Amos To Front
If _CAP=1
   Erase 11
End If
_CF1=Chip Free
If _CF0<>_CF1
   Inc _ERR
End If
Cls
Print "M18 R68 CBLOCK CHIP LAB"
Print "METHODS CAP/REST ";_CAPMODE;" ";_RESTMODE
Print "DRAW CPU8/BLIT/CPU16 ";_CPU8;" ";_BLIT;" ";_CPU16
Print "RECAP/SAME ";_REUSE;" ";_SAME
Print "BANK LEN ";_LEN
Print "CHIP START/END ";_CF0;" ";_CF1
Print "ERROR ";_ERR
_RESULT=0
If _ERR=0
   _RESULT=1
End If
Print "RESULT ";_RESULT
Print "CLOSE RETURNED"
End
