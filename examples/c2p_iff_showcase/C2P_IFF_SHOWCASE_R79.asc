' C2P IFF SHOWCASE - integrated visual reference, R79 v0.13.24.
' Select iff-TEST/AGA_DEMO_320x256_256c.iff.
' Its 81920-byte .chk companion MUST be in the SAME directory.
' The demonstration overwrites DATA banks 12 and 13. Use an empty AMOS program.
' AGA + CPU 68020+ + LIBS:c2p.library 1.9 required. INTERPRETED first.
Cls
Print "C2P IFF SHOWCASE - R79"
Print "Select AGA_DEMO_320x256_256c.iff"
_IFF$=Fsel$("**")
If _IFF$=""
   Print "CANCELLED"
   End
End If
If Len(_IFF$)<5
   Print "INVALID FILE NAME"
   End
End If
_W=Aga Pic Info(_IFF$,0)
_H=Aga Pic Info(_IFF$,1)
_D=Aga Pic Info(_IFF$,2)
_C=Aga Pic Info(_IFF$,7)
_MODE=Aga Pic Info(_IFF$,6)
If _W<>320 or _H<>256 or _D<>8 or _C<>256 or _MODE<>$00021000
   Print "SELECT THE 320X256X8 AGA DEMO IFF"
   End
End If
_RAW$=Left$(_IFF$,Len(_IFF$)-4)+".chk"
Trap Open In 1,_RAW$
_FILEERR=Errtrap
If _FILEERR<>0
   Print "MISSING .CHK IN SAME DIRECTORY"
   Print _RAW$
   End
End If
_RAWLEN=Lof(1)
Trap Close 1
If _RAWLEN<>81920
   Print "INVALID CHUNKY LENGTH: ";_RAWLEN
   Print "EXPECTED 81920 BYTES"
   End
End If
' Measure before allocating banks or the AGA private screen.
_CF0=Chip Free
_FF0=Fast Free
_RESULT=1
_ERR=0
_AGA=0
_ACTIVE=0
_CLOSE_COUNT=0
_IFF_OK=0
_PALETTE_OK=0
_RAW_OK=0
_BASE_OK=0
_BLIT_OK=0
_ZOOM_OK=0
_PIX_OK=0
_BAD_OK=0
_REOPEN_OK=0
_END_OK=0
_PRG_STATE=Prg State
_EXEC_MODE$="UNKNOWN"
If _PRG_STATE=0
   _EXEC_MODE$="INTERPRETED"
End If
If _PRG_STATE=1
   _EXEC_MODE$="RUNTIME"
End If
If _PRG_STATE=-1
   _EXEC_MODE$="COMPILED"
End If
_LOGFILE$="RAM:C2P_IFF_SHOWCASE.TXT"
' Exact 8-bit pixels from the IFF, no AMOS planar readback.
Reserve As Data 12,81920
Reserve As Data 13,81920
If Length(12)<>81920 or Length(13)<>81920
   _ERR=10
   Goto CLEANUP
End If
_PTR=Start(12)
_SRC=Start(13)
Trap Bload _RAW$,_PTR
_BLOADERR=Errtrap
If _BLOADERR<>0
   _ERR=11
   Goto CLEANUP
End If
Trap Bload _RAW$,_SRC
_BLOADERR=Errtrap
If _BLOADERR<>0
   _ERR=12
   Goto CLEANUP
End If
If Peek(_PTR)<>251 or Peek(_SRC+321)<>129
   _ERR=11
   Goto CLEANUP
End If
If Peek(_SRC+64*320+64)<>35 or Peek(_SRC+255*320+319)<>238
   _ERR=12
   Goto CLEANUP
End If
_RAW_OK=1
If Aga Detect=0
   _ERR=13
   Goto CLEANUP
End If
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   _ERR=14
   Goto CLEANUP
End If
_AGA=1
_DB=Aga Double Buffer
If _DB<>1
   _ERR=15
   Goto CLEANUP
End If
' STEP 1: display the unchanged original FORM ILBM and its own palette.
_LOAD=Aga Iff Load(_IFF$)
If _LOAD<>1
   _ERR=16
   Goto CLEANUP
End If
_IFF_OK=1
_PAL=Aga Palette Load(_IFF$)
If _PAL<>1
   _ERR=17
   Goto CLEANUP
End If
_P0=Aga Palette Get(0)
_P64=Aga Palette Get(64)
_P255=Aga Palette Get(255)
If _P0<>$F6F2FA or _P64<>$4B7F7B or _P255<>0
   _ERR=18
   Goto CLEANUP
End If
_PALETTE_OK=1
_T=0
Repeat
   _SWIFF=Aga Swap
   _T=_T+1
   If _SWIFF=0
      Aga Wait Vbl
   End If
Until _SWIFF=1 or _T>=60
If _SWIFF<>1
   _ERR=19
   Goto CLEANUP
End If
Amos To Back
For _I=1 To 90
   Aga Wait Vbl
Next _I
' STEP 2: convert the exact same indexed pixels through c2p.library.
_C2P=Aga C2P Open(12)
If _C2P<>1
   _ERR=20
   Goto CLEANUP
End If
_ACTIVE=1
_T=0
Repeat
   _CV1=Aga C2P Convert
   _T=_T+1
   If _CV1=0
      Aga Wait Vbl
   End If
Until _CV1=1 or _T>=60
If _CV1<>1
   _ERR=21
   Goto CLEANUP
End If
_T=0
Repeat
   _SW1=Aga Swap
   _T=_T+1
   If _SW1=0
      Aga Wait Vbl
   End If
Until _SW1=1 or _T>=60
If _SW1<>1
   _ERR=22
   Goto CLEANUP
End If
_BASE_OK=1
For _I=1 To 90
   Aga Wait Vbl
Next _I
' STEP 3: all operations use the real 320x256 image, not fake patterns.
' Blit source is bank 13; destination is the bank 12 attached to C2P.
_B1=Aga C2P Blit(13,320,20,90,52,52,70,170)
_B2=Aga C2P Blit(13,320,238,92,58,48,222,165)
_B3=Aga C2P Blit(13,320,237,3,76,26,122,225)
If _B1<>1 or _B2<>1 or _B3<>1
   _ERR=30
   Goto CLEANUP
End If
_BLIT_OK=1
' Zoom includes x1.5, x2, x0.5, noninteger, all four clipped edges.
_Z1=Aga C2P Zoom(13,320,145,10,56,56,10,14,84,84)
_Z2=Aga C2P Zoom(13,320,240,74,48,64,198,14,96,112)
_Z3=Aga C2P Zoom(13,320,234,176,64,64,132,176,32,32)
_Z4=Aga C2P Zoom(13,320,0,64,40,48,-16,115,64,96)
_Z5=Aga C2P Zoom(13,320,128,48,48,48,292,215,72,72)
_Z6=Aga C2P Zoom(13,320,231,0,60,32,124,-16,60,48)
_Z7=Aga C2P Zoom(13,320,82,145,49,33,79,108,77,49)
If _Z1<>1 or _Z2<>1 or _Z3<>1 or _Z4<>1
   _ERR=31
   Goto CLEANUP
End If
If _Z5<>1 or _Z6<>1 or _Z7<>1
   _ERR=32
   Goto CLEANUP
End If
_ZOOM_OK=1
' Pixel oracle computed independently from the original ILBM.
' All samples are after the final blits and zooms, with no overlap.
_PIXCOUNT=0
If Peek(_PTR+319)=244
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+250*320)=246
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+170*320+70)=114
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+168*320+224)=58
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+225*320+122)=224
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+14*320+10)=68
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+95*320+92)=0
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+14*320+198)=123
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+176*320+132)=52
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+115*320)=155
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+255*320+319)=85
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+124)=221
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+108*320+79)=127
   _PIXCOUNT=_PIXCOUNT+1
End If
If Peek(_PTR+151*320+150)=155
   _PIXCOUNT=_PIXCOUNT+1
End If
If _PIXCOUNT<>14
   _ERR=33
   Goto CLEANUP
End If
_PIX_OK=1
' Reject bad C2P calls without changing any pixel.
_PROBE=Peek(_PTR+120*320+180)
_BADBL=Aga C2P Blit(12,320,20,90,24,24,180,120)
_BADZM=Aga C2P Zoom(13,0,0,0,30,30,180,120,60,60)
If _BADBL<>0 or _BADZM<>0
   _ERR=34
   Goto CLEANUP
End If
If Peek(_PTR+120*320+180)<>_PROBE
   _ERR=35
   Goto CLEANUP
End If
_BAD_OK=1
' STEP 3 visible: C2P Convert updates back, Swap reveals composition.
_T=0
Repeat
   _CV2=Aga C2P Convert
   _T=_T+1
   If _CV2=0
      Aga Wait Vbl
   End If
Until _CV2=1 or _T>=60
If _CV2<>1
   _ERR=36
   Goto CLEANUP
End If
_T=0
Repeat
   _SW2=Aga Swap
   _T=_T+1
   If _SW2=0
      Aga Wait Vbl
   End If
Until _SW2=1 or _T>=60
If _SW2<>1
   _ERR=37
   Goto CLEANUP
End If
For _I=1 To 90
   Aga Wait Vbl
Next _I
' Test explicit Close, harmless second Close, refusal, and ReOpen.
_CL1=Aga C2P Close
_ACTIVE=0
_DEAD=Aga C2P Zoom(13,320,145,10,56,56,10,14,84,84)
_DEADCV=Aga C2P Convert
_CL2=Aga C2P Close
If _CL1<>1 or _CL2<>0 or _DEAD<>0 or _DEADCV<>0
   _ERR=40
   Goto CLEANUP
End If
_AGAIN=Aga C2P Open(12)
If _AGAIN<>1
   _ERR=41
   Goto CLEANUP
End If
_ACTIVE=1
' Idempotent writes: the golden final image is unchanged after ReOpen.
_BAGAIN=Aga C2P Blit(13,320,237,3,76,26,122,225)
_ZAGAIN=Aga C2P Zoom(13,320,145,10,56,56,10,14,84,84)
If _BAGAIN<>1 or _ZAGAIN<>1
   _ERR=42
   Goto CLEANUP
End If
_T=0
Repeat
   _CV3=Aga C2P Convert
   _T=_T+1
   If _CV3=0
      Aga Wait Vbl
   End If
Until _CV3=1 or _T>=60
If _CV3<>1
   _ERR=43
   Goto CLEANUP
End If
_T=0
Repeat
   _SW3=Aga Swap
   _T=_T+1
   If _SW3=0
      Aga Wait Vbl
   End If
Until _SW3=1 or _T>=60
If _SW3<>1
   _ERR=44
   Goto CLEANUP
End If
_REOPEN_OK=1
' The AGA window is in front. ESC must reach Aga Key.
_K=-1
Repeat
   _K=Aga Key
   Aga Wait Vbl
Until _K=69
_END_OK=1
CLEANUP:
If _ACTIVE=1
   _CL3=Aga C2P Close
   _ACTIVE=0
   If _CL3<>1
      If _ERR=0
         _ERR=45
      End If
   End If
End If
If _AGA=1
   Aga Screen Close
   _CLOSE_COUNT=_CLOSE_COUNT+1
End If
Amos To Front
Erase 13
Erase 12
If _ERR<>0
   _RESULT=0
End If
_CF1=Chip Free
_FF1=Fast Free
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS"
End If
_LOGERR=0
_CLOSEERR=0
Trap Open Out 1,_LOGFILE$
_LOGERR=Errtrap
If _LOGERR=0
   Print #1,"TEST C2P-IFF-SHOWCASE-R79"
   Print #1,"VERSION R79 V0.13.24 CANDIDATE"
   Print #1,"RUN_MODE ";_EXEC_MODE$
   Print #1,"PRG_STATE ";_PRG_STATE
   Print #1,"SOURCE ";_IFF$
   Print #1,"CHUNKY ";_RAW$
   Print #1,"RESULT ";_RESULT
   Print #1,"VERDICT ";_VERDICT$
   Print #1,"IFF_OK ";_IFF_OK
   Print #1,"PALETTE_OK ";_PALETTE_OK
   Print #1,"RAW_OK ";_RAW_OK
   Print #1,"C2P_BASE_OK ";_BASE_OK
   Print #1,"BLIT_OK ";_BLIT_OK
   Print #1,"ZOOM_OK ";_ZOOM_OK
   Print #1,"PIXEL_CHECK_OK ";_PIX_OK
   Print #1,"PIXEL_CHECK_COUNT ";_PIXCOUNT
   Print #1,"INVALID_CALLS_OK ";_BAD_OK
   Print #1,"REOPEN_OK ";_REOPEN_OK
   Print #1,"ESC_OK ";_END_OK
   Print #1,"SCREEN_CLOSE_COUNT ";_CLOSE_COUNT
   Print #1,"ERR ";_ERR
   Print #1,"CHIP_BEFORE ";_CF0
   Print #1,"CHIP_AFTER ";_CF1
   Print #1,"CHIP_DELTA ";_CF0-_CF1
   Print #1,"FAST_BEFORE ";_FF0
   Print #1,"FAST_AFTER ";_FF1
   Print #1,"FAST_DELTA ";_FF0-_FF1
   Print #1,"CLOSE_RETURNED"
   Trap Close 1
   _CLOSEERR=Errtrap
End If
Cls
Print "C2P IFF SHOWCASE R79 - ";_VERDICT$
Print "RAW/IFF/PALETTE ";_RAW_OK;" ";_IFF_OK;" ";_PALETTE_OK
Print "BASE/BLIT/ZOOM ";_BASE_OK;" ";_BLIT_OK;" ";_ZOOM_OK
Print "PIXELS ";_PIXCOUNT;"/14 INVALID ";_BAD_OK
Print "REOPEN ";_REOPEN_OK;" ESC ";_END_OK
Print "SCREEN CLOSED ";_CLOSE_COUNT;" ERR ";_ERR
Print "CHIP DELTA ";_CF0-_CF1;" FAST DELTA ";_FF0-_FF1
Print "LOG ";_LOGFILE$
Print "LOG OPEN ERR ";_LOGERR;" CLOSE ERR ";_CLOSEERR
Print "CLOSE RETURNED"
End
