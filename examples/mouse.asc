' MOUSE - read positions, buttons and click transitions.
' Move the mouse and click LEFT / RIGHT on the AGA pattern.
' Press any key to leave early; automatic exit after 5 seconds.
' R23 is a candidate: Ctrl+C and full runtime coverage pending.
Cls
Print "AGA MOUSE - CLICK LEFT AND RIGHT"
_OPEN=Aga Screen Open(320,256,256,$00021000)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   End
End If
Aga Screen Pattern
Amos To Back
_ALLP=0
_ALLR=0
_ERR=0
_DONE=0
_X=-1
_Y=-1
For _I=1 To 250
   If _DONE=0
      _X=Aga Mouse X
      _Y=Aga Mouse Y
      _P=Aga Mouse Pressed
      _R=Aga Mouse Released
      If _P<0 or _R<0
         _ERR=1
         _DONE=1
      Else
         _ALLP=_ALLP Or _P
         _ALLR=_ALLR Or _R
         _K=Aga Key
         If _K>=0
            _DONE=1
         End If
      End If
      Aga Wait Vbl
   End If
Next _I
Aga Screen Close
Amos To Front
Print "LAST POSITION ";_X;" ";_Y
Print "PRESSED MASK ";_ALLP;" RELEASED MASK ";_ALLR
Print "BUTTONS: 1=LEFT 2=RIGHT 4=MIDDLE"
Print "INPUT ERROR ";_ERR
End
