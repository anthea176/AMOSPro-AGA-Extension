' M19 S1-P1b AGSP DATA-bank AMOS Save/Load compatibility probe.
' SOURCE_TAG M19_S1P1B_DATA_ABK_V1
' This does NOT call any Aga Sprite API and does NOT test DMA.
' Copy AGSP_1IMG_16X16.ABK to the current directory before running.
' Do NOT run with a user bank 10 already in memory.
Set Buffer 20
Cls
_PRG=Prg State : _MODE$="UNKNOWN" : _ERR=0 : _RESULT=0
_LOG$="RAM:M19_S1P1B_AGSP_UNKNOWN.TXT"
If _PRG=0
   _MODE$="INTERPRETED" : _LOG$="RAM:M19_S1P1B_AGSP_INTERPRETED.TXT"
End If
If _PRG=1
   _MODE$="RUNTIME" : _LOG$="RAM:M19_S1P1B_AGSP_RUNTIME.TXT"
End If
If _PRG=-1
   _MODE$="COMPILED" : _LOG$="RAM:M19_S1P1B_AGSP_COMPILED.TXT"
End If
_LOAD_OK=0 : _SAVE_OK=0 : _ERASE_OK=0 : _CHECK_OK=0
_BANK_OWN=0 : _LEN=0 : _PTR=0 : _IO=-1
If Length(10)<>0
   _ERR=1
End If
For _PASS=1 To 2
   If _ERR=0
      If _PASS=1
         Trap Load "AGSP_1IMG_16X16.ABK",10
      Else
         Trap Load "RAM:AGSP_S1P1B_RESAVED.ABK",10
      End If
      _IO=Errtrap
      If _IO<>0
         _ERR=2
      Else
         _BANK_OWN=1 : _LOAD_OK=_LOAD_OK+1
      End If
   End If
   If _ERR=0
      _LEN=Length(10)
      If _LEN<>192
         _ERR=3
      Else
         _PTR=Start(10)
         If Peek$(_PTR,4)<>"AGSP"
            _ERR=4
         End If
         If Deek(_PTR+4)<>1 or Deek(_PTR+8)<>1
            _ERR=5
         End If
         If Deek(_PTR+10)<>48 or Leek(_PTR+20)<>192
            _ERR=6
         End If
         If Deek(_PTR+32)<>1 or Deek(_PTR+34)<>16 or Deek(_PTR+36)<>16
            _ERR=7
         End If
         If Deek(_PTR+38)<>2 or Deek(_PTR+40)<>2
            _ERR=8
         End If
         If Peek(_PTR+80)<>85 or Peek(_PTR+112)<>51
            _ERR=9
         End If
         If Peek(_PTR+147)<>255 or Peek(_PTR+148)<>80 or Peek(_PTR+149)<>56
            _ERR=10
         End If
         If Peek(_PTR+153)<>61 or Peek(_PTR+154)<>199 or Peek(_PTR+155)<>182
            _ERR=11
         End If
         If _ERR=0
            _CHECK_OK=_CHECK_OK+1
         End If
      End If
   End If
   If _ERR=0 and _PASS=1
      Trap Save "RAM:AGSP_S1P1B_RESAVED.ABK",10
      _IO=Errtrap
      If _IO<>0
         _ERR=12
      Else
         _SAVE_OK=1
      End If
   End If
   If _BANK_OWN=1
      Erase 10
      _BANK_OWN=0
      If Length(10)<>0
         _ERR=13
      Else
         _ERASE_OK=_ERASE_OK+1
      End If
   End If
Next _PASS
If _ERR=0 and _LOAD_OK=2 and _SAVE_OK=1 and _ERASE_OK=2 and _CHECK_OK=2
   _RESULT=1
End If
_VERDICT$="FAIL"
If _RESULT=1
   _VERDICT$="PASS_DATA_BANK_ONLY"
End If
Print "S1-P1b AGSP DATA BANK ";_VERDICT$;" ERR ";_ERR
Print "LOAD ";_LOAD_OK;" SAVE ";_SAVE_OK;" ERASE ";_ERASE_OK;" CHECK ";_CHECK_OK
Trap Open Out 1,_LOG$
_IO=Errtrap
If _IO=0
   Print #1,"TEST M19 S1P1B AGSP DATA BANK"
   Print #1,"SOURCE_TAG M19_S1P1B_DATA_ABK_V1"
   Print #1,"PRG_STATE ";_PRG
   Print #1,"RUN_MODE ";_MODE$
   Print #1,"RESULT ";_RESULT
   Print #1,"ERR ";_ERR
   Print #1,"LOAD_OK ";_LOAD_OK
   Print #1,"SAVE_OK ";_SAVE_OK
   Print #1,"ERASE_OK ";_ERASE_OK
   Print #1,"CHECK_OK ";_CHECK_OK
   Print #1,"VERDICT ";_VERDICT$
   Trap Close 1
End If
Print "RAM LOG ";_LOG$;" OPEN_ERR ";_IO
End
