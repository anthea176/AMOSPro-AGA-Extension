' PICTURE - load a 320x256x8 IFF/ILBM and show it.
' Choose examples/demo.iff in the file selector.
Cls
Print "AGA PICTURE - SELECT demo.iff"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8 or _C<>256
   Print "PLEASE SELECT A 320X256X8 IFF"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
_SWAP=Aga Swap
If _SWAP<>1
   Aga Screen Close
   Amos To Front
   Print "SWAP FAILED"
   End
End If
Amos To Back
_K=Aga Wait Key
Aga Screen Close
Amos To Front
Print "PICTURE OK - KEY ";_K
End
