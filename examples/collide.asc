' COLLIDE - R25 rectangle overlap with mouse and double buffering.
' Choose examples/demo.iff for its palette, not its picture.
' Blue = fixed, green = free, red = overlap. Left click exits.
Cls
Print "AGA COLLIDE - SELECT demo.iff"
_FILE$=Fsel$("**")
If _FILE$=""
   Print "CANCELLED"
   End
End If
_W=Aga Pic Info(_FILE$,0)
_H=Aga Pic Info(_FILE$,1)
_D=Aga Pic Info(_FILE$,2)
_C=Aga Pic Info(_FILE$,7)
_MODE=Aga Pic Info(_FILE$,6)
If _W<>320 or _H<>256 or _D<>8 or _C<>256 or _MODE<>$00021000
   Print "SELECT examples/demo.iff (320X256X8 PAL)"
   End
End If
_OPEN=Aga Screen Open(_W,_H,_C,_MODE)
If _OPEN<>1
   Print "SCREEN OPEN FAILED"
   End
End If
_DB=Aga Double Buffer
If _DB<>1
   Aga Screen Close
   Amos To Front
   Print "DOUBLE BUFFER FAILED"
   End
End If
_LOAD=Aga Iff Load(_FILE$)
If _LOAD<>1
   Aga Screen Close
   Amos To Front
   Print "IFF LOAD FAILED"
   End
End If
_INIT=Aga Mouse Pressed
_ERR=0
Amos To Back
For _FRAME=1 To 900
   _MX=Aga Mouse X
   _MY=Aga Mouse Y
   If _MX<0
      _MX=0
   End If
   If _MY<0
      _MY=0
   End If
   _SX=_MX-16
   _SY=_MY-16
   If _SX<0
      _SX=0
   End If
   If _SY<0
      _SY=0
   End If
   If _SX>288
      _SX=288
   End If
   If _SY>224
      _SY=224
   End If
   _HIT=Aga Rect Overlap(100,70,120,100,_SX,_SY,32,32)
   If _HIT=1
      _INK=224
   Else
      _INK=28
   End If
   ' Redraw back buffer to avoid trails.
   _CLEAR=Aga Blit Clear(0,0,320,256)
   _FIXED=Aga Blit Fill(100,70,120,100,3)
   _MOVE=Aga Blit Fill(_SX,_SY,32,32,_INK)
   _LED=Aga Blit Fill(8,8,16,16,_INK)
   _SW=Aga Swap
   If _CLEAR<>1 or _FIXED<>1 or _MOVE<>1 or _LED<>1 or _SW<>1
      _ERR=1
      _FRAME=900
   End If
   _P=Aga Mouse Pressed
   If _P=1 or _P=3
      _FRAME=900
   End If
   Aga Wait Vbl
Next _FRAME
Aga Screen Close
Amos To Front
Print "COLLIDE DONE - ERR ";_ERR
End
